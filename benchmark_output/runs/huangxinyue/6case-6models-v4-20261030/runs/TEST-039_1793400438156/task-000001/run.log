i.resize(w,h);return i;}\nfunction recolor(node,color){if('fills'in node&&Array.isArray(node.fills)&&node.fills.length&&node.fills[0].type==='SOLID')node.fills=[S(color)];if('children'in node)node.children.forEach(ch=>recolor(ch,color));}\nfunction icon(id,parent,x,y,size,label,color){const i=mediaInst(id,size,size);i.x=x;i.y=y;i.name=label||'icon';parent.appendChild(i);if(color)recolor(i,color);return i;}\nfunction shell(scr,c){const sb=mediaInst('6:32',390,44);sb.x=0;sb.y=0;recolor(sb,c);scr.appendChild(sb);const hi=mediaInst('6:42',390,34);hi.x=0;hi.y=810;recolor(hi,c);scr.appendChild(hi);}\nfunction screen(name,x,bg){const f=F(name,390,844,bg);f.x=x;f.y=0;WS.appendChild(f);return f;}\nfunction findKid(node,nm){if(node.name===nm)return node;if('children'in node){for(const ch of node.children){const r=findKid(ch,nm);if(r)return r;}}return null;}\nfunction setTexts(node,map){for(const k in map){const t=findKid(node,k);if(t&&t.type==='TEXT')t.characters=map[k];}}\nfunction tradeNav(scr,current){const bar=F('Trade Nav Bar',390,83,C.tCard);bar.x=0;bar.y=761;bar.appendChild(R(390,1,C.tLine));scr.appendChild(bar);\nconst defs=[['Home','2:27','07'],['Markets','2:32','08'],['Exchange','2:37','09'],['Futures','2:42',null],['Wallets','2:17',null]];\ndefs.forEach((d,i)=>{const tab=F('tab '+d[0],64,49,null);tab.x=7+i*78;tab.y=8;bar.appendChild(tab);\nicon(d[1],tab,20,2,24,'icon',d[2]===current?C.primary:C.tSub);\nconst lb=T(d[0],{style:'Medium',size:11,color:d[2]===current?C.primary:C.tSub,align:'CENTER',w:64,h:14,name:'label'});lb.x=0;lb.y=31;tab.appendChild(lb);});\nreturn bar;}\nfunction genericCoin(parent,x,y,letter,color){const g=figma.createEllipse();g.resize(36,36);g.fills=[S(color)];g.x=x;g.y=y;g.name='coin';parent.appendChild(g);\nconst t=T(letter,{fam:'Poppins',style:'SemiBold',size:14,color:C.white,align:'CENTER',w:36,h:36,name:'cl'});t.textAlignVertical='CENTER';t.x=x;t.y=y;parent.appendChild(t);}\n\n// ---- patch 08: replace BTC-reused coins for USDT/ADA/DOT/AVAX with generic badges\nconst s8=WS.children.find(n=>n.name==='08_Market');\nconst rows=s8.children.filter(c=>c.name==='FinX / Market Row');\nconst patch=[['USDT','U',C.teal],['ADA','A',C.primary],['DOT','D',C.pink],['AVAX','A',C.down]];\nrows.forEach(r=>{\n  const tk=findKid(r,'ticker');const match=patch.find(p=>p[0]===tk.characters);\n  if(match){const coin=r.children.find(c=>c.name==='coin');if(coin){genericCoin(r,coin.x,coin.y,match[1],match[2]);coin.remove();}}\n});\n\n// ============ 09_Exchange_Stock ============\nconst s9=screen('09_Exchange_Stock',3440,C.tBg);\nshell(s9,C.tText);\nconst t9=T('Exchange',{fam:'Poppins',style:'SemiBold',size:20,color:C.tText});t9.x=16;t9.y=60;s9.appendChild(t9);\nconst calc9=F('calculator',36,36,C.tCard);calc9.cornerRadius=18;calc9.x=338;calc9.y=56;s9.appendChild(calc9);\nicon('4:87',calc9,6,6,24,'calculator',C.tText);\n// side switch\nconst sideBg=R(200,36,C.tCard,18);sideBg.x=95;sideBg.y=108;s9.appendChild(sideBg);\nconst buyPill=R(96,28,C.primary,14);buyPill.x=99;buyPill.y=112;s9.appendChild(buyPill);\nconst buyT=T('Buy',{style:'SemiBold',fam:'Poppins',size:13,color:C.white,align:'CENTER',w:96,h:28,name:'buy'});buyT.textAlignVertical='CENTER';buyT.x=99;buyT.y=112;s9.appendChild(buyT);\nconst sellT=T('Sell',{style:'Medium',size:13,color:C.tSub,align:'CENTER',w:96,h:28,name:'sell'});sellT.textAlignVertical='CENTER';sellT.x=199;sellT.y=112;s9.appendChild(sellT);\n// FROM card\nconst eaComp=figma.getNodeById('11:64');\nconst from=eaComp.createInstance();from.x=16;from.y=164;s9.appendChild(from);\nconst fromD=from.detachInstance();\nsetTexts(fromD,{ticker:'AAPL',sub:'Apple Inc.',amount:'$156.50'});\nconst caret=R(2,20,C.primary);caret.x=318;caret.y=26;fromD.appendChild(caret);\n// swap button\nconst swapB=F('swap direction',44,44,C.primary);swapB.cornerRadius=22;swapB.x=173;swapB.y=224;swapB.strokes=[S(C.tBg)];swapB.strokeWeight=3;s9.appendChild(swapB);\nicon('4:97',swapB,10,10,24,'swap',C.white);\n// TO card\nconst to=eaComp.createInstance();to.x=16;to.y=256;s9.appendChild(to);\nconst toD=to.detachInstance();\nconst oldLogo=toD.children.find(c=>c.name==='logo');if(oldLogo){const ni=mediaInst('4:126',40,40);ni.x=oldLogo.x;ni.y=oldLogo.y;ni.name='logo';toD.appendChild(ni);oldLogo.remove();}\nsetTexts(toD,{ticker:'SPOT',sub:'Spotify',amount:'≈ 0.69'});\nconst rateT=T('at $226.90 per share',{size:11,color:C.tSub,align:'RIGHT',w:150,h:14,name:'rate'});rateT.x=190;rateT.y=50;toD.appendChild(rateT);\n// keypad\nconst keys=[['1',''],['2','ABC'],['3','DEF'],['4','GHI'],['5','JKL'],['6','MNO'],['7','PQRS'],['8','TUV'],['9','WXYZ'],['',''],['0',''],['⌫','']];\nkeys.forEach((k,i)=>{\n  const col=i%3,row=Math.floor(i/3);\n  const x=17+col*120,y=356+row*58;\n  if(i===11){icon('4:92',s9,x+47,y+17,24,'backspace',C.tText);return;}\n  if(k[0]==='')return;\n  const inst=figma.getNodeById('11:72').createInstance();inst.x=x;inst.y=y;s9.appendChild(inst);\n  const det=inst.detachInstance();setTexts(det,{num:k[0],letters:k[1]});\n});\ntradeNav(s9,'09');\nreturn JSON.stringify({s9:s9.id});","description":"Patch market coin badges and build 09_Exchange_Stock with keypad"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"2a07d38d-5d51-448b-bf79-cabdc4345135","uuid":"b336c7a7-c3d4-49f3-bab1-1b492a983a0a","timestamp":"2026-10-30T23:05:03.175Z","tool_use_meta":[{"id":"mcp__figma__use_figma_35_d877b978","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
