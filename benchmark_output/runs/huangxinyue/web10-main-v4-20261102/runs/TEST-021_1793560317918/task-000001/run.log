od,'204 Customer Reviews',16,'Regular',C.muted,984,336,{lh:22});\ntxt(prod,'Setting the bar as one of the most comfortable sofas in its class, the Asgaard is a compact, sturdy three-seater with a solid-wood frame and deep, soft cushions.',16,'Regular',C.body,820,384,{lh:26,w:440});\ntxt(prod,'Size',16,'Regular',C.muted,820,500,{lh:24});\n[['L',true],['XL',false],['XS',false]].forEach(([s,sel],k)=>{ const b=frame(prod,820+k*70,532,60,44,sel?C.gold:C.cream,'Size_'+s,6); txt(b,s,16,sel?'Medium':'Regular',sel?'#FFFFFF':C.ink,22,10,{lh:24}); });\ntxt(prod,'Color',16,'Regular',C.muted,820,600,{lh:24});\n[['#816DFA',true],['#000000',false],['#B88E2F',false]].forEach(([col,sel],k)=>{ const dot=figma.createEllipse(); prod.appendChild(dot); dot.name='Color_'+col; dot.resize(30,30); dot.fills=[solid(col)]; if(sel){ dot.strokes=[solid('#1A1A1F')]; dot.strokeWeight=2; dot.strokeAlign='OUTSIDE'; } dot.x=820+k*52; dot.y=632; });\nconst qty=B('QtyStepper').createInstance(); prod.appendChild(qty); qty.name='QtyStepper'; qty.x=820; qty.y=700;\nbtn(prod,'Add To Cart','Primary',1000,700);\nconst cmpW=frame(prod,1220,700,140,54,'#FFFFFF','CompareWrap'); cmpW.strokes=[solid(C.ink)]; cmpW.strokeWeight=1;\nicon(cmpW,'Icon_Compare',16,C.ink,18,19); txt(cmpW,'+ Compare',16,'Medium',C.ink,42,15,{lh:24});\nconst meta=frame(prod,820,810,500,140,'#FFFFFF','Meta');\n[['SKU','SS001'],['Category','Sofas'],['Tags','Sofa, Chair, Home, Shop']].forEach(([k,v],idx)=>{ txt(meta,k,16,'Regular',C.muted,0,idx*36,{lh:24}); txt(meta,v,16,'Regular',C.body,110,idx*36,{lh:24}); });\ntxt(meta,'Share',16,'Regular',C.muted,0,116,{lh:24});\n['Logo_Facebook','Logo_LinkedIn','Logo_Twitter'].forEach((l,k)=>{ const lg=I(l).createInstance(); meta.appendChild(lg); lg.name=l; lg.resize(18,18); lg.x=100+k*34; lg.y=118; });\nconst div=figma.createRectangle(); prod.appendChild(div); div.name='Divider'; div.resize(1240,1); div.fills=[solid(C.line)]; div.x=100; div.y=1000;\nconst tabs=B('Tabs').createInstance(); prod.appendChil