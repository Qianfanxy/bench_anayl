ush(v);});\nfor(const [g,vs] of Object.entries(groups)){const sec=figma.createFrame(); sec.name=g; sec.layoutMode='VERTICAL'; sec.itemSpacing=12; sec.primaryAxisSizingMode='AUTO'; sec.counterAxisSizingMode='AUTO'; sec.fills=[]; fd.appendChild(sec); sec.appendChild(await T(g.charAt(0).toUpperCase()+g.slice(1),'Heading/H3'));\n const row=figma.createFrame(); row.layoutMode='HORIZONTAL'; row.itemSpacing=16; row.primaryAxisSizingMode='AUTO'; row.counterAxisSizingMode='AUTO'; row.fills=[]; row.name='Swatches'; sec.appendChild(row);\n for(const v of vs){const c=figma.createFrame(); c.name=v.name; c.layoutMode='VERTICAL'; c.itemSpacing=6; c.primaryAxisSizingMode='AUTO'; c.counterAxisSizingMode='AUTO'; c.fills=[]; const sw=figma.createRectangle(); sw.resize(112,64); sw.cornerRadius=12; sw.fills=[P(v)]; sw.strokes=[P(V['border/default'])]; c.appendChild(sw); const val=Object.values(v.valuesByMode)[0]; const hx='#'+[val.r,val.g,val.b].map(x=>Math.round(x*255).toString(16).padStart(2,'0')).join('').toUpperCase(); c.appendChild(await T(v.name,'Caption/Medium')); c.appendChild(await T(hx,'Caption/Regular','text/secondary')); row.appendChild(c);}}\nconst ts=figma.createFrame(); ts.name='Type scale'; ts.layoutMode='VERTICAL'; ts.itemSpacing=10; ts.primaryAxisSizingMode='AUTO'; ts.counterAxisSizingMode='AUTO'; ts.fills=[]; fd.appendChild(ts); ts.appendChild(await T('Type scale · Plus Jakarta Sans','Heading/H3'));\nfor(const s of TS){ts.appendChild(await T(s.name+' — '+s.fontSize+'/'+s.lineHeight.value+' '+s.fontName.style+' · $190,008.03',s.name));}\nfd.appendChild(await T('Spacing 4 · 8 · 12 · 16 · 20 · 24 · 32   |   Radii 8 · 12 · 16 · 24 · full   |   Elevation/Card 0 8 24 6%, Elevation/Nav 0 -4 20 8%','Body/Medium','text/secondary'));\nreturn chk;","description":"Verify reactions and add foundations token board","fileKey":"MBHvOG7BDhv7MBK9aeD1M4"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_token