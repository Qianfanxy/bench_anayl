{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011Cgb3ZHwIbjbKW1pjgVDEv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01aQK9rLV5lxaybQty4VgbSR","name":"mcp__figma__use_figma","input":{"code":"\nfor (const s of ['Regular','Medium','Semi Bold','Bold']) await figma.loadFontAsync({family:'Roboto',style:s});\nconst C={bg:'#0E0F13',surface:'#17181E',surface2:'#1F2028',surface3:'#282A33',border:'#2C2E38',text:'#F2F2F2',text2:'#9EA0AD',text3:'#6E7080',brand:'#279646',brandSoft:'#173A26',gain:'#2FBF71',loss:'#F0554B'};\nconst rgb=h=>{h=h.replace('#','');return{r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255};};\nconst paint=h=>[{type:'SOLID',color:rgb(h)}];\nfunction text(parent,name,chars,color,size,weight,lh){const t=figma.createText();t.name=name;t.fontName={family:'Roboto',style:weight||'Regular'};t.characters=chars;t.fontSize=size;t.lineHeight={unit:'PIXELS',value:lh||Math.round(size*1.35)};t.fills=paint(color);parent.appendChild(t);return t;}\nfunction box(name,w,h,fill,radius){const f=figma.createFrame();f.name=name;f.resize(w,h);f.fills=fill?paint(fill):[];f.clipsContent=true;if(radius!==undefined)f.cornerRadius=radius;return f;}\nasync function inst(id,parent,w,h){const n=await figma.getNodeByIdAsync(id);const i=n.createInstance();if(w){i.resize(w,h||w);}parent.appendChild(i);return i;}\nfunction recolor(node,color){for(const t of node.findAll(n=>['VECTOR','ELLIPSE','RECTANGLE'].includes(n.type))){try{t.fills=paint(color);}catch(e){}}}\nconst page=await figma.getNodeByIdAsync('5:2');await figma.setCurrentPageAsync(page);\nconst setT=(i,name,v)=>{const n=i.findOne(x=>x.name===name);if(n)n.characters=v;return n;};\nfunction screen(name,x){const f=figma.createFrame();f.name=name;f.resize(375,812);f.x=x;f.y=0;f.fills=paint(C.bg);f.clipsContent=true;page.appendChild(f);return f;}\nfunction body(f,h){const b=box('Body',375,h,null);b.x=0;b.y=100;b.layoutMode='VERTICAL';b.primaryAxisSizingMode='AUTO';b.counterAxisSizingMode='FIXED';b.paddingLeft=16;b.paddingRight=16;b.paddingTop=12;b.itemSpacing=16;return b;}\nasync function secTitle(parent,t){const r=box('Title '+t,343,20,null);r.layoutMode='HORIZONTAL';r.primaryAxisSizingMode='FIXED';r.counterAxisSizingMode='FIXED';parent.appendChild(r);text(r,'Title',t,C.text,14,'Medium',20);return r;}\n\n// remove old 03\nfor(const ch of Array.from(page.children)){ if(ch.name==='03_Detail_Saham') ch.remove(); }\n\n// ================= 03 Detail Saham =================\nconst s3=screen('03_Detail_Saham',840);\nawait inst('1:30',s3);\nconst h3=await inst('7:28',s3);h3.x=0;h3.y=44;\n\nconst idb=box('Identity',375,96,null);idb.x=0;idb.y=100;s3.appendChild(idb);\nidb.layoutMode='HORIZONTAL';idb.primaryAxisSizingMode='FIXED';idb.counterAxisSizingMode='FIXED';\nidb.paddingLeft=16;idb.paddingRight=16;idb.paddingTop=2;idb.paddingBottom=10;idb.itemSpacing=12;idb.counterAxisAlignItems='CENTER';\nconst logo3=await inst('3:45',idb,44,44);logo3.cornerRadius=22;logo3.clipsContent=true;\nconst idText=box('Names',0,52,null);idText.layoutMode='VERTICAL';idText.primaryAxisSizingMode='AUTO';idText.counterAxisSizingMode='AUTO';idText.layoutGrow=1;idText.itemSpacing=1;idb.appendChild(idText);\ntext(idText,'Ticker','GOTO',C.text,18,'Semi Bold',24);\ntext(idText,'Name','GoTo Gojek Tokopedia',C.text3,12,'Regular',16);\nconst idRight=box('Price block',0,52,null);idRight.layoutMode='VERTICAL';idRight.primaryAxisSizingMode='AUTO';idRight.counterAxisSizingMode='AUTO';idRight.counterAxisAlignItems='MAX';idRight.itemSpacing=0;idb.appendChild(idRight);\ntext(idRight,'Price','Rp189',C.text,24,'Bold',30);\ntext(idRight,'Change','−Rp9 (−4,55%)',C.loss,12,'Medium',16);\n\nconst dayRow=box('Hari ini',375,24,null);dayRow.x=0;dayRow.y=196;s3.appendChild(dayRow);\ndayRow.layoutMode='HORIZONTAL';dayRow.paddingLeft=16;dayRow.paddingRight=16;dayRow.primaryAxisSizingMode='FIXED';dayRow.counterAxisSizingMode='FIXED';dayRow.primaryAxisAlignItems='SPACE_BETWEEN';dayRow.counterAxisAlignItems='CENTER';\ntext(dayRow,'Left','Hari ini',C.text2,12,'Regular',16);\ntext(dayRow,'Hint','1D',C.text3,12,'Regular',16);\n\nconst b3=body(s3,590);b3.y=222;b3.paddingTop=6;s3.appendChild(b3);\n\nconst chartCard=box('Chart card',343,232,C.surface,16);b3.appendChild(chartCard);\nchartCard.layoutMode='NONE';\nconst pts=[[197,'6:00'],[199,'10:00'],[194,'14:00'],[196,'18:00'],[192,'22:00'],[189,'2:00']];\nconst px=16,pw=311,plotTop=28,plotH=140,minV=186,maxV=202;\nconst coords=pts.map((p,i)=>[px+(pw/(pts.length-1))*i, plotTop+plotH-((p[0]-minV)/(maxV-minV))*plotH]);\nfor(let i=0;i<=3;i++){const gl=box('Grid',pw,1,C.surface3,0);chartCard.appendChild(gl);gl.x=px;gl.y=plotTop+(plotH/3)*i;gl.opacity=0.5;}\nlet dArea='M '+coords[0][0]+' '+(plotTop+plotH)+' ';\nfor(const c of coords) dArea+='L '+c[0].toFixed(1)+' '+c[1].toFixed(1)+' ';\ndArea+='L '+coords[coords.length-1][0]+' '+(plotTop+plotH)+' Z';\nconst area=figma.createVector();area.name='Area';area.vectorPaths=[{windingRule:'NONZERO',data:dArea}];\narea.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{...rgb(C.brand),a:0.30}},{position:1,color:{...rgb(C.brand),a:0}}]}];\nchartCard.appendChild(area);\nlet dLine='M '+coords[0][0]+' '+coords[0][1]+' ';\nfor(const c of coords.slice(1)) dLine+='L '+c[0].toFixed(1)+' '+c[1].toFixed(1)+' ';\nconst line=figma.createVector();line.name='Price line';line.vectorPaths=[{windingRule:'NONZERO',data:dLine}];\nline.strokes=[{type:'SOLID',color:rgb(C.text)}];line.strokeWeight=2;line.fills=[];\nchartCard.appendChild(line);\nconst hp=coords[4];\nconst vline=box('Guide',1,plotH,C.text3,0);chartCard.appendChild(vline);vline.x=hp[0];vline.y=plotTop;vline.opacity=0.45;\nconst dotRing=box('Point ring',16,16,C.brand,8);dotRing.opacity=0.3;chartCard.appendChild(dotRing);dotRing.x=hp[0]-8;dotRing.y=hp[1]-8;\nconst dot=box('Point',8,8,C.text,4);chartCard.appendChild(dot);dot.x=hp[0]-4;dot.y=hp[1]-4;\nconst tip=box('Tooltip',150,60,C.surface3,10);chartCard.appendChild(tip);tip.x=hp[0]-75;tip.y=hp[1]-72;\ntip.layoutMode='VERTICAL';tip.primaryAxisSizingMode='FIXED';tip.counterAxisSizingMode='FIXED';tip.paddingLeft=10;tip.paddingTop=7;tip.itemSpacing=1;tip.strokes=paint(C.border);tip.strokeWeight=1;tip.strokeAlign='INSIDE';\ntext(tip,'Val','Rp192',C.text,14,'Semi Bold',18);\ntext(tip,'Time','28 Okt 2022 - 22:00',C.text2,10,'Regular',13);\ntext(tip,'Vol','Volume: 102K',C.text3,10,'Regular',13);\nconst axis=box('Axis',343,20,null);chartCard.appendChild(axis);axis.x=0;axis.y=192;\naxis.layoutMode='HORIZONTAL';axis.primaryAxisSizingMode='FIXED';axis.counterAxisSizingMode='FIXED';axis.paddingLeft=16;axis.paddingRight=16;axis.primaryAxisAlignItems='SPACE_BETWEEN';\nfor(const p of pts) text(axis,'T',p[1],C.text3,10,'Regular',13);\n\nconst ranges=box('Range tabs',343,34,null);ranges.layoutMode='HORIZONTAL';ranges.primaryAxisSizingMode='FIXED';ranges.counterAxisSizingMode='FIXED';ranges.itemSpacing=5;b3.appendChild(ranges);\nfor(const r of ['1D','5D','1M','6M','YTD','1Y','5Y','MAX']){\n  const on=r==='1D';\n  const c=box('Range '+r,0,34,on?C.brand:null,10);ranges.appendChild(c);\n  c.layoutMode='HORIZONTAL';c.primaryAxisSizingMode='AUTO';c.counterAxisSizingMode='FIXED';c.primaryAxisAlignItems='CENTER';c.counterAxisAlignItems='CENTER';c.paddingLeft=11;c.paddingRight=11;\n  text(c,'Label',r,on?'#FFFFFF':C.text2,11,on?'Medium':'Regular',15);\n}\nconst acts=box('Actions',343,48,null);acts.layoutMode='HORIZONTAL';acts.primaryAxisSizingMode='FIXED';acts.counterAxisSizingMode='FIXED';acts.itemSpacing=10;b3.appendChild(acts);\nconst beli=await inst('8:4',acts,166,48);beli.resize(166,48);beli.layoutGrow=1;setT(beli,'Label','Beli');\nconst jual=await inst('8:12',acts,166,48);jual.resize(166,48);jual.layoutGrow=1;setT(jual,'Label','Jual');\njual.fills=[];jual.strokes=paint(C.border);jual.strokeWeight=1;jual.strokeAlign='INSIDE';jual.cornerRadius=12;\nconst jl=jual.findOne(n=>n.type==='TEXT');if(jl)jl.fills=paint(C.text);\n\nawait secTitle(b3,'Dibandingkan dengan');\nconst cdata=[['Bukalapak Tbk','BUKA','Rp276','+2,82%'],['Bank Rakyat Indonesia','BBRI','Rp4.630','+0,83%'],['PT Industri Jamu','SIDO','Rp740','+2,82%']];\nfor(const d of cdata){\n  const r=box('Compare row',343,56,null);r.layoutMode='HORIZONTAL';r.primaryAxisSizingMode='FIXED';r.counterAxisSizingMode='FIXED';r.counterAxisAlignItems='CENTER';r.itemSpacing=12;b3.appendChild(r);\n  const badge=box('Badge',36,36,C.surface2,18);r.appendChild(badge);badge.layoutMode='HORIZONTAL';badge.primaryAxisSizingMode='FIXED';badge.counterAxisSizingMode='FIXED';badge.primaryAxisAlignItems='CENTER';badge.counterAxisAlignItems='CENTER';\n  text(badge,'B',d[1],C.text2,10,'Bold',13);\n  const mid=box('Text',0,34,null);mid.layoutMode='VERTICAL';mid.primaryAxisSizingMode='AUTO';mid.counterAxisSizingMode='AUTO';mid.layoutGrow=1;mid.itemSpacing=1;r.appendChild(mid);\n  text(mid,'Company',d[0],C.text,13,'Regular',17);\n  text(mid,'Ticker',d[1],C.text3,10,'Regular',13);\n  const rt=box('Vals',0,34,null);rt.layoutMode='VERTICAL';rt.primaryAxisSizingMode='AUTO';rt.counterAxisSizingMode='AUTO';rt.counterAxisAlignItems='MAX';rt.itemSpacing=1;r.appendChild(rt);\n  text(rt,'Price',d[2],C.text,13,'Medium',17);\n  text(rt,'Change',d[3],C.gain,10,'Medium',13);\n}\nawait secTitle(b3,'Keystats');\nconst ksData=[['Previous Close','Rp198'],['Day Range','Rp188 - Rp199'],['Year Range','Rp180 - Rp396'],['Market Cap','694,70T IDR'],['AVG Volume','167,58M'],['P/E Ratio','15,50'],['Dividend Yield','3,76%'],['Primary Exchange','IDX']];\nfor(const d of ksData){const r=await inst('20:384',b3,343,34);setT(r,'Label',d[0]);setT(r,'Value',d[1]);}\n\nreturn '03 '+s3.id;\n","description":"Rebuild 03_Detail_Saham with identity block and fixed compare rows","fileKey":"4vKKpRHOlbMS1w0BzHKmKz"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":19,"cache_creation_input_tokens":4020,"c