{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_da3ffc8d67f042aba21dbf3a","name":"mcp__figma__use_figma","input":{"code":"const get = id => figma.getNodeByIdAsync(id);\nconst home = await get('13:83');\nconst prop = await get('16:271');\nconst out={ wired: [], failed: [] };\n\nconst nav = (node, dest, mode) => {\n  node.reactions = [{ trigger:{type:'ON_CLICK'}, actions:[{type:'NODE', destinationId:dest, navigation:mode||'NAVIGATE', transition:null}] }];\n};\n\nconst heroBtn = home.findAll(n=>n.type==='INSTANCE').find(i=>i.findAll(t=>t.type==='TEXT').some(t=>t.characters==='See all listings'));\ntry{ nav(heroBtn,'16:271'); out.wired.push('hero:'+heroBtn.id); }catch(e){ out.failed.push('hero:'+e.message); }\nfor(const cid of ['14:108','14:129','14:150','14:172','14:193','14:214']){\n  const c = await get(cid);\n  try{ nav(c,'16:271'); out.wired.push('card:'+cid); }catch(e){ out.failed.push('card:'+cid+':'+e.message); }\n}\n\nconst header = prop.findOne(n=>n.name==='Header');\nconst logo = header && header.findOne(n=>n.name==='Logo');\ntry{ nav(logo,'13:83'); out.wired.push('logo:'+logo.id); }catch(e){ out.failed.push('logo:'+e.message); }\n\nconst simRow = prop.findOne(n=>n.name==='Similar').findOne(n=>n.name==='Row');\nfor(const c of simRow.children){\n  try{\n    nav(c,'16:271');\n    out.wired.push('sim:'+c.id);\n  }catch(e){\n    try{\n      nav(c,'16:271','SWAP');\n      out.wired.push('sim-swap:'+c.id);\n    }catch(e2){ out.failed.push('sim:'+c.id+':'+e2.message); }\n  }\n}\nreturn JSON.stringify(out);","description":"Wire all prototype links with per-node error handling","fileKey":"rQsVjyS3FLCJmO37vlAUQN"}}],"id":"66b22613-361f-48cf-a549-049dcd8803dd","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"78243550-d1f1-4909-8c2b-393b72e47362","uuid":"8013fc07-e1c6-4f6b-bcec-4059d4709