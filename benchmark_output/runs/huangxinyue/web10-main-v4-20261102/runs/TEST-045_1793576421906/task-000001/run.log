e === 'Listing / Card');\nfor (const c of simCards) out.push('sim card ' + c.name + ': ' + addLink(c, prop.id));\n\n// 01_Home: header logo -> 01_Home (self)\nconst homeLogos = home.findAll(n => n.type === 'INSTANCE' && n.mainComponent && (n.mainComponent.name === 'Logo / Dark' || n.mainComponent.name === 'Logo / Light'));\nif (homeLogos.length > 0) out.push('home logo: ' + addLink(homeLogos[0], home.id));\n\nreturn out.join('\\n');\n","description":"Set prototype navigation links (fixed findOne crash)"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"8420bd2b-08e1-4650-9759-ee0744cf2f7f","uuid":"ca504dcf-3563-45e4-9672-3b7ca59a18a6","timestamp":"2026-11-02T00:11:12.781Z","tool_use_meta":[{"id":"mcp__figma__use_figma_64_9e988f48","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
