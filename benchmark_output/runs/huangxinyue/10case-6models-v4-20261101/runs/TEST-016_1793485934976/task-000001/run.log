om=24;set.fills=[solid(bg)];set.cornerRadius=16;set.counterAxisAlignItems='CENTER';return set;}\nconst M={Bank:'4:8',Check:'4:12',Close:'4:13',History:'4:14',Logout:'4:15',NewPay:'4:16',Offer:'4:17',Receive:'4:18',Refresh:'4:19',Scan:'4:20',Search:'4:21',Send:'4:23',Settings:'4:22'};\nasync function icon(k,col,size=24){const i=(await figma.getNodeByIdAsync(M[k])).createInstance();i.findAll(n=>n.type==='VECTOR').forEach(v=>v.strokes=[solid(col)]);if(size!==24)i.rescale(size/24);return i;}\nfunction comp(name,dir,o={}){const c=figma.createComponent();c.name=name;c.layoutMode=dir;c.primaryAxisSizingMode='AUTO';c.counterAxisSizingMode='AUTO';c.itemSpacing=o.gap??0;c.paddingLeft=c.paddingRight=o.px??0;c.paddingTop=c.paddingBottom=o.py??0;c.fills=o.fill?[solid(o.fill,o.fo??1)]:[];if(o.r)c.cornerRadius=o.r;c.counterAxisAlignItems=o.align??'CENTER';return c;}\nconst sh1={type:'DROP_SHADOW',color:{r:0.07,g:0.08,b:0.2,a:0.06},offset:{x:0,y:4},radius:16,spread:0,visible:true,blendMode:'NORMAL'};\nconst ids={};\n// Balance card\nlet sec=section('Balance Card · Primary account (HSBC)');\nconst bc=comp('Balance Card / Primary','VERTICAL',{gap:16,px:20,py:20,r:24,align:'MIN'});bc.counterAxisSizingMode='FIXED';bc.resize(358,10);\nbc.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0.8,0.6,0],[-0.6,0.8,0.3]],gradientStops:[{position:0,color:{...hex('3446FF'),a:1}},{position:1,color:{...hex('1424C8'),a:1}}]}];\nbc.effects=[{type:'DROP_SHADOW',color:{r:0.12,g:0.2,b:0.98,a:0.28},offset:{x:0,y:12},radius:28,spread:-6,visible:true,blendMode:'NORMAL'}];bc.clipsContent=true;\nconst deco=figma.createEllipse();deco.name='Deco';deco.resize(220,220);deco.fills=[solid('FFFFFF',0.07)];bc.appendChild(deco);deco.layoutPositioning='ABSOLUTE';deco.x=200;deco.y=-90;\nconst deco2=figma.createEllipse();deco2.name='Deco 2';deco2.resize(160,160);deco2.fills=[solid('FFFFFF',0.05)];bc.appendChild(deco2);deco2.layoutPositioning='ABSOLUTE';deco2.x=260;deco2.y=70;\nconst r1=af('Bank row','HORIZONTAL',{align:'CENTER'});r1.primaryAxisAlignItems='SPACE_BETWEEN';bc.appendChild(r1);r1.layoutAlign='STRETCH';r1.primaryAxisSizingMode='FIXED';\nconst chip=af('HSBC chip','HORIZONTAL',{px:10,py:7,fill:'FFFFFF',r:10});chip.appendChild((await figma.getNodeByIdAsync('4:11')).createInstance());r1.appendChild(chip);\nr1.appendChild((await figma.getNodeByIdAsync('10:44')).createInstance());\nconst col=af('Balance','VERTICAL',{gap:4});bc.appendChild(col);col.layoutAlign='STRETCH';\ncol.appendChild(txt('Last Updated Balance',13,'Medium','FFFFFF',18));col.children[0].opacity=0.78;\nconst r2=af('Amount row','HORIZONTAL',{align:'CENTER'});r2.primaryAxisAlignItems='SPACE_BETWEEN';col.appendChild(r2);r2.layoutAlign='STRETCH';r2.primaryAxisSizingMode='FIXED';\nconst amt=txt('₹85,625',34,'Bold','FFFFFF',40);amt.name='Amount';amt.letterSpacing={value:-1,unit:'PERCENT'};r2.appendChild(amt);\nconst ibSet=await figma.getNodeByIdAsync('10:41');const rb=ibSet.children.find(c=>c.name==='Tone=OnBrand, State=Default').createInstance();rb.name='Refresh Button';r2.appendChild(rb);\nconst rbIcon=rb.findOne(n=>n.name==='Icon');rbIcon.swapComponent(await figma.getNodeByIdAsync(M.Refresh));rbIcon.findAll(n=>n.type==='VECTOR').forEach(v=>v.strokes=[solid('FFFFFF')]);\nsec.appendChild(bc);ids.balance=bc.id;\n// Action buttons\nsec=section('Action Button · Type × State');\nlet cs=[];\nfor(const [type,ic,tint,fg] of [['Send','Send',T.brandTint,T.brand],['Receive','Receive',T.posTint,T.pos]])for(const state of ['Default','Pressed']){const c=comp(`Type=${type}, State=${state}`,'HORIZONTAL',{gap:12,px:12,py:10,fill:state==='Pressed'?T.bg:'FFFFFF',r:16});c.primaryAxisSizingMode='FIXED';c.resize(171,56);c.strokes=[solid(T.border)];c.strokeAlign='INSIDE';if(state==='Default')c.effects=[sh1];\n const circ=af('Icon circle','HORIZONTAL',{fill:tint,r:18});circ.primaryAxisAlignItems='CENTER';circ.counterAxisAlignItems='CENTER';circ.primaryAxisSizingMode='FIXED';circ.counterAxisSizingMode='FIXED';circ.resize(36,36);circ.appendChild(await icon(ic,fg,20));c.appendChild(circ);\n c.appendChild(txt(type,15,'Semi Bold',T.ink,20));cs.push(c);}\nids.action=setify(cs,sec,'Action Button').id;\n// Account tile\nsec=section('Account Tile · State (bank mark swappable)');\ncs=[];\nfor(const state of ['Default','Pressed']){const c=comp('State='+state,'HORIZONTAL',{gap:10,px:12,py:12,fill:state==='Pressed'?T.bg:'FFFFFF',r:16});c.primaryAxisSizingMode='FIXED';c.resize(175,64);c.strokes=[solid(state==='Pressed'?T.brand:T.border)];c.strokeAlign='INSIDE';\n const mk=(await figma.getNodeByIdAsync('11:56')).createInstance();mk.name='Mark';c.appendChild(mk);\n const tc=af('Text','VERTICAL',{gap:2});c.appendChild(tc);tc.layoutGrow=1;\n const n=txt('Axis Bank',13,'Medium',T.text2,18);n.name='Bank name';tc.appendChild(n);const b=txt('₹3,500',15,'Semi Bold',T.ink,20);b.name='Balance';tc.appendChild(b);\n const p1=c.addComponentProperty('Bank name','TEXT','Axis Bank');n.componentPropertyReferences={characters:p1};\n const p2=c.addComponentProperty('Balance','TEXT','₹3,500');b.componentPropertyReferences={characters:p2};\n const p3=c.addComponentProperty('Mark','INSTANCE_SWAP','11:56',{preferredValues:['11:56','11:59','11:66','11:70'].map(k=>({type:'COMPONENT',key:figma.getNodeById?'' :''})).filter(()=>false)});mk.componentPropertyReferences={mainComponent:p3};\n cs.push(c);}\nids.tile=setify(cs,sec,'Account Tile').id;\nreturn JSON.stringify(ids);","description":"Create balance card, action buttons, account tile","fileKey":"MBJGR6pcP8R2URhIN3ARYg"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":69,"cache_creation_input_tokens":636,"cache_read_input_tokens":46071,"cache_creation":{"ephemeral_5m_input_tokens":636,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"624c2a9a-654c-44d2-8d05-3d341d78f1b2","uuid":"58a95b54-a576-4003-85fc-532b0da817c3","timestamp":"2026-10-31T