: 'SOLID', color: hex(h), opacity: o === undefined ? 1 : o });\nasync function inst(id) { return (await figma.getNodeByIdAsync(id)).createInstance(); }\nasync function icon(id, size, tint) { /* instance, resize, fills=[], walk descendants set fills=[S(tint)] skipping INSTANCE nodes */ }\nconst RATING = { '5.0': '9:11', '4.5': '9:27', '4.0': '9:43', '3.5': '9:59', '3.0': '9:75' };\nasync function makeCard(d) { // d = {n, r, pr, old?, dc?, p}\n  const c = await inst('11:2');\n  c.setProperties({ 'Photo#11:0': d.p, 'Rating#11:1': RATING[d.r], 'Name#11:2': d.n, 'Score#11:3': d.r + '/5',\n    'Price#11:4': d.pr, 'OldPrice#11:5': d.old || '$0', 'Discount#11:6': d.dc || '-0%',\n    'ShowOld#11:7': !!d.old, 'ShowDiscount#11:8': !!d.old });\n  c.children[0].children[0].resize(187, 280); // re-fix photo size after swap\n  return c;\n}\n```\n   - Header current-state override (used on 02; reuse on 03):\n```js\nconst nav = hd.children.find(c => c.name === 'nav');\nfor (const it of nav.children) {\n  const label = it.findOne(n => n.name === 'label');\n  if (it.name === 'nav-Shop') { label.fills = [S('#000000')]; label.textDecoration = 'UNDERLINE'; }\n  else { label.fills = [S('#616161')]; }\n}\n```\n   - NEVER call resize() on an auto-layout frame that must hug — or re-set `primaryAxisSizingMode='AUTO'` (and counterAxis for H-layouts) afterward.\n\n4. Errors and fixes:\n   - **mkArrowChip missing await** (S4 part 1): `const ic = iconInst(...)` returned a Promise → \"in appendChild: The node with id \\\"undefined\\\" does not exist\" → fixed by making mkArrowChip async and awaiting iconInst. CRITICAL LESSON: the whole failed script ROLLED BACK — Hero/Brand Strip/Filter Panel were silently not created (confirmed empty scan + removed:[] orphan cleanup); had to recreate all three in a new script.\n   - **resize() forces FIXED sizing modes**: after `resize(1240,10)` on hug-intended containers, heights stuck (sections 10px, content 104, frame 200; confirmed via sizing-mode read: all F