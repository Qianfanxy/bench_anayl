bs) {\n  const a = mk('Tab / ' + tab + ' Active', 88, 56, tx, 1620);\n  const pill = figma.createRectangle(); pill.resize(56,30); pill.x=16; pill.y=0; pill.cornerRadius=15; pill.fills=[S(LIME)]; pill.name='Pill'; a.appendChild(pill);\n  const ic = await icon(icName, 20, DARK, 1.6); ic.x=34; ic.y=5; a.appendChild(ic);\n  const l = T(tab, 11, 'Bold', DARK, {name:'Label', align:'CENTER'}); l.textAutoResize='HEIGHT'; l.resize(88, l.height); l.x=0; l.y=37; a.appendChild(l);\n  out.comps['tabOn_' + tab] = a.id;\n  const b = mk('Tab / ' + tab + ' Inactive', 88, 56, tx, 1700);\n  const ic2 = await icon(icName, 22, TER, 1.5); ic2.x=33; ic2.y=3; b.appendChild(ic2);\n  const l2 = T(tab, 11, 'Regular', TER, {name:'Label', align:'CENTER'}); l2.textAutoResize='HEIGHT'; l2.resize(88, l2.height); l2.x=0; l2.y=37; b.appendChild(l2);\n  out.comps['tabOff_' + tab] = b.id;\n  tx += 96;\n}\n// Tab bar\n{\n  const c = mk('Tab Bar', 390, 88, 1600, 1620); c.fills=[S(WHITE)];\n  c.topLeftRadius=24; c.topRightRadius=24; sh(c,0.10,8,28);\n  const items = [['Home', out.comps['tabOff_Home']], ['Explore', out.comps['tabOff_Explore']], ['Analytics', out.comps['tabOff_Analytics']], ['Profile', out.comps['tabOff_Profile']]];\n  let x = 19;\n  for (const [nm, id] of items) { const i = (await figma.getNodeByIdAsync(id)).createInstance(); i.x=x; i.y=10; i.name=nm; c.appendChild(i); x += 88; }\n  out.comps.tabBar = c.id;\n}\n// Button variants\n{\n  const src = await figma.getNodeByIdAsync('9:2');\n  const pr = src.clone(); page.appendChild(pr); pr.name='Button / Pressed'; pr.x=0; pr.y=1700;\n  pr.fills=[S('#A5DB33')];\n  const pt = pr.findOne(n => n.type==='TEXT'); pt.fills=[S(DARK)];\n  out.comps.btnPressed = pr.id;\n  const di = src.clone(); page.appendChild(di); di.name='Button / Disabled'; di.x=400; di.y=1700;\n  di.fills=[S('#E4E7E3')];\n  const dt = di.findOne(n => n.type==='TEXT'); dt.fills=[S(TER)];\n  out.comps.btnDisabled = di.id;\n}\nreturn JSON.stringify(out);","description":"Create reusab