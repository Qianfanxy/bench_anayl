"Section Header\"].createInstance();parent.appendChild(si);si.x=24;si.y=y;si.findOne(n=>n.name===\"Title\").characters=title;return si;}\nsechead(f5,353,\"Exclusive Offer\");\nsechead(f5,618,\"Best Selling\");\nsechead(f5,883,\"Groceries\");\nprodCard(f5,24,658,null,\"Bell Pepper Red\",\"1kg, Price\",\"$4.99\",\"Product_Bell_Pepper_Red\");\nprodCard(f5,219,658,null,\"Ginger\",\"250gm, Price\",\"$2.99\",\"Product_Ginger\");\nfunction catChip(parent,x,y,name,title,imgName,tint){const cc=MASTER[\"Category Chip\"].createInstance();parent.appendChild(cc);cc.x=x;cc.y=y;if(name)cc.name=name;cc.fills=[F(tint)];cc.findOne(n=>n.name===\"Label\").characters=title;const p=cc.findOne(n=>n.name===\"Photo\");p.swapComponent(MASTER[imgName]);const s=Math.min(40/MASTER[imgName].width,40/MASTER[imgName].height);p.resize(MASTER[imgName].width*s,MASTER[imgName].height*s);p.x=12;p.y=12;return cc;}\ncatChip(f5,24,923,null,\"Pulses\",\"Category_Pulses\",\"#EAF2EA\"?);\n```\nHmm chip tints: Pulses → light green #EAF6E9? Rice → #FFF6E0? I'll use Pulses #EAF6E9, Rice #F7F0E8... Actually keep consistent with explore palette: Pulses #EAF6E9, Rice #FFF6E0.\n\nWait — unit lines: brief says format \"1kg, Price\" for products. For Organic Bananas \"7pcs\" → \"7pcs, Price\". Ginger \"250gm, Price\". Good.\n\nThen chips row: two chips side by side (171 wide, gap 24): x24, x219. y923 height 64 → 987.\n\nProducts row y1011: Beef Bone, Broiler Chicken.\n\n```js\nprodCard(f5,24,1011,null,\"Beef Bone\",\"1kg, Price\",\"$4.99\",\"Product_Beef_Bone\");\nprodCard(f5,219,1011,null,\"Broiler Chicken\",\"1kg, Price\",\"$4.99\",\"Product_Broiler_Chicken\");\nconst tb=tabInst(f5,\"Shop\",1230);\nhomeInd(f5,false,false);\n```\n\ntabInst helper:\n```js\nfunction tabInst(parent,active,y){const TB=figma.root.findOne(n=>n.type===\"COMPONENT_SET\"&&n.name===\"Tab Bar\");const v=TB.children.find(c=>c.name===\"ActiveTab=\"+active);const inst=v.createInstance();parent.appendChild(inst);inst.x=0;inst.y=y;return inst;}\n``