tNodeByIdAsync(id); return comps[id]; }\nasync function inst(id,w,h){ const c=await comp(id); const i=c.createInstance(); if(w&&h) i.resize(w,h); return i; }\nasync function icon(id,size,colorHex){ const c=await comp(id); const i=c.createInstance(); const s=size/Math.max(c.width,c.height); i.rescale(s); if(colorHex){ const rec=n=>{ if('fills' in n && Array.isArray(n.fills) && n.fills.some(f=>f.type==='SOLID')) n.fills=[sol(colorHex)]; if('children' in n) n.children.forEach(rec); }; rec(i);} return i; }\nfunction stretchFill(parent,n){ parent.appendChild(n); n.layoutAlign='STRETCH'; n.primaryAxisSizingMode='FIXED'; n.counterAxisSizingMode='AUTO'; }\n\nconst cmp=figma.createFrame(); cmp.name='05_Comparison'; cmp.resize(1440,100); cmp.fills=[sol(C.white)];\ncmp.layoutMode='VERTICAL'; cmp.itemSpacing=0; cmp.primaryAxisSizingMode='AUTO'; cmp.counterAxisSizingMode='FIXED'; cmp.clipsContent=true;\nconst hI=(await comp('18:2')).createInstance(); hI.layoutAlign='STRETCH'; cmp.appendChild(hI);\nconst bI=(await comp('18:20')).createInstance(); bI.layoutAlign='STRETCH'; cmp.appendChild(bI);\nbI.findOne(n=>n.name==='Title').characters='Product Comparison';\nbI.findOne(n=>n.name==='Crumb current').characters='Comparison';\n\nconst head=fr('Compare head'); head.fills=[sol(C.white)]; al(head,{mode:'HORIZONTAL',gap:60,pad:[40,100,40,100]});\nconst leftCol=fr('Intro col'); al(leftCol,{mode:'VERTICAL',gap:22,cross:'MIN',main:'CENTER'}); leftCol.resize(230,260); leftCol.primaryAxisSizingMode='AUTO'; leftCol.counterAxisSizingMode='FIXED';\nleftCol.appendChild(txt('Go to Product page for more Products',28,F.sb,C.dark,{w:224,lh:125}));\nconst vm=fr('ViewMore'); al(vm,{mode:'VERTICAL',gap:2}); vm.appendChild(txt('View More',20,F.med,C.gray,{name:'View More'})); const vmLine=figma.createRectangle(); vmLine.resize(93,1); vmLine.fills=[sol(C.gray)]; vm.appendChild(vmLine);\nleftCol.appendChild(vm); head.appendChild(leftCol);\nconst prodCard=async(pid,name,price,rating,reviews)=>{\n  const c=fr('Cmp/'+name); al(c,{mode:'VERTICAL',gap:14});\n  const p=await inst(pid,280,177); p.cornerRadius=10; c.appendChild(p);\n  c.appendChild(txt(name,24,F.med,C.ink,{name:'Name'}));\n  c.appendChild(txt(price,18,F.med,C.ink,{name:'Price'}));\n  const rr=fr('Rating row'); al(rr,{mode:'HORIZONTAL',gap:8,cross:'CENTER'});\n  rr.appendChild(txt(rating,18,F.med,C.ink));\n  rr.appendChild(await icon('13:31',18));\n  const sr=figma.createRectangle(); sr.resize(1,24); sr.fills=[sol(C.muted)]; rr.appendChild(sr);\n  rr.appendChild(txt(reviews,13,F.reg,C.muted));\n  c.appendChild(rr);\n  const atc=fr('Add To Cart'); atc.fills=[sol(C.gold)]; al(atc,{mode:'HORIZONTAL',pad:[14,36,14,36]}); atc.appendChild(txt('Add To Cart',16,F.med,C.white)); c.appendChild(atc);\n  return c;\n};\nhead.appendChild(await prodCard('13:4','Asgaard Sofa','Rs. 250,000.00','4.7','204 Review'));\nhead.appendChild(await prodCard('13:14','Outdoor Sofa Set','Rs. 224,000.00','4.2','145 Review'));\nconst addCol=fr('Add product col'); al(addCol,{mode:'VERTICAL',gap:14,cross:'MIN',main:'CENTER'}); addCol.resize(240,260); addCol.primaryAxisSizingMode='AUTO'; addCol.counterAxisSizingMode='FIXED';\naddCol.appendChild(txt('Add A Product',24,F.sb,C.gold));\nconst choose=fr('ChooseBtn'); choose.fills=[sol(C.gold)]; choose.cornerRadius=6; al(choose,{mode:'HORIZONTAL',main:'SPACE_BETWEEN',cross:'CENTER',pad:[16,20,16,20]}); choose.primaryAxisSizingMode='FIXED'; choose.resize(242,56);\nchoose.appendChild(txt('Choose a Product',16,F.sb,C.white,{name:'Choose label'})); choose.appendChild(await icon('13:30',20,C.white));\naddCol.appendChild(choose); head.appendChild(addCol);\nstretchFill(cmp,head);\n\nconst table=fr('Specifications'); table.fills=[sol(C.white)]; al(table,{mode:'VERTICAL',gap:34,pad:[20,100,60,100]});\nconst ROWS=[\n ['General',null,null],\n ['Sales Package','1 sectional sofa','1 Three Seater, 2 Single Seater'],\n ['Model Number','TFCBLIGRBL6SRHS','DTUBLIGRBL568'],\n ['Secondary Material','Solid Wood','Solid 