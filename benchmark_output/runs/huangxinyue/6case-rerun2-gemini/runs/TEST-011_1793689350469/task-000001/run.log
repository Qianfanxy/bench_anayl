 vdTxt.x = 20; vdTxt.y = 40; procBar.appendChild(vdTxt);\n\n  const btnProceed = figma.createFrame(); btnProceed.name = \"Proceed to Payment\";\n  btnProceed.resize(180, 45); btnProceed.x = 175; btnProceed.y = 12; btnProceed.cornerRadius = 6;\n  btnProceed.fills = [{ type: 'SOLID', color: { r: 0.97, g: 0.22, b: 0.35 } }];\n  const ptxt = figma.createText(); ptxt.fontName = { family: \"Montserrat\", style: \"Bold\" }; ptxt.fontSize = 14; ptxt.characters = \"Proceed to Payment\"; ptxt.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  ptxt.x = (180 - ptxt.width) / 2; ptxt.y = 14; btnProceed.appendChild(ptxt);\n  procBar.appendChild(btnProceed);\n\n  f12.appendChild(procBar);\n\n  // 13_Payment\n  const f13 = figma.createFrame();\n  f13.name = '13_Payment';\n  f13.resize(375, 812);\n  f13.x = 5040; f13.y = 0;\n  f13.fills = [{ type: 'SOLID', color: { r: 0.98, g: 0.98, b: 0.98 } }];\n  createStatusAndHome(f13);\n\n  const top13 = figma.createFrame();\n  top13.resize(343, 40); top13.x = 16; top13.y = 50; top13.fills = [];\n  const b13 = createInstanceByName('Icon_Back', top13); if (b13) { b13.x = 0; b13.y = 8; b13.name = 'back'; }\n  const t13 = figma.createText(); t13.fontName = { family: \"Montserrat\", style: \"Bold\" }; t13.fontSize = 18; t13.characters = \"Checkout\"; t13.x = (343 - t13.width) / 2; t13.y = 8; top13.appendChild(t13);\n  f13.appendChild(top13);\n\n  const sumBox = figma.createFrame();\n  sumBox.name = \"Payment Summary\";\n  sumBox.resize(343, 100); sumBox.x = 16; sumBox.y = 100; sumBox.cornerRadius = 8;\n  sumBox.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  const s1 = figma.createText(); s1.fontName = { family: \"Montserrat\", style: \"Regular\" }; s1.fontSize = 14; s1.characters = \"Order                                          ₹7,000\"; s1.x = 16; s1.y = 15; sumBox.appendChild(s1);\n  const s2 = figma.createText(); s2.fontName = { family: \"Montserrat\", style: \"Regular\" }; s2.fontSize = 14; s2.characters = \"Shipping  