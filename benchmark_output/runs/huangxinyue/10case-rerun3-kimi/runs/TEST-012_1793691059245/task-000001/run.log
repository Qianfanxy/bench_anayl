d:to.id,navigation:'NAVIGATE',transition:{type:'MOVE_OUT',direction:'RIGHT',duration:0.25,easing:{type:'EASE_IN'}},preserveScrollPosition:false}]});\n\nlet n=0;\nfunction setRx(node,rx){if(node){node.reactions=rx;n++;}}\n// 01 Welcome\nsetRx(W.findOne(n=>n.name==='Link/SignUp'),[overlay(W,S)]);\n// 02 Sheet\nsetRx(S.findOne(n=>n.name==='Button/FaceID'),[tap(S,E)]);\nsetRx(S.findOne(n=>n.name==='Icon/Close'),[closeBack(S,W)]);\n// 03 Explore\nsetRx(E.findOne(n=>n.name==='Story/Claire'),[tapT(E,CL)]);\nconst tbE=E.findOne(n=>n.name.startsWith('TabBar'));\nsetRx(tbE.findOne(n=>n.name==='Icon/Dating'),[tapT(E,FP)]);\nsetRx(tbE.findOne(n=>n.name==='Label/Dating'),[tapT(E,FP)]);\nsetRx(tbE.findOne(n=>n.name==='Avatar/Profile'),[tapT(E,PR)]);\nsetRx(tbE.findOne(n=>n.name==='Label/Profile'),[tapT(E,PR)]);\n// 04 Find Partner\nsetRx(FP.findOne(n=>n.name==='Icon/Back'),[tap(FP,E)]);\nconst tbF=FP.findOne(n=>n.name.startsWith('TabBar'));\nsetRx(tbF.findOne(n=>n.name==='Icon/Home'),[tap(FP,E)]);\nsetRx(tbF.findOne(n=>n.name==='Label/Home'),[tap(FP,E)]);\nsetRx(tbF.findOne(n=>n.name==='Avatar/Profile'),[tapT(FP,PR)]);\nsetRx(tbF.findOne(n=>n.name==='Label/Profile'),[tapT(FP,PR)]);\n// 05 Claire profile\nsetRx(CL.findOne(n=>n.name==='Icon/Left'),[tap(CL,E)]);\nsetRx(CL.findOne(n=>n.name==='Tab/Short'),[tapT(CL,SV)]);\n// 06 Short video\nsetRx(SV.findOne(n=>n.name==='Icon/Back'),[tap(SV,CL,{transition:{type:'MOVE_OUT',direction:'RIGHT',duration:0.3,easing:{type:'EASE_IN'}}})]);\n// 07 Profile\nsetRx(PR.findOne(n=>n.name==='Icon/Left'),[overlayL(PR,M)]);\nconst tbP=PR.findOne(n=>n.name.startsWith('TabBar'));\nsetRx(tbP.findOne(n=>n.name==='Icon/Home'),[tap(PR,E)]);\nsetRx(tbP.findOne(n=>n.name==='Label/Home'),[tap(PR,E)]);\n// 08 Menu\nsetRx(M.findOne(n=>n.name==='Icon/Close'),[closeBackL(M,PR)]);\nsetRx(M.findOne(n=>n.name==='Link/ShowProfile'),[closeBackL(M,PR)]);\nsetRx(M.findOne(n=>n.name==='Scrim'),[closeBackL(M,PR)]);\nreturn {wired:n};\n","description":"Wire all prototype interactions per brief: sign-in flow, tab bar links, story/profile/short push, sheet and drawer overlays","fileKey":"5xY0YjB6IWmTqgOsns9U6t"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"ed8da9f8-6f65-452e-96bf-8860e9b0c5f8","uuid":"a270f113-ce24-4602-ad35-aa40e6706c2c","timestamp":"2026-11-03T08:11:33.713Z","tool_use_meta":[{"id":"mcp__figma__use_figma_0_bfd9dde7","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
