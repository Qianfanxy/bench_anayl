,[NAV(PR,smart(0.3))],'FP.profile');\nsetRx(CL.findOne(n=>n.name==='Icon/Left'),[NAV(E,smart(0.3))],'CL.back');\nsetRx(CL.findOne(n=>n.name==='Tab/Short'),[NAV(SV,smart(0.35))],'CL.short');\nsetRx(SV.findOne(n=>n.name==='Icon/Back'),[NAV(CL,smart(0.3))],'SV.back');\nsetRx(PR.findOne(n=>n.name==='Icon/Left'),[OVL(M)],'PR.menu');\nconst tbP=PR.findOne(n=>n.name.startsWith('TabBar'));\nsetRx(tbP.findOne(n=>n.name==='Icon/Home'),[NAV(E,smart(0.3))],'PR.home');\nsetRx(M.findOne(n=>n.name==='Icon/Close'),[NAV(PR,smart(0.3))],'M.close');\nsetRx(M.findOne(n=>n.name==='Link/ShowProfile'),[NAV(PR,smart(0.3))],'M.showprofile');\nsetRx(M.findOne(n=>n.name==='Scrim'),[NAV(PR,smart(0.3))],'M.scrim');\nreturn {wired:n,missed};\n","description":"Wire prototype links with corrected easing enum EASE_IN_AND_OUT","fileKey":"5xY0YjB6IWmTqgOsns9U6t"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"ed8da9f8-6f65-452e-96bf-8860e9b0c5f8","uuid":"85d620e6-8dfc-49f3-be5a-f0a301e1bc55","timestamp":"2026-11-03T08:17:58.522Z","tool_use_meta":[{"id":"mcp__figma__use_figma_0_3e4cce25","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
