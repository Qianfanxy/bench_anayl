{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_760759fb8a30481782faa474","name":"mcp__figma__use_figma","input":{"code":"const page = await figma.getNodeByIdAsync('5:2');\nfor (const s of ['Regular','Medium','SemiBold','Bold']) await figma.loadFontAsync({family:'Roboto',style:s});\nconst C = {\n  bg:{r:0.047,g:0.055,b:0.051}, s1:{r:0.086,g:0.102,b:0.094}, s2:{r:0.118,g:0.137,b:0.129}, s3:{r:0.149,g:0.173,b:0.161},\n  line:{r:0.153,g:0.176,b:0.165}, txt:{r:0.949,g:0.949,b:0.949}, sec:{r:0.663,g:0.698,b:0.675}, ter:{r:0.439,g:0.478,b:0.455},\n  brand:{r:0.153,g:0.588,b:0.275}, brandB:{r:0.180,g:0.682,b:0.325}, gain:{r:0.243,g:0.812,b:0.494}, loss:{r:0.965,g:0.357,b:0.357}, white:{r:1,g:1,b:1}\n};\nconst solid=(c,o)=>({type:'SOLID',color:c,opacity:(o===undefined?1:o)});\nconst ICON={chevR:'2:48',copy:'2:91',atm:'2:69'};\nconst IC={}; for(const k in ICON){ IC[k]=await figma.getNodeByIdAsync(ICON[k]); }\nfunction T(chars,size,style,color,name,lh){ const t=figma.createText(); t.fontName={family:'Roboto',style}; t.fontSize=size; t.characters=chars; t.fills=[solid(color)]; if(name)t.name=name; if(lh)t.lineHeight={value:lh,unit:'PIXELS'}; return t; }\nfunction ic(key,size,color,name){ const i=IC[key].createInstance(); if(size&&Math.abs(size-IC[key].width)>0.01) i.rescale(size/IC[key].width); if(color){const v=i.findOne(n=>n.type==='VECTOR'); if(v)v.fills=[solid(color)];} if(name)i.name=name; return i; }\nconst created=[];\n\n// Method Row\nconst mr=figma.createComponent(); page.appendChild(mr); mr.name='Method Row'; mr.resize(343,60);\nmr.layoutMode='HORIZONTAL'; mr.counterAxisAlignItems='CENTER'; mr.itemSpacing=12; mr.paddingLeft=12; mr.paddingRight=14; mr.cornerRadius=12; mr.fills=[solid(C.s1)];\nconst tile=figma.createFrame(); tile.name='Tile'; tile.fills=[solid(C.s2)]; tile.cornerRadius=10; tile.layoutMode='HORIZONTAL'; tile.resize(40,40); tile.primaryAxisAlignItems='CENTER'; tile.counterAxisAlignItems='CENTER';\ntile.appendChild(ic('atm',20,C.txt,'Icon'));\nmr.appendChild(tile);\nmr.appendChild(T('ATM',15,'Medium',C.txt,'Label')); mr.children[1].layoutGrow=1;\nmr.appendChild(ic('chevR',18,C.ter,'Chevron'));\ncreated.push('Method Row '+mr.id);\n\n// Amount Option variants\nfunction amountOpt(state){\n  const c=figma.createComponent(); page.appendChild(c); c.name='State='+state;\n  c.layoutMode='HORIZONTAL'; c.resize(165,44); c.counterAxisAlignItems='CENTER'; c.itemSpacing=10; c.paddingLeft=12; c.paddingRight=12; c.cornerRadius=12; c.fills=[solid(C.s1)];\n  if(state==='Selected'){ c.strokes=[solid(C.brand)]; c.strokeWeight=1.5; }\n  const radio=figma.createFrame(); radio.name='Radio'; radio.fills=[]; radio.resize(18,18); radio.cornerRadius=999;\n  if(state==='Selected'){ radio.fills=[solid(C.brand)]; const dot=figma.createEllipse(); dot.name='Dot'; dot.resize(6,6); dot.x=6; dot.y=6; dot.fills=[solid(C.white)]; radio.appendChild(dot); }\n  else { radio.fills=[]; radio.strokes=[solid(C.ter)]; radio.strokeWeight=1.5; }\n  c.appendChild(radio);\n  c.appendChild(T('Rp500.000',14,'Medium',state==='Selected'?C.txt:C.sec,'Label'));\n  return c;\n}\nconst aoSet=figma.combineAsVariants([amountOpt('Default'),amountOpt('Selected')],page); aoSet.name='Amount Option';\ncreated.push('Amount Option '+aoSet.id);\n\n// Stepper\nconst sp=figma.createComponent(); page.appendChild(sp); sp.name='Stepper';\nsp.layoutMode='HORIZONTAL'; sp.counterAxisAlignItems='CENTER'; sp.itemSpacing=8;\nfunction stepNode(n,active,label){\n  const g=figma.createFrame(); g.name='Step '+n; g.fills=[]; g.layoutMode='HORIZONTAL'; g.itemSpacing=6; g.counterAxisAlignItems='CENTER';\n  const c=figma.createFrame(); c.name='Circle'; c.resize(22,22); c.cornerRadius=999;\n  c.layoutMode='HORIZONTAL'; c.primaryAxisAlignItems='CENTER'; c.counterAxisAlignItems='CENTER';\n  if(active){ c.fills=[solid(C.brand)]; c.appendChild(T(String(n),11,'SemiBold',C.white,'Num')); }\n  else { c.fills=[solid(C.s2)]; c.strokes=[solid(C.line)]; c.strokeWeight=1; c.appendChild(T(String(n),11,'Medium',C.ter,'Num')); }\n  g.appendChild(c);\n  g.appendChild(T(label,11,'Medium',active?C.txt:C.ter,'Label'));\n  return g;\n}\nsp.appendChild(stepNode(1,true,'Masukkan Nominal'));\nconst conn=figma.createRectangle(); conn.name='Connector'; conn.resize(20,1.5); conn.fills=[solid(C.line)]; sp.appendChild(conn);\nsp.appendChild(stepNode(2,false,'Pembayaran'));\ncreated.push('Stepper '+sp.id);\n\n// Key Stat Cell\nconst ks=figma.createComponent(); page.appendChild(ks); ks.name='Key Stat Cell';\nks.layoutMode='VERTICAL'; ks.resize(165,40); ks.itemSpacing=3;\nks.appendChild(T('Previous Close',10,'Regular',C.ter,'Stat Label'));\nks.appendChild(T('Rp198',13,'Medium',C.txt,'Stat Value'));\ncreated.push('Key Stat Cell '+ks.id);\n\n// Compare Row\nconst cr=figma.createComponent(); page.appendChild(cr); cr.name='Compare Row'; cr.resize(343,44);\ncr.layoutMode='HORIZONTAL'; cr.counterAxisAlignItems='CENTER'; cr.itemSpacing=8; cr.fills=[];\nconst cl=figma.createFrame(); cl.name='Left'; cl.fills=[]; cl.layoutMode='VERTICAL'; cl.itemSpacing=2;\ncl.appendChild(T('Bukalapak Tbk',13,'Regular',C.txt,'Company'));\ncl.appendChild(T('BUKA',11,'Medium',C.ter,'Ticker'));\ncr.appendChild(cl); cl.layoutGrow=1;\nconst crv=figma.createFrame(); crv.name='Values'; crv.fills=[]; crv.layoutMode='VERTICAL'; crv.itemSpacing=2; crv.counterAxisAlignItems='MAX';\ncrv.appendChild(T('Rp276',13,'Medium',C.txt,'Price'));\ncrv.appendChild(T('+2,82%',11,'Medium',C.gain,'Change'));\ncr.appendChild(crv);\ncreated.push('Compare Row '+cr.id);\n\n// Payment Row variants\nfunction payRow(withCopy){\n  const c=figma.createComponent(); page.appendChild(c); c.name='Type='+(withCopy?'Copy':'Basic');\n  c.layoutMode='VERTICAL'; c.resize(343,c.height); c.itemSpacing=5;\n  c.appendChild(T('No Transaksi',11,'Medium',C.ter,'Label'));\n  const vr=figma.createFrame(); vr.name='ValueRow'; vr.fills=[]; vr.layoutMode='HORIZONTAL'; vr.itemSpacing=8; vr.counterAxisAlignItems='CENTER';\n  const val=T('FD8U4J38J0040