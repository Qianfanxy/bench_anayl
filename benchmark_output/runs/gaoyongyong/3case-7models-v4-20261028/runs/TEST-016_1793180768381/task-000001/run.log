mily:'Roboto',style:st}; s.fontSize=sz; s.lineHeight={value:lh,unit:'PIXELS'}; s.letterSpacing={value:0,unit:'PIXELS'};}\nconst es=await figma.getLocalEffectStylesAsync();\nconst mk=(name,effects)=>{let s=es.find(e=>e.name===name); if(!s){s=figma.createEffectStyle(); s.name=name;} s.effects=effects;};\nmk('Foodgo/Elevation 1',[{type:'DROP_SHADOW',color:{r:0.235,g:0.184,b:0.184,a:0.08},offset:{x:0,y:6},radius:20,spread:0,visible:true,blendMode:'NORMAL'}]);\nmk('Foodgo/Elevation 2',[{type:'DROP_SHADOW',color:{r:0.235,g:0.184,b:0.184,a:0.18},offset:{x:0,y:12},radius:32,spread:0,visible:true,blendMode:'NORMAL'}]);\nmk('Foodgo/Elevation Red',[{type:'DROP_SHADOW',color:{r:0.937,g:0.165,b:0.224,a:0.35},offset:{x:0,y:8},radius:20,spread:0,visible:true,blendMode:'NORMAL'}]);\nreturn 'ok '+(await figma.variables.getLocalVariablesAsync('COLOR')).length;","description":"Create color variables, text styles, effect styles"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":10454,"cache_read_input_tokens":24188,"cache_creation":{"ephemeral_5m_input_tokens":10454,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"68e3acd5-653d-48c8-9466-97ca92f6c51b","uuid":"cf384f30-faf7-4f62-a198-5838bbf072c9","timestamp":"2026-10-28T09:48:54.898Z","tool_use_meta":[{"id":"toolu_bdrk_01HTReTL5AEdyLjcJo36Rxiv","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
