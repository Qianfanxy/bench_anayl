r\" };\n  rangeSubtitle.fontSize = 20;\n  rangeSubtitle.characters = \"Find the right pieces for every room in your home.\";\n  rangeSubtitle.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n  rangeSubtitle.x = (1185 - rangeSubtitle.width) / 2;\n  rangeSubtitle.y = 48;\n  rangeSec.appendChild(rangeSubtitle);\n\n  // 3 range items: Dining, Living, Bedroom\n  const ranges = [\n    { title: \"Dining\", photo: \"Photo_Range_Dining\" },\n    { title: \"Living\", photo: \"Photo_Range_Living\" },\n    { title: \"Bedroom\", photo: \"Photo_Range_Bedroom\" }\n  ];\n\n  ranges.forEach((rng, index) => {\n    const item = figma.createFrame();\n    item.name = rng.title;\n    item.resize(381, 520);\n    item.x = index * 402;\n    item.y = 120;\n    item.fills = [];\n\n    const img = createAssetInstance(mediaMap[rng.photo]);\n    img.resize(381, 480);\n    img.cornerRadius = 10;\n    item.appendChild(img);\n\n    const lbl = figma.createText();\n    lbl.fontName = { family: \"Poppins\", style: \"Semi Bold\" };\n    lbl.fontSize = 24;\n    lbl.characters = rng.title;\n    lbl.fills = [{ type: 'SOLID', color: DARK }];\n    lbl.x = (381 - lbl.width) / 2;\n    lbl.y = 496;\n    item.appendChild(lbl);\n\n    rangeSec.appendChild(item);\n  });\n  home.appendChild(rangeSec);\n\n  // 4. Our Products Section\n  const prodSec = figma.createFrame();\n  prodSec.name = \"Our Products\";\n  prodSec.resize(1238, 1021);\n  prodSec.x = 102;\n  prodSec.y = 1600;\n  prodSec.fills = [];\n\n  const prodTitle = figma.createText();\n  prodTitle.fontName = { family: \"Poppins\", style: \"Bold\" };\n  prodTitle.fontSize = 40;\n  prodTitle.characters = \"Our Products\";\n  prodTitle.fills = [{ type: 'SOLID', color: DARK }];\n  prodTitle.x = (1238 - prodTitle.width) / 2;\n  prodTitle.y = 0;\n  prodSec.appendChild(prodTitle);\n\n  // Grid of 8 products (4x2)\n  productDataList.forEach((prod, idx) => {\n    const isLeviosaHover = prod.name === \"Leviosa\"; // Hover state requested for Leviosa card\n    const card = buildProductCard(prod, isLeviosaHover);\n    const col = idx % 4;\n    const row = Math.floor(idx / 4);\n    card.x = col * 317;\n    card.y = 80 + row * 478;\n    prodSec.appendChild(card);\n  });\n\n  // Show More Button\n  const showMore = figma.createFrame();\n  showMore.name = \"Show More Button\";\n  showMore.resize(245, 48);\n  showMore.strokes = [{ type: 'SOLID', color: GOLD }];\n  showMore.strokeWeight = 1;\n  showMore.fills = [{ type: 'SOLID', color: WHITE }];\n  const smTxt = figma.createText();\n  smTxt.fontName = { family: \"Poppins\", style: \"Semi Bold\" };\n  smTxt.fontSize = 16;\n  smTxt.characters = \"Show More\";\n  smTxt.fills = [{ type: 'SOLID', color: GOLD }];\n  showMore.appendChild(smTxt);\n  smTxt.x = (245 - smTxt.width) / 2;\n  smTxt.y = (48 - smTxt.height) / 2;\n  showMore.x = (1238 - 245) / 2;\n  showMore.y = 973;\n  prodSec.appendChild(showMore);\n\n  home.appendChild(prodSec);\n\n  // 5. Inspiration Section (at the bottom/middle)\n  // Let's adjust page height to fit inspiration and setup\n  home.resize(1440, 4300);\n\n  const inspSec = figma.createFrame();\n  inspSec.name = \"Inspiration Section\";\n  inspSec.resize(1440, 670);\n  inspSec.x = 0;\n  inspSec.y = 2670;\n  inspSec.fills = [{ type: 'SOLID', color: { r: 0.99, g: 0.98, b: 0.96 } }];\n\n  // Left Content Col\n  const inspLeft = figma.createFrame();\n  inspLeft.name = \"Left Content\";\n  inspLeft.layoutMode = \"VERTICAL\";\n  inspLeft.itemSpacing = 25;\n  inspLeft.fills = [];\n\n  const inspTitle = figma.createText();\n  inspTitle.fontName = { family: \"Poppins\", style: \"Bold\" };\n  inspTitle.fontSize = 40;\n  inspTitle.characters = \"50+ Beautiful rooms\\ninspiration\";\n  inspTitle.fills = [{ type: 'SOLID', color: DARK }];\n  inspLeft.appendChild(inspTitle);\n\n  const inspDesc = figma.createText();\n  inspDesc.fontName = { family: \"Poppins\", style: \"Medium\" };\n  inspDesc.fontSize = 16;\n  inspDesc.characters = \"Our designers have already made many beautiful room prototypes to inspire you.\";\n  inspDesc.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n  inspLeft.appendChild(inspDesc);\n\n  const expMoreBtn = figma.createFrame();\n  expMoreBtn.name = \"Explore More\";\n  expMoreBtn.resize(176, 48);\n  expMoreBtn.fills = [{ type: 'SOLID', color: GOLD }];\n  const expTxt = figma.createText();\n  expTxt.fontName = { family: \"Poppins\", style: \"Semi Bold\" };\n  expTxt.fontSize = 16;\n  expTxt.characters = \"Explore More\";\n  expTxt.fills = [{ type: 'SOLID', color: WHITE }];\n  expMoreBtn.appendChild(expTxt);\n  expTxt.x = (176 - expTxt.width) / 2;\n  expTxt.y = (48 - expTxt.height) / 2;\n  inspLeft.appendChild(expMoreBtn);\n\n  inspLeft.x = 100;\n  inspLeft.y = 223;\n  inspSec.appendChild(inspLeft);\n\n  // Room slides\n  const slide1 = figma.createFrame();\n  slide1.name = \"Slide 1 - Current\";\n  slide1.resize(404, 582);\n  slide1.x = 564;\n  slide1.y = 44;\n  slide1.fills = [];\n  const s1Img = createAssetInstance(mediaMap[\"Photo_Inspiration_Inner_Peace\"]);\n  s1Img.resize(404, 582);\n  slide1.appendChild(s1Img);\n\n  // Overlay in Slide 1\n  const s1Overlay = figma.createFrame();\n  s1Overlay.name = \"Active Label\";\n  s1Overlay.resize(217, 130);\n  s1Overlay.x = 24;\n  s1Overlay.y = 428;\n  s1Overlay.fills = [{ type: 'SOLID', color: WHITE, opacity: 0.9 }];\n  s1Overlay.layoutMode = \"VERTICAL\";\n  s1Overlay.paddingLeft = 32;\n  s1Overlay.paddingTop = 32;\n  s1Overlay.itemSpacing = 8;\n\n  const s1Tag = figma.createText();\n  s1Tag.fontName = { family: \"Poppins\", style: \"Medium\" };\n  s1Tag.fontSize = 16;\n  s1Tag.characters = \"01 — Bed Room\";\n  s1Tag.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n  s1Overlay.appendChild(s1Tag);\n\n  const s1Title = figma.createText();\n  s1Title.fontName = { family: \"Poppins\", style: \"Semi Bold\" };\n  s1Title.fontSize = 28;\n  s1Title.characters = \"Inner Peace\";\n  s1Title.fills = [{ type: 'SOLID', color: DARK }];\n  s1Overlay.appendChild(s1Title);\n  slide1.appendChild(s1Overlay);\n\n  const s1ArrowBtn = figma.createFrame();\n  s1ArrowBtn.name = \"Arrow Right Button\";\n  s1ArrowBtn.resize(48, 48);\n  s1ArrowBtn.x = 241;\n  s1ArrowBtn.y = 510;\n  s1ArrowBtn.fills = [{ type: 'SOLID', color: GOLD }];\n  s1ArrowBtn.appendChild(createAssetInstance(mediaMap[\"Icon_Arrow_Right\"]));\n  slide1.appendChild(s1ArrowBtn);\n\n  inspSec.appendChild(slide1);\n\n  // Slide 2 & 3\n  const slide2 = figma.createFrame();\n  slide2.name = \"Slide 2\";\n  slide2.resize(372, 486);\n  slide2.x = 992;\n  slide2.y = 44;\n  slide2.fills = [];\n  const s2Img = createAssetInstance(mediaMap[\"Photo_Inspiration_2\"]);\n  s2Img.resize(372, 486);\n  slide2.appendChild(s2Img);\n  inspSec.appendChild(slide2);\n\n  // Next chevron\n  const nextBtn = figma.createFrame();\n  nextBtn.name = \"Next Slide Button\";\n  nextBtn.resize(48, 48);\n  nextBtn.cornerRadius = 24;\n  nextBtn.x = 1334;\n  nextBtn.y = 263;\n  nextBtn.fills = [{ type: 'SOLID', color: WHITE }];\n  // Let's use chevron right\n  nextBtn.appendChild(createAssetInstance(mediaMap[\"Icon_Chevron_Right\"]));\n  inspSec.appendChild(nextBtn);\n\n  // Slide indicators (bottom right under slide 2/3)\n  const indicator = figma.createFrame();\n  indicator.name = \"Slide Indicator\";\n  indicator.layoutMode = \"HORIZONTAL\";\n  indicator.itemSpacing = 20;\n  indicator.fills = [];\n  for (let i = 0; i < 4; i++) {\n    const dot = figma.createFrame();\n    dot.resize(11, 11);\n    dot.cornerRadius = 6;\n    dot.fills = [{ type: 'SOLID', color: i === 0 ? GOLD : GRAY_BORDER }];\n    indicator.appendChild(dot);\n  }\n  indicator.x = 992;\n  indicator.y = 560;\n  inspSec.appendChild(indicator);\n\n  home.appendChild(inspSec);\n\n  // 6. Share your setup section\n  const setupSec = figma.createFrame();\n  setupSec.name = \"Share your setup\";\n  setupSec.resize(1440, 720);\n  setupSec.x = 0;\n  setupSec.y = 3390;\n  setupSec.fills = [];\n\n  const setupTag = figma.createText();\n  setupTag.fontName = { family: \"Poppins\", style: \"Semi Bold\" };\n  setupTag.fontSize = 20;\n  setupTag.characters = \"Share your setup with\";\n  setupTag.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n  setupTag.x = (1440 - setupTag.width) / 2;\n  setupTag.y = 0;\n  setupSec.appendChild(setupTag);\n\n  const setupTitle = figma.createText();\n  setupTitle.fontName = { family: \"Poppins\", style: \"Bold\" };\n  setupTitle.fontSize = 40;\n  setupTitle.characters = \"#FurniroFurniture\";\n  setupTitle.fills = [{ type: 'SOLID', color: DARK }];\n  setupTitle.x = (1440 - setupTitle.width) / 2;\n  setupTitle.y = 36;\n  setupSec.appendChild(setupTitle);\n\n  // Layout the setup photos as specified Photo_Setup_1 to 9\n  // Since we want to make it look like a nice gallery:\n  // Layout positions:\n  const setupPhotos = [\n    { name: \"Photo_Setup_1\", x: 0, y: 100, w: 100, h: 280 },\n    { name: \"Photo_Setup_2\", x: 120, y: 100, w: 250, h: 210 },\n    { name: \"Photo_Setup_3\", x: 0, y: 400, w: 180, h: 220 },\n    { name: \"Photo_Setup_4\", x: 200, y: 330, w: 170, h: 290 },\n    { name: \"Photo_Setup_5\", x: 390, y: 180, w: 280, h: 360 },\n    { name: \"Photo_Setup_6\", x: 690, y: 100, w: 290, h: 320 },\n    { name: \"Photo_Setup_7\", x: 690, y: 440, w: 220, h: 180 },\n    { name: \"Photo_Setup_8\", x: 1000, y: 140, w: 210, h: 280 },\n    { name: \"Photo_Setup_9\", x: 1230, y: 100, w: 210, h: 320 }\n  ];\n\n  setupPhotos.forEach(sp => {\n    const sNode = createAssetInstance(mediaMap[sp.name]);\n    sNode.resize(sp.w, sp.h);\n    sNode.x = sp.x;\n    sNode.y = sp.y;\n    setupSec.appendChild(sNode);\n  });\n  home.appendChild(setupSec);\n\n  // Footer\n  const footer = buildFooter();\n  footer.x = 0;\n  footer.y = 3795;\n  home.appendChild(footer);\n\n  // Make sure home frame height matches footer bottom\n  home.resize(1440, 4300);\n\n  return \"Home page created successfully\";\n})();","description":"Implement Frame 01_Home with all requested sections and elements","fileKey":"lyAJXJy8GatyIPzWRh2m00"