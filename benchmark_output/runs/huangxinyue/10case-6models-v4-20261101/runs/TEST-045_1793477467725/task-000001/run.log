on\":{\"id\":\"6:31\",\"type\":\"FRAME\",\"width\":131,\"height\":95,\"children\":[{\"id\":\"5:2\",\"name\":\"Avatar_Robert_Dawson\",\"type\":\"COMPONENT\"},{\"id\":\"6:32\",\"name\":\"Avatar_Robert_Dawson\",\"type\":\"TEXT\"}]},\"Merchant_Apple\":{\"id\":\"6:35\",\"type\":\"FRAME\",\"width\":124,\"height\":123,\"children\":[{\"id\":\"5:5\",\"name\":\"Merchant_Apple\",\"type\":\"COMPONENT\"},{\"id\":\"6:36\",\"name\":\"Merchant_Apple\",\"type\":\"TEXT\"}]},\"Merchant_Nike\":{\"id\":\"6:37\",\"type\":\"FRAME\",\"width\":113,\"height\":123,\"children\":[{\"id\":\"5:9\",\"name\":\"Merchant_Nike\",\"type\":\"COMPONENT\"},{\"id\":\"6:38\",\"name\":\"Merchant_Nike\",\"type\":\"TEXT\"}]},\"Merchant_Uber\":{\"id\":\"6:39\",\"type\":\"FRAME\",\"width\":146,\"height\":123,\"children\":[{\"id\":\"5:7\",\"name\":\"Merchant_Uber\",\"type\":\"COMPONENT\"},{\"id\":\"6:40\",\"name\":\"Merchant_Uber\",\"type\":\"TEXT\"}]},\"Logo_Mastercard\":{\"id\":\"6:43\",\"type\":\"FRAME\",\"width\":127,\"height\":77,\"children\":[{\"id\":\"6:11\",\"name\":\"Logo_Mastercard\",\"type\":\"COMPONENT\"},{\"id\":\"6:44\",\"name\":\"Logo_Mastercard\",\"type\":\"TEXT\"}]},\"Logo_Visa\":{\"id\":\"6:45\",\"type\":\"FRAME\",\"width\":250,\"height\":123,\"children\":[{\"id\":\"5:3\",\"name\":\"Logo_Visa\",\"type\":\"COMPONENT\"},{\"id\":\"6:46\",\"name\":\"Logo_Visa\",\"type\":\"TEXT\"}]},\"Barcode_Receipt\":{\"id\":\"6:49\",\"type\":\"FRAME\",\"width\":282,\"height\":119,\"children\":[{\"id\":\"6:2\",\"name\":\"Barcode_Receipt\",\"type\":\"COMPONENT\"},{\"id\":\"6:50\",\"name\":\"Barcode_Receipt\",\"type\":\"TEXT\"}]},\"Icon_Add_Card\":{\"id\":\"6:53\",\"type\":\"FRAME\",\"width\":114,\"height\":75,\"children\":[{\"id\":\"6:6\",\"name\":\"Icon_Add_Card\",\"type\":\"COMPONENT\"},{\"id\":\"6:54\",\"name\":\"Icon_Add_Card\",\"type\":\"TEXT\"}]},\"Icon_Back\":{\"id\":\"6:55\",\"type\":\"FRAME\",\"width\":86,\"height\":75,\"children\":[{\"id\":\"6:3\",\"name\":\"Icon_Back\",\"type\":\"COMPONENT\"},{\"id\":\"6:56\",\"name\":\"Icon_Back\",\"type\":\"TEXT\"}]},\"Icon_Chevron_Right\":{\"id\":\"6:57\",\"type\":\"FRAME\",\"width\":140,\"height\":75,\"children\":[{\"id\":\"6:4\",\"name\":\"Icon_Chevron_Right\",\"type\":\"COMPONENT\"},{\"id\":\"6:58\",\"name\":\"Icon_Chevron_Right\",\"type\":\"TEXT\"}]},\"Icon_Close\":{\"id\":\"6:59\",\"type\":\"FRAME\",\"width\":89,\"height\":75,\"children\":[{\"id\":\"6:7\",\"name\":\"Icon_Close\",\"type\":\"COMPONENT\"},{\"id\":\"6:60\",\"name\":\"Icon_Close\",\"type\":\"TEXT\"}]},\"Icon_Help\":{\"id\":\"6:61\",\"type\":\"FRAME\",\"width\":84,\"height\":75,\"children\":[{\"id\":\"6:5\",\"name\":\"Icon_Help\",\"type\":\"COMPONENT\"},{\"id\":\"6:62\",\"name\":\"Icon_Help\",\"type\":\"TEXT\"}]},\"Icon_Plus\":{\"id\":\"6:63\",\"type\":\"FRAME\",\"width\":82,\"height\":75,\"children\":[{\"id\":\"6:8\",\"name\":\"Icon_Plus\",\"type\":\"COMPONENT\"},{\"id\":\"6:64\",\"name\":\"Icon_Plus\",\"type\":\"TEXT\"}]},\"Icon_Share\":{\"id\":\"6:65\",\"type\":\"FRAME\",\"width\":91,\"height\":75,\"children\":[{\"id\":\"6:9\",\"name\":\"Icon_Share\",\"type\":\"COMPONENT\"},{\"id\":\"6:66\",\"name\":\"Icon_Share\",\"type\":\"TEXT\"}]}}"}],"_meta":{"mcpRequestId":"ef490586-a3b7-4af2-ae28-22bdea1aca8f"}},"tool_result_meta":[{"id":"call_befbf711c37c4a6e817b76c514a290b4","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"id":"chatcmpl-202610312012154724092858268d9d6gRukNQwj","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_78c31e49944647a19a1af8259e1e6d4d","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  const mediaPage = figma.root.children.find(p => p.name.includes(\"04 · Media\"));\n  await mediaPage.loadAsync();\n\n  const map = {};\n  for (const group of mediaPage.children[0].children) {\n    if (group.type === 'FRAME') {\n      for (const child of group.children) {\n        if (child.type === 'FRAME') {\n          const comp = child.children.find(c => c.type === 'COMPONENT');\n          if (comp) {\n            map[comp.name] = comp.id;\n          }\n        }\n      }\n    }\n  }\n\n  const compPage = figma.root.children.find(p => p.name.includes(\"02 · Components\"));\n  await compPage.loadAsync();\n  const shell = compPage.children[0].children.find(c => c.name === 'Shell');\n  if (shell) {\n    for (const c of shell.children) {\n      if (c.type === 'COMPONENT') {\n        map[c.name] = c.id;\n      }\n    }\n  }\n  const button = compPage.children[0].children.find(c => c.name === 'Button');\n  if (button) map['Button'] = button.id;\n  const textField = compPage.children[0].children.find(c => c.name === 'Text Field');\n  if (textField) map['Text Field'] = textField.id;\n\n  return map;\n})()","description":"Get component IDs for instantiating/cloning components","fileKey":"SWZDf6UJywe35eYKx1FOzo"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":20779,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":18236},"context_management":null},"parent_tool_use_id":null,"session_id":"a4452011-3230-4699-83de-3ef384270e2a","uuid":"8f28d796-c334-4529-83e1-b615254bb969","timestamp":"2026-10-31T20:12:22.588Z","tool_use_meta":[{"id":"call_78c31e49944647a19a1af8259e1e6d4d","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_78c31e49944647a19a1af8259e1e6d4d","type":"tool_result","content":[{"type":"text","text":"{\"Logo_Expenio\":\"6:10\",\"Card_Texture_Coral\":\"5:10\",\"Illustration_Get_Started\":\"5:6\",\"Promo_Cashback\":\"5:8\",\"Avatar_Maria_Lopez\":\"5:4\",\"Avatar_Robert_Dawson\":\"5:2\",\"Merchant_Apple\":\"5:5\",\"Merchant_Nike\":\"5:9\",\"Merchant_Uber\":\"5:7\",\"Logo_Mastercard\":\"6:11\",\"Logo_Visa\":\"5:3\",\"Barcode_Receipt\":\"6:2\",\"Icon_Add_Card\":\"6:6\",\"Icon_Back\":\"6:3\",\"Icon_Chevron_Right\":\"6:4\",\"Icon_Close\":\"6:7\",\"Icon_Help\":\"6:5\",\"Icon_Plus\":\"6:8\",\"Icon_Share\":\"6:9\",\"Status Bar\":\"1:33\",\"Home Indicator\":\"1:44\",\"Button\":\"1:23\",\"Text Field\":\"1:26\"}"}]}]},"parent_tool_use_id":null,"session_id":"a4452011-3230-4699-83de-3ef384270e2a","uuid":"547c7cfd-03f6-4552-98bb-90896d383712","timestamp":"2026-10-31T20:12:25.238Z","tool_use_result":{"content":[{"type":"text","text":"{\"Logo_Expenio\":\"6:10\",\"Card_Texture_Coral\":\"5:10\",\"Illustration_Get_Started\":\"5:6\",\"Promo_Cashback\":\"5:8\",\"Avatar_Maria_Lopez\":\"5:4\",\"Avatar_Robert_Dawson\":\"5:2\",\"Merchant_Apple\":\"5:5\",\"Merchant_Nike\":\"5:9\",\"Merchant_Uber\":\"5:7\",\"Logo_Mastercard\":\"6:11\",\"Logo_Visa\":\"5:3\",\"Barcode_Receipt\":\"6:2\",\"Icon_Add_Card\":\"6:6\",\"Icon_Back\":\"6:3\",\"Icon_Chevron_Right\":\"6:4\",\"Icon_Close\":\"6:7\",\"Icon_Help\":\"6:5\",\"Icon_Plus\":\"6:8\",\"Icon_Share\":\"6:9\",\"Status Bar\":\"1:33\",\"Home Indicator\":\"1:44\",\"Button\":\"1:23\",\"Text Field\":\"1:26\"}"}],"_meta":{"mcpRequestId":"1f325537-ba65-4950-a44c-436d30cd1a3c"}},"tool_result_meta":[{"id":"call_78c31e49944647a19a1af8259e1e6d4d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"id":"chatcmpl-202610312012268885783288268d9d64KLiWEIt","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_1562e451244c470c960d14cc62d09098","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  await figma.loadFontAsync({ family: \"Inter\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Inter\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Inter\", style: \"Semi Bold\" });\n  await figma.loadFontAsync({ family: \"Inter\", style: \"Bold\" });\n\n  const compPage = figma.root.children.find(p => p.name.includes(\"02 · Components\"));\n  const mediaPage = figma.root.children.find(p => p.name.includes(\"04 · Media\"));\n  await compPage.loadAsync();\n  await mediaPage.loadAsync();\n\n  function findComp(name) {\n    let result = null;\n    function search(node) {\n      if (node.name === name && node.type === 'COMPONENT') {\n        result = node;\n        return;\n      }\n      if ('children' in node) {\n        for (const c of node.children) search(c);\n      }\n    }\n    search(compPage);\n    if (!result) search(mediaPage);\n    return result;\n  }\n\n  function createInst(name) {\n    const comp = findComp(name);\n    if (comp) return comp.createInstance();\n    console.warn(\"Component not found:\", name);\n    return null;\n  }\n\n  // Colors\n  const BRAND = { r: 0, g: 0.478, b: 1 }; // #007AFF\n  const BG_LIGHT = { r: 0.972, g: 0.976, b: 0.984 }; // #F8F9FA\n  const WHITE = { r: 1, g: 1, b: 1 };\n  const TEXT_PRIMARY = { r: 0.102, g: 0.102, b: 0.122 }; // #1A1A1F\n  const TEXT_MUTED = { r: 0.557, g: 0.557, b: 0.576 }; // #8E8E93\n  const BORDER_COLOR = { r: 0.898, g: 0.898, b: 0.918 }; // #E5E5EA\n  const GREEN_COLOR = { r: 0.204, g: 0.78, b: 0.349 }; // #34C759\n  const CARD_BG = { r: 0.102, g: 0.102, b: 0.122 };\n\n  // Helper function to create standard Shell top/bottom\n  function addShell(frame, statusStyle = \"dark\") {\n    const sb = createInst(\"Status Bar\");\n    if (sb) {\n      sb.x = 0;\n      sb.y = 0;\n      frame.appendChild(sb);\n    }\n    const hi = createInst(\"Home Indicator\");\n    if (hi) {\n      hi.x = 0;\n      hi.y = frame.height - 34;\n      frame.appendChild(hi);\n    }\n  }\n\n  // Workspace\n  let workspace = figma.root.children.find(p => p.name.includes(\"03 · Workspace\"));\n  if (!workspace) {\n    workspace = figma.createPage();\n    workspace.name = \"03 · Workspace\";\n  }\n  await figma.setCurrentPageAsync(workspace);\n\n  // Clear workspace existing children if any\n  for (const child of [...workspace.children]) {\n    child.remove();\n  }\n\n  // ----------------------------------------------------\n  // FRAME 1: 01_Get_Started\n  // ----------------------------------------------------\n  const f1 = figma.createFrame();\n  f1.name = \"01_Get_Started\";\n  f1.resize(375, 812);\n  f1.x = 0;\n  f1.y = 0;\n  f1.fills = [{ type: 'SOLID', color: WHITE }];\n\n  addShell(f1);\n\n  // Logo\n  const logo1 = createInst(\"Logo_Expenio\");\n  if (logo1) {\n    logo1.x = 24;\n    logo1.y = 64;\n    f1.appendChild(logo1);\n  }\n\n  // Illustration\n  const ill1 = createInst(\"Illustration_Get_Started\");\n  if (ill1) {\n    ill1.x = (375 - ill1.width) / 2;\n    ill1.y = 180;\n    f1.appendChild(ill1);\n  }\n\n  // Copy\n  const copy1 = figma.createText();\n  copy1.fontName = { family: \"Inter\", style: \"Bold\" };\n  copy1.fontSize = 28;\n  copy1.lineHeight = { value: 36, unit: \"PIXELS\" };\n  copy1.characters = \"Going cashless has never been easier with the world’s leading expense manager.\";\n  copy1.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n  copy1.resize(327, 120);\n  copy1.x = 24;\n  copy1.y = 500;\n  f1.appendChild(copy1);\n\n  // Button\n  const btn1 = createInst(\"Button\");\n  if (btn1) {\n    btn1.x = 16;\n    btn1.y = 708;\n    f1.appendChild(btn1);\n  }\n\n\n  // ----------------------------------------------------\n  // FRAME 2: 02_Home\n  // ----------------------------------------------------\n  const f2 = figma.createFrame();\n  f2.name = \"02_Home\";\n  f2.resize(375, 812);\n  f2.x = 415;\n  f2.y = 0;\n  f2.fills = [{ type: 'SOLID', color: BG_LIGHT }];\n\n  addShell(f2);\n\n  // Greeting Header: Hello, Maria / Home / Avatar\n  const greetingText = figma.createText();\n  greetingText.fontName = { family: \"Inter\", style: \"Regular\" };\n  greetingText.fontSize = 14;\n  greetingText.characters = \"Hello, Maria\";\n  greetingText.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  greetingText.x = 24;\n  greetingText.y = 60;\n  f2.appendChild(greetingText);\n\n  const homeTitle = figma.createText();\n  homeTitle.fontName = { family: \"Inter\", style: \"Bold\" };\n  homeTitle.fontSize = 24;\n  homeTitle.characters = \"Home\";\n  homeTitle.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n  homeTitle.x = 24;\n  homeTitle.y = 80;\n  f2.appendChild(homeTitle);\n\n  const avatarMaria = createInst(\"Avatar_Maria_Lopez\");\n  if (avatarMaria) {\n    avatarMaria.x = 311;\n    avatarMaria.y = 60;\n    f2.appendChild(avatarMaria);\n  }\n\n  // Balance Card\n  const balanceCard = figma.createFrame();\n  balanceCard.name = \"Balance_Card\";\n  balanceCard.resize(327, 110);\n  balanceCard.x = 24;\n  balanceCard.y = 124;\n  balanceCard.cornerRadius = 16;\n  balanceCard.fills = [{ type: 'SOLID', color: BRAND }];\n  \n  const balanceLabel = figma.createText();\n  balanceLabel.fontName = { family: \"Inter\", style: \"Medium\" };\n  balanceLabel.fontSize = 14;\n  balanceLabel.characters = \"My Balance\";\n  balanceLabel.fills = [{ type: 'SOLID', color: { r: 0.8, g: 0.9, b: 1 } }];\n  balanceLabel.x = 20;\n  balanceLabel.y = 20;\n  balanceCard.appendChild(balanceLabel);\n\n  const balanceVal = figma.createText();\n  balanceVal.fontName = { family: \"Inter\", style: \"Bold\" };\n  balanceVal.fontSize = 32;\n  balanceVal.characters = \"$25,520.00\";\n  balanceVal.fills = [{ type: 'SOLID', color: WHITE }];\n  balanceVal.x = 20;\n  balanceVal.y = 48;\n  balanceCard.appendChild(balanceVal);\n\n  const chevronRight = createInst(\"Icon_Chevron_Right\");\n  if (chevronRight) {\n    chevronRight.x = 283;\n    chevronRight.y = 43;\n    balanceCard.appendChild(chevronRight);\n  }\n  f2.appendChild(balanceCard);\n\n  // Expenses Chart Section Header\n  const expTitle = figma.createText();\n  expTitle.fontName = { family: \"Inter\", style: \"Bold\" };\n  expTitle.fontSize = 18;\n  expTitle.characters = \"Expenses\";\n  expTitle.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n  expTitle.x = 24;\n  expTitle.y = 254;\n  f2.appendChild(expTitle);\n\n  // Expenses Chart Card\n  const chartCard = figma.createFrame();\n  chartCard.name = \"Expenses_Chart_Card\";\n  chartCard.resize(327, 180);\n  chartCard.x = 24;\n  chartCard.y = 286;\n  chartCard.cornerRadius = 16;\n  chartCard.fills = [{ type: 'SOLID', color: WHITE }];\n\n  // Months MAR, APR, MAY, JUN, JUL, AUG\n  const months = [\"MAR\", \"APR\", \"MAY\", \"JUN\", \"JUL\", \"AUG\"];\n  const chartXCoords = [30, 80, 130, 180, 230, 280];\n  const chartYCoords = [110, 95, 120, 70, 105, 90]; // JUN at y=70 (highest)\n\n  // Draw chart line\n  const lineVector = figma.createVector();\n  let pathStr = `M ${chartXCoords[0]} ${chartYCoords[0]}`;\n  for (let i = 1; i < months.length; i++) {\n    pathStr += ` L ${chartXCoords[i]} ${chartYCoords[i]}`;\n  }\n  lineVector.vectorPaths = [{\n    windingRule: \"NONZERO\",\n    data: pathStr\n  }];\n  lineVector.strokes = [{ type: 'SOLID', color: BRAND }];\n  lineVector.strokeWeight = 3;\n  chartCard.appendChild(lineVector);\n\n  // Draw points and labels\n  for (let i = 0; i < months.length; i++) {\n    const m = months[i];\n    const x = chartXCoords[i];\n    const y = chartYCoords[i];\n\n    // Dot\n    const dot = figma.createEllipse();\n    if (m === \"JUN\") {\n      dot.resize(12, 12);\n      dot.x = x - 6;\n      dot.y = y - 6;\n      dot.fills = [{ type: 'SOLID', color: BRAND }];\n      dot.strokes = [{ type: 'SOLID', color: WHITE }];\n      dot.strokeWeight = 2;\n\n      // Highlight Tooltip / Tag for JUN $80.40\n      const tag = figma.createFrame();\n      tag.resize(60, 24);\n      tag.x = x - 30;\n      tag.y = y - 34;\n      tag.cornerRadius = 6;\n      tag.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n\n      const tagText = figma.createText();\n      tagText.fontName = { family: \"Inter\", style: \"Bold\" };\n      tagText.fontSize = 11;\n      tagText.characters = \"$80.40\";\n      tagText.fills = [{ type: 'SOLID', color: WHITE }];\n      tagText.x = 8;\n      tagText.y = 5;\n      tag.appendChild(tagText);\n      chartCard.appendChild(tag);\n    } else {\n      dot.resize(6, 6);\n      dot.x = x - 3;\n      dot.y = y - 3;\n      dot.fills = [{ type: 'SOLID', color: BRAND }];\n    }\n    chartCard.appendChild(dot);\n\n    // Month Label\n    const lbl = figma.createText();\n    lbl.fontName = { family: \"Inter\", style: m === \"JUN\" ? \"Bold\" : \"Regular\" };\n    lbl.fontSize = 11;\n    lbl.characters = m;\n    lbl.fills = [{ type: 'SOLID', color: m === \"JUN\" ? BRAND : TEXT_MUTED }];\n    lbl.x = x - 12;\n    lbl.y = 150;\n    chartCard.appendChild(lbl);\n  }\n  f2.appendChild(chartCard);\n\n  // Transactions Header\n  const transHeader = figma.createText();\n  transHeader.fontName = { family: \"Inter\", style: \"Bold\" };\n  transHeader.fontSize = 18;\n  transHeader.characters = \"Wallet\";\n  transHeader.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n  transHeader.x = 24;\n  transHeader.y = 486;\n  f2.appendChild(transHeader);\n\n  const seeAllBtn = figma.createText();\n  seeAllBtn.fontName = { family: \"Inter\", style: \"Bold\" };\n  seeAllBtn.fontSize = 14;\n  seeAllBtn.characters = \"See all\";\n  seeAllBtn.fills = [{ type: 'SOLID', color: BRAND }];\n  seeAllBtn.x = 305;\n  seeAllBtn.y = 488;\n  f2.appendChild(seeAllBtn);\n\n  // Helper for Transaction Row\n  function createTxRow(merchantCompName, title, date, amount, isPositive, y) {\n    const row = figma.createFrame();\n    row.name = `Tx_${title}`;\n    row.resize(327, 60);\n    row.x = 24;\n    row.y = y;\n    row.cornerRadius = 12;\n    row.fills = [{ type: 'SOLID', color: WHITE }];\n\n    const icon = createInst(merchantCompName);\n    if (icon) {\n      icon.x = 12;\n      icon.y = 10;\n      row.appendChild(icon);\n    }\n\n    const tText = figma.createText();\n    tText.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n    tText.fontSize = 15;\n    tText.characters = title;\n    tText.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n    tText.x = 60;\n    tText.y = 12;\n    row.appendChild(tText);\n\n    const dText = figma.createText();\n    dText.fontName = { family: \"Inter\", style: \"Regular\" };\n    dText.fontSize = 12;\n    dText.characters = date;\n    dText.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n    dText.x = 60;\n    dText.y = 34;\n    row.appendChild(dText);\n\n    const aText = figma.createText();\n    aText.fontName = { family: \"Inter\", style: \"Bold\" };\n    aText.fontSize = 15;\n    aText.characters = amount;\n    aText.fills = [{ type: 'SOLID', color: isPositive ? GREEN_COLOR : TEXT_PRIMARY }];\n    aText.x = 327 - 16 - (amount.length * 9); // right align estimate\n    aText.y = 20;\n    row.appendChild(aText);\n\n    return row;\n  }\n\n  // 3 Transaction Rows\n  f2.appendChild(createTxRow(\"Merchant_Nike\", \"Nike Air Max 2090\", \"15 Aug 2020\", \"−$243.00\", false, 520));\n  f2.appendChild(createTxRow(\"Merchant_Apple\", \"iPad Pro 2020\", \"10 Aug 2020\", \"−$799.00\", false, 588));\n  f2.appendChild(createTxRow(\"Merchant_Uber\", \"Uber\", \"5 Mar 2020\", \"+$50.00\", true, 656));\n\n  // Floating Plus Action Button (new payment)\n  const fab = figma.createFrame();\n  fab.name = \"Fab_New_Payment\";\n  fab.resize(56, 56);\n  fab.cornerRadius = 28;\n  fab.x = 295;\n  fab.y = 720;\n  fab.fills = [{ type: 'SOLID', color: BRAND }];\n  \n  const plusIcon = createInst(\"Icon_Plus\");\n  if (plusIcon) {\n    plusIcon.x = 16;\n    plusIcon.y = 16;\n    fab.appendChild(plusIcon);\n  }\n  f2.appendChild(fab);\n\n\n  // ----------------------------------------------------\n  // FRAME 3: 03_Wallet\n  // ----------------------------------------------------\n  const f3 = figma.createFrame();\n  f3.name = \"03_Wallet\";\n  f3.resize(375, 812);\n  f3.x = 830;\n  f3.y = 0;\n  f3.fills = [{ type: 'SOLID', color: BG_LIGHT }];\n\n  addShell(f3);\n\n  // Header: Back icon, Header \"Wallet\", Add card icon\n  const backIcon3 = createInst(\"Icon_Back\");\n  if (backIcon3) {\n    backIcon3.x = 16;\n    backIcon3.y = 56;\n    f3.appendChild(backIcon3);\n  }\n\n  const walletTitle = figma.createText();\n  walletTitle.fontName = { family: \"Inter\", style: \"Bold\" };\n  walletTitle.fontSize = 20;\n  walletTitle.characters = \"Wallet\";\n  walletTitle.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n  walletTitle.x = 156;\n  walletTitle.y = 56;\n  f3.appendChild(walletTitle);\n\n  const addCardIcon = createInst(\"Icon_Add_Card\");\n  if (addCardIcon) {\n    addCardIcon.x = 319;\n    addCardIcon.y = 56;\n    f3.appendChild(addCardIcon);\n  }\n\n  // Card component (Maria's Visa card, card 1 of 3)\n  const cardComponent = figma.createFrame();\n  cardComponent.name = \"Maria_Visa_Card\";\n  cardComponent.resize(327, 200);\n  cardComponent.x = 24;\n  cardComponent.y = 104;\n  cardComponent.cornerRadius = 16;\n  cardComponent.fills = [{ type: 'SOLID', color: CARD_BG }];\n\n  // Card Artwork\n  const cardArt = createInst(\"Card_Texture_Coral\");\n  if (cardArt) {\n    cardArt.x = 0;\n    cardArt.y = 0;\n    cardArt.resize(327, 200);\n    cardComponent.appendChild(cardArt);\n  }\n\n  // Visa Logo\n  const visaLogo = createInst(\"Logo_Visa\");\n  if (visaLogo) {\n    visaLogo.x = 24;\n    visaLogo.y = 24;\n    cardComponent.appendChild(visaLogo);\n  }\n\n  // Card Balance\n  const cardBalLbl = figma.createText();\n  cardBalLbl.fontName = { family: \"Inter\", style: \"Medium\" };\n  cardBalLbl.fontSize = 11;\n  cardBalLbl.characters = \"BALANCE\";\n  cardBalLbl.fills = [{ type: 'SOLID', color: { r: 0.8, g: 0.8, b: 0.85 } }];\n  cardBalLbl.x = 200;\n  cardBalLbl.y = 24;\n  cardComponent.appendChild(cardBalLbl);\n\n  const cardBalVal = figma.createText();\n  cardBalVal.fontName = { family: \"Inter\", style: \"Bold\" };\n  cardBalVal.fontSize = 16;\n  cardBalVal.characters = \"$25,520.00\";\n  cardBalVal.fills = [{ type: 'SOLID', color: WHITE }];\n  cardBalVal.x = 200;\n  cardBalVal.y = 40;\n  cardComponent.appendChild(cardBalVal);\n\n  // Card Number\n  const cardNum = figma.createText();\n  cardNum.fontName = { family: \"Inter\", style: \"Medium\" };\n  cardNum.fontSize = 18;\n  cardNum.characters = \"4225  9765  0008  6141\";\n  cardNum.fills = [{ type: 'SOLID', color: WHITE }];\n  cardNum.x = 24;\n  cardNum.y = 100;\n  cardComponent.appendChild(cardNum);\n\n  // Card Holder Name\n  const cardHolderLbl = figma.createText();\n  cardHolderLbl.fontName = { family: \"Inter\", style: \"Regular\" };\n  cardHolderLbl.fontSize = 10;\n  cardHolderLbl.characters = \"CARD HOLDER\";\n  cardHolderLbl.fills = [{ type: 'SOLID', color: { r: 0.8, g: 0.8, b: 0.85 } }];\n  cardHolderLbl.x = 24;\n  cardHolderLbl.y = 145;\n  cardComponent.appendChild(cardHolderLbl);\n\n  const cardHolderVal = figma.createText();\n  cardHolderVal.fontName = { family: \"Inter\", style: \"Bold\" };\n  cardHolderVal.fontSize = 13;\n  cardHolderVal.characters = \"MARIA LOPEZ\";\n  cardHolderVal.fills = [{ type: 'SOLID', color: WHITE }];\n  cardHolderVal.x = 24;\n  cardHolderVal.y = 160;\n  cardComponent.appendChild(cardHolderVal);\n\n  // Card Expiry\n  const cardExpLbl = figma.createText();\n  cardExpLbl.fontName = { family: \"Inter\", style: \"Regular\" };\n  cardExpLbl.fontSize = 10;\n  cardExpLbl.characters = \"EXPIRES\";\n  cardExpLbl.fills = [{ type: 'SOLID', color: { r: 0.8, g: 0.8, b: 0.85 } }];\n  cardExpLbl.x = 220;\n  cardExpLbl.y = 145;\n  cardComponent.appendChild(cardExpLbl);\n\n  const cardExpVal = figma.createText();\n  cardExpVal.fontName = { family: \"Inter\", style: \"Bold\" };\n  cardExpVal.fontSize = 13;\n  cardExpVal.characters = \"09/24\";\n  cardExpVal.fills = [{ type: 'SOLID', color: WHITE }];\n  cardExpVal.x = 220;\n  cardExpVal.y = 160;\n  cardComponent.appendChild(cardExpVal);\n\n  f3.appendChild(cardComponent);\n\n  // Card Indicator (1 of 3)\n  const cardInd = figma.createText();\n  cardInd.fontName = { family: \"Inter\", style: \"Medium\" };\n  cardInd.fontSize = 12;\n  cardInd.characters = \"Card 1 of 3\";\n  cardInd.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  cardInd.x = 158;\n  cardInd.y = 312;\n  f3.appendChild(cardInd);\n\n  // Promo Card Header/Banner\n  const promoCard = figma.createFrame();\n  promoCard.name = \"Promo_Card\";\n  promoCard.resize(327, 100);\n  promoCard.x = 24;\n  promoCard.y = 338;\n  promoCard.cornerRadius = 16;\n  promoCard.fills = [{ type: 'SOLID', color: WHITE }];\n\n  const promoBadge = figma.createFrame();\n  promoBadge.resize(68, 20);\n  promoBadge.x = 16;\n  promoBadge.y = 16;\n  promoBadge.cornerRadius = 4;\n  promoBadge.fills = [{ type: 'SOLID', color: { r: 1, g: 0.92, b: 0.8 } }];\n\n  const promoBadgeText = figma.createText();\n  promoBadgeText.fontName = { family: \"Inter\", style: \"Bold\" };\n  promoBadgeText.fontSize = 10;\n  promoBadgeText.characters = \"POPULAR\";\n  promoBadgeText.fills = [{ type: 'SOLID', color: { r: 1, g: 0.58, b: 0 } }];\n  promoBadgeText.x = 8;\n  promoBadgeText.y = 4;\n  promoBadge.appendChild(promoBadgeText);\n  promoCard.appendChild(promoBadge);\n\n  const promoText = figma.createText();\n  promoText.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n  promoText.fontSize = 14;\n  promoText.lineHeight = { value: 20, unit: \"PIXELS\" };\n  promoText.characters = \"Get up to 15% cashback on clothing and apparel\";\n  promoText.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n  promoText.resize(200, 40);\n  promoText.x = 16;\n  promoText.y = 44;\n  promoCard.appendChild(promoText);\n\n  const promoImg = createInst(\"Promo_Cashback\");\n  if (promoImg) {\n    promoImg.x = 225;\n    promoImg.y = 10;\n    promoCard.appendChild(promoImg);\n  }\n  f3.appendChild(promoCard);\n\n  // Transactions Header\n  const walletTxHeader = figma.createText();\n  walletTxHeader.fontName = { family: \"Inter\", style: \"Bold\" };\n  walletTxHeader.fontSize = 18;\n  walletTxHeader.characters = \"Transactions\";\n  walletTxHeader.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n  walletTxHeader.x = 24;\n  walletTxHeader.y = 454;\n  f3.appendChild(walletTxHeader);\n\n  // 3 Transaction Rows\n  f3.appendChild(createTxRow(\"Merchant_Nike\", \"Nike Air Max 2090\", \"15 Aug 2020\", \"−$243.00\", false, 488));\n  f3.appendChild(createTxRow(\"Merchant_Apple\", \"iPad Pro 2020\", \"10 Aug 2020\", \"−$799.00\", false, 556));\n  f3.appendChild(createTxRow(\"Merchant_Uber\", \"Uber\", \"5 Mar 2020\", \"+$50.00\", true, 624));\n\n\n  // ----------------------------------------------------\n  // FRAME 4: 04_Add_Card (Sheet presentation over 03_Wallet)\n  // ----------------------------------------------------\n  const f4 = figma.createFrame();\n  f4.name = \"04_Add_Card\";\n  f4.resize(375, 812);\n  f4.x = 1245;\n  f4.y = 0;\n  f4.fills = [{ type: 'SOLID', color: BG_LIGHT }];\n\n  // Render dim overlay over background representation or background sheet\n  const dimBg = figma.createFrame();\n  dimBg.resize(375, 812);\n  dimBg.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 }, opacity: 0.4 }];\n  f4.appendChild(dimBg);\n\n  // Bottom Sheet Container\n  const sheet = figma.createFrame();\n  sheet.name = \"Bottom_Sheet\";\n  sheet.resize(375, 712);\n  sheet.x = 0;\n  sheet.y = 100;\n  sheet.cornerRadius = 24;\n  sheet.fills = [{ type: 'SOLID', color: WHITE }];\n\n  // Sheet Grabber Bar\n  const grabber = figma.createFrame();\n  grabber.resize(36, 5);\n  grabber.cornerRadius = 2.5;\n  grabber.x = (375 - 36) / 2;\n  grabber.y = 10;\n  grabber.fills = [{ type: 'SOLID', color: BORDER_COLOR }];\n  sheet.appendChild(grabber);\n\n  // Header: \"Add new card\", Icon_Close\n  const addCardHeader = figma.createText();\n  addCardHeader.fontName = { family: \"Inter\", style: \"Bold\" };\n  addCardHeader.fontSize = 20;\n  addCardHeader.characters = \"Add new card\";\n  addCardHeader.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n  addCardHeader.x = 24;\n  addCardHeader.y = 28;\n  sheet.appendChild(addCardHeader);\n\n  const closeIcon = createInst(\"Icon_Close\");\n  if (closeIcon) {\n    closeIcon.x = 327;\n    closeIcon.y = 28;\n    sheet.appendChild(closeIcon);\n  }\n\n  // Card Preview Frame\n  const cardPrev = figma.createFrame();\n  cardPrev.name = \"Card_Preview\";\n  cardPrev.resize(327, 180);\n  cardPrev.x = 24;\n  cardPrev.y = 70;\n  cardPrev.cornerRadius = 16;\n  cardPrev.fills = [{ type: 'SOLID', color: CARD_BG }];\n\n  const mcLogo = createInst(\"Logo_Mastercard\");\n  if (mcLogo) {\n    mcLogo.x = 24;\n    mcLogo.y = 20;\n    cardPrev.appendChild(mcLogo);\n  }\n\n  const prevNum = figma.createText();\n  prevNum.fontName = { family: \"Inter\", style: \"Medium\" };\n  prevNum.fontSize = 17;\n  prevNum.characters = \"5412  7534  0089  2216\";\n  prevNum.fills = [{ type: 'SOLID', color: WHITE }];\n  prevNum.x = 24;\n  prevNum.y = 80;\n  cardPrev.appendChild(prevNum);\n\n  const prevNameLbl = figma.createText();\n  prevNameLbl.fontName = { family: \"Inter\", style: \"Regular\" };\n  prevNameLbl.fontSize = 10;\n  prevNameLbl.characters = \"CARD HOLDER\";\n  prevNameLbl.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  prevNameLbl.x = 24;\n  prevNameLbl.y = 125;\n  cardPrev.appendChild(prevNameLbl);\n\n  const prevNameVal = figma.createText();\n  prevNameVal.fontName = { family: \"Inter\", style: \"Bold\" };\n  prevNameVal.fontSize = 12;\n  prevNameVal.characters = \"NAME ON CARD\";\n  prevNameVal.fills = [{ type: 'SOLID', color: { r: 0.6, g: 0.6, b: 0.65 } }];\n  prevNameVal.x = 24;\n  prevNameVal.y = 140;\n  cardPrev.appendChild(prevNameVal);\n\n  const prevExpLbl = figma.createText();\n  prevExpLbl.fontName = { family: \"Inter\", style: \"Regular\" };\n  prevExpLbl.fontSize = 10;\n  prevExpLbl.characters = \"EXPIRES\";\n  prevExpLbl.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  prevExpLbl.x = 220;\n  prevExpLbl.y = 125;\n  cardPrev.appendChild(prevExpLbl);\n\n  const prevExpVal = figma.createText();\n  prevExpVal.fontName = { family: \"Inter\", style: \"Bold\" };\n  prevExpVal.fontSize = 12;\n  prevExpVal.characters = \"MM / YY\";\n  prevExpVal.fills = [{ type: 'SOLID', color: { r: 0.6, g: 0.6, b: 0.65 } }];\n  prevExpVal.x = 220;\n  prevExpVal.y = 140;\n  cardPrev.appendChild(prevExpVal);\n\n  sheet.appendChild(cardPrev);\n\n  // Helper for Input Field Form\n  function createFormField(label, valText, isPlaceholder, isFocused, logoComp, helpIconComp, width = 327) {\n    const f = figma.createFrame();\n    f.name = `Field_${label}`;\n    f.resize(width, 68);\n\n    const lText = figma.createText();\n    lText.fontName = { family: \"Inter\", style: \"Medium\" };\n    lText.fontSize = 13;\n    lText.characters = label;\n    lText.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n    lText.x = 0;\n    lText.y = 0;\n    f.appendChild(lText);\n\n    const inputBg = figma.createFrame();\n    inputBg.resize(width, 44);\n    inputBg.x = 0;\n    inputBg.y = 24;\n    inputBg.cornerRadius = 10;\n    inputBg.fills = [{ type: 'SOLID', color: BG_LIGHT }];\n    inputBg.strokes = [{ type: 'SOLID', color: isFocused ? BRAND : BORDER_COLOR }];\n    inputBg.strokeWeight = isFocused ? 2 : 1;\n\n    const val = figma.createText();\n    val.fontName = { family: \"Inter\", style: \"Regular\" };\n    val.fontSize = 15;\n    val.characters = valText;\n    val.fills = [{ type: 'SOLID', color: isPlaceholder ? TEXT_MUTED : TEXT_PRIMARY }];\n    val.x = 12;\n    val.y = 12;\n    inputBg.appendChild(val);\n\n    if (logoComp) {\n      const logoInst = createInst(logoComp);\n      if (logoInst) {\n        logoInst.x = width - logoInst.width - 12;\n        logoInst.y = (44 - logoInst.height) / 2;\n        inputBg.appendChild(logoInst);\n      }\n    }\n\n    if (helpIconComp) {\n      const helpInst = createInst(helpIconComp);\n      if (helpInst) {\n        helpInst.x = width - helpInst.width - 12;\n        helpInst.y = (44 - helpInst.height) / 2;\n        inputBg.appendChild(helpInst);\n      }\n    }\n\n    f.appendChild(inputBg);\n    return f;\n  }\n\n  // Form Fields\n  // 1. Card holder's name (empty, placeholder \"Name on card\")\n  const field1 = createFormField(\"Card holder’s name\", \"Name on card\", true, false, null, null, 327);\n  field1.x = 24;\n  field1.y = 268;\n  sheet.appendChild(field1);\n\n  // 2. Card number 5412 7534 0089 2216, focused, Mastercard detected\n  const field2 = createFormField(\"Card number\", \"5412 7534 0089 2216\", false, true, \"Logo_Mastercard\", null, 327);\n  field2.x = 24;\n  field2.y = 352;\n  sheet.appendChild(field2);\n\n  // 3. Expiry Date (empty, placeholder \"MM / YY\")\n  const field3 = createFormField(\"Expiry Date\", \"MM / YY\", true, false, null, null, 155);\n  field3.x = 24;\n  field3.y = 436;\n  sheet.appendChild(field3);\n\n  // 4. CVV (empty, placeholder \"123\", help Icon_Help)\n  const field4 = createFormField(\"CVV\", \"123\", true, false, null, \"Icon_Help\", 155);\n  field4.x = 196;\n  field4.y = 436;\n  sheet.appendChild(field4);\n\n  // Action Button: Add new card\n  const btnAdd = createInst(\"Button\");\n  if (btnAdd) {\n    btnAdd.x = 16;\n    btnAdd.y = 616;\n    // Update button text to \"Add new card\"\n    const btnTextNode = btnAdd.children.find(c => c.type === 'TEXT');\n    if (btnTextNode) {\n      btnTextNode.characters = \"Add new card\";\n    }\n    sheet.appendChild(btnAdd);\n  }\n\n  f4.appendChild(sheet);\n  addShell(f4);\n\n\n  // ----------------------------------------------------\n  // FRAME 5: 05_Payment\n  // ----------------------------------------------------\n  const f5 = figma.createFrame();\n  f5.name = \"05_Payment\";\n  f5.resize(375, 812);\n  f5.x = 1660;\n  f5.y = 0;\n  f5.fills = [{ type: 'SOLID', color: BG_LIGHT }];\n\n  addShell(f5);\n\n  // Header: \"Cancel\" (left action), \"Payment\" (title)\n  const cancelBtn = figma.createText();\n  cancelBtn.fontName = { family: \"Inter\", style: \"Medium\" };\n  cancelBtn.fontSize = 16;\n  cancelBtn.characters = \"Cancel\";\n  cancelBtn.fills = [{ type: 'SOLID', color: BRAND }];\n  cancelBtn.x = 24;\n  cancelBtn.y = 56;\n  f5.appendChild(cancelBtn);\n\n  const payHeaderTitle = figma.createText();\n  payHeaderTitle.fontName = { family: \"Inter\", style: \"Bold\" };\n  payHeaderTitle.fontSize = 20;\n  payHeaderTitle.characters = \"Payment\";\n  payHeaderTitle.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n  payHeaderTitle.x = 146;\n  payHeaderTitle.y = 56;\n  f5.appendChild(payHeaderTitle);\n\n  // Payee Section: \"PAYING\", Robert Dawson, Avatar\n  const payingLbl = figma.createText();\n  payingLbl.fontName = { family: \"Inter\", style: \"Bold\" };\n  payingLbl.fontSize = 12;\n  payingLbl.characters = \"PAYING\";\n  payingLbl.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  payingLbl.x = 164;\n  payingLbl.y = 110;\n  f5.appendChild(payingLbl);\n\n  const avatarRobert = createInst(\"Avatar_Robert_Dawson\");\n  if (avatarRobert) {\n    avatarRobert.x = (375 - avatarRobert.width) / 2;\n    avatarRobert.y = 132;\n    f5.appendChild(avatarRobert);\n  }\n\n  const robertName = figma.createText();\n  robertName.fontName = { family: \"Inter\", style: \"Bold\" };\n  robertName.fontSize = 18;\n  robertName.characters = \"Robert Dawson\";\n  robertName.fills = [{ type: 'SOLID', color: TEXT_PRIMARY }];\n  robertName.x = 122;\n  robertName.y = 200;\n  f5.appendChild(robertName);\n\n  // Amount\n  const payAmt = figma.createText();\n  payAmt.fontName = { family: \"Inter\", style: \"Bold\" };\n  payAmt.fontSize = 40;\n  payAmt.characters = \"$50.00\";\n  payAmt.fills = [{ 