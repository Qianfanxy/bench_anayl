return f;}\n\nconst H=1680;\nconst s=figma.createFrame();s.name='04_Home';s.resize(414,H);s.fills=S(C.surf);s.clipsContent=true;s.x=2500;s.y=0;\nconst sb=(await figma.getNodeByIdAsync('48:43')).createInstance();s.appendChild(sb);sb.x=0;sb.y=0;\n\nconst body=col('content',26);body.resize(414,H-44-74);body.fills=[];\nbody.paddingTop=20;body.paddingBottom=24;body.paddingLeft=30;body.paddingRight=30;\ns.appendChild(body);body.x=0;body.y=44;\n\n// header\nconst hd=row('header',10);body.appendChild(hd);hd.layoutAlign='STRETCH';hd.primaryAxisAlignItems='SPACE_BETWEEN';\nconst greet=txt('Welcome, Jonas.',24,'Bold','DM Sans',C.t1,32);greet.name='greeting';hd.appendChild(greet);\nconst icons=row('entries',14);hd.appendChild(icons);\nconst menu=await icon('6:273',22,C.t1);menu.name='entry_menu';icons.appendChild(menu);\nconst notif=await icon('6:274',22,C.t1);notif.name='entry_notification';icons.appendChild(notif);\n\n// Invest now\nconst invest=figma.createFrame();invest.name='btn_invest_now';invest.resize(354,56);invest.cornerRadius=20;invest.fills=S(C.p);\ninvest.layoutMode='HORIZONTAL';invest.primaryAxisAlignItems='CENTER';invest.counterAxisAlignItems='CENTER';\ninvest.appendChild(txt('Invest now',17,'Semi Bold','Inter',C.white,24));\nbody.appendChild(invest);invest.layoutAlign='STRETCH';\n\n// Portfolio card\nconst pf=col('card_portfolio',10);pf.resize(354,150);pf.cornerRadius=16;pf.fills=S(C.white);\npf.strokes=S(C.line);pf.strokeWeight=1;pf.paddingTop=18;pf.paddingBottom=18;pf.paddingLeft=18;pf.paddingRight=18;\nbody.appendChild(pf);pf.layoutAlign='STRETCH';\npf.appendChild(txt('Your total asset portfolio',13,'Medium','Inter',C.t2,18));\nconst pfr=row('amount',10);pf.appendChild(pfr);pfr.layoutAlign='STRETCH';\nconst amt=txt('₦203,935',34,'Bold','DM Sans',C.t1,42);amt.name='portfolio_amount';pfr.appendChild(amt);\nconst chg=txt('+2%',15,'Semi Bold','Inter',C.p,20);chg.name='portfolio_change';pfr.appendChild(chg);\n\n// section header helper\nasync function sec(title,right,linkName){const r=row('section_'+title,10);r.primaryAxisAlignItems='SPACE_BETWEEN';\n const t=txt(title,18,'Semi Bold','DM Sans',C.t1,24);t.name='section_title';r.appendChild(t);\n if(right){const rt=txt(right,13,'Medium','Inter',C.p,18);rt.name=linkName;r.appendChild(rt);}\n return r;}\n\n// Best Plans\nconst plans=col('section_best_plans',14);body.appendChild(plans);plans.layoutAlign='STRETCH';\nplans.appendChild(await sec('Best Plans','See All','link_see_all_plans'));\nplans.children[0].layoutAlign='STRETCH';\nconst pr=row('plan_row',11);plans.appendChild(pr);pr.layoutAlign='STRETCH';\nconst planC=await figma.getNodeByIdAsync('2009:52');\nfor(const [name,ret] of [['Gold','30%'],['Silver','60%'],['Platinum','90%']]){\n  const inst=planC.createInstance();inst.name='PlanCard/'+name;pr.appendChild(inst);inst.layoutGrow=1;\n  inst.findOne(n=>n.name==='plan_name').characters=name;\n  inst.findOne(n=>n.name==='plan_return').characters=ret+' return';}\n\n// Investment Guide\nconst guide=col('section_investment_guide',14);body.appendChild(guide);guide.layoutAlign='STRETCH';\nguide.appendChild(await sec('Investment Guide','See All','link_see_all_articles'));\nguide.children[0].layoutAlign='STRETCH';\nconst artC=await figma.getNodeByIdAsync('2009:58');\nconst articles=[['Basic type of investments','This is how you set your foot for the 2020 stock market recession. What’s next…'],\n ['How much can you start with?','What do you like to see? It’s a very different market from 2018. The way…'],\n ['Welcome to New NASDAQ','When we talk about Wall Street, what looks good might be different…']];\nfor(const [t,su] of articles){const a=artC.createInstance();a.name='ArticleCard/'+t;guide.appendChild(a);a.layoutAlign='STRETCH';\n a.findOne(n=>n.name==='title').characters=t;\n a.findOne(n=>n.name==='summary').characters=su;}\n\n// bottom nav\nconst nav=(await figma.getNodeByIdAsync('2009:24')).createInstance();nav.name='BottomNav/Home';s.appendChild(nav);nav.x=0;nav.y=H-74;\n\nreturn JSON.stringify({home:s.id,h:H});\n","description":"Build 04_Home with greeting header, Invest now, portfolio card, Best Plans, Investment Guide, bottom nav","fileKey":"j3A0ecMMlYQqRT10ygTiTe","skillNames":"resource:figma-use"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":29051,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"76699855-d304-4fda-983c-5359f7738e40","uuid":"54080dfb-9db2-4346-90c6-a4e3aa602d30","timestamp":"2026-10-28T18:10:37.511Z","tool_use_meta":[{"id":"call_087db27a3da744ed95a679db","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
