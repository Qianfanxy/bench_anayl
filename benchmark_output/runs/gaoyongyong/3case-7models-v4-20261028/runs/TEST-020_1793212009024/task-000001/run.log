          <text id=\"4:109\" name=\"Line Messenger (Logo_Line) · $21.00 · due Sep 05, 2023 · 1 month · Subscriptions · Pay now Adobe XD (Logo_Adobe_XD) · $126.02 · due Sep 19, 2023 · 1 month · Subscriptions · Pay now Netflix (Logo_Netflix) · $932.53 · due Jul 08, 2024 · 1 year · Subscriptions · Pay now Bill actions: Add · Edit · Delete\" x=\"25\" y=\"53\" width=\"576\" height=\"76\" />\n        </frame>\n        <frame id=\"4:110\" name=\"Transactions (newest first)\" x=\"0\" y=\"348\" width=\"624\" height=\"207\">\n          <text id=\"4:111\" name=\"Transactions (newest first)\" x=\"25\" y=\"21\" width=\"197\" height=\"22\" />\n          <text id=\"4:112\" name=\"Aug 19, 2023 · PayPal (Logo_PayPal) · Transferred · -$123.00 Jul 20, 2023 · DANA (Logo_DANA) · Transferred · -$12.00 May 08, 2023 · Google Play (Logo_Google_Play) · Refund · +$234.00 Feb 28, 2023 · Shopee (Logo_Shopee) · Refund · +$15.00 Jan 25, 2023 · Apple (Logo_Apple) · Payment · -$92.00 Jan 16, 2023 · Spotify (Logo_Spotify) · Payment · -$20.00 Show latest 3 where a screen asks for “latest 3”.\" x=\"25\" y=\"53\" width=\"576\" height=\"133\" />\n        </frame>\n        <frame id=\"4:113\" name=\"Cards\" x=\"648\" y=\"348\" width=\"624\" height=\"131\">\n          <text id=\"4:114\" name=\"Cards\" x=\"25\" y=\"21\" width=\"44\" height=\"22\" />\n          <text id=\"4:115\" name=\"Card_Art_Green · Esaaa Warden · **** **** **** 3447 · Exp 09/24 · primary Card_Art_Pink · Esaaa Warden · **** **** **** 8821 · Exp 03/26 Card_Art_Purple · Esaaa Warden · **** **** **** 5104 · Exp 11/25\" x=\"25\" y=\"53\" width=\"576\" height=\"57\" />\n        </frame>\n        <frame id=\"4:116\" name=\"Assets\" x=\"0\" y=\"579\" width=\"624\" height=\"131\">\n          <text id=\"4:117\" name=\"Assets\" x=\"25\" y=\"21\" width=\"50\" height=\"22\" />\n          <text id=\"4:118\" name=\"Solana · SOL · $12,094.08 (Crypto_Solana) Bitcoin · BTC · $17,238.11 (Crypto_Bitcoin) Ethereum · ETH · $8,200.00 (Crypto_Ethereum)\" x=\"