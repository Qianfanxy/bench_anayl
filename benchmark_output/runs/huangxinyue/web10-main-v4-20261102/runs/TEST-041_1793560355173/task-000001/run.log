nction inst(id,w,h){ const c=await comp(id); const i=c.createInstance(); if(w&&h) i.resize(w,h); return i; }\nasync function icon(id,size,colorHex){ const c=await comp(id); const i=c.createInstance(); const s=size/Math.max(c.width,c.height); i.rescale(s); if(colorHex){ const rec=n=>{ if('fills' in n && Array.isArray(n.fills) && n.fills.some(f=>f.type==='SOLID')) n.fills=[sol(colorHex)]; if('children' in n) n.children.forEach(rec); }; rec(i);} return i; }\nlet compY=0;\nfor (const n of WS.children) if (n.x < -2000) compY=Math.max(compY, n.y+n.height);\ncompY+=120;\nfunction park(n){ WS.appendChild(n); n.x=-2400; n.y=compY; compY+=n.height+120; }\n\nconst cardComp=figma.createComponent(); cardComp.name='F/ProductCard'; cardComp.resize(285,446); cardComp.fills=[sol(C.light)];\nal(cardComp,{mode:'VERTICAL'});\nconst photoWrap=fr('Photo'); photoWrap.clipsContent=true; photoWrap.resize(285,301); photoWrap.primaryAxisSizingMode='FIXED'; photoWrap.counterAxisSizingMode='FIXED';\nconst photo=await inst('13:21',285,301); photo.name='Product photo'; photo.x=0; photo.y=0; photoWrap.appendChild(photo);\nconst info=fr('Info'); al(info,{mode:'VERTICAL',gap:8,pad:[16,16,30,16]});\ninfo.appendChild(txt('Product name',24,F.sb,C.dark,{name:'Name'}));\ninfo.appendChild(txt('Description',16,F.med,'8A8A8A',{name:'Description'}));\nconst prices=fr('Prices'); al(prices,{mode:'HORIZONTAL',gap:16,cross:'CENTER'});\nprices.appendChild(txt('Rp 0.000.000',20,F.sb,C.dark,{name:'Price'}));\nprices.appendChild(txt('Rp 0.000.000',16,F.reg,C.subtle,{name:'Old price'}));\ninfo.appendChild(prices);\ncardComp.appendChild(photoWrap); cardComp.appendChild(info);\npark(cardComp);\n\nconst hov=figma.createComponent(); hov.name='F/ProductCardHover'; hov.resize(285,446); hov.fills=[sol(C.light)];\nal(hov,{mode:'VERTICAL'});\nconst hPhotoWrap=fr('Photo'); hPhotoWrap.clipsContent=true; hPhotoWrap.resize(285,301); hPhotoWrap.primaryAxisSizingMode='FIXED'; hPhotoWrap.counterAxisSizingMode='FIXED';\nconst hPhoto=await inst('13:17',285,301); hPhoto.name='Product photo'; hPhoto.x=0; hPhoto.y=0; hPhotoWrap.appendChild(hPhoto);\nconst overlay=fr('Hover overlay'); overlay.resize(285,301); overlay.fills=[{type:'SOLID', color:hex(C.dark), opacity:0.72}]; overlay.x=0; overlay.y=0;\nal(overlay,{mode:'VERTICAL', main:'CENTER', cross:'CENTER', gap:24});\noverlay.primaryAxisSizingMode='FIXED'; overlay.counterAxisSizingMode='FIXED';\nconst atc=fr('AddToCartBtn'); atc.fills=[sol(C.white)]; al(atc,{mode:'HORIZONTAL',pad:[12,52,12,52]}); atc.appendChild(txt('Add to cart',16,F.sb,C.gold));\noverlay.appendChild(atc);\nconst actions=fr('Hover actions'); al(actions,{mode:'HORIZONTAL',gap:22,cross:'CENTER'});\nconst mkA=async(ic,label)=>{ const a=fr('A/'+label); al(a,{mode:'HORIZONTAL',gap:4,cross:'CENTER'}); a.appendChild(await icon(ic,16,C.white)); a.appendChild(txt(label,16,F.sb,C.white)); return a; };\nactions.appendChild(await mkA('13:51','Share')); actions.appendChild(await mkA('13:47','Compare')); actions.appendChild(await mkA('13:53','Like'));\noverlay.appendChild(actions); hPhotoWrap.appendChild(overlay);\nconst hInfo=fr('Info'); al(hInfo,{mode:'VERTICAL',gap:8,pad:[16,16,30,16]});\nhInfo.appendChild(txt('Leviosa',24,F.sb,C.dark,{name:'Name'}));\nhInfo.appendChild(txt('Stylish cafe chair',16,F.med,'8A8A8A',{name:'Description'}));\nconst hPrices=fr('Prices'); al(hPrices,{mode:'HORIZONTAL',gap:16,cross:'CENTER'}); hPrices.appendChild(txt('Rs. 2,500,000.00',20,F.sb,C.dark,{name:'Price'})); hInfo.appendChild(hPrices);\nhov.appendChild(hPhotoWrap); hov.appendChild(hInfo);\npark(hov);\n\nconst pg=figma.createComponent(); pg.name='F/Pagination'; pg.fills=[];\nal(pg,{mode:'HORIZONTAL',gap:38,cross:'CENTER'});\nconst mkP=(label,w,bg,fg)=>{ const p=fr('P/'+label); p.fills=[sol(bg)]; p.cornerRadius=10; al(p,{mode:'HORIZONTAL', main:'CENTER', cross:'CENTER', pad:[15,0,15,0]}); p.resize(w,60); const t=txt(label,20,F.reg,fg); p.appendChild(t); p.primaryAxisSizingMode='FIXED'; p.counterAxisSizingMode