2\",bacon:\"1:267\",cheese:\"1:272\",mushroom:\"1:277\",avocado:\"1:282\",fries:\"1:290\",coleslaw:\"1:295\",salad:\"1:300\",onionRings:\"1:305\",mozz:\"1:310\",mc:\"1:318\",visa:\"1:323\"})){IMG[k]=await GH(id);}\nconst M={rating:\"2007:23\",heartOff:\"2007:31\",heartOn:\"2007:39\",chipSel:\"2007:47\",chipDef:\"2007:49\",ibBack:\"2007:53\",ibSearch:\"2007:58\",ibSettings:\"2007:67\",ibMenu:\"2007:73\",stepper:\"2007:77\",inputSearch:\"2007:90\",inputPill:\"2007:100\",sendBtn:\"2007:102\",profileField:\"2007:111\",linkRow:\"2007:114\",bubA:\"2007:121\",bubC:\"2007:123\",paySel:\"2007:125\",payDef:\"2007:134\"};\n// HeaderBar\nasync function headerBar(type){const c=comp(\"Type=\"+type,430,64,null,0);c.layoutMode=\"HORIZONTAL\";c.primaryAxisSizingMode=\"FIXED\";c.counterAxisSizingMode=\"FIXED\";c.counterAxisAlignItems=\"CENTER\";c.paddingLeft=24;c.paddingRight=24;c.itemSpacing=12;c.appendChild((await figma.getNodeByIdAsync(M.ibBack)).createInstance());const t=await T(\"\",\"Title/S\",C.ink);t.name=\"Title\";t.layoutGrow=1;c.appendChild(t);const rightId={Search:M.ibSearch,Settings:M.ibSettings,Menu:M.ibMenu}[type];c.appendChild((await figma.getNodeByIdAsync(rightId)).createInstance());return c;}\nconst hbs=[await headerBar(\"Search\"),await headerBar(\"Settings\"),await headerBar(\"Menu\")];\n// BottomNav\nconst nav=comp(\"BottomNav\",430,84,C.surf,0);nav.topLeftRadius=28;nav.topRightRadius=28;nav.layoutMode=\"HORIZONTAL\";nav.primaryAxisSizingMode=\"FIXED\";nav.counterAxisSizingMode=\"FIXED\";nav.primaryAxisAlignItems=\"SPACE_BETWEEN\";nav.counterAxisAlignItems=\"CENTER\";nav.paddingLeft=30;nav.paddingRight=26;nav.effects=[{type:\"DROP_SHADOW\",color:{r:0.23,g:0.17,b:0.17,a:0.10},offset:{x:0,y:-6},radius:20,visible:true,blendMode:\"NORMAL\"}];\nasync function navItem(iconId,label,active){const f=figma.createFrame();f.layoutMode=\"VERTICAL\";f.itemSpacing=4;f.primaryAxisSizingMode=\"AUTO\";f.counterAxisSizingMode=\"AUTO\";f.counterAxisAlignItems=\"CENTER\";f.fills=[];f