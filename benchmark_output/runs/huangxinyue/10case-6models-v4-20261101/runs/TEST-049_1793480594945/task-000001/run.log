ard.cornerRadius = 16;\ntodayCard.fills = [{ type: 'SOLID', color: WHITE }];\ntodayCard.effects = [{\n  type: 'DROP_SHADOW',\n  color: { r: 0, g: 0, b: 0, a: 0.04 },\n  offset: { x: 0, y: 4 },\n  radius: 12,\n  visible: true,\n  blendMode: 'NORMAL'\n}];\n\n// Left Content (Time info)\nconst todayInfo = figma.createFrame();\ntodayInfo.name = \"Info\";\ntodayInfo.resize(180, 50);\ntodayInfo.x = 16;\ntodayInfo.y = 20;\ntodayInfo.fills = [];\ntodayInfo.layoutMode = \"VERTICAL\";\ntodayInfo.itemSpacing = 4;\n\nconst activityLabel = createText(\"Active Time\", 14, \"Medium\", TEXT_MUTED);\nconst timeLabel = createText(\"8.00 AM - 1.30 PM\", 18, \"Bold\", TEXT_DARK);\ntodayInfo.appendChild(activityLabel);\ntodayInfo.appendChild(timeLabel);\ntodayCard.appendChild(todayInfo);\n\n// Right Content (Illustration)\nconst todayIllSrc = figma.getNodeById(\"3:31\");\nconst todayIllInst = todayIllSrc.createInstance();\ntodayIllInst.resize(110, 74);\ntodayIllInst.x = 248;\ntodayIllInst.y = 8;\ntodayCard.appendChild(todayIllInst);\n\ntodaySection.appendChild(todayCard);\nscrollContainer.appendChild(todaySection);\n\n// -------------------------------------------------------------\n// RECOMMENDATION CLASS (Yoga Class, With Rachael Wisdom, Photo, Favorite icon)\n// -------------------------------------------------------------\nconst recSection = figma.createFrame();\nrecSection.name = \"RecommendationSection\";\nrecSection.resize(374, 210);\nrecSection.x = 20;\nrecSection.y = 582;\nrecSection.fills = [];\n\n// Header row\nconst recHeader = figma.createFrame();\nrecHeader.name = \"SectionHeader\";\nrecHeader.resize(374, 24);\nrecHeader.x = 0;\nrecHeader.y = 0;\nrecHeader.fills = [];\n\nconst recTitle = createText(\"Recommendation Class\", 18, \"Bold\", TEXT_DARK);\nrecTitle.x = 0;\nrecTitle.y = 0;\nrecHeader.appendChild(recTitle);\n\nconst recSeeAll = createText(\"See all\", 14, \"Medium\", BRAND_PRIMARY);\nrecSeeAll.x = 326;\nrecSeeAll.y = 2;\nrecHeader.appendChild(recSeeAll);\n\nrecSection.appendChild(recHeader);\n\n// Recommendation Card\nconst recCard = figma.createFrame();\nrecCard.name = \"RecommendationCard\";\nrecCard.resize(374, 150);\nrecCard.x = 0;\nrecCard.y = 36;\nrecCard.cornerRadius = 16;\nrecCard.fills = [{ type: 'SOLID', color: WHITE }];\nrecCard.clipsContent = true;\nrecCard.effects = [{\n  type: 'DROP_SHADOW',\n  color: { r: 0, g: 0, b: 0, a: 0.04 },\n  offset: { x: 0, y: 4 },\n  radius: 12,\n  visible: true,\n  blendMode: 'NORMAL'\n}];\n\n// Background photo\nconst recPhotoSrc = figma.getNodeById(\"3:15\");\nconst recPhotoInst = recPhotoSrc.createInstance();\nrecPhotoInst.resize(374, 150);\nrecPhotoInst.x = 0;\nrecPhotoInst.y = 0;\nrecCard.appendChild(recPhotoInst);\n\n// Overlay dark gradient to make text visible\nconst gradientOverlay = figma.createRectangle();\ngradientOverlay.name = \"GradientOverlay\";\ngradientOverlay.resize(374, 150);\ngradientOverlay.x = 0;\ngradientOverlay.y = 0;\ngradientOverlay.fills = [{\n  type: \"GRADIENT_LINEAR\",\n  gradientTransform: [\n    [0, 1, 0],\n    [-1, 0, 1]\n  ],\n  gradientStops: [\n    { position: 0, color: { r: 0.1, g: 0.1, b: 0.1, a: 0.6 } },\n    { position: 0.6, color: { r: 0.1, g: 0.1, b: 0.1, a: 0.1 } },\n    { position: 1, color: { r: 0.1, g: 0.1, b: 0.1, a: 0.0 } }\n  ]\n}];\nrecCard.appendChild(gradientOverlay);\n\n// Text Content inside Card (Bottom left)\nconst classInfo = figma.createFrame();\nclassInfo.name = \"ClassInfo\";\nclassInfo.resize(250, 50);\nclassInfo.x = 16;\nclassInfo.y = 84;\nclassInfo.fills = [];\nclassInfo.layoutMode = \"VERTICAL\";\nclassInfo.itemSpacing = 2;\n\nconst className = createText(\"Yoga Class\", 18, \"Bold\", WHITE);\nconst classCoach = createText(\"With Rachael Wisdom\", 14, \"Medium\", WHITE, 0.85);\nclassInfo.appendChild(className);\nclassInfo.appendChild(classCoach);\nrecCard.appendChild(classInfo);\n\n// Favorite Icon (Top right)\nconst favSrc = figma.getNodeById(\"3:20\");\nconst favInst = favSrc.createInstance();\nfavInst.x = 328;\nfavInst.y = 16;\nrecCard.appendChild(favInst);\n\nrecSection.appendChild(recCard);\nscrollContainer.appendChild(recSection);\n\nconsole.log(\"02_Home built fully\");\nreturn \"Recommendation section and Todays Activity successfully built\";\n","description":"Add Today's Activity and Recommendation Class cards to the 02_Home frame. Apply shadow effects, image overlays, and icons.","fileKey":"3v6MKXTXZc4rqr75aMQHiO"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":41057,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"fe9f7e04-3732-4c02-a3aa-681285101806","uuid":"9238d681-d33d-4538-9c57-e77c3f6443e3","timestamp":"2026-10-31T21:08:45.285Z","tool_use_meta":[{"id":"call_7c3f0ef5fea043f4a80d2499f884d31a","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
