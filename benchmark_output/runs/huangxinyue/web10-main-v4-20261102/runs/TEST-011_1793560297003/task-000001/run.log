{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_bdrk_xvlrotb3stns3ilkr4rghchdpw5cjopmswww5we55hc5yoc4mfeq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01UkuSC4fgtU1xXPiH2kGNRY","name":"mcp__figma__use_figma","input":{"code":"const ws=figma.root.children.find(p=>p.id==='15:2'); await figma.setCurrentPageAsync(ws);\nconst F='Poppins'; for(const s of ['Regular','Medium','SemiBold','Bold','Light']) await figma.loadFontAsync({family:F,style:s});\nconst hex=h=>{h=h.replace('#','');return {r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255}};\nconst solid=(h,o=1)=>[{type:'SOLID',color:hex(h),opacity:o}];\nconst C={brand:'#B88E2F',brandDark:'#8F6D20',ink:'#1F1F1F',text:'#3A3A3A',sub:'#616161',muted:'#9F9F9F',line:'#E4E0D8',cream:'#F9F1E7',cream2:'#FCF8F3',card:'#F4F5F7',white:'#FFFFFF',sale:'#E97171',new:'#2EC1AC'};\nfunction T(str,size=16,style='Regular',color=C.text,o={}){const t=figma.createText();t.fontName={family:F,style};t.fontSize=size;t.characters=str;t.fills=solid(color);if(o.lh)t.lineHeight={value:o.lh,unit:'PIXELS'};if(o.w){t.textAutoResize='HEIGHT';t.resize(o.w,t.height);} if(o.align)t.textAlignHorizontal=o.align; t.name=o.name||str.slice(0,30); return t;}\nfunction AL(dir='VERTICAL',o={}){const f=figma.createFrame();f.layoutMode=dir;f.primaryAxisSizingMode='AUTO';f.counterAxisSizingMode='AUTO';f.fills=o.fill?solid(o.fill):[];f.itemSpacing=o.gap||0; const p=o.pad||0; if(Array.isArray(p)){[f.paddingTop,f.paddingRight,f.paddingBottom,f.paddingLeft]=p;}else{f.paddingTop=f.paddingRight=f.paddingBottom=f.paddingLeft=p;} if(o.r)f.cornerRadius=o.r; f.name=o.name||'Frame'; if(o.align)f.counterAxisAlignItems=o.align; if(o.justify)f.primaryAxisAlignItems=o.justify; if(o.stroke){f.strokes=solid(o.stroke);f.strokeWeight=o.sw||1;} f.clipsContent=false; return f;}\nconst N=async id=>await figma.getNodeByIdAsync(id);\nconst inst=async(id,w,h)=>{const i=(await N(id)).createInstance(); if(w)i.resize(w,h||w); return i;};\nconst icon=async(id,col,s)=>{const i=await inst(id); if(s) i.rescale(s/i.width); if(col) i.findAll(n=>n.type==='VECTOR').forEach(v=>v.fills=solid(col)); return i;};\nconst sec=await N('17:2'); let y=Math.max(...sec.children.map(c=>c.y+c.height))+80;\nconst badgeSet=await N('17:18'); const badgeSale=badgeSet.children.find(c=>c.name==='Type=Sale');\nconst cards=[];\nfor(const state of ['Default','Hover']){\n const c=AL('VERTICAL',{fill:C.card,name:'Product Card',r:8}); c.counterAxisSizingMode='FIXED'; c.resize(285,10); c.clipsContent=true;\n const ph=await inst('13:21',285,301); ph.name='Photo'; c.appendChild(ph); ph.layoutSizingHorizontal='FILL';\n const info=AL('VERTICAL',{gap:8,pad:[16,16,28,16],name:'Info'}); c.appendChild(info); info.layoutSizingHorizontal='FILL';\n info.appendChild(T('Syltherine',24,'SemiBold',C.text,{name:'Name'})); info.appendChild(T('Stylish cafe chair',16,'Medium',C.muted,{name:'Description'}));\n const pr=AL('HORIZONTAL',{gap:12,align:'CENTER',name:'Prices'}); pr.appendChild(T('Rs. 2,500,000.00',18,'SemiBold',C.text,{name:'Price'})); const old=T('Rs. 3,500,000.00',14,'Regular','#B0B0B0',{name:'Old Price'}); old.textDecoration='STRIKETHROUGH'; pr.appendChild(old); info.appendChild(pr);\n pr.layoutSizingHorizontal='FILL'; pr.layoutWrap='WRAP'; pr.counterAxisSpacing=2;\n const b=badgeSale.createInstance(); b.name='Badge'; c.appendChild(b); b.layoutPositioning='ABSOLUTE'; b.x=285-24-48; b.y=24; b.constraints={horizontal:'MAX',vertical:'MIN'};\n if(state==='Hover'){\n  const ov=AL('VERTICAL',{gap:24,align:'CENTER',justify:'CENTER',name:'Hover Overlay'}); ov.fills=[{type:'SOLID',color:hex('#3A3A3A'),opacity:0.72}]; c.appendChild(ov); ov.layoutPositioning='ABSOLUTE'; ov.primaryAxisSizingMode='FIXED'; ov.counterAxisSizingMode='FIXED'; ov.resize(285,c.height); ov.x=0; ov.y=0; ov.constraints={horizontal:'STRETCH',vertical:'STRETCH'};\n  const btn=AL('HORIZONTAL',{fill:C.white,pad:[12,52,12,52],align:'CENTER',justify:'CENTER',name:'Add to cart'}); btn.appendChild(T('Add to cart',16,'SemiBold',C.brand,{name:'Label'})); ov.appendChild(btn);\n  const acts=AL('HORIZONTAL',{gap:20,align:'CENTER',name:'Card Actions'});\n  for(const [l,id] of [['Share','13:51'],['Compare','13:47'],['Like','13:53']]){const a=AL('HORIZONTAL',{gap:4,align:'CENTER',name:'Action/'+l}); a.appendChild(await icon(id,C.white,16)); a.appendChild(T(l,16,'SemiBold',C.white,{name:'Label'})); acts.appendChild(a);} ov.appendChild(acts);\n }\n const comp=figma.createComponentFromNode(c); comp.name='State='+state; cards.push(comp);\n}\ncards.forEach(c=>sec.appendChild(c)); const set=figma.combineAsVariants(cards,sec); set.name='Product Card'; set.layoutMode='HORIZONTAL'; set.itemSpacing=32; set.paddingLeft=set.paddingRight=set.paddingTop=set.paddingBottom=24; set.primaryAxisSizingMode='AUTO';set.counterAxisSizingMode='AUTO'; set.fills=solid('#FFFFFF'); set.strokes=solid('#9747FF'); set.dashPattern=[6,4];\nset.x=80; set.y=y; y+=set.height+80;\n// props\nconst kN=set.addComponentProperty('Name','TEXT','Syltherine'); const kD=set.addComponentProperty('Description','TEXT','Stylish cafe chair'); const kP=set.addComponentProperty('Price','TEXT','Rs. 2,500,000.00'); const kO=set.addComponentProperty('Old price','TEXT','Rs. 3,500,000.00'); const kSO=set.addComponentProperty('Show old price','BOOLEAN',true); const kSB=set.addComponentProperty('Show badge','BOOLEAN',true);\nconst kPh=set.addComponentProperty('Photo','INSTANCE_SWAP','13:21');\nfor(const v of set.children){ v.findOne(n=>n.name==='Name').componentPropertyReferences={characters:kN}; v.findOne(n=>n.name==='Description').componentPropertyReferences={characters:kD}; v.findOne(n=>n.name==='Price').componentPropertyReferences={characters:kP}; v.findOne(n=>n.name==='Old Price').componentPropertyReferences={characters:kO,visible:kSO}; v.findOne(n=>n.name==='Badge').componentPropertyReferences={visible:kSB}; v.findOne(n=>n.name==='Photo').componentPropertyReferences={mainComponent:kPh};\n const ov=v.findOne(n=>n.name==='Hover Overlay'); if(ov){ ov.resize(285,v.height);} }\nsec.resizeWithoutConstraints(3000,y+200);\nreturn JSON.stringify({set:set.id,kN,kD,kP,kO,kSO,kSB,kPh, h:set.children.map(c=>c.height)});","description":"Create Product Card component set with Default/Hover","fileKey":"SpBMJAM0UYyUkLizLNGfSY"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":63120,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":63120,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"753f1172-7f5a-41f7-ae4e-eb68ec9f64d7","uuid":"4d46dfd2-b15c-4e05-83c3-4942df2f3ebd","timestamp":"2026-11-01T19:18:48.358Z","tool_use_meta":[{"id":"toolu_bdrk_01UkuSC4fgtU1xXPiH2kGNRY","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
