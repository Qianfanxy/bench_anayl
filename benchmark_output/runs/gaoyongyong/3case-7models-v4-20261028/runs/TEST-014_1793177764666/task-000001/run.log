l='FILL'; if(o.fillH) c.layoutSizingVertical='FILL'; if(o.grow) c.layoutGrow=1; return c;}\nfunction tint(node,tok){const w=n=>{ if('strokes' in n && n.strokes.length && n.strokes[0].type==='SOLID') n.strokes=[P(tok)]; if('fills' in n && n.fills!==figma.mixed && n.fills.length && n.fills[0].type==='SOLID'){const c=n.fills[0].color; if(c.r<0.2&&c.g<0.2&&c.b<0.2) n.fills=[P(tok)];} if('children' in n) n.children.forEach(w);}; w(node);}\nasync function I(id){return (await N(id)).createInstance();}\nfunction setSet(s,dir='VERTICAL'){s.layoutMode=dir; s.itemSpacing=16; s.paddingTop=s.paddingBottom=s.paddingLeft=s.paddingRight=16; s.primaryAxisSizingMode='AUTO'; s.counterAxisSizingMode='AUTO'; s.fills=[P('surface/default')]; s.cornerRadius=16;}\nconst lib=await N('2007:3');\nasync function section(title){const s=Fr(title,{dir:'VERTICAL',gap:20}); add(s,await T(title,'Heading/H2')); lib.appendChild(s); const row=Fr('row',{dir:'HORIZONTAL',gap:32,ai:'MIN'}); s.appendChild(row); return row;}\nconst IB=await N('2007:7'); const ibKey=Object.keys(IB.componentPropertyDefinitions)[0];\nfunction ibI(icon,name){const i=IB.createInstance(); i.setProperties({[ibKey]:icon}); i.name=name; return i;}\nconst out={};\n// ---- Headers\nlet row=await section('Headers');\nconst hp=Fr('Header / Pushed',{comp:true,dir:'HORIZONTAL',w:375,h:56,pad:[6,20],jc:'SPACE_BETWEEN',ai:'CENTER',fill:'surface/background'});\nhp.appendChild(ibI('2:8','Back'));\nconst title=await T('Title','Heading/H2'); title.name='Title'; title.textAlignHorizontal='CENTER'; hp.appendChild(title); title.layoutPositioning='ABSOLUTE'; title.textAutoResize='NONE'; title.resize(200,24); title.x=87.5; title.y=16; title.constraints={horizontal:'CENTER',vertical:'CENTER'};\nconst right=Fr('Right',{dir:'HORIZONTAL',gap:8,ai:'CENTER'}); hp.appendChild(right);\nconst msg=ibI('2:7','Messages'), bell=ibI('2:6','Notifications'), more=ibI('2:18','More'); const avI=await I('2:65'); avI.rescale(44/48); avI.name='Avatar';\n[avI,msg,bell,more].forEach(n=>right.appendChild(n));\nconst tk=hp.addComponentProperty('Title','TEXT','Title'); title.componentPropertyReferences={characters:tk};\nfor(const [n,node,def] of [['Show Avatar',avI,true],['Show Messages',msg,false],['Show Notifications',bell,false],['Show More',more,true]]){const k=hp.addComponentProperty(n,'BOOLEAN',def); node.componentPropertyReferences={visible:k};}\nrow.appendChild(hp); out.hp=hp.id;\nconst ah=Fr('Header / Account',{comp:true,dir:'HORIZONTAL',w:375,h:64,pad:[8,20],gap:12,ai:'CENTER',fill:'surface/background'});\nconst a2=await I('2:65'); a2.name='Avatar'; ah.appendChild(a2);\nconst tc=Fr('Greeting',{dir:'VERTICAL',gap:2}); add(ah,tc,{grow:true}); tc.appendChild(await T('Hi, Esaaa!','Heading/H2')); tc.appendChild(await T('Aug 20, 2023','Caption/Regular','text/secondary'));\nah.appendChild(ibI('2:7','Messages')); ah.appendChild(ibI('2:6','Notifications'));\nrow.appendChild(ah); out.ah=ah.id;\n\n// ---- Segments & chips\nrow=await section('Switches & Chips');\nconst segs=[];\nfor(const st of ['Selected','Default']){const s=Fr(`State=${st}`,{comp:true,dir:'HORIZONTAL',h:40,pad:[0,12],r:20,ai:'CENTER',jc:'CENTER',fill:st==='Selected'?'brand/primary':null}); const t=await T('My Balance',st==='Selected'?'Label/Medium':'Label/Medium',st==='Selected'?'text/primary':'text/secondary'); if(st==='Selected'){t.fontName={family:F,style:'SemiBold'};} t.name='Label'; s.appendChild(t); segs.push(s);}\nconst segSet=figma.combineAsVariants(segs,row); segSet.name='Segment'; setSet(segSet,'HORIZONTAL'); const segK=segSet.addComponentProperty('Label','TEXT','My Balance'); segSet.children.forEach(c=>c.findOne(n=>n.name==='Label').componentPropertyReferences={characters:segK});\nasync function makeSwitch(name,opts,prop,w){const vs=[]; for(const cur of opts){const sw=Fr(`${prop}=${cur}`,{comp:true,dir:'HORIZONTAL',w,pad:[4],gap:4,r:24,fill:'surface/default',stroke:'border/default',ai:'CENTER'}); for(const o of opts){const v=segSet.children.find(c=>c.name===`State=${o===cur?'Selected':'Default'}`).createInstance(); v.setProperties({[segK]:o}); v.name=o; add(sw,v,{grow:true}); v.layoutSizingHorizontal='FILL';} vs.push(sw);} const s=figma.combineAsVariants(vs,row); s.name=name; setSet(s); return s;}\nout.homeSw=(await makeSwitch('Home View Switch',['My Balance','Upcoming Bills','Transactions'],'View',335)).id;\nout.incSw=(await makeSwitch('Analytics Switch',['Income','Expenses'],'View',335)).id;\nconst chips=[];\nfor(const size of ['Default','Small']) for(const st of ['Selected','Default']){const c=Fr(`Size=${size}, State=${st}`,{comp:true,dir:'HORIZONTAL',pad:size==='Default'?[10,16]:[6,10],r:size==='Default'?20:14,ai:'CENTER',jc:'CENTER',fill:st==='Selected'?'surface/dark':'surface/default',stroke:st==='Selected'?null:'border/default'}); const t=await T(size==='Default'?'Personal Finance':'1D',size==='Default'?'Label/Medium':'Caption/Medium',st==='Selected'?'text/on-dark':'text/secondary'); t.name='Label'; c.appendChild(t); chips.push(c);}\nconst chipSet=figma.combineAsVariants(chips,row); chipSet.name='Chip'; setSet(chipSet); const chK=chipSet.addComponentProperty('Label','TEXT','Personal Finance'); chipSet.children.forEach(c=>c.findOne(n=>n.name==='Label').componentPropertyReferences={characters:chK}); out.chip=chipSet.id;\n\n// ---- Inputs\nrow=await section('Inputs');\nconst otps=[];\nfor(const st of ['Empty','Focused','Filled']){const o=Fr(`State=${st}`,{comp:true,dir:'HORIZONTAL',w:64,h:64,r:16,ai:'CENTER',jc:'CENTER',fill:'surface/default',stroke:st==='Focused'?'brand/primary-strong':'border/strong',sw:st==='Focused'?2:1}); if(st==='Filled'){const t=await T('0','Heading/H1'); t.name='Digit'; o.appendChild(t);} else if(st==='Focused'){const c=figma.createRectangle(); c.name='Caret'; c.resize(2,24); c.fills=[P('brand/primary-strong')]; o.appendChild(c);} else {const d=figma.createRectangle(); d.name='Placeholder'; d.resize(12,2); d.cornerRadius=1; d.fills=[P('border/strong')]; o.appendChild(d);} otps.push(o);}\nconst otpSet=figma.combineAsVariants(otps,row); otpSet.name='OTP Digit'; setSet(otpSet,'HORIZONTAL'); out.otp=otpSet.id;\n// Country / currency selector\nconst cs=Fr('Country Selector',{comp:true,dir:'HORIZONTAL',gap:6,pad:[6,8,6,8],r:16,ai:'CENTER',fill:'surface/background'});\nconst flag=await I('2:62'); flag.rescale(20/16); flag.name='Flag'; cs.appendChild(flag); const code=await T('+62','Body/Medium'); code.name='Code'; cs.appendChild(code); const chev=await I('2:17'); chev.rescale(16/24); cs.appendChild(chev);\nconst fk=cs.addComponentProperty('Flag','INSTANCE_SWAP','2:62'); flag.componentPropertyReferences={mainComponent:fk}; const ck=cs.addComponentProperty('Code','TEXT','+62'); code.componentPropertyReferences={characters:ck};\nrow.appendChild(cs); out.cs=cs.id;\n// Phone field composed from 02 Text Field\nconst pf=Fr('Phone Field',{comp:true,w:335,h:101});\nconst tf=await I('3:71'); pf.appendChild(tf); tf.x=0; tf.y=0;\nconst tfLabel=tf.children[0]; tfLabel.characters='Phone number';\nconst inp=tf.findOne(n=>n.name==='Input'); inp.paddingLeft=118;\nconst val=tf.findOne(n=>n.name==='Value'); val.characters='858 2409 3560'; val.fills=[P('text/primary')];\nconst csI=cs.createInstance(); pf.appendChild(csI); csI.x=10; csI.y=26+(52-csI.height)/2;\nconst div=figma.createRectangle(); div.name='Divider'; div.resize(1,24); div.fills=[P('border/strong')]; pf.appendChild(div); div.x=104; div.y=26+14;\nrow.appendChild(pf); out.pf=pf.id;\n// Search field\nconst sf=Fr('Search Field',{comp:true,dir:'HORIZONTAL',w:279,h:48,r:24,pad:[0,16],gap:10,ai:'CENTER',fill:'surface/default',stroke:'border/default'});\nconst si=await I('2:15'); tint(si,'text/tertiary'); sf.appendChild(si); const ph=await T('Search...','Body/Medium','text/tertiary'); ph.name='Placeholder'; sf.appendChild(ph);\nrow.appendChild(sf); out.sf=sf.id;\nreturn out;","description":"Build components batch 2: headers, switches, chips, inputs","fileKey":"MBHvOG7BDhv7MBK9aeD1M4"}}],"container":null,"stop_reason":null,"