{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_93e75295387a44a89ed20d82","name":"mcp__figma__use_figma","input":{"code":"const out = {};\nasync function info(id, name) {\n  const n = await figma.getNodeByIdAsync(id);\n  if (!n) { out[name] = 'NOT FOUND'; return; }\n  const o = { type: n.type, w: Math.round(n.width*10)/10, h: Math.round(n.height*10)/10 };\n  if (n.type === 'COMPONENT' || n.type === 'INSTANCE') {\n    try { o.props = Object.keys(n.componentPropertyDefinitions || {}); } catch(e) { o.props = 'n/a'; }\n  }\n  if ('fills' in n && Array.isArray(n.fills)) o.fills = JSON.stringify(n.fills.map(f => f.type === 'SOLID' ? {t:'S', c:f.color} : {t:f.type})).slice(0, 400);\n  if (n.children && n.children.length <= 8) {\n    o.kids = n.children.map(c => {\n      const k = { t: c.type, n: c.name, w: Math.round(c.width*10)/10, h: Math.round(c.height*10)/10 };\n      if ('fills' in c && Array.isArray(c.fills)) k.f = JSON.stringify(c.fills.map(f => f.type === 'SOLID' ? {t:'S', c:{r:Math.round(f.color.r*255), g:Math.round(f.color.g*255), b:Math.round(f.color.b*255)}} : {t:f.type})).slice(0, 200);\n      if (c.type === 'TEXT') { k.chars = c.characters.slice(0, 40); k.fs = c.fontSize; k.ff = c.fontName && c.fontName.style; }\n      return k;\n    });\n  }\n  out[name] = o;\n}\nawait info('4:168','Button');\nawait info('4:174','TextField');\nawait info('4:180','StatusBar');\nawait info('4:191','HomeIndicator');\nawait info('3:92','SW_Symbol');\nawait info('3:95','SW_Wordmark');\nawait info('3:116','Logo_Netflix');\nawait info('3:122','Avatar_Neutral');\nawait info('3:125','Phone_Frame');\nawait info('3:134','Welcome_Hand');\nawait info('3:143','Icon_BalVis');\nawait info('3:164','Icon_Trade');\nconst ws = await figma.getNodeByIdAsync('5:2');\nout.workspace = { type: ws.type, kids: (ws.children||[]).map(c=>c.id+':'+c.name) };\nreturn JSON.stringify(out);","description":"Read-only inspection of reference components and workspace state","fileKey":"Itxd