  p.appendChild(r);r.x=o.x||0;r.y=o.y||0;return r;\n}\nasync function IC(p,id,size,x,y,color){\n  const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();p.appendChild(i);\n  i.rescale(size/Math.max(c.width,c.height));\n  i.findAll(function(n){return n.type==='VECTOR';}).forEach(function(v){\n    if(v.fills.length){v.fills=[sol(color)];}\n    if(v.strokes.length){v.strokes=[sol(color)];}\n  });\n  i.x=x;i.y=y;return i;\n}\nconst IDS={timer:'7:47',fork:'7:40',play:'7:42',print:'7:43',share:'7:46',chevR:'7:38',arrow:'7:35',fb:'7:48',tw:'7:50',ig:'7:49'};\n\n// ---- FIX 1: newsletter decorations absolute ----\nconst news=byName('Section / Newsletter');\nnews.children.forEach(function(c){\n  if(c.name.indexOf('Decor_')===0){c.layoutPositioning='ABSOLUTE';}\n});\nnews.children.find(function(c){return c.name==='Title';}).layoutPositioning='AUTO';\n// reposition decor\nconst veg=news.children.find(function(c){return c.name==='Decor_Subscribe_Vegetables';});veg.x=-40;veg.y=270;\nconst sal=news.children.find(function(c){return c.name==='Decor_Subscribe_Salad';});sal.x=1120;sal.y=250;\nconst leaf=news.children.find(function(c){return c.name==='Decor_Subscribe_Leaf';});leaf.x=1050;leaf.y=-10;\n\n// ---- FIX 2: direction step text naming ----\nconst dirC=byName('Block / Direction Step');\nconst db=dirC.children[1];\ndb.children[0].name='DTitle';db.children[1].name='DText';\n\n// ---- FIX 3: home more-recipes title width ----\nconst home=PG.children.find(function(n){return n.name==='01_Home';});\nconst sec2=home.children.find(function(n){return n.name==='MoreRecipes';});\nif(sec2){const t2=sec2.children.find(function(c){return c.name==='Title';});\n  if(t2){t2.fontSize=34;t2.resize(1000,10);t2.x=220;}}\n\n// ---- BUILD 02_Recipe ----\nfor(const n of [...PG.children]){ if(n.name==='02_Recipe'){n.remove();} }\nconst navSet=byName('Navigation / Item');\nconst navCur=navSet.children.find(function(c){return c.name.indexOf('Current')>=0;});\nconst navDef=navSet.children.find(function(c){return c.name.indexOf('Current')<0;});\nconst hdrC=byName('Site / Header');\nfunction makeHeader(parent,current){\n  const h=hdrC.createInstance();parent.appendChild(h);h.x=0;h.y=0;\n  ['Home','Recipes','Blog','Contact','About us'].forEach(function(l){\n    const inst=h.findOne(function(n){return n.name==='Nav_'+l.replace(' ','');});\n    if(!inst){return;}\n    if(l===current){inst.swapComponent(navCur);}else{inst.swapComponent(navDef);}\n    const t=inst.findOne(function(n){return n.type==='TEXT';});\n    if(t){t.characters=l;}\n  });\n  return h;\n}\nconst avC=byName('Avatar');\nconst rec=figma.createFrame();rec.name='02_Recipe';rec.resize(1440,1200);rec.x=1600;rec.y=0;\nrec.fills=[sol(P.white)];PG.appendChild(rec);\nmakeHeader(rec,'Recipes');\n\nT(rec,{name:'Title',w:980,sz:50,st:'b',lh:1.15,ls:-1.4,al:'CENTER',x:230,y:148},'Healthy Japanese Fried Rice with Asparagus');\nconst meta=F(rec,{name:'MetaRow',w:1000,h:56,x:200,y:238});\nconst av=avC.createInstance();meta.appendChild(av);av.x=0;av.y=4;\nT(meta,{name:'Author',w:150,sz:15,st:'sb',x:60,y:2},'John Smith');\nT(meta,{name:'Date',w:150,sz:13,c:P.muted,x:60,y:26},'15 March 2022');\nF(meta,{name:'div1',w:1,h:36,fill:P.line,x:222,y:8});\nawait IC(meta,IDS.timer,20,252,16,P.ink);\nT(meta,{name:'PrepLbl',w:120,sz:11,c:P.muted,ls:8,x:282,y:8},'PREP TIME');\nT(meta,{name:'PrepVal',w:120,sz:14,st:'m',x:282,y:26},'15 Minutes');\nF(meta,{name:'div2',w:1,h:36,fill:P.line,x:418,y:8});\nawait IC(meta,IDS.timer,20,448,16,P.ink);\nT(meta,{name:'CookLbl',w:120,sz:11,c:P.muted,ls:8,x:478,y:8},'COOK TIME');\nT(meta,{name:'CookVal',w:120,sz:14,st:'m',x:478,y:26},'15 Minutes');\nF(meta,{name:'div3',w:1,h:36,fill:P.line,x:614,y:8});\nawait IC(meta,IDS.fork,20,644,16,P.ink);\nT(meta,{name:'CatVal',w:140,sz:14,st:'m',x:674,y:18},'Healthy');\n\nconst act=F(rec,{name:'Actions',w:220,h:44,x:1140,y:238});\nconst pr=F(act,{name:'Print',w:96,h:44,r:12,fill:P.white,stroke:P.line,sw:1.5,x:0,y:0});\nawait IC(pr,IDS.print,16,1