):s).createInstance();};\nconst T=(inst,layer,val)=>{const t=inst.findOne(n=>n.name===layer&&n.type==='TEXT');t.characters=val;return t;};\nconst screen=(name,x,h)=>{const f=figma.createFrame();f.name=name;f.x=x;f.y=0;f.resize(375,h||812);al(f,'VERTICAL',0,[0,0,0,0],'MIN','MIN');f.counterAxisSizingMode='FIXED';f.primaryAxisSizingMode=h?'FIXED':'AUTO';fill(f,'bg/base');f.clipsContent=true;return f;};\nconst addFill=(p,c)=>{p.appendChild(c);c.layoutSizingHorizontal='FILL';return c;};\nconst sec=async(p,title)=>{const s=fr(title,'VERTICAL',12,[0,0,0,0],'MIN','MIN');addFill(p,s);const h=C('Section Header');T(h,'Title',title);h.findOne(n=>n.name==='Action').visible=false;addFill(s,h);return s;};\nconst f=screen('03_Detail_Saham',910);\nf.appendChild(B['Status Bar'].createInstance());\nconst h=C('Header','Type=Detail');addFill(f,h);\nconst body=fr('Content','VERTICAL',24,[8,20,24,20],'MIN','MIN');addFill(f,body);\n// stock summary\nconst sm=fr('Stock Summary','VERTICAL',16,[0,0,0,0],'MIN','MIN');addFill(body,sm);\nconst id=fr('Identity','HORIZONTAL',12,[0,0,0,0],'MIN','CENTER');addFill(sm,id);\nconst lg=figma.createFrame();lg.name='Logo';lg.resize(48,48);lg.cornerRadius=24;lg.clipsContent=true;const li=M['Logo_GOTO'].createInstance();li.rescale(0.5);lg.appendChild(li);id.appendChild(lg);\nconst nm=fr('Name','VERTICAL',2,[0,0,0,0],'MIN','MIN');nm.appendChild(await txt('GOTO','Heading/H2','text/primary','Ticker'));nm.appendChild(await txt('GoTo Gojek Tokopedia','Body/Regular','text/secondary','Company'));id.appendChild(nm);\nconst pq=fr('Quote','VERTICAL',6,[0,0,0,0],'MIN','MIN');addFill(sm,pq);\npq.appendChild(await txt('Rp189','Price/Large','text/primary','Price'));\nconst cr=fr('Change','HORIZONTAL',8,[0,0,0,0],'MIN','CENTER');const b=C('Change Badge','Direction=Down');T(b,'Value','−Rp9 (−4,55%)');cr.appendChild(b);cr.appendChild(await txt('Hari ini','Caption/Regular','text/tertiary','Period'));pq.appendChild(cr);\n// chart + ranges\nconst cb=fr('Chart Block','VERTICAL',16,[0,0,0,0],'MIN','MIN');addFill(body,cb);\nconst chart=C('Price Chart / 1D');cb.appendChild(chart);\nconst rt=fr('Range Tabs','HORIZONTAL',2,[4,4,4,4],'SPACE_BETWEEN','CENTER');rt.cornerRadius=10;fill(rt,'bg/surface');addFill(cb,rt);\nfor(const r of ['1D','5D','1M','6M','YTD','1Y','5Y','MAX']){const t=C('Range Tab',r==='1D'?'State=Selected':'State=Default');t.name='Range/'+r;T(t,'Label',r);rt.appendChild(t);t.layoutGrow=1;}\n// keystats\nconst ks=await sec(body,'Keystats');const kc=fr('Table','VERTICAL',0,[4,16,4,16],'MIN','MIN');kc.cornerRadius=16;fill(kc,'bg/surface');addFill(ks,kc);\nconst K=[['Previous Close','Rp198'],['Day Range','Rp188 - Rp199'],['Year Range','Rp180 - Rp396'],['Market Cap','694,70T IDR'],['AVG Volume','167,58M'],['P/E Ratio','15,50'],['Dividend Yield','3,76%'],['Primary Exchange','IDX']];\nK.forEach(([l,v],i)=>{const r=C('Keystat Row');r.name='Keystat/'+l;T(r,'Label',l);T(r,'Value',v);if(i===K.length-1)r.strokeBottomWeight=0;addFill(kc,r);});\n// compare\nconst cp=await sec(body,'Dibandingkan dengan');const cl=fr('List','VERTICAL',8,[0,0,0,0],'MIN','MIN');addFill(cp,cl);\nfor(const [co,tk,pr,ch,ini] of [['Bukalapak Tbk','BUKA','Rp276','+2,82%','BU'],['Bank Rakyat Indonesia','BBRI','Rp4.630','+0,83%','BB'],['PT Industri Jamu','SIDO','Rp740','+2,82%','SI']]){\n const r=C('Compare Row','Direction=Up');r.name='Compare/'+tk;T(r,'Company',co);T(r,'Ticker',tk);T(r,'Price',pr);T(r,'Value',ch);T(r,'Initials',ini);addFill(cl,r);}\n// bottom action bar\nconst bar=fr('Trade Bar','VERTICAL',0,[12,0,0,0],'MIN','CENTER');fill(bar,'bg/surface');bar.strokes=[paint('border/subtle')];bar.strokeTopWeight=1;bar.strokeBottomWeight=0;bar.strokeLeftWeight=0;bar.strokeRightWeight=0;addFill(f,bar);\nconst btns=fr('Buttons','HORIZONTAL',12,[0,20,0,20],'MIN','CENTER');addFill(bar,btns);\nconst j=C('Button / Action','Variant=Danger, State=Default');j.name='Jual';T(j,'Label','Jual');btns.appendChild(j);j.layoutGrow=1;\nconst be=C('Button / Action','Variant=Primary, State=Default');be.name='Beli';T(be,'Label','Beli');btns.appendChild(be);be.layoutGrow=1;\naddFill(bar,B['Home Indicator'].createInstance());\nreturn {id:f.id,h:f.height};","description":"Build 03_Detail_Saham","fileKey":"YrTPLf9m7JWQ8bXXXJcUlA"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":550,"cache_read_input_tokens":78919,"cache_creation":{"ephemeral_5m_input_tokens":550,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"235036c5-5c0b-434d-bf2d-9b106a96a136","uuid":"41e2ec8e-8e16-4f37-83fb-b79397db7e5d","timestamp":"2026-10-31T20:56:08.233Z","tool_use_meta":[{"id":"toolu_bdrk_01GycdWRwcKdYqnTBYas2Xmh","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
