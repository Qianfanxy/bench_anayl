ht=1;\nb2.appendChild(T('Jual',16,'Medium',C.txt,'Label'));\ncreated.push('Button / Secondary '+b2.id);\n\n// Chart · Price 1D\nconst ch=figma.createComponent(); page.appendChild(ch); ch.name='Chart · Price 1D'; ch.resize(343,154);\nch.layoutMode='VERTICAL'; ch.paddingLeft=12; ch.paddingRight=12; ch.paddingTop=12; ch.paddingBottom=12; ch.itemSpacing=4;\nch.cornerRadius=12; ch.fills=[solid(C.s1)];\nconst plot=figma.createFrame(); plot.name='Plot'; plot.fills=[]; plot.resize(319,112); \nconst area=figma.createVector(); area.name='Area';\narea.vectorPaths=[{windingRule:'NONZERO',data:'M 0 27.2 L 63.8 8 L 127.6 56 L 191.4 36.8 L 255.2 75.2 L 319 104 L 319 112 L 0 112 Z'}];\narea.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{r:0.153,g:0.588,b:0.275,a:0.30}},{position:1,color:{r:0.153,g:0.588,b:0.275,a:0}}]}];\narea.strokes=[];\nplot.appendChild(area); area.x=0; area.y=0;\nconst ln=figma.createVector(); ln.name='Line';\nln.vectorPaths=[{windingRule:'NONE',data:'M 0 27.2 L 63.8 8 L 127.6 56 L 191.4 36.8 L 255.2 75.2 L 319 104'}];\nln.fills=[]; ln.strokes=[solid(C.brandB)]; ln.strokeWeight=2; ln.strokeJoin='ROUND'; ln.strokeCap='ROUND';\nplot.appendChild(ln); ln.x=0; ln.y=0;\nconst dv=figma.createVector(); dv.name='CursorLine';\ndv.vectorPaths=[{windingRule:'NONE',data:'M 255.2 8 L 255.2 112'}];\ndv.fills=[]; dv.strokes=[solid(C.ter,0.6)]; dv.strokeWeight=1; dv.dashPattern=[2,3];\nplot.appendChild(dv); dv.x=0; dv.y=0;\nconst ring=figma.createEllipse(); ring.name='Ring'; ring.resize(16,16); ring.x=247.2; ring.y=67.2; ring.fills=[solid(C.brand,0.25)];\nplot.appendChild(ring);\nconst dot=figma.createEllipse(); dot.name='Dot'; dot.resize(8,8); dot.x=251.2; dot.y=71.2; dot.fills=[solid(C.white)]; dot.strokes=[solid(C.brandB)]; dot.strokeWeight=2;\nplot.appendChild(dot);\nch.appendChild(plot);\nconst lbls=figma.createFrame(); lbls.name='Axis'; lbls.fills=[]; lbls.layoutMode='HORIZONTAL'; lbls.resize(319,14); lbls.primaryAxisAlignItems='SPACE_BETWEEN'; lbls.counterAxisAlignItems='CENTER';\nfor (const s of ['6:00','10:00','14:00','18:00','22:00','2:00']) lbls.appendChild(T(s,10,'Regular',C.ter));\nch.appendChild(lbls);\nconst tpi=tp.createInstance(); tpi.name='Tooltip'; ch.appendChild(tpi); tpi.x=112; tpi.y=-2;\ncreated.push('Chart '+ch.id);\n\n// positions\nmr.x=0; mr.y=1480;\naoSet.x=370; aoSet.y=1480;\nsp.x=720; sp.y=1480;\nks.x=880; ks.y=1480;\ncr.x=1060; cr.y=1480;\nprSet.x=1430; prSet.y=1480;\ngs.x=1430; gs.y=1580;\ntp.x=1800; tp.y=1480;\nb2.x=1960; tp.x=1960; b2.y=1580; tp.y=1480;\nch.x=0; ch.y=1620;\n\nreturn 'OK\\n' + created.join('\\n');","description":"Create Method Row, Amount Option, Stepper, Key Stat, Compare Row, Payment Row, Guide Step, Tooltip, Secondary Button, Chart components","fileKey":"K1JM8KrV8Si1stciFJqXfQ"}}],"id":"cd29db9a-902f-4786-b96a-5cc0b2aeceb5","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"9a1582c6-6201-4705-96fb-bb880f77176a","uuid":"6d20fd70-d3ec-445b-a89b-5437ccc4a8db","timestamp":"2026-10-31T21:00:37.255Z","tool_use_meta":[{"id":"call_760759fb8a30481782faa474","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
