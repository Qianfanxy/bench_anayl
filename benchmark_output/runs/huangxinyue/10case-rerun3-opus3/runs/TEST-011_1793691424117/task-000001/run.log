(x=>x.name==='Progress Bar'); b.setProperties({Value:v}); out.push([n,b.width,b.findOne(x=>x.name==='Fill').width]);}\nreturn {set:set.id,out};","description":"Create Progress Bar variants and use them in Plan Row and Steps tile","fileKey":"7etw0umjivQ6Yi6l5iEkX3"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":741,"cache_read_input_tokens":86667,"cache_creation":{"ephemeral_5m_input_tokens":741,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1ed87517-1430-4a61-8f00-7b155f170969","uuid":"30db3b90-a055-48ef-952c-444f518853b0","timestamp":"2026-11-03T07:48:24.611Z","tool_use_meta":[{"id":"toolu_bdrk_01EH2rjT5jU8FWjetmAFK231","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
