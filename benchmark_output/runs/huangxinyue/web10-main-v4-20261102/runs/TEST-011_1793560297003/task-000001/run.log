ame='Components · Furniro'; sec.x=-3200; sec.y=0; sec.resizeWithoutConstraints(3000,6000);\nlet y=80; const ids={};\nfunction place(n,x=80){sec.appendChild(n); n.x=x; n.y=y; y+=n.height+80;}\nfunction variants(comps,name,gap=24){comps.forEach((c,i)=>{sec.appendChild(c);}); const s=figma.combineAsVariants(comps,sec); s.name=name; s.layoutMode='HORIZONTAL'; s.itemSpacing=gap; s.paddingLeft=s.paddingRight=s.paddingTop=s.paddingBottom=24; s.primaryAxisSizingMode='AUTO'; s.counterAxisSizingMode='AUTO'; s.fills=solid('#FFFFFF'); s.strokes=solid('#9747FF'); s.dashPattern=[6,4]; s.cornerRadius=8; s.counterAxisAlignItems='CENTER'; place(s); ids[name]=s.id; return s;}\nfunction bindText(set,prop,def,nodeName){const key=set.addComponentProperty(prop,'TEXT',def); for(const v of set.children){const t=v.findOne(n=>n.type==='TEXT'&&n.name===nodeName); if(t) t.componentPropertyReferences={characters:key};} return key;}\n\n// Nav Item\nconst navs=['No','Yes'].map(cur=>{const f=AL('VERTICAL',{gap:6,align:'CENTER',pad:[4,0,0,0]}); const t=T('Home',16,cur==='Yes'?'SemiBold':'Medium',cur==='Yes'?C.brand:C.ink,{name:'Label'}); f.appendChild(t); const bar=figma.createRectangle(); bar.name='Indicator'; bar.resize(24,2); bar.cornerRadius=1; bar.fills=cur==='Yes'?solid(C.brand):[]; f.appendChild(bar); const c=toComp(f); c.name='Current='+cur; return c;});\nconst navSet=variants(navs,'Nav Item'); bindText(navSet,'Label','Home','Label');\n\n// Badge\nconst badges=[['Sale',C.sale,'-30%'],['New',C.new,'New']].map(([k,col,txt])=>{const f=AL('HORIZONTAL',{align:'CENTER',justify:'CENTER',fill:col}); f.primaryAxisSizingMode='FIXED';f.counterAxisSizingMode='FIXED'; f.resize(48,48); f.cornerRadius=24; f.appendChild(T(txt,16,'Medium',C.white,{name:'Label'})); const c=toComp(f); c.name='Type='+k; return c;});\nconst badgeSet=variants(badges,'Badge'); bindText(badgeSet,'Label','-30%','Label');\n\n// Button Outline / Text link button\nconst btns=[['Outline','Default'],['Outline','Hover'],['Ghost Dark','Default']].map(([k,st])=>{const f=AL('HORIZONTAL',{align:'CENTER',justify:'CENTER',pad:[14,48,14,48],r:10,stroke:k==='Ghost Dark'?C.ink:C.brand,fill:st==='Hover'?C.brand:null}); f.appendChild(T('Show More',16,'SemiBold',st==='Hover'?C.white:(k==='Ghost Dark'?C.ink:C.brand),{name:'Label'})); const c=toComp(f); c.name='Style='+k+', State='+st; return c;});\nconst btnSet=variants(btns,'Button Secondary'); bindText(btnSet,'Label','Show More','Label');\n\n// Pagination\nconst pages=['Default','Current'].map(st=>{const f=AL('HORIZONTAL',{align:'CENTER',justify:'CENTER',fill:st==='Current'?C.brand:C.cream,r:10,pad:[0,24,0,24]}); f.counterAxisSizingMode='FIXED'; f.resize(60,60); f.primaryAxisSizingMode='AUTO'; f.minWidth=60; f.appendChild(T('1',20,'Regular',st==='Current'?C.white:C.ink,{name:'Label'})); const c=toComp(f); c.name='State='+st; return c;});\nconst pgSet=variants(pages,'Pagination Item'); bindText(pgSet,'Label','1','Label');\n\n// Slide dot\nconst dots=['Default','Current'].map(st=>{const f=AL('HORIZONTAL',{align:'CENTER',justify:'CENTER'}); f.primaryAxisSizingMode='FIXED';f.counterAxisSizingMode='FIXED'; f.resize(28,28); f.cornerRadius=14; if(st==='Current'){f.strokes=solid(C.brand);f.strokeWeight=1;} const d=figma.createEllipse(); d.resize(11,11); d.fills=solid(st==='Current'?C.brand:'#D8D8D8'); f.appendChild(d); const c=toComp(f); c.name='State='+st; return c;});\nvariants(dots,'Slide Dot');\n\n// Size chip\nconst sizes=['Default','Selected'].map(st=>{const f=AL('HORIZONTAL',{align:'CENTER',justify:'CENTER',fill:st==='Selected'?C.brand:C.cream,r:6}); f.primaryAxisSizingMode='FIXED';f.counterAxisSizingMode='FIXED'; f.resize(36,36); f.appendChild(T('L',13,'Medium',st==='Selected'?C.white:C.ink,{name:'Label'})); const c=toComp(f); c.name='State='+st; return c;});\nconst sizeSet=variants(sizes,'Size Chip'); bindText(sizeSet,'Label','L','Label');\n\n// Color swatch\nconst sw=['Default','Selected'].map(st=>{const f=AL('HORIZONTAL',{align:'CENTER',justify:'CENTER'});