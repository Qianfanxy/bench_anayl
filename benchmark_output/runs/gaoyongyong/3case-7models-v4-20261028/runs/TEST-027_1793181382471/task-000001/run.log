, b: 0.596 },\n  textTertiary: { r: 0.733, g: 0.741, b: 0.769 },\n  error: { r: 0.898, g: 0.282, b: 0.302 },\n  border: { r: 0.898, g: 0.906, b: 0.922 },\n  divider: { r: 0.937, g: 0.941, b: 0.949 },\n};\n\n// Helper: create a rectangle with image fill\nfunction imageRect(hash, w, h, scaleMode = \"FIT\") {\n  const r = figma.createRectangle();\n  r.resize(w, h);\n  r.fills = [{ type: \"IMAGE\", imageHash: hash, scaleMode: scaleMode }];\n  return r;\n}\n\n// Helper: create text\nfunction txt(chars, fontFamily, fontStyle, fontSize, color, lineHeight) {\n  const t = figma.createText();\n  t.fontName = { family: fontFamily, style: fontStyle };\n  t.characters = chars;\n  t.fontSize = fontSize;\n  t.fills = [{ type: \"SOLID\", color: color }];\n  if (lineHeight) t.lineHeight = { value: lineHeight, unit: \"PIXELS\" };\n  return t;\n}\n\n// Helper: rounded rect\nfunction rect(w, h, color, cornerRadius) {\n  const r = figma.createRectangle();\n  r.resize(w, h);\n  if (color) r.fills = [{ type: \"SOLID\", color: color }];\n  if (cornerRadius) r.cornerRadius = cornerRadius;\n  return r;\n}\n\n// Helper: ellipse\nfunction ellipse(w, h, color) {\n  const e = figma.createEllipse();\n  e.resize(w, h);\n  if (color) e.fills = [{ type: \"SOLID\", color: color }];\n  return e;\n}\n\n// Create 01_Splash frame\nconst splash = figma.createFrame();\nsplash.name = \"01_Splash\";\nsplash.resize(414, 932);\nsplash.fills = [{ type: \"SOLID\", color: C.white }];\nsplash.x = 0;\nsplash.y = 0;\nsplash.clipsContent = true;\n\n// Add logo centered\nconst logoSplash = imageRect(IMG.logo, 240, 159, \"FIT\");\nlogoSplash.x = (414 - 240) / 2;\nlogoSplash.y = (932 - 159) / 2 - 40;\nsplash.appendChild(logoSplash);\n\n// Add status bar\nconst statusBar = await figma.getNodeByIdAsync(\"48:43\");\nif (statusBar && statusBar.type === \"COMPONENT\") {\n  const sbInstance = statusBar.createInstance();\n  sbInstance.x = 0;\n  sbInstance.y = 0;\n  splash.appendChild(sbInstance);\n}\n\n// Add home indicator\nconst homeInd = await figma.getNodeByIdAsync(\"48:54\");\nif (homeInd && homeInd.type === \"COMPONENT\") {\n  const hiInstance = homeInd.createInstance();\n  hiInstance.x = 0;\n  hiInstance.y = 932 - 34;\n  splash.appendChild(hiInstance);\n}\n\npage.appendChild(splash);\n\nreturn \"01_Splash created: \" + splash.id;\n","description":"Create 01_Splash screen","fileKey":"BxIMHhCjiRBVph4Aa3oNRO"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"3394a1fc-48e8-404f-9f28-7846423ba2bb","uuid":"87d814a6-d40c-479a-91d3-93db28be51ee","timestamp":"2026-10-28T10:04:39.895Z","tool_use_meta":[{"id":"mcp__figma__use_figma_15_bd3a0f67","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
