Content=true; WS.appendChild(f);\nconst sb=await inst('49:130'); f.appendChild(sb); sb.x=0; sb.y=0;\nconst back=await inst('2006:3'); back.x=24; back.y=64; f.appendChild(back);\nconst srch=await inst('2006:9'); srch.x=430-24-40; srch.y=64; f.appendChild(srch);\n\nconst img=await imgFit('1:244',150,206); img.x=24; img.y=128; f.appendChild(img);\nimg.effects=[{type:'DROP_SHADOW',color:{r:0.24,g:0.18,b:0.18,a:0.18},offset:{x:0,y:14},radius:28,spread:0,visible:true,blendMode:'NORMAL'}];\nconst copy=await T(f,'Customize Your Burger to Your Tastes. Ultimate Experience',{x:196,y:150,w:210,size:20,style:'Bold',color:BROWN,lh:26});\n\nawait T(f,'Portion',{x:24,y:370,size:15,style:'SemiBold',color:BROWN});\nconst sp=await inst('2006:65'); sp.x=24; sp.y=396; f.appendChild(sp);\nawait T(f,'Spicy',{x:262,y:370,size:15,style:'SemiBold',color:BROWN});\nconst sl=await inst('2007:54'); sl.x=215; sl.y=394; f.appendChild(sl);\n\nawait T(f,'Toppings',{x:24,y:462,size:16,style:'SemiBold',color:BROWN});\nconst toppings=[\n  ['1:252','Tomato',true],['1:257','Onions',false],['1:262','Pickles',false],['1:267','Bacon',false],\n  ['1:272','Cheese',true],['1:277','Mushroom',false],['1:282','Avocado',false],\n];\nlet tx=24;\nfor(const [imgId,nm,added] of toppings){\n  const c=await inst(added?'2006:82':'2006:74');\n  const old=c.findOne(n=>n.type==='RECTANGLE'&&Array.isArray(n.fills)&&n.fills[0]&&n.fills[0].type==='IMAGE');\n  const src=await figma.getNodeByIdAsync(imgId);\n  const k=Math.min(64/src.width,56/src.height);\n  const ni=src.clone(); ni.resize(Math.round(src.width*k),Math.round(src.height*k));\n  ni.x=(96-ni.width)/2; ni.y=10+(56-ni.height)/2;\n  c.insertChild(c.children.indexOf(old),ni); old.remove();\n  const t=c.findAll(n=>n.type==='TEXT').find(n=>n.fontSize===12); t.characters=nm; t.x=(96-t.width)/2;\n  c.x=tx; c.y=492; f.appendChild(c); tx+=96+10;\n}\nawait T(f,'Side options',{x:24,y:636,size:16,style:'SemiBold',color:BROWN});\nconst sides=[\n  ['1:290','Fries',true],['1:295','Coleslaw',false],['1:300','Salad',false],['1:305','Onion Rings',false],['1:310','Mozzarella Sticks',false],\n];\nlet sx=24;\nfor(const [imgId,nm,added] of sides){\n  const c=await inst(added?'2006:82':'2006:74');\n  const old=c.findOne(n=>n.type==='RECTANGLE'&&Array.isArray(n.fills)&&n.fills[0]&&n.fills[0].type==='IMAGE');\n  const src=await figma.getNodeByIdAsync(imgId);\n  const k=Math.min(64/src.width,56/src.height);\n  const ni=src.clone(); ni.resize(Math.round(src.width*k),Math.round(src.height*k));\n  ni.x=(96-ni.width)/2; ni.y=10+(56-ni.height)/2;\n  c.insertChild(c.children.indexOf(old),ni); old.remove();\n  const t=c.findAll(n=>n.type==='TEXT').find(n=>n.fontSize===12); t.characters=nm; t.x=(96-t.width)/2;\n  c.x=sx; c.y=666; f.appendChild(c); sx+=96+8;\n}\n// total + CTA\nawait T(f,'Total',{x:24,y:822,size:12,style:'Medium',color:SUB});\nawait T(f,'$16.48',{x:24,y:838,size:26,style:'Bold',color:RED});\nconst btn=await inst('2004:9'); btn.resize(238,64); btn.x=430-24-238; btn.y=820; f.appendChild(btn);\nconst hi=await inst('49:141'); f.appendChild(hi); hi.x=0; hi.y=1100-34;\n\nreturn JSON.stringify({customize:f.id, back:back.id, btn:btn.id});\n","description":"Build 07_Customize screen with exploded burger, portion/spicy, toppings, side options, total","fileKey":"xCaQ6D2H3AhzjPBYLooEMF"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"646e8bf7-f7ad-4c70-b0b4-d0ae7901c022","uuid":"5474ad5a-e971-4f74-9210-afa665c9a420","timestamp":"2026-10-28T16:36:50.076Z","tool_use_meta":[{"id":"mcp__figma__use_figma_22_87952f2b","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
