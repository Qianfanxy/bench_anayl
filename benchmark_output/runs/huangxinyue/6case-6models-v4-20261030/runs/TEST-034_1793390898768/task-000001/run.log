nstance = photoOrig.createInstance();\n      pInstance.resize(64, 64);\n      pInstance.x = 0;\n      pInstance.y = 8;\n      row.appendChild(pInstance);\n    }\n\n    // Name & pack qty text\n    const nameText = figma.createText();\n    nameText.characters = name;\n    nameText.fontName = { family: \"Nunito\", style: \"Bold\" };\n    nameText.fontSize = 16;\n    nameText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n    nameText.x = 80;\n    nameText.y = 12;\n    row.appendChild(nameText);\n\n    const qtyText = figma.createText();\n    qtyText.characters = qty;\n    qtyText.fontName = { family: \"Nunito\", style: \"Regular\" };\n    qtyText.fontSize = 14;\n    qtyText.fills = [{ type: 'SOLID', color: { r: 0.35, g: 0.35, b: 0.35 } }];\n    qtyText.x = 80;\n    qtyText.y = 36;\n    row.appendChild(qtyText);\n\n    // Price\n    const nairaOrig = await getOrig(\"2:83\");\n    if (nairaOrig) {\n      const naira = nairaOrig.createInstance();\n      naira.x = 220;\n      naira.y = 30;\n      row.appendChild(naira);\n    }\n\n    const priceText = figma.createText();\n    priceText.characters = price;\n    priceText.fontName = { family: \"Nunito\", style: \"Bold\" };\n    priceText.fontSize = 16;\n    priceText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n    priceText.x = 240;\n    priceText.y = 28;\n    row.appendChild(priceText);\n\n    // Divider line at the bottom of the row\n    const rowLine = figma.createRectangle();\n    rowLine.resize(327, 1);\n    rowLine.x = 0;\n    rowLine.y = 79;\n    rowLine.fills = [{ type: 'SOLID', color: { r: 0.94, g: 0.94, b: 0.94 } }];\n    row.appendChild(rowLine);\n\n    return row;\n  };\n\n  // --- Frame 06_Basket ---\n  const frameBasket = createFrame(\"06_Basket\", 2125, 0);\n  frameBasket.fills = [{ type: 'SOLID', color: brandPrimaryColor }]; // top section color\n  await addShell(frameBasket);\n\n  // Top header: Go back + My Basket title\n  const iconBackOrig = await getOrig(\"2:117\");\n  if (iconBackOrig) {\n    const goBackBtn = figma.createFrame();\n    goBackBtn.name = \"Go back\";\n    goBackBtn.resize(80, 32);\n    goBackBtn.x = 24;\n    goBackBtn.y = 56;\n    goBackBtn.cornerRadius = 16;\n    goBackBtn.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n    \n    const backIcon = iconBackOrig.createInstance();\n    backIcon.x = 8;\n    backIcon.y = 4;\n    goBackBtn.appendChild(backIcon);\n\n    const backText = figma.createText();\n    backText.characters = \"Go back\";\n    backText.fontName = { family: \"Nunito\", style: \"SemiBold\" };\n    backText.fontSize = 12;\n    backText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n    backText.x = 28;\n    backText.y = 8;\n    goBackBtn.appendChild(backText);\n\n    frameBasket.appendChild(goBackBtn);\n  }\n\n  const headerTitle = figma.createText();\n  headerTitle.characters = \"My Basket\";\n  headerTitle.fontName = { family: \"Nunito\", style: \"Bold\" };\n  headerTitle.fontSize = 24;\n  headerTitle.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  headerTitle.x = 130;\n  headerTitle.y = 56;\n  frameBasket.appendChild(headerTitle);\n\n  // White background bottom sheet\n  const basketSheet = figma.createFrame();\n  basketSheet.name = \"Basket Sheet\";\n  basketSheet.resize(375, 680);\n  basketSheet.x = 0;\n  basketSheet.y = 120;\n  basketSheet.cornerRadius = 24;\n  basketSheet.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n\n  // Items: Quinoa fruit salad · Melon fruit salad · Tropical fruit salad, each with photo, name, “2 packs” and ₦20,000\n  const row1 = await createBasketRow({\n    name: \"Quinoa fruit salad\",\n    price: \"20,000\",\n    qty: \"2 packs\",\n    photoId: \"2:20\",\n    yPos: 40\n  });\n  basketSheet.appendChild(row1);\n\n  const row2 = await createBasketRow({\n    name: \"Melon fruit salad\",\n    price: \"20,000\",\n    qty: \"2 packs\",\n    photoId: \"2:26\",\n    yPos: 130\n  });\n  basketSheet.appendChild(row2);\n\n  const row3 = await createBasketRow({\n    name: \"Tropical fruit salad\",\n    price: \"20,000\",\n    qty: \"2 packs\",\n    photoId: \"2:23\",\n    yPos: 220\n  });\n  basketSheet.appendChild(row3);\n\n  // Total section at bottom\n  const totalRow = figma.createFrame();\n  totalRow.name = \"Total Row\";\n  totalRow.resize(327, 40);\n  totalRow.x = 24;\n  totalRow.y = 480;\n  totalRow.fills = [];\n\n  const totalLabel = figma.createText();\n  totalLabel.characters = \"Total\";\n  totalLabel.fontName = { family: \"Nunito\", style: \"Bold\" };\n  totalLabel.fontSize = 18;\n  totalLabel.fills = [{ type: 'SOLID', color: brandDarkColor }];\n  totalLabel.x = 0;\n  totalLabel.y = 6;\n  totalRow.appendChild(totalLabel);\n\n  const nairaOrig = await getOrig(\"2:83\");\n  if (nairaOrig) {\n    const totalNaira = nairaOrig.createInstance();\n    totalNaira.x = 210;\n    totalNaira.y = 8;\n    totalRow.appendChild(totalNaira);\n  }\n\n  const totalText = figma.createText();\n  totalText.characters = \"60,000\";\n  totalText.fontName = { family: \"Nunito\", style: \"Bold\" };\n  totalText.fontSize = 22;\n  totalText.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n  totalText.x = 230;\n  totalText.y = 4;\n  totalRow.appendChild(totalText);\n\n  basketSheet.appendChild(totalRow);\n\n  // Button Checkout\n  const buttonOrig = await getOrig(\"3:25\");\n  if (buttonOrig) {\n    const checkoutBtn = buttonOrig.createInstance();\n    checkoutBtn.x = 24;\n    checkoutBtn.y = 540;\n    const btnText = checkoutBtn.findOne(n => n.type === \"TEXT\");\n    if (btnText) {\n      btnText.characters = \"Checkout\";\n    }\n    basketSheet.appendChild(checkoutBtn);\n  }\n\n  frameBasket.appendChild(basketSheet);\n\n  return \"Frame 06_Basket built successfully\";\n})()","description":"Build 06_Basket frame on 03 · Workspace (fixed nairaOrig reference)","fileKey":"jiYwYdVVeh1sSSwCPVx5uG"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":36491,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read