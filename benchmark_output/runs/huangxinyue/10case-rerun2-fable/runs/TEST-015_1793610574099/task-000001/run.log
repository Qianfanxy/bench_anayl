; ln.x=0; ln.y=0;\n  ['Home','Explore','Analytics','Profile'].forEach((n,i)=>{\n    const inst=tabMasters[n+(n===active?'Active':'Inactive')].createInstance();\n    c.appendChild(inst); inst.x=12+i*91.5; inst.y=12;\n  });\n  tabBars[active]=c; put(c,0,80);\n});\n\n// ---- compact workout card ----\nfunction cardMaster(name,hash,kcal,min){\n  const c=mkComp('Card / '+name,175,206,C.white,20); c.clipsContent=true; c.effects=SH(0.09,8);\n  const ph=photo(hash,175,128,0); c.appendChild(ph); ph.x=0; ph.y=0;\n  const sc=grad(175,128,dk(0),dk(0.5)); c.appendChild(sc); sc.x=0; sc.y=0;\n  const play=figma.createEllipse(); play.name='Play'; play.resize(34,34); play.fills=[{type:'SOLID',color:H(C.lime)}]; c.appendChild(play); play.x=127; play.y=78;\n  const pi=icon(ICON.play,C.char,14); c.appendChild(pi); pi.x=137; pi.y=88;\n  const nm=txt(name,'Body / 14 Bold',C.char,{bold:true,size:13,w:150}); nm.name='Name'; c.appendChild(nm); nm.x=12; nm.y=138;\n  const meta=figma.createFrame(); meta.name='Meta'; meta.resize(151,18); meta.fills=[]; c.appendChild(meta); meta.x=12; meta.y=176;\n  meta.layoutMode='HORIZONTAL'; meta.counterAxisAlignItems='CENTER'; meta.itemSpacing=4;\n  meta.appendChild(icon(ICON.fire,C.ink2,12));\n  const k=txt(kcal,'Caption / 12 Regular',C.ink2,{size:11}); k.name='Kcal'; meta.appendChild(k);\n  const dot=rect('Dot',3,3,'#D6DDE0',1.5); meta.appendChild(dot);\n  meta.appendChild(icon(ICON.timer,C.ink2,12));\n  const m=txt(min,'Caption / 12 Regular',C.ink2,{size:11}); m.name='Min'; meta.appendChild(m);\n  return c;\n}\nconst cardLower=cardMaster('Lower Body Training',IMG.lower,'500 Kcal','50 Min'); put(cardLower,0,180);\nconst cardHand=cardMaster('Hand Training',IMG.hand,'600 Kcal','40 Min'); put(cardHand,190,180);\n\n// ---- plan rows with baked level ----\nfunction planRowMaster(name,meta,level,pct,hash){\n  const c=mkComp('PlanRow / '+name,350,82,C.white,18); c.effects=SH(0.05,6);\n  const ph=photo(hash,58,58,15); c.appendChild(ph); ph.x=11; ph.y=12;\n  const nm=txt(name,'Body / 14 Bold',C.char,{bold:true,size:14}); nm.name='Name'; c.appendChild(nm); nm.x=82; nm.y=12;\n  const mm=txt(meta,'Caption / 12 Regular',C.ink2,{size:11}); mm.name='Meta'; c.appendChild(mm); mm.x=82; mm.y=30;\n  const lv=lvPick(level).createInstance(); c.appendChild(lv); lv.x=350-14-lv.width; lv.y=13;\n  const tr=rect('Track',168,6,C.track,3); c.appendChild(tr); tr.x=82; tr.y=56;\n  const pf=rect('Progress',168*pct/100,6,C.lime,3); c.appendChild(pf); pf.x=82; pf.y=56;\n  const p=txt(pct+'%','Caption / 12 Regular',C.char,{size:11,bold:true}); p.name='Pct'; c.appendChild(p); p.x=300; p.y=51;\n  return c;\n}\nconst rowPush=planRowMaster('Push Up','100 push ups a day','Intermediate',45,IMG.push); put(rowPush,380,80);\nconst rowSit=planRowMaster('Sit Up','20 sit ups a day','Beginner',75,IMG.sit); put(rowSit,380,175);\nconst rowKnee=planRowMaster('Knee Push Up','20 knee push ups a day','Beginner',45,IMG.knee); put(rowKnee,380,270);\n\n// ---- challenge chip ----\nfunction challengeMaster(title){\n  const c=mkComp('Challenge / '+title,110,72,C.char,18);\n  const t=txt(title,'Body / 14 Bold',C.white,{bold:true,size:12,w:86}); t.name='Name'; c.appendChild(t); t.x=12; t.y=12;\n  const a=icon(ICON.chev,C.lime,14); c.appendChild(a); a.x=12; a.y=44;\n  return c;\n}\nconst chPlank=challengeMaster('Plank Challenge'); put(chPlank,760,80);\nconst chSprint=challengeMaster('Sprint Challenge'); put(chSprint,880,80);\nconst chSquat=challengeMaster('Squat Challenge'); put(chSprint,880,80);\nput(chSquat,1000,80);\n\n// ---- compact program tile ----\nfunction progMaster(name,meta,hash,level,extra){\n  const c=mkComp('Program / '+name,171,150,0,0);\n  const ph=photo(hash,171,92,16); c.appendChild(ph); ph.x=0; ph.y=0;\n  const nm=txt(name,'Body / 14 Bold',C.char,{bold:true,size:13,w:168}); nm.name='Name'; c.appendChild(nm); nm.x=0; nm.y=100;\n  const mm=txt(meta,'Caption / 12 Regular',C.ink2,{size:11}); mm.name='Meta'; c.appendChild(mm); mm.x=0; mm.y=120;\n  const lv=lvP