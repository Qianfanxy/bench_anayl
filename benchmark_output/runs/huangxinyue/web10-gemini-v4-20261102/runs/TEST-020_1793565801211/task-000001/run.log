outMode = \"HORIZONTAL\";\n  techGrid.itemSpacing = 20;\n  techGrid.layoutAlign = \"STRETCH\";\n  techGrid.fills = [];\n\n  const techList = [\n    { label: \"JavaScript\", logo: logoJS },\n    { label: \"Next.js\", logo: logoNext },\n    { label: \"HTML5\", logo: logoHTML5 },\n    { label: \"CSS3\", logo: logoCSS3 },\n    { label: \"React\", logo: logoReact }\n  ];\n\n  for (const tech of techList) {\n    const badge = figma.createFrame();\n    badge.name = `Tech Badge - ${tech.label}`;\n    badge.layoutMode = \"HORIZONTAL\";\n    badge.paddingLeft = 24;\n    badge.paddingRight = 24;\n    badge.paddingTop = 16;\n    badge.paddingBottom = 16;\n    badge.cornerRadius = 14;\n    badge.itemSpacing = 14;\n    badge.counterAxisAlignItems = \"CENTER\";\n    badge.fills = [{ type: 'SOLID', color: COLOR_SURFACE }];\n    badge.strokes = [{ type: 'SOLID', color: COLOR_BORDER }];\n    badge.strokeWeight = 1;\n    badge.layoutGrow = 1;\n\n    if (tech.logo) {\n      const lInst = tech.logo.createInstance();\n      recolorNode(lInst, COLOR_ORANGE);\n      badge.appendChild(lInst);\n    }\n\n    const tLabel = figma.createText();\n    tLabel.fontName = { family: \"Poppins\", style: \"Semi Bold\" };\n    tLabel.fontSize = 16;\n    tLabel.characters = tech.label;\n    tLabel.fills = [{ type: 'SOLID', color: COLOR_TEXT_PRIMARY }];\n    badge.appendChild(tLabel);\n\n    techGrid.appendChild(badge);\n  }\n\n  techSection.appendChild(techTitle);\n  techSection.appendChild(techGrid);\n  homeFrame.appendChild(techSection);\n\n  // 4. PROJECTS SECTION\n  const projectsSection = figma.createFrame();\n  projectsSection.name = \"Projects Section\";\n  projectsSection.layoutMode = \"VERTICAL\";\n  projectsSection.paddingLeft = 80;\n  projectsSection.paddingRight = 80;\n  projectsSection.paddingTop = 80;\n  projectsSection.paddingBottom = 80;\n  projectsSection.itemSpacing = 40;\n  projectsSection.layoutAlign = \"STRETCH\";\n  projectsSection.fills = [];\n\n  const projTitle = figma.createText