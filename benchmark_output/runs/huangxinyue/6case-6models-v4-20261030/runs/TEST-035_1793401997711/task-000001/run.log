av(s6.findOne(n=>n.name==='Button · I’m ready to start!'),s7);\nnav(s7.findOne(n=>n.name==='PortfolioCard'),s8);\n{const rows=s7.children.filter(n=>n.type==='INSTANCE'&&n.mainComponent&&n.mainComponent.name==='Stock Row');\nif(rows[0])nav(rows[0],s9);}\nnav(s8.findOne(n=>n.name==='Back'),s7);\n{const rows=s8.children.filter(n=>n.type==='INSTANCE'&&n.mainComponent&&n.mainComponent.name==='Stock Row');\nif(rows[0])nav(rows[0],s9);}\nnav(s9.findOne(n=>n.name==='Back'),s7);\nnav(s9.findOne(n=>n.name==='Button · Buy stocks'),s10);\nnav(s10.findOne(n=>n.name==='Back'),s9);\nnav(s10.findOne(n=>n.name==='Button · Confirm order'),s7);\n// tab bars: 07 home(current), 08 portfolio(current), 11 profile(current)\nasync function wireTab(frame,current){\n  const bar=frame.children.find(n=>n.type==='INSTANCE'&&n.mainComponent&&n.mainComponent.name==='Main Navigation');\n  if(!bar)return;\n  const map={'Home':s7,'Portfolio':s8,'Trade':s10,'Profile':s11};\n  for(const [label,dst] of Object.entries(map)){\n    if(label===current)continue;\n    const tab=bar.findOne(n=>n.name==='Tab '+label);\n    if(tab)nav(tab,dst);\n  }\n}\nawait wireTab(s7,'Home');await wireTab(s8,'Portfolio');await wireTab(s11,'Profile');\nreturn 'wired';\n","description":"Wire prototype interactions between screens"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"9458b504-b751-4b03-9680-f776dd3321b8","uuid":"2f282b4b-cd3d-4372-8011-9cd48b3817ea","timestamp":"2026-10-30T23:37:44.380Z","tool_use_meta":[{"id":"mcp__figma__use_figma_27_14a9f8b6","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
