{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_209b741ee2b240eabb82cb10","name":"mcp__figma__use_figma","input":{"code":"\nconst F = s => ({ family: 'Inter', style: s });\nawait Promise.all(['Regular','Medium','Semi Bold','Bold','Extra Bold'].map(s => figma.loadFontAsync(F(s))));\nconst hex = (h, o = 1) => { const n = parseInt(h.slice(1), 16); return { type: 'SOLID', color: { r: ((n>>16)&255)/255, g: ((n>>8)&255)/255, b: (n&255)/255 }, opacity: o }; };\nconst C = { brand:'#24C8FE', brandSoft:'#E4F6FE', ink:'#10232E', sub:'#71808C', faint:'#9AA6B2', surface:'#FFFFFF', line:'#EDF1F5' };\nconst SH = [{ type:'DROP_SHADOW', color:{r:0.06,g:0.15,b:0.24,a:0.08}, offset:{x:0,y:10}, radius:30, spread:-4, visible:true, blendMode:'NORMAL' }];\nconst ws = await figma.getNodeByIdAsync('5:2');\nfor (const n of [...ws.children]) { if (['Class Card',\"Today's Activity Card\",'Screen Header','Chart · Calories'].includes(n.name)) n.remove(); }\nfunction txt(chars, style, size, fill, o={}) { const t = figma.createText(); t.fontName = F(style); t.fontSize = size; t.characters = chars; t.fills = [fill]; if (o.name) t.name = o.name; return t; }\nfunction comp(name) { const c = figma.createComponent(); c.name = name; ws.appendChild(c); return c; }\nfunction put(parent, node, x, y) { parent.appendChild(node); node.x = x; node.y = y; return node; }\nasync function icon(id, parent, x, y, w, h, color) { const c = await figma.getNodeByIdAsync(id); const i = c.createInstance(); i.resize(w, h); i.x = x; i.y = y; if (color) i.findAll(n => n.type === 'VECTOR').forEach(v => { v.fills = [color]; }); parent.appendChild(i); return i; }\nconst out = {};\n\n// ---- Class Card ----\nconst cl = comp('Class Card'); cl.resize(366, 170); cl.cornerRadius = 20; cl.fills = [hex(C.surface)]; cl.effects = SH; cl.clipsContent = false;\nput(cl, txt('Yoga Class','Bold',18,hex(C.ink),{name:'Title'}), 20, 30);\nput(cl, txt('With Rachael Wisdom','Medium',13,hex(C.sub),{name:'Subtitle'}), 20, 58);\nconst photo = (await figma.getNodeByIdAsync('3:15')).createInstance(); photo.name = 'Photo'; photo.resize(140, 140); photo.cornerRadius = 16; put(cl, photo, 211, 15);\nconst fav = figma.createFrame(); fav.name = 'Favorite'; fav.resize(36, 36); fav.cornerRadius = 18; fav.fills = [hex(C.surface)]; fav.effects = SH;\nawait icon('3:20', fav, 9, 10.5, 17.92, 15.23, hex('#FF6B6B'));\nput(cl, fav, 307, 23);\nout.classCard = cl.id; cl.x = 880; cl.y = 0;\n\n// ---- Today's Activity Card ----\nconst ta = comp(\"Today's Activity Card\"); ta.resize(366, 120); ta.cornerRadius = 20;\nta.fills = [{ type:'GRADIENT_LINEAR', gradientTransform:[[1,0,0],[0,1,0]], gradientStops:[ {position:0, color:{r:0.141,g:0.784,b:0.996,a:1}}, {position:1, color:{r:0.278,g:0.839,b:1,a:1}} ] }];\nta.effects = SH; ta.clipsContent = false;\nput(ta, txt(\"Today's activity\",'Bold',18,hex(C.surface),{name:'Title'}), 20, 30);\nput(ta, txt('8.00 AM - 1.30 PM','Medium',14,hex(C.surface,0.9),{name:'Time'}), 20, 58);\nconst ill = (await figma.getNodeByIdAsync('3:31')).createInstance(); ill.name = 'Illustration'; ill.resize(122, 122); ill.findAll(n => n.type === 'VECTOR').forEach(v => { v.fills = [hex(C.surface, 0.95)]; });\nput(ta, ill, 226, -1);\nout.todayCard = ta.id; ta.x = 880; ta.y = 210;\n\n// ---- Screen Header ----\nconst hc = comp('Screen Header'); hc.layoutMode = 'HORIZONTAL'; hc.primaryAxisAlignItems = 'SPACE_BETWEEN'; hc.counterAxisAlignItems = 'CENTER'; hc.resize(366, 40); hc.fills = [];\nconst ibC = await figma.getNodeByIdAsync('8:2');\nconst backBtn = ibC.createInstance(); backBtn.name = 'Back'; hc.appendChild(backBtn);\nconst hcT = txt('Your activities','Bold',18,hex(C.ink),{name:'Title'}); hc.appendChild(hcT);\nconst moreBtn = ibC.createInstance(); moreBtn.name = 'More'; hc.appendChild(moreBtn);\nconst moreIcon = moreBtn.findOne(n => n.type === 'INSTANCE');\nconst iconMore = await figma.getNodeByIdAsync('3:23');\nmoreIcon.swapComponent(iconMore); moreIcon.resize(9, 27); moreIcon.x = 15.5; moreIcon.y = 6.5; moreIcon.findAll(n => n.type === 'VECTOR').forEach(v => { v.fills = [hex(C.ink)]; });\nout.screenHeader = hc.id; hc.x = 880; hc.y = 420;\n\n// ---- Chart ----\nconst ch = comp('Chart · Calories'); ch.resize(366, 188); ch.cornerRadius = 20; ch.fills = [hex(C.surface)]; ch.effects = SH; ch.clipsContent = false;\nput(ch, txt('1680','Extra Bold',28,hex(C.ink),{name:'Calories'}), 20, 16);\nput(ch, txt('kcal','Medium',13,hex(C.sub),{name:'Unit'}), 20, 54);\n[88, 118, 148].forEach(gy => { const ln = figma.createRectangle(); ln.name = 'Grid'; ln.resize(326, 1); ln.fills = [hex(C.line)]; put(ch, ln, 20, gy); });\nconst vals = [40,55,70,60,85,75,90,105,120];\nconst pts = vals.map((v, i) => ({ x: 20 + i * (326/8), y: 152 - (v/130)*84 }));\nlet d = `M ${pts[0].x} ${pts[0].y}`;\nfor (let i = 1; i < pts.length; i++) { const p0 = pts[i-1], p1 = pts[i]; const dx = (p1.x - p0.x) / 3; d += ` C ${p0.x + dx} ${p0.y} ${p1.x - dx} ${p1.y} ${p1.x} ${p1.y}`; }\nconst areaV = figma.createVector(); areaV.name = 'Area'; ch.appendChild(areaV);\nareaV.vectorPaths = [{ windingRule:'NONZERO', data: d + ` L ${pts[8].x} 156 L 20 156 Z` }];\nareaV.fills = [{ type:'GRADIENT_LINEAR', gradientTransform:[[0,1,0],[-1,0,1]], gradientStops:[ {position:0, color:{r:0.141,g:0.784,b:0.996,a:0.32}}, {position:1, color:{r:0.141,g:0.784,b:0.996,a:0}} ] }]; areaV.strokes = [];\nconst lineV = figma.createVector(); lineV.name = 'Curve'; ch.appendChild(lineV);\nlineV.vectorPaths = [{ windingRule:'NONZERO', data: d }];\nlineV.fills = []; lineV.strokes = [hex(C.brand)]; lineV.strokeWeight = 2.5; lineV.strokeCap = 'ROUND';\nconst last = pts[8];\nconst dot = figma.createEllipse(); dot.name = 'Dot'; dot.resize(10, 10); put(ch, dot, last.x - 5, last.y - 5); dot.fills = [hex(C.brand)]; dot.strokes = [hex(C.surface)]; dot.strokeWeight = 2;\nconst tip = figma.createFrame(); tip.name = 'Tooltip'; tip.cornerRadius = 10; tip.fills = [hex(C.ink)]; tip.layoutMode = 'HORIZONTAL'; tip.primaryAxisAlignItems = 'CENTER'; tip.counterAxisAlignItems = 'CENTER'; tip.paddingLeft = 10; tip.paddingRight = 10; tip.paddingTop = 6; tip.paddingBottom = 6;\nconst tipT = txt('120 cal','Semi Bold',12,hex(C.surface)); tip.appendChild(tipT);\nput(ch, tip, 0, 0); tip.x = last.x - tip.width/2; tip.y = last.y - tip.height - 10;\n[['8AM',20],['10AM',99.5],['12PM',179],['2PM',258.5],['4PM',338]].forEach(([s, x]) => { const t = txt(s,'Medium',11,hex(C.faint),{name:'Axis'}); put(ch, t, 0, 162); t.x = x - t.width/2; });\nout.chart = ch.id; ch.x = 880; ch.y = 640;\nreturn JSON.stringify(out);\n","description":"Rebuild Class Card, Today's Activity Card, Screen Header, Calories Chart","fileKey":"7rLveN0IHU79pD7QwJ97Mb"}}],"id":"ba9dfadc-8377-478c-913f-74b4c5219ff0","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"4461202f-e76f-4edc-acde-2f8130872b79","uuid":"47a6a258-4ff7-4dfd-9599-1ec0622a8841","timestamp":"2026-11-02T08:05:59.505Z","tool_use_meta":[{"id":"call_209b741ee2b240eabb82cb10","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
