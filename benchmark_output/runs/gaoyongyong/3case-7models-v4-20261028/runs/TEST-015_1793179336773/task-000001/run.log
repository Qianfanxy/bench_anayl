],\n['Body/Regular','Inter','Regular',14,20,0],\n['Body/Strong','Inter','Semi Bold',14,20,0],\n['Label/Small','Inter','Semi Bold',12,16,0.2],\n['Caption','Inter','Regular',12,16,0],\n['Button/Label','Inter','Semi Bold',17,22,0],\n];\nfor(const [n,f,s,size,lh,ls] of ts){const st=figma.createTextStyle(); st.name=n; st.fontName={family:f,style:s}; st.fontSize=size; st.lineHeight={unit:'PIXELS',value:lh}; st.letterSpacing={unit:'PIXELS',value:ls};}\nreturn {coll:coll.id, vars:Object.keys(vars).length};"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":69,"cache_creation_input_tokens":31578,"cache_read_input_tokens":9366,"cache_creation":{"ephemeral_5m_input_tokens":31578,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"cec50fe8-0981-4a9e-a5f5-60c5e79e1651","uuid":"2a52cd99-c4e3-4824-9c01-05df6d172b0d","timestamp":"2026-10-28T09:25:54.020Z","tool_use_meta":[{"id":"toolu_bdrk_01BEq3i2fSNCBa1ggmD4m9zD","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
