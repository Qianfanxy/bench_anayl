ndChild(stp);stp.x=252;stp.y=64;return c;}\n     function chkRow(parent,x,y,label,value,opts){const r=MASTER[\"Checkout Row\"].createInstance();parent.appendChild(r);r.x=x;r.y=y;findTxt(r).characters=label;const v=findN(r,n=>n.name===\"Value\"&&n.type===\"TEXT\");if(value){v.characters=value;}else{v.visible=false;}if(opts&&opts.total){v.fontSize=20;v.fontName={family:\"Poppins\",style:\"Bold\"};v.fills=[F(C.dark)];const cv=findN(r,n=>n.name===\"Chevron\");cv.visible=false;const dv=findN(r,n=>n.name===\"Divider\");dv.visible=false;}return r;}\n     function listRow(parent,y,label,iconName){const r=MASTER[\"List Entry\"].createInstance();parent.appendChild(r);r.x=24;r.y=y;findTxt(r).characters=label;const ei=findN(r,n=>n.name===\"EntryIcon\");ei.swapComponent(MASTER[iconName]);const s=Math.min(24/ei.width,24/ei.height);if(s<1)ei.resize(ei.width*s,ei.height*s);recolor(ei,C.dark);return r;}\n     ```\n     Tab Bar instance pattern: `const TB=findN(figma.root,n=>n.type===\"COMPONENT_SET\"&&n.name===\"Tab Bar\");const tb=TB.children.find(c=>c.name===\"ActiveTab=Shop\").createInstance();parent.appendChild(tb);tb.x=0;tb.y=<y>;`\n\n   - **PROTOTYPE WIRING (COMPLETED, all 26 \"ok\")** — final working code shape:\n     ```js\n     function link(srcName,frame,dest,tag){const s=findN(frame,n=>n.name===srcName);if(!s){R[tag]=\"MISSING\";return;}s.reactions=[{actions:[{type:\"NODE\",destinationId:dest.id,navigation:\"NAVIGATE\",transition:null}],trigger:{type:\"ON_CLICK\"}}];}\n     // splash auto: f1.reactions=[{actions:[{type:\"NODE\",destinationId:f2.id,navigation:\"NAVIGATE\",transition:null}],trigger:{type:\"AFTER_TIMEOUT\",timeout:2000}}];\n     ```\n     Link map (tag: from → to): auto: 01→02 (AFTER_TIMEOUT 2000); getStarted: 02→03 (Btn/Get Started); phone: 03→04 (Tap/Phone); vBack: 04→03 (Btn/Back); vNext: 04→05 (Btn/Next); redApple: 05→06 (Card/Red Apple); hExplore: 05→07; hCart: 05→09; hAccount: 05→12 (hotspots); pdBack: 06→05; addBasket: 06→09 (Btn/Add To Basket); bevCa