\n    }\n  }\n\n  // Hold to Invest button bar (Icon_Face_ID)\n  const actionPanel = figma.createFrame();\n  actionPanel.name = \"Action_Panel\";\n  actionPanel.resize(375, 120);\n  actionPanel.x = 0; actionPanel.y = 580 - 120;\n  actionPanel.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  actionPanel.strokes = [{ type: 'SOLID', color: { r: 0.94, g: 0.94, b: 0.96 } }];\n  sheet.appendChild(actionPanel);\n\n  // Big Rounded Button \"Hold to Invest\"\n  const holdBtn = figma.createFrame();\n  holdBtn.name = \"Hold_To_Invest_Button\";\n  holdBtn.resize(335, 52);\n  holdBtn.x = 20; holdBtn.y = 16;\n  holdBtn.cornerRadius = 26;\n  holdBtn.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n  actionPanel.appendChild(holdBtn);\n\n  const faceId = figma.getNodeById(\"2:106\").createInstance();\n  faceId.x = 84; faceId.y = 14;\n  // Let's change vector stroke colors to white inside the cloned Instance\n  const vectors = faceId.findAll(n => n.type === \"VECTOR\" || n.type === \"BOOLEAN_OPERATION\");\n  vectors.forEach(v => {\n    v.strokes = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  });\n  holdBtn.appendChild(faceId);\n\n  const holdTxtNode = figma.createText();\n  holdTxtNode.characters = \"Hold to Invest\";\n  holdTxtNode.fontName = { family: \"Nunito\", style: \"Bold\" };\n  holdTxtNode.fontSize = 17; holdTxtNode.x = 120; holdTxtNode.y = 15;\n  holdTxtNode.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  holdBtn.appendChild(holdTxtNode);\n\n  // Home Indicator\n  const hi4 = figma.getNodeById(\"3:36\").createInstance();\n  hi4.x = 0; hi4.y = 812 - 34;\n  frame4.appendChild(hi4);\n\n  figma.currentPage.appendChild(frame4);\n  return \"04_Invest_Amount screen successfully built!\";\n})();","description":"Build the 04_Invest_Amount keypad screen.","fileKey":"EctuBlB5drFNCeGwWM7KyI"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":74563,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":32180},"