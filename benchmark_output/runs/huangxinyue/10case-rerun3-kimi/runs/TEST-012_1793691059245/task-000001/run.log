ng App?'],\n  ['Meta / Regular 12',12,'Regular','2h ago · Follow'],\n  ['Tab label / Semi Bold 10–14',12,'Semi Bold','Home'],\n];\nfor(let i=0;i<scale.length;i++){\n  const t=txt(scale[i][3],scale[i][1],scale[i][2],INK);t.x=32;t.y=76+i*40;T.appendChild(t);\n  const l=txt(scale[i][0],11,'Medium',SUB);l.x=430;l.y=80+i*40;T.appendChild(l);\n}\nconst swatches=[\n  ['Brand primary · plum','#4B164C',PLUM],\n  ['Brand secondary · orchid pink','#DD88CF',ORCHID],\n  ['Ink / primary text','#1A161C',INK],\n  ['Secondary text','#6F6874',SUB],\n  ['Hairline / borders','#EEE7EF',LINE],\n  ['Surface alt','#F7F4F8',SURF],\n];\nfor(let i=0;i<swatches.length;i++){\n  const y=76+i*40;\n  const r=figma.createRectangle();r.resize(52,28);r.cornerRadius=6;r.fills=[solid(swatches[i][2])];r.x=610;r.y=y;T.appendChild(r);\n  const n=txt(swatches[i][0],12,'Medium',INK);n.x=672;n.y=y;T.appendChild(n);\n  const h=txt(swatches[i][1],11,'Regular',SUB);h.x=672;h.y=y+15;T.appendChild(h);\n}\nconst g=figma.createRectangle();g.resize(52,28);g.cornerRadius=6;g.fills=[gradBrand()];g.x=610;g.y=76+6*40;T.appendChild(g);\nconst gn=txt('Brand gradient (buttons, rings)',12,'Medium',INK);gn.x=672;gn.y=76+6*40;T.appendChild(gn);\nreturn {ok:true};\n","description":"Add a small type & color foundations summary frame to the workspace","fileKey":"5xY0YjB6IWmTqgOsns9U6t"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"ed8da9f8-6f65-452e-96bf-8860e9b0c5f8","uuid":"1bb33f1f-e0bd-47ed-ae4d-12501d867436","timestamp":"2026-11-03T08:20:49.870Z","tool_use_meta":[{"id":"mcp__figma__use_figma_0_50ef005c","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
