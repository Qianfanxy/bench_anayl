avatar);\n\n    const titleText = figma.createText();\n    titleText.characters = \"My Wallet\";\n    titleText.fontName = { family: \"Nunito\", style: \"Bold\" };\n    titleText.fontSize = 20;\n    titleText.x = 52;\n    titleText.y = 2;\n    titleText.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    header.appendChild(titleText);\n\n    const addressText = figma.createText();\n    addressText.characters = \"0xc8...320f\";\n    addressText.fontName = { family: \"Nunito\", style: \"Medium\" };\n    addressText.fontSize = 13;\n    addressText.x = 52;\n    addressText.y = 26;\n    addressText.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.56 } }];\n    header.appendChild(addressText);\n\n    const scanIcon = figma.getNodeById(\"2:95\").createInstance();\n    scanIcon.x = 343 - 24;\n    scanIcon.y = 12;\n    header.appendChild(scanIcon);\n\n    // Balance Block: $54,292.79 · +5.21%\n    const balanceFrame = figma.createFrame();\n    balanceFrame.name = \"Balance_Block\";\n    balanceFrame.x = 16;\n    balanceFrame.y = 80;\n    balanceFrame.resize(343, 72);\n    balanceFrame.fills = [];\n    content.appendChild(balanceFrame);\n\n    const balTitle = figma.createText();\n    balTitle.characters = \"Balance\";\n    balTitle.fontName = { family: \"Nunito\", style: \"Regular\" };\n    balTitle.fontSize = 14;\n    balTitle.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.56 } }];\n    balanceFrame.appendChild(balTitle);\n\n    const balVal = figma.createText();\n    balVal.characters = \"$54,292.79\";\n    balVal.fontName = { family: \"Nunito\", style: \"ExtraBold\" };\n    balVal.fontSize = 32;\n    balVal.y = 20;\n    balVal.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    balanceFrame.appendChild(balVal);\n\n    const balChange = figma.createText();\n    balChange.characters = \"+5.21%\";\n    balChange.fontName = { family: \"Nunito\", style: \"Bold\" };\n    balChange.fontSize = 14;\n    balChange.x = 185;\n    balChange.y = 35;\n    balChange.fills = [{ type: 'SOLID', color: { r: 0.18, g: 0.72, b: 0.45 } }]; // green\n    balanceFrame.appendChild(balChange);\n\n    // Actions Block: Send, Receive\n    const actionsFrame = figma.createFrame();\n    actionsFrame.name = \"Actions\";\n    actionsFrame.x = 16;\n    actionsFrame.y = 168;\n    actionsFrame.resize(343, 52);\n    actionsFrame.fills = [];\n    content.appendChild(actionsFrame);\n\n    // Send Button\n    const sendBtn = figma.createFrame();\n    sendBtn.name = \"Send_Btn\";\n    sendBtn.x = 0;\n    sendBtn.y = 0;\n    sendBtn.resize(164, 52);\n    sendBtn.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n    sendBtn.cornerRadius = 16;\n    // Add shadow\n    sendBtn.effects = [{\n      type: 'DROP_SHADOW',\n      color: { r: 0, g: 0, b: 0, a: 0.04 },\n      offset: { x: 0, y: 4 },\n      radius: 12,\n      visible: true,\n      blendMode: 'NORMAL'\n    }];\n    actionsFrame.appendChild(sendBtn);\n\n    const sendIcon = figma.getNodeById(\"2:75\").createInstance();\n    sendIcon.x = 36;\n    sendIcon.y = 14;\n    sendBtn.appendChild(sendIcon);\n\n    const sendText = figma.createText();\n    sendText.characters = \"Send\";\n    sendText.fontName = { family: \"Nunito\", style: \"Bold\" };\n    sendText.fontSize = 16;\n    sendText.x = 68;\n    sendText.y = 15;\n    sendText.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    sendBtn.appendChild(sendText);\n\n    // Receive Button\n    const recBtn = figma.createFrame();\n    recBtn.name = \"Receive_Btn\";\n    recBtn.x = 179;\n    recBtn.y = 0;\n    recBtn.resize(164, 52);\n    recBtn.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n    recBtn.cornerRadius = 16;\n    recBtn.effects = sendBtn.effects;\n    actionsFrame.appendChild(recBtn);\n\n    const recIcon = figma.getNodeById(\"2:80\").createInstance();\n    recIcon.x = 28;\n    recIcon.y = 14;\n    recBtn.appendChild(recIcon);\n\n    const recText = figma.createText();\n    recText.characters = \"Receive\";\n    recText.fontName = { family: \"Nunito\", style: \"Bold\" };\n    recText.fontSize = 16;\n    recText.x = 60;\n    recText.y = 15;\n    recText.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    recBtn.appendChild(recText);\n\n    // Pockets Section\n    const pocketsHeader = figma.createText();\n    pocketsHeader.characters = \"Pockets\";\n    pocketsHeader.fontName = { family: \"Nunito\", style: \"Bold\" };\n    pocketsHeader.fontSize = 18;\n    pocketsHeader.x = 16;\n    pocketsHeader.y = 244;\n    pocketsHeader.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    content.appendChild(pocketsHeader);\n\n    // Horizontal Scrollable Container for Pockets\n    const pocketsScroll = figma.createFrame();\n    pocketsScroll.name = \"Pockets_Scroll\";\n    pocketsScroll.x = 0;\n    pocketsScroll.y = 276;\n    pocketsScroll.resize(375, 112);\n    pocketsScroll.fills = [];\n    pocketsScroll.clipsContent = false;\n    content.appendChild(pocketsScroll);\n\n    const createPocketCard = (x, title, val, change, isPositive) => {\n      const card = figma.createFrame();\n      card.name = \"Pocket_Card\";\n      card.x = x;\n      card.y = 0;\n      card.resize(150, 100);\n      card.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n      card.cornerRadius = 16;\n      card.effects = sendBtn.effects;\n\n      const cardTitle = figma.createText();\n      cardTitle.characters = title;\n      cardTitle.fontName = { family: \"Nunito\", style: \"Bold\" };\n      cardTitle.fontSize = 13;\n      cardTitle.x = 12;\n      cardTitle.y = 12;\n      cardTitle.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.56 } }];\n      card.appendChild(cardTitle);\n\n      const cardVal = figma.createText();\n      cardVal.characters = val;\n      cardVal.fontName = { family: \"Nunito\", style: \"ExtraBold\" };\n      cardVal.fontSize = 16;\n      cardVal.x = 12;\n      cardVal.y = 44;\n      cardVal.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n      card.appendChild(cardVal);\n\n      const cardChange = figma.createText();\n      cardChange.characters = change;\n      cardChange.fontName = { family: \"Nunito\", style: \"Bold\" };\n      cardChange.fontSize = 12;\n      cardChange.x = 12;\n      cardChange.y = 68;\n      cardChange.fills = [{ type: 'SOLID', color: isPositive ? { r: 0.18, g: 0.72, b: 0.45 } : { r: 0.92, g: 0.26, b: 0.26 } }];\n      card.appendChild(cardChange);\n\n      return card;\n    };\n\n    const pocket1 = createPocketCard(16, \"My New House 🏡\", \"$15,642.40\", \"+7.86%\", true);\n    pocketsScroll.appendChild(pocket1);\n\n    const pocket2 = createPocketCard(178, \"Tesla Model S Plaid 🚙\", \"$28,389.21\", \"-2.13%\", false);\n    pocketsScroll.appendChild(pocket2);\n\n    // Add Pocket Card\n    const addPocketCard = figma.createFrame();\n    addPocketCard.name = \"Add_Pocket\";\n    addPocketCard.x = 340;\n    addPocketCard.y = 0;\n    addPocketCard.resize(100, 100);\n    addPocketCard.fills = [{ type: 'SOLID', color: { r: 0.94, g: 0.94, b: 0.96 } }];\n    addPocketCard.cornerRadius = 16;\n    \n    const addIcon = figma.getNodeById(\"2:85\").createInstance();\n    addIcon.x = 38;\n    addIcon.y = 26;\n    addPocketCard.appendChild(addIcon);\n\n    const addText = figma.createText();\n    addText.characters = \"Add Pocket\";\n    addText.fontName = { family: \"Nunito\", style: \"Bold\" };\n    addText.fontSize = 12;\n    addText.x = 18;\n    addText.y = 58;\n    addText.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    addPocketCard.appendChild(addText);\n\n    pocketsScroll.appendChild(addPocketCard);\n\n    // Assets Section\n    const assetsHeader = figma.createText();\n    assetsHeader.characters = \"Assets\";\n    assetsHeader.fontName = { family: \"Nunito\", style: \"Bold\" };\n    assetsHeader.fontSize = 18;\n    assetsHeader.x = 16;\n    assetsHeader.y = 404;\n    assetsHeader.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    content.appendChild(assetsHeader);\n\n    // Asset rows\n    const assetsData = [\n      { name: \"Ethereum\", holding: \"2.569032 ETH\", val: \"$3,226.31\", change: \"+3.48%\", logo: \"2:11\", isPos: true },\n      { name: \"Dai\", holding: \"3,045.86 DAI\", val: \"$3,021.15\", change: \"-0.02%\", logo: \"2:38\", isPos: false },\n      { name: \"Avalanche\", holding: \"180.02 AVAX\", val: \"$2,440.09\", change: \"+1.54%\", logo: \"2:41\", isPos: true },\n      { name: \"PancakeSwap\", holding: \"397.33 CAKE\", val: \"$1,573.63\", change: \"-0.02%\", logo: \"2:44\", isPos: false }\n    ];\n\n    let rowY = 436;\n    assetsData.forEach(asset => {\n      const row = figma.createFrame();\n      row.name = \"Asset_Row_\" + asset.name;\n      row.x = 16;\n      row.y = rowY;\n      row.resize(343, 64);\n      row.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n      row.cornerRadius = 16;\n      row.effects = sendBtn.effects;\n      content.appendChild(row);\n\n      const logo = figma.getNodeById(asset.logo).createInstance();\n      logo.x = 12;\n      logo.y = 12;\n      logo.resize(40, 40);\n      row.appendChild(logo);\n\n      const nameTxt = figma.createText();\n      nameTxt.characters = asset.name;\n      nameTxt.fontName = { family: \"Nunito\", style: \"Bold\" };\n      nameTxt.fontSize = 16;\n      nameTxt.x = 64;\n      nameTxt.y = 12;\n      nameTxt.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n      row.appendChild(nameTxt);\n\n      const holdTxt = figma.createText();\n      holdTxt.characters = asset.holding;\n      holdTxt.fontName = { family: \"Nunito\", style: \"Medium\" };\n      holdTxt.fontSize = 13;\n      holdTxt.x = 64;\n      holdTxt.y = 34;\n      holdTxt.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.56 } }];\n      row.appendChild(holdTxt);\n\n      const valTxt = figma.createText();\n      valTxt.characters = asset.val;\n      valTxt.fontName = { family: \"Nunito\", style: \"Bold\" };\n      valTxt.fontSize = 16;\n      valTxt.x = 343 - 12 - 120;\n      valTxt.y = 12;\n      valTxt.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n      valTxt.textAlignHorizontal = \"RIGHT\";\n      valTxt.resize(120, 20);\n      row.appendChild(valTxt);\n\n      const changeTxt = figma.createText();\n      changeTxt.characters = asset.change;\n      changeTxt.fontName = { family: \"Nunito\", style: \"Bold\" };\n      changeTxt.fontSize = 13;\n      changeTxt.x = 343 - 12 - 100;\n      changeTxt.y = 34;\n      changeTxt.fills = [{ type: 'SOLID', color: asset.isPos ? { r: 0.18, g: 0.72, b: 0.45 } : { r: 0.92, g: 0.26, b: 0.26 } }];\n      changeTxt.textAlignHorizontal = \"RIGHT\";\n      changeTxt.resize(100, 18);\n      row.appendChild(changeTxt);\n\n      rowY += 76;\n    });\n\n    // Main Navigation: page 2 of 3 (My Wallet)\n    const navBar = figma.createFrame();\n    navBar.name = \"Nav_Bar\";\n    navBar.x = 0;\n    navBar.y = 812 - 34 - 60;\n    navBar.resize(375, 60);\n    navBar.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n    navBar.strokes = [{ type: 'SOLID', color: { r: 0.9, g: 0.9, b: 0.9 } }];\n    frame.appendChild(navBar);\n\n    // Tab 1: placeholder (not part of task)\n    const tab1 = figma.createText();\n    tab1.characters = \"Activity\";\n    tab1.fontName = { family: \"Nunito\", style: \"Bold\" };\n    tab1.fontSize = 13;\n    tab1.x = 32;\n    tab1.y = 20;\n    tab1.fills = [{ type: 'SOLID', color: { r: 0.7, g: 0.7, b: 0.75 } }];\n    navBar.appendChild(tab1);\n\n    // Tab 2: My Wallet (Active)\n    const tab2 = figma.createText();\n    tab2.characters = \"My Wallet\";\n    tab2.fontName = { family: \"Nunito\", style: \"ExtraBold\" };\n    tab2.fontSize = 13;\n    tab2.x = 150;\n    tab2.y = 20;\n    tab2.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    navBar.appendChild(tab2);\n\n    // Tab 3: Discovery\n    const tab3 = figma.createText();\n    tab3.characters = \"Discovery\";\n    tab3.fontName = { family: \"Nunito\", style: \"Bold\" };\n    tab3.fontSize = 13;\n    tab3.x = 275;\n    tab3.y = 20;\n    tab3.fills = [{ type: 'SOLID', color: { r: 0.7, g: 0.7, b: 0.75 } }];\n    navBar.appendChild(tab3);\n\n    // Page Indicator (dots)\n    const indicatorFrame = figma.createFrame();\n    indicatorFrame.name = \"Page_Indicator\";\n    indicatorFrame.x = 157;\n    indicatorFrame.y = 42;\n    indicatorFrame.resize(60, 8);\n    indicatorFrame.fills = [];\n    navBar.appendChild(indicatorFrame);\n\n    const dot1 = figma.createEllipse();\n    dot1.x = 0; dot1.y = 0; dot1.resize(6, 6);\n    dot1.fills = [{ type: 'SOLID', color: { r: 0.8, g: 0.8, b: 0.85 } }];\n    indicatorFrame.appendChild(dot1);\n\n    const dot2 = figma.createEllipse();\n    dot2.x = 14; dot2.y = 0; dot2.resize(16, 6); // current is elongated\n    dot2.cornerRadius = 3;\n    dot2.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    indicatorFrame.appendChild(dot2);\n\n    const dot3 = figma.createEllipse();\n    dot3.x = 36; dot3.y = 0; dot3.resize(6, 6);\n    dot3.fills = [{ type: 'SOLID', color: { r: 0.8, g: 0.8, b: 0.85 } }];\n    indicatorFrame.appendChild(dot3);\n\n    figma.currentPage.appendChild(frame);\n    return frame;\n  };\n  \n  await createWalletFrame();\n  return \"01_Wallet screen created successfully!\";\n})();","description":"Construct the first screen (01_Wallet) with all required data, icons, and page indicator.","fileKey":"EctuBlB5drFNCeGwWM7KyI"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":32311,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":31418},"context_management":null},"parent_tool_use_id":null,"session_id":"d28aef32-2131-4dd0-98ee-c308ac3f9753","uuid":"72d88f53-5c0a-4a72-a7f3-f2dfc74c7461","timestamp":"2026-11-01T10:26:59.907Z","tool_use_meta":[{"id":"call_32a09b709275423ab0600cc8bf3f93b7","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
