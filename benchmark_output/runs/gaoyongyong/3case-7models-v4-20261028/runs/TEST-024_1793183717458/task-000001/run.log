{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a829e25e61be4d599356de72ab6b30e1","type":"tool_result","content":[{"type":"text","text":"<canvas id=\"1:2\" name=\"01 · Foundations 视觉规范\" x=\"0\" y=\"0\" width=\"0\" height=\"0\">\n  <frame id=\"10:52\" name=\"Foundations\" x=\"0\" y=\"0\" width=\"1400\" height=\"990\">\n    <frame id=\"10:53\" name=\"Header\" x=\"0\" y=\"0\" width=\"1400\" height=\"176\">\n      <text id=\"10:54\" name=\"PARADISE INVEST / DESIGN FOUNDATIONS\" x=\"56\" y=\"48\" width=\"336\" height=\"19\" />\n      <text id=\"10:55\" name=\"Fixed: brand primary + typefaces. You build everything else.\" x=\"56\" y=\"79\" width=\"1028\" height=\"49\" />\n    </frame>\n    <frame id=\"10:56\" name=\"Body\" x=\"0\" y=\"176\" width=\"1400\" height=\"814\">\n      <frame id=\"10:57\" name=\"01  BRAND COLORS (FIXED)\" x=\"56\" y=\"52\" width=\"1288\" height=\"292\">\n        <text id=\"10:58\" name=\"01 BRAND COLOR (FIXED)\" x=\"0\" y=\"0\" width=\"231\" height=\"22\" />\n        <text id=\"10:59\" name=\"Only the brand primary is given. Define every other color yourself — neutrals and grays, text, backgrounds and surfaces, semantic colors (gain / loss, error, disabled) and any supporting colors — once, and use them consistently.\" x=\"0\" y=\"42\" width=\"1288\" height=\"36\" />\n        <frame id=\"10:60\" name=\"Frame\" x=\"0\" y=\"98\" width=\"168\" height=\"194\">\n          <frame id=\"10:61\" name=\"Primary\" x=\"0\" y=\"0\" width=\"168\" height=\"194\">\n            <rounded-rectangle id=\"10:62\" name=\"Rectangle\" x=\"0\" y=\"0\" width=\"168\" height=\"80\" />\n            <text id=\"10:63\" name=\"Brand primary\" x=\"0\" y=\"86\" width=\"168\" height=\"16\" />\n            <text id=\"10:64\" name=\"#31A062\" x=\"0\" y=\"108\" width=\"168\" height=\"16\" />\n            <text id=\"10:65\" name=\"The Paradise Invest brand color. Where and how much to use it is your decision.\" x=\"0\" y=\"130\" width=\"168\" height=\"64\" />\