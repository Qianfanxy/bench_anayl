deByIdAsync('7:18')).createInstance(); frame.appendChild(hi); hi.x=0; hi.y=928-34;\n}\nasync function addIcon(frame, id, size, x, y){\n  const ic = (await figma.getNodeByIdAsync(id)).createInstance();\n  ic.resize(size,size); frame.appendChild(ic); ic.x=x; ic.y=y; return ic;\n}\n// Chat chrome: menu (left), export (right top), title center; input bar bottom\nasync function chatChrome(f){\n  await addIcon(f,'7:92',24, 20, 59);            // menu\n  await addIcon(f,'7:96',24, 428-20-24, 59);    // export\n  const logo = (await figma.getNodeByIdAsync('7:20')).createInstance(); logo.resize(40,40); f.appendChild(logo); logo.x=(428-40)/2; logo.y=56;\n  const t1 = txt('Chat Bot AI 4.5', BRI_SB, 17, C.ink);\n  f.appendChild(t1); t1.x=(428-t1.width)/2; t1.y=104;\n  const badge = figma.createFrame(); badge.name='PremiumBadge';\n  badge.layoutMode='HORIZONTAL'; badge.counterAxisAlignItems='CENTER'; badge.itemSpacing=5;\n  badge.paddingLeft=10; badge.paddingRight=10; badge.paddingTop=4; badge.paddingBottom=4;\n  badge.cornerRadius=12; badge.fills=[{type:'SOLID',color:C.primarySoft}];\n  const pi = (await figma.getNodeByIdAsync('7:103')).createInstance(); pi.resize(12,12);\n  const bl = txt('Premium account', NUN_SB, 11, C.primary);\n  badge.appendChild(pi); badge.appendChild(bl);\n  f.appendChild(badge); badge.x=(428-badge.width)/2; badge.y=132;\n}\nasync function inputBar(f, y){\n  const bar = figma.createFrame(); bar.name='InputBar';\n  bar.resize(380,56); bar.cornerRadius=28; bar.fills=[{type:'SOLID',color:C.surface}];\n  bar.layoutMode='HORIZONTAL'; bar.counterAxisAlignItems='CENTER'; bar.paddingLeft=18; bar.paddingRight=6; bar.itemSpacing=8;\n  const ph = txt('Ask me anything...', NUN_REG, 14, C.sub);\n  bar.appendChild(ph);\n  bar.primaryAxisAlignItems='SPACE_BETWEEN';\n  const send = figma.createFrame(); send.name='Send'; send.resize(44,44); send.cornerRadius=22;\n  send.fills=[{type:'SOLID',color:C.primary}];\n  bar.appendChild(send);\n  f.appendChild(bar); bar.x=24; bar.y=y;\n  const sic = (await figma.getNodeByIdAsync('7:90')).createInstance(); sic.resize(20,20);\n  f.appendChild(sic); sic.x = 24+380-6-44+12; sic.y = y+12;\n  return bar;\n}\n// ---------- 05_Chat_New ----------\n{\n  const f = byName('05_Chat_New');\n  await addShell(f);\n  await chatChrome(f);\n  const hello = txt('How can I help you my friend? 😊', BRI_SB, 22, C.ink, {width: 340, align:'CENTER'});\n  f.appendChild(hello); hello.x=(428-340)/2; hello.y=200;\n  const sugg = [\n    ['Brainstorm names','for my fantasy football team with a frog theme'],\n    ['Suggest some codenames','for a project introducing flexible work arrangements'],\n    ['Write a SQL query','that adds a “status” column to an “orders” table'],\n    ['Explain why popcorn pops','to a kid who loves watching it in the microwave'],\n  ];\n  const grid = figma.createFrame(); grid.name='Suggestions';\n  grid.fills=[]; grid.layoutMode='HORIZONTAL'; grid.layoutWrap='WRAP';\n  grid.itemSpacing=12; grid.counterAxisSpacing=12;\n  grid.counterAxisSizingMode='AUTO'; grid.primaryAxisSizingMode='FIXED'; grid.resize(380,10);\n  for(const [title, detail] of sugg){\n    const card = figma.createFrame(); card.name='Sugg/'+title.slice(0,16);\n    card.resize(184,120); card.cornerRadius=16; card.fills=[{type:'SOLID',color:C.white}];\n    card.strokes=[{type:'SOLID',color:C.border}]; card.strokeWeight=1;\n    card.layoutMode='VERTICAL'; card.paddingLeft=card.paddingRight=14; card.paddingTop=14; card.paddingBottom=12; card.itemSpacing=6;\n    card.primaryAxisAlignItems='SPACE_BETWEEN';\n    const body = figma.createFrame(); body.fills=[]; body.layoutMode='VERTICAL'; body.itemSpacing=5; body.counterAxisSizingMode='AUTO'; body.primaryAxisSizingMode='AUTO';\n    const t = txt(title, NUN_B, 13, C.ink, {width:156});\n    const d = txt(detail, NUN_REG, 11, C.sub, {width:156, maxLines:3});\n    body.appendChild(t); body.appendChild(d);\n    card.appendChild(body);\n    const arr = figma.createFrame(); arr.fills=[]; arr.layoutMode='HORIZONTAL'; arr.primaryAxisAlignItems='MAX'; arr.counterAxisSizingMode='AUTO'; arr.primaryAxisSizingMode='FIXED'; arr.resize(156,16);\n    const ai = (await figma.getNodeByIdAsync('7:72')).createInstance(); ai.resize(16,16);\n    arr.appendChild(ai);\n    card.appendChild(arr);\n    grid.appendChild(card);\n  }\n  f.appendChild(grid); grid.x=24; grid.y=300;\n  await inputBar(f, 928-34-16-56);\n}\nreturn {ok: byName('05_Chat_New').children.length};","description":"Build 05_Chat_New with chat chrome, suggestions and input bar"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"0338c781-78cf-48da-b153-97e8b743ce85","uuid":"7545ec6e-c7ef-4b86-96f9-d4fac1dae4c7","timestamp":"2026-10-31T05:55:33.570Z","tool_use_meta":[{"id":"mcp__figma__use_figma_21_c10d5b5a","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
