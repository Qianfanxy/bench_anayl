pt);\n\n    const openRow = figma.createFrame();\n    openRow.layoutMode = \"HORIZONTAL\";\n    openRow.primaryAxisAlignItems = \"MAX\";\n    openRow.layoutAlign = \"STRETCH\";\n    openRow.fills = [];\n\n    const openCircle = figma.createFrame();\n    openCircle.resize(40, 40);\n    openCircle.cornerRadius = 20;\n    openCircle.fills = [{ type: 'SOLID', color: GRAY_100 }];\n    openCircle.layoutMode = \"HORIZONTAL\";\n    openCircle.primaryAxisAlignItems = \"CENTER\";\n    openCircle.counterAxisAlignItems = \"CENTER\";\n    openCircle.appendChild(createIcon(iconArrowRightComp, 20));\n\n    openRow.appendChild(openCircle);\n    artCard.appendChild(artContent);\n    artCard.appendChild(openRow);\n    articlesGrid.appendChild(artCard);\n  });\n\n  blogSection.appendChild(blogTop);\n  blogSection.appendChild(articlesGrid);\n  pageFrame.appendChild(blogSection);\n\n  // 4. CTA BANNER\n  const ctaBanner = figma.createFrame();\n  ctaBanner.name = \"Call_To_Action_Banner\";\n  ctaBanner.layoutMode = \"VERTICAL\";\n  ctaBanner.layoutAlign = \"STRETCH\";\n  ctaBanner.paddingLeft = 80;\n  ctaBanner.paddingRight = 80;\n  ctaBanner.paddingTop = 80;\n  ctaBanner.paddingBottom = 80;\n  ctaBanner.fills = [{ type: 'SOLID', color: WHITE }];\n\n  const ctaBox = figma.createFrame();\n  ctaBox.layoutMode = \"HORIZONTAL\";\n  ctaBox.layoutAlign = \"STRETCH\";\n  ctaBox.paddingLeft = 60;\n  ctaBox.paddingRight = 60;\n  ctaBox.paddingTop = 60;\n  ctaBox.paddingBottom = 60;\n  ctaBox.cornerRadius = 28;\n  ctaBox.fills = [{ type: 'SOLID', color: LIME }];\n  ctaBox.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  ctaBox.counterAxisAlignItems = \"CENTER\";\n\n  const ctaTxt = figma.createText();\n  ctaTxt.fontName = fontBold;\n  ctaTxt.fontSize = 44;\n  ctaTxt.characters = \"Ready to work with us?\";\n  ctaTxt.fills = [{ type: 'SOLID', color: INK }];\n\n  const ctaBtn = figma.createFrame();\n  ctaBtn.layoutMode = \"HORIZONTAL\";\n  ctaBtn.paddingLeft = 32;\n  ctaBtn.paddingRight = 28;\n  ctaBtn