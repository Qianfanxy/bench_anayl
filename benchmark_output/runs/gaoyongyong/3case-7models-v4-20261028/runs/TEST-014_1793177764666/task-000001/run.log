lW) c.layoutSizingHorizontal='FILL'; if(o.fillH) c.layoutSizingVertical='FILL'; if(o.grow) c.layoutGrow=1; return c;}\nfunction prop(comp,name,type,def,node,field){const k=comp.addComponentProperty(name,type,def); node.componentPropertyReferences=Object.assign({},node.componentPropertyReferences||{},{[field]:k}); return k;}\nfunction place(p,n,x,y){p.appendChild(n); n.x=x; n.y=y; return n;}\nasync function I(id){return (await N(id)).createInstance();}\nconst out={};\n// 1. Contact Add variant label\nconst ciSet=await N('2009:340'); const addV=ciSet.children.find(c=>c.name==='Type=Add'); const at=addV.findOne(n=>n.name==='Name'); at.componentPropertyReferences={}; at.characters='Add';\n// Action pill destructive label default\nconst ap=await N('2009:438'); const dv=ap.children.find(c=>c.name==='Style=Destructive'); \n// 2. Selector: rename, add Show Icon, fix flag sizing via fixed wrapper\nconst cs=await N('2008:316'); cs.name='Selector';\nconst flag=cs.children[0]; const fk=Object.keys(cs.componentPropertyDefinitions).find(k=>k.startsWith('Flag'));\ncs.editComponentProperty(fk,{name:'Icon'});\nconst ik=Object.keys(cs.componentPropertyDefinitions).find(k=>k.startsWith('Icon'));\nconst sk=cs.addComponentProperty('Show Icon','BOOLEAN',true); flag.componentPropertyReferences={mainComponent:ik,visible:sk};\nconst ckk=Object.keys(cs.componentPropertyDefinitions).find(k=>k.startsWith('Code')); cs.editComponentProperty(ckk,{name:'Label'});\n// fix balance card currency flag\nconst bc=await N('2009:259'); const csi=bc.findOne(n=>n.name==='Currency Selector'); const fl=csi.children[0]; fl.resize(20,20);\ncsi.paddingLeft=6; \n// 3. Financial health chart shorter\nconst fh=await N('2010:555'); fh.paddingTop=fh.paddingBottom=fh.paddingLeft=fh.paddingRight=16; fh.itemSpacing=12; fh.resize(335,fh.height);\nconst ch=fh.findOne(n=>n.name==='Bar Chart'); ch.children.slice().forEach(c=>c.remove()); ch.resize(303,146);\nconst top=8,H=110; const yv=v=>top+(50-v)/40*H; const W=303-40;\nfor(const v of [50,40,30,20,10]){const l=await T(v+'K','Micro/Medium','text/tertiary'); place(ch,l,0,yv(v)-7); const g=figma.createLine(); g.resize(W,0); g.strokes=[P('border/default')]; g.dashPattern=[3,3]; place(ch,g,40,yv(v));}\nconst data=[['Mon',24],['Tue',35],['Wed',45],['Thu',22],['Fri',34],['Sat',18],['Sun',30]]; const slot=W/7;\nfor(let i=0;i<7;i++){const [d,v]=data[i]; const cx=40+slot*i+slot/2; const b=figma.createRectangle(); b.name=d+' '+v+'K'; b.resize(20,(v-10)/40*H); b.cornerRadius=6; b.bottomLeftRadius=2; b.bottomRightRadius=2; b.fills=[P(v===45?'surface/dark':'chart/1')]; place(ch,b,cx-10,yv(v));\n const vl=await T(v+'K','Micro/Medium',v===45?'text/primary':'text/secondary'); vl.textAlignHorizontal='CENTER'; vl.textAutoResize='NONE'; vl.resize(32,14); place(ch,vl,cx-16,yv(v)-17);\n const dl=await T(d,'Caption/Regular',v===45?'text/primary':'text/tertiary'); dl.textAlignHorizontal='CENTER'; dl.textAutoResize='NONE'; dl.resize(36,16); place(ch,dl,cx-18,top+H+10);}\n// 4. New components\nconst lib=await N('2007:3');\nconst s=Fr('More components',{dir:'VERTICAL',gap:20}); add(s,await T('More components','Heading/H2')); lib.appendChild(s); const row=Fr('row',{dir:'HORIZONTAL',gap:32,ai:'MIN'}); s.appendChild(row);\n// Asset tile\nconst tl=Fr('Asset Tile',{comp:true,dir:'VERTICAL',w:103,pad:[12],gap:10,r:16,fill:'surface/default',fx:'Elevation/Card'});\nconst tc=await I('2:34'); tc.rescale(32/40); tl.appendChild(tc); const tt=Fr('Text',{dir:'VERTICAL',gap:1}); add(tl,tt,{fillW:true});\nconst tn=await T('Bitcoin','Label/Medium','text/primary','Name'), tk=await T('BTC','Micro/Medium','text/tertiary','Ticker'), tv=await T('$17,238.11','Label/Medium','text/primary','Value'); tv.fontName={family:F,style:'SemiBold'}; tt.appendChild(tn); tt.appendChild(tk); add(tl,tv);\nprop(tl,'Coin','INSTANCE_SWAP','2:34',tc,'mainComponent'); prop(tl,'Name','TEXT','Bitcoin',tn,'characters'); prop(tl,'Ticker','TEXT','BTC',tk,'characters'); prop(tl,'Value','TEXT','$17,238.11',tv,'characters'); row.appendChild(tl); out.tile=tl.id;\n// Legal text\nconst lg=figma.createComponent(); lg.name='Legal Text'; const lt=await T('By signing up, you agree to the Terms of Service and Privacy Policy, including Cookie Use.','Caption/Regular','text/secondary','Legal'); lg.appendChild(lt); lt.textAutoResize='HEIGHT'; lt.resize(335,lt.height); lt.textAlignHorizontal='CENTER'; lt.lineHeight={unit:'PIXELS',value:18};\nfor(const w of ['Terms of Service','Privacy Policy']){const i=lt.characters.indexOf(w); lt.setRangeFills(i,i+w.length,[P('brand/primary-strong')]); lt.setRangeFontName(i,i+w.length,{family:F,style:'SemiBold'}); lt.setRangeTextDecoration(i,i+w.length,'UNDERLINE');}\nlg.resize(335,lt.height); row.appendChild(lg); out.legal=lg.id;\n// Brand mark\nconst bm=Fr('Brand Mark',{comp:true,dir:'HORIZONTAL',w:56,h:56,r:18,fill:'brand/primary',ai:'CENTER',jc:'CENTER'}); const bt=await T('B','Heading/H1','text/primary'); bm.appendChild(bt); row.appendChild(bm); out.bm=bm.id;\nreturn out;","description":"Fix components and add asset tile, legal text, brand mark","fileKey":"MBHvOG7BDhv7MBK9aeD1M4"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":70888,"cache_read_input_tokens":7731,"cache_creation":{"ephemeral_5m_input_tokens":70888,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9b6cf0bf-bc44-403b-a903-8b507b85de29","uuid":"622954dd-10c2-4a62-b0bf-a253b4b885b5","timestamp":"2026-10-28T09:07:03.397Z","tool_use_meta":[{"id":"toolu_bdrk_017wLD5dxKafgXBgw8zAdBoz","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
