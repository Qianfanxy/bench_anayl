{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_abc7f47f946145c2bd88b458","name":"mcp__figma__use_figma","input":{"code":"for (const f of [['Archivo Black','Regular'],['Plus Jakarta Sans','Regular'],['Plus Jakarta Sans','Medium'],['Plus Jakarta Sans','SemiBold'],['Plus Jakarta Sans','Bold'],['Inter','Regular']]) {\n  await figma.loadFontAsync({family: f[0], style: f[1]});\n}\nconst ws = await figma.getNodeByIdAsync('6:2');\nconst hex = h => ({ r: parseInt(h.slice(1,3),16)/255, g: parseInt(h.slice(3,5),16)/255, b: parseInt(h.slice(5,7),16)/255 });\nconst S = (h, o) => ({ type: 'SOLID', color: hex(h), opacity: o === undefined ? 1 : o });\nconst ids = {};\nlet cx = 2100, cy = -5400, rowH = 0;\nfunction place(node) {\n  ws.appendChild(node);\n  node.x = cx; node.y = cy;\n  cx += node.width + 120;\n  if (node.height > rowH) rowH = node.height;\n  if (cx > 5600) { cx = 100; cy += rowH + 120; rowH = 0; }\n}\nfunction txt(str, style, size, h, opts) {\n  const t = figma.createText();\n  t.fontName = { family: 'Plus Jakarta Sans', style: style };\n  t.characters = str;\n  t.fontSize = size;\n  t.fills = [S(h)];\n  opts = opts || {};\n  if (opts.lh) t.lineHeight = { value: opts.lh, unit: 'PIXELS' };\n  if (opts.op !== undefined) t.fills = [S(h, opts.op)];\n  if (opts.dec) t.textDecoration = opts.dec;\n  return t;\n}\nfunction atxt(str, size, h, opts) {\n  const t = figma.createText();\n  t.fontName = { family: 'Archivo Black', style: 'Regular' };\n  t.characters = str;\n  t.fontSize = size;\n  t.fills = [S(h)];\n  opts = opts || {};\n  if (opts.lh) t.lineHeight = { value: opts.lh, unit: 'PIXELS' };\n  if (opts.ls !== undefined) t.letterSpacing = { value: opts.ls, unit: 'PERCENT' };\n  return t;\n}\nasync function iconInst(compId, size, tintHex, keepFills) {\n  const comp = await figma.getNodeByIdAsync(compId);\n  const inst = comp.createInstance();\n  inst.resize(size, size);\n  if (!keepFills) inst.fills = [];\n  if (tintHex) {\n    const walk = n => {\n      if ('fills' in n && Array.isArray(n.fills) && n.fills.length && n.type !== 'INSTANCE') { try { n.fills = [S(tintHex)]; } catch (e) {} }\n      if ('children' in n) n.children.forEach(walk);\n    };\n    inst.children.forEach(walk);\n  }\n  return inst;\n}\nconst ICON = { Close:'4:11', Search:'4:16', Cart:'4:7', Account:'4:5', ChevronDown:'4:9' };\nconst LOGO = { Twitter:'4:30', Facebook:'4:24', Instagram:'4:27', GitHub:'4:25', Visa:'4:31', Mastercard:'4:28', PayPal:'4:29', ApplePay:'4:22', GooglePay:'4:26' };\n\n// ============ Announcement Bar ============\n{\n  const comp = figma.createComponent();\n  comp.name = 'Announcement Bar';\n  comp.layoutMode = 'HORIZONTAL';\n  comp.primaryAxisSizingMode = 'FIXED';\n  comp.counterAxisSizingMode = 'AUTO';\n  comp.resize(1440, 40);\n  comp.fills = [S('#000000')];\n  comp.primaryAxisAlignItems = 'CENTER';\n  comp.counterAxisAlignItems = 'CENTER';\n  comp.itemSpacing = 4;\n  const t1 = txt('Sign up and get 20% off to your first order.', 'Regular', 14, '#FFFFFF');\n  comp.appendChild(t1);\n  const t2 = txt('Sign Up Now', 'Medium', 14, '#FFFFFF');\n  t2.textDecoration = 'UNDERLINE';\n  comp.appendChild(t2);\n  const cl = await iconInst(ICON.Close, 20, '#FFFFFF');\n  cl.name = 'btn-close';\n  comp.appendChild(cl);\n  cl.layoutPositioning = 'ABSOLUTE';\n  cl.constraints = { horizontal: 'MAX', vertical: 'CENTER' };\n  cl.x = 1440 - 44; cl.y = 10;\n  place(comp);\n  ids['Announcement Bar'] = comp.id;\n}\n\n// ============ Header ============\n{\n  const comp = figma.createComponent();\n  comp.name = 'Header';\n  comp.layoutMode = 'HORIZONTAL';\n  comp.primaryAxisSizingMode = 'FIXED';\n  comp.counterAxisSizingMode = 'AUTO';\n  comp.resize(1440, 96);\n  comp.fills = [S('#FFFFFF')];\n  comp.counterAxisAlignItems = 'CENTER';\n  comp.paddingLeft = 100; comp.paddingRight = 100;\n  comp.paddingTop = 24; comp.paddingBottom = 24;\n  comp.itemSpacing = 32;\n  const wm = atxt('SHOP.CO', 20, '#000000');\n  wm.name = 'wordmark';\n  comp.appendChild(wm);\n  const nav = figma.createFrame();\n  nav.name = 'nav';\n  nav.layoutMode = 'HORIZONTAL';\n  nav.itemSpacing = 32;\n  nav.fills = [];\n  nav.primaryAxisSizingMode = 'AUTO'; nav.counterAxisSizingMode = 'AUTO';\n  nav.counterAxisAlignItems = 'CENTER';\n  const mkItem = (label, chevron) => {\n    const g = figma.createFrame();\n    g.name = 'nav-' + label;\n    g.layoutMode = 'HORIZONTAL';\n    g.itemSpacing = 4;\n    g.fills = [];\n    g.primaryAxisSizingMode = 'AUTO'; g.counterAxisSizingMode = 'AUTO';\n    g.counterAxisAlignItems = 'CENTER';\n    const t = txt(label, 'Medium', 16, '#000000');\n    t.name = 'label';\n    g.appendChild(t);\n    if (chevron) { const c = iconInstSyncChevron(); g.appendChild(c); }\n    return g;\n  };\n  function iconInstSyncChevron() {\n    // chevron built synchronously is not possible; use placeholder replaced below\n    const f = figma.createFrame();\n    f.name = 'chevron-slot';\n    f.resize(16, 16);\n    f.fills = [];\n    return f;\n  }\n  const navItems = [['Shop', true], ['On Sale', false], ['New Arrivals', false], ['Brands', false]];\n  for (const [label, chev] of navItems) {\n    const it = mkItem(label, chev);\n    nav.appendChild(it);\n    it.name = 'nav-' + label;\n  }\n  comp.appendChild(nav);\n  const spacer = figma.createFrame();\n  spacer.name = 'spacer';\n  spacer.fills = [];\n  spacer.resize(10, 10);\n  comp.appendChild(spacer);\n  spacer.layoutGrow = 1;\n  const sfComp = await figma.getNodeByIdAsync('9:91');\n  const sf = sfComp.createInstance();\n  comp.appendChild(sf);\n  const cart = await iconInst(ICON.Cart, 24, '#000000');\n  cart.name = 'btn-cart';\n  comp.appendChild(cart);\n  const acc = await iconInst(ICON.Account, 24, '#000000');\n  comp.appendChild(acc);\n  // replace chevron slots with real icons\n  for (const it of nav.children) {\n    const slot = it.children.find(c => c.name === 'chevron-slot');\n    if (slot) {\n      const ci = await iconInst(ICON.ChevronDown, 16, '#000000');\n      const idx = it.children.indexOf(slot);\n      it.insertChild(idx, ci);\n      ci.x = slot.x; ci.y = slot.y;\n      slot.remove();\n    }\n  }\n  place(comp);\n  ids['Header'] = comp.id;\n}\n\n// ============ Newsletter ============\n{\n  const comp = figma.createComponent();\n  comp.name = 'Newsletter';\n  comp.layoutMode = 'VERTICAL';\n  comp.primaryAxisSizingMode = 'AUTO';\n  comp.counterAxisSizingMode = 'FIXED';\n  comp.resize(1240, 100);\n  comp.fills = [S('#000000')];\n  comp.cornerRadius = 20;\n  comp.counterAxisAlignItems = 'CENTER';\n  comp.paddingTop = 40; comp.paddingBottom = 40;\n  comp.itemSpacing = 16;\n  const title = atxt('STAY UP TO DATE ABOUT OUR LATEST OFFERS', 24, '#FFFFFF', { ls: 2 });\n  comp.appendChild(title);\n  const row = figma.createFrame();\n  row.name = 'row';\n  row.layoutMode = 'HORIZONTAL';\n  row.itemSpacing = 8;\n  row.fills = [];\n  row.primaryAxisSizingMode = 'AUTO'; row.counterAxisSizingMode = 'AUTO';\n  row.counterAxisAlignItems = 'CENTER';\n  comp.appendChild(row);\n  const tfComp = await figma.getNodeByIdAsync('1:26');\n  const tfi = tfComp.createInstance();\n  row.appendChild(tfi);\n  const labelNode = tfi.children.find(c => c.name === 'Label');\n  if (labelNode) labelNode.visible = false;\n  const input = tfi.children.find(c => c.name === 'Input');\n  input.fills = [S('#FFFFFF')];\n  const ph = input.children.find(c => c.name === 'Placeholder');\n  ph.characters = 'Enter your email address';\n  if (Math.round(tfi.height) > 49) tfi.resize(tfi.width, 48);\n  const btnComp = await figma.getNodeByIdAsync('1:23');\n  const btn = btnComp.createInstance();\n  row.appendChild(btn);\n  btn.children[0].characters = 'Subscribe to Newsletter';\n  btn.resize(250, 52);\n  const report = 'tfi h=' + Math.round(tfi.height) + ' w=' + Math.round(tfi.width) + ' row h=' + Math.round(row.height);\n  place(comp);\n  ids['Newsletter'] = comp.id;\n  ids['_report'] = report;\n}\n\n// ============ Footer ============\n{\n  const comp = figma.createComponent();\n  comp.name = 'Footer';\n  comp.layoutMode = 'VERTICAL';\n  comp.primaryAxisSizingMode = 'FIXED';\n  comp.counterAxisSizingMode = 'FIXED';\n  comp.resize(1440, 420);\n  comp.fills = [S('#000000')];\n  comp.topLeftRadius = 40; comp.topRightRadius = 40;\n  comp.paddingLeft = 100; comp.paddingRight = 100;\n  comp.paddingTop = 64; comp.paddingBottom = 40;\n  comp.itemSpacing = 56;\n  // top row\n  const top = figma.createFrame();\n  top.name = 'top';\n  top.layoutMode = 'HORIZONTAL';\n  top.fills = [];\n  top.primaryAxisSizingMode = 'AUTO'; top.counterAxisSizingMode = 'AUTO';\n  top.itemSpacing = 100;\n  comp.appendChild(top);\n  const brand = figma.createFrame();\n  brand.name = 'brand';\n  brand.layoutMode = 'VERTICAL';\n  brand.fills = [];\n  brand.primaryAxisSizingMode = 'AUTO'; brand.counterAxisSizingMode = 'FIXED';\n  brand.resize(340, 100);\n  brand.itemSpacing = 16;\n  top.appendChild(brand);\n  const fw = atxt('SHOP.CO', 24, '#FFFFFF');\n  brand.appendChild(fw);\n  const blurb = txt(\"We have clothes that suit your style and which you're proud to wear. From women to men.\", 'Regular', 16, '#FFFFFF', { lh: 24 });\n  blurb.fills = [S('#FFFFFF', 0.6)];\n  blurb.textAutoResize = 'HEIGHT';\n  blurb.resize(300, 10);\n  brand.appendChild(blurb);\n  const social = figma.createFrame();\n  social.name = 'social';\n  social.layoutMode = 'HORIZONTAL';\n  social.itemSpacing = 24;\n  social.fills = [];\n  social.primaryAxisSizingMode = 'AUTO'; social.counterAxisSizingMode = 'AUTO';\n  social.counterAxisAlignItems = 'CENTER';\n  brand.appendChild(social);\n  const soc = [['Twitter', 24, 20], ['Facebook', 10, 20], ['Instagram', 20, 20], ['GitHub', 20, 20]];\n  for (const [nm, w, h] of soc) {\n    const li = await iconInst(LOGO[nm], h, '#FFFFFF');\n    li.resize(w, h);\n    social.appendChild(li);\n  }\n  const cols = figma.createFrame();\n  cols.name = 'cols';\n  cols.layoutMode = 'HORIZONTAL';\n  cols.fills = [];\n  cols.primaryAxisSizingMode = 'AUTO'; cols.counterAxisSizingMode = 'AUTO';\n  cols.itemSpacing = 80;\n  top.appendChild(cols);\n  const colData = [\n    ['COMPANY', ['About', 'Features', 'Works', 'Career']],\n    ['HELP', ['Customer Support', 'Delivery Details', 'Terms & Conditions', 'Privacy Policy']],\n    ['FAQ', ['Account', 'Manage Deliveries', 'Orders', 'Payments']],\n    ['RESOURCES', ['Free eBooks', 'Development Tutorial', 'How to - Blog', 'Youtube Playlist']]\n  ];\n  for (const [head, links] of colData) {\n    const col = figma.createFrame();\n    col.layoutMode = 'VERTICAL';\n    col.fills = [];\n    col.primaryAxisSizingMode = 'AUTO'; col.counterAxisSizingMode = 'AUTO';\n    col.itemSpacing = 16;\n    const h = txt(head, 'Medium', 16, '#FFFFFF');\n    col.appendChild(h);\n    for (const l of links) {\n      const lt = txt(l, 'Regular', 14, '#FFFFFF', { op: 0.6 });\n      col.appendChild(lt);\n    }\n    cols.appendChild(col);\n  }\n  // bottom\n  const bottom = figma.createFrame();\n  bottom.name = 'bottom';\n  bottom.layoutMode = 'VERTICAL';\n  bottom.fills = [];\n  bottom.primaryAxisSizingMode = 'AUTO'; bottom.counterAxisSizingMode = 'AUTO';\n  bottom.itemSpacing = 24;\n  comp.appendChild(bottom);\n  const div = figma.createRectangle();\n  div.resize(1240, 1);\n  div.fills = [S('#FFFFFF', 0.1)];\n  bottom.appendChild(div);\n  const brow = figma.createFrame();\n  brow.layoutMode = 'HORIZONTAL';\n  brow.fills = [];\n  brow.primaryAxisSizingMode = 'AUTO'; brow.counterAxisSizingMode = 'AUTO';\n  brow.counterAxisAlignItems = 'CENTER';\n  brow.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  brow.resize(1240, 32);\n  bottom.appendChild(brow);\n  const cp = txt('Shop.co © 2000-2023, All Rights Reserved', 'Regular', 14, '#FFFFFF', { op: 0.6 });\n  brow.appendChild(cp);\n  const pays = figma.createFrame();\n  pays.layoutMode = 'HORIZONTAL';\n  pays.itemSpacing = 16;\n  pays.fills = [];\n  pays.primaryAxisSizingMode = 'AUTO'; pays.counterAxisSizingMode = 'AUTO';\n  pays.counterAxisAlignItems = 'CENTER';\n  brow.appendChild(pays);\n  for (const nm of ['Visa', 'Mastercard', 'PayPal', 'ApplePay', 'GooglePay']) {\n    const li = await figma.getNodeByIdAsync(LOGO[nm]);\n    const inst = li.createInstance();\n    inst.resize(42, 31);\n    pays.appendChild(inst);\n  }\n  // fix footer height to hug content: set vertical auto\n  comp.primaryAxisSizingMode = 'AUTO';\n  comp.resize(1440, comp.height);\n  place(comp);\n  ids['Footer'] = comp.id;\n}\nreturn JSON.stringify(ids);","description":"Create Announcement Bar, Header, Newsletter, Footer components","fileKey":"v7DhK3JEKoEZ85CKjv3t3x"}}],"id":"137963c1-2eaa-4550-a925-6d672705c1fc","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"7e0442a0-e797-4be3-bd46-d253cafd84e1","uuid":"3d0c962b-001a-49ee-9f2b-fbefc3a12451","timestamp":"2026-11-01T22:03:58.892Z","tool_use_meta":[{"id":"call_abc7f47f946145c2bd88b458","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
