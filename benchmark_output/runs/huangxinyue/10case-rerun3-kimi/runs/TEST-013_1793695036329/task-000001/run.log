ound(w*pct/100),6,'#BBF246',3); comp.appendChild(fill);\n  return comp;\n}\n```\nComponent with no bg fill, children track+fill.\n\nHmm — component clipsContent default true; fine.\n\nDayCell variants:\n```js\nfunction makeDay(letter, num, current){\n  const comp=figma.createComponent(); comp.name = current? 'state=current':'state=default'; comp.resize(38,58);\n  if(current){ comp.fills=[{type:'SOLID',color:C('#BBF246')}]; comp.cornerRadius=19; } else comp.fills=[];\n  const l=txt(letter,11,'Bold',current?'#192126':'#98A3AC'); comp.appendChild(l); l.x=(38-l.width)/2; l.y=9;\n  const n=txt(num,13,'Black','#192126'); comp.appendChild(n); n.x=(38-n.width)/2; n.y=31;\n  return comp;\n}\n```\nVariants from makeDay('S','10',false) and makeDay('T','12',true).\n\nStatChip:\n```js\nconst chip=figma.createComponent(); chip.name='Stat Chip'; chip.resize(169,56); chip.cornerRadius=16; chip.fills=[{type:'SOLID',color:C('#F2F5F6')}];\nconst circ=rect(36,36,'#BBF246',18); circ.x=10; circ.y=10; circ.name='iconBg'; chip.appendChild(circ);\nconst ic=await icon('Timer',18,'#192126'); ic.x=19; ic.y=19; ic.name='icon'; chip.appendChild(ic);\nconst lab=txt('Time',11,'Regular','#78838C'); lab.x=56; lab.y=12; lab.name='label'; chip.appendChild(lab);\nconst val=txt('50 min',15,'Black','#192126'); val.x=56; val.y=30; val.name='value'; chip.appendChild(val);\n```\n\nChallengeCard:\n```js\nconst ch=figma.createComponent(); ch.name='Challenge Card'; ch.resize(108,72); ch.cornerRadius=16; ch.fills=[{type:'SOLID',color:C('#F1FBCF')}];\nconst ct=txt('Plank\\nChallenge',12,'Bold','#192126',{align:'CENTER', w:96, lh:16}); ct.x=6; ct.y=(72-32)/2; ch.appendChild(ct);\n```\n\nReportTile:\n```js\nconst tile=figma.createComponent(); tile.name='Report Tile'; tile.resize(169,120); tile.cornerRadius=20; tile.fills=[{type:'SOLID',color:C('#FFFFFF')}]; tile.effects=[shadow];\nconst chipBg=rect(32,32,'#F1FBCF',16); at 12,12 name 'iconBg';\nicon Fire 16 charcoal at 20,20 name 'icon';\ntitle 'Active calories' 12