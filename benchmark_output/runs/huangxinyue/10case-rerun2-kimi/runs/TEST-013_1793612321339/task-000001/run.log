ANGLE' || n.type==='ELLIPSE') && n.name !== 'Notch').forEach(n => { n.fills = S(C.white); }); parent.appendChild(sb); return sb; }\nfunction menuRow(parent, x, y, label, iconKey, color){ const f = figma.createFrame(); f.name = 'Menu · ' + label; f.resize(278,52); f.fills = []; f.x = x; f.y = y; parent.appendChild(f); iconInst(iconKey, 16, 16, f, color); const t = T(label, 15, 'Semi Bold', color, 'Label'); t.x = 48; f.appendChild(t); t.y = Math.round((52 - t.height)/2); return f; }\n\nconst f4 = figma.createFrame(); f4.name = '04_Menu'; f4.resize(390,844); f4.fills = S(C.white); f4.x = 1380; f4.y = 0; f4.clipsContent = true; P.appendChild(f4);\n// mini home preview behind\nconst mini = figma.createFrame(); mini.name = 'Home preview (03_Home behind)'; mini.resize(390,844); mini.fills = S(C.white); mini.x = 0; mini.y = 0; mini.clipsContent = true; f4.appendChild(mini);\nconst mh = figma.createFrame(); mh.name = 'Header · Balance'; mh.resize(390,300); mh.fills = S(C.brand); mh.x = 0; mh.y = 0; mh.clipsContent = true; mini.appendChild(mh);\nwhiteSB(mh);\nconst mav = lib.avH.createInstance(); mav.resize(40,40); mav.cornerRadius = 20; mav.x = 16; mav.y = 63; mh.appendChild(mav);\nconst msearch = figma.createFrame(); msearch.name = 'Search'; msearch.resize(232,40); msearch.cornerRadius = 20; msearch.fills = TINT(C.white, 0.16); msearch.x = 64; msearch.y = 63; mh.appendChild(msearch);\niconInst('search', 12, 10, msearch, C.white);\nconst msph = T('Pay by name or phone', 13, 'Regular', C.white, 'Placeholder'); msph.opacity = 0.75; msph.x = 40; msearch.appendChild(msph); msph.y = (40 - msph.height)/2;\nconst mhist = figma.createFrame(); mhist.name = 'History'; mhist.resize(40,40); mhist.cornerRadius = 20; mhist.fills = TINT(C.white, 0.16); mhist.x = 334; mhist.y = 63; mh.appendChild(mhist); iconInst('hist', 10, 10, mhist, C.white);\nconst mhsbc = lib.hsbc.createInstance(); mhsbc.resize(60,17); mhsbc.x = 24; mhsbc.y = 131; mh.appendChild(mhsbc);\nconst mlub = T('Last Updated Ba