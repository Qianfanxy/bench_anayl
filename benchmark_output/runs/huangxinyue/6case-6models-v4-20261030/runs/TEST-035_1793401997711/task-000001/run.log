);i.resize(i.width*s,i.height*s);}i.x=x;i.y=y;return i;}\nasync function scr(name,x,y,bg){const f=figma.createFrame();f.name=name;f.x=x;f.y=y;f.resize(375,812);f.fills=[{type:'SOLID',color:bg||C.wh}];f.clipsContent=true;page.appendChild(f);await I('4:180',f,0,0);await I('4:191',f,0,778);return f;}\nasync function setTxt(inst,str){const t=inst.findOne(n=>n.type==='TEXT');const fn=t.fontName;await figma.loadFontAsync(fn);t.characters=str;}\nasync function btn(parent,label,x,y,variant){const b=await I('4:168',parent,x,y);await setTxt(b,label);b.name='Button · '+label;if(variant==='outline'){b.fills=[{type:'SOLID',color:C.wh}];b.strokes=[{type:'SOLID',color:C.ln}];b.strokeWeight=1;const t=b.findOne(n=>n.type==='TEXT');t.fills=[{type:'SOLID',color:C.ink}];}return b;}\nasync function field(parent,label,placeholder,value,x,y){await T(parent,label,13,'S',C.ink,x,y,{name:'Label '+label});const f=await I('4:174',parent,x,y+22);const t=f.findOne(n=>n.type==='TEXT');const fn=t.fontName;await figma.loadFontAsync(fn);t.characters=value||placeholder;if(value){f.strokes=[{type:'SOLID',color:C.pri}];f.strokeWeight=1;t.fills=[{type:'SOLID',color:C.ink}];}else{f.strokes=[{type:'SOLID',color:C.ln}];f.strokeWeight=1;}f.name='Field · '+label;return f;}\n\nasync function signup(name,x,y,filled){\n  const f=await scr(name,x,y);\n  await T(f,'Join StockWave',26,'B',C.ink,24,84);\n  await T(f,'Embark on your investment journey with a single dollar.',14,'R',C.sub,24,122,{w:327,lh:22});\n  await field(f,'Username','Username',filled?'Agatha Bella':null,24,176);\n  await field(f,'Email','Email',filled?'agbella@email.com':null,24,268);\n  await field(f,'Password','Password',filled?'••••••••••':null,24,360);\n  await btn(f,'Continue',24,444,'primary');\n  R(f,24,538,95,1,C.ln);R(f,256,538,95,1,C.ln);\n  await T(f,'Or continue with',13,'R',C.sub,0,528,{w:375,align:'CENTER'});\n  R(f,24,570,158,52,C.wh,12,{stroke:C.ln,name:'GoogleBtn'});\n  const gc=figma.createEllipse();gc.resize(18,18);gc.x=52;gc.