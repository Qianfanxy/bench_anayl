ce };\n  } catch (e) { errs.push('OldPrice:' + e.message); }\n  try {\n    propKeys.Discount = comp.addComponentProperty('Discount', 'TEXT', '-20%');\n    dt.componentPropertyReferences = { characters: propKeys.Discount };\n  } catch (e) { errs.push('Discount:' + e.message); }\n  try {\n    propKeys.ShowOld = comp.addComponentProperty('ShowOld', 'BOOLEAN', true);\n    old.componentPropertyReferences = { visible: propKeys.ShowOld };\n  } catch (e) { errs.push('ShowOld:' + e.message); }\n  try {\n    propKeys.ShowDiscount = comp.addComponentProperty('ShowDiscount', 'BOOLEAN', true);\n    pill.componentPropertyReferences = { visible: propKeys.ShowDiscount };\n  } catch (e) { errs.push('ShowDiscount:' + e.message); }\n  place(comp);\n  ids['ProductCard'] = comp.id;\n}\n\n// ============ Style Tile ============\n{\n  const comp = figma.createComponent();\n  comp.name = 'Style Tile';\n  comp.layoutMode = 'HORIZONTAL';\n  comp.primaryAxisSizingMode = 'FIXED';\n  comp.counterAxisSizingMode = 'FIXED';\n  comp.resize(293, 220);\n  comp.fills = [S('#F0F0F0')];\n  comp.cornerRadius = 20;\n  comp.clipsContent = true;\n  const photoComp = await figma.getNodeByIdAsync('4:44');\n  const photo = photoComp.createInstance();\n  photo.name = 'photo';\n  photo.resize(293, 220);\n  photo.constraints = { horizontal: 'STRETCH', vertical: 'STRETCH' };\n  comp.appendChild(photo);\n  const label = txt('Casual', 'SemiBold', 20, '#000000');\n  label.name = 'label';\n  comp.appendChild(label);\n  label.layoutPositioning = 'ABSOLUTE';\n  label.constraints = { horizontal: 'MIN', vertical: 'MAX' };\n  label.x = 24; label.y = 220 - 20 - 20;\n  try {\n    propKeys.TilePhoto = comp.addComponentProperty('Photo', 'INSTANCE_SWAP', '4:44');\n    photo.componentPropertyReferences = { mainComponent: propKeys.TilePhoto };\n  } catch (e) { errs.push('TilePhoto:' + e.message); }\n  try {\n    propKeys.TileLabel = comp.addComponentProperty('Label', 'TEXT', 'Casual');\n    label.componentPropertyReferences = { characters: propKeys.TileLabel };\n  } catch (e) { errs.push('TileLabel:' + e.message); }\n  place(comp);\n  ids['StyleTile'] = comp.id;\n}\n\n// ============ Review Card (home testimonial) ============\n{\n  const comp = figma.createComponent();\n  comp.name = 'Review Card';\n  comp.layoutMode = 'VERTICAL';\n  comp.primaryAxisSizingMode = 'AUTO';\n  comp.counterAxisSizingMode = 'FIXED';\n  comp.resize(400, 100);\n  comp.itemSpacing = 12;\n  comp.paddingTop = 28; comp.paddingBottom = 28;\n  comp.paddingLeft = 24; comp.paddingRight = 24;\n  comp.fills = [S('#FFFFFF')];\n  comp.cornerRadius = 20;\n  comp.strokes = [S('#E0E0E0')];\n  comp.strokeWeight = 1;\n  const rateComp = await figma.getNodeByIdAsync('9:11');\n  const rating = rateComp.createInstance();\n  rating.name = 'rating';\n  comp.appendChild(rating);\n  const nrow = hframe('namerow', 8, 'CENTER');\n  const name = txt(\"Sarah M.\", 'SemiBold', 16, '#000000');\n  name.name = 'name';\n  nrow.appendChild(name);\n  const v = await iconInst('4:23', 24, '#3B82F6');\n  nrow.appendChild(v);\n  comp.appendChild(nrow);\n  const quote = txt(\"I'm blown away by the quality and style of the clothes I received from Shop.co. From casual wear to elegant dresses, every piece I've bought has exceeded my expectations.\", 'Regular', 16, '#616161', { lh: 24 });\n  quote.name = 'quote';\n  quote.textAutoResize = 'HEIGHT';\n  quote.resize(352, quote.height);\n  comp.appendChild(quote);\n  place(comp);\n  ids['ReviewCard'] = comp.id;\n}\n\n// ============ Product Review Card (03) ============\n{\n  const comp = figma.createComponent();\n  comp.name = 'Product Review Card';\n  comp.layoutMode = 'VERTICAL';\n  comp.primaryAxisSizingMode = 'AUTO';\n  comp.counterAxisSizingMode = 'FIXED';\n  comp.resize(612, 100);\n  comp.itemSpacing = 12;\n  comp.paddingTop = 24; comp.paddingBottom = 24;\n  comp.paddingLeft = 28; comp.paddingRight = 28;\n  comp.fills = [S('#F0F0F0')];\n  comp.cornerRadius = 20;\n  const r1 = hframe('head', 8, 'CENTER')