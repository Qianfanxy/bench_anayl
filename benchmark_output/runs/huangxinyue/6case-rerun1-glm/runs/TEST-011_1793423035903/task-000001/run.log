d(t);t.x=x;t.y=y;return t;}\nfunction inst(id,parent,x,y){const i=figma.getNodeById(id).createInstance();parent.appendChild(i);i.x=x;i.y=y;return i;}\nfunction recolor(i,hex){const kids=i.children||[];for(const c of kids){if(Array.isArray(c.fills)&&c.fills.length&&c.fills!==figma.mixed)c.fills=[P(hex)];if(Array.isArray(c.strokes)&&c.strokes.length)c.strokes=[P(hex)];}}\nfunction setPhoto(cardInst,mediaId){const p=cardInst.findOne(n=>n.name===\"photo\");p.fills=figma.getNodeById(mediaId).fills;}\n```\n\n4. Errors and fixes:\n   - **Screens vanished (external cause)**: all 10 previously built screens disappeared from the file between sessions; getNodeById NULL for all; zero 375×812 frames document-wide; design system survived intact with icon fixes. Fix in progress: full rebuild of the 10 screens on page 5:2 (01–03 done; 04 in progress). Must report this incident in the final answer limitations.\n   - **NEW ERROR (Script C, 04_Home)**: \"Error: in set_x: This property cannot be overridden in an instance: relative-transform\" — thrown in chip() at `t.x=Math.round((c.width-t.width)/2)` where t is a TEXT child INSIDE a chip INSTANCE (11:87). The whole script rolled back (04_Home was NOT created). Fix: NEVER set x/y on instance children. New chip approach: set characters (allowed), measure t.width, resize instance to pad*2+t.width (pad 12, gap 8, flow from x=24), never move t; selected chip = c.fills=[P(PRIMARY)] + t.fills=[P(WHITE)] (fills overrides are allowed). Buttons needing non-327 width (05 \"Add to basket\" 145x56; 07 \"Pay on delivery\"/\"Pay with card\" 155x56) must be PLAIN FRAMES (PRIMARY bg r10 / white bg + PRIMARY stroke r10) with own centered text child (setting t.x on a plain frame's child IS allowed); 327-wide buttons can stay 7:5/7:7 instances with only .characters overridden (proven working: b3 override succeeded).\n   - Prior-session errors (still relevant): prototype format — \"AFTER_DELAY\"→\"AFTER_TIMEOUT\", `delay`→`timeout`, `action`→`actions`, \"