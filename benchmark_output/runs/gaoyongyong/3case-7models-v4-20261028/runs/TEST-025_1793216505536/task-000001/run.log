{"type":"assistant","message":{"id":"chatcmpl-202610281955399596527038268d9d6sLuaBGEC","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_2b1f106bdf91462e9b7a2c382b54f309","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  // Let's create the 11_Support_Chat screen!\n  // Must include:\n  // • Actions: back · menu · send\n  // • Conversation: 7 items in the order given in DATA — each message from the agent or the customer · timestamp “26 minutes ago” after the agent’s third message\n  // • Input: “Type here...”\n  \n  // Conversation Messages (7 items in this exact order):\n  // 1. Agent: \"Hi, how can I help you?\"\n  // 2. Customer: \"Hello, I ordered two Cheeseburger Wendy’s Burgers. Can I know how long it will take to arrive?\"\n  // 3. Agent: \"Ok, please let me check!\"\n  // 4. Customer: \"Sure...\"\n  // 5. Agent: \"It’ll take 25 minutes to arrive at your address.\"\n  // 6. Timestamp after Agent's 3rd message (which is message #5): \"[26 minutes ago]\" or \"26 minutes ago\"\n  // 7. Customer: \"Ok, thank you for your support.\" (Brief correction: the brief says: C “Ok, thank you for your support.”, instead of source's typo \"thanks you\")\n\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Bold\" });\n  \n  const frame = await figma.getNodeByIdAsync(\"2004:12\"); // 11_Support_Chat\n  if (!frame) return \"Support Chat frame not found\";\n  \n  // Clear success frame loose children first (keep Status Bar and Home Indicator)\n  for (const child of [...frame.children]) {\n    if (child.name !== \"Status Bar\" && child.name !== \"Home Indicator\") {\n      child.remove();\n    }\n  }\n  \n  const backMaster = await figma.getNodeByIdAsync(\"1:355\");\n  const menuMaster = await figma.getNodeByIdAsync(\"1:404\");\n  const sendMaster = await figma.getNodeByIdAsync(\"1:383\");\n  const avatarMaster = await figma.getNodeByIdAsync(\"1:214\");\n  \n  // 1. Header (Back Button, Title \"Support Chat\" / Agent Active Status, Menu Button)\n  const backBtn = figma.createFrame();\n  backBtn.name = \"Back_Button\";\n  backBtn.resize(48, 48);\n  backBtn.cornerRadius = 16;\n  backBtn.backgrounds = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  backBtn.strokes = [{ type: \"SOLID\", color: { r: 0.9, g: 0.9, b: 0.9 } }];\n  backBtn.strokeWeight = 1;\n  backBtn.x = 24;\n  backBtn.y = 64;\n  if (backMaster) {\n    const backIcon = backMaster.createInstance();\n    backIcon.x = 12;\n    backIcon.y = 12;\n    backIcon.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n    backBtn.appendChild(backIcon);\n  }\n  frame.appendChild(backBtn);\n  \n  const menuBtn = figma.createFrame();\n  menuBtn.name = \"Menu_Button\";\n  menuBtn.resize(48, 48);\n  menuBtn.cornerRadius = 16;\n  menuBtn.backgrounds = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  menuBtn.strokes = [{ type: \"SOLID\", color: { r: 0.9, g: 0.9, b: 0.9 } }];\n  menuBtn.strokeWeight = 1;\n  menuBtn.x = frame.width - 24 - 48;\n  menuBtn.y = 64;\n  if (menuMaster) {\n    const menuIcon = menuMaster.clone(); // It's a FRAME, clone it!\n    menuIcon.resize(20, 20);\n    menuIcon.x = 14;\n    menuIcon.y = 14;\n    menuIcon.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n    menuBtn.appendChild(menuIcon);\n  }\n  frame.appendChild(menuBtn);\n  \n  // Agent Details in Header Center\n  const agentName = figma.createText();\n  agentName.characters = \"Foodgo Support\";\n  agentName.fontSize = 18;\n  agentName.fontName = { family: \"Roboto\", style: \"Bold\" };\n  agentName.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n  agentName.x = (frame.width - agentName.width) / 2;\n  agentName.y = 66;\n  frame.appendChild(agentName);\n  \n  const activeStatus = figma.createText();\n  activeStatus.characters = \"Online\";\n  activeStatus.fontSize = 13;\n  activeStatus.fontName = { family: \"Roboto\", style: \"Medium\" };\n  activeStatus.fills = [{ type: \"SOLID\", color: { r: 0.22, g: 0.68, b: 0.35 } }]; // beautiful green\n  activeStatus.x = (frame.width - activeStatus.width) / 2;\n  activeStatus.y = 88;\n  frame.appendChild(activeStatus);\n  \n  // Green active dot next to Status\n  const greenDot = figma.createFrame();\n  greenDot.resize(8, 8);\n  greenDot.cornerRadius = 4;\n  greenDot.backgrounds = [{ type: \"SOLID\", color: { r: 0.22, g: 0.68, b: 0.35 } }];\n  greenDot.x = (frame.width - activeStatus.width) / 2 - 12;\n  greenDot.y = 92;\n  frame.appendChild(greenDot);\n  \n  return \"Support Chat screen header design completed.\";\n})()\n","description":"Design 11_Support_Chat header layout with back, custom menu cloned button, agent name, and green active \"Online\" indicator dot.","fileKey":"pNVsMbFlqHuHgCQFsjUPkH"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":76012,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"494b4549-32cd-4fcc-b024-fd0ae7aff445","uuid":"b0bda979-655a-4c33-a4fa-0242b0d61865","timestamp":"2026-10-28T19:55:53.248Z","tool_use_meta":[{"id":"call_2b1f106bdf91462e9b7a2c382b54f309","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_2b1f106bdf91462e9b7a2c382b54f309","type":"tool_result","content":[{"type":"text","text":"Support Chat screen header design completed."}]}]},"parent_tool_use_id":null,"session_id":"494b4549-32cd-4fcc-b024-fd0ae7aff445","uuid":"88d11b91-2aa7-4b06-8cc7-3a6845c3ae7a","timestamp":"2026-10-28T19:55:59.754Z","tool_use_result":{"content":[{"type":"text","text":"Support Chat screen header design completed."}],"_meta":{"mcpRequestId":"8bd0b853-e23a-4bef-b0ea-25cc4ed3532b"}},"tool_result_meta":[{"id":"call_2b1f106bdf91462e9b7a2c382b54f309","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"id":"chatcmpl-202610281956001238036498268d9d6UJ00q5un","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_fb998092eb004e379057418309389537","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  // Let's create the 7 messages in the chat conversation sequentially.\n  // We'll calculate height dynamically or place them nicely starting from y = 135.\n  // Agent bubble: Left-aligned, light gray/dark brown background. Let's make it beautiful:\n  // - Background: #EAEAEA (R=0.92, G=0.92, B=0.92), text: Dark brown #3C2F2F.\n  // Customer bubble: Right-aligned, primary red #EF2A39 background, text: white.\n  \n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Bold\" });\n  \n  const frame = await figma.getNodeByIdAsync(\"2004:12\"); // 11_Support_Chat\n  if (!frame) return \"Support Chat frame not found\";\n  \n  const avatarMaster = await figma.getNodeByIdAsync(\"1:214\");\n  \n  const conversations = [\n    { sender: \"agent\", text: \"Hi, how can I help you?\" },\n    { sender: \"customer\", text: \"Hello, I ordered two Cheeseburger Wendy’s Burgers. Can I know how long it will take to arrive?\" },\n    { sender: \"agent\", text: \"Ok, please let me check!\" },\n    { sender: \"customer\", text: \"Sure...\" },\n    { sender: \"agent\", text: \"It’ll take 25 minutes to arrive at your address.\" },\n    { sender: \"timestamp\", text: \"26 minutes ago\" },\n    { sender: \"customer\", text: \"Ok, thank you for your support.\" }\n  ];\n  \n  let cy = 135;\n  for (let i = 0; i < conversations.length; i++) {\n    const item = conversations[i];\n    \n    if (item.sender === \"timestamp\") {\n      // Timestamp bubble/label centered\n      const timeLbl = figma.createText();\n      timeLbl.name = `Timestamp_${i}`;\n      timeLbl.characters = item.text;\n      timeLbl.fontSize = 12;\n      timeLbl.fontName = { family: \"Roboto\", style: \"Medium\" };\n      timeLbl.fills = [{ type: \"SOLID\", color: { r: 0.6, g: 0.6, b: 0.6 } }];\n      timeLbl.x = (frame.width - timeLbl.width) / 2;\n      timeLbl.y = cy + 12;\n      frame.appendChild(timeLbl);\n      \n      cy += 40;\n      continue;\n    }\n    \n    // Bubble container\n    const bubble = figma.createFrame();\n    bubble.name = `${item.sender === \"agent\" ? \"Agent\" : \"Customer\"}_Bubble_${i}`;\n    bubble.cornerRadius = 16;\n    \n    // Text inside bubble\n    const txt = figma.createText();\n    txt.characters = item.text;\n    txt.fontSize = 14;\n    txt.lineHeight = { value: 20, unit: \"PIXELS\" };\n    txt.fontName = { family: \"Roboto\", style: \"Regular\" };\n    \n    // Calculate bubble width & wrap text if too long\n    const maxTextWidth = 260;\n    txt.resize(maxTextWidth, 10); // set width, height is auto\n    const actualWidth = Math.min(txt.width, maxTextWidth);\n    const bubbleW = actualWidth + 24; // padding left/right\n    const bubbleH = txt.height + 20; // padding top/bottom\n    bubble.resize(bubbleW, bubbleH);\n    \n    txt.x = 12;\n    txt.y = 10;\n    bubble.appendChild(txt);\n    \n    if (item.sender === \"agent\") {\n      // Agent bubble on the left\n      bubble.backgrounds = [{ type: \"SOLID\", color: { r: 0.94, g: 0.94, b: 0.94 } }];\n      txt.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }]; // Dark brown\n      bubble.x = 24;\n      bubble.y = cy;\n      \n      // Let's add a small active profile icon or just bubble. \"A small profile indicator\" - let's keep it simple and clean!\n    } else {\n      // Customer bubble on the right (brand red background, white text)\n      bubble.backgrounds = [{ type: \"SOLID\", color: { r: 0.9372549, g: 0.1647059, b: 0.2235294 } }];\n      txt.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n      bubble.x = frame.width - 24 - bubbleW;\n      bubble.y = cy;\n      \n      // Since it's right-aligned, we need to adjust txt.x if wrap width was larger than actual text width\n      txt.x = 12;\n    }\n    \n    frame.appendChild(bubble);\n    cy += bubbleH + 14; // gap of 14 between messages\n  }\n  \n  // 3. Chat Input Box at the bottom above the home indicator\n  // Height: 64, y = 932 - 34 - 64 - 12 = 822.\n  const inputContainer = figma.createFrame();\n  inputContainer.name = \"Input_Box\";\n  inputContainer.resize(382, 56);\n  inputContainer.x = 24;\n  inputContainer.y = 822;\n  inputContainer.cornerRadius = 16;\n  inputContainer.backgrounds = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  inputContainer.strokes = [{ type: \"SOLID\", color: { r: 0.92, g: 0.92, b: 0.92 } }];\n  inputContainer.strokeWeight = 1;\n  \n  const placeholder = figma.createText();\n  placeholder.characters = \"Type here...\";\n  placeholder.fontSize = 15;\n  placeholder.fontName = { family: \"Roboto\", style: \"Regular\" };\n  placeholder.fills = [{ type: \"SOLID\", color: { r: 0.6, g: 0.6, b: 0.6 } }];\n  placeholder.x = 16;\n  placeholder.y = 18;\n  inputContainer.appendChild(placeholder);\n  \n  // Send Action Button (floating style or right side inside input)\n  const sendBtn = figma.createFrame();\n  sendBtn.name = \"Send_Action\";\n  sendBtn.resize(40, 40);\n  sendBtn.cornerRadius = 12;\n  sendBtn.backgrounds = [{ type: \"SOLID\", color: { r: 0.9372549, g: 0.1647059, b: 0.2235294 } }]; // Red circle/box\n  sendBtn.x = inputContainer.width - 8 - 40;\n  sendBtn.y = 8;\n  \n  const sendMaster = await figma.getNodeByIdAsync(\"1:383\");\n  if (sendMaster) {\n    const sendIcon = sendMaster.createInstance();\n    sendIcon.resize(18, 18);\n    sendIcon.x = 11; // center nicely\n    sendIcon.y = 11;\n    sendIcon.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n    sendBtn.appendChild(sendIcon);\n  }\n  inputContainer.appendChild(sendBtn);\n  frame.appendChild(inputContainer);\n  \n  return \"All conversation messages and bottom Chat Input populated successfully.\";\n})()\n","description":"Design 11_Support_Chat's 7 conversation bubbles with perfect vertical gaps, accurate customer red / agent gray colors, and center \"26 minutes ago\" label, plus bottom Chat Input box with placeholder and send button.","fileKey":"pNVsMbFlqHuHgCQFsjUPkH"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":77692,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"494b4549-32cd-4fcc-b024-fd0ae7aff445","uuid":"05d447b6-974d-4028-bbdb-d25b32699bfa","timestamp":"2026-10-28T19:56:11.993Z","tool_use_meta":[{"id":"call_fb998092eb004e379057418309389537","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_fb998092eb004e379057418309389537","type":"tool_result","content":[{"type":"text","text":"All conversation messages and bottom Chat Input populated successfully."}]}]},"parent_tool_use_id":null,"session_id":"494b4549-32cd-4fcc-b024-fd0ae7aff445","uuid":"eb901a7e-102a-4915-b7d0-4be68d538355","timestamp":"2026-10-28T19:56:19.569Z","tool_use_result":{"content":[{"type":"text","text":"All conversation messages and bottom Chat Input populated successfully."}],"_meta":{"mcpRequestId":"41a38002-c520-48e9-a594-9c23b96b9b8b"}},"tool_result_meta":[{"id":"call_fb998092eb004e379057418309389537","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"id":"chatcmpl-202610281956199240892548268d9d6WGkdhRPm","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_a127d4098ce0458593ed4a0ab0c0b372","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  // Let's create the required prototype connections for the 11 frames in 03 · Workspace.\n  // The brief lists these connections:\n  // 1. 01_Splash: Auto-advances to 02_Home. (After delay -> navigate to 02_Home)\n  // 2. 02_Home:\n  //    - Cheeseburger Wendy’s Burger (Menu_Card_Wendy's_Burger) -> 03_Product_Cheeseburger\n  //    - Veggie Burger (Menu_Card_Veggie_Burger) -> 04_Product_Veggie\n  //    - Chicken Burger (Menu_Card_Chicken_Burger) -> 05_Product_Chicken\n  //    - Fried Chicken Burger (Menu_Card_Fried_Chicken_Burger) -> 06_Product_Fried_Chicken\n  //    - Profile Tab (Bottom Nav, x=270, Icon / User) -> 10_Profile\n  //    - Support Tab (Bottom Nav, x=350, Icon / Chat) -> 11_Support_Chat\n  // 3. 03_Product_Cheeseburger:\n  //    - Back Button -> 02_Home\n  //    - Order Now -> 07_Customize\n  // 4. 04_Product_Veggie:\n  //    - Back Button -> 02_Home\n  // 5. 05_Product_Chicken:\n  //    - Back Button -> 02_Home\n  // 6. 06_Product_Fried_Chicken:\n  //    - Back Button -> 02_Home\n  // 7. 07_Customize:\n  //    - Back Button -> 03_Product_Cheeseburger\n  //    - Order Now -> 08_Payment\n  // 8. 08_Payment:\n  //    - Back Button -> 07_Customize\n  //    - Pay Now -> 09_Payment_Success_Overlay\n  // 9. 09_Payment_Success_Overlay:\n  //    - Go Back -> 02_Home\n  // 10. 10_Profile:\n  //    - Back Button -> 02_Home\n  // 11. 11_Support_Chat:\n  //    - Back Button -> 02_Home\n\n  const page = await figma.getNodeByIdAsync(\"2002:2\");\n  if (!page) return \"Workspace page not found\";\n  \n  // Find frames\n  const f01 = page.children.find(c => c.name === \"01_Splash\");\n  const f02 = page.children.find(c => c.name === \"02_Home\");\n  const f03 = page.children.find(c => c.name === \"03_Product_Cheeseburger\");\n  const f04 = page.children.find(c => c.name === \"04_Product_Veggie\");\n  const f05 = page.children.find(c => c.name === \"05_Product_Chicken\");\n  const f06 = page.children.find(c => c.name === \"06_Product_Fried_Chicken\");\n  const f07 = page.children.find(c => c.name === \"07_Customize\");\n  const f08 = page.children.find(c => c.name === \"08_Payment\");\n  const f09 = page.children.find(c => c.name === \"09_Payment_Success_Overlay\");\n  const f10 = page.children.find(c => c.name === \"10_Profile\");\n  const f11 = page.children.find(c => c.name === \"11_Support_Chat\");\n  \n  if (!f01 || !f02 || !f03 || !f04 || !f05 || !f06 || !f07 || !f08 || !f09 || !f10 || !f11) {\n    return \"Some frames are missing!\";\n  }\n  \n  // Helper to add navigate reaction\n  function connect(sourceNode, targetNode, triggerType = \"ON_CLICK\", transitionType = \"DISSOLVE\") {\n    if (!sourceNode || !targetNode) return;\n    \n    // Dissolve transition\n    const transition = {\n      type: transitionType,\n      duration: 0.3\n    };\n    \n    const reaction = {\n      trigger: { type: triggerType, delay: triggerType === \"AFTER_DELAY\" ? 1.5 : undefined },\n      actions: [{\n        type: \"NODE\",\n        destinationId: targetNode.id,\n        navigation: \"NAVIGATE\",\n        transition: transition\n      }]\n    };\n    \n    // Assign reactions list\n    sourceNode.reactions = [reaction];\n  }\n  \n  // 1. Splash -> Home (After delay 1.5s)\n  connect(f01, f02, \"AFTER_DELAY\");\n  \n  // 2. Home -> Products\n  const card1 = f02.children.find(c => c.name === \"Menu_Card_Wendy's_Burger\");\n  const card2 = f02.children.find(c => c.name === \"Menu_Card_Veggie_Burger\");\n  const card3 = f02.children.find(c => c.name === \"Menu_Card_Chicken_Burger\");\n  const card4 = f02.children.find(c => c.name === \"Menu_Card_Fried_Chicken_Burger\");\n  \n  connect(card1, f03);\n  connect(card2, f04);\n  connect(card3, f05);\n  connect(card4, f06);\n  \n  // 3. Home Bottom Nav -> Profile / Support\n  const botNav = f02.children.find(c => c.name === \"Bottom Navigation\");\n  if (botNav) {\n    // We placed user icon at x=270, chat icon at x=350.\n    // Let's create small interactive hot-spots or find children inside botNav.\n    // To make it easy, we can search for instances of \"Icon / User\" and \"Icon / Chat\" inside botNav\n    const userInst = botNav.children.find(c => c.name.includes(\"User\"));\n    const chatInst = botNav.children.find(c => c.name.includes(\"Chat\"));\n    \n    connect(userInst, f10);\n    connect(chatInst, f11);\n  }\n  \n  // 4. Back buttons to Home\n  const backF03 = f03.children.find(c => c.name === \"Back_Button\");\n  const backF04 = f04.children.find(c => c.name === \"Back_Button\");\n  const backF05 = f05.children.find(c => c.name === \"Back_Button\");\n  const backF06 = f06.children.find(c => c.name === \"Back_Button\");\n  const backF07 = f07.children.find(c => c.name === \"Back_Button\");\n  const backF08 = f08.children.find(c => c.name === \"Back_Button\");\n  const backF10 = f10.children.find(c => c.name === \"Back_Button\");\n  const backF11 = f11.children.find(c => c.name === \"Back_Button\");\n  \n  connect(backF03, f02);\n  connect(backF04, f02);\n  connect(backF05, f02);\n  connect(backF06, f02);\n  connect(backF07, f03);\n  connect(backF08, f07);\n  connect(backF10, f02);\n  connect(backF11, f02);\n  \n  // 5. Order Now from Cheeseburger -> Customize\n  const footerF03 = f03.children.find(c => c.name === \"Footer\");\n  if (footerF03) {\n    const orderBtn = footerF03.children.find(c => c.name.startsWith(\"Button\"));\n    connect(orderBtn, f07);\n  }\n  \n  // 6. Customize Order Now -> Payment\n  const footerF07 = f07.children.find(c => c.name === \"Footer\");\n  if (footerF07) {\n    const orderBtn = footerF07.children.find(c => c.name.startsWith(\"Button\"));\n    connect(orderBtn, f08);\n  }\n  \n  // 7. Payment Pay Now -> Success Overlay\n  const footerF08 = f08.children.find(c => c.name === \"Footer\");\n  if (footerF08) {\n    const payBtn = footerF08.children.find(c => c.name.startsWith(\"Button\"));\n    connect(payBtn, f09);\n  }\n  \n  // 8. Success Overlay Go Back -> Home\n  const dialog = f09.children.find(c => c.name === \"Success_Dialog\");\n  if (dialog) {\n    const goBackBtn = dialog.children.find(c => c.name.startsWith(\"Button\"));\n    connect(goBackBtn, f02);\n  }\n  \n  return \"All prototype interactions, connections, and dissolves configured successfully!\";\n})()\n","description":"Add all required interactive prototype connections between screens (Splash auto-advances, menu cards click, bottom navigation tabs, back buttons, and order checkout flows with dissolves).","fileKey":"pNVsMbFlqHuHgCQFsjUPkH"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":79785,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"494b4549-32cd-4fcc-b024-fd0ae7aff445","uuid":"326d6572-5c7f-4f68-89c5-9ddf3170cd5f","timestamp":"2026-10-28T19:56:49.701Z","tool_use_meta":[{"id":"call_a127d4098ce0458593ed4a0ab0c0b372","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
