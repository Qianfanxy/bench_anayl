e=\"07_Confirm_Purchase\" x=\"24\" y=\"24\" width=\"191\" height=\"26\" />\n          <text id=\"4:58\" name=\"Goal: Confirm or cancel the purchase.\" x=\"24\" y=\"60\" width=\"596\" height=\"20\" />\n          <text id=\"4:59\" name=\"MUST INCLUDE\" x=\"24\" y=\"90\" width=\"84\" height=\"16\" />\n          <text id=\"4:60\" name=\"• Actions: “Cancel” · “Buy” • Copy: “Are you sure?” • Presentation: dialog over 06_Stock_Transaction\" x=\"24\" y=\"116\" width=\"596\" height=\"60\" />\n          <text id=\"4:61\" name=\"LINKS\" x=\"24\" y=\"186\" width=\"33\" height=\"16\" />\n          <text id=\"4:62\" name=\"→ Cancel → 06_Stock_Transaction → Buy (entry only — the purchase result is not part of this task)\" x=\"24\" y=\"212\" width=\"596\" height=\"40\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"4:63\" name=\"Navigation structure\" x=\"64\" y=\"2065\" width=\"1312\" height=\"183\">\n      <text id=\"4:64\" name=\"Navigation structure\" x=\"0\" y=\"0\" width=\"242\" height=\"35\" />\n      <text id=\"4:65\" name=\"• Bottom tab bar on 01 and 04–06 with 5 tabs in this order: Main (Icon_Main), Payments (Icon_Payments), Cashback (Icon_Cashback), Invest (Icon_Invest), More (Icon_More). Current: Main on 01; Invest on 04–06. How the current tab looks is yours. 02, 03 and 07 have no tab bar. • First-time Invest flow: 01_Home → Invest tab → 02_About_Investment → start → 03_Create_PIN → Ready → 04_Portfolio. • Buying: 04 → AAPL → 05_Trading → Buy → 06_Stock_Transaction → Buy → 07_Confirm_Purchase (dialog over 06). • Entry only (no frame): My card, Transfer, Mobile, history search and rows, card pager, Payments / Cashback / More tabs, other cases, Sell, periods, menu, chart, insights, EUR account, Buy on 07.\" x=\"0\" y=\"51\" width=\"1312\" height=\"132\" />\n    </frame>\n    <frame id=\"4:66\" name=\"Fixed data &amp; copy\" x=\"64\" y=\"2296\" width=\"1312\" height=\"588\">\n      <text id=\"4:67\" name=\"Fixed data &amp; copy\" x=\"0\" y=\"0\" width