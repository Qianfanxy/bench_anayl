const r1l=T(\"Order\",13,\"Regular\",C.gray); f.appendChild(r1l); r1l.x=16; r1l.y=112;\n  const r1r=T(\"₹7,000\",13,\"Medium\",C.ink); f.appendChild(r1r); r1r.x=359-r1r.width; r1r.y=112;\n  const r2l=T(\"Shipping\",13,\"Regular\",C.gray); f.appendChild(r2l); r2l.x=16; r2l.y=138;\n  const r2r=T(\"₹30\",13,\"Medium\",C.ink); f.appendChild(r2r); r2r.x=359-r2r.width; r2r.y=138;\n  const line=R(343,1,C.border,0); f.appendChild(line); line.x=16; line.y=166;\n  const r3l=T(\"Total\",14,\"SemiBold\",C.ink); f.appendChild(r3l); r3l.x=16; r3l.y=178;\n  const r3r=T(\"₹7,030\",14,\"Bold\",C.ink); f.appendChild(r3r); r3r.x=359-r3r.width; r3r.y=178;\n}\n// payment methods\n{\n  const pt=T(\"Payment\",15,\"SemiBold\",C.ink); f.appendChild(pt); pt.x=16; pt.y=224;\n  const methods=[[\"VISA\",\"3:215\",true],[\"PayPal\",\"3:218\",false],[\"Maestro\",\"3:221\",false],[\"Apple Pay\",\"4:17\",false]];\n  let y=256;\n  for (const [name,logoId,sel] of methods){\n    const row=R(343,56,sel?{r:255/255,g:240/255,b:242/255}:C.white,10); row.strokes=[{type:\"SOLID\",color:sel?C.primary:C.border}]; row.strokeWeight=sel?1.5:1; f.appendChild(row); row.x=16; row.y=y; row.name=\"Pay_\"+name.replace(\" \",\"\");\n    const lg=await inst(logoId,32,32); f.appendChild(lg); lg.x=32; lg.y=y+12;\n    const nm=T(name,13,\"SemiBold\",C.ink); f.appendChild(nm); nm.x=76; nm.y=y+20;\n    const num=T(\"*********2109\",11,\"Regular\",C.gray); f.appendChild(num); num.x=200; num.y=y+22;\n    const radio=R(20,20,C.white,10); radio.strokes=[{type:\"SOLID\",color:sel?C.primary:C.border}]; radio.strokeWeight=sel?5:1.5; f.appendChild(radio); radio.x=323; radio.y=y+18;\n    y+=68;\n  }\n}\n// Continue button\nconst btn=await inst(\"2:24\"); f.appendChild(btn); btn.x=29; btn.y=560; btn.name=\"ContinueBtn\";\nconst lbl=btn.findOne(n=>n.type===\"TEXT\"); lbl.characters=\"Continue\";\nconst sb=await inst(\"2:34\",375,44); f.appendChild(sb); sb.x=0; sb.y=0;\nconst hi=await inst(\"2:45\",375,34); f.appendChild(hi); hi.x=0; hi.y=778;\nreturn \"13 done\";","description":"Build 13_Payment"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"14b42764-d761-4609-9d48-7eed784bda72","uuid":"934d340a-8f03-484e-b1dc-0cefb2e6d691","timestamp":"2026-10-31T00:29:35.449Z","tool_use_meta":[{"id":"mcp__figma__use_figma_43_ee66df6a","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
