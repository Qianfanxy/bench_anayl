ionFrame.id,\n        navigation: \"NAVIGATE\",\n        transition: null\n      }],\n      trigger: { type: \"ON_CLICK\" }\n    }];\n  }\n\n  function wireTabBar(screenFrame, currentTabName) {\n    if (!screenFrame) return;\n    const shopTab = findNodeByName(screenFrame, \"TabItem_Shop\");\n    const exploreTab = findNodeByName(screenFrame, \"TabItem_Explore\");\n    const cartTab = findNodeByName(screenFrame, \"TabItem_Cart\");\n    const accountTab = findNodeByName(screenFrame, \"TabItem_Account\");\n\n    if (currentTabName !== \"Shop\") setTapReaction(shopTab, f05);\n    if (currentTabName !== \"Explore\") setTapReaction(exploreTab, f07);\n    if (currentTabName !== \"Cart\") setTapReaction(cartTab, f09);\n    if (currentTabName !== \"Account\") setTapReaction(accountTab, f12);\n  }\n\n  // 1. Onboarding flow\n  setTapReaction(f01, f02);\n\n  const getStartedBtn = findNodeByName(f02, \"Button\");\n  setTapReaction(getStartedBtn, f03);\n\n  const phoneInput = findNodeByName(f03, \"PhoneInput\");\n  setTapReaction(phoneInput, f04);\n\n  const back04 = findNodeByName(f04, \"BackBtn\");\n  setTapReaction(back04, f03);\n\n  const nextFab = findNodeByName(f04, \"NextFAB\");\n  setTapReaction(nextFab, f05);\n\n  // 2. 05_Home links\n  wireTabBar(f05, \"Shop\");\n  const redAppleCard = findNodeByName(f05, \"ProductCard_Red Apple\");\n  setTapReaction(redAppleCard, f06);\n\n  // 3. 06_Product_Detail links\n  const back06 = findNodeByName(f06, \"BackBtn\");\n  setTapReaction(back06, f05);\n  const addToBasketBtn = findNodeByName(f06, \"Button\");\n  setTapReaction(addToBasketBtn, f09);\n\n  // 4. 07_Explore links\n  wireTabBar(f07, \"Explore\");\n  const bevCatCard = findNodeByName(f07, \"CategoryCard_Beverages\");\n  setTapReaction(bevCatCard, f08);\n\n  // 5. 08_Beverages links\n  const back08 = findNodeByName(f08, \"BackBtn\");\n  setTapReaction(back08, f07);\n\n  // 6. 09_My_Cart links\n  wireTabBar(f09, \"Cart\");\n  const checkoutBtn = findNodeByName(f09, \"GoToCh