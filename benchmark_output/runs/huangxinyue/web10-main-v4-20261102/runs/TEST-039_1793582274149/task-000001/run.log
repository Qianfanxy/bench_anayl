→ gap 64. OK as built earlier.\n\nNow Call H1 (fix widths) + H2 (prototype) — can combine into one call to save round trips. But if reactions throw uncaught → rollback of width fix too. Wrap ALL reaction sets in try/catch. Combine.\n\nCode plan:\n\n```js\nconst w1=await figma.getNodeByIdAsync(\"11:21\");\nw1.resize(1440,w1.height);\nconst w2=await figma.getNodeByIdAsync(\"12:81\");\nw2.resize(1440,w2.height);\nconst errors=[];\nfunction wire(node,dest,nav){\n  const actions=[[{trigger:{type:\"ON_CLICK\"},action:{type:\"NODE\",destinationId:dest,navigation:nav,transition:{type:\"INSTANT\"}}}],\n   [{trigger:{type:\"ON_CLICK\"},action:{type:\"NODE\",destinationId:dest,navigation:nav,transition:{type:\"DISSOLVE\",duration:0.2,easing:{type:\"EASE_OUT\"}}}}],\n   [{trigger:{type:\"ON_CLICK\"},action:{type:\"NODE\",destinationId:dest,navigation:nav}}]];\n  for(let i=0;i<actions.length;i++){\n    try{ node.reactions=actions[i]; return i; }catch(e){ errors.push(node.name+\":\"+e.message); }\n  }\n  return -1;\n}\n// 01_Work header\nconst h1=(await figma.getNodeByIdAsync(\"11:22\"));\nconst wnav=h1.findOne(n=>n.name===\"Nav/About\"&&n.type===\"INSTANCE\");\nwire(wnav,\"12:81\",\"NAVIGATE\");\nconst wknav=h1.findOne(n=>n.name===\"Nav/Work\"&&n.type===\"INSTANCE\");\nwire(wknav,\"11:21\",\"NAVIGATE\");\nconst logo1=h1.findOne(n=>n.name===\"Logo\");\nwire(logo1,\"11:21\",\"NAVIGATE\");\nconst cue=(await figma.getNodeByIdAsync(\"11:39\"));\nwire(cue,\"11:42\",\"SCROLL_TO\");\n// 02_About header\nconst h2=(await figma.getNodeByIdAsync(\"12:82\"));\nconst wnav2=h2.findOne(n=>n.name===\"Nav/Work\"&&n.type===\"INSTANCE\");\nwire(wnav2,\"11:21\",\"NAVIGATE\");\nconst anav2=h2.findOne(n=>n.name===\"Nav/About\"&&n.type===\"INSTANCE\");\nwire(anav2,\"12:81\",\"NAVIGATE\"); // self, harmless; brief doesn't require — maybe skip? It's fine to add self-link; keep? Brief lists only logo & Work for About. I'll wire About nav to 12:81 anyway? Extra self link is harmless but not required. Skip 