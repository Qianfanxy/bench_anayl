IXED'; c.counterAxisSizingMode='FIXED';\n  c.cornerRadius=26;\n  let bg,fg;\n  if(style==='Primary'){\n    bg = state==='Default'?S('#007A8C'):state==='Pressed'?S('#005F6E'):S('#D8DDE1');\n    fg = state==='Disabled'?'#8A9097':'#FFFFFF';\n  } else {\n    if(state==='Default'){bg=S('#FFFFFF');fg='#007A8C';}\n    else if(state==='Pressed'){bg=S('#E2EEF0');fg='#005F6E';}\n    else {bg=S('#FFFFFF',0.4);fg='#FFFFFF';}\n  }\n  c.fills=[bg];\n  c.appendChild(txt('Sign In',16,'Semi Bold',fg,{name:'Label'}));\n  return c;\n}\nconst btnVars=[];\nfor(const st of ['Primary','OnPhoto']) for(const s2 of ['Default','Pressed','Disabled']){\n  const b=button(st,s2); b.name=`Style=${st}, State=${s2}`; b.x=-2400; b.y=200+btnVars.length*70; page.appendChild(b); btnVars.push(b);\n}\nconst btnSet=figma.combineAsVariants(btnVars,page); btnSet.name='Button'; created.btnSet=btnSet.id;\n\n// ---- Text Field variants ----\nfunction field(state){\n  const c=figma.createComponent(); c.name='Text Field';\n  c.layoutMode='HORIZONTAL'; c.counterAxisAlignItems='CENTER';\n  c.resize(358,48); c.primaryAxisSizingMode='FIXED'; c.counterAxisSizingMode='FIXED';\n  c.paddingLeft=16; c.paddingRight=16; c.cornerRadius=12; c.fills=[S('#FFFFFF')];\n  if(state==='Focused'){c.strokes=[S('#007A8C')];c.strokeWeight=1.5;}\n  else if(state==='Error'){c.strokes=[S('#D92D20')];c.strokeWeight=1.5;}\n  else {c.strokes=[S('#E5E8EB')];c.strokeWeight=1;}\n  const isVal=(state==='Filled'||state==='Error');\n  c.appendChild(txt(isVal?'paul@travelin.app':'Email or Phone Number',15,'Regular',isVal?'#1A1A1F':'#8A9097',{name:'Value'}));\n  return c;\n}\nconst tfVars=[];\nfor(const s2 of ['Default','Focused','Filled','Error']){\n  const v=field(s2); v.name=`State=${s2}`; v.x=-2400; v.y=700+tfVars.length*70; page.appendChild(v); tfVars.push(v);\n}\nconst tfSet=figma.combineAsVariants(tfVars,page); tfSet.name='Text Field'; created.tfSet=tfSet.id;\n\n// ---- Language Selector variants ----\nconst chevComp=await figma.getNodeByIdAsync('3:12');\nfunction langSel(context){\n  const c=figma.createComponent(); c.name='Language Selector';\n  c.layoutMode='HORIZONTAL'; c.primaryAxisSizingMode='AUTO'; c.counterAxisSizingMode='AUTO';\n  c.counterAxisAlignItems='CENTER'; c.paddingLeft=16; c.paddingRight=12; c.paddingTop=8; c.paddingBottom=8;\n  c.itemSpacing=6; c.cornerRadius=20;\n  if(context==='OnPhoto'){c.fills=[S('#FFFFFF',0.22)];}\n  else {c.fills=[S('#FFFFFF')];c.strokes=[S('#E5E8EB')];c.strokeWeight=1;}\n  c.appendChild(txt('English',13,'Medium',context==='OnPhoto'?'#FFFFFF':'#1A1A1F',{name:'Label'}));\n  const ic=chevComp.createInstance(); ic.name='Icon';\n  if(context==='OnPhoto') recolor(ic,'#FFFFFF');\n  c.appendChild(ic);\n  return c;\n}\nconst lsVars=[];\nfor(const ctx of ['OnPhoto','OnSurface']){\n  const v=langSel(ctx); v.name=`Context=${ctx}`; v.x=-2400; v.y=1050+lsVars.length*70; page.appendChild(v); lsVars.push(v);\n}\nconst lsSet=figma.combineAsVariants(lsVars,page); lsSet.name='Language Selector'; created.lsSet=lsSet.id;\n\n// ---- Status Badge variants ----\nfunction badge(context){\n  const c=figma.createComponent(); c.name='Status Badge';\n  c.layoutMode='HORIZONTAL'; c.primaryAxisSizingMode='AUTO'; c.counterAxisSizingMode='AUTO';\n  c.counterAxisAlignItems='CENTER'; c.paddingLeft=12; c.paddingRight=12; c.paddingTop=6; c.paddingBottom=6;\n  c.itemSpacing=6; c.cornerRadius=999;\n  const dark=context==='OnDark';\n  c.fills=[dark?S('#FFFFFF',0.18):S('#DFF0F2')];\n  const dot=figma.createEllipse(); dot.resize(6,6); dot.fills=[S(dark?'#FFFFFF':'#007A8C')]; dot.name='Dot'; c.appendChild(dot);\n  c.appendChild(txt('Upcoming',11,'Semi Bold',dark?'#FFFFFF':'#007A8C',{name:'Label'}));\n  return c;\n}\nconst bdVars=[];\nfor(const ctx of ['OnSurface','OnDark']){\n  const v=badge(ctx); v.name=`Context=${ctx}`; v.x=-2400; v.y=1300+bdVars.length*70; page.appendChild(v); bdVars.push(v);\n}\nconst bdSet=figma.combineAsVariants(bdVars,page); bdSet.name='Status Badge'; created.bdSet=bdSet.id;\n\n// ---- Search Bar ----\nconst searchComp=await figma.getNodeByIdAsync('3:52');\nconst sb=figma.createComponent(); sb.name='Search Bar';\nsb.layoutMode='HORIZONTAL'; sb.counterAxisAlignItems='CENTER';\nsb.resize(358,44); sb.primaryAxisSizingMode='FIXED'; sb.counterAxisSizingMode='FIXED';\nsb.paddingLeft=14; sb.paddingRight=14; sb.itemSpacing=10; sb.cornerRadius=22;\nsb.fills=[S('#FFFFFF')]; sb.strokes=[S('#E5E8EB')]; sb.strokeWeight=1;\nconst si=searchComp.createInstance(); si.name='Icon_Search'; recolor(si,'#8A9097'); sb.appendChild(si);\nsb.appendChild(txt('Where to go?',15,'Regular','#8A9097',{name:'Placeholder'}));\npage.appendChild(sb); created.searchBar=sb.id;\n\n// ---- Section Header ----\nconst sh=figma.createComponent(); sh.name='Section Header';\nsh.layoutMode='HORIZONTAL'; sh.primaryAxisAlignItems='SPACE_BETWEEN'; sh.counterAxisAlignItems='CENTER';\nsh.resize(358,26); sh.primaryAxisSizingMode='FIXED'; sh.counterAxisSizingMode='FIXED';\nsh.fills=[];\nsh.appendChild(txt('Section title',17,'Semi Bold','#1A1A1F',{name:'Title'}));\nsh.appendChild(txt('See all',13,'Medium','#007A8C',{name:'Action'}));\npage.appendChild(sh); created.sectionHeader=sh.id;\n\n// position sets in a column\nlet y=200;\nfor(const s of [btnSet,tfSet,lsSet,bdSet]){ s.x=-1350; s.y=y; y+=s.height+90; }\nsb.x=-1350; sb.y=y; sh.x=-1350; sh.y=y+80;\nconst out={created, btnVariants:btnSet.children.map(c=>({name:c.name,id:c.id})), tfVariants:tfSet.children.map(c=>({name:c.name,id:c.id})), lsVariants:lsSet.children.map(c=>({name:c.name,id:c.id})), bdVariants:bdSet.children.map(c=>({name:c.name,id:c.id}))};\nconsole.log(JSON.stringify(out));\nreturn JSON.stringify(out).slice(0,3500);","description":"Create base components in 03 · Workspace: Button set, Text Field set, Language Selector set, Status Badge set, Search Bar, Section Header","fileKey":"6RTx8rpD2yiaw6vhUevCSO"}}],"id":"bf78836d-5e65-4737-9051-5423b7a92246","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6b901ff1-9fdc-48e6-8bc5-70d16984c7d4","uuid":"c227d529-457c-4cb8-b9fb-259f90064785","timestamp":"2026-10-31T20:27:24.472Z","tool_use_meta":[{"id":"call_2b7aa3fc052a4b9a85b86ba6","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
