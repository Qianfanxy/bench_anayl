or(i,t);return i;};\nconst DS=await figma.getNodeByIdAsync('8:2');\nconst C=(set,variant)=>{const s=DS.findOne(n=>(n.type==='COMPONENT_SET'||n.type==='COMPONENT')&&n.name===set);return (variant?s.children.find(c=>c.name===variant):s).createInstance();};\nconst T=(inst,layer,val)=>{const t=inst.findOne(n=>n.name===layer&&n.type==='TEXT');t.characters=val;return t;};\nconst swapLogo=(inst,name)=>{inst.findOne(n=>n.name==='Logo').children[0].swapComponent(M[name]);};\nconst screen=(name,x,h)=>{const f=figma.createFrame();f.name=name;f.x=x;f.y=0;f.resize(375,h||812);al(f,'VERTICAL',0,[0,0,0,0],'MIN','MIN');f.counterAxisSizingMode='FIXED';f.primaryAxisSizingMode=h?'FIXED':'AUTO';fill(f,'bg/base');f.clipsContent=true;return f;};\nconst addFill=(p,c)=>{p.appendChild(c);c.layoutSizingHorizontal='FILL';return c;};\nconst bottomNav=(cur)=>{const b=fr('Bottom Navigation','VERTICAL',0);fill(b,'bg/surface');const tb=C('Tab Bar','Current='+cur);tb.name='Tab Bar';b.appendChild(tb);const hi=B['Home Indicator'].createInstance();b.appendChild(hi);return b;};\nconst f=screen('01_Aktivitas',0);\nf.appendChild(B['Status Bar'].createInstance());\nconst h=C('Header','Type=Main');T(h,'Title','Aktivitas');addFill(f,h);\nconst body=fr('Content','VERTICAL',28,[8,20,28,20],'MIN','MIN');addFill(f,body);\nconst bc=C('Balance Card');addFill(body,bc);\nconst tr=fr('Trending Hari ini','VERTICAL',12,[0,0,0,0],'MIN','MIN');addFill(body,tr);\nconst sh=C('Section Header');T(sh,'Title','Trending Hari ini');sh.findOne(n=>n.name==='Action').visible=false;addFill(tr,sh);\nconst cards=fr('Cards','HORIZONTAL',13,[0,0,0,0],'MIN','MIN');addFill(tr,cards);\nfor(const [tk,lg] of [['BRRI','Logo_BRRI'],['ARB','Logo_ARB'],['FSX','Logo_FSX']]){const c=C('Trending Card','Direction=Up');c.name='Trending Card/'+tk;T(c,'Ticker',tk);T(c,'Price','8.600');T(c,'Change','+50 (+0,58%)');swapLogo(c,lg);cards.appendChild(c);c.layoutGrow=1;}\nconst wl=fr('Watchlist Saya','VERTICAL',8,[0,0,0,0],'MIN','MIN');addFill(body,wl);\nconst whr=fr('Header Row','HORIZONTAL',8,[0,0,0,0],'MIN','CENTER');addFill(wl,whr);\nconst wh=C('Section Header');T(wh,'Title','Watchlist Saya');wh.findOne(n=>n.name==='Action').visible=false;whr.appendChild(wh);wh.layoutGrow=1;\nconst addB=fr('Add Watchlist','HORIZONTAL',0,[6,6,6,6],'CENTER','CENTER');addB.cornerRadius=999;fill(addB,'brand/tint');addB.appendChild(icon('Icon_Plus','gain/fg',20));whr.appendChild(addB);\nconst list=fr('List','VERTICAL',0,[4,16,4,16],'MIN','MIN');list.cornerRadius=16;fill(list,'bg/surface');addFill(wl,list);\nconst W=[['DHDI','PT Duatiga Pertama','8.600','+50 (+0,58%)','Up'],['AMRI','PT Atma Merapi','2.421','−121 (−4,76%)','Down'],['ODD','PT Okufo Dokuri','5.300','+31 (+0,59%)','Up'],['PYQ','PT Pimnas Yosque','3.867','−71 (−1,80%)','Down'],['DAN','PT Danang Amin','6.600','−201 (−2,96%)','Down']];\nW.forEach(([tk,co,pr,chg,d],i)=>{const r=C('Watchlist Row','Direction='+d);r.name='Watchlist Row/'+tk;T(r,'Ticker',tk);T(r,'Company',co);T(r,'Price',pr);T(r,'Change',chg);swapLogo(r,'Logo_'+tk);if(i===W.length-1){r.strokeBottomWeight=0;}addFill(list,r);});\naddFill(f,bottomNav('Aktivitas'));\nreturn {id:f.id,h:f.height};","description":"Build 01_Aktivitas screen","fileKey":"YrTPLf9m7JWQ8bXXXJcUlA"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":855,"cache_read_input_tokens":67432,"cache_creation":{"ephemeral_5m_input_tokens":855,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"235036c5-5c0b-434d-bf2d-9b106a96a136","uuid":"8ce96322-d81b-437c-9560-8a66bad1780c","timestamp":"2026-10-31T20:50:15.386Z","tool_use_meta":[{"id":"toolu_bdrk_01NyjUqyT6Fy5f1j9gYTJGfN","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
