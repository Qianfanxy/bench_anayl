ls=[solid(hex)];if(n.children)for(const c of n.children)recolor(c,hex);}\nasync function ic(p,id,x,y,s,hex){const i=await inst(p,id,x,y,s,s);i.fills=[];recolor(i,hex);return i;}\nconst home=await figma.getNodeByIdAsync('13:10');\nconst lib=await figma.getNodeByIdAsync('16:15');\n\n// ---------- DISCOUNTS ----------\nlet y=3246;\nconst disc=frame(home,'Discounts',0,y,1920,520,C.cream,0,true);\ntxt(disc,'Eyebrow','SAVE TODAY',300,80,600,{size:12,weight:'Bold',color:C.primary,ls:2.4,lh:18});\ntxt(disc,'Heading','Daily discounts',300,102,900,{size:38,weight:'Bold',color:C.ink,lh:50});\ntxt(disc,'Sub','Deals that refresh every day — grab them while they last.',300,160,900,{size:16,color:C.ink2,lh:24});\nconst ddata=[['15%','Spring Salad','6 Days Remaining','2c9fdf0e1e12578ef1af7bca8e81b88651b2fb75'],\n['10%','Farfalle Salad','6 Days Remaining','45d0bf590ea203ba6d81e5a0067d843c6c7695dc'],\n['25%','Buddha Bowl','7 Days Remaining','5ba4898c5b709450f60397c8804b89d010d20d67'],\n['20%','Red Curry Soup','8 Days Remaining','39915d5d7b3e7ee141e1b04bf791f94b91227e06']];\nconst dc=lib.findOne(n=>n.name==='Discount Card');\nconst xs=[300,636,972,1308];\nfor(let i=0;i<4;i++){\n  const ii=dc.createInstance(); disc.appendChild(ii); ii.x=xs[i]; ii.y=222;\n  const pct=ii.findOne(n=>n.name==='Percent'); if(pct) pct.characters=ddata[i][0];\n  const dish=ii.findOne(n=>n.name==='Dish'); if(dish) dish.characters=ddata[i][1];\n  const days=ii.findOne(n=>n.name==='Days text'); if(days) days.characters=ddata[i][2];\n  const ph=ii.findOne(n=>n.name==='Photo');\n  if(ph && ph.children.length) ph.children[0].fills=[{type:'IMAGE',imageHash:ddata[i][3],scaleMode:'FILL'}];\n}\n\n// ---------- SEARCH BY FOOD ----------\ny+=520;\nconst sbf=frame(home,'Search by Food',0,y,1920,470,C.white,0,true);\ntxt(sbf,'Heading','Search by Food',300,84,700,{size:38,weight:'Bold',color:C.ink,lh:50});\nconst va=frame(sbf,'View All link',0,100,300,24,null,0,false); va.x=1460;\ntxt(va,'View All label','View All',0,0,110,{size:15,weight:'Bold',color:C.primary,lh:22});\nawait ic(va,'9:4',86,4,16,C.primary);\nconst pv=frame(sbf,'Previous button',1300,88,56,56,'#FFFFFF',28,true);\npv.strokes=[solid('#EDE3D7')];pv.strokeWeight=1;pv.strokeAlign='INSIDE';\nawait ic(pv,'9:3',16,16,24,C.ink);\nconst nx=frame(sbf,'Next button',1368,88,56,56,C.primary,28,true);\nawait ic(nx,'9:4',16,16,24,'#FFFFFF');\n// tiles\nconst cats=[['Pizza','e7935948aad40b3a73d3b385f0f1bb60c6976497'],\n['Burger','12c1f2720267a38e9ac2dc3d6d45d0753bb36afd'],\n['Noodles','251c970eb0281206c374b11033bc4e7793dff760'],\n['Sub-sandwich','2d7a1c01e518c1ab3179fc5710933d7be32f3219'],\n['Chowmein','42a6991f3ae86e47b2654abdf62997178080efbe'],\n['Steak','63e2586012b04acb1a1bf13d43ce9e6901ba28c1']];\nconst tileComp=lib.findOne(n=>n.name==='Category Tile · Pizza');\nconst cx=[300,556,812,1068,1324,1580];\nfor(let i=0;i<6;i++){\n  const ii=tileComp.createInstance(); sbf.appendChild(ii); ii.x=cx[i]; ii.y=196;\n  const lb=ii.findOne(n=>n.name==='Label'); if(lb) lb.characters=cats[i][0];\n  const cir=ii.findOne(n=>n.name==='Photo circle');\n  if(cir){ const img=cir.findOne(n=>n.type==='INSTANCE'&&n.name==='Photo'); if(img) img.fills=[{type:'IMAGE',imageHash:cats[i][1],scaleMode:'FILL'}]; }\n}\nreturn {disc:disc.id, sbf:sbf.id, nextY:y+470};\n","description":"Build Discounts and Search by Food sections","fileKey":"NE4meAES0ToaWiR2n9eVVf"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":96819,"input_tokens":1,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":96819}},"context_management":null},"parent_tool_use_id":null,"session_id":"c0f7ff31-013f-490f-95a5-726c8f36f404","uuid":"0e89095d-15cf-4ac8-b3b8-4f73d21e165e","timestamp":"2026-11-01T22:55:06.234Z","tool_use_meta":[{"id":"toolu_01FyEWieh9w1qtQN9w5h3jCH","display_name":"Use Figma","server_display_name":"figma-au