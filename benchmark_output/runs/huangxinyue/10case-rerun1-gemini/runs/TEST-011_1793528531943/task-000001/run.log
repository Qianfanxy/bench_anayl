\"DOGE\", price: \"$0.1012\", change: \"-0.17%\", logo: \"Coin_DOGE\", isPos: false },\n      { name: \"Cardano\", ticker: \"ADA\", price: \"$0.3196\", change: \"+0.09%\", logo: \"Coin_ADA\", isPos: true },\n      { name: \"Polygon\", ticker: \"MATIC\", price: \"$0.9082\", change: \"+2.18%\", logo: \"Coin_MATIC\", isPos: true }\n    ];\n\n    let coinY = 860;\n    coinListData.forEach(coin => {\n      const row = figma.createFrame();\n      row.name = \"Coin_Row_\" + coin.ticker;\n      row.x = 16;\n      row.y = coinY;\n      row.resize(343, 44);\n      row.fills = [];\n      frame.appendChild(row);\n\n      const logoComp = figma.root.findOne(n => n.name === coin.logo && n.type === 'COMPONENT');\n      if (logoComp) {\n        const logoInst = logoComp.createInstance();\n        logoInst.x = 0;\n        logoInst.y = 2;\n        logoInst.resize(40, 40);\n        row.appendChild(logoInst);\n      }\n\n      const nameTxt = figma.createText();\n      nameTxt.characters = coin.name;\n      nameTxt.fontName = { family: \"Nunito\", style: \"Bold\" };\n      nameTxt.fontSize = 15;\n      nameTxt.x = 52;\n      nameTxt.y = 2;\n      nameTxt.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n      row.appendChild(nameTxt);\n\n      const tickerTxt = figma.createText();\n      tickerTxt.characters = coin.ticker;\n      tickerTxt.fontName = { family: \"Nunito\", style: \"Medium\" };\n      tickerTxt.fontSize = 12;\n      tickerTxt.x = 52;\n      tickerTxt.y = 24;\n      tickerTxt.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.56 } }];\n      row.appendChild(tickerTxt);\n\n      const priceTxt = figma.createText();\n      priceTxt.characters = coin.price;\n      priceTxt.fontName = { family: \"Nunito\", style: \"Bold\" };\n      priceTxt.fontSize = 15;\n      priceTxt.x = 343 - 120;\n      priceTxt.y = 2;\n      priceTxt.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n      priceTxt.textAlignHorizontal = \"RIGHT\";\n      priceTxt.resize(120, 18);\n      row.appendChild(priceTxt);\n\n      const changeTxt = figma.createText();\n      changeTxt.characters = coin.change;\n      changeTxt.fontName = { family: \"Nunito\", style: \"Bold\" };\n      changeTxt.fontSize = 12;\n      changeTxt.x = 343 - 100;\n      changeTxt.y = 24;\n      changeTxt.fills = [{ type: 'SOLID', color: coin.isPos ? { r: 0.18, g: 0.72, b: 0.45 } : { r: 0.92, g: 0.26, b: 0.26 } }];\n      changeTxt.textAlignHorizontal = \"RIGHT\";\n      changeTxt.resize(100, 16);\n      row.appendChild(changeTxt);\n\n      coinY += 48;\n    });\n\n    // Main Navigation Bar at bottom of screen\n    // Note: since 02_Discovery is taller (1400), we should put navigation bar fixed at bottom?\n    // Actually, design rules say: \"01_Wallet, 02_Discovery and 03_Strategy may scroll vertically.\"\n    // To mimic true mobile experience, the Navigation Bar can be positioned at 812 - 34 - 60, but since Figma frames render fully, we'll place it at the absolute bottom of the frame (1400 - 34 - 60) so it's always accessible if scrolling, or just place it at the visible viewport of a 375x812 design.\n    // Wait, let's look at standard practice: we should size the container frame to 812 height, and make a scrolling group inside, OR keep the outer frame 1400 height and put the tab bar at the bottom.\n    // Let's size the outer frame to 812 height, set scrolling on the content group! Yes! That's exactly how high-quality designs do it.\n    // Let's rewrite the frame structure so that the outer frame is 375x812, and it contains:\n    // 1. Status Bar (fixed top)\n    // 2. Nav Bar (fixed bottom)\n    // 3. Scrollable Content (from Y=44 to Y=812-94)\n  };\n  \n  await createDiscoveryFrame();\n  return \"02_Discovery created\";\n})();","description":"Create 02_Discovery frame.","fileKey":"EctuBlB5drFNCeGwWM7KyI"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":37687,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_manageme