);\n  goldRow.name = \"Current_Plan_Gold\";\n  goldRow.resize(354, 76);\n  goldRow.x = 30;\n  goldRow.y = 234;\n  goldRow.cornerRadius = 16;\n  goldRow.fills = [{ type: \"SOLID\", color: { r: 255/255, g: 249/255, b: 235/255 } }];\n  sheet.appendChild(goldRow);\n\n  drawCoin(goldRow, 16, 14, \"Gold_Small\", \"G\", { r: 254/255, g: 236/255, b: 198/255 }, { r: 217/255, g: 151/255, b: 17/255 });\n\n  const goldRowName = figma.createText();\n  goldRowName.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  goldRowName.fontSize = 16;\n  goldRowName.characters = \"Gold\";\n  goldRowName.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  goldRowName.x = 76;\n  goldRowName.y = 16;\n  goldRow.appendChild(goldRowName);\n\n  const goldRowRet = figma.createText();\n  goldRowRet.fontName = { family: \"Inter\", style: \"Medium\" };\n  goldRowRet.fontSize = 13;\n  goldRowRet.characters = \"30% return\";\n  goldRowRet.fills = [{ type: \"SOLID\", color: primaryColor }];\n  goldRowRet.x = 76;\n  goldRowRet.y = 40;\n  goldRow.appendChild(goldRowRet);\n\n  const chevClone = iconChevron ? iconChevron.clone() : null;\n  if (chevClone) {\n    chevClone.x = 314;\n    chevClone.y = 30;\n    // Rotate to point right\n    chevClone.rotation = -90;\n    chevClone.x = 314;\n    chevClone.y = 44;\n    recolorNode(chevClone, textGreyColor);\n    goldRow.appendChild(chevClone);\n  }\n\n  // History Section\n  const histTitle = figma.createText();\n  histTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  histTitle.fontSize = 18;\n  histTitle.characters = \"History\";\n  histTitle.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  histTitle.x = 30;\n  histTitle.y = 334;\n  sheet.appendChild(histTitle);\n\n  // Transactions: 4 items (dated Mon 22 Jun 2020)\n  function createHistoryItem(y, type, stock, amtText, isInflow) {\n    const item = figma.createFrame();\n    item.name = \"History_Item_\" + type + \"_\" + stock;\n    item.resize(354, 56);\n    item.x = 30;\n    item.y = y;\n    item.fills = [];\n    sheet.appendChild(item);\n\n    const title = figma.createText();\n    title.fontName = { family: \"DM Sans\", style: \"Bold\" };\n    title.fontSize = 15;\n    title.characters = (type === \"Buy\" ? \"Buy \" : \"Sell \") + \"\\\\\"\" + stock + \"\\\\\" Stock\";\n    title.fills = [{ type: \"SOLID\", color: textDarkColor }];\n    title.x = 0;\n    title.y = 6;\n    item.appendChild(title);\n\n    const date = figma.createText();\n    date.fontName = { family: \"Inter\", style: \"Regular\" };\n    date.fontSize = 12;\n    date.characters = \"Mon 22 Jun 2020\";\n    date.fills = [{ type: \"SOLID\", color: textGreyColor }];\n    date.x = 0;\n    date.y = 28;\n    item.appendChild(date);\n\n    const amt = figma.createText();\n    amt.fontName = { family: \"Inter\", style: \"Bold\" };\n    amt.fontSize = 15;\n    amt.characters = (isInflow ? \"+\" : \"-\") + amtText;\n    amt.fills = [{ type: \"SOLID\", color: isInflow ? primaryColor : textDarkColor }];\n    amt.textAlignHorizontal = \"RIGHT\";\n    amt.resize(150, 20);\n    amt.x = 204;\n    amt.y = 18;\n    item.appendChild(amt);\n\n    const line = figma.createLine();\n    line.resize(354, 0);\n    line.x = 30;\n    line.y = y + 54;\n    line.strokes = [{ type: \"SOLID\", color: dividerColor }];\n    line.strokeWeight = 1;\n    sheet.appendChild(line);\n  }\n\n  // 1. Buy AAPL Stock ₦200,000 (Buy = Money out)\n  createHistoryItem(366, \"Buy\", \"AAPL\", \"₦200,000\", false);\n  // 2. Sell TLKM Stock ₦150,000 (Sell = Money in)\n  createHistoryItem(422, \"Sell\", \"TLKM\", \"₦150,000\", true);\n  // 3. Buy FB Stock ₦1,000,240\n  createHistoryItem(478, \"Buy\", \"FB\", \"₦1,000,240\", false);\n  // 4. Sell AAPL Stock ₦1,000,240\n  createHistoryItem(534, \"Sell\", \"AAPL\", \"₦1,000,240\", true);\n\n\n  // ----------------------------------------------------\n  // 06_Notification\n  // ----------------------------------------------------\n  const notification = figma.createFrame();\n  notification.name = \"06_Notification\";\n  notification.resize(414, 932);\n  notification.x = 1000;\n  notification.y = 1100;\n  notification.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  workspacePage.appendChild(notification);\n  addShell(notification);\n\n  // Header\n  const notHeader = figma.createFrame();\n  notHeader.name = \"Header_Bar\";\n  notHeader.resize(414, 60);\n  notHeader.x = 0;\n  notHeader.y = 54;\n  notHeader.fills = [];\n  notification.appendChild(notHeader);\n\n  if (iconBack) {\n    const backClone = iconBack.clone();\n    backClone.x = 24;\n    backClone.y = 18;\n    recolorNode(backClone, textDarkColor);\n    notHeader.appendChild(backClone);\n  }\n\n  const notTitle = figma.createText();\n  notTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  notTitle.fontSize = 24;\n  notTitle.characters = \"Notification\";\n  notTitle.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  notTitle.x = 74;\n  notTitle.y = 14;\n  notHeader.appendChild(notTitle);\n\n  // Notification rows list\n  function createNotificationRow(y, message, timeText, iconBgColor) {\n    const row = figma.createFrame();\n    row.name = \"Notification_Row\";\n    row.resize(366, 80);\n    row.x = 24;\n    row.y = y;\n    row.fills = [];\n    notification.appendChild(row);\n\n    // Thumbnail/Icon rounded container\n    const thumb = figma.createFrame();\n    thumb.name = \"Thumb_Icon\";\n    thumb.resize(48, 48);\n    thumb.x = 0;\n    thumb.y = 10;\n    thumb.cornerRadius = 24;\n    thumb.fills = [{ type: \"SOLID\", color: iconBgColor }];\n    row.appendChild(thumb);\n\n    // Internal icon visual\n    const dot = figma.createEllipse();\n    dot.resize(12, 12);\n    dot.x = 18;\n    dot.y = 18;\n    dot.fills = [{ type: \"SOLID\", color: primaryColor }];\n    thumb.appendChild(dot);\n\n    // Message\n    const msg = figma.createText();\n    msg.fontName = { family: \"Inter\", style: \"Medium\" };\n    msg.fontSize = 14;\n    msg.lineHeight = { value: 20, unit: \"PIXELS\" };\n    msg.characters = message;\n    msg.fills = [{ type: \"SOLID\", color: textDarkColor }];\n    msg.resize(294, 40);\n    msg.x = 64;\n    msg.y = 10;\n    row.appendChild(msg);\n\n    // Time\n    const time = figma.createText();\n    time.fontName = { family: \"Inter\", style: \"Regular\" };\n    time.fontSize = 11;\n    time.characters = timeText;\n    time.fills = [{ type: \"SOLID\", color: textGreyColor }];\n    time.x = 64;\n    time.y = 52;\n    row.appendChild(time);\n\n    // Line separator\n    const line = figma.createLine();\n    line.resize(366, 0);\n    line.x = 24;\n    line.y = y + 80;\n    line.strokes = [{ type: \"SOLID\", color: dividerColor }];\n    line.strokeWeight = 1;\n    notification.appendChild(line);\n  }\n\n  // 1. Where do you see yourself in the next ages? (30 secs ago)\n  createNotificationRow(130, \"Where do you see yourself in the next ages?\", \"30 secs ago\", { r: 255/255, g: 249/255, b: 235/255 });\n  // 2. Check out today's best investor. You'll learn from him. (3 min ago)\n  createNotificationRow(220, \"Check out today's best investor. You'll learn from him.\", \"3 min ago\", { r: 240/255, g: 248/255, b: 243/255 });\n  // 3. Apple stocks just increased. Check it out now. (15 min ago)\n  createNotificationRow(310, \"Apple stocks just increased. Check it out now.\", \"15 min ago\", { r: 245/255, g: 247/255, b: 248/255 });\n\n  console.log(\"Home, Asset Overlay, and Notification screens built successfully!\");\n}\n\nawait buildSecondScreens();\n`;\n\nawait figma.use_figma({\n  code: code,\n  description: \"Build 04_Home, 05_My_Asset_Overlay, and 06_Notification frames inside Workspace.\",\n  fileKey: \"1Dyjg6o91wFpVkfahevN0Q\"\n});\n","description":"Build 04_Home, 05_My_Asset_Overlay, and 06_Notification screens in the workspace.","fileKey":"1Dyjg6o91wFpVkfahevN0Q"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":93034,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_to