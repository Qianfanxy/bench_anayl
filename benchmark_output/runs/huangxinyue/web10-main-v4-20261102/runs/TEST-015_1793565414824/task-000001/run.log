++){const t=thD.createInstance();t.name='Thumb · Photo_Modern_House_'+(i+1);setP(t,'Photo',ID.MH[i]);t.layoutGrow=1;tr2.appendChild(t);}\ngl.appendChild(tr2);\ns=await section('Gallery','Photo_Modern_House_Main + thumbnails 1–7 (Gallery Thumbnail instances). Selected: none.');s.appendChild(gl);R.gallery=gl.id;\n\n// Details Strip\nconst ds=comp('Details Strip','VERTICAL',{gap:24});fixW(ds,760);\nds.appendChild(await txt('Details','H3','ink'));\nconst st=af('Strip','HORIZONTAL',{pad:[24,28],r:16,main:'SPACE_BETWEEN',align:'CENTER'});st.layoutAlign='STRETCH';st.primaryAxisSizingMode='FIXED';await fill(st,'surf');await stroke(st,'line');\nfor(const [id,v] of [[ID.bed,'4 Bedrooms'],[ID.bath,'2 Bathrooms'],[ID.garage,'2 Garage'],[ID.floors,'1 Floor'],[ID.cal,'Built 2007']]){const i=di.createInstance();i.name='Detail · '+v;setP(i,'Value',v);setP(i,'Icon',id);st.appendChild(i);}\nds.appendChild(st);\ns=await section('Details Strip','Details · 4 Bedrooms · 2 Bathrooms · 2 Garage · 1 Floor · Built 2007.');s.appendChild(ds);R.details=ds.id;\n\n// Feature List\nconst fl=comp('Feature List','VERTICAL',{gap:24});fixW(fl,760);\nfl.appendChild(await txt('Features','H3','ink'));\nconst grid=af('Grid','HORIZONTAL',{gap:24});grid.layoutAlign='STRETCH';grid.primaryAxisSizingMode='FIXED';grid.layoutWrap='WRAP';grid.counterAxisSpacing=20;\nfor(const f of ['Air conditioning','Central heating','Hardwood floors','Open-plan kitchen','Kitchen island','Dishwasher','Laundry room','Walk-in closet','En-suite bathroom','Private garden','Patio','Double garage','Security system','Solar panels','Storage room']){const i=fi.createInstance();i.name='Feature · '+f;setP(i,'Label',f);i.primaryAxisSizingMode='FIXED';i.resize(237,i.height);grid.appendChild(i);}\nfl.appendChild(grid);\ns=await section('Feature List','15 features with Icon_Check, 3-column grid.');s.appendChild(fl);R.features=fl.id;\nreturn R;","description":"Build composite section components","fileKey":"3KZ3B4yH0x44BL8SAdaRYB"}}],"container"