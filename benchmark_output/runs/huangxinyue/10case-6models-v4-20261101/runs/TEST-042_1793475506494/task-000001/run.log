ne1.fills = [{ type: 'SOLID', color: COLOR_BORDER }];\n  dividerRow.appendChild(line1);\n\n  const divText = figma.createText();\n  divText.fontName = { family: 'Inter', style: 'Regular' };\n  divText.fontSize = 13;\n  divText.characters = 'or sign in with';\n  divText.fills = [{ type: 'SOLID', color: COLOR_GRAY_TEXT }];\n  dividerRow.appendChild(divText);\n\n  const line2 = figma.createRectangle();\n  line2.resize(120, 1);\n  line2.fills = [{ type: 'SOLID', color: COLOR_BORDER }];\n  dividerRow.appendChild(line2);\n\n  formCard.appendChild(dividerRow);\n\n  // Social sign-in buttons: Apple (Icon_Apple) · Facebook (Icon_Facebook) · Google (Icon_Google)\n  const socialRow = figma.createFrame();\n  socialRow.layoutMode = 'HORIZONTAL';\n  socialRow.primaryAxisAlignItems = 'CENTER';\n  socialRow.itemSpacing = 20;\n  socialRow.fills = [];\n  socialRow.resize(382, 56);\n\n  function createSocialBtn(iconMaster, name) {\n    const sb = figma.createFrame();\n    sb.name = name;\n    sb.resize(64, 56);\n    sb.cornerRadius = 16;\n    sb.fills = [{ type: 'SOLID', color: COLOR_LIGHT_BG }];\n    sb.strokes = [{ type: 'SOLID', color: COLOR_BORDER }];\n    sb.strokeWeight = 1;\n    sb.layoutMode = 'HORIZONTAL';\n    sb.primaryAxisAlignItems = 'CENTER';\n    sb.counterAxisAlignItems = 'CENTER';\n\n    const iconInst = iconMaster.createInstance();\n    iconInst.resize(28, 28);\n    sb.appendChild(iconInst);\n    return sb;\n  }\n\n  socialRow.appendChild(createSocialBtn(masterIconGoogle, 'Social_Google'));\n  socialRow.appendChild(createSocialBtn(masterIconApple, 'Social_Apple'));\n  socialRow.appendChild(createSocialBtn(masterIconFacebook, 'Social_Facebook'));\n\n  formCard.appendChild(socialRow);\n\n  // Bottom signup prompt: “Don’t have an account?” · “Sign Up”\n  const signUpRow = figma.createFrame();\n  signUpRow.layoutMode = 'HORIZONTAL';\n  signUpRow.primaryAxisAlignItems = 'CENTER';\n  signUpRow.counterAxisAlignItems = 'CENTER';\n  signUpRow.itemSpacing = 6;\n  signUpRow.fil