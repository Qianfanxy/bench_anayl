nction(n){return n.type==='INSTANCE'&&n.name==='Site / Footer';})[0];\nif(ni){ni.y=RY+560;}\nif(fi){fi.y=RY+980;}\nrec.resize(1440,RY+1280);\nreturn {rows:info,sauceY:sauce?Math.round(sauce.y):null,dirY:dirFrame?Math.round(dirFrame.y):null,recH:rec.height};\n","description":"Reflow recipe ingredient rows","fileKey":"KBfh4lzngcd72ozCVtDt2c"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":1466,"input_tokens":55,"cache_read_input_tokens":350410,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1466}},"context_management":null},"parent_tool_use_id":null,"session_id":"4a1094b8-95cb-47b4-aa0a-0df7e190b320","uuid":"5be21015-dcce-44da-993a-810d2176b6c4","timestamp":"2026-11-03T07:50:20.415Z","tool_use_meta":[{"id":"toolu_01UISolQet51MoIjlXqKgOKi","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
