 = 16;\n\n  const leftH5 = figma.createFrame();\n  leftH5.fills = [];\n  leftH5.layoutMode = \"HORIZONTAL\";\n  leftH5.itemSpacing = 12;\n  leftH5.counterAxisAlignItems = \"CENTER\";\n\n  const backIcon = getInstance(\"2:52\");\n  if (backIcon) leftH5.appendChild(backIcon);\n\n  const h5Title = figma.createText();\n  h5Title.fontName = { family: \"Roboto\", style: \"Bold\" };\n  h5Title.characters = \"Top Up\";\n  h5Title.fontSize = 20;\n  h5Title.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n  leftH5.appendChild(h5Title);\n  h5.appendChild(leftH5);\n\n  const helpIcon = getInstance(\"2:65\");\n  if (helpIcon) h5.appendChild(helpIcon);\n\n  f5.appendChild(h5);\n\n  // Content Scroll Container\n  const scroll5 = figma.createFrame();\n  scroll5.name = \"Content Scroll\";\n  scroll5.resize(375, 812 - 44 - 56 - 64);\n  scroll5.x = 0; scroll5.y = 100;\n  scroll5.fills = [];\n  scroll5.layoutMode = \"VERTICAL\";\n  scroll5.itemSpacing = 18;\n  scroll5.paddingLeft = 16; scroll5.paddingRight = 16; scroll5.paddingBottom = 20;\n\n  // Steps indicator: Steps: 1 Masukkan Nominal · 2 Pembayaran · current: step 1\n  const stepsBar = figma.createFrame();\n  stepsBar.name = \"Steps Indicator\";\n  stepsBar.resize(343, 32);\n  stepsBar.fills = [];\n  stepsBar.layoutMode = \"HORIZONTAL\";\n  stepsBar.itemSpacing = 12;\n  stepsBar.counterAxisAlignItems = \"CENTER\";\n\n  // Step 1\n  const s1 = figma.createFrame();\n  s1.name = \"Step_1\";\n  s1.fills = [];\n  s1.layoutMode = \"HORIZONTAL\";\n  s1.itemSpacing = 6;\n  s1.counterAxisAlignItems = \"CENTER\";\n\n  const s1Circle = figma.createEllipse();\n  s1Circle.resize(20, 20);\n  s1Circle.fills = [{ type: 'SOLID', color: GREEN_GAIN }];\n  // We can add step number inside or adjacent\n  const s1Txt = figma.createText();\n  s1Txt.fontName = { family: \"Roboto\", style: \"Bold\" };\n  s1Txt.characters = \"1 Masukkan Nominal\";\n  s1Txt.fontSize = 13;\n  s1Txt.fills = [{ type: 'SOLID', color: GREEN_GAIN }];\n  s1.appendChild(s1Txt);\n 