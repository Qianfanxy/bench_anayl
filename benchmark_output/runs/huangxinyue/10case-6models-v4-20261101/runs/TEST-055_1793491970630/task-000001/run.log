nk); rTitle.x=72; rTitle.y=13; row.appendChild(rTitle);\nconst rDate = txt('15 Aug 2020', 12, 'Regular', C.gray); rDate.x=72; rDate.y=35; row.appendChild(rDate);\nconst rAmt = txt('−$243.00', 15, 'Semi Bold', C.ink);\nrAmt.textAlignHorizontal='RIGHT'; rAmt.resize(110, rAmt.height); rAmt.x=343-16-110; rAmt.y=13; row.appendChild(rAmt);\nrow.x = 2600; row.y = 0;\n\n// ---------- Payment Card (Visa coral) ----------\nconst card = figma.createComponent();\ncard.name = 'Expenio / Payment Card';\ncard.resize(343, 200); card.cornerRadius = 20; card.clipsContent = true;\ncard.fills = solid({r:0.85,g:0.4,b:0.35});\ncard.effects = [{type:'DROP_SHADOW', color:{r:0.9,g:0.45,b:0.4,a:0.35}, offset:{x:0,y:12}, radius:28, spread:0, visible:true, blendMode:'NORMAL'}];\nconst tex = await instOf('5:10', 345, 200); tex.x=-1; tex.y=0; card.appendChild(tex);\nconst bal = txt('BALANCE', 10, 'Medium', C.white); bal.opacity=0.75;\nbal.letterSpacing={unit:'PERCENT', value:12}; bal.x=20; bal.y=22; card.appendChild(bal);\nconst balV = txt('$25,520.00', 22, 'Bold', C.white); balV.x=20; balV.y=38; card.appendChild(balV);\nconst visa = await instOf('5:3', 62, 20); visa.x=343-20-62; visa.y=24; card.appendChild(visa);\nconst num = txt('4225 9765 0008 6141', 17, 'Medium', C.white);\nnum.letterSpacing={unit:'PERCENT', value:6}; num.x=20; num.y=112; card.appendChild(num);\nconst chL = txt('CARD HOLDER', 8, 'Medium', C.white); chL.opacity=0.7; chL.letterSpacing={unit:'PERCENT', value:10}; chL.x=20; chL.y=150; card.appendChild(chL);\nconst chN = txt('MARIA LOPEZ', 12, 'Semi Bold', C.white); chN.letterSpacing={unit:'PERCENT', value:4}; chN.x=20; chN.y=162; card.appendChild(chN);\nconst exL = txt('EXPIRY', 8, 'Medium', C.white); exL.opacity=0.7; exL.letterSpacing={unit:'PERCENT', value:10}; exL.x=272; exL.y=150; card.appendChild(exL);\nconst exV = txt('09/24', 12, 'Semi Bold', C.white); exV.x=272; exV.y=162; card.appendChild(exV);\ncard.x = 2600; card.y = 120;\n\n// ---------- Expenses Chart ----------\nco