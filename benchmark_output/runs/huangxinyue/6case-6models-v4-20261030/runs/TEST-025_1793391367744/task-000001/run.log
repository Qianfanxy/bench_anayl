ue); av.cornerRadius=20; const avI=inst(G.avatar,40,40); av.appendChild(avI); av.x=315; av.y=8; hb.appendChild(av);\nhb.x=-800; hb.y=0;\n```\nComponent-ify: `figma.createComponentFromNode(hb)` — converts frame to component. That's easiest: build frame then createComponentFromNode. \n\nSearch Bar:\n```js\nconst sb = FR(\"Search Bar\",375,56,null);\nconst field = FR(\"Field\",335,48,\"#F5F6FA\",true); field.cornerRadius=12; field.x=20; field.y=4; sb.appendChild(field);\nconst si = inst(G.iSearch,18,18); si.x=16; si.y=15; field.appendChild(si);\nconst ph = T(\"Search any Product..\",13,\"Regular\",\"#ABB7C2\"); ph.x=44; ph.y=16; field.appendChild(ph);\nconst vi = inst(G.iVoice,20,20); vi.x=335-36; vi.y=14; field.appendChild(vi);\n```\n\nSection Header:\n```js\nconst sh = FR(\"Section Header\",375,32,null);\nconst tt = T(\"Title\",18,\"SemiBold\",\"#1D1E20\"); tt.x=20; tt.y=2; sh.appendChild(tt);\nconst rl = T(\"View all\",12,\"Medium\",\"#8F959E\"); sh.appendChild(rl); rl.y=8; rl.x=335-rl.width; rl.constraints={horizontal:\"MAX\",vertical:\"CENTER\"};\n```\n\nChip (auto layout):\n```js\nconst ch = figma.createFrame(); ch.name=\"Chip\"; ch.layoutMode=\"HORIZONTAL\"; ch.primaryAxisSizingMode=\"AUTO\"; ch.counterAxisSizingMode=\"AUTO\"; ch.itemSpacing=6; ch.paddingLeft=12; ch.paddingRight=12; ch.paddingTop=8; ch.paddingBottom=8; ch.cornerRadius=8; ch.fills=[solid(\"#F5F6FA\")]; ch.counterAxisAlignItems=\"CENTER\";\nconst ci = inst(G.iSort? no — chip default icon: use iFilter 14); ...\n```\nChip children: icon instance 14×14 (will swap icon per instance by swapping? Swapping instance child inside instance: allowed via `childOfInstance.swapComponent(comp)`. Yes instances support swapComponent on nested instances). Label \"Sort\".\n\nOnboarding Progress:\n```js\nconst op = FR(\"Onboarding Progress\",375,40,null);\nconst bars = FR(\"bars\",136,4,null); bars.x=(375-136)/2; bars.y=0;\nbar rects 40×4 r2: b1 fill primary, b2 \"#F3F3F3\", b3 \"#F3F3F3\", x=0,48,96.\nconst cap = T(