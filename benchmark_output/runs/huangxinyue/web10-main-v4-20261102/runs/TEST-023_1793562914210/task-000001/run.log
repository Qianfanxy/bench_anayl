size(w,h);inst.x=x;inst.y=y;inst.fills=[{type:'IMAGE',scaleMode:'FILL',imageHash:src.fills[0].imageHash}];return inst;}\nasync function btn(parent,x,y,w,label,kind,h){const src=await figma.getNodeByIdAsync('1:24');const b=src.createInstance();parent.appendChild(b);b.resize(w,h||58);b.x=x;b.y=y;if(kind==='outline'){b.fills=fill(P.white);b.strokes=[{type:'SOLID',color:rgb('#D8D2C6'),opacity:1}];b.strokeWeight=1;b.strokeAlign='INSIDE';b.findOne(n=>n.type==='TEXT').fills=fill(P.ink);}const t=b.findOne(n=>n.type==='TEXT');t.characters=label;t.fontSize=14;return b;}\nasync function field(parent,y,label,ph){\n  const src=await figma.getNodeByIdAsync('29:1265');const i=src.createInstance();parent.appendChild(i);i.x=0;i.y=y;\n  i.children.find(n=>n.name==='Label').characters=label;\n  if(ph){const p=i.children.find(n=>n.name==='Placeholder'); if(p) p.characters=ph;}\n  return i;\n}\nasync function social(parent,y,label,imgHash){\n  const src=await figma.getNodeByIdAsync('29:1269'); const i=src.createInstance(); parent.appendChild(i); i.x=0; i.y=y;\n  i.children.find(n=>n.name==='Label').characters=label;\n  const g=i.children.find(n=>n.type==='INSTANCE');\n  if(g) g.fills=[{type:'IMAGE',scaleMode:'FIT',imageHash:imgHash}];\n  return i;\n}\nconst gmailSrc=await figma.getNodeByIdAsync('6:69');\nconst googleSrc=await figma.getNodeByIdAsync('6:23');\nconst gmailHash=gmailSrc.fills&&gmailSrc.fills[0]?gmailSrc.fills[0].imageHash:null;\nconst googleHash=googleSrc.fills&&googleSrc.fills[0]?googleSrc.fills[0].imageHash:null;\n\n// ============ 07_Sign_Up (1920x1080) ============\nconst su=comp(lib,'Auth / Sign Up Card',1920,1080,0,20000);\nconst sub=box(su,'Page',0,0,1920,1080,{fill:P.cream});\nconst mp=box(sub,'Media Panel',0,0,840,1080,{fill:P.sand,clip:true});\nawait photo(mp,'6:63',0,0,840,1080);\nconst scrim=box(mp,'Scrim',0,0,840,1080,'#0A0A0A'); scrim.opacity=0.28;\ntx(mp,'Wordmark',64,64,{t:'FASCO',f:'Volkhov',w:'Bold',s:34,ls:3,c:P.white});\ntx(mp,'Tagline',64,880,{t:'Wear it well.\\nWear it often.',f:'Volkhov',w:'Regular',s:34,c:P.white,width:600,lh:46});\ntx(mp,'Small',64,990,{t:'New season pieces, made to last.',s:13,c:'#E8E4DC'});\n// form column\nconst form=box(sub,'Form',1000,90,700,900,{});\ntx(form,'Title',0,0,{t:'Create Account',s:40,f:'Volkhov',w:'Bold',c:P.ink});\ntx(form,'Sub',0,56,{t:'Join FASCO for early access to new arrivals and member-only prices.',s:14,c:P.body,width:560});\nawait social(form,110,'Sign up with Google',googleHash);\nawait social(form,182,'Sign up with Email',gmailHash);\nconst orRow=box(form,'OR Row',0,262,560,20,{});\nbox(orRow,'L',0,9,236,1,{fill:'#DED9CF'});\nbox(orRow,'R',324,9,236,1,{fill:'#DED9CF'});\ntx(orRow,'OR',0,0,{t:'OR',s:11,w:'SemiBold',ls:2,c:P.muted}).x=268; orRow.children[2].y=2;\nconst fields=[['First Name','Jordan'],['Last Name','Lee'],['Email Address','you@example.com'],['Phone Number','+1 555 012 3456'],['Password','••••••••'],['Confirm Password','••••••••']];\nfor(let i=0;i<6;i++){\n  const col=i%2, row=Math.floor(i/2);\n  const f=await field(form,306+row*100,fields[i][0],fields[i][1]);\n  f.x=col*300; f.resize(260,84);\n  f.children.find(n=>n.name==='Input').resize(260,60);\n  f.children.find(n=>n.name==='Placeholder').x=14;\n}\nawait btn(form,0,604,272,'Create Account',null,58);\nawait btn(form,300,604,260,'Already have an account? Login','outline',58);\ntx(sub,'Terms',1000,0,{t:'FASCO Terms & Conditions',s:12,w:'Medium',c:P.body}); // reposition below\nconst terms=sub.children[sub.children.length-1]; terms.x=1000; terms.y=1000;\ntx(sub,'TermsCopy',1000,1020,{t:'By creating an account you agree to our FASCO Terms & Conditions and Privacy Policy.',s:11,c:P.muted,width:520});\nreturn {su:su.id};\n","description":"Build sign up card component","fileKey":"zj84fVMgzEUIcsaY8ScK7u"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":169215,"input_tokens":1,"cache_rea