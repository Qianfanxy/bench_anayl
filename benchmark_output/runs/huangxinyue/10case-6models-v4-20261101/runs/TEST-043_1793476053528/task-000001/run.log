re(findChildByName(f1, \"Button_Deposit\"), f4));\n  results.push(\"01 Trending tab: \" + wire(findChildByName(f1, \"Tab_Trending\"), f2));\n  results.push(\"01 Top Up tab: \" + wire(findChildByName(f1, \"Tab_Top Up\"), f4));\n\n  // Frame 02_Trending links:\n  // GOTO -> 03_Detail_Saham\n  // Aktivitas tab -> 01_Aktivitas\n  // Top Up tab -> 04_Top_Up_Metode\n  results.push(\"02 GOTO: \" + wire(findChildByName(f2, \"Row_GOTO\"), f3));\n  results.push(\"02 Aktivitas tab: \" + wire(findChildByName(f2, \"Tab_Aktivitas\"), f1));\n  results.push(\"02 Top Up tab: \" + wire(findChildByName(f2, \"Tab_Top Up\"), f4));\n\n  // Frame 03_Detail_Saham links:\n  // back -> 02_Trending\n  // Note: Icon_Back or Header back node\n  const f3Back = findChildByName(f3, \"Icon_Back\") || findChildByName(f3, \"Header\")?.children?.[0];\n  results.push(\"03 Back: \" + wire(f3Back, f2));\n\n  // Frame 04_Top_Up_Metode links:\n  // Alfamart -> 05_Top_Up_Nominal\n  // back -> 01_Aktivitas\n  const f4Back = findChildByName(f4, \"Icon_Back\") || findChildByName(f4, \"Header\")?.children?.[0];\n  results.push(\"04 Alfamart: \" + wire(findChildByName(f4, \"Method_Alfamart\"), f5));\n  results.push(\"04 Back: \" + wire(f4Back, f1));\n\n  // Frame 05_Top_Up_Nominal links:\n  // Bayar -> 06_Top_Up_Pembayaran\n  // back / Ganti -> 04_Top_Up_Metode\n  const f5Back = findChildByName(f5, \"Icon_Back\") || findChildByName(f5, \"Header\")?.children?.[0];\n  const f5Ganti = findChildByName(f5, \"Method Card\");\n  results.push(\"05 Bayar: \" + wire(findChildByName(f5, \"Button_Bayar\"), f6));\n  results.push(\"05 Back: \" + wire(f5Back, f4));\n  if (f5Ganti) results.push(\"05 Ganti: \" + wire(f5Ganti, f4));\n\n  // Frame 06_Top_Up_Pembayaran links:\n  // Oke -> 01_Aktivitas\n  results.push(\"06 Oke: \" + wire(findChildByName(f6, \"Button_Oke\"), f1));\n\n  return results;\n})()","description":"Wire prototype connections between screens according to navigation requirements","fileKey":"JFBzRSGrqYhoiYPN8CHL