eateInstance(); f.appendChild(s); s.x=0;s.y=0; const h=homeInd.createInstance(); f.appendChild(h); h.x=0; h.y=898;}\nfunction hdr(f,title){const h=header.createInstance(); setP(h,{Title:title}); h.name='Header'; add(f,h,0,48); return h;}\nfunction vstack(name,gap=0){const c=figma.createFrame(); c.name=name; c.layoutMode='VERTICAL'; c.itemSpacing=gap; c.fills=[]; return c;}\nfunction card(name){const c=vstack(name); c.fills=[P('surface/base')]; c.cornerRadius=20; c.strokes=[P('border/default')]; c.strokeWeight=1; c.clipsContent=true; return c;}\nconst divide=(rows)=>rows.forEach((r,i)=>{ if(i<rows.length-1){r.strokes=[P('border/default')]; r.strokeTopWeight=0;r.strokeLeftWeight=0;r.strokeRightWeight=0;r.strokeBottomWeight=1;}});\nconst out={};\n\n// 06 Notification\nconst s6=screen('06_Notification',3458); hdr(s6,'Notification');\nconst l6=vstack('Notifications',12); add(s6,l6,24,124);\nconst nots=[['Photo','Yes','Where do you see yourself in the next ages?','30 secs ago','5:70'],['Avatar','Yes','Check out today’s best investor. You’ll learn from him.','3 min ago',null],['Photo','No','Apple stocks just increased. Check it out now.','15 min ago','5:65']];\nfor(const [m,u,msg,time,img] of nots){const i=variant(nset,`Media=${m}, Unread=${u}`).createInstance(); setP(i,{Message:msg,Time:time}); if(img) i.findOne(n=>n.name==='Thumbnail').fills=[{type:'IMAGE',imageHash:await hash(img),scaleMode:'FILL'}]; i.name=msg; l6.appendChild(i);}\nl6.layoutSizingHorizontal='HUG'; l6.layoutSizingVertical='HUG';\nshell(s6); out.s6=s6.id;\n\n// 07 Profile\nconst s7=screen('07_Profile',3952);\nconst t7=await T('Profile','Heading/H1','text/primary'); add(s7,t7,24,64);\nconst pcard=figma.createFrame(); pcard.name='Account card'; pcard.layoutMode='HORIZONTAL'; pcard.itemSpacing=16; pcard.counterAxisAlignItems='CENTER'; pcard.paddingTop=pcard.paddingBottom=20; pcard.paddingLeft=pcard.paddingRight=20; pcard.fills=[P('surface/base')]; pcard.cornerRadius=24; pcard.strokes=[P('border/default')]; pcard.strokeWeight=1; add(s7,pcard,24,124);\nconst av7=avatar.createInstance(); av7.rescale(72/150); pcard.appendChild(av7);\nconst who=vstack('Identity',6); pcard.appendChild(who);\nwho.appendChild(await T('Jonas Macroni','Heading/H2','text/primary'));\nconst lvl=figma.createFrame(); lvl.name='Level'; lvl.layoutMode='HORIZONTAL'; lvl.itemSpacing=6; lvl.counterAxisAlignItems='CENTER'; lvl.paddingTop=lvl.paddingBottom=4; lvl.paddingLeft=10; lvl.paddingRight=12; lvl.cornerRadius=999; lvl.fills=[P('brand/primary-soft')];\nconst dot=figma.createEllipse(); dot.resize(6,6); dot.fills=[P('brand/primary')]; lvl.appendChild(dot); lvl.appendChild(await T('Expert','Label/Small','brand/primary')); who.appendChild(lvl);\nlvl.layoutSizingHorizontal='HUG'; lvl.layoutSizingVertical='HUG'; who.layoutSizingHorizontal='HUG'; who.layoutSizingVertical='HUG';\npcard.resize(366,10); pcard.primaryAxisSizingMode='FIXED'; pcard.counterAxisSizingMode='AUTO';\nconst g1=card('Account entries'); add(s7,g1,24,pcard.y+pcard.height+24);\nconst entries=[['Contact Info','6:281'],['Bank Account Info','6:283'],['Source of Funding Info','6:282'],['Document Info','6:284']];\nconst rows1=[]; for(const [l,ic] of entries){const r=menuRow.createInstance(); setP(r,{Label:l,Icon:ic}); r.name=l; r.cornerRadius=0; g1.appendChild(r); rows1.push(r);} divide(rows1);\ng1.layoutSizingHorizontal='HUG'; g1.layoutSizingVertical='HUG';\nconst g2=card('Settings entry'); add(s7,g2,24,g1.y+g1.height+16);\nconst r2=menuRow.createInstance(); setP(r2,{Label:'Settings',Icon:'6:285'}); r2.name='Settings'; r2.cornerRadius=0; g2.appendChild(r2); g2.layoutSizingHorizontal='HUG'; g2.layoutSizingVertical='HUG';\nfor(const r of [...rows1,r2]) for(const v of r.findOne(n=>n.name==='Icon Tile').findAll(x=>x.type==='VECTOR')) v.fills=[P('brand/primary')];\nconst tb=variant(tabBar,'Current=Account').createInstance(); tb.name='Tab Bar'; add(s7,tb,0,932-tb.height);\nshell(s7); out.s7=s7.id;\n\n// 08 Contact Info\nconst s8=screen('08_Contact_Info',4446); hdr(s8,'Contact info');\nconst avw=figma.createFrame(); avw.name='Avatar editor'; avw.resize(104,104); avw.fills=[]; avw.clipsContent=false; add(s8,avw,155,124);\nconst av8=avatar.createInstance(); av8.rescale(104/150); avw.appendChild(av8); av8.x=0; av8.y=0;\nconst eb=figma.createFrame(); eb.name='Edit avatar'; eb.resize(36,36); eb.cornerRadius=18; eb.fills=[P('brand/primary')]; eb.strokes=[P('surface/base')]; eb.strokeWeight=3; eb.strokeAlign='OUTSIDE'; eb.layoutMode='HORIZONTAL'; eb.primaryAxisAlignItems='CENTER'; eb.counterAxisAlignItems='CENTER'; eb.primaryAxisSizingMode='FIXED'; eb.counterAxisSizingMode='FIXED';\nconst ei=editIc.createInstance(); ei.rescale(0.75); eb.appendChild(ei); avw.appendChild(eb); eb.x=70; eb.y=70;\nconst d1=card('Details'); add(s8,d1,24,252);\nconst det=[['Name','Jonas Macroni'],['Email','jonas.macroni@invest.ai'],['Birthdate','05 November 1993'],['Gender','Male']];\nconst dr=[]; for(const [l,v] of det){const r=variant(dset,'Status=Added').createInstance(); setP(r,{Label:l,Value:v,Action:'Change'}); r.name=l; d1.appendChild(r); dr.push(r);} divide(dr);\nd1.layoutSizingHorizontal='HUG'; d1.layoutSizingVertical='HUG';\nconst nl=await T('Not added yet','Label/Small','text/secondary'); nl.name='Not added yet label'; nl.textCase='UPPER'; add(s8,nl,28,d1.y+d1.height+28);\nconst d2=card('Not added yet'); add(s8,d2,24,nl.y+28);\nconst mr=[]; for(const [l,v] of [['Address','No address added'],['Phone Number','No phone number added']]){const r=variant(dset,'Status=Missing').createInstance(); setP(r,{Label:l,Value:v,Action:'+ Add'}); r.name=l; d2.appendChild(r); mr.push(r);} divide(mr);\nd2.layoutSizingHorizontal='HUG'; d2.layoutSizingVertical='HUG';\nshell(s8); out.s8=s8.id;\n\n// 09 Bank account info\nconst s9=screen('09_Bank_Account_Info',4940); hdr(s9,'Bank account info');\nconst l9=vstack('Accounts',12); add(s9,l9,24,124);\nfor(const b of ['Bank of America','Zenith Bank']){const i=variant(bank,'Bank='+b).createInstance(); setP(i,{Number:'0182128xxx',Holder:'Jonas Macroni'}); i.name=b; l9.appendChild(i);}\nl9.layoutSizingHorizontal='HUG'; l9.layoutSizingVertical='HUG';\nconst addb=variant(btnSet,'Style=Primary').createInstance(); setP(addb.children[0],{Label:'+  Add account'}); addb.name='Add account'; add(s9,addb,24,808);\nshell(s9); out.s9=s9.id;\nreturn out;","description":"Build 06_Notification, 07_Profile, 08_Contact_Info and 09_Bank_Account_Info screens","fileKey":"oEVCBoWMrSozqyLTP60OiS"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":98384,"cache_read_input_tokens":7727,"cache_creation":{"ephemeral_5m_input_tokens":98384,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"cec50fe8-0981-4a9e-a5f5-60c5e79e1651","uuid":"12a9459c-5373-45df-9041-666b4d4514cc","timestamp":"2026-10-28T09:41:06.648Z","tool_use_meta":[{"id":"toolu_bdrk_011ZAjCjVqVh2EKCjzdSkafx","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
