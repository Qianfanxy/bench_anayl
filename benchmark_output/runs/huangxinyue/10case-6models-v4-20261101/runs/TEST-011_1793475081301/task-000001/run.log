ateInstance(); c.name='For You · '+t; setP(c,{Title:t,Participants:pp,Return:ret}); const r=sub(c,'Risk'); setP(r,{Risk:risk.split('=')[1]}); setP(r,{Label:rl}); fyr.appendChild(c); c.layoutSizingHorizontal='FILL'; c.layoutAlign='STRETCH';}\n// strategies\nconst st=A('Investing Strategies','VERTICAL',{gap:14}); C.appendChild(st); st.layoutSizingHorizontal='FILL';\nconst sh=(await node('10:28')).createInstance(); setP(sh,{Title:'Investing Strategies','Show trailing':false}); st.appendChild(sh); sh.layoutSizingHorizontal='FILL';\nconst grid=A('Strategy grid','HORIZONTAL',{gap:15}); grid.layoutWrap='WRAP'; grid.counterAxisSpacing=15; st.appendChild(grid); grid.layoutSizingHorizontal='FILL';\nconst sdata=[['The Big Long','15.16%',['BTC','ETH','USDT'],'+3'],['Aggressive Growth','159%',['MATIC','MANA','CAKE'],'+2'],['Best Projects','46.22%',['NEAR','DASH','AVAX'],'+12'],['Strategy 2022','26.08%',['ETC','DAI','BNB'],'+2']];\nfor(const [n,r,lg,m] of sdata){const c=await V_('10:171','State=Default'); c.name='Strategy · '+n; setP(c,{Name:n,Return:r,More:m,'Logo 1':L[lg[0]],'Logo 2':L[lg[1]],'Logo 3':L[lg[2]]}); grid.appendChild(c); c.resize(160,c.height);}\n// coin lists\nconst cl=A('Coin Lists','VERTICAL',{gap:12}); C.appendChild(cl); cl.layoutSizingHorizontal='FILL';\nconst ch=(await node('10:28')).createInstance(); setP(ch,{Title:'Coin Lists','Show trailing':false}); cl.appendChild(ch); ch.layoutSizingHorizontal='FILL';\nconst tabsClip=figma.createFrame(); tabsClip.name='Tabs · scroll'; tabsClip.fills=[]; tabsClip.clipsContent=true; tabsClip.resize(355,34); cl.appendChild(tabsClip); tabsClip.overflowDirection='HORIZONTAL';\nconst tabs=A('Tabs','HORIZONTAL',{gap:8}); tabsClip.appendChild(tabs); tabs.x=0; tabs.y=0;\nfor(const [lab,sel] of [['🔥 Trending',1],['📺 Watchlist',0],['❤️ Favorites',0],['💵 Stablecoins',0],['🔗 BNB Chain Ecosystem',0]]){const t=await V_('7:104',sel?'State=Selected':'State=Default'); setP(t,{Label:lab}); t.name='Tab · '+lab+(sel?' (current)':''); tabs.appendChild(t);}\nconst list=A('Coin list · Trending','VERTICAL',{gap:0}); cl.appendChild(list); list.layoutSizingHorizontal='FILL';\nconst coins=[['Bitcoin','BTC','$16,963.58','−0.12%'],['Ethereum','ETH','$1,259.10','+1.15%'],['Tether','USDT','$1.01','+0.01%'],['Binance Coin','BNB','$288.01','+0.76%'],['USD Coin','USDC','$0.9999','−0.02%'],['Binance USD','BUSD','$1.00','−0.01%'],['XRP','XRP','$0.3891','+2.54%'],['Dogecoin','DOGE','$0.1012','−0.17%'],['Cardano','ADA','$0.3196','+0.09%'],['Polygon','MATIC','$0.9082','+2.18%']];\nconst coinComp=await node('10:172');\nfor(const [n,t,p,c] of coins){const r=coinComp.createInstance(); r.name='Coin · '+n; setP(r,{Name:n,Ticker:t,Price:p,Logo:L[t]}); const x=sub(r,'24h change'); setP(x,{Trend:c.startsWith('+')?'Up':'Down'}); setP(x,{Value:c}); list.appendChild(r); r.layoutSizingHorizontal='FILL';}\n// shell\nconst sb=(await node('3:26')).createInstance(); F.appendChild(sb); sb.x=0; sb.y=0; sb.name='Status Bar';\nconst H=Math.max(812,Math.ceil(C.height)); F.resize(375,H);\nconst fade=figma.createRectangle(); fade.name='Bottom fade'; fade.resize(375,110); fade.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{r:1,g:1,b:1,a:0}},{position:0.45,color:{r:1,g:1,b:1,a:1}},{position:1,color:{r:1,g:1,b:1,a:1}}]}]; F.appendChild(fade); fade.x=0; fade.y=H-110;\nconst pg=await V_('7:30','Page=3'); pg.name='Page Indicator · Discovery'; F.appendChild(pg); pg.x=(375-pg.width)/2; pg.y=H-34-pg.height-8;\nconst hi=(await node('3:36')).createInstance(); hi.name='Home Indicator'; F.appendChild(hi); hi.x=0; hi.y=H-34;\nfor(const n of [fade,pg,hi]) n.constraints={horizontal:'CENTER',vertical:'MAX'};\nF.numberOfFixedChildren=4;\n// same for wallet\nconst W=await node('13:55'); W.numberOfFixedChildren=4;\nreturn F.id+' H'+H;","description":"Build 02_Discovery screen","fileKey":"Sj1zQCA7vlG3EkhCBDD7ZI"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tok