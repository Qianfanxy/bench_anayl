l2: \"DTUBLIGRBL568\" },\n        { label: \"Secondary Material\", val1: \"Solid Wood\", val2: \"Solid Wood\" },\n        { label: \"Configuration\", val1: \"L-shaped\", val2: \"L-shaped\" },\n        { label: \"Upholstery Material\", val1: \"Fabric + Cotton\", val2: \"Fabric + Cotton\" },\n        { label: \"Upholstery Color\", val1: \"Bright Grey & Lion\", val2: \"Bright Grey & Lion\" }\n      ]\n    },\n    {\n      group: \"Product\",\n      rows: [\n        { label: \"Filling Material\", val1: \"Foam\", val2: \"Foam\" },\n        { label: \"Finish Type\", val1: \"Matte\", val2: \"Matte\" },\n        { label: \"Adjustable Headrest\", val1: \"No\", val2: \"Yes\" },\n        { label: \"Maximum Load Capacity\", val1: \"280 KG\", val2: \"300 KG\" },\n        { label: \"Origin of Manufacture\", val1: \"India\", val2: \"India\" }\n      ]\n    },\n    {\n      group: \"Dimensions\",\n      rows: [\n        { label: \"Width\", val1: \"265.32 cm\", val2: \"265.32 cm\" },\n        { label: \"Height\", val1: \"76 cm\", val2: \"76 cm\" },\n        { label: \"Depth\", val1: \"167.76 cm\", val2: \"167.76 cm\" },\n        { label: \"Weight\", val1: \"45 KG\", val2: \"65 KG\" },\n        { label: \"Seat Height\", val1: \"41.52 cm\", val2: \"41.52 cm\" },\n        { label: \"Leg Height\", val1: \"5.46 cm\", val2: \"5.46 cm\" }\n      ]\n    },\n    {\n      group: \"Warranty\",\n      rows: [\n        { label: \"Warranty Summary\", val1: \"1 Year Manufacturing Warranty\", val2: \"1.2 Year Manufacturing Warranty\" },\n        { label: \"Warranty Service Type\", val1: \"For Warranty Claims or Any Product Related Issues Please Email at operations@furniro.example\", val2: \"… at support@furniro.example\" },\n        { label: \"Covered in Warranty\", val1: \"Warranty Against Manufacturing Defect\", val2: \"Warranty of the product is limited to manufacturing defects only.\" },\n        { label: \"Not Covered in Warranty\", val1: \"The Warranty Does Not Cover Damages Due To Usage Of The Product Beyond Its Intended Use And Wear & Tear In The Natural Course Of Product Usage.\", val2: \"The Warranty Does Not Cover Damages Due To Usage Of The Product Beyond Its Intended Use And Wear & Tear In The Natural Course Of Product Usage.\" },\n        { label: \"Domestic Warranty\", val1: \"1 Year\", val2: \"3 Months\" }\n      ]\n    }\n  ];\n\n  let currentY = 400;\n\n  specData.forEach(g => {\n    // Group Title\n    const gTitle = figma.createText();\n    gTitle.fontName = { family: \"Poppins\", style: \"Medium\" };\n    gTitle.fontSize = 28;\n    gTitle.characters = g.group;\n    gTitle.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    gTitle.x = 0;\n    gTitle.y = currentY;\n    mainComp.appendChild(gTitle);\n\n    currentY += 50;\n\n    g.rows.forEach(r => {\n      const rowFrame = figma.createFrame();\n      rowFrame.resize(1332, 45);\n      rowFrame.fills = [];\n\n      // Label (col 1: x=0)\n      const lbl = figma.createText();\n      lbl.fontName = { family: \"Poppins\", style: \"Regular\" };\n      lbl.fontSize = 18;\n      lbl.characters = r.label;\n      lbl.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n      lbl.x = 0;\n      lbl.y = 0;\n      rowFrame.appendChild(lbl);\n\n      // Val 1 (col 2: x=310)\n      const v1 = figma.createText();\n      v1.fontName = { family: \"Poppins\", style: \"Regular\" };\n      v1.fontSize = 18;\n      v1.characters = r.val1;\n      v1.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n      v1.x = 310;\n      v1.y = 0;\n      rowFrame.appendChild(v1);\n\n      // Val 2 (col 3: x=640)\n      const v2 = figma.createText();\n      v2.fontName = { family: \"Poppins\", style: \"Regular\" };\n      v2.fontSize = 18;\n      v2.characters = r.val2;\n      v2.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n      v2.x = 640;\n      v2.y = 0;\n      rowFrame.appendChild(v2);\n\n      rowFrame.x = 0;\n      rowFrame.y = currentY;\n      mainComp.appendChild(rowFrame);\n\n      currentY += 45;\n    });\n\n    currentY += 30; // space between groups\n  });\n\n  // \"Add To Cart\" buttons under each product column at the bottom of specs table\n  const atcRow = figma.createFrame();\n  atcRow.resize(1332, 60);\n  atcRow.fills = [];\n\n  const addAtcBtn = (x) => {\n    const btn = figma.createFrame();\n    btn.name = \"Add To Cart\";\n    btn.resize(215, 64);\n    btn.fills = [{ type: 'SOLID', color: GOLD }];\n    const t = figma.createText();\n    t.fontName = { family: \"Poppins\", style: \"Medium\" };\n    t.fontSize = 18;\n    t.characters = \"Add To Cart\";\n    t.fills = [{ type: 'SOLID', color: WHITE }];\n    btn.appendChild(t);\n    t.x = (215 - t.width) / 2;\n    t.y = (64 - t.height) / 2;\n    btn.x = x;\n    btn.y = 0;\n    atcRow.appendChild(btn);\n  };\n\n  addAtcBtn(310);\n  addAtcBtn(640);\n\n  atcRow.x = 0;\n  atcRow.y = currentY;\n  mainComp.appendChild(atcRow);\n\n  currentY += 100;\n  mainComp.resize(1332, currentY);\n\n  compPage.appendChild(mainComp);\n\n  // 4. Features Strip\n  const strip = buildFeaturesStrip();\n  strip.y = 450 + currentY + 50;\n  compPage.appendChild(strip);\n\n  // 5. Footer\n  const cpFooter = buildFooter();\n  cpFooter.y = strip.y + 270;\n  compPage.appendChild(cpFooter);\n\n  compPage.resize(1440, cpFooter.y + 505);\n\n  return \"Comparison page created successfully!\";\n})();","description":"Implement 05_Comparison frame with two sofa cards, specifications table and feature strip","fileKey":"lyAJXJy8GatyIPzWRh2m00"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":93279,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":67332},"context_management":null},"parent_tool_use_id":null,"session_id":"68369d55-e3dd-4325-b303-55296225c818","uuid":"df0effeb-16aa-4f7c-9052-90741084bf72","timestamp":"2026-11-01T19:17:36.595Z","tool_use_meta":[{"id":"call_56d46cb9f80a4c6380cca37bc1ec7682","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
