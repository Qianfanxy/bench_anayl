.primaryAxisSizingMode='FIXED';f.resize(o.w,f.height);}return f;}\nconst CMP=(n,d,o)=>AL(n,d,o,true);\nconst ICON={Email:'4:58',Password:'4:64',Show:'4:70',Plus:'4:76',Search:'4:82',Chats:'4:87',Archive:'4:94',Image:'4:101',PDFDoc:'4:110',Back:'4:116',ArrowUR:'4:121',Edit:'4:128',Copy:'4:134',Share:'4:139',Regenerate:'4:145',Download:'4:152',Send:'4:157',Menu:'4:164',Export:'4:171',Close:'4:177',Premium:'4:182',More:'4:189',Delete:'4:197'};\nconst MEDIA={Logo:'4:8',Avatar:'4:11',Mug:'4:19',Rat:'4:22',Statue:'4:25',Student:'4:28',PDF:'4:31',Google:'4:42',Facebook:'4:48'};\nconst recolor=(i,tok)=>{i.findAll(n=>['VECTOR','ELLIPSE','RECTANGLE','BOOLEAN_OPERATION','STAR','POLYGON'].includes(n.type)).forEach(v=>{if(v.strokes.length)v.strokes=[P(tok)];if(v.fills.length)v.fills=[P(tok)];});};\nasync function icon(name,tok='text/primary',size){const c=await figma.getNodeByIdAsync(ICON[name]);const i=c.createInstance();i.fills=[];recolor(i,tok);if(size)i.rescale(size/i.width);i.name='Icon/'+name;return i;}\nasync function media(name,size){const c=await figma.getNodeByIdAsync(MEDIA[name]);const i=c.createInstance();if(size)i.rescale(size/i.width);return i;}\nfunction grid(set,cols,gap=24,pad=24){const k=set.children;let x=pad,y=pad,rowH=0;k.forEach((c,i)=>{if(i%cols===0&&i>0){x=pad;y+=rowH+gap;rowH=0;}c.x=x;c.y=y;x+=c.width+gap;rowH=Math.max(rowH,c.height);});let W=0,H=0;k.forEach(c=>{W=Math.max(W,c.x+c.width);H=Math.max(H,c.y+c.height);});set.resize(W+pad,H+pad);set.fills=[P('surface/subtle')];stroke(set,'brand/primary-tint');set.dashPattern=[6,4];set.cornerRadius=16;}\nconst IB=await figma.getNodeByIdAsync('10:151');\nasync function iconBtn(iconName,style='Plain',state='Default',tok){const v=IB.children.find(c=>c.name===`Style=${style}, State=${state}`);const i=v.createInstance();i.setProperties({'Icon#10:0':ICON[iconName]});const t=tok||(style==='Plain'?'text/primary':style==='Tonal'?'brand/primary':'text/on-primary');recolor(i,t);i.name='Icon Button/'+iconName;return i;}\nconst MA=await figma.getNodeByIdAsync('12:200');\nasync function action(label,ic){const i=MA.createInstance();i.setProperties({'Label#12:6':label,'Icon#12:7':ICON[ic]});recolor(i.children[0],'text/secondary');i.name='Action/'+label;return i;}\nconst AV=await figma.getNodeByIdAsync('12:65');\nconst lib=await figma.getNodeByIdAsync('10:2');\nconst out={};\nasync function chevron(tok='text/tertiary'){const c=await icon('Back',tok,20);c.rotation=180;c.name='Chevron';return c;}\n\n// Chat list item\nconst cl=CMP('Chat List Item','VERTICAL',{gap:8,pad:[16,16,14,16],r:20,fill:'surface/bg',w:380});stroke(cl,'border/default');\nconst q=await T('How can I forget a bad memory?','Body/15 Strong','text/primary',{lines:2,name:'Question'});cl.appendChild(q);q.layoutSizingHorizontal='FILL';\nconst a=await T('Forgetting a bad memory entirely may be challenging, as memories are complex and deeply ingrained in the brain. However, there are strategies you can use to cope with and reduce the impact of negative memories.','Body/14','text/secondary',{lines:2,name:'Answer'});cl.appendChild(a);a.layoutSizingHorizontal='FILL';\nconst imgw=figma.createFrame();imgw.name='Generated image';imgw.resize(348,160);imgw.cornerRadius=14;imgw.clipsContent=true;imgw.fills=[P('surface/muted')];const st=await media('Student');st.rescale(348/st.width);st.y=(160-st.height)/2;imgw.appendChild(st);cl.appendChild(imgw);imgw.layoutSizingHorizontal='FILL';\nconst ft=AL('Meta','HORIZONTAL',{gap:6,align:'CENTER'});cl.appendChild(ft);ft.layoutSizingHorizontal='FILL';\nconst ti=await T('28 mins ago','Caption/12','text/tertiary',{name:'Time'});ft.appendChild(ti);ti.layoutGrow=1;ft.appendChild(await icon('ArrowUR','brand/primary',18));\nconst cq=cl.addComponentProperty('Question','TEXT','How can I forget a bad memory?');const ca=cl.addComponentProperty('Answer','TEXT',a.characters);const ct=cl.addComponentProperty('Time','TEXT','28 mins ago');const cb=cl.addComponentProperty('Has image','BOOLEAN',false);\nq.componentPropertyReferences={characters:cq};a.componentPropertyReferences={characters:ca};ti.componentPropertyReferences={characters:ct};imgw.componentPropertyReferences={visible:cb};\nlib.appendChild(cl);out.chatItem=[cl.id,cq,ca,ct,cb];\n\n// Export row set\nconst er=[];\nfor(const v of ['Default','Deletable']){const c=CMP(`Action=${v}`,'HORIZONTAL',{gap:12,pad:[12,12,12,12],r:16,fill:'surface/bg',align:'CENTER',w:380});stroke(c,'border/default');\n c.appendChild(await media('PDF',44));const col=AL('Text','VERTICAL',{gap:2});c.appendChild(col);col.layoutGrow=1;\n const t1=await T('How can I forget a bad memory?','Body/15 Strong','text/primary',{lines:1,name:'Title'});col.appendChild(t1);t1.layoutSizingHorizontal='FILL';\n const mr=AL('Meta','HORIZONTAL',{gap:6,align:'CENTER'});col.appendChild(mr);const d=await T('DEC 30, 2023','Caption/12','text/tertiary',{name:'Date'});const dot=await T('•','Caption/12','text/tertiary',{name:'dot'});const s=await T('2.16 MB','Caption/12','text/secondary',{name:'Size'});mr.appendChild(d);mr.appendChild(dot);mr.appendChild(s);\n if(v==='Deletable'){const del=await iconBtn('Delete','Plain','Default','semantic/error');del.fills=[P('semantic/error-soft')];del.name='Delete';c.appendChild(del);} else {c.appendChild(await chevron());}\n er.push(c);}\nconst ers=figma.combineAsVariants(er,lib);ers.name='Export Row';grid(ers,2);\nconst et=ers.addComponentProperty('Title','TEXT','How can I forget a bad memory?');const ed=ers.addComponentProperty('Date','TEXT','DEC 30, 2023');const es=ers.addComponentProperty('Size','TEXT','2.16 MB');\nfor(const c of ers.children){c.findOne(n=>n.name==='Title').componentPropertyReferences={characters:et};c.findOne(n=>n.name==='Date').componentPropertyReferences={characters:ed};c.findOne(n=>n.name==='Size').componentPropertyReferences={characters:es};}\nout.exportRow=[ers.id,et,ed,es];\n\n// Suggestion card\nconst sg=CMP('Suggestion Card','VERTICAL',{gap:4,pad:[14,14,14,14],r:16,fill:'surface/subtle',w:186});stroke(sg,'border/default');\nconst sgt=await T('Brainstorm names','Body/15 Strong','text/primary',{name:'Title'});sg.appendChild(sgt);sgt.layoutSizingHorizontal='FILL';\nconst sgd=await T('for my fantasy football team with a frog theme','Body/14','text/secondary',{name:'Detail',lines:3});sg.appendChild(sgd);sgd.layoutSizingHorizontal='FILL';\nconst sp1=sg.addComponentProperty('Title','TEXT','Brainstorm names');const sp2=sg.addComponentProperty('Detail','TEXT','for my fantasy football team with a frog theme');sgt.componentPropertyReferences={characters:sp1};sgd.componentPropertyReferences={characters:sp2};\nlib.appendChild(sg);out.sugg=[sg.id,sp1,sp2];\n\n// Message / You\nconst mu=CMP('Message/You','VERTICAL',{gap:8,align:'MAX',w:396});\nconst hu=AL('Sender','HORIZONTAL',{gap:8,align:'CENTER'});hu.appendChild(await T('You','Label/14','text/secondary',{name:'Sender name'}));const av1=AV.createInstance();av1.rescale(28/40);hu.appendChild(av1);mu.appendChild(hu);\nconst bu=AL('Bubble','VERTICAL',{pad:[12,16,12,16],fill:'brand/primary'});bu.topLeftRadius=20;bu.topRightRadius=6;bu.bottomLeftRadius=20;bu.bottomRightRadius=20;bu.counterAxisSizingMode='FIXED';bu.resize(320,10);\nconst ut=await T('Tell me the story of a student who was going to school and some interesting things happened to her on the way.','Body/16','text/on-primary',{name:'Message'});bu.appendChild(ut);ut.layoutSizingHorizontal='FILL';mu.appendChild(bu);\nconst ua=AL('Actions','HORIZONTAL',{gap:8});ua.appendChild(await action('Edit','Edit'));ua.appendChild(await action('Copy','Copy'));mu.appendChild(ua);\nconst mup=mu.addComponentProperty('Message','TEXT',ut.characters);ut.componentPropertyReferences={characters:mup};lib.appendChild(mu);out.msgYou=[mu.id,mup];\n\n// Message / Bot set\nconst mb=[];\nfor(const kind of ['Text','Image']){const c=CMP(`Kind=${kind}`,'VERTICAL',{gap:8,align:'MIN',w:396});\n const h=AL('Sender','HORIZONTAL',{gap:8,align:'CENTER'});const lg=await media('Logo',28);lg.name='Logo';h.appendChild(lg);h.appendChild(await T('Chat Bot AI','Label/14','brand/primary',{name:'Sender name'}));c.appendChild(h);\n const b=AL('Bubble','VERTICAL',{gap:12,pad:[12,16,14,16],fill:'surface/subtle'});b.topLeftRadius=6;b.topRightRadius=20;b.bottomLeftRadius=20;b.bottomRightRadius=20;b.counterAxisSizingMode='FIXED';b.resize(360,10);stroke(b,'border/default');\n const txt= kind==='Text'?'Once upon a time, in the quaint town of Meadowville, there lived a spirited high school student named Lily.':'I’ll try to create that. Here is the image I generated based on your description. I hope you like it. 😊';\n const bt=await T(txt,'Body/16','text/primary',{name:'Message'});b.appendChild(bt);bt.layoutSizingHorizontal='FILL';\n if(kind==='Image'){const iw=figma.createFrame();iw.name='Generated image';iw.resize(328,234);iw.cornerRadius=14;iw.clipsContent=true;iw.fills=[P('surface/muted')];const s=await media('Student');s.rescale(328/s.width);iw.appendChild(s);b.appendChild(iw);iw.layoutSizingHorizontal='FILL';}\n c.appendChild(b);\n const ac=AL('Actions','HORIZONTAL',{gap:8});\n if(kind==='Text'){ac.appendChild(await action('Copy','Copy'));ac.appendChild(await action('Share','Share'));ac.appendChild(await action('Regenerate','Regenerate'));}\n else{ac.appendChild(await action('Download','Download'));ac.appendChild(await action('Share','Share'));ac.appendChild(await action('Regenerate','Regenerate'));}\n c.appendChild(ac);mb.push(c);}\nconst mbs=figma.combineAsVariants(mb,lib);mbs.name='Message/Chat Bot AI';grid(mbs,2);\nconst mbp=mbs.addComponentProperty('Message','TEXT','Once upon a time');for(const c of mbs.children)c.findOne(n=>n.name==='Message').componentPropertyReferences={characters:mbp};\nout.msgBot=[mbs.id,mbp];\nreturn out;","description":"Build chat item, export row, suggestion, message components","fileKey":"qYmJPYhan4qnoskPJ57RhI"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":2970,"cach