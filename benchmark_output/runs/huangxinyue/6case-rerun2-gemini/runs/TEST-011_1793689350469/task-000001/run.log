Link.y = 635;\n  f6.appendChild(siLink);\n\n  // 07_Forgot_Password\n  const f7 = figma.createFrame();\n  f7.name = '07_Forgot_Password';\n  f7.resize(375, 812);\n  f7.x = 2520; f7.y = 0;\n  f7.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  createStatusAndHome(f7);\n\n  const t7 = figma.createText();\n  t7.fontName = { family: \"Montserrat\", style: \"Bold\" };\n  t7.fontSize = 36;\n  t7.characters = \"Forgot\\npassword?\";\n  t7.x = 29; t7.y = 70;\n  t7.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  f7.appendChild(t7);\n\n  const tf7_1 = createCustomTextField(\"Enter your email address\", \"Icon_Mail\");\n  tf7_1.x = 29; tf7_1.y = 190;\n  f7.appendChild(tf7_1);\n\n  const note7 = figma.createText();\n  note7.fontName = { family: \"Montserrat\", style: \"Regular\" };\n  note7.fontSize = 12;\n  note7.characters = \"* We will send you a message to set or reset your new password\";\n  note7.fills = [{ type: 'SOLID', color: { r: 0.4, g: 0.4, b: 0.4 } }];\n  note7.resize(317, 32);\n  note7.x = 29; note7.y = 260;\n  f7.appendChild(note7);\n\n  const btnSubmit = createCustomButton(\"Submit\");\n  btnSubmit.x = 29; btnSubmit.y = 310;\n  f7.appendChild(btnSubmit);\n\n  // 08_Get_Started\n  const f8 = figma.createFrame();\n  f8.name = '08_Get_Started';\n  f8.resize(375, 812);\n  f8.x = 2940; f8.y = 0;\n  f8.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  createStatusAndHome(f8);\n\n  const bgPhoto = createInstanceByName('Get_Started_Photo', f8);\n  if (bgPhoto) {\n    bgPhoto.x = 0; bgPhoto.y = 0;\n  }\n\n  const overlay = figma.createFrame();\n  overlay.name = 'OverlayContainer';\n  overlay.resize(375, 300);\n  overlay.x = 0; overlay.y = 512;\n  overlay.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 }, opacity: 0.6 }];\n  f8.appendChild(overlay);\n\n  const t8_1 = figma.createText();\n  t8_1.fontName = { family: \"Montserrat\", style: \"Semi Bold\" };\n  t8_1.fontSize = 34;\n  t8_1.characters = \"You want\\nAuthentic, here\\nyou 