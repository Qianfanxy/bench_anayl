n});\nconst tabsRule=frame(prod,'Tabs Rule',{w:1440,dir:'HORIZONTAL',padX:100});tabsRule.fills=[];\nframe(tabsRule,'Line',{w:1240,h:1,fill:C.line});\n\nconst revSec=frame(prod,'Reviews',{w:1440,dir:'VERTICAL',gap:24,padX:100});revSec.paddingTop=32;revSec.paddingBottom=40;\nconst revHead=frame(revSec,'Head',{w:1240,dir:'HORIZONTAL',justify:'SPACE_BETWEEN',align:'CENTER'});revHead.fills=[];\nconst revCount=frame(revHead,'Count',{dir:'HORIZONTAL',gap:6,align:'CENTER'});revCount.fills=[];\ntext(revCount,{text:'All Reviews',font:F.bold,size:24,color:C.ink});\ntext(revCount,{text:'(451)',font:F.reg,size:16,color:C.muted});\nconst revCtl=frame(revHead,'Controls',{dir:'HORIZONTAL',gap:12,align:'CENTER'});revCtl.fills=[];\nconst fBtn=frame(revCtl,'Filter',{w:48,h:48,fill:C.surface,radius:62,dir:'HORIZONTAL',justify:'CENTER',align:'CENTER'});fBtn.appendChild(icon('Filter',20,C.ink));\nconst sortBtn=frame(revCtl,'Sort',{h:48,fill:C.surface,radius:62,dir:'HORIZONTAL',gap:8,align:'CENTER',justify:'CENTER',padX:20});\ntext(sortBtn,{text:'Latest',font:F.med,size:15,color:C.ink});sortBtn.appendChild(icon('Chevron_Down',16,C.ink));\nlabeledBtn(revCtl,'Write a Review',{padX:24});\nconst revGrid=frame(revSec,'Grid',{w:1240,dir:'HORIZONTAL',gap:20,wrap:true,rowGap:20});revGrid.fills=[];\nreviewData.forEach(function(d){\n  const c=make(prc,revGrid);\n  tFind(c,'Reviewer').characters=d[0];\n  tFind(c,'Quote').characters='“'+d[2]+'”';\n  tFind(c,'Date').characters=d[3];\n  const topRow=c.findOne(n=>n.name==='Top');\n  const st=topRow.findOne(n=>n.name==='Stars');\n  if(st) st.visible=false;\n  const fresh=starsRow(topRow,d[1],18,4);\n  topRow.insertChild(0,fresh);\n});\nconst loadWrap=frame(revSec,'Load More',{w:1240,dir:'HORIZONTAL',justify:'CENTER'});loadWrap.fills=[];\nlabeledBtn(loadWrap,'Load More Reviews',{secondary:true,padX:54});\n\nconst likeSec=frame(prod,'You Might Also Like',{w:1440,dir:'VERTICAL',gap:32,padX:100});likeSec.paddingTop=40;likeSec.paddingBottom=64;\ntext(likeSec,