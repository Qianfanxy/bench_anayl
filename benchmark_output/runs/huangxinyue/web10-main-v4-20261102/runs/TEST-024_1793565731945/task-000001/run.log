outWrap='WRAP';n.counterAxisSpacing=o.rowGap===undefined?(o.gap||0):o.rowGap;}n.primaryAxisSizingMode='AUTO';n.counterAxisSizingMode='AUTO';n.resize(o.w===undefined?100:o.w,o.h===undefined?100:o.h);if(o.w!==undefined&&!o.hugW){n.counterAxisSizingMode='FIXED';n.resize(o.w,n.height);}if(o.h!==undefined&&!o.hugH){n.primaryAxisSizingMode='FIXED';n.resize(n.width,o.h);}}\nelse{n.resize(o.w===undefined?100:o.w,o.h===undefined?100:o.h);}\nif(o.x!==undefined)n.x=o.x;if(o.y!==undefined)n.y=o.y;return n;}\nfunction text(parent,o){const t=figma.createText();t.fontName=o.font||F.reg;t.characters=o.text===undefined?'':o.text;t.fontSize=o.size||16;if(o.lh)t.lineHeight={unit:'PIXELS',value:o.lh};t.fills=[paint(o.color||C.ink)];if(o.align)t.textAlignHorizontal=o.align;if(o.strike)t.textDecoration='STRIKETHROUGH';parent.appendChild(t);if(o.w){t.resize(o.w,t.height);t.textAutoResize='HEIGHT';}else t.textAutoResize='WIDTH_AND_HEIGHT';return t;}\nconst iconMap={};ws.findAll(x=>x.type==='COMPONENT'&&x.name.indexOf('Icon/')===0).forEach(c=>iconMap[c.name.slice(5)]=c);\nfunction icon(n,size,color){const c=iconMap[n];if(!c)throw new Error('icon '+n);const i=c.createInstance();if(size)i.rescale(size/i.width);const col=color||C.ink2;i.findAll(v=>v.type==='VECTOR').forEach(v=>{v.fills=[paint(col)];if(v.strokes&&v.strokes.length)v.strokes=[paint(col)];});return i;}\nfunction photo(parent,hash,w,h,r){const p=figma.createRectangle();p.name='Photo';p.resize(w,h);p.fills=[{type:'IMAGE',imageHash:hash,scaleMode:'FILL'}];if(r)p.cornerRadius=r;parent.appendChild(p);return p;}\nconst H={}; for (const [k,id] of Object.entries({Hero:'4:36',Casual:'4:44',Formal:'4:45',Party:'4:47',Gym:'4:46',Tape:'4:48',Jeans:'4:42',Check:'4:33',Sleeve:'4:43',Vertical:'4:51',Courage:'4:49',Bermuda:'4:37',Faded:'4:34',Gradient:'4:35',PoloTip:'4:41',BlackStripe:'4:32',PoloContrast:'4:40',One1:'4:38',One2:'4:39',One3:'4:50'})) { const n=await figma.getNodeByIdAsync(id); H[k]=n.fills[0].imageHash; }\nfunction set(name){ retu