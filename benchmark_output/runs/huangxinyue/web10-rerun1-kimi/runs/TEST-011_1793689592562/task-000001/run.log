4',\n  checkered: '3e5af3bd4090b719f9e42d6984ebbd10f41fc9c3',\n  sleeveStriped: 'ef45eeebb5fae60d034aff1014d22e0e6da465db',\n  verticalStriped: '0cd824094e131d46c078ec766c523b4693d10bba',\n  courage: 'c5bf7371fccba672c21a584729b73ef7ad09fa55',\n  bermuda: '26bcb83ffdfcea554d93b0e0a65bc3fa67c6b980',\n};\n\n// Build product card with smaller images for grid\nfunction buildCard(name, hash, rating, price, oldPrice, discount) {\n  const card = figma.createFrame();\n  card.name = 'Product / ' + name;\n  card.layoutMode = 'VERTICAL';\n  card.itemSpacing = 12;\n  card.counterAxisSizingMode = 'AUTO';\n  card.primaryAxisSizingMode = 'AUTO';\n  card.fills = [];\n  \n  const thumb = figma.createFrame();\n  thumb.name = 'Image';\n  thumb.resize(198, 200);\n  thumb.cornerRadius = 14;\n  thumb.fills = [{ type:'IMAGE', imageHash: hash, scaleMode:'FILL' }];\n  card.appendChild(thumb);\n  \n  const info = figma.createFrame();\n  info.name = 'Info';\n  info.fills = [];\n  info.layoutMode = 'VERTICAL';\n  info.itemSpacing = 4;\n  info.counterAxisSizingMode = 'AUTO';\n  info.primaryAxisSizingMode = 'AUTO';\n  \n  const nameT = H.text(name, 16, 'Bold', '#000000');\n  nameT.name = 'Name';\n  info.appendChild(nameT);\n  \n  const ratingWrap = figma.createFrame();\n  ratingWrap.name = 'Rating';\n  ratingWrap.fills = [];\n  ratingWrap.layoutMode = 'HORIZONTAL';\n  ratingWrap.itemSpacing = 8;\n  ratingWrap.counterAxisAlignItems = 'CENTER';\n  ratingWrap.counterAxisSizingMode = 'AUTO';\n  ratingWrap.primaryAxisSizingMode = 'AUTO';\n  const starsWrap = figma.createFrame();\n  starsWrap.fills = [];\n  starsWrap.layoutMode = 'HORIZONTAL';\n  starsWrap.itemSpacing = 4;\n  starsWrap.counterAxisSizingMode = 'AUTO';\n  starsWrap.primaryAxisSizingMode = 'AUTO';\n  const full = Math.floor(rating);\n  const hasHalf = (rating % 1) >= 0.25;\n  for (let i = 0; i < full; i++) {\n    const s = starIcon.createInstance();\n    s.fills = H.solid('#FFC633');\n    s.resize(16, 16);\n    starsWrap.appendChild(s);\n  }\n  if (hasHalf) {\n    const s = starHalfIcon.createInstance();\n    s.fills = H.solid('#FFC633');\n    s.resize(8, 16);\n    starsWrap.appendChild(s);\n  }\n  ratingWrap.appendChild(starsWrap);\n  ratingWrap.appendChild(H.text(rating.toFixed(1) + '/5', 12, 'Regular', '#000000'));\n  info.appendChild(ratingWrap);\n  \n  const priceRow = figma.createFrame();\n  priceRow.name = 'Price';\n  priceRow.fills = [];\n  priceRow.layoutMode = 'HORIZONTAL';\n  priceRow.itemSpacing = 8;\n  priceRow.counterAxisAlignItems = 'CENTER';\n  priceRow.counterAxisSizingMode = 'AUTO';\n  priceRow.primaryAxisSizingMode = 'AUTO';\n  priceRow.appendChild(H.text('$' + price, 20, 'Bold', '#000000'));\n  if (oldPrice) {\n    const o = H.text('$' + oldPrice, 20, 'Bold', '#000000', 'Plus Jakarta Sans', 0.4);\n    o.textDecoration = 'STRIKETHROUGH';\n    priceRow.appendChild(o);\n    const disc = figma.createFrame();\n    disc.paddingLeft = 12; disc.paddingRight = 12; disc.paddingTop = 4; disc.paddingBottom = 4;\n    disc.cornerRadius = 62;\n    disc.fills = H.rgba('#FF3333', 0.1);\n    disc.counterAxisSizingMode = 'AUTO';\n    disc.primaryAxisSizingMode = 'AUTO';\n    disc.layoutMode = 'HORIZONTAL';\n    disc.counterAxisAlignItems = 'CENTER';\n    disc.primaryAxisAlignItems = 'CENTER';\n    disc.appendChild(H.text('-' + discount + '%', 10, 'Medium', '#FF3333'));\n    priceRow.appendChild(disc);\n  }\n  info.appendChild(priceRow);\n  card.appendChild(info);\n  return card;\n}\n\n// ===== Products area (right of sidebar) =====\nconst prodArea = figma.createFrame();\nprodArea.name = 'Products Area';\nprodArea.fills = [];\nprodArea.layoutMode = 'VERTICAL';\nprodArea.itemSpacing = 24;\nprodArea.counterAxisSizingMode = 'FIXED';\nprodArea.primaryAxisSizingMode = 'AUTO';\nprodArea.layoutAlign = 'STRETCH';\nprodArea.layoutGrow = 1;\n\n// Results header\nconst rh = figma.createFrame();\nrh.name = 'Results Header';\nrh.fills = [];\nrh.layoutMode = 'HORIZONTAL';\nrh.primaryAxisSizingMode = 'FIXED';\nrh.counterAxisSizingMode = 'AUTO';\nrh.primaryAxisAlignItems = 'SPACE_BETWEEN';\nrh.counterAxisAlignItems = 'CENTER';\nrh.layoutAlign = 'STRETCH';\n\nconst rhLeft = figma.createFrame();\nrhLeft.fills = [];\nrhLeft.layoutMode = 'HORIZONTAL';\nrhLeft.itemSpacing = 8;\nrhLeft.counterAxisAlignItems = 'BASELINE';\nrhLeft.counterAxisSizingMode = 'AUTO';\nrhLeft.primaryAxisSizingMode = 'AUTO';\nrhLeft.appendChild(H.text('Casual', 32, 'Bold', '#000000'));\nrhLeft.appendChild(H.text('Showing 1-9 of 100 Products', 16, 'Regular', '#000000', 'Plus Jakarta Sans', 0.6));\nrh.appendChild(rhLeft);\n\nconst rhRight = figma.createFrame();\nrhRight.fills = [];\nrhRight.layoutMode = 'HORIZONTAL';\nrhRight.itemSpacing = 4;\nrhRight.counterAxisAlignItems = 'CENTER';\nrhRight.counterAxisSizingMode = 'AUTO';\nrhRight.primaryAxisSizingMode = 'AUTO';\nrhRight.appendChild(H.text('Sort by: ', 16, 'Regular', '#000000', 'Plus Jakarta Sans', 0.6));\nrhRight.appendChild(H.text('Most Popular', 16, 'Medium', '#000000'));\nconst sortChev = chevronDown.createInstance();\nsortChev.resize(16, 16);\nrhRight.appendChild(sortChev);\nrh.appendChild(rhRight);\nprodArea.appendChild(rh);\n\n// Product grid 3x3\nconst grid = figma.createFrame();\ngrid.name = 'Products';\ngrid.fills = [];\ngrid.layoutMode = 'HORIZONTAL';\ngrid.layoutWrap = 'WRAP';\ngrid.itemSpacing = 20;\ngrid.counterAxisSpacing = 36;\ngrid.counterAxisSizingMode = 'FIXED';\ngrid.primaryAxisSizingMode = 'AUTO';\ngrid.layoutAlign = 'STRETCH';\n\nconst products = [\n  ['Gradient Graphic T-shirt', HASH.gradient, 3.5, 145],\n  ['Polo with Tipping Details', HASH.poloTipping, 4.5, 180],\n  ['Black Striped T-shirt', HASH.blackStriped, 5.0, 120, 150, 30],\n  ['Skinny Fit Jeans', HASH.skinny, 3.5, 240, 260, 20],\n  ['Checkered Shirt', HASH.checkered, 4.5, 180],\n  ['Sleeve Striped T-shirt', HASH.sleeveStriped, 4.5, 130, 160, 30],\n  ['Vertical Striped Shirt', HASH.verticalStriped, 5.0, 212, 232, 20],\n  ['Courage Graphic T-shirt', HASH.courage, 4.0, 145],\n  ['Loose Fit Bermuda Shorts', HASH.bermuda, 3.0, 80],\n];\nfor (const p of products) {\n  grid.appendChild(buildCard(...p));\n}\nprodArea.appendChild(grid);\n\n// Divider\nconst pd = figma.createRectangle();\npd.resize(925, 1);\npd.fills = H.rgba('#000000', 0.1);\npd.layoutAlign = 'STRETCH';\nprodArea.appendChild(pd);\n\n// Pagination\nconst pagination = figma.createFrame();\npagination.name = 'Pagination';\npagination.fills = [];\npagination.layoutMode = 'HORIZONTAL';\npagination.primaryAxisSizingMode = 'FIXED';\npagination.counterAxisSizingMode = 'AUTO';\npagination.primaryAxisAlignItems = 'SPACE_BETWEEN';\npagination.counterAxisAlignItems = 'CENTER';\npagination.layoutAlign = 'STRETCH';\n\nfunction pageBtn(label, opts = {}) {\n  const b = figma.createFrame();\n  b.name = 'Page / ' + label;\n  b.layoutMode = 'HORIZONTAL';\n  b.paddingLeft = 14; b.paddingRight = 14; b.paddingTop = 8; b.paddingBottom = 8;\n  b.counterAxisSizingMode = 'AUTO';\n  b.primaryAxisSizingMode = 'AUTO';\n  b.counterAxisAlignItems = 'CENTER';\n  b.primaryAxisAlignItems = 'CENTER';\n  b.cornerRadius = 8;\n  b.itemSpacing = 8;\n  if (opts.active) {\n    b.fills = H.rgba('#000000', 0.06);\n  } else if (opts.bordered) {\n    b.fills = H.solid('#FFFFFF');\n    b.strokes = H.rgba('#000000', 0.1);\n    b.strokeWeight = 1;\n  } else {\n    b.fills = [];\n  }\n  const t = H.text(label, 14, opts.active ? 'Medium' : 'Regular', '#000000', 'Plus Jakarta Sans', opts.disabled ? 0.4 : 1);\n  b.appendChild(t);\n  return b;\n}\nfunction arrowBtn(dir) {\n  const b = figma.createFrame();\n  b.name = 'Page / ' + dir;\n  b.layoutMode = 'HORIZONTAL';\n  b.paddingLeft = 14; b.paddingRight = 14; b.paddingTop = 8; b.paddingBottom = 8;\n  b.counterAxisSizingMode = 'AUTO';\n  b.primaryAxisSizingMode = 'AUTO';\n  b.counterAxisAlignItems = 'CENTER';\n  b.cornerRadius = 8;\n  b.itemSpacing = 8;\n  b.fills = H.solid('#FFFFFF');\n  b.strokes = H.rgba('#000000', 0.1);\n  b.strokeWeight = 1;\n  if (dir === 'Previous') {\n    const ic = figma.getNodeById('4:4').createInstance();\n    ic.resize(16, 16);\n    b.appendChild(ic);\n  }\n  const t = H.text(dir, 14, 'Medium', '#000000');\n  b.appendChild(t);\n  if (dir === 'Next') {\n    const ic = figma.getNodeById('4:6').createInstance();\n    ic.resize(16, 16);\n    b.appendChild(ic);\n  }\n  return b;\n}\n\npagination.appendChild(arrowBtn('Previous'));\nconst pageNums = figma.createFrame();\npageNums.fills = [];\npageNums.layoutMode = 'HORIZONTAL';\npageNums.itemSpacing = 4;\npageNums.counterAxisSizingMode = 'AUTO';\npageNums.primaryAxisSizingMode = 'AUTO';\npageNums.appendChild(pageBtn('1', { active: true }));\npageNums.appendChild(pageBtn('2'));\npageNums.appendChild(pageBtn('3'));\npageNums.appendChild(pageBtn('...', { disabled: true }));\npageNums.appendChild(pageBtn('8'));\npageNums.appendChild(pageBtn('9'));\npageNums.appendChild(pageBtn('10'));\npagination.appendChild(pageNums);\npagination.appendChild(arrowBtn('Next'));\nprodArea.appendChild(pagination);\n\ncontent.appendChild(prodArea);\n\nreturn { prodAreaId: prodArea.id };\n","description":"Build Products grid and Pagination for 02_Category","fileKey":"5S6WFXEo4QEfJTtE7MFltz"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"c5b3498c-81e1-408a-9e23-797293d6b873","uuid":"b0af19bd-b315-4885-a523-7d57acdf6cef","timestamp":"2026-11-03T07:30:15.992Z","tool_use_meta":[{"id":"mcp__figma__use_figma_44_c0f45657","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
