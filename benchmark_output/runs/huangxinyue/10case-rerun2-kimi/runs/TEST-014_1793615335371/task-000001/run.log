teRectangle(); hair.resize(414,1); hair.x=0;hair.y=0;hair.fills=[{type:'SOLID',color:line}]; tabBar.appendChild(hair);\nconst tabs=[['Main','Main',true],['Payments','Payments',false],['Cashback','Cashback',false],['Invest','Invest',false],['More','More',false]];\nlet tx=0; const tw=414/5;\nfor (const [label,key,active] of tabs){\n  const col=active?brand:ink2;\n  const ic=await iconInst(key); ic.resize(24,24); ic.x=tx+tw/2-12; ic.y=10; tabBar.appendChild(ic); paint(ic,col); ic.name='Icon_'+label;\n  const t=txt(label,10,'Medium',col); t.x=tx+tw/2-t.width/2; t.y=38; tabBar.appendChild(t); t.name='Label_'+label;\n  tx+=tw;\n}\nids.tabBar=tabBar.id;\n\n// ---- Quick Action ----\nconst qa=figma.createComponent(); qa.name='Quick Action'; qa.resize(80,74); qa.fills=[]; lib.appendChild(qa); qa.x=430; qa.y=0;\nconst qbg=figma.createRectangle(); qbg.resize(48,48); qbg.cornerRadius=16; qbg.fills=[{type:'SOLID',color:surface}]; qbg.strokes=[{type:'SOLID',color:line}]; qbg.strokeWeight=1; qbg.x=16; qbg.y=0; qa.appendChild(qbg);\nconst qic=await iconInst('Card'); qic.resize(24,24); qic.x=28; qic.y=12; qa.appendChild(qic); paint(qic,ink); qic.name='Icon';\nconst ql=txt('Label',12,'Medium',ink); ql.x=40-ql.width/2; ql.y=56; qa.appendChild(ql); ql.name='Label';\nids.quickAction=qa.id;\n\n// ---- History Row ----\nconst hr=figma.createComponent(); hr.name='History Row'; hr.resize(374,64); hr.fills=[]; lib.appendChild(hr); hr.x=530; hr.y=0;\nconst hbg=figma.createRectangle(); hbg.resize(40,40); hbg.cornerRadius=14; hbg.fills=[{type:'SOLID',color:softGray}]; hbg.x=0; hbg.y=12; hr.appendChild(hbg);\nconst hic=await iconInst('Location'); hic.resize(20,20); hic.x=10; hic.y=22; hr.appendChild(hic); paint(hic,ink); hic.name='Icon';\nconst ht=txt('Title',15,'Semi Bold',ink); ht.x=56; ht.y=10; hr.appendChild(ht); ht.name='Title';\nconst hs=txt('Subtitle',12,'Regular',ink2); hs.x=56; hs.y=33; hr.appendChild(hs); hs.name='Subtitle';\nconst ha=txt('−$560',15,'Semi Bold',ink); ha.textAlignHorizontal='RIGHT'; ha.resize(160,ha.height); ha.x=214; ha.y=10; hr.appendChild(ha); ha.name='Amount';\nids.historyRow=hr.id;\n\n// ---- Stock Row ----\nconst sr=figma.createComponent(); sr.name='Stock Row'; sr.resize(374,64); sr.fills=[{type:'SOLID',color:surface}]; sr.cornerRadius=16; lib.appendChild(sr); sr.x=530; sr.y=90;\nconst sl=await iconInst('Apple'); sl.resize(40,40); sl.x=12; sl.y=12; sr.appendChild(sl); sl.name='Logo';\nconst st=txt('AAPL',16,'Semi Bold',ink); st.x=64; st.y=13; sr.appendChild(st); st.name='Ticker';\nconst sp=txt('$143.43',15,'Semi Bold',ink); sp.textAlignHorizontal='RIGHT'; sp.resize(120,sp.height); sp.x=242; sp.y=10; sr.appendChild(sp); sp.name='Price';\nconst sc=txt('+31.62 (28.28%)',12,'Medium',green); sc.textAlignHorizontal='RIGHT'; sc.resize(160,sc.height); sc.x=202; sc.y=34; sr.appendChild(sc); sc.name='Change';\nids.stockRow=sr.id;\n\n// ---- Keypad Key ----\nconst kk=figma.createComponent(); kk.name='Keypad Key'; kk.resize(110,60); kk.fills=[]; lib.appendChild(kk); kk.x=530; kk.y=180;\nconst kd=txt('2',28,'Medium',ink); kd.x=55-kd.width/2; kd.y=4; kk.appendChild(kd); kd.name='Digit';\nconst kl=txt('ABC',10,'Medium',ink2); kl.x=55-kl.width/2; kl.y=40; kk.appendChild(kl); kl.name='Letters';\nids.keypadKey=kk.id;\n\n// ---- Account Row ----\nconst ar=figma.createComponent(); ar.name='Account Row'; ar.resize(374,68); ar.fills=[{type:'SOLID',color:surface}]; ar.cornerRadius=16; lib.appendChild(ar); ar.x=0; ar.y=90;\nconst ac=figma.createEllipse(); ac.resize(40,40); ac.x=12; ac.y=14; ac.fills=[{type:'SOLID',color:softRed}]; ar.appendChild(ac);\nconst acs=txt('$',16,'Semi Bold',brand); acs.x=32-acs.width/2; acs.y=24; ar.appendChild(acs); acs.name='Symbol';\nconst at=txt('USD account',15,'Semi Bold',ink); at.x=64; at.y=13; ar.appendChild(at); at.name='Title';\nconst ab=txt('$18,943.43',13,'Regular',ink2); ab.x=64; ab.y=35; ar.appendChild(ab); ab.name='Balance';\nconst ring=figma.createEllipse(); ring.resize(22,22); ring.x=340; ring.y=23; ring.fills=[]; ring.strokes=[{type:'SOLID',color:brand}]; ring.strokeWeight=2; ar.appendChild(ring); ring.name='Radio';\nconst dot=figma.createEllipse(); dot.resize(10,10); dot.x=346; dot.y=29; dot.fills=[{type:'SOLID',color:brand}]; ar.appendChild(dot); dot.name='Dot';\nids.accountRow=ar.id;\n\nlib.resize(1200, 280);\nreturn ids;\n","description":"Create reusable components: Tab Bar, Quick Action, History Row, Stock Row, Keypad Key, Account Row","fileKey":"atiEUxu12QVUXf9mpT2DgG"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"6a558fc7-699a-4150-ad66-1b2df7225d3f","uuid":"76f206d7-2541-4f7f-830d-eb891450da7b","timestamp":"2026-11-02T10:40:25.648Z","tool_use_meta":[{"id":"mcp__figma__use_figma_0_5067edd3","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
