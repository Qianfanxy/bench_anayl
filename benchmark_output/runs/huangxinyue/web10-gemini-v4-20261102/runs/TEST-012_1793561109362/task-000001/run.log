0, b: 0, a: 0.6 } }];\n    timeTag.appendChild(timeTxt);\n    tagsRow.appendChild(timeTag);\n\n    const catTag = figma.createFrame();\n    catTag.fills = [];\n    catTag.layoutMode = \"HORIZONTAL\";\n    catTag.itemSpacing = 8;\n    catTag.counterAxisAlignItems = \"CENTER\";\n    const catIcon = getInst(\"Icon_Fork_Knife\");\n    catIcon.resize(18, 18);\n    catTag.appendChild(catIcon);\n    const catTxt = figma.createText();\n    catTxt.characters = categoryText;\n    catTxt.fontSize = 14;\n    catTxt.fontName = { family: \"Inter\", style: \"Medium\" };\n    catTxt.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0, a: 0.6 } }];\n    catTag.appendChild(catTxt);\n    tagsRow.appendChild(catTag);\n\n    card.appendChild(tagsRow);\n    return card;\n  }\n\n  // --- BUILD 04_BLOG_POST ---\n  const postFrame = figma.createFrame();\n  postFrame.name = \"04_Blog_Post\";\n  postFrame.resize(1440, 3900);\n  postFrame.x = 4800;\n  postFrame.y = 0;\n  postFrame.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  workspace.appendChild(postFrame);\n\n  let curY = 40;\n\n  // Header\n  const header = createHeader(\"Blog\");\n  header.x = 80;\n  header.y = curY;\n  postFrame.appendChild(header);\n\n  curY += 80 + 40;\n\n  // Article Title Block\n  const titleBlock = figma.createFrame();\n  titleBlock.name = \"Article Title and Meta\";\n  titleBlock.resize(1280, 240);\n  titleBlock.x = 80;\n  titleBlock.y = curY;\n  titleBlock.fills = [];\n  titleBlock.layoutMode = \"VERTICAL\";\n  titleBlock.primaryAxisAlignItems = \"CENTER\";\n  titleBlock.counterAxisAlignItems = \"CENTER\";\n  titleBlock.itemSpacing = 24;\n\n  const aTitle = figma.createText();\n  aTitle.characters = \"Full Guide to Becoming a Professional Chef\";\n  aTitle.fontSize = 48;\n  aTitle.fontName = { family: \"Inter\", style: \"Bold\" };\n  aTitle.textAlignHorizontal = \"CENTER\";\n  aTitle.resize(1000, 120);\n  titleBlock.appendChild(aTitle);\n\n  // Author details row\n  const metaRow = figma.createFrame();\n  metaRow.name = \"Meta Info\";\n  metaRow.fills = [];\n  metaRow.layoutMode = \"HORIZONTAL\";\n  metaRow.itemSpacing = 24;\n  metaRow.counterAxisAlignItems = \"CENTER\";\n\n  const av = getInst(\"Avatar_Dianne_Russell\");\n  av.resize(40, 40);\n  metaRow.appendChild(av);\n\n  const authName = figma.createText();\n  authName.characters = \"Dianne Russell\";\n  authName.fontSize = 15;\n  authName.fontName = { family: \"Inter\", style: \"Bold\" };\n  metaRow.appendChild(authName);\n\n  const vDiv = figma.createRectangle();\n  vDiv.resize(1, 16);\n  vDiv.fills = [{ type: \"SOLID\", color: { r: 0.8, g: 0.8, b: 0.8 } }];\n  metaRow.appendChild(vDiv);\n\n  const dateTxt = figma.createText();\n  dateTxt.characters = \"12 November 2021\";\n  dateTxt.fontSize = 14;\n  dateTxt.fontName = { family: \"Inter\", style: \"Medium\" };\n  dateTxt.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0, a: 0.6 } }];\n  metaRow.appendChild(dateTxt);\n\n  titleBlock.appendChild(metaRow);\n  postFrame.appendChild(titleBlock);\n\n  curY += 240 + 40;\n\n  // Intro text\n  const introNode = figma.createText();\n  introNode.name = \"Article Intro\";\n  introNode.characters = \"We asked a working head chef about first jobs, long services and what it really takes to make it in a professional kitchen.\";\n  introNode.fontSize = 18;\n  introNode.fontName = { family: \"Inter\", style: \"Regular\" };\n  introNode.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0, a: 0.8 } }];\n  introNode.textAlignHorizontal = \"CENTER\";\n  introNode.x = 80;\n  introNode.y = curY;\n  introNode.resize(1280, 60);\n  postFrame.appendChild(introNode);\n\n  curY += 60 + 40;\n\n  // Large Hero Image\n  const heroImg = getInst(\"Photo_Blog_Chef\");\n  heroImg.name = \"Article Hero Photo\";\n  heroImg.resize(1280, 600);\n  heroImg.cornerRadius = 30;\n  heroImg.x = 80;\n  heroImg.y = curY;\n  postFrame.appendChild(heroImg);\n\n  curY += 600 + 60;\n\n  // 2-Column Article Content (Left Content 800px / Right Share Column 160px)\n  const contentColumns = figma.createFrame();\n  contentColumns.name = \"Article Content Block\";\n  contentColumns.resize(1280, 1400);\n  contentColumns.x = 80;\n  contentColumns.y = curY;\n  contentColumns.fills = [];\n  contentColumns.layoutMode = \"HORIZONTAL\";\n  contentColumns.itemSpacing = 60;\n\n  // Left Column (Questions + Answers + Pull quote)\n  const leftCol = figma.createFrame();\n  leftCol.name = \"Left Column - Story\";\n  leftCol.resize(900, 1400);\n  leftCol.fills = [];\n  leftCol.layoutMode = \"VERTICAL\";\n  leftCol.itemSpacing = 40;\n\n  // Helpers to add Question & Answer\n  function addQAndA(container, q, a) {\n    const qNode = figma.createText();\n    qNode.characters = q;\n    qNode.fontSize = 22;\n    qNode.fontName = { family: \"Inter\", style: \"Bold\" };\n    qNode.resize(900, 32);\n\n    const aNode = figma.createText();\n    aNode.characters = a;\n    aNode.fontSize = 16;\n    aNode.fontName = { family: \"Inter\", style: \"Regular\" };\n    aNode.fills = [{ type: \"SOLID\", color: { r: 0.2, g: 0.2, b: 0.2 } }];\n    aNode.resize(900, 100);\n\n    container.appendChild(qNode);\n    container.appendChild(aNode);\n  }\n\n  // Q1\n  addQAndA(leftCol,\n    \"How did you start out in the food industry?\",\n    \"I started washing dishes in a small family restaurant when I was sixteen. Watching the line cooks every night made me want to be on the other side of the pass, and after two years the chef finally let me prep vegetables.\"\n  );\n\n  // Q2\n  addQAndA(leftCol,\n    \"What do you like most about your job?\",\n    \"The rhythm of service. Hours of preparation come down to a few intense minutes, and when a full dining room goes quiet because everyone is eating, it feels like the whole team has done something together.\"\n  );\n\n  // Q3\n  addQAndA(leftCol,\n    \"Do you cook at home on your days off?\",\n    \"Yes, but simply. I cook the food I grew up with: rice, eggs and whatever vegetables look good at the market. Home cooking is where I remember why I love food.\"\n  );\n\n  // Cooking Step Photo after Q3\n  const stepImg = getInst(\"Photo_Cooking_Step\");\n  stepImg.resize(900, 480);\n  stepImg.cornerRadius = 24;\n  leftCol.appendChild(stepImg);\n\n  // Q4\n  addQAndA(leftCol,\n    \"What would your advice be to young people looking to get their foot in the door?\",\n    \"Start anywhere and be the person who shows up early. Ask questions, taste everything and write down what you learn.\"\n  );\n\n  // Pull quote\n  const pullQuote = figma.createFrame();\n  pullQuote.name = \"Pull Quote\";\n  pullQuote.resize(900, 120);\n  pullQuote.fills = [{ type: \"SOLID\", color: { r: 0.9058823529, g: 0.9764705882, b: 0.9921568627 } }];\n  pullQuote.cornerRadius = 24;\n  pullQuote.paddingLeft = 40;\n  pullQuote.paddingRight = 40;\n  pullQuote.layoutMode = \"VERTICAL\";\n  pullQuote.primaryAxisAlignItems = \"CENTER\";\n\n  const pqText = figma.createText();\n  pqText.characters = \"“Technique can be taught; curiosity and reliability can’t.”\";\n  pqText.fontSize = 24;\n  pqText.fontName = { family: \"Inter\", style: \"Medium\" };\n  pqText.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0 } }];\n  pqText.resize(820, 60);\n  pullQuote.appendChild(pqText);\n\n  leftCol.appendChild(pullQuote);\n\n  // Q5\n  addQAndA(leftCol,\n    \"What is the biggest misconception that people have about being a professional chef?\",\n    \"That it is all creativity. Most of the job is consistency: making the same dish perfectly two hundred times a night, keeping the kitchen clean and looking after your team.\"\n  );\n\n  contentColumns.appendChild(leftCol);\n\n  // Right Column (Share vertical container)\n  const rightCol = figma.createFrame();\n  rightCol.name = \"Right Column - Share\";\n  rightCol.resize(320, 400);\n  rightCol.fills = [];\n  rightCol.layoutMode = \"VERTICAL\";\n  rightCol.itemSpacing = 24;\n  rightCol.counterAxisAlignItems = \"CENTER\";\n\n  const shareTitle = figma.createText();\