roperties(pr);};\nconst put=(p,n,x,y)=>{p.appendChild(n);n.x=x;n.y=y;return n;};\nconst screen=(name,x,bg)=>{const f=figma.createFrame();f.name=name;f.resize(414,896);f.x=x;f.y=0;f.fills=P(bg||K.bg);f.clipsContent=true;return f;};\nconst shadow=(a,y,r)=>[{type:'DROP_SHADOW',color:{r:0.1,g:0.1,b:0.12,a},offset:{x:0,y},radius:r,spread:0,visible:true,blendMode:'NORMAL'}];\nconst out={};\n// ===== 03 =====\nconst s3=screen('03_Create_PIN',988);out.s3=s3.id;\nput(s3,await inst('1:33'),0,0);\nconst h3=await inst('8:111');h3.name='Header';sp(h3,{Title:'Create PIN code','Show menu':false,'Show chart':false,'Show insights':false});put(s3,h3,0,44);\nconst intro=T('Set a 4-digit code to protect your brokerage account',15,'Regular',K.ink2,{lh:22,align:'CENTER'});intro.textAutoResize='HEIGHT';intro.resize(300,intro.height);put(s3,intro,57,140);\nconst slots=figma.createFrame();slots.name='PIN · 3 of 4';AL(slots,'HORIZONTAL',{gap:16});\nfor(const d of ['9','7','7']){const s=await inst('10:108','State=Filled');s.name='Slot · '+d;sp(s,{Digit:d});slots.appendChild(s);}\nconst a=await inst('10:108','State=Active');a.name='Slot · empty (next)';slots.appendChild(a);\nput(s3,slots,(414-(64*4+48))/2,212);\nconst prog=figma.createFrame();prog.name='Progress';AL(prog,'HORIZONTAL',{gap:6,cross:'CENTER'});\nfor(const i of [0,1,2,3]){const d=figma.createEllipse();d.resize(8,8);d.fills=P(i<3?K.brand:'#D5D8E1');prog.appendChild(d);}\nprog.appendChild(T('3 of 4',13,'Medium',K.ink2));put(s3,prog,0,312);prog.x=(414-prog.width)/2;\nconst kp=await inst('10:119');kp.name='PIN Keypad';put(s3,kp,0,896-kp.height);\nconst rb=await inst('1:23');rb.name='Ready';rb.findOne(n=>n.type==='TEXT').characters='Ready';put(s3,rb,20,896-kp.height-24-56);\nput(s3,await inst('1:44'),0,862);out.kpH=kp.height;\n// ===== 04 =====\nconst s4=screen('04_Portfolio',1482);out.s4=s4.id;\nput(s4,await inst('1:33'),0,0);\nconst h4=await inst('8:111');h4.name='Header';sp(h4,{Title:'Investment Portfolio','Show menu':true,'Show cha