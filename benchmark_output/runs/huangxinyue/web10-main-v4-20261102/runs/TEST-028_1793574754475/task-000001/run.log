a:'CENTER'});\n  chip.appendChild(T('5 min read',12,S.semi,'#3F6B12',{lh:16,name:'Label'}));\n  meta.appendChild(chip);\n  meta.appendChild(inst('2:3',20,COL.ink));\n  c.appendChild(meta);\n  c.appendChild(T('How a Digital Marketing Agency Can Boost Your Business',21,S.semi,COL.ink,{w:384,lh:28,name:'Title'}));\n  c.appendChild(T('We are the top digital marketing agency for branding corp. We offer a full range of services to help clients improve their search engine rankings.',15,S.reg,COL.body,{w:360,lh:23,name:'Excerpt'}));\n  sec.appendChild(c);\n}\n// ===== FAQ ITEM =====\nif(!exists('FAQ Item')){\n  const sec=bsec('FAQ item','VERTICAL');\n  const mk=(state)=>{\n    const c=figma.createComponent(); c.name='state='+state; c.fills=[]; c.strokes=[];\n    c.layoutMode='VERTICAL'; c.primaryAxisSizingMode='AUTO'; c.counterAxisSizingMode='FIXED'; c.resize(720,88); c.itemSpacing=14; c.clipsContent=false;\n    const row=lbox('Question row',720,88,{dir:'HORIZONTAL',ca:'CENTER'}); row.fills=[]; row.primaryAxisAlignItems='SPACE_BETWEEN';\n    row.appendChild(T('Why is digital marketing important for my business?',18,S.semi,COL.ink,{lh:24,w:590,name:'Question'}));\n    const tb=box('Toggle',46,46,{fill:state==='Expanded'?COL.ink:COL.white,radius:23});\n    tb.strokes=[solid(state==='Expanded'?COL.ink:COL.line)]; tb.strokeWeight=1; tb.strokeAlign='INSIDE';\n    tb.layoutMode='HORIZONTAL'; tb.primaryAxisAlignItems='CENTER'; tb.counterAxisAlignItems='CENTER';\n    tb.primaryAxisSizingMode='FIXED'; tb.counterAxisSizingMode='FIXED'; tb.resize(46,46);\n    tb.appendChild(inst(state==='Expanded'?'2:8':'2:11',18,state==='Expanded'?COL.white:COL.ink));\n    row.appendChild(tb);\n    c.appendChild(row);\n    if(state==='Expanded'){\n      c.appendChild(T('Digital marketing allows businesses to reach and engage with a wider audience, generate leads, drive website traffic, and increase brand visibility. It provides measurable results, allows for targeted marketing efforts, and enables bu