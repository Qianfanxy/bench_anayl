acters = \"1111000065665144\"; r3V.fontSize = 16; r3V.fills = [{ type: 'SOLID', color: TEXT_WHITE }]; r3Left.appendChild(r3V);\n  r3.appendChild(r3Left);\n\n  const copyBtn = figma.createFrame();\n  copyBtn.name = \"Button_Copy\";\n  copyBtn.fills = [];\n  copyBtn.layoutMode = \"HORIZONTAL\";\n  copyBtn.itemSpacing = 4;\n  copyBtn.counterAxisAlignItems = \"CENTER\";\n  const copyIcon = getInstance(\"2:91\");\n  if (copyIcon) copyBtn.appendChild(copyIcon);\n  const copyTxt = figma.createText();\n  copyTxt.fontName = { family: \"Roboto\", style: \"Bold\" };\n  copyTxt.characters = \"Salin\";\n  copyTxt.fontSize = 12;\n  copyTxt.fills = [{ type: 'SOLID', color: GREEN_GAIN }];\n  copyBtn.appendChild(copyTxt);\n  r3.appendChild(copyBtn);\n\n  payCard.appendChild(r3);\n  scroll6.appendChild(payCard);\n\n  // Payment Guide Section: Guide: “Panduan Pembayaran” · 6 steps (see DATA)\n  /*\n  1. Catat kode pembayaran di atas dan datang ke gerai Alfamart, Alfa Midi, Lawson atau DAN+DAN terdekat.\n  2. Beritahukan ke kasir bahwa Anda ingin melakukan pembayaran.\n  3. Kasir akan menanyakan kode pembayaran. Berikan kode pembayaran Anda 1111000065665144.\n  4. Kasir akan melakukan konfirmasi data konsumen berupa Nama Merchant, Nama Konsumen, dan Nominal. Lakukan pembayaran ke kasir sejumlah nominal yang disebutkan.\n  5. Terima struk sebagai bukti pembayaran sudah sukses dilakukan. Notifikasi pembayaran akan langsung diterima oleh Merchant.\n  6. Selesai.\n  */\n  const guideSec = figma.createFrame();\n  guideSec.name = \"Payment Guide Section\";\n  guideSec.resize(343, 300);\n  guideSec.fills = [];\n  guideSec.layoutMode = \"VERTICAL\";\n  guideSec.itemSpacing = 12;\n\n  const gTitle = figma.createText();\n  gTitle.fontName = { family: \"Roboto\", style: \"Bold\" };\n  gTitle.characters = \"Panduan Pembayaran\";\n  gTitle.fontSize = 16;\n  gTitle.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n  guideSec.appendChild(gTitle);\n\n  const stepsData = [\n    \"Catat kode pembayaran di atas dan datang ke gerai Alfamart, Alfa Midi, Lawson atau DAN+DAN terdekat.\",\n    \"Beritahukan ke kasir bahwa Anda ingin melakukan pembayaran.\",\n    \"Kasir akan menanyakan kode pembayaran. Berikan kode pembayaran Anda 1111000065665144.\",\n    \"Kasir akan melakukan konfirmasi data konsumen berupa Nama Merchant, Nama Konsumen, dan Nominal. Lakukan pembayaran ke kasir sejumlah nominal yang disebutkan.\",\n    \"Terima struk sebagai bukti pembayaran sudah sukses dilakukan. Notifikasi pembayaran akan langsung diterima oleh Merchant.\",\n    \"Selesai.\"\n  ];\n\n  stepsData.forEach((st, idx) => {\n    const sRow = figma.createFrame();\n    sRow.name = `Guide_Step_${idx + 1}`;\n    sRow.resize(343, 36);\n    sRow.fills = [];\n    sRow.layoutMode = \"HORIZONTAL\";\n    sRow.itemSpacing = 10;\n    sRow.counterAxisAlignItems = \"MIN\";\n\n    const numDot = figma.createFrame();\n    numDot.resize(20, 20);\n    numDot.fills = [{ type: 'SOLID', color: CARD_BG }];\n    numDot.cornerRadius = 10;\n    numDot.layoutMode = \"HORIZONTAL\";\n    numDot.primaryAxisAlignItems = \"CENTER\";\n    numDot.counterAxisAlignItems = \"CENTER\";\n    const numTxt = figma.createText();\n    numTxt.fontName = { family: \"Roboto\", style: \"Bold\" };\n    numTxt.characters = `${idx + 1}`;\n    numTxt.fontSize = 11;\n    numTxt.fills = [{ type: 'SOLID', color: GREEN_GAIN }];\n    numDot.appendChild(numTxt);\n    sRow.appendChild(numDot);\n\n    const stTxt = figma.createText();\n    stTxt.fontName = { family: \"Roboto\", style: \"Regular\" };\n    stTxt.characters = st;\n    stTxt.fontSize = 12;\n    stTxt.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n    stTxt.resize(310, 36); // word wrap width\n    stTxt.textAutoResize = \"HEIGHT\";\n    sRow.appendChild(stTxt);\n\n    guideSec.appendChild(sRow);\n  });\n\n  scroll6.appendChild(guideSec);\n  f6.appendChild(scroll6);\n\n  // Fixed Bottom Action Bar: Action: Oke\n  const okeBar = figma.createFrame();\n  okeBar.name = \"Action Bar\";\n  okeBar.resize(375, 70);\n  okeBar.x = 0; okeBar.y = 812 - 70;\n  okeBar.fills = [{ type: 'SOLID', color: CARD_BG }];\n  okeBar.strokes = [{ type: 'SOLID', color: BORDER_COLOR }];\n  okeBar.strokeWeight = 1;\n  okeBar.layoutMode = \"HORIZONTAL\";\n  okeBar.primaryAxisAlignItems = \"CENTER\";\n  okeBar.counterAxisAlignItems = \"CENTER\";\n  okeBar.paddingLeft = 16; okeBar.paddingRight = 16;\n\n  const okeBtn = figma.createFrame();\n  okeBtn.name = \"Button_Oke\";\n  okeBtn.resize(343, 44);\n  okeBtn.fills = [{ type: 'SOLID', color: GREEN_GAIN }];\n  okeBtn.cornerRadius = 22;\n  okeBtn.layoutMode = \"HORIZONTAL\";\n  okeBtn.primaryAxisAlignItems = \"CENTER\";\n  okeBtn.counterAxisAlignItems = \"CENTER\";\n\n  const oTxt = figma.createText();\n  oTxt.fontName = { family: \"Roboto\", style: \"Bold\" };\n  oTxt.characters = \"Oke\";\n  oTxt.fontSize = 15;\n  oTxt.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n  okeBtn.appendChild(oTxt);\n  okeBar.appendChild(okeBtn);\n\n  f6.appendChild(okeBar);\n\n  addShell(f6);\n  workspace.appendChild(f6);\n\n  return \"Frame 06_Top_Up_Pembayaran created successfully\";\n})()","description":"Build frame 06_Top_Up_Pembayaran in 03 · Workspace","fileKey":"JFBzRSGrqYhoiYPN8CHLgF"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":55066,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"29675d63-ebdc-41c5-b9bc-94637defa1d1","uuid":"cdfe14d8-ea30-454d-b57e-0257600e0b8c","timestamp":"2026-10-31T19:54:54.129Z","tool_use_meta":[{"id":"call_07b44e9b77c448ac9c9ffdee7cfe7048","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
