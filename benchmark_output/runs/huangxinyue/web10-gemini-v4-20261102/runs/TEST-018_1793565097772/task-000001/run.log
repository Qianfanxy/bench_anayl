r: WHITE }];\n    artCard.strokes = [{ type: 'SOLID', color: GRAY_200 }];\n    artCard.strokeWeight = 1;\n    artCard.paddingLeft = 24;\n    artCard.paddingRight = 24;\n    artCard.paddingTop = 24;\n    artCard.paddingBottom = 24;\n    artCard.layoutMode = \"VERTICAL\";\n    artCard.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n\n    const artContent = figma.createFrame();\n    artContent.layoutMode = \"VERTICAL\";\n    artContent.itemSpacing = 16;\n    artContent.fills = [];\n    artContent.layoutAlign = \"STRETCH\";\n\n    const readTime = figma.createText();\n    readTime.fontName = fontSemiBold;\n    readTime.fontSize = 13;\n    readTime.characters = \"5 min read\";\n    readTime.fills = [{ type: 'SOLID', color: GRAY_500 }];\n\n    const artTitle = figma.createText();\n    artTitle.fontName = fontBold;\n    artTitle.fontSize = 20;\n    artTitle.lineHeight = { value: 28, unit: 'PIXELS' };\n    artTitle.characters = art.title;\n    artTitle.fills = [{ type: 'SOLID', color: INK }];\n    artTitle.layoutAlign = \"STRETCH\";\n\n    const artExcerpt = figma.createText();\n    artExcerpt.fontName = fontRegular;\n    artExcerpt.fontSize = 15;\n    artExcerpt.lineHeight = { value: 24, unit: 'PIXELS' };\n    artExcerpt.characters = art.excerpt;\n    artExcerpt.fills = [{ type: 'SOLID', color: GRAY_600 }];\n    artExcerpt.layoutAlign = \"STRETCH\";\n\n    artContent.appendChild(readTime);\n    artContent.appendChild(artTitle);\n    artContent.appendChild(artExcerpt);\n\n    // Open Action Row (Icon_Arrow_Right)\n    const openRow = figma.createFrame();\n    openRow.name = \"Open_Action\";\n    openRow.layoutMode = \"HORIZONTAL\";\n    openRow.primaryAxisAlignItems = \"MAX\";\n    openRow.layoutAlign = \"STRETCH\";\n    openRow.fills = [];\n\n    const openCircle = figma.createFrame();\n    openCircle.resize(40, 40);\n    openCircle.cornerRadius = 20;\n    openCircle.fills = [{ type: 'SOLID', color: GRAY_100 }];\n    openCircle.layoutMode = \"HORIZONTAL\";\n    openCircle.prim