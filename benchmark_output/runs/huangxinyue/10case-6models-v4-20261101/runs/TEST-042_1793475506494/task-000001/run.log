Mode = 'HORIZONTAL';\n  accountHeader.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  accountHeader.counterAxisAlignItems = 'CENTER';\n  accountHeader.fills = [];\n  accountHeader.resize(390, 48);\n\n  const userGroup = figma.createFrame();\n  userGroup.layoutMode = 'HORIZONTAL';\n  userGroup.counterAxisAlignItems = 'CENTER';\n  userGroup.itemSpacing = 12;\n  userGroup.fills = [];\n\n  const avatar = masterPhotoAvatar.createInstance();\n  avatar.resize(44, 44);\n  avatar.cornerRadius = 22;\n  userGroup.appendChild(avatar);\n\n  const nameGroup = figma.createFrame();\n  nameGroup.layoutMode = 'VERTICAL';\n  nameGroup.itemSpacing = 2;\n  nameGroup.fills = [];\n\n  const greeting = figma.createText();\n  greeting.fontName = { family: 'Inter', style: 'Bold' };\n  greeting.fontSize = 18;\n  greeting.characters = 'Hi, Paul';\n  greeting.fills = [{ type: 'SOLID', color: COLOR_DARK }];\n  nameGroup.appendChild(greeting);\n\n  const subGreeting = figma.createText();\n  subGreeting.fontName = { family: 'Inter', style: 'Regular' };\n  subGreeting.fontSize = 12;\n  subGreeting.characters = 'Where do you want to explore?';\n  subGreeting.fills = [{ type: 'SOLID', color: COLOR_GRAY_TEXT }];\n  nameGroup.appendChild(subGreeting);\n\n  userGroup.appendChild(nameGroup);\n  accountHeader.appendChild(userGroup);\n\n  // Points Badge: 2,000 points (Icon_Coin)\n  const pointsBadge = figma.createFrame();\n  pointsBadge.layoutMode = 'HORIZONTAL';\n  pointsBadge.counterAxisAlignItems = 'CENTER';\n  pointsBadge.itemSpacing = 6;\n  pointsBadge.paddingLeft = 10; pointsBadge.paddingRight = 12;\n  pointsBadge.paddingTop = 6; pointsBadge.paddingBottom = 6;\n  pointsBadge.cornerRadius = 16;\n  pointsBadge.fills = [{ type: 'SOLID', color: { r: 1, g: 0.96, b: 0.88 } }]; // warm light orange/yellow background\n\n  const coinIcon = masterIconCoin.createInstance();\n  recolorNode(coinIcon, COLOR_GOLD);\n  coinIcon.resize(18, 18);\n  pointsBadge.appendChild(coinIcon);\n\n  const pointsText = figma.createText();\n  pointsText.fontName = { family: 'Inter', style: 'Semi Bold' };\n  pointsText.fontSize = 13;\n  pointsText.characters = '2,000 pts';\n  pointsText.fills = [{ type: 'SOLID', color: { r: 0.7, g: 0.45, b: 0 } }];\n  pointsBadge.appendChild(pointsText);\n\n  accountHeader.appendChild(pointsBadge);\n  homeScroll.appendChild(accountHeader);\n\n  // 2. Search Bar: “Where to go?” (Icon_Search)\n  const searchBar = figma.createFrame();\n  searchBar.name = 'Search Bar';\n  searchBar.layoutMode = 'HORIZONTAL';\n  searchBar.counterAxisAlignItems = 'CENTER';\n  searchBar.itemSpacing = 12;\n  searchBar.paddingLeft = 16; searchBar.paddingRight = 16;\n  searchBar.resize(390, 48);\n  searchBar.cornerRadius = 14;\n  searchBar.fills = [{ type: 'SOLID', color: COLOR_WHITE }];\n  searchBar.strokes = [{ type: 'SOLID', color: COLOR_BORDER }];\n  searchBar.strokeWeight = 1;\n\n  const searchIcon = masterIconSearch.createInstance();\n  recolorNode(searchIcon, COLOR_GRAY_TEXT);\n  searchIcon.resize(20, 20);\n  searchBar.appendChild(searchIcon);\n\n  const searchText = figma.createText();\n  searchText.fontName = { family: 'Inter', style: 'Regular' };\n  searchText.fontSize = 15;\n  searchText.characters = 'Where to go?';\n  searchText.fills = [{ type: 'SOLID', color: COLOR_GRAY_TEXT }];\n  searchBar.appendChild(searchText);\n\n  homeScroll.appendChild(searchBar);\n\n  // 3. Categories: Bus · Ferry · Flights · Hotels · Trains, each with its icon\n  const catSection = figma.createFrame();\n  catSection.name = 'Categories';\n  catSection.layoutMode = 'HORIZONTAL';\n  catSection.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  catSection.fills = [];\n  catSection.resize(390, 72);\n\n  const catItems = [\n    { name: 'Flights', icon: masterIconFlight },\n    { name: 'Hotels', icon: masterIconHotel },\n    { name: 'Trains', icon: masterIconTrain },\n    { name: 'Ferry', icon: masterIconFerry },\n    { name: 'Bus', icon: masterIconBus }\n  ];\n\n  for (const cat of catItems) {\n    const catBox = figma.createFrame();\n    catBox.layoutMode = 'VERTICAL';\n    catBox.primaryAxisAlignItems = 'CENTER';\n    catBox.counterAxisAlignItems = 'CENTER';\n    catBox.itemSpacing = 6;\n    catBox.fills = [];\n\n    const iconCircle = figma.createFrame();\n    iconCircle.resize(48, 48);\n    iconCircle.cornerRadius = 14;\n    iconCircle.fills = [{ type: 'SOLID', color: COLOR_WHITE }];\n    iconCircle.strokes = [{ type: 'SOLID', color: COLOR_BORDER }];\n    iconCircle.strokeWeight = 1;\n    iconCircle.layoutMode = 'HORIZONTAL';\n    iconCircle.primaryAxisAlignItems = 'CENTER';\n    iconCircle.counterAxisAlignItems = 'CENTER';\n\n    const catIconInst = cat.icon.createInstance();\n    recolorNode(catIconInst, COLOR_TEAL);\n    catIconInst.resize(22, 22);\n    iconCircle.appendChild(catIconInst);\n\n    catBox.appendChild(iconCircle);\n\n    const catLabel = figma.createText();\n    catLabel.fontName = { family: 'Inter', style: 'Medium' };\n    catLabel.fontSize = 12;\n    catLabel.characters = cat.name;\n    catLabel.fills = [{ type: 'SOLID', color: COLOR_DARK }];\n    catBox.appendChild(catLabel);\n\n    catSection.appendChild(catBox);\n  }\n\n  homeScroll.appendChild(catSection);\n\n  // 4. Upcoming Flight Ticket:\n  // Status: Upcoming · 24 March 2024\n  // CGK 05:30 → DPS 08:00 · 1h 30m\n  // Sentosa Air · Economy · Direct\n  // Booking ID: ZEEBAW\n  const flightCard = figma.createFrame();\n  flightCard.name = 'Upcoming Flight Ticket';\n  flightCard.resize(390, 180);\n  flightCard.cornerRadius = 20;\n  flightCard.fills = [{ type: 'SOLID', color: COLOR_TEAL }];\n  flightCard.layoutMode = 'VERTICAL';\n  flightCard.paddingLeft = 20; flightCard.paddingRight = 20;\n  flightCard.paddingTop = 16; flightCard.paddingBottom = 16;\n  flightCard.itemSpacing = 12;\n\n  // Header row: Status + Date\n  const flightTopRow = figma.createFrame();\n  flightTopRow.layoutMode = 'HORIZONTAL';\n  flightTopRow.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  flightTopRow.counterAxisAlignItems = 'CENTER';\n  flightTopRow.fills = [];\n  flightTopRow.resize(350, 24);\n\n  const statusBadge = figma.createFrame();\n  statusBadge.layoutMode = 'HORIZONTAL';\n  statusBadge.paddingLeft = 8; statusBadge.paddingRight = 8;\n  statusBadge.paddingTop = 3; statusBadge.paddingBottom = 3;\n  statusBadge.cornerRadius = 6;\n  statusBadge.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 }, opacity: 0.2 }];\n\n  const statusText = figma.createText();\n  statusText.fontName = { family: 'Inter', style: 'Semi Bold' };\n  statusText.fontSize = 12;\n  statusText.characters = 'Upcoming';\n  statusText.fills = [{ type: 'SOLID', color: COLOR_WHITE }];\n  statusBadge.appendChild(statusText);\n  flightTopRow.appendChild(statusBadge);\n\n  const flightDateText = figma.createText();\n  flightDateText.fontName = { family: 'Inter', style: 'Medium' };\n  flightDateText.fontSize = 13;\n  flightDateText.characters = '24 March 2024';\n  flightDateText.fills = [{ type: 'SOLID', color: { r: 0.9, g: 0.95, b: 0.98 } }];\n  flightTopRow.appendChild(flightDateText);\n\n  flightCard.appendChild(flightTopRow);\n\n  // Route & Time Row: CGK 05:30 → DPS 08:00 · 1h 30m\n  const routeRow = figma.createFrame();\n  routeRow.layoutMode = 'HORIZONTAL';\n  routeRow.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  routeRow.counterAxisAlignItems = 'CENTER';\n  routeRow.fills = [];\n  routeRow.resize(350, 48);\n\n  // Left Code & Time\n  const leftRoute = figma.createFrame();\n  leftRoute.layoutMode = 'VERTICAL';\n  leftRoute.itemSpacing = 2;\n  leftRoute.fills = [];\n\n  const cgkText = figma.createText();\n  cgkText.fontName = { family: 'Inter', style: 'Bold' };\n  cgkText.fontSize = 22;\n  cgkText.characters = 'CGK';\n  cgkText.fills = [{ type: 'SOLID', color: COLOR_WHITE }];\n  leftRoute.appendChild(cgkText);\n\n  const cgkTime = figma.createText();\n  cgkTime.fontName = { family: 'Inter', style: 'Regular' };\n  cgkTime.fontSize = 13;\n  cgkTime.characters = '05:30';\n  cgkTime.fills = [{ type: 'SOLID', color: { r: 0.9, g: 0.95, b: 0.98 } }];\n  leftRoute.appendChild(cgkTime);\n\n  routeRow.appendChild(leftRoute);\n\n  // Flight path icon / duration\n  const pathGroup = figma.createFrame();\n  pathGroup.layoutMode = 'VERTICAL';\n  pathGroup.counterAxisAlignItems = 'CENTER';\n  pathGroup.itemSpacing = 2;\n  pathGroup.fills = [];\n\n  const planeIconFlight = masterIconPlane.createInstance();\n  recolorNode(planeIconFlight, COLOR_WHITE);\n  planeIconFlight.resize(20, 18);\n  pathGroup.appendChild(planeIconFlight);\n\n  const durationText = figma.createText();\n  durationText.fontName = { family: 'Inter', style: 'Medium' };\n  durationText.fontSize = 11;\n  durationText.characters = '1h 30m';\n  durationText.fills = [{ type: 'SOLID', color: { r: 0.9, g: 0.95, b: 0.98 } }];\n  pathGroup.appendChild(durationText);\n\n  routeRow.appendChild(pathGroup);\n\n  // Right Code & Time\n  const rightRoute = figma.createFrame();\n  rightRoute.layoutMode = 'VERTICAL';\n  rightRoute.counterAxisAlignItems = 'MAX';\n  rightRoute.itemSpacing = 2;\n  rightRoute.fills = [];\n\n  const dpsText = figma.createText();\n  dpsText.fontName = { family: 'Inter', style: 'Bold' };\n  dpsText.fontSize = 22;\n  dpsText.characters = 'DPS';\n  dpsText.fills = [{ type: 'SOLID', color: COLOR_WHITE }];\n  rightRoute.appendChild(dpsText);\n\n  const dpsTime = figma.createText();\n  dpsTime.fontName = { family: 'Inter', style: 'Regular' };\n  dpsTime.fontSize = 13;\n  dpsTime.characters = '08:00';\n  dpsTime.fills = [{ type: 'SOLID', color: { r: 0.9, g: 0.95, b: 0.98 } }];\n  rightRoute.appendChild(dpsTime);\n\n  routeRow.appendChild(rightRoute);\n\n  flightCard.appendChild(routeRow);\n\n  // Bottom info line: Sentosa Air · Economy · Direct | Booking ID: ZEEBAW\n  const flightBottomRow = figma.createFrame();\n  flightBottomRow.layoutMode = 'HORIZONTAL';\n  flightBottomRow.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  flightBottomRow.counterAxisAlignItems = 'CENTER';\n  flightBottomRow.fills = [];\n  flightBottomRow.resize(350, 20);\n\n  const airlineText = figma.createText();\n  airlineText.fontName = { family: 'Inter', style: 'Regular' };\n  airlineText.fontSize = 12;\n  airlineText.characters = 'Sentosa Air · Economy · Direct';\n  airlineText.fills = [{ type: 'SOLID', color: { r: 0.9, g: 0.95, b: 0.98 } }];\n  flightBottomRow.appendChild(airlineText);\n\n  const bookingText = figma.createText();\n  bookingText.fontName = { family: 'Inter', style: 'Semi Bold' };\n  bookingText.fontSize = 12;\n  bookingText.characters = 'ID: ZEEBAW';\n  bookingText.fills = [{ type: 'SOLID', color: COLOR_WHITE }];\n  flightBottomRow.appendChild(bookingText);\n\n  flightCard.appendChild(flightBottomRow);\n\n  homeScroll.appendChild(flightCard);\n\n  // 5. Journeys Section: “Journey together” · See all\n  const journeySectionHead = figma.createFrame();\n  journeySectionHead.layoutMode = 'HORIZONTAL';\n  journeySectionHead.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  journeySectionHead.counterAxisAlignItems = 'CENTER';\n  journeySectionHead.fills = [];\n  journeySectionHead.resize(390, 24);\n\n  const jTitle = figma.createText();\n  jTitle.fontName = { family: 'Inter', style: 'Bold' };\n  jTitle.fontSize = 18;\n  jTitle.characters = 'Journey together';\n  jTitle.fills = [{ type: 'SOLID', color: COLOR_DARK }];\n  journeySectionHead.appendChild(jTitle);\n\n  const jSeeAll = figma.createText();\n  jSeeAll.fontName = { family: 'Inter', style: 'Semi Bold' };\n  jSeeAll.fontSize = 14;\n  jSeeAll.characters = 'See all';\n  jSeeAll.fills = [{ type: 'SOLID', color: COLOR_TEAL }];\n  journeySectionHead.appendChild(jSeeAll);\n\n  homeScroll.appendChild(journeySectionHead);\n\n  // Horizontal Scroll Cards Container for Journeys\n  const journeyScroll = figma.createFrame();\n  journeyScroll.name = 'Journey Horizontal Scroll';\n  journeyScroll.layoutMode = 'HORIZONTAL';\n  journeyScroll.itemSpacing = 14;\n  journeyScroll.fills = [];\n  journeyScroll.resize(390, 210);\n\n  const journeyData = [\n    {\n      title: 'Mount Bromo',\n      location: 'Volcano in East Java',\n      rating: '★ 4.9',\n      price: 'Start from $150/pax',\n      duration: '3D2N',\n      photo: masterPhotoBromo\n    },\n    {\n      title: 'Labengki Sombori',\n      location: 'Islands in Sulawesi',\n      rating: '★ 4.8',\n      price: 'Start from $250/pax',\n      duration: '3D2N',\n      photo: masterPhotoLabengki\n    },\n    {\n      title: 'Sailing Komodo',\n      location: 'Labuan Bajo',\n      rating: '★ 4.8',\n      price: 'Start from $200/pax',\n      duration: '3D2N',\n      photo: masterPhotoKomodo\n    }\n  ];\n\n  for (const j of journeyData) {\n    const card = figma.createFrame();\n    card.name = `Journey Card - ${j.title}`;\n    card.resize(200, 210);\n    card.cornerRadius = 16;\n    card.fills = [{ type: 'SOLID', color: COLOR_WHITE }];\n    card.strokes = [{ type: 'SOLID', color: COLOR_BORDER }];\n    card.strokeWeight = 1;\n    card.clipsContent = true;\n    card.layoutMode = 'VERTICAL';\n\n    // Image frame\n    const imgFrame = figma.createFrame();\n    imgFrame.resize(200, 110);\n    imgFrame.fills = [];\n    imgFrame.clipsContent = true;\n\n    const photoInst = j.photo.createInstance();\n    photoInst.resize(200, 110);\n    imgFrame.appendChild(photoInst);\n\n    // Rating Badge on top right of image\n    const rBadge = figma.createFrame();\n    rBadge.layoutMode = 'HORIZONTAL';\n    rBadge.counterAxisAlignItems = 'CENTER';\n    rBadge.itemSpacing = 3;\n    rBadge.paddingLeft = 6; rBadge.paddingRight = 8;\n    rBadge.paddingTop = 3; rBadge.paddingBottom = 3;\n    rBadge.cornerRadius = 10;\n    rBadge.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 }, opacity: 0.6 }];\n\n    const starInst = masterIconStar.createInstance();\n    recolorNode(starInst, COLOR_GOLD);\n    starInst.resize(12, 12);\n    rBadge.appendChild(starInst);\n\n    const rText = figma.createText();\n    rText.fontName = { family: 'Inter', style: 'Semi Bold' };\n    rText.fontSize = 11;\n    rText.charact