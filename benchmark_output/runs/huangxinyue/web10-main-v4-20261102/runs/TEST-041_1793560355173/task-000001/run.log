omps[id]) comps[id]=await figma.getNodeByIdAsync(id); return comps[id]; }\nasync function inst(id,w,h){ const c=await comp(id); const i=c.createInstance(); if(w&&h) i.resize(w,h); return i; }\nasync function icon(id,size,colorHex){ const c=await comp(id); const i=c.createInstance(); const s=size/Math.max(c.width,c.height); i.rescale(s); if(colorHex){ const rec=n=>{ if('fills' in n && Array.isArray(n.fills) && n.fills.some(f=>f.type==='SOLID')) n.fills=[sol(colorHex)]; if('children' in n) n.children.forEach(rec); }; rec(i);} return i; }\nfunction stretchFill(parent,n){ parent.appendChild(n); n.layoutAlign='STRETCH'; n.primaryAxisSizingMode='FIXED'; n.counterAxisSizingMode='AUTO'; }\n\nconst cart=figma.createFrame(); cart.name='06_Cart'; cart.resize(1440,100); cart.fills=[sol(C.white)];\ncart.layoutMode='VERTICAL'; cart.itemSpacing=0; cart.primaryAxisSizingMode='AUTO'; cart.counterAxisSizingMode='FIXED'; cart.clipsContent=true;\nconst hI=(await comp('18:2')).createInstance(); hI.layoutAlign='STRETCH'; cart.appendChild(hI);\nconst bI=(await comp('18:20')).createInstance(); bI.layoutAlign='STRETCH'; cart.appendChild(bI);\nbI.findOne(n=>n.name==='Title').characters='Cart';\nbI.findOne(n=>n.name==='Crumb current').characters='Cart';\n\nconst body=fr('Cart body'); body.fills=[sol(C.white)]; al(body,{mode:'HORIZONTAL',gap:30,pad:[70,100,85,100]});\nconst left=fr('Cart table'); al(left,{mode:'VERTICAL',gap:0});\nconst thead=fr('Table head'); thead.fills=[sol(C.cream)]; al(thead,{mode:'HORIZONTAL',gap:0,cross:'CENTER',pad:[15,0,15,0]}); thead.primaryAxisSizingMode='FIXED'; thead.resize(820,55);\nconst cols=[[105,''],[160,'Product'],[150,'Price'],[140,'Quantity'],[150,'Subtotal'],[55,'']];\nfor (const [w,label] of cols){ const c=fr('TH/'+ (label||'x')); c.resize(w,24); c.primaryAxisSizingMode='AUTO'; c.counterAxisSizingMode='FIXED'; al(c,{mode:'HORIZONTAL',main:'CENTER'}); if(label) c.appendChild(txt(label,16,F.med,C.ink)); thead.appendChild(c); }\nleft.appendChild(thead);\nconst trow=fr('Table row'); al(trow,{mode:'HORIZONTAL',gap:0,cross:'CENTER',pad:[55,0,20,0]}); trow.primaryAxisSizingMode='FIXED'; trow.resize(820,140);\nconst cellWidths=[105,160,150,140,150,55];\nconst photo=await inst('13:4',105,105); photo.cornerRadius=5; \nconst c0=fr('TD photo'); c0.resize(105,105); c0.primaryAxisSizingMode='FIXED'; c0.counterAxisSizingMode='FIXED'; photo.x=0; photo.y=0; c0.appendChild(photo); trow.appendChild(c0);\nconst cellVal=(w,label,color,name)=>{ const c=fr('TD/'+name); c.resize(w,24); c.primaryAxisSizingMode='AUTO'; c.counterAxisSizingMode='FIXED'; al(c,{mode:'HORIZONTAL',main:'CENTER'}); c.appendChild(txt(label,16,F.reg,color,{name})); return c; };\ntrow.appendChild(cellVal(160,'Asgaard sofa',C.muted,'Product name'));\ntrow.appendChild(cellVal(150,'Rs. 250,000.00',C.muted,'Price'));\ntrow.appendChild(cellVal(140,'1',C.ink,'Quantity'));\ntrow.appendChild(cellVal(150,'Rs. 250,000.00',C.ink,'Subtotal'));\nconst cDel=fr('TD remove'); cDel.resize(55,28); cDel.primaryAxisSizingMode='AUTO'; cDel.counterAxisSizingMode='FIXED'; al(cDel,{mode:'HORIZONTAL',main:'CENTER'}); cDel.appendChild(await icon('13:28',24,C.red)); trow.appendChild(cDel);\nleft.appendChild(trow);\nbody.appendChild(left);\n\nconst right=fr('Cart Totals'); right.fills=[sol(C.cream)]; al(right,{mode:'VERTICAL',gap:30,cross:'CENTER',pad:[15,75,80,75]}); right.primaryAxisSizingMode='AUTO'; right.counterAxisSizingMode='AUTO';\nright.appendChild(txt('Cart Totals',32,F.sb,C.ink));\nconst r1=fr('R1'); al(r1,{mode:'HORIZONTAL',gap:60,cross:'CENTER'}); r1.appendChild(txt('Subtotal',16,F.med,C.ink,{w:90})); r1.appendChild(txt('Rs. 250,000.00',16,F.reg,C.muted,{name:'Subtotal value'})); right.appendChild(r1);\nconst r2=fr('R2'); al(r2,{mode:'HORIZONTAL',gap:60,cross:'CENTER'}); r2.appendChild(txt('Total',16,F.med,C.ink,{w:90})); r2.appendChild(txt('Rs. 250,000.00',20,F.med,C.gold,{name:'Total value'})); right.appendChild(r2);\nconst co=fr('Check Out'); co.cornerRadius=15; co.strokes=[sol(C.ink)]; co.strokeWeight=1; al(co,{mode:'HORIZONTAL',pad:[14,58,14,58]}); co.appendChild(txt('Check Out',20,F.reg,C.ink));\nright.appendChild(co);\nbody.appendChild(right);\nstretchFill(cart,body);\n\nconst sI=(await comp('18:28')).createInstance(); sI.layoutAlign='STRETCH'; cart.appendChild(sI);\nconst fI=(await comp('18:53')).createInstance(); fI.layoutAlign='STRETCH'; cart.appendChild(fI);\nWS.appendChild(cart); cart.x=8000; cart.y=0;\nreturn {cart:cart.id, h:cart.height};\n","description":"Build 06_Cart: banner, cart table with one row and delete icon, cart totals panel with Check Out, feature strip, footer"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"4169e7d1-fa58-4180-9c80-2a57d8444911","uuid":"7a39ea23-cc39-4086-bbd4-4f32a9634efc","timestamp":"2026-11-01T19:29:10.089Z","tool_use_meta":[{"id":"mcp__figma__use_figma_26_4fc22879","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
