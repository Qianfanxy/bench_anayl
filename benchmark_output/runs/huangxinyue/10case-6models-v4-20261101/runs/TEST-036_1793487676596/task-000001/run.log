Pay by name or phone\",{size:14,color:C.GRAY400,x:42,y:13});\nconst hist=figma.createFrame(); hist.name=\"History button\"; hist.resize(44,44); hist.cornerRadius=22; hist.fills=[sp(C.SURFACE)]; hist.strokes=[sp(C.BORDER)]; hist.strokeWeight=1; f3.appendChild(hist); hist.x=330; hist.y=56;\n{ const ic=get(\"4:14\").createInstance(); ic.resize(20,20); recolor(ic,sp(C.INK)); hist.appendChild(ic); ic.x=12; ic.y=12; }\nconst bal=get(\"8:47\").createInstance(); f3.appendChild(bal); bal.x=16; bal.y=116;\nconst tile1=get(\"8:14\").createInstance(); f3.appendChild(tile1); tile1.x=16; tile1.y=282;\nconst tile2=get(\"8:14\").createInstance(); f3.appendChild(tile2); tile2.x=138; tile2.y=282;\n{ tile2.fills=[sp(C.GREEN)];\n  const ic=tile2.findOne(n=>n.type===\"INSTANCE\"&&n.name.startsWith(\"Icon\")); ic.swapComponent(get(\"4:18\")); ic.resize(24,24); recolor(ic,sp(\"#FFFFFF\"));\n  const lb=tile2.findOne(n=>n.type===\"TEXT\"); lb.characters=\"Receive\"; }\nconst tile3=get(\"8:14\").createInstance(); f3.appendChild(tile3); tile3.x=260; tile3.y=282;\n{ tile3.fills=[sp(C.INK)];\n  const ic=tile3.findOne(n=>n.type===\"INSTANCE\"&&n.name.startsWith(\"Icon\")); ic.swapComponent(get(\"4:20\")); ic.resize(24,24); recolor(ic,sp(\"#FFFFFF\"));\n  const lb=tile3.findOne(n=>n.type===\"TEXT\"); lb.characters=\"Scan any QR\"; }\nconst ban=get(\"8:30\").createInstance(); f3.appendChild(ban); ban.x=16; ban.y=362;\nmkText(f3,\"OTHER ACCOUNTS\",{style:\"Semi Bold\",size:11,color:C.GRAY600,x:16,y:438,ls:7});\nconst accDefs=[[\"HDFC Bank\",\"₹63,520\",\"4:7\",199,460],[\"Deutsche Bank\",\"₹36,258\",\"4:6\",16,530],[\"Union Bank\",\"₹67,820\",\"4:9\",199,530]];\nfor(const [name,bal2,markId,x,y] of accDefs){\n  const inst=get(\"8:18\").createInstance(); f3.appendChild(inst); inst.x=x; inst.y=y;\n  const mk=inst.findOne(n=>n.type===\"INSTANCE\"&&n.name.startsWith(\"Bank\")); mk.swapComponent(get(markId)); mk.resize(26,26);\n  const t1=inst.findOne(n=>n.type===\"TEXT\"&&n.characters===\"Axis Bank\"); t1.characters=name;\n  const t2=inst.findOne(n=>n.type===\"TEXT\"&&n.characters===\"₹3,500\"); t2.characters=bal2;\n}\nconst acc1=get(\"8:18\").createInstance(); f3.appendChild(acc1); acc1.x=16; acc1.y=460;\nmkText(f3,\"RECENT TRANSACTIONS\",{style:\"Semi Bold\",size:11,color:C.GRAY600,x:16,y:608,ls:7});\nconst th=mkText(f3,\"Transaction History\",{style:\"Semi Bold\",size:13,color:C.BRAND,x:0,y:606}); th.x=374-th.width;\nconst row1=get(\"8:24\").createInstance(); f3.appendChild(row1); row1.x=16; row1.y=638;\nlet row2info=null;\ntry{\n  const row2=get(\"8:24\").createInstance(); f3.appendChild(row2); row2.x=16; row2.y=696;\n  const mk=row2.findOne(n=>n.type===\"INSTANCE\"&&n.name.startsWith(\"Merchant\")); mk.swapComponent(get(\"4:3\")); mk.resize(24,36);\n  const t1=row2.findOne(n=>n.type===\"TEXT\"&&n.characters===\"Paytm Auto Pay\"); t1.characters=\"Risa Midyett\";\n  const t2=row2.findOne(n=>n.type===\"TEXT\"&&n.characters===\"22 Jan · Weekly transaction\"); t2.characters=\"05 Jan · Gift for Christmas\";\n  const t3=row2.findOne(n=>n.type===\"TEXT\"&&n.characters===\"−₹3,500\"); t3.characters=\"+₹6,950\"; t3.fills=[sp(C.GREEN)];\n  row2info=row2.id;\n}catch(e){\n  const row2=figma.createFrame(); row2.name=\"Row / Transaction (Risa)\"; row2.resize(358,56); row2.cornerRadius=14; row2.fills=[sp(C.SURFACE)]; row2.effects=[shadowCard]; f3.appendChild(row2); row2.x=16; row2.y=696;\n  const chip=figma.createFrame(); chip.resize(36,36); chip.cornerRadius=18; chip.fills=[sp(C.CHIP)]; chip.clipsContent=true; row2.appendChild(chip); chip.x=12; chip.y=10;\n  const m=get(\"4:3\").createInstance(); m.resize(24,36); chip.appendChild(m); m.x=6; m.y=0;\n  mkText(row2,\"Risa Midyett\",{style:\"Semi Bold\",size:14,x:60,y:9});\n  mkText(row2,\"05 Jan · Gift for Christmas\",{size:12,color:C.GRAY600,x:60,y:29});\n  mkText(row2,\"+₹6,950\",{style:\"Semi Bold\",size:14,color:C.GREEN,x:254,y:19,w:90,align:\"RIGHT\"});\n  row2info=row2.id+\" (manual)\";\n}\nconst row3=get(\"8:24\").createInstance(); f3.appendChild(row3); row3.x=16; row3.y=754;\n{ const mk=row3.findOne(n=>n.type===\"INSTANCE\"&&n.name.startsWith(\"Merchant\")); mk.swapComponent(get(\"4:24\")); mk.resize(24,24);\n  const t1=row3.findOne(n=>n.type===\"TEXT\"&&n.characters===\"Paytm Auto Pay\"); t1.characters=\"Amazon Pantry\";\n  const t2=row3.findOne(n=>n.type===\"TEXT\"&&n.characters===\"22 Jan · Weekly transaction\"); t2.characters=\"01 Jan · Subscription payment\";\n  const t3=row3.findOne(n=>n.type===\"TEXT\"&&n.characters===\"−₹3,500\"); t3.fills=[sp(C.RED)]; }\nconst hi3=get(\"1:44\").createInstance(); f3.appendChild(hi3); hi3.x=0; hi3.y=810;\n\nreturn JSON.stringify({f1:f1.id, btn1:btn1.id, f3:f3.id, avatar:av.id, row2:row2info, row1:row1.id, row3:row3.id});\n","description":"Build 01_Onboarding and 03_Home frames using override-safe instance patterns","fileKey":"CzkDgUe1dyJA7vCKriV99m"}}],"id":"7a355aa3-8a2e-42ea-b2a2-cbb3425bc802","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"cc0b1614-1a50-4b76-91ee-9a5812ecc44e","uuid":"1ac5c4e0-a4c2-4ff6-9db0-b6335ac4a26a","timestamp":"2026-10-31T23:16:24.590Z","tool_use_meta":[{"id":"call_f8b261817f5041329ee229b1","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
