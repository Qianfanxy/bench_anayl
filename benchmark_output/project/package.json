{
  "name": "figma-eval-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 4175",
    "build": "vite build",
    "start": "node server/index.mjs",
    "benchmark-design": "node scripts/start-benchmark-design.mjs",
    "bench": "node scripts/bench.mjs",
    "test": "node --test 'tests/**/*.test.mjs'"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^7.0.6"
  }
}
