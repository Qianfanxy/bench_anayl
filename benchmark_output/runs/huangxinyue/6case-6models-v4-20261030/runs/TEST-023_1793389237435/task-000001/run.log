if(o.name)f.name=o.name;return f;}\n     function V(p,d,hex,x,y,w,fill){const v=figma.createVector();v.vectorPaths=[{windingRule:fill?'NONZERO':'NONE',data:d}];if(fill){v.fills=[S(hex)];v.strokes=[];}else{v.strokes=[S(hex)];v.strokeWeight=w||2;v.strokeCap='ROUND';v.strokeJoin='ROUND';v.fills=[];}p.appendChild(v);v.x=x;v.y=y;return v;}\n     function spark(p,pts,hex,x,y,w,h,wt){let d='';pts.forEach((pt,i)=>{d+=(i===0?'M ':'L ')+pt[0]+' '+pt[1]+' ';});const v=V(p,d,hex,x,y,wt||2);v.resize(w,h);return v;}\n     async function get(id){return await figma.getNodeByIdAsync(id);}\n     function tint(n,hex){n.findAll(c=>{if('fills'in c&&Array.isArray(c.fills)&&c.fills.some(s=>s.type==='SOLID'))c.fills=[S(hex)];if('strokes'in c&&Array.isArray(c.strokes)&&c.strokes.some(s=>s.type==='SOLID'))c.strokes=[S(hex)];});if('fills'in n&&Array.isArray(n.fills)&&n.fills.some(s=>s.type==='SOLID'))n.fills=[S(hex)];}\n     function RS(n,f){try{n.rescale(f);}catch(e){n.resize(n.width*f,n.height*f);}}\n     function act(dest){return [{type:'NODE',destinationId:dest,navigation:'NAVIGATE',transition:null}];}\n     ```\n   - **Apple silhouette path used** (absolute curves, ~14×16 box, drawn at (x,594) then `.resize(15,18)`):\n     `'M 8.6 3.6 C 9.0 3.0 9.2 2.2 9.0 1.5 C 8.3 1.7 7.6 2.1 7.2 2.7 C 6.8 3.3 6.6 4.0 6.8 4.6 C 7.5 4.5 8.2 4.1 8.6 3.6 Z M 7.0 5.2 C 6.2 4.7 5.2 4.6 4.3 4.9 C 2.6 5.4 1.4 7.1 1.5 9.0 C 1.6 10.9 2.6 12.8 3.8 14.2 C 4.4 14.9 5.1 15.4 5.9 15.3 C 6.4 15.3 6.8 15.0 7.3 15.0 C 7.8 15.0 8.2 15.3 8.7 15.3 C 9.5 15.3 10.2 14.7 10.8 14.0 C 11.5 13.2 12.0 12.2 12.3 11.2 C 11.4 10.8 10.7 10.0 10.5 9.0 C 10.3 8.0 10.7 7.0 11.5 6.4 C 11.0 5.7 10.2 5.1 9.3 4.9 C 8.5 4.7 7.6 4.9 7.0 5.2 Z'`\n   - **Chart math (built)**: 08 chart cx=[20,67.8,115.7,163.5,211.3,259.2,307], cy=[150,80,126,74,50,62,40], area closed to y=150 (brand 10%), Sun dot 8×8 at (303,36), chip 'Sun · $13,240.11' tint pill (190,30,113,22); 09 chart px=[20,48.7,77.4,106.1,134.8,163.5,192.2,206.6,226.6,249.6,278.3,307], py