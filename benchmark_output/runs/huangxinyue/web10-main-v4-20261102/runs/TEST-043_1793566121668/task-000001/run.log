(ch.name!=='Toolbar')ch.remove()}\nfor(const ch of [...shop.children]){if(['Collection Banner','Features','Instagram','Newsletter','Footer/Store'].includes(ch.name))ch.remove()}\nconst pcD=root.findOne(n=>n.name==='Product Card/Default');\nconst pcS=root.findOne(n=>n.name==='Product Card/Sold Out');\nconst data=[['Rounded Red Hat','$8.00',null,'6:78',false],['Linen-blend Shirt','$17.00',null,'6:57',true],['Long-sleeve Coat','$106.00',null,'6:60',false],['Boxy Denim Hat','$25.00',null,'6:27',false],['Linen Plain Top','$25.00',null,'6:58',false],['Oversized T-shirt','$11.00','$14.00','6:77',false],['Polarised Sunglasses','$18.00','$21.00','6:79',false],['Rockstar Jacket','$22.00',null,'6:61',false],['Dotted Black Dress','$20.00',null,'6:71',false]];\nconst grid=Fr(col,1092,100,null);grid.name='Products';AL(grid,'HORIZONTAL',36,0,0,0,0);grid.layoutWrap='WRAP';grid.counterAxisSpacing=40;\nfor(const [name,price,old,pid,sold] of data){\n  const c=(sold?pcS:pcD).createInstance();grid.appendChild(c);c.resize(340,452);c.name='Product · '+name;\n  const ph=c.findOne(n=>n.name==='Photo');ph.resize(340,300);\n  const im=ph.findOne(n=>n.name==='Image');im.resize(340,300);im.fills=[await imgFill(pid)];\n  for(const t of c.findAll(n=>n.type==='TEXT')){\n    if(t.characters==='Product Name'){t.characters=name;t.fontSize=16}\n    else if(t.characters==='(4.1k) Customer Reviews'){t.characters=' '}\n    else if(t.characters==='$95.50'){t.characters=old?(price+'   '+old):price}\n    else if(t.characters==='Almost Sold Out'){t.characters=' '}\n  }\n}\nconst pgw=Fr(col,1092,48,null);AL(pgw,'HORIZONTAL',0,0,0,0,0);pgw.primaryAxisAlignItems='CENTER';\nconst pg=root.findOne(n=>n.name==='Pagination').createInstance();pgw.appendChild(pg);\nmain.primaryAxisSizingMode='AUTO';\nlet y=main.y+main.height+100;\nconst cb=root.findOne(n=>n.name==='Collection Banner').createInstance();cb.x=240;cb.y=y;shop.appendChild(cb);y+=cb.height+120;\nconst fs2=Fr(shop,1440,160,null);fs2.name='Features';fs2.x=240