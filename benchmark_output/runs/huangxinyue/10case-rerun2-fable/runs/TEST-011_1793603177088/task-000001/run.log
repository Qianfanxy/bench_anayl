,size||24);const paint=(n)=>{if('fills' in n&&n.fills&&n.fills.length){n.fills=n.fills.map(f=>f.type==='SOLID'?solid(color||C.ink,f.opacity):f);}if('children' in n)n.children.forEach(paint);};paint(i);return i;}\nglobalThis.T=T;globalThis.solid=solid;globalThis.grad=grad;globalThis.icon=icon;globalThis.hashOf=hashOf;globalThis.rgb=rgb;\nconst lib=figma.createFrame();lib.name='Components · Meet (built)';lib.resize(1800,1500);lib.x=0;lib.y=1250;lib.fills=[solid('#FFFFFF')];P.appendChild(lib);\nglobalThis.lib=lib;\nasync function note(s,x,y){const t=await T(s,{size:12,weight:'Semi Bold',color:'#A29CA6',ls:0.6});t.x=x;t.y=y;lib.appendChild(t);}\nasync function button(label,style){const b=figma.createComponent();b.name='Style='+style;b.resize(345,52);b.cornerRadius=16;b.fills= style==='Primary'?[solid(C.plum)]: style==='Gradient'?[grad(C.plum,C.orchid,'h')]:[solid(C.white)];if(style==='Outline'){b.strokes=[solid('#E7DEE9')];b.strokeWeight=1;b.strokeAlign='INSIDE';}if(style==='Primary'||style==='Gradient')b.effects=[{type:'DROP_SHADOW',color:{r:0.294,g:0.086,b:0.298,a:0.22},offset:{x:0,y:8},radius:20,spread:0,visible:true,blendMode:'NORMAL'}];b.layoutMode='HORIZONTAL';b.primaryAxisAlignItems='CENTER';b.counterAxisAlignItems='CENTER';b.counterAxisSizingMode='FIXED';b.primaryAxisSizingMode='FIXED';b.itemSpacing=10;lib.appendChild(b);return b;}\nconst b1=await button('Primary','Primary');b1.appendChild(await T('Continue',{size:16,weight:'Semi Bold',color:C.white}));\nconst b2=await button('Outline','Outline');b2.appendChild(await T('Outline',{size:16,weight:'Semi Bold',color:C.plum}));\nconst b3=await button('Gradient','Gradient');b3.appendChild(await T('Gradient',{size:16,weight:'Semi Bold',color:C.white}));\nnote('Buttons',0,0);b1.x=0;b1.y=30;b2.x=380;b2.y=30;b3.x=760;b3.y=30;\nasync function tabItem(label,iconName,isCur,isAdd){\n  const w=figma.createFrame();w.name='Tab/'+label;w.resize(76,56);w.fills=[];w.layoutMode='VERTICAL';w.primaryAxisAlignItems='CENTER';w.counterAxisAlignItems='CENTER';w.itemSpacing=4;\n  if(isAdd){const circ=figma.createFrame();circ.name='AddButton';circ.resize(42,42);circ.cornerRadius=21;circ.fills=[grad(C.plum,C.orchid,'h')];circ.effects=[{type:'DROP_SHADOW',color:{r:0.294,g:0.086,b:0.298,a:0.28},offset:{x:0,y:4},radius:12,spread:0,visible:true,blendMode:'NORMAL'}];const pl=icon('Icon_Plus',22,C.white);pl.x=10;pl.y=10;circ.appendChild(pl);w.appendChild(circ);return w;}\n  if(label==='Profile'){const av=figma.createFrame();av.name='Avatar';av.resize(26,26);av.cornerRadius=13;av.fills=[{type:'IMAGE',imageHash:hashOf('Portrait_Sarah_Payne'),scaleMode:'FILL'}];if(isCur){av.strokes=[solid(C.plum)];av.strokeWeight=2;av.strokeAlign='OUTSIDE';}w.appendChild(av);}\n  else {w.appendChild(icon(iconName,24,isCur?C.plum:C.ink3));}\n  const lb=await T(label,{size:10,weight:isCur?'Semi Bold':'Medium',color:isCur?C.plum:C.ink3,lh:12});w.appendChild(lb);return w;}\nasync function tabBar(cur){const tb=figma.createComponent();tb.name='State='+cur;tb.resize(393,84);tb.fills=[solid(C.white)];tb.strokes=[solid(C.line)];tb.strokeWeight=1;tb.strokeAlign='INSIDE';tb.layoutMode='HORIZONTAL';tb.primaryAxisSizingMode='FIXED';tb.counterAxisSizingMode='FIXED';tb.paddingLeft=8;tb.paddingRight=8;tb.paddingTop=8;tb.paddingBottom=0;tb.counterAxisAlignItems='MIN';tb.primaryAxisAlignItems='SPACE_BETWEEN';\n  const defs=[['Home','Icon_Home'],['Dating','Icon_Heart'],['Add',null],['Chat','Icon_Chat'],['Profile',null]];\n  for(const d of defs){const t=await tabItem(d[0],d[1],d[0]===cur,d[0]==='Add');tb.appendChild(t);}\n  return tb;}\nconst tbHome=await tabBar('Home'),tbDate=await tabBar('Dating'),tbProf=await tabBar('Profile');\ntbHome.x=0;tbHome.y=120;tbDate.x=440;tbDate.y=120;tbProf.x=880;tbProf.y=120;note('Tab Bar · current variants',0,95);\nasync function header(type){const h=figma.createComponent();h.name='Type='+type;h.resize(393,56);h.fills=[];h.layoutMode='HORIZONTAL';h.primaryAxisSizingMode='FIXED';h.counterAxisSizingMode='FIXED';h.pad