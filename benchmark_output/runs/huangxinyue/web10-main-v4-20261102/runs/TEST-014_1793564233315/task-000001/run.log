{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_bdrk_shdy4zjeit2nl3656dghjmaieq7664h3jjrpa27r7lyjat2eqocq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01AQ3KcH6etw3iLT3c38MwD3","name":"mcp__figma__use_figma","input":{"description":"Create input fields, announcement bar, header, stat, product card, style tile components","fileKey":"1lB6sFZZe3WOcgYZxebEca","code":"const P=await figma.getNodeByIdAsync('6:2'); await figma.setCurrentPageAsync(P);\nconst A={family:'Archivo Black',style:'Regular'}; const J=s=>({family:'Plus Jakarta Sans',style:s});\nfor(const f of [A,J('Regular'),J('Medium'),J('SemiBold'),J('Bold')]) await figma.loadFontAsync(f);\nconst hex=h=>{h=h.replace('#','');return {r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255}};\nconst S=h=>[{type:'SOLID',color:hex(h)}];\nconst tstyles=await figma.getLocalTextStylesAsync(); const sty=n=>tstyles.find(s=>s.name===n);\nconst T=async(chars,style,color='#000000')=>{const t=figma.createText(); const s=sty(style); t.fontName=s.fontName; t.characters=chars; await t.setTextStyleIdAsync(s.id); t.fills=S(color); return t;};\nconst AL=(name,dir,gap=0,pad=[0,0,0,0],comp=false)=>{const f=comp?figma.createComponent():figma.createFrame(); f.name=name; f.layoutMode=dir; f.itemSpacing=gap; [f.paddingTop,f.paddingRight,f.paddingBottom,f.paddingLeft]=pad; f.fills=[]; f.primaryAxisSizingMode='AUTO'; f.counterAxisSizingMode='AUTO'; f.counterAxisAlignItems='CENTER'; return f;};\nconst G=async id=>await figma.getNodeByIdAsync(id);\nconst icon=async(id,color,size)=>{const c=await G(id); const i=c.createInstance(); i.fills=[]; if(size&&size!==i.width) i.rescale(size/i.width); if(color){ i.findAll(n=>n.type==='VECTOR').forEach(v=>{ if(v.fills.length&&v.fills[0].type==='SOLID'&&v.fills[0].color.r<0.2) v.fills=S(color); if(v.strokes.length&&v.strokes[0].color.r<0.2) v.strokes=S(color);});} return i;};\nconst textProp=(comp,node,name)=>{const k=comp.addComponentProperty(name,'TEXT',node.characters); node.componentPropertyReferences={characters:k}; return k;};\nconst root=await G('10:2');\nconst row=async(title)=>{const w=AL(title,'VERTICAL',20); w.counterAxisAlignItems='MIN'; w.appendChild(await T(title,'Heading/L')); const r=AL(title+' · items','HORIZONTAL',32); r.counterAxisAlignItems='MIN'; w.appendChild(r); root.appendChild(w); return r;};\nconst combine=(comps,parent,name)=>{const s=figma.combineAsVariants(comps,parent); s.name=name; s.layoutMode='HORIZONTAL'; s.itemSpacing=24; s.paddingTop=s.paddingBottom=s.paddingLeft=s.paddingRight=24; s.primaryAxisSizingMode='AUTO'; s.counterAxisSizingMode='AUTO'; s.counterAxisAlignItems='CENTER'; s.fills=[]; s.strokes=S('#9747FF'); s.dashPattern=[6,4]; s.cornerRadius=13; return s;};\nconst ids={};\nconst TF=await G('1:26');\n\n// Input fields (wrap given Text Field)\nlet r1=await row('Input Fields');\nconst fv=[['Search','Search for products...','4:16','#F0F0F0',null,577],['Search Focused','Search for products...','4:16','#FFFFFF','#000000',577],['Promo','Add promo code','4:20','#F0F0F0',null,326],['Email','Enter your email address',null,'#FFFFFF',null,349],['Email Focused','Enter your email address',null,'#FFFFFF','#063AF5',349]];\nconst fcs=[];\nfor(const [n,ph,ic,bg,stroke,w] of fv){const c=AL('Type='+n,'HORIZONTAL',0,[0,0,0,0],true); c.primaryAxisSizingMode='FIXED'; c.resize(w,48);\n const i=TF.createInstance(); c.appendChild(i); i.layoutSizingHorizontal='FILL'; i.findOne(x=>x.name==='Label').visible=false; const inp=i.findOne(x=>x.name==='Input'); inp.fills=S(bg); if(stroke){inp.strokes=S(stroke); inp.strokeWeight=stroke==='#063AF5'?2:1;}\n const t=i.findOne(x=>x.name==='Placeholder'); t.characters=ph; await t.setTextStyleIdAsync(sty('Body/L').id); t.fills=S(stroke==='#000000'?'#000000':'#666666'); if(ic){inp.paddingLeft=52; const ico=await icon(ic,'#666666'); c.appendChild(ico); ico.layoutPositioning='ABSOLUTE'; ico.x=16; ico.y=12;} fcs.push(c);}\nids.field=combine(fcs,r1,'Input Field').id;\n\n// Announcement bar\nlet r2=await row('Announcement Bar · Header');\nconst ab=AL('Announcement Bar','HORIZONTAL',4,[9,100,9,100],true); ab.primaryAxisSizingMode='FIXED'; ab.resize(1440,38); ab.primaryAxisAlignItems='CENTER'; ab.fills=S('#000000');\nab.appendChild(await T('Sign up and get 20% off to your first order.','Body/M','#FFFFFF'));\nconst su=await T('Sign Up Now','Body/M Medium','#FFFFFF'); su.textDecoration='UNDERLINE'; su.name='Sign Up Now'; ab.appendChild(su);\nconst cl=await icon('4:11','#FFFFFF'); cl.name='Close'; ab.appendChild(cl); cl.layoutPositioning='ABSOLUTE'; cl.x=1320; cl.y=9;\nr2.appendChild(ab); ids.ann=ab.id;\n\n// Header variants\nconst navSet=await G('10:100'); const navDef=navSet.children.find(c=>c.name==='State=Default'); const navCur=navSet.children.find(c=>c.name==='State=Current');\nconst fieldSearch=(await G(ids.field)).children.find(c=>c.name==='Type=Search');\nconst hcs=[];\nfor(const cur of ['None','Shop']){const h=AL('Current='+cur,'HORIZONTAL',40,[24,100,24,100],true); h.primaryAxisSizingMode='FIXED'; h.resize(1440,96); h.fills=S('#FFFFFF'); h.strokes=S('#E5E5E5'); h.strokeTopWeight=0; h.strokeLeftWeight=0; h.strokeRightWeight=0; h.strokeBottomWeight=1;\n const wm=await T('SHOP.CO','Wordmark'); wm.name='Wordmark'; h.appendChild(wm);\n const nav=AL('Navigation','HORIZONTAL',24); for(const [lbl,ch] of [['Shop',true],['On Sale',false],['New Arrivals',false],['Brands',false]]){const ni=(lbl==='Shop'&&cur==='Shop'?navCur:navDef).createInstance(); ni.name='Nav · '+lbl; const props=ni.componentProperties; const pk=Object.keys(props); ni.setProperties({[pk.find(k=>k.startsWith('Label'))]:lbl,[pk.find(k=>k.startsWith('Chevron'))]:ch}); nav.appendChild(ni);} h.appendChild(nav);\n const sf=fieldSearch.createInstance(); sf.name='Search'; h.appendChild(sf); sf.layoutSizingHorizontal='FILL';\n const ic=AL('Actions','HORIZONTAL',14); const cart=await icon('4:7','#000000'); cart.name='Cart'; const acc=await icon('4:5','#000000'); acc.name='Account'; ic.appendChild(cart); ic.appendChild(acc); h.appendChild(ic); hcs.push(h);}\nconst hs=combine(hcs,r2,'Header'); hs.layoutMode='VERTICAL'; ids.header=hs.id;\n\n// Stat\nlet r3=await row('Stat · Product Card · Style Tile');\nconst st=AL('Stat','VERTICAL',4,[0,0,0,0],true); st.counterAxisAlignItems='MIN'; const sn=await T('200+','Stat'); const sl=await T('International Brands','Body/L','#666666'); st.appendChild(sn); st.appendChild(sl); textProp(st,sn,'Value'); textProp(st,sl,'Label'); r3.appendChild(st); ids.stat=st.id;\n\n// Product card\nconst ratingSet=await G('10:76'); const badge=await G('10:77');\nconst pc=AL('Product Card','VERTICAL',16,[0,0,0,0],true); pc.counterAxisAlignItems='MIN'; pc.counterAxisSizingMode='FIXED'; pc.resize(295,10);\nconst pf=figma.createFrame(); pf.name='Photo frame'; pf.resize(295,298); pf.cornerRadius=20; pf.clipsContent=true; pf.fills=S('#F2F0F1'); pc.appendChild(pf); pf.layoutSizingHorizontal='FILL';\nconst ph=(await G('4:48')).createInstance(); ph.name='Photo'; pf.appendChild(ph); ph.resize(295,298); ph.x=0; ph.y=0; ph.constraints={horizontal:'STRETCH',vertical:'STRETCH'};\nconst info=AL('Info','VERTICAL',8); info.counterAxisAlignItems='MIN'; pc.appendChild(info); info.layoutSizingHorizontal='FILL';\nconst nm=await T('T-shirt with Tape Details','Heading/M'); info.appendChild(nm); nm.layoutSizingHorizontal='FILL';\nconst rr=AL('Rating row','HORIZONTAL',12); const ri=ratingSet.children.find(c=>c.name==='Value=4.5').createInstance(); ri.name='Rating'; rr.appendChild(ri); const sc=await T('4.5/5','Body/M','#000000'); rr.appendChild(sc); info.appendChild(rr);\nconst pr=AL('Price row','HORIZONTAL',10); const p1=await T('$120','Price/M'); const p2=await T('$160','Price/M','#B3B3B3'); p2.textDecoration='STRIKETHROUGH'; p2.name='Old price'; const bi=badge.createInstance(); bi.name='Discount'; pr.appendChild(p1); pr.appendChild(p2); pr.appendChild(bi); info.appendChild(pr);\ntextProp(pc,nm,'Name'); textProp(pc,sc,'Score'); textProp(pc,p1,'Price'); textProp(pc,p2,'Old Price');\nconst kd=pc.addComponentProperty('Has Discount','BOOLEAN',false); p2.componentPropertyReferences={...p2.componentPropertyReferences,visible:kd}; bi.componentPropertyReferences={visible:kd};\nconst kp=pc.addComponentProperty('Photo','INSTANCE_SWAP','4:48'); ph.componentPropertyReferences={mainComponent:kp};\nri.isExposedInstance=true; bi.isExposedInstance=true;\npc.effects=[]; r3.appendChild(pc); ids.card=pc.id;\n\n// Style tile\nconst tile=figma.createComponent(); tile.name='Style Tile'; tile.resize(407,289); tile.cornerRadius=20; tile.clipsContent=true; tile.fills=S('#FFFFFF');\nconst tp=(await G('4:44')).createInstance(); tp.name='Photo'; tile.appendChild(tp); tp.resize(385,289); tp.x=407-385; tp.y=0; tp.constraints={horizontal:'MAX',vertical:'STRETCH'};\nconst tl=await T('Casual','Price/L'); tl.name='Label'; tile.appendChild(tl); tl.x=36; tl.y=25;\ntextProp(tile,tl,'Label'); const kt=tile.addComponentProperty('Photo','INSTANCE_SWAP','4:44'); tp.componentPropertyReferences={mainComponent:kt};\nr3.appendChild(tile); ids.tile=tile.id;\nreturn ids;"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":51205,"cache_read_input_tokens":7701,"cache_creation":{"ephemeral_5m_input_tokens":51205,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"33fdca80-10af-4719-bef6-cca51e068667","uuid":"6fd4f0e2-65b7-4df7-84b2-c63c363de9f2","timestamp":"2026-11-01T20:22:25.351Z","tool_use_meta":[{"id":"toolu_bdrk_01AQ3KcH6etw3iLT3c38MwD3","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
