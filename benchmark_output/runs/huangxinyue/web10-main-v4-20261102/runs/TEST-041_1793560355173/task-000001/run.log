n comp(id){ if(!comps[id]) comps[id]=await figma.getNodeByIdAsync(id); return comps[id]; }\nasync function inst(id,w,h){ const c=await comp(id); const i=c.createInstance(); if(w&&h) i.resize(w,h); return i; }\nasync function icon(id,size,colorHex){ const c=await comp(id); const i=c.createInstance(); const s=size/Math.max(c.width,c.height); i.rescale(s); if(colorHex){ const rec=n=>{ if('fills' in n && Array.isArray(n.fills) && n.fills.some(f=>f.type==='SOLID')) n.fills=[sol(colorHex)]; if('children' in n) n.children.forEach(rec); }; rec(i);} return i; }\nfunction stretchFill(parent,n){ parent.appendChild(n); n.layoutAlign='STRETCH'; n.primaryAxisSizingMode='FIXED'; n.counterAxisSizingMode='AUTO'; }\n\nconst frame=figma.createFrame(); frame.name='04_Cart_Drawer'; frame.resize(1440,950); frame.fills=[sol(C.white)];\nframe.primaryAxisSizingMode='FIXED'; frame.counterAxisSizingMode='FIXED'; frame.clipsContent=true;\nconst hI=(await comp('18:2')).createInstance(); hI.x=0; hI.y=0; frame.appendChild(hI);\nconst cb=fr('BreadcrumbBar'); cb.fills=[sol(C.cream)]; cb.resize(1440,100); cb.x=0; cb.y=100;\nal(cb,{mode:'HORIZONTAL',gap:14,cross:'CENTER',pad:[38,100,38,100]}); cb.primaryAxisSizingMode='FIXED'; cb.counterAxisSizingMode='FIXED';\ncb.appendChild(txt('Home',16,F.reg,C.muted,{name:'Crumb home'}));\ncb.appendChild(await icon('13:46',20,C.ink));\ncb.appendChild(txt('Shop',16,F.reg,C.muted,{name:'Crumb shop'}));\ncb.appendChild(await icon('13:46',20,C.ink));\nconst sepv=figma.createRectangle(); sepv.resize(2,30); sepv.fills=[sol(C.muted)]; cb.appendChild(sepv);\ncb.appendChild(txt('Asgaard sofa',16,F.reg,C.ink,{name:'Crumb current'}));\nframe.appendChild(cb);\nconst main=fr('Product main'); main.resize(1440,750); main.x=0; main.y=200; al(main,{mode:'HORIZONTAL',gap:80,pad:[36,100,60,100]}); main.primaryAxisSizingMode='FIXED'; main.counterAxisSizingMode='FIXED';\nconst gal=fr('Gallery'); al(gal,{mode:'HORIZONTAL',gap:32});\nconst thumbs=fr('Thumbs'); al(thumbs,{mode:'VERTICAL',gap:32});\nfor (const tp of ['13:4','13:14','13:64','13:13']){ const t=await inst(tp,80,80); t.cornerRadius=10; thumbs.appendChild(t); }\ngal.appendChild(thumbs);\nconst mainPhoto=await inst('13:4',423,500); mainPhoto.cornerRadius=10; gal.appendChild(mainPhoto);\nmain.appendChild(gal);\nconst info=fr('Info'); al(info,{mode:'VERTICAL',gap:14});\ninfo.appendChild(txt('Asgaard sofa',42,F.reg,C.ink,{name:'Product title'}));\ninfo.appendChild(txt('Rs. 250,000.00',24,F.med,C.muted,{name:'Price'}));\nconst buyRow=fr('Buy row'); al(buyRow,{mode:'HORIZONTAL',gap:18,cross:'CENTER'});\nconst qty=fr('Quantity'); qty.resize(123,64); qty.cornerRadius=10; qty.strokes=[sol(C.muted)]; qty.strokeWeight=1; al(qty,{mode:'HORIZONTAL',main:'SPACE_BETWEEN',cross:'CENTER',pad:[0,12,0,12]}); qty.primaryAxisSizingMode='FIXED'; qty.counterAxisSizingMode='FIXED';\nqty.appendChild(txt('-',20,F.reg,C.ink,{name:'Qty minus'})); qty.appendChild(txt('1',16,F.med,C.ink,{name:'Qty value'})); qty.appendChild(txt('+',20,F.reg,C.ink,{name:'Qty plus'}));\nbuyRow.appendChild(qty);\nconst atc=fr('Add To Cart'); atc.cornerRadius=15; atc.strokes=[sol(C.ink)]; atc.strokeWeight=1; al(atc,{mode:'HORIZONTAL',pad:[17,48,17,48]}); atc.appendChild(txt('Add To Cart',20,F.reg,C.ink));\nbuyRow.appendChild(atc);\ninfo.appendChild(buyRow);\nmain.appendChild(info);\nframe.appendChild(main);\n\nconst dim=figma.createRectangle(); dim.name='Scrim'; dim.resize(1440,950); dim.x=0; dim.y=0; dim.fills=[{type:'SOLID',color:hex('000000'),opacity:0.2}]; frame.appendChild(dim);\n\nconst drawer=fr('Cart drawer'); drawer.fills=[sol(C.white)]; drawer.resize(417,746); drawer.x=1023; drawer.y=0;\nal(drawer,{mode:'VERTICAL',gap:0,pad:[28,30,30,30]}); drawer.primaryAxisSizingMode='FIXED'; drawer.counterAxisSizingMode='FIXED';\nconst dTop=fr('Drawer top'); al(dTop,{mode:'HORIZONTAL',main:'SPACE_BETWEEN',cross:'CENTER'}); dTop.counterAxisSizingMode='AUTO'; dTop.primaryAxisSizingMode='FIXED'; dTop.resize(357,40);\ndTop.appendChild(txt('Shopping Cart',24,F.sb,C.ink,{name:'Drawer title'}));\ndTop.appendChild(await icon('13:39',20,C.muted));\ndrawer.appendChild(dTop);\nconst dLine=figma.createRectangle(); dLine.resize(357,1); dLine.fills=[sol('D9D9D9')]; dLine.y=0; drawer.appendChild(dLine);\nconst spA=fr('sp'); spA.resize(4,42); drawer.appendChild(spA);\nconst item=fr('Cart item'); al(item,{mode:'HORIZONTAL',gap:32,cross:'CENTER'}); item.primaryAxisSizingMode='FIXED'; item.counterAxisSizingMode='AUTO'; item.resize(357,105);\nconst iph=await inst('13:4',105,105); iph.cornerRadius=10; item.appendChild(iph);\nconst itxt=fr('Item texts'); al(itxt,{mode:'VERTICAL',gap:8});\nitxt.appendChild(txt('Asgaard sofa',16,F.sb,C.ink,{name:'Item name'}));\nconst qtyRow=fr('Item qty row'); al(qtyRow,{mode:'HORIZONTAL',gap:15,cross:'CENTER'});\nqtyRow.appendChild(txt('1',16,F.med,C.ink)); qtyRow.appendChild(txt('X',12,F.med,C.ink)); qtyRow.appendChild(txt('Rs. 250,000.00',16,F.med,C.gold,{name:'Item price'}));\nitxt.appendChild(qtyRow); item.appendChild(itxt);\nitem.appendChild(await icon('13:43',20,'8A8A8A'));\ndrawer.appendChild(item);\nconst spB=fr('sp'); spB.resize(4,140); drawer.appendChild(spB);\nconst subRow=fr('Subtotal row'); al(subRow,{mode:'HORIZONTAL',main:'SPACE_BETWEEN',cross:'CENTER'}); subRow.primaryAxisSizingMode='FIXED'; subRow.resize(357,24);\nsubRow.appendChild(txt('Subtotal',16,F.reg,C.ink,{name:'Subtotal label'}));\nsubRow.appendChild(txt('Rs. 250,000.00',16,F.sb,C.gold,{name:'Subtotal value'}));\ndrawer.appendChild(subRow);\nconst spC=fr('sp'); spC.resize(4,23); drawer.appendChild(spC);\nconst dLine2=figma.createRectangle(); dLine2.resize(357,1); dLine2.fills=[sol('D9D9D9')]; drawer.appendChild(dLine2);\nconst spD=fr('sp'); spD.resize(4,26); drawer.appendChild(spD);\nconst btns=fr('Drawer actions'); al(btns,{mode:'HORIZONTAL',gap:14,cross:'CENTER'});\nconst mkB=(label)=>{ const b=fr('Btn/'+label); b.cornerRadius=50; b.strokes=[sol(C.ink)]; b.strokeWeight=1; al(b,{mode:'HORIZONTAL',pad:[6,30,6,30]}); b.appendChild(txt(label,12,F.reg,C.ink)); return b; };\nbtns.appendChild(mkB('Cart')); btns.appendChild(mkB('Checkout')); btns.appendChild(mkB('Comparison'));\ndrawer.appendChild(btns);\nframe.appendChild(drawer);\n\nWS.appendChild(frame); frame.x=4800; frame.y=0;\nreturn {id:frame.id};\n","description":"Build 04_Cart_Drawer: dimmed product page behind, right-side shopping cart drawer with item, subtotal and Cart/Checkout/Comparison actions"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"4169e7d1-fa58-4180-9c80-2a57d8444911","uuid":"8195ebd9-df1b-473c-aeda-37edffdd0f5f","timestamp":"2026-11-01T19:27:45.300Z","tool_use_meta":[{"id":"mcp__figma__use_figma_23_681383a8","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
