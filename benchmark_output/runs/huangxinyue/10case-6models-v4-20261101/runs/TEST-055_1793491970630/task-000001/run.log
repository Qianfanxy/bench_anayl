appendChild(wrap);return wrap;}\nasync function txRow(parent,x,y,d){\n  const rowI = await instOf('10:2'); rowI.x=x; rowI.y=y; parent.appendChild(rowI);\n  const icon = rowI.children[0]; icon.children[0].visible=false;\n  const lg = await instOf(d.icon, d.iw, d.ih); lg.x=(40-d.iw)/2; lg.y=(40-d.ih)/2; parent.appendChild(lg); lg.x=x+16+(40-d.iw)/2; lg.y=y+12+(40-d.ih)/2;\n  rowI.children[1].characters=d.title; rowI.children[2].characters=d.date; rowI.children[3].characters=d.amt;\n  if(!d.neg) rowI.children[3].fills=solid(C.green);\n  return rowI;\n}\nconst TX=[{icon:'5:9',iw:18,ih:18,title:'Nike Air Max 2090',date:'15 Aug 2020',amt:'−$243.00',neg:true},{icon:'5:5',iw:20,ih:15,title:'iPad Pro 2020',date:'10 Aug 2020',amt:'−$799.00',neg:true},{icon:'5:7',iw:22,ih:13,title:'Uber',date:'5 Mar 2020',amt:'+$50.00',neg:false}];\n\n// ============ 01_Get_Started ============\nconst f1 = screen('01_Get_Started', 0);\nawait shell(f1);\nconst illus = await instOf('5:6', 300, 200); illus.x=37.5; illus.y=150; f1.appendChild(illus);\nconst logo = await instOf('6:10', 150, 20); logo.x=112.5; logo.y=400; f1.appendChild(logo);\nconst tag = txt('Going cashless has never been easier with the world’s leading expense manager.', 15, 'Regular', C.gray);\ntag.textAutoResize='HEIGHT'; tag.resize(311, tag.height); tag.textAlignHorizontal='CENTER'; tag.x=32; tag.y=446; f1.appendChild(tag);\nconst btn1 = await instOf('1:23', 343, 56); btn1.x=16; btn1.y=690; btn1.name='Get Started'; f1.appendChild(btn1);\n\n// ============ 02_Home ============\nconst f2 = screen('02_Home', 500);\nawait shell(f2);\nawait circleAvatar(f2,'5:4',44,16,58,108,72);\nconst g1 = txt('Hello, Maria', 20, 'Bold', C.ink); g1.x=72; g1.y=61; f2.appendChild(g1);\nconst g2 = txt('Home', 13, 'Regular', C.gray); g2.x=72; g2.y=85; f2.appendChild(g2);\nconst plusBtn = figma.createFrame(); plusBtn.resize(44,44); plusBtn.cornerRadius=22; plusBtn.x=315; plusBtn.y=58; plusBtn.fills=solid(C.brand); plusBtn.name='New payment'; f2.append