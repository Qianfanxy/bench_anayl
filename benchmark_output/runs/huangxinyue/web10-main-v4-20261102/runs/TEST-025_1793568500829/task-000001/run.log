me='Text Field (starter)'; fWrap.fills=[]; fWrap.layoutMode='VERTICAL'; fWrap.primaryAxisSizingMode='AUTO'; fWrap.counterAxisSizingMode='AUTO'; fWrap.itemSpacing=12;\nfWrap.appendChild(fInst); fWrap.appendChild(T('Text Field · default from 02 · Components → base of our Text Field set',14,'Regular',muted));\nrow.appendChild(fWrap);\nsec.appendChild(row);\nds.appendChild(sec);\nds.layoutMode='VERTICAL'; ds.primaryAxisSizingMode='AUTO'; ds.itemSpacing=56; ds.paddingTop=56; ds.paddingBottom=56; ds.paddingLeft=56; ds.paddingRight=56;\nreturn JSON.stringify({ds:ds.id, w:Math.round(ds.width), h:Math.round(ds.height), kids:ds.children.map(c=>c.name+' '+Math.round(c.width)+'x'+Math.round(c.height))});","description":"Add source component instances to design system frame","fileKey":"YUW1fDQZdbeVJfGXh6CwcB"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":4555,"input_tokens":55,"cache_read_input_tokens":148087,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":4555}},"context_management":null},"parent_tool_use_id":null,"session_id":"1a2ea8f9-759f-405f-98a5-13324c4c09fc","uuid":"b91c5b8e-3147-4a96-b603-85e24e2ad4f3","timestamp":"2026-11-01T21:51:23.751Z","tool_use_meta":[{"id":"toolu_01cy5wmtZNvtXnNKkwT4Sxjl","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
