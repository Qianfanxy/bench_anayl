ance(); f.appendChild(th); th.x=20; th.y=1436; const tts=th.findAll(x=>x.type===\"TEXT\"); if(tts[0])tts[0].characters=\"Trending Products\"; if(tts[1])tts[1].characters=\"View all\";\nconst ld=T(\"Last Date 28/02/22\",11,\"Regular\",\"#8F959E\"); f.appendChild(ld); ld.x=20; ld.y=1464;\nconst tr=FR(\"Trending Row\",335,200,null,true); f.appendChild(tr); tr.x=20; tr.y=1486;\nconst tdata=[\n [\"IWC Schaffhausen 2021 Pilot’s Watch “SIHH 2019” 44mm\",\"₹650\",\"₹1,599\",\"59% off\"],\n [\"Labbin White Sneakers For Men and Female\",\"₹650\",\"₹1,250\",\"48% off\"],\n [\"Mammon Women’s Handbag (Set of 3, Beige)\",\"₹750\",\"₹1,999\",\"62% off\"],\n [\"Do Bhai Women Wedges Sandal (Butterfly)\",\"₹750\",\"₹1,499\",\"50% off\"],\n [\"Lakme Enrich Matte Lipstick - Shade RM1 (4.7gm)\",\"₹950\",\"₹1,990\",\"52% off\"]];\nfor(let i=0;i<5;i++){const d=tdata[i];const c=miniC.createInstance();c.x=i*76;c.y=0;c.resize(72,10);tr.appendChild(c);\n  const ts=c.findAll(x=>x.type===\"TEXT\");\n  if(ts[0]){ts[0].characters=d[0];ts[0].fontSize=9;}\n  if(ts[1])ts[1].characters=d[1]; if(ts[2])ts[2].characters=d[2]; if(ts[3])ts[3].characters=d[3]; if(ts[4])ts[4].characters=\"\";\n  if(trendPh[i]){const inner=c.findOne(n=>n.type===\"INSTANCE\");if(inner)inner.swapComponent(trendPh[i]);}else{grayOut(c);const ic=srchC.createInstance();ic.resize(28,28);tint(ic,\"#C0C4CC\");tr.appendChild(ic);ic.x=i*76+22;ic.y=22;}}\nconst nv=homeVar.createInstance(); f.appendChild(nv); nv.x=0; nv.y=1696;\nreturn JSON.stringify({frame:f.id});","description":"Rebuild 09_Home with verbatim data: deal/trending names, promo subtitles, Flat and Heels overlay","fileKey":"tB1sUry3dJDspx8uxl0ftc"}}],"id":"ae85fd1d-7ab5-45af-9cf0-49ec7b486e8f","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"27c02197-3252-480f-900a-884ff728e974","uuid":"2d1db496-b8db-4f74-afa2-ee8