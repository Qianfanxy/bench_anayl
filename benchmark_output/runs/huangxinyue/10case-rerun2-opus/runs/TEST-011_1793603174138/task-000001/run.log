(bg||K.bg);f.clipsContent=true;return f;};\nconst shadow=(a,y,r)=>[{type:'DROP_SHADOW',color:{r:0.1,g:0.1,b:0.12,a},offset:{x:0,y},radius:r,spread:0,visible:true,blendMode:'NORMAL'}];\nconst out={};\n// ===== 05 =====\nconst s5=screen('05_Trading',1976);out.s5=s5.id;\nput(s5,await inst('1:33'),0,0);\nconst h5=await inst('8:111');h5.name='Header';sp(h5,{Title:'Trading','Show menu':true,'Show chart':true,'Show insights':true});put(s5,h5,0,44);\nconst si=await inst('12:178');si.name='Stock · AAPL';put(s5,si,20,112);\nconst per=figma.createFrame();per.name='Period selector';AL(per,'HORIZONTAL',{gap:2,pad:[4,4,4,4],fill:'#ECEEF3',pFixed:true});per.resize(374,40);per.cornerRadius=12;\nfor(const l of ['Day','Week','Month','Year','All']){const c=await inst('12:168',l==='Day'?'State=Selected':'State=Default');c.name='Period · '+l;sp(c,{Label:l});per.appendChild(c);c.layoutGrow=1;}\nput(s5,per,20,184);\nconst pan=figma.createFrame();pan.name='Chart panel';pan.resize(374,300);pan.fills=P('#FFFFFF');pan.cornerRadius=20;pan.effects=shadow(0.05,4,16);put(s5,pan,20,240);\nconst cap=T('AAPL · Intraday',13,'Semi Bold',K.ink);put(pan,cap,16,14);\nconst cht=await inst('11:148');cht.name='Candlestick Chart';put(pan,cht,4,36);\n// shrink: scale chart instance to fit 366\ncht.rescale(0.97);\nconst pos=figma.createFrame();pos.name='Position';AL(pos,'HORIZONTAL',{gap:16});\nfor(const [l,v] of [['Market Value','$97.83'],['Buying Power','$18,943.43']]){const i=await inst('12:158');i.name='Position · '+l;sp(i,{Label:l,Value:v,'Show change':false});pos.appendChild(i);}\nput(s5,pos,20,556);\nconst tr=figma.createFrame();tr.name='Trade actions';AL(tr,'HORIZONTAL',{gap:16});\nconst buy=await inst('12:177','Type=Buy');buy.name='Buy';tr.appendChild(buy);const sell=await inst('12:177','Type=Sell');sell.name='Sell';tr.appendChild(sell);\nput(s5,tr,20,0);\nconst tb5=await inst('7:132','Current=Invest');tb5.name='Tab Bar';put(s5,tb5,0,896-tb5.height);tr.y=896-tb5.height-20-56;\nout.posEnd=pos.y+pos.hei