ateComponent(); c.name=name; c.resize(w,h); c.fills=[]; c.x=24; c.y=8; ds.appendChild(c); return c; }\nconst ICONS={chev:'1:359',edit:'1:375',signout:'1:379',send:'1:383',menu:'1:404',search:'1:347',filter:'1:351',star:'1:363'};\n\n// ---------- Profile Row ----------\nawait label('PROFILE ROW', 2280);\nconst pr=comp('DS / Profile Row',382,56);\nconst prTile=figma.createRectangle(); prTile.resize(40,40); prTile.x=0; prTile.y=8; prTile.cornerRadius=12; prTile.fills=[{type:'SOLID',color:{r:0.965,g:0.949,b:0.941}}]; prTile.name='Tile'; pr.appendChild(prTile);\nawait T(pr,'Order history',{x:56,y:19,size:15,style:'Medium',color:BROWN});\nconst prChev=await iconInst(ICONS.chev,20,FAINT); prChev.x=382-20-4; prChev.y=18; pr.appendChild(prChev);\npr.x=24; pr.y=2316;\n\n// ---------- Switch ----------\nawait label('SWITCH (ON / OFF)', 2410);\nfunction sw(name,on){\n  const c=comp(name,48,28);\n  const track=figma.createRectangle(); track.resize(48,28); track.cornerRadius=14; track.fills=[{type:'SOLID',color:on?RED:{r:0.85,g:0.83,b:0.82}}]; track.name='Track'; c.appendChild(track);\n  const th=figma.createEllipse(); th.resize(22,22); th.x=on?23:3; th.y=3; th.fills=[{type:'SOLID',color:WHITE}]; th.name='Thumb';\n  th.effects=[{type:'DROP_SHADOW',color:{r:0.2,g:0.15,b:0.15,a:0.2},offset:{x:0,y:1},radius:3,spread:0,visible:true,blendMode:'NORMAL'}];\n  c.appendChild(th);\n  return c;\n}\nconst swOn=sw('State=On',true); const swOff=sw('State=Off',false);\nconst swSet=figma.combineAsVariants([swOn,swOff], ds);\nswSet.name='DS / Switch'; swSet.x=24; swSet.y=2446; swSet.itemSpacing=16;\n\n// ---------- Chat bubble variants ----------\nawait label('CHAT BUBBLE · Sender', 2510);\nfunction bubble(name,isAgent,txt,fill,tc,w=280){\n  const c=comp(name,w,10);\n  const bg=figma.createRectangle(); bg.cornerRadius=16; bg.fills=[{type:'SOLID',color:fill}]; bg.name='Bg'; c.appendChild(bg);\n  const t=figma.createText(); t.fontName={family:'Roboto',style:'Regular'}; t.characters=txt; t.fontSize=14;\n  t.fills=[{type:'SOLID',color:tc}]; t.lineHeight={unit:'PIXELS',value:20}; t.textAutoResize='HEIGHT'; t.resize(w-28,10);\n  c.appendChild(t); t.x=14; t.y=12;\n  const H=t.height+24; bg.resize(w,H); c.resize(w,H);\n  return c;\n}\nconst bA=bubble('Sender=Agent',true,'Hi, how can I help you?',WHITE,BROWN);\nconst bC=bubble('Sender=Customer',false,'Hello, I ordered two Cheeseburger Wendy’s Burgers. Can I know how long it will take to arrive?',RED,WHITE,320);\nconst bSet=figma.combineAsVariants([bA,bC], ds);\nbSet.name='DS / Chat Bubble'; bSet.x=24; bSet.y=2546; bSet.itemSpacing=16;\n\n// ---------- Profile Header ----------\nawait label('PROFILE HEADER (TITLE / ACTIONS)', 2640);\nasync function pHeader(name,leftTitle){\n  const c=comp(name,382,40);\n  const tile=figma.createRectangle(); tile.resize(40,40); tile.cornerRadius=12; tile.fills=[{type:'SOLID',color:WHITE}]; tile.strokes=[{type:'SOLID',color:LINE}]; tile.strokeWeight=1; tile.name='Back Btn'; c.appendChild(tile);\n  const bk=await iconInst('1:355',20,BROWN); bk.x=10; bk.y=10; c.appendChild(bk);\n  const t=await T(c,'Profile',{size:16,style:'SemiBold',color:BROWN,align:'CENTER'}); t.resize(382,t.height); t.x=0; t.y=(40-t.height)/2; t.name='Title';\n  const tile2=figma.createRectangle(); tile2.resize(40,40); tile2.x=382-40; tile2.cornerRadius=12; tile2.fills=[{type:'SOLID',color:WHITE}]; tile2.strokes=[{type:'SOLID',color:LINE}]; tile2.strokeWeight=1; tile2.name='Action Btn'; c.appendChild(tile2);\n  const st=await iconInst(leftTitle?'1:367':'1:404',20,BROWN); st.x=382-40+10; st.y=10; c.appendChild(st);\n  return c;\n}\nconst hProfile=await pHeader('Type=Settings',true);\nconst hChat=await pHeader('Type=Menu',false);\nconst hSet=figma.combineAsVariants([hProfile,hChat], ds);\nhSet.name='DS / Header (Title + Actions)'; hSet.x=24; hSet.y=2676; hSet.itemSpacing=24;\n\n// ---------- Search Bar ----------\nawait label('SEARCH BAR', 2770);\nconst sb=comp('DS / Search Bar',382,56);\nconst f=figma.createRectangle(); f.resize(382-64,56); f.cornerRadius=14; f.fills=[{type:'SOLID',color:WHITE}]; f.name='Field'; sb.appendChild(f);\nconst si=await iconInst(ICONS.search,20,FAINT); si.x=16; si.y=18; sb.appendChild(si);\nawait T(sb,'Search',{x:48,y:19,size:15,style:'Regular',color:FAINT});\nconst fb=figma.createRectangle(); fb.resize(56,56); fb.x=382-56; fb.cornerRadius=14; fb.fills=[{type:'SOLID',color:RED}]; fb.name='Filter Btn'; sb.appendChild(fb);\nconst fi=await iconInst(ICONS.filter,22,WHITE); fi.x=382-56+17; fi.y=17; sb.appendChild(fi);\nsb.x=24; sb.y=2806;\n\nreturn JSON.stringify({profileRow:pr.id, switchSet:swSet.id, bubbleSet:bSet.id, headerSet:hSet.id, searchBar:sb.id});\n","description":"Build ProfileRow, Switch variants, ChatBubble variants, ProfileHeader variants, SearchBar components","fileKey":"xCaQ6D2H3AhzjPBYLooEMF"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"646e8bf7-f7ad-4c70-b0b4-d0ae7901c022","uuid":"51d201f1-8f31-461b-a4d9-f3777c5d65b0","timestamp":"2026-10-28T16:29:52.232Z","tool_use_meta":[{"id":"mcp__figma__use_figma_12_6ac1f298","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
