L',justify:'CENTER',align:'CENTER'});annClose.fills=[];ann.appendChild(annClose);\nannClose.appendChild(icon('Close',16,C.white));\nannClose.x=1380;annClose.layoutPositioning='ABSOLUTE';\nann.x=0;ann.y=-2400;\n\n// ---- Header ----\nfunction buildHeader(name,current){\n  const hdr=frame(lib,name,{w:1440,h:96,fill:C.white},true);\n  const row=frame(hdr,'Row',{w:1240,h:96,dir:'HORIZONTAL',align:'CENTER',gap:40,x:100});\n  row.fills=[];\n  const logo=frame(row,'Wordmark',{w:170,h:32,dir:'HORIZONTAL',align:'CENTER'});logo.fills=[];\n  text(logo,{text:'SHOP.CO',font:F.display,size:32,color:C.ink,lh:32});\n  const nav=frame(row,'Nav',{dir:'HORIZONTAL',gap:28,align:'CENTER'});nav.fills=[];\n  const navDefs=[['Shop',true],['On Sale',false],['New Arrivals',false],['Brands',false]];\n  navDefs.forEach(function(d){\n    const item=frame(nav,'Nav Item',{dir:'HORIZONTAL',gap:4,align:'CENTER'});item.fills=[];\n    const isCur=current===d[0];\n    const t=text(item,{text:d[0],font:isCur?F.semi:F.reg,size:16,color:isCur?C.ink:C.ink2});\n    if(d[1]) item.appendChild(icon('Chevron_Down',16,C.ink2));\n    if(isCur){const dot=frame(item,'Current',{w:6,h:6,radius:3,fill:C.ink});}\n  });\n  const searchField=(function(){\n    const wrap=frame(row,'Search',{w:420,h:48,fill:C.surface,radius:62,dir:'HORIZONTAL',align:'CENTER',gap:12,padX:16});\n    wrap.appendChild(icon('Search',20,C.muted));\n    text(wrap,{text:'Search for products...',font:F.reg,size:16,color:C.muted});\n    return wrap;\n  })();\n  const actions=frame(row,'Actions',{dir:'HORIZONTAL',gap:16,align:'CENTER'});actions.fills=[];\n  actions.appendChild(icon('Cart',24,C.ink));\n  actions.appendChild(icon('Account',24,C.ink));\n  if(current!=='Shop') hdr.fills=[paint(C.white)];\n  return hdr;\n}\nconst hdrA=buildHeader('Header',null);\nconst hdrB=buildHeader('Header (Shop current)','Shop');\nhdrA.x=0;hdrA.y=-2300;hdrB.x=0;hdrB.y=-2180;\nconst hdrSet=figma.combineAsVariants([hdrA,hdrB],lib);hdrSet.name='Header';hdrSet.x=0;hdrSet.y=-2320;\n\n// ---- Breadcrumb ----\nfunction buildCrumb(name,items){\n  const bc=frame(lib,name,{w:1240,h:24,dir:'HORIZONTAL',gap:10,align:'CENTER'},true);bc.fills=[];\n  items.forEach(function(it,i){\n    const isLast=i===items.length-1;\n    text(bc,{text:it,font:F.reg,size:14,color:isLast?C.ink:C.muted});\n    if(!isLast) bc.appendChild(icon('Chevron_Right',14,C.muted));\n  });\n  return bc;\n}\nconst crumbHome=buildCrumb('Breadcrumb · Home › Cart',['Home','Cart']);\nconst crumbCat=buildCrumb('Breadcrumb · Home › Casual',['Home','Casual']);\nconst crumbProd=buildCrumb('Breadcrumb · Home › Shop › Men › T-shirts',['Home','Shop','Men','T-shirts']);\nconst crumbSet=figma.combineAsVariants([crumbHome,crumbCat,crumbProd],lib);crumbSet.name='Breadcrumb';crumbSet.x=1500;crumbSet.y=-2300;\n\n// ---- Brand strip ----\nconst brand=frame(lib,'Brand Strip',{w:1440,h:96,fill:C.ink,dir:'HORIZONTAL',justify:'SPACE_BETWEEN',align:'CENTER',padX:100},true);\n['NORDE','ATELIER K','MONVALE','RIVA','CASSEL'].forEach(function(b){\n  text(brand,{text:b,font:F.display,size:28,color:C.white});\n});\nbrand.x=0;brand.y=-2050;\n\n// ---- Newsletter ----\nconst nl=frame(lib,'Newsletter',{w:1240,h:190,fill:C.ink,radius:20,dir:'HORIZONTAL',justify:'SPACE_BETWEEN',align:'CENTER',padX:64,padY:32},true);\nconst nlTitle=frame(nl,'Title',{w:540,dir:'VERTICAL'});nlTitle.fills=[];\ntext(nlTitle,{text:'STAY UP TO DATE ABOUT',font:F.display,size:40,color:C.white,lh:46});\ntext(nlTitle,{text:'OUR LATEST OFFERS',font:F.display,size:40,color:C.white,lh:46});\nconst nlForm=frame(nl,'Form',{dir:'VERTICAL',gap:12});nlForm.fills=[];\nconst nlField=frame(nlForm,'Email Field',{w:380,h:48,fill:C.white,radius:62,dir:'HORIZONTAL',align:'CENTER',gap:12,padX:16});\nnlField.appendChild(icon('Account',20,C.muted));\ntext(nlField,{text:'Enter your email address',font:F.reg,size:16,color:C.muted});\nconst nlBtn=frame(nlForm,'Subscribe',{w:380,h:48,fill:C.white,radius:62,dir:'HORIZONTAL',justify:'CENTER',align:'CENTER'});\ntext(nlBtn,{text:'Subscribe to Newsletter',font:F.med,size:16,color:C.ink});\nnl.x=100;nl.y=-1900;\n\n// ---- Footer ----\nconst ft=frame(lib,'Footer',{w:1440,h:520,fill:C.surface},true);\nconst ftInner=frame(ft,'Inner',{w:1240,dir:'VERTICAL',gap:40,x:100,y:60});ftInner.fills=[];\nconst ftTop=frame(ftInner,'Top',{w:1240,dir:'HORIZONTAL',justify:'SPACE_BETWEEN',align:'MIN',gap:40});ftTop.fills=[];\nconst ftBrand=frame(ftTop,'Brand',{w:300,dir:'VERTICAL',gap:18});ftBrand.fills=[];\ntext(ftBrand,{text:'SHOP.CO',font:F.display,size:32,color:C.ink});\ntext(ftBrand,{text:'We have clothes that suit your style and which you’re proud to wear. From women to men.',font:F.reg,size:14,color:C.body,lh:20,w:300});\nconst socials=frame(ftBrand,'Socials',{dir:'HORIZONTAL',gap:12,align:'CENTER'});socials.fills=[];\n[['4:30','Twitter'],['4:24','Facebook'],['4:27','Instagram'],['4:25','GitHub']].forEach(function(s){\n  const c=figma.getNodeByIdAsync(s[0]);\n});\nconst socChips=[];\nfor (const sid of ['4:30','4:24','4:27','4:25']) {\n  const src=await figma.getNodeByIdAsync(sid);\n  const pill=frame(socials,'Social',{w:36,h:36,fill:C.white,radius:18,dir:'HORIZONTAL',justify:'CENTER',align:'CENTER'});\n  const inst=src.createInstance();\n  pill.appendChild(inst);\n}\nconst colsDef=[['COMPANY',['About','Features','Works','Career']],['HELP',['Customer Support','Delivery Details','Terms & Conditions','Privacy Policy']],['FAQ',['Account','Manage Deliveries','Orders','Payments']],['RESOURCES',['Free eBooks','Development Tutorial','How to - Blog','Youtube Playlist']]];\ncolsDef.forEach(function(cd){\n  const col=frame(ftTop,'Column',{w:190,dir:'VERTICAL',gap:16});col.fills=[];\n  text(col,{text:cd[0],font:F.med,size:14,color:C.ink,ls:6});\n  cd[1].forEach(function(l){text(col,{text:l,font:F.reg,size:15,color:C.body,lh:20});});\n});\nftInner.appendChild(rule(ftInner,1240,'#D4D4D8'));\nconst ftBottom=frame(ftInner,'Bottom',{w:1240,dir:'HORIZONTAL',justify:'SPACE_BETWEEN',align:'CENTER'});ftBottom.fills=[];\ntext(ftBottom,{text:'Shop.co © 2000-2023, All Rights Reserved',font:F.reg,size:14,color:C.body});\nconst pays=frame(ftBottom,'Payments',{dir:'HORIZONTAL',gap:10,align:'CENTER'});pays.fills=[];\nfor (const pid of ['4:31','4:28','4:29','4:22','4:26']) {\n  const src=await figma.getNodeByIdAsync(pid);\n  const pill=frame(pays,'Pay',{w:76,h:48,fill:C.white,radius:8,dir:'HORIZONTAL',justify:'CENTER',align:'CENTER',clip:true});\n  const inst=src.createInstance();\n  inst.rescale(0.82);\n  pill.appendChild(inst);\n}\nft.x=0;ft.y=-1700;\n\n// ---- Order Summary ----\nconst os=frame(lib,'Order Summary',{w:500,dir:'VERTICAL',gap:24,fill:C.white,radius:20,stroke:C.line,pad:28},true);\ntext(os,{text:'Order Summary',font:F.bold,size:24,color:C.ink});\nconst osRows=frame(os,'Rows',{w:444,dir:'VERTICAL',gap:16});osRows.fills=[];\n[['Subtotal','$565',C.body,C.ink],['Discount (-20%)','-$113',C.body,C.discount],['Delivery Fee','$15',C.body,C.ink]].forEach(function(r){\n  const row=frame(osRows,'Row',{w:444,dir:'HORIZONTAL',justify:'SPACE_BETWEEN'});\n  text(row,{text:r[0],font:F.reg,size:16,color:r[2]});\n  text(row,{text:r[1],font:F.med,size:16,color:r[3]});\n});\nconst totalRow=frame(osRows,'Total Row',{w:444,dir:'HORIZONTAL',justify:'SPACE_BETWEEN',align:'CENTER'});\ntext(totalRow,{text:'Total',font:F.bold,size:22,color:C.ink});\ntext(totalRow,{text:'$467',font:F.bold,size:24,color:C.ink});\nconst promoRow=frame(os,'Promo',{w:444,dir:'HORIZONTAL',gap:12});promoRow.fills=[];\nconst promoField=frame(promoRow,'Promo Field',{w:300,h:48,fill:C.surface,radius:62,dir:'HORIZONTAL',align:'CENTER',gap:10,padX:16});\npromoField.appendChild(icon('Tag',20,C.muted));\ntext(promoField,{text:'Add promo code',font:F.reg,size:16,color:C.muted});\nconst applyBtn=frame(promoRow,'Apply',{w:130,h:48,fill:C.ink,radius:62,dir:'HORIZONTAL',justify:'CENTER',align:'CENTER'});\ntext(applyBtn,{text:'Apply',font:F.med,size:16,color:C.white});\nconst checkout=frame(os,'Checkout',{w:444,h:56,fi