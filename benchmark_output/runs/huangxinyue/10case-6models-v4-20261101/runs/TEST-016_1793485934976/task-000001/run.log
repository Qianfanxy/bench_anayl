ingMode='AUTO';set.itemSpacing=24;set.paddingLeft=set.paddingRight=set.paddingTop=set.paddingBottom=24;set.fills=[solid(bg)];set.cornerRadius=16;set.counterAxisAlignItems='CENTER';return set;}\nconst M={Bank:'4:8',Check:'4:12',Close:'4:13',History:'4:14',Logout:'4:15',NewPay:'4:16',Offer:'4:17',Receive:'4:18',Refresh:'4:19',Scan:'4:20',Search:'4:21',Send:'4:23',Settings:'4:22'};\nasync function icon(k,col,size=24){const i=(await figma.getNodeByIdAsync(M[k])).createInstance();i.findAll(n=>n.type==='VECTOR').forEach(v=>v.strokes=[solid(col)]);if(size!==24)i.rescale(size/24);return i;}\nfunction comp(name,dir,o={}){const c=figma.createComponent();c.name=name;c.layoutMode=dir;c.primaryAxisSizingMode='AUTO';c.counterAxisSizingMode='AUTO';c.itemSpacing=o.gap??0;c.paddingLeft=c.paddingRight=o.px??0;c.paddingTop=c.paddingBottom=o.py??0;c.fills=o.fill?[solid(o.fill,o.fo??1)]:[];if(o.r)c.cornerRadius=o.r;c.counterAxisAlignItems=o.align??'CENTER';return c;}\nconst ids={};\n// Icon Button\nlet sec=section('Icon Button · Tone × State');\nlet cs=[];\nfor(const [tone,bg,bo,fg] of [['Surface','FFFFFF',1,T.ink],['OnBrand','FFFFFF',0.16,'FFFFFF']])for(const state of ['Default','Pressed']){const c=comp(`Tone=${tone}, State=${state}`,'HORIZONTAL',{fill:bg,fo:state==='Pressed'?(tone==='Surface'?1:0.28):bo,r:22});c.primaryAxisAlignItems='CENTER';c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';c.resize(44,44);if(tone==='Surface'){c.strokes=[solid(T.border)];if(state==='Pressed')c.fills=[solid(T.bg)];}\n const ic=await icon('History',fg);ic.name='Icon';c.appendChild(ic);cs.push(c);}\nids.iconBtn=setify(cs,sec,'Icon Button','HORIZONTAL','8F97B8').id;\n// Badge\nsec=section('Badge · Primary account');\nconst bd=comp('Badge / Primary','HORIZONTAL',{gap:4,px:8,py:4,fill:'FFFFFF',r:12});bd.paddingRight=10;const bi=await icon('Check',T.brand,16);bd.appendChild(bi);bd.appendChild(txt('Primary',12,'Semi Bold',T.brand,16));sec.appendChild(bd);ids.badge=bd.id;\n// Search field\nsec=section('Search Bar · Home header');\nconst sb=comp('Search Bar','HORIZONTAL',{gap:10,px:14,fill:'FFFFFF',r:22});sb.primaryAxisSizingMode='FIXED';sb.counterAxisSizingMode='FIXED';sb.resize(250,44);sb.strokes=[solid(T.border)];sb.appendChild(await icon('Search',T.text2,20));const st=txt('Pay by name or phone',15,'Regular',T.text3,20);sb.appendChild(st);sec.appendChild(sb);ids.search=sb.id;\n// Home Header\nconst av=await figma.getNodeByIdAsync('4:2');\nconst hh=comp('Header / Home','HORIZONTAL',{gap:12,px:16});hh.primaryAxisSizingMode='FIXED';hh.resize(390,44);hh.primaryAxisAlignItems='SPACE_BETWEEN';\nconst avw=figma.createFrame();avw.name='Avatar';avw.resize(44,44);avw.cornerRadius=22;avw.clipsContent=true;avw.strokes=[solid('FFFFFF')];avw.strokeWeight=2;avw.strokeAlign='INSIDE';const ai=av.createInstance();ai.rescale(44/72);avw.appendChild(ai);ai.x=0;ai.y=0;\nhh.appendChild(avw);const sbi=sb.createInstance();hh.appendChild(sbi);sbi.layoutGrow=1;\nconst ib=(await figma.getNodeByIdAsync(ids.iconBtn)).children[0].createInstance();ib.name='History Button';hh.appendChild(ib);\nsec.appendChild(hh);ids.homeHeader=hh.id;\n// Sheet Header\nsec=section('Header / Sheet');\nconst sh=comp('Header / Sheet','VERTICAL',{gap:0,px:24});sh.counterAxisSizingMode='FIXED';sh.resize(390,10);sh.counterAxisAlignItems='MIN';sh.fills=[solid('FFFFFF')];\nconst grab=af('Grabber row','HORIZONTAL',{py:8});grab.primaryAxisAlignItems='CENTER';const g=figma.createRectangle();g.name='Grabber';g.resize(40,5);g.cornerRadius=3;g.fills=[solid(T.border)];grab.appendChild(g);sh.appendChild(grab);grab.layoutAlign='STRETCH';grab.primaryAxisSizingMode='FIXED';\nconst top=af('Title row','HORIZONTAL',{});top.primaryAxisAlignItems='SPACE_BETWEEN';top.counterAxisAlignItems='CENTER';sh.appendChild(top);top.layoutAlign='STRETCH';top.primaryAxisSizingMode='FIXED';top.paddingTop=8;\nconst tt=txt('Get Started',24,'Bold',T.ink,30);tt.name='Title';top.appendChild(tt);\nconst linkSet=await figma.getNodeByIdAsync('8:119');const cancel=linkSet.children.find(c=>c.name==='Tone=Brand, State=Default').createInstance();cancel.name='Cancel';top.appendChild(cancel);cancel.setProperties({[Object.keys(cancel.componentProperties).find(k=>k.startsWith('Label'))]:'Cancel'});\nconst sub=txt('Please enter the mobile phone number',15,'Regular',T.text2,22);sub.name='Subtitle';sh.appendChild(sub);sh.itemSpacing=4;\nsec.appendChild(sh);ids.sheetHeader=sh.id;\nreturn JSON.stringify(ids);","description":"Create icon button, badge, search, headers","fileKey":"MBJGR6pcP8R2URhIN3ARYg"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":2068,"cache_read_input_tokens":36652,"cache_creation":{"ephemeral_5m_input_tokens":2068,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"624c2a9a-654c-44d2-8d05-3d341d78f1b2","uuid":"21b453c2-b910-46ee-9a40-11bbaa34b9a9","timestamp":"2026-10-31T22:36:50.437Z","tool_use_meta":[{"id":"toolu_bdrk_01X7xxFDTy8jJQm5V3gg71e9","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
