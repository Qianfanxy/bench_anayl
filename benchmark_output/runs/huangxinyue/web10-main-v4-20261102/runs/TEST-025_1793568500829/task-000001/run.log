,n){ p.appendChild(n); return n; }\nfunction icon(id,color){ const inst=figma.getNodeById(id).createInstance();\n  inst.findAll(n=>['VECTOR','RECTANGLE','ELLIPSE','LINE','POLYGON','STAR','BOOLEAN_OPERATION'].includes(n.type)).forEach(v=>{\n    try{ if(v.fills && v.fills.length) v.fills=solid(color);}catch(e){}\n    try{ if(v.strokes && v.strokes.length) v.strokes=solid(color);}catch(e){} });\n  return inst; }\nconst btnSet = figma.getNodeById('8:42');\nconst fieldSet = figma.getNodeById('8:63');\nbtnSet.children.forEach(c=>{ try{ c.layoutSizingHorizontal='AUTO'; }catch(e){} });\nfieldSet.children.forEach(c=>{ try{ const b=c.children[1]; b.layoutSizingHorizontal='FILL'; }catch(e){} });\nconst btn=(style,state)=>{const c=btnSet.children.find(x=>x.name===`Style=${style}, State=${state}`); return c.createInstance();};\nconst field=(state)=>{const c=fieldSet.children.find(x=>x.name===`State=${state}`); return c.createInstance();};\n\n// widen design system frame\nconst ds = figma.getNodeById('8:2');\nds.resize(1960, ds.height); ds.x=-620; ds.y=0;\n\nconst ds2 = FR('Northgate · Page Components', 1900, 100, C('#FBFAF8'), {mode:'VERTICAL', prim:'AUTO', pt:64, pb:64, gap:64});\nds2.x=-620; ds2.y=720;\npage.appendChild(ds2);\nfunction section(name){ const s=FR(name,1772,10,null,{mode:'VERTICAL',prim:'AUTO',gap:32}); ds2.appendChild(s); return s; }\n\n/* Header */\nconst secHeader = section('Header');\nconst header = figma.createComponent(); header.name='Header'; header.resize(1440,88);\nheader.layoutMode='HORIZONTAL'; header.primaryAxisSizingMode='FIXED'; header.counterAxisSizingMode='FIXED';\nheader.paddingLeft=112; header.paddingRight=112; header.counterAxisAlignItems='CENTER'; header.itemSpacing=48;\nheader.fills=solid(K.white); header.strokes=solid(K.line); header.strokeWeight=1;\nconst logoG = FR('Logo',10,40,null,{mode:'HORIZONTAL',prim:'AUTO',cnt:'AUTO',gap:10,cal:'CENTER'});\nadd(logoG, icon('3:16',K.ink));\nadd(logoG, T('NORTHGATE',20,'Bold',K.ink,{lh:24,ls:8}));\nadd(header, logoG);\nconst nav = FR('Navigation',10,24,null,{mode:'HORIZONTAL',prim:'AUTO',cnt:'AUTO',gap:40,cal:'CENTER'});\n['Buy','Sell','Rent','About'].forEach(x=>add(nav, T(x,16,'Medium',K.ink,{lh:24})));\nadd(header, nav);\nconst sp = FR('Spacer',10,10,null,{}); sp.layoutGrow=1; add(header, sp);\nadd(header, btn('Primary','Default'));\nadd(secHeader, header);\n\n/* Nav link */\nconst secNav = section('Navigation links');\nconst navVars=[];\nfor(const st of ['Default','Hover']){\n  const c=figma.createComponent(); c.name='State='+st; c.layoutMode='VERTICAL'; c.primaryAxisSizingMode='AUTO'; c.counterAxisSizingMode='AUTO';\n  c.itemSpacing=4; c.paddingBottom=6; c.fills=[]; c.strokes= st==='Hover'? solid(K.ink):[]; c.strokeWeight=2;\n  c.appendChild(T('Nav item',16,'Medium',K.ink,{lh:24}));\n  navVars.push(c);\n}\nconst navSet=figma.combineAsVariants(navVars,secNav); navSet.name='Nav Link';\n\n/* Link Arrow */\nconst secLink = section('Link arrows');\nconst linkVars=[];\nfor(const tone of ['Light','Dark']){\n  for(const st of ['Default','Hover']){\n    const col = tone==='Dark'? (st==='Hover'?K.amber:K.white) : (st==='Hover'?K.amberHover:K.ink);\n    const c=figma.createComponent(); c.name=`Tone=${tone}, State=${st}`; c.layoutMode='HORIZONTAL'; c.primaryAxisSizingMode='AUTO'; c.counterAxisSizingMode='AUTO';\n    c.itemSpacing=12; c.counterAxisAlignItems='CENTER'; c.fills=[]; c.paddingBottom=4;\n    add(c, T('Learn more',16,'Bold',col,{lh:24}));\n    add(c, icon('3:3', col));\n    linkVars.push(c);\n  }\n}\nconst linkSet=figma.combineAsVariants(linkVars,secLink); linkSet.name='Link Arrow';\n\n/* Footer */\nconst secFooter = section('Footer');\nconst footer = figma.createComponent(); footer.name='Footer'; footer.resize(1440,520);\nfooter.layoutMode='VERTICAL'; footer.primaryAxisSizingMode='AUTO'; footer.counterAxisSizingMode='FIXED';\nfooter.fills=solid(K.ink); footer.paddingTop=88; footer.paddingBottom=56; footer.paddingLeft=112; footer.paddingRight=112; footer.itemSpacing=0;\nconst fTop = FR('CTA row',1216,10,null,{mode:'HORIZONTAL',prim:'FIXED',cnt:'AUTO',gap:48,cal:'CENTER',pb:56});\nfTop.primaryAxisAlignItems='SPACE_BETWEEN';\nadd(fTop, T('Make your dreams a reality',40,'Bold',K.white,{lh:48,ls:-1,w:620}));\nadd(fTop, btn('Primary','Default'));\nadd(footer, fTop);\nconst fDiv = FR('Divider',1216,1,C('#2A2D33'),{});\nadd(footer, fDiv);\nconst fMid = FR('Columns',1216,10,null,{mode:'HORIZONTAL',prim:'FIXED',cnt:'AUTO',gap:96,pt:56});\nconst brandCol = FR('Brand',360,10,null,{mode:'VERTICAL',prim:'AUTO',cnt:'FIXED',gap:24});\nconst flogo = FR('Logo',10,40,null,{mode:'HORIZONTAL',prim:'AUTO',cnt:'AUTO',gap:10,cal:'CENTER'});\nadd(flogo, icon('3:16',K.ink));\nadd(flogo, T('NORTHGATE',20,'Bold',K.white,{lh:24,ls:8}));\nadd(brandCol, flogo);\nconst socialRow = FR('Social',10,22,null,{mode:'HORIZONTAL',prim:'AUTO',cnt:'AUTO',gap:20,cal:'CENTER'});\n['3:14','3:17','3:15'].forEach(id=>add(socialRow, icon(id,K.darkLogo)));\nadd(brandCol, socialRow);\nadd(fMid, brandCol);\n[['Company',['About us','Our agents','Careers','Contact']],['Services',['Buy a home','Sell a home','Rent a home','Property management']],['Resources',['Market reports','Buyer guide','Seller guide','FAQ']]].forEach(([title,links])=>{\n  const col=FR(title,220,10,null,{mode:'VERTICAL',prim:'AUTO',cnt:'FIXED',gap:12});\n  add(col, T(title,13,'Bold',K.muted,{lh:18,ls:8}));\n  links.forEach(l=>add(col, T(l,16,'Regular',K.onDark,{lh:26})));\n  add(fMid, col);\n});\nadd(footer, fMid);\nadd(secFooter, footer);\n\n/* Listing cards */\nconst secCard = section('Listing cards');\nconst cardRows=FR('Rows',1772,10,null,{mode:'VERTICAL',prim:'AUTO',gap:40}); add(secCard, cardRows);\nconst cardSets={};\nfor(let p=1;p<=6;p++){\n  const vars=[];\n  for(const st of ['Default','Hover']){\n    const c=figma.createComponent(); c.name=`Photo=${p}, State=${st}`;\n    c.layoutMode='VERTICAL'; c.primaryAxisSizingMode='AUTO'; c.counterAxisSizingMode='FIXED';\n    c.resize(384,400); c.cornerRadius=12; c.fills=solid(K.white); c.clipsContent=true;\n    c.strokes=solid(st==='Hover'?C('#DCD9D2'):K.line); c.strokeWeight=1;\n    if(st==='Hover') c.effects=[{type:'DROP_SHADOW',color:{r:0.08,g:0.09,b:0.11,a:0.16},offset:{x:0,y:14},radius:32,spread:0,visible:true,blendMode:'NORMAL'}];\n    const src=figma.getNodeById(['3:22','3:23','3:24','3:25','3:26','3:34'][p-1]);\n    const pi=src.createInstance(); pi.resize(384,248); pi.name='Photo';\n    const pf=FR('Photo wrap',384,248,null,{clip:true});\n    add(pf, pi); pi.x=0; pi.y=0;\n    add(c, pf); pf.layoutSizingHorizontal='FILL';\n    const body=FR('Body',384,10,null,{mode:'VERTICAL',prim:'AUTO',cnt:'AUTO',gap:14,pt:22,pb:26,pl:24,pr:24});\n    add(body, T('Listing name',20,'SemiBold',K.ink,{lh:26}));\n    const meta=FR('Meta',10,20,null,{mode:'HORIZONTAL',prim:'AUTO',cnt:'AUTO',gap:20,cal:'CENTER'});\n    [['3:6','4 bd'],['3:5','2 ba'],['3:4','1,650 sq ft']].forEach(([id,val])=>{\n      const g=FR('Meta item',10,20,null,{mode:'HORIZONTAL',prim:'AUTO',cnt:'AUTO',gap:8,cal:'CENTER'});\n      add(g, icon(id,K.ink));\n      add(g, T(val,14,'Medium',K.body,{lh:20}));\n      add(meta, g);\n    });\n    add(body, meta);\n    add(c, body); body.layoutSizingHorizontal='FILL';\n    vars.push(c);\n  }\n  const set=figma.combineAsVariants(vars,cardRows); set.name='Listing Card · Photo '+p;\n  cardSets[p]=set.id;\n}\n\n/* Filter field */\nconst secFilter = section('Search filters');\nconst fVars=[];\nfor(const st of ['Default','Open']){\n  const c=figma.createComponent(); c.name='State='+st; c.layoutMode='VERTICAL'; c.primaryAxisSizingMode='AUTO'; c.counterAxisSizingMode='FIXED';\n  c.resize(232,74); c.paddingTop=14; c.paddingBottom=14; c.paddingLeft=16; c.paddingRight=16; c.itemSpacing=4;\n  c.cornerRadius=4; c.fills=solid(st==='Open'?K.white:C('#FBFAF8')); c.strokes=solid(st==='Open'?K.ink:K.line); c.strokeWeight=st==='Open'?2:1;\n  add(c, T('Looking for',12,'Medium',K.muted,{lh:16,ls:4}));\n  const vr=FR('Value row',10,24,null,{mode:'HORIZONTAL',prim:'FIXED',cnt:'AUTO',cal:'CENTER'});\n  vr.primaryAxisAlignItems='SPACE_BETWEEN';\n  add(vr, T('Any',16,'SemiBold',K.ink,{lh:24}));\n  add(vr, icon('3:9',K.ink));\n  add(c, vr); vr.layoutSizingHorizontal='FILL';\n  fVars.push(c);\n}\nconst fset=figma.combineAsVariants(fVars,secFilter); fset.name='Filter Field';\n\n/* Testimonial */\nconst secTest = section('Testimonial client');\nconst tVars=[];\nfor(const st of ['No','Yes']){\n  const c=figma.createComponent(); c.name='Current='+st; c.layoutMode='HORIZONTAL'; c.primaryAxisSizingMode='AUTO'; c.counterAxisSizingMode='AUTO';\n  c.itemSpacing=14; c.counterAxisAlignItems='CENTER'; c.fills=[]; c.paddingLeft=4; c.paddingRight=8;\n  const ring=FR('Avatar ring',76,76,st==='Yes'?K.amber:null,{mode:'HORIZONTAL',prim:'FIXED',cnt:'FIXED'});\n  ring.cornerRadius=999; ring.counterAxisAlignItems='CENTER'; ring.primaryAxisAlignItems='CENTER';\n  if(st==='Yes'){ ring.strokes=solid(K.amber); ring.strokeWeight=2; }\n  const av=figma.getNodeById('3:18').createInstance(); av.resize(64,64); av.cornerRadius=999; av.name='Avatar_Client';\n  add(ring, av);\n  add(c, ring);\n  const tx=FR('Text',10,44,null,{mode:'VERTICAL',prim:'AUTO',cnt:'AUTO',gap:2});\n  add(tx, T('Client name',16,'SemiBold',K.ink,{lh:22}));\n  add(tx, T('Client',14,'Regular',K.muted,{lh:20}));\n  add(c, tx);\n  tVars.push(c);\n}\nconst tset=figma.combineAsVariants(tVars,secTest); tset.name='Testimonial Client';\n\n/* Feature item */\nconst secFeat = section('Feature item');\nconst featC=figma.createComponent(); featC.name='Feature Item'; featC.layoutMode='HORIZONTAL'; featC.primaryAxisSizingMode='AUTO'; featC.counterAxisSizingMode='AUTO';\nfeatC.itemSpacing=10; featC.counterAxisAlignItems='CENTER'; featC.fills=[];\nconst fc=FR('Check',24,24,K.amberTint,{mode:'HORIZONTAL',prim:'FIXED',cnt:'FIXED'}); fc.cornerRadius=999; fc.primaryAxisAlignItems='CENTER'; fc.counterAxisAlignItems='CENTER';\nconst ci=icon('3:8',K.ink); ci.resize(12,12); add(fc, ci);\nadd(featC, fc); add(featC, T('Feature',16,'Regular',K.body,{lh:24}));\nadd(secFeat, featC);\n\n/* Detail item */\nconst secDet = section('Detail item');\nconst detC=figma.createComponent(); detC.name='Detail Item'; detC.layoutMode='VERTICAL'; detC.primaryAxisSizingMode='AUTO'; detC.counterAxisSizingMode='FIXED';\ndetC.resize(120,110); detC.itemSpacing=12; detC.fills=[];\nadd(detC, icon('3:6',K.ink));\nadd(detC, T('4',20,'Bold',K.ink,{lh:26}));\nadd(detC, T('Bedrooms',14,'Medium',K.muted,{lh:20}));\nadd(secDet, detC);\n\n/* Thumbnail */\nconst secThumb = section('Gallery thumbnails');\nconst thVars=[];\nfor(const st of ['Default','Selected']){\n  const c=figma.createComponent(); c.name='State='+st; c.resize(160,112); c.cornerRadius=8; c.clipsContent=true; c.fills=solid(K.soft);\n  if(st==='Selected'){ c.strokes=solid(K.ink); c.strokeWeight=2; }\n  const pi=figma.getNodeById('3:27').createInstance(); pi.resize(160,112); pi.name='Photo'; add(c, pi); pi.x=0; pi.y=0;\n  thVars.push(c);\n}\nconst thset=figma.combineAsVariants(thVars,secThumb); thset.name='Gallery Thumbnail';\n\n/* Agent card */\nconst secAgent = section('Agent contact card');\nconst agent=figma.createComponent(); agent.name='Agent Contact Card'; agent.resize(400,700);\nagent.layoutMode='VERTICAL'; agent.primaryAxisSizingMode='AUTO'; agent.counterAxisSizingMode='FIXED';\nagent.paddingTop=32; agent.paddingBottom=32; agent.paddingLeft=32; agent.paddingRight=32; agent.itemSpacing=20;\nagent.cornerRadius=12; agent.fills=solid(K.white); agent.strokes=solid(K.line); agent.strokeWeight=1;\nconst agHead=FR('Agent',10,72,null,{mode:'HORIZONTAL',prim:'AUTO',cnt:'AUTO',gap:16,cal:'CENTER'});\nconst kav=figma.getNodeById('3:19').createInstance(); kav.resize(72,72); kav.cornerRadius=999; kav.name='Avatar_Kayley_Hall';\nadd(agHead, kav);\nconst agTx=FR('Text',10,60,null,{mode:'VERTICAL',prim:'AUTO',cnt:'AUTO',gap:6});\nadd(agTx, T('Kayley Hall',20,'SemiBold',K.ink,{lh:26}));\nconst vp=FR('View profile',10,24,null,{mode:'HORIZONTAL',prim:'AUTO',cnt:'AUTO',gap:8,cal:'CENTER'});\nadd(vp, T('View profile',15,'Medium',K.ink,{lh:20}));\nadd(vp, icon('3:3',K.ink));\nadd(agTx, vp);\nadd(agHead, agTx);\nadd(agent, agHead);\n[['Field · Name','Filled'],['Field · Phone','Filled'],['Field · Email','Focused']].forEach(([nm,st])=>{ const f=field(st); f.name=nm; add(agent,f); f.layoutSizingHorizontal='FILL'; });\nconst msg=FR('Field · Message',336,130,K.white,{mode:'VERTICAL',prim:'FIXED',cnt:'FIXED',pt:14,pl:16,pr:16,gap:12,r:4,stroke:K.line});\nadd(msg, T('Message',14,'Bold',K.ink,{lh:18}));\nconst mt=T('Hello, I am interested in…',16,'Regular',K.ink,{lh:26,w:304}); add(msg, mt);\nadd(agent, msg); msg.layoutSizingHorizontal='FILL';\nconst cab=btn('Primary','Default'); add(agent, cab); cab.layoutSizingHorizontal='FILL';\nadd(secAgent, agent);\n\nreturn JSON.stringify({ds2:ds2.id, header:header.id, footer:footer.id, navSet:navSet.id, linkSet:linkSet.id, cards:cardSets, filter:fset.id, test:tset.id, feat:featC.id, det:detC.id, thumb:thset.id, agent:agent.id, sections:ds2.children.map(c=>c.name+':'+c.id)});","description":"Rebuild page and business components with bug fixes","fileKey":"YUW1fDQZdbeVJfGXh6CwcB"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":2136,"input_tokens":55,"cache_read_input_tokens":69018,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":2136}},"context_management":null},"parent_tool_use_id":null,"session_id":"1a2ea8f9-759f-405f-98a5-13324c4c09fc","uuid":"ed5d758e-da7d-4b6e-a701-44b6a800e370","timestamp":"2026-11-01T21:38:53.227Z","tool_use_meta":[{"id":"toolu_01XUxiBEpgSQQAQEn0t9dkPB","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
