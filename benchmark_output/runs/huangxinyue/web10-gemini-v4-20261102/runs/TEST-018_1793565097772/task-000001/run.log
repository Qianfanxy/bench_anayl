{"type":"assistant","message":{"id":"chatcmpl-202611012032329620041158268d9d6ZWLKVzSA","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_8dfc3acf21ef43a984291eff71c8cfab","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  // Load fonts\n  const fontRegular = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n  const fontMedium = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n  const fontSemiBold = { family: \"Plus Jakarta Sans\", style: \"Semi Bold\" };\n  const fontBold = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n\n  await figma.loadFontAsync(fontRegular).catch(() => {});\n  await figma.loadFontAsync(fontMedium).catch(() => {});\n  await figma.loadFontAsync(fontSemiBold).catch(() => {});\n  await figma.loadFontAsync(fontBold).catch(() => {});\n\n  // Workspace page\n  const workspacePage = figma.root.children.find(p => p.name.includes('03 · Workspace'));\n  if (!workspacePage) throw new Error(\"Workspace page not found\");\n  await figma.setCurrentPageAsync(workspacePage);\n\n  // Clear existing items in Workspace to build fresh\n  for (const child of workspacePage.children) {\n    child.remove();\n  }\n\n  // Get Media components\n  const mediaPage = figma.root.children.find(p => p.name.includes('04 · Media'));\n  await mediaPage.loadAsync();\n\n  const getMediaComponent = (name) => {\n    const comp = mediaPage.findOne(n => n.type === 'COMPONENT' && n.name === name);\n    if (!comp) console.warn(`Media component ${name} not found`);\n    return comp;\n  };\n\n  const logoMacComp = getMediaComponent('Logo_MAC');\n  const logoFbComp = getMediaComponent('Logo_Facebook');\n  const logoInstaComp = getMediaComponent('Logo_Instagram');\n  const logoLinkedinComp = getMediaComponent('Logo_LinkedIn');\n  const logoTwitterComp = getMediaComponent('Logo_Twitter');\n  const iconArrowLeftComp = getMediaComponent('Icon_Arrow_Left');\n  const iconArrowRightComp = getMediaComponent('Icon_Arrow_Right');\n  const iconBellComp = getMediaComponent('Icon_Bell');\n  const iconChevronDownComp = getMediaComponent('Icon_Chevron_Down');\n  const iconMailComp = getMediaComponent('Icon_Mail');\n  const iconMapPinComp = getMediaComponent('Icon_Map_Pin');\n  const iconMinusComp = getMediaComponent('Icon_Minus');\n  const iconPhoneComp = getMediaComponent('Icon_Phone');\n  const iconPlayComp = getMediaComponent('Icon_Play');\n  const iconPlusComp = getMediaComponent('Icon_Plus');\n  const iconTrendingUpComp = getMediaComponent('Icon_Trending_Up');\n\n  // Helpers\n  const hexToRgb = (hex) => {\n    let c = hex.replace('#', '');\n    if (c.length === 3) c = c.split('').map(x => x + x).join('');\n    const num = parseInt(c, 16);\n    return { r: ((num >> 16) & 255) / 255, g: ((num >> 8) & 255) / 255, b: (num & 255) / 255 };\n  };\n\n  const LIME = hexToRgb('#99EA48');\n  const INK = hexToRgb('#010205');\n  const WHITE = { r: 1, g: 1, b: 1 };\n  const GRAY_50 = hexToRgb('#F9FAFB');\n  const GRAY_100 = hexToRgb('#F3F4F6');\n  const GRAY_200 = hexToRgb('#E5E7EB');\n  const GRAY_300 = hexToRgb('#D1D5DB');\n  const GRAY_500 = hexToRgb('#6B7280');\n  const GRAY_600 = hexToRgb('#4B5563');\n  const GRAY_800 = hexToRgb('#1F2937');\n  const GRAY_900 = hexToRgb('#111827');\n  const CARD_BG = hexToRgb('#16181D');\n  const CARD_BG_LIGHT = hexToRgb('#F4F5F7');\n\n  const createInstanceOrFallback = (comp, size = 24) => {\n    if (comp) {\n      const inst = comp.createInstance();\n      inst.resize(size, size);\n      return inst;\n    }\n    const frame = figma.createFrame();\n    frame.resize(size, size);\n    frame.fills = [];\n    return frame;\n  };\n\n  // Reusable Component Set / Section Creation in Workspace\n  // Page Frame: 01_Home\n  const pageFrame = figma.createFrame();\n  pageFrame.name = \"01_Home\";\n  pageFrame.resize(1440, 6800);\n  pageFrame.fills = [{ type: 'SOLID', color: WHITE }];\n  pageFrame.layoutMode = \"VERTICAL\";\n  pageFrame.primaryAxisSizingMode = \"AUTO\";\n  pageFrame.counterAxisSizingMode = \"FIXED\";\n  pageFrame.itemSpacing = 0;\n\n  // 1. HEADER\n  const headerFrame = figma.createFrame();\n  headerFrame.name = \"Header\";\n  headerFrame.resize(1440, 90);\n  headerFrame.layoutMode = \"HORIZONTAL\";\n  headerFrame.primaryAxisSizingMode = \"FIXED\";\n  headerFrame.counterAxisSizingMode = \"FIXED\";\n  headerFrame.layoutAlign = \"STRETCH\";\n  headerFrame.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  headerFrame.counterAxisAlignItems = \"CENTER\";\n  headerFrame.paddingLeft = 80;\n  headerFrame.paddingRight = 80;\n  headerFrame.paddingTop = 20;\n  headerFrame.paddingBottom = 20;\n  headerFrame.fills = [{ type: 'SOLID', color: WHITE }];\n  headerFrame.strokes = [{ type: 'SOLID', color: GRAY_200 }];\n  headerFrame.strokeWeight = 1;\n  headerFrame.strokeAlign = 'INSIDE';\n\n  // Logo instance\n  const logoInst = logoMacComp ? logoMacComp.createInstance() : figma.createText();\n  if (logoInst.type === 'TEXT') { logoInst.characters = \"MAC\"; }\n\n  // Nav Items Frame\n  const navFrame = figma.createFrame();\n  navFrame.name = \"Navigation\";\n  navFrame.layoutMode = \"HORIZONTAL\";\n  navFrame.primaryAxisSizingMode = \"AUTO\";\n  navFrame.counterAxisSizingMode = \"AUTO\";\n  navFrame.itemSpacing = 32;\n  navFrame.counterAxisAlignItems = \"CENTER\";\n  navFrame.fills = [];\n\n  const navItems = [\"Service\", \"Agency\", \"Case Study\", \"Resources\"];\n  for (const item of navItems) {\n    const itemFrame = figma.createFrame();\n    itemFrame.name = `Nav_${item}`;\n    itemFrame.layoutMode = \"HORIZONTAL\";\n    itemFrame.primaryAxisSizingMode = \"AUTO\";\n    itemFrame.counterAxisSizingMode = \"AUTO\";\n    itemFrame.itemSpacing = 6;\n    itemFrame.counterAxisAlignItems = \"CENTER\";\n    itemFrame.fills = [];\n\n    const txt = figma.createText();\n    txt.fontName = fontMedium;\n    txt.fontSize = 15;\n    txt.characters = item;\n    txt.fills = [{ type: 'SOLID', color: INK }];\n    itemFrame.appendChild(txt);\n\n    const chevron = createInstanceOrFallback(iconChevronDownComp, 16);\n    itemFrame.appendChild(chevron);\n\n    navFrame.appendChild(itemFrame);\n  }\n\n  // Nav Contact (no dropdown)\n  const contactTxt = figma.createText();\n  contactTxt.fontName = fontMedium;\n  contactTxt.fontSize = 15;\n  contactTxt.characters = \"Contact\";\n  contactTxt.fills = [{ type: 'SOLID', color: INK }];\n  navFrame.appendChild(contactTxt);\n\n  // Header Right Action\n  const headerRight = figma.createFrame();\n  headerRight.name = \"Header_Right\";\n  headerRight.layoutMode = \"HORIZONTAL\";\n  headerRight.primaryAxisSizingMode = \"AUTO\";\n  headerRight.counterAxisSizingMode = \"AUTO\";\n  headerRight.itemSpacing = 16;\n  headerRight.counterAxisAlignItems = \"CENTER\";\n  headerRight.fills = [];\n\n  // Bell icon button\n  const bellBtn = figma.createFrame();\n  bellBtn.name = \"Notification_Button\";\n  bellBtn.resize(44, 44);\n  bellBtn.cornerRadius = 22;\n  bellBtn.fills = [{ type: 'SOLID', color: GRAY_100 }];\n  bellBtn.layoutMode = \"HORIZONTAL\";\n  bellBtn.primaryAxisAlignItems = \"CENTER\";\n  bellBtn.counterAxisAlignItems = \"CENTER\";\n  const bellIcon = createInstanceOrFallback(iconBellComp, 20);\n  bellBtn.appendChild(bellIcon);\n\n  // Get Started Button\n  const headerCta = figma.createFrame();\n  headerCta.name = \"Header_CTA\";\n  headerCta.layoutMode = \"HORIZONTAL\";\n  headerCta.paddingLeft = 24;\n  headerCta.paddingRight = 24;\n  headerCta.paddingTop = 12;\n  headerCta.paddingBottom = 12;\n  headerCta.cornerRadius = 24;\n  headerCta.fills = [{ type: 'SOLID', color: INK }];\n  headerCta.counterAxisAlignItems = \"CENTER\";\n  const headerCtaTxt = figma.createText();\n  headerCtaTxt.fontName = fontSemiBold;\n  headerCtaTxt.fontSize = 15;\n  headerCtaTxt.characters = \"Get started\";\n  headerCtaTxt.fills = [{ type: 'SOLID', color: WHITE }];\n  headerCta.appendChild(headerCtaTxt);\n\n  headerRight.appendChild(bellBtn);\n  headerRight.appendChild(headerCta);\n\n  headerFrame.appendChild(logoInst);\n  headerFrame.appendChild(navFrame);\n  headerFrame.appendChild(headerRight);\n\n  pageFrame.appendChild(headerFrame);\n\n  // 2. HERO SECTION\n  const heroSection = figma.createFrame();\n  heroSection.name = \"Hero_Section\";\n  heroSection.layoutMode = \"VERTICAL\";\n  heroSection.layoutAlign = \"STRETCH\";\n  heroSection.primaryAxisSizingMode = \"AUTO\";\n  heroSection.counterAxisSizingMode = \"FIXED\";\n  heroSection.paddingLeft = 80;\n  heroSection.paddingRight = 80;\n  heroSection.paddingTop = 80;\n  heroSection.paddingBottom = 80;\n  heroSection.itemSpacing = 64;\n  heroSection.fills = [{ type: 'SOLID', color: GRAY_50 }];\n\n  // Hero Content Main Top\n  const heroTop = figma.createFrame();\n  heroTop.name = \"Hero_Top\";\n  heroTop.layoutMode = \"HORIZONTAL\";\n  heroTop.layoutAlign = \"STRETCH\";\n  heroTop.primaryAxisSizingMode = \"FIXED\";\n  heroTop.counterAxisSizingMode = \"AUTO\";\n  heroTop.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  heroTop.counterAxisAlignItems = \"CENTER\";\n  heroTop.fills = [];\n\n  // Hero Left Text Column\n  const heroLeft = figma.createFrame();\n  heroLeft.name = \"Hero_Left_Text\";\n  heroLeft.layoutMode = \"VERTICAL\";\n  heroLeft.resize(640, 100);\n  heroLeft.primaryAxisSizingMode = \"AUTO\";\n  heroLeft.counterAxisSizingMode = \"FIXED\";\n  heroLeft.itemSpacing = 24;\n  heroLeft.fills = [];\n\n  const heroH1 = figma.createText();\n  heroH1.fontName = fontBold;\n  heroH1.fontSize = 56;\n  heroH1.lineHeight = { value: 66, unit: 'PIXELS' };\n  heroH1.characters = \"Stay ahead of the curve with our forward-thinking\";\n  heroH1.fills = [{ type: 'SOLID', color: INK }];\n  heroH1.layoutAlign = \"STRETCH\";\n\n  const heroSub = figma.createText();\n  heroSub.fontName = fontRegular;\n  heroSub.fontSize = 18;\n  heroSub.lineHeight = { value: 28, unit: 'PIXELS' };\n  heroSub.characters = \"An award-winning SEO agency with disciplines in digital marketing, design, and website development, focused on understanding you.\";\n  heroSub.fills = [{ type: 'SOLID', color: GRAY_600 }];\n  heroSub.layoutAlign = \"STRETCH\";\n\n  // Hero Actions\n  const heroActions = figma.createFrame();\n  heroActions.name = \"Hero_Actions\";\n  heroActions.layoutMode = \"HORIZONTAL\";\n  heroActions.primaryAxisSizingMode = \"AUTO\";\n  heroActions.counterAxisSizingMode = \"AUTO\";\n  heroActions.itemSpacing = 16;\n  heroActions.counterAxisAlignItems = \"CENTER\";\n  heroActions.fills = [];\n\n  // Schedule Call CTA (Lime button with arrow)\n  const schedBtn = figma.createFrame();\n  schedBtn.name = \"Schedule_Call_Button\";\n  schedBtn.layoutMode = \"HORIZONTAL\";\n  schedBtn.paddingLeft = 28;\n  schedBtn.paddingRight = 24;\n  schedBtn.paddingTop = 16;\n  schedBtn.paddingBottom = 16;\n  schedBtn.cornerRadius = 30;\n  schedBtn.fills = [{ type: 'SOLID', color: LIME }];\n  schedBtn.itemSpacing = 10;\n  schedBtn.counterAxisAlignItems = \"CENTER\";\n\n  const schedTxt = figma.createText();\n  schedTxt.fontName = fontBold;\n  schedTxt.fontSize = 16;\n  schedTxt.characters = \"Schedule Call\";\n  schedTxt.fills = [{ type: 'SOLID', color: INK }];\n  const schedArrow = createInstanceOrFallback(iconArrowRightComp, 20);\n  schedBtn.appendChild(schedTxt);\n  schedBtn.appendChild(schedArrow);\n\n  // View Case Study Button (Outline)\n  const caseBtn = figma.createFrame();\n  caseBtn.name = \"View_Case_Study_Button\";\n  caseBtn.layoutMode = \"HORIZONTAL\";\n  caseBtn.paddingLeft = 28;\n  caseBtn.paddingRight = 28;\n  caseBtn.paddingTop = 16;\n  caseBtn.paddingBottom = 16;\n  caseBtn.cornerRadius = 30;\n  caseBtn.fills = [{ type: 'SOLID', color: WHITE }];\n  caseBtn.strokes = [{ type: 'SOLID', color: GRAY_300 }];\n  caseBtn.strokeWeight = 1;\n  caseBtn.strokeAlign = 'INSIDE';\n  caseBtn.counterAxisAlignItems = \"CENTER\";\n\n  const caseTxt = figma.createText();\n  caseTxt.fontName = fontSemiBold;\n  caseTxt.fontSize = 16;\n  caseTxt.characters = \"View Case Study\";\n  caseTxt.fills = [{ type: 'SOLID', color: INK }];\n  caseBtn.appendChild(caseTxt);\n\n  heroActions.appendChild(schedBtn);\n  heroActions.appendChild(caseBtn);\n\n  heroLeft.appendChild(heroH1);\n  heroLeft.appendChild(heroSub);\n  heroLeft.appendChild(heroActions);\n\n  // Hero Right Visual / Stats Cards Container\n  const heroRight = figma.createFrame();\n  heroRight.name = \"Hero_Right_Cards\";\n  heroRight.resize(560, 420);\n  heroRight.fills = [];\n\n  // Card 1: 230+ Stats Card\n  const statCard1 = figma.createFrame();\n  statCard1.name = \"Hero_Stat_Card_230\";\n  statCard1.resize(260, 220);\n  statCard1.x = 0;\n  statCard1.y = 0;\n  statCard1.cornerRadius = 24;\n  statCard1.fills = [{ type: 'SOLID', color: INK }];\n  statCard1.paddingLeft = 24;\n  statCard1.paddingRight = 24;\n  statCard1.paddingTop = 24;\n  statCard1.paddingBottom = 24;\n  statCard1.layoutMode = \"VERTICAL\";\n  statCard1.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n\n  const statHeader = figma.createFrame();\n  statHeader.layoutMode = \"HORIZONTAL\";\n  statHeader.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  statHeader.layoutAlign = \"STRETCH\";\n  statHeader.counterAxisAlignItems = \"CENTER\";\n  statHeader.fills = [];\n\n  const statNum = figma.createText();\n  statNum.fontName = fontBold;\n  statNum.fontSize = 44;\n  statNum.characters = \"230+\";\n  statNum.fills = [{ type: 'SOLID', color: LIME }];\n\n  const growthBadge = figma.createFrame();\n  growthBadge.name = \"Growth_Badge\";\n  growthBadge.resize(36, 36);\n  growthBadge.cornerRadius = 18;\n  growthBadge.fills = [{ type: 'SOLID', color: hexToRgb('#1E2619') }];\n  growthBadge.layoutMode = \"HORIZONTAL\";\n  growthBadge.primaryAxisAlignItems = \"CENTER\";\n  growthBadge.counterAxisAlignItems = \"CENTER\";\n  const trendIcon = createInstanceOrFallback(iconTrendingUpComp, 20);\n  growthBadge.appendChild(trendIcon);\n  statHeader.appendChild(statNum);\n  statHeader.appendChild(growthBadge);\n\n  const statDesc = figma.createText();\n  statDesc.fontName = fontMedium;\n  statDesc.fontSize = 14;\n  statDesc.lineHeight = { value: 20, unit: 'PIXELS' };\n  statDesc.characters = \"some big companies that we work with, and trust us very much\";\n  statDesc.fills = [{ type: 'SOLID', color: GRAY_300 }];\n  statDesc.layoutAlign = \"STRETCH\";\n\n  // Progress Bar\n  const progressBarBg = figma.createFrame();\n  progressBarBg.name = \"Progress_Bar\";\n  progressBarBg.resize(212, 8);\n  progressBarBg.cornerRadius = 4;\n  progressBarBg.fills = [{ type: 'SOLID', color: hexToRgb('#374151') }];\n  progressBarBg.layoutMode = \"NONE\";\n\n  const progressBarFill = figma.createFrame();\n  progressBarFill.name = \"Progress_Fill\";\n  progressBarFill.resize(140, 8);\n  progressBarFill.cornerRadius = 4;\n  progressBarFill.fills = [{ type: 'SOLID', color: LIME }];\n  progressBarBg.appendChild(progressBarFill);\n\n  statCard1.appendChild(statHeader);\n  statCard1.appendChild(statDesc);\n  statCard1.appendChild(progressBarBg);\n\n  // Card 2: Traffic Card (Drive More Traffic and Sales)\n  const trafficCard = figma.createFrame();\n  trafficCard.name = \"Hero_Traffic_Card\";\n  trafficCard.resize(270, 240);\n  trafficCard.x = 280;\n  trafficCard.y = 120;\n  trafficCard.cornerRadius = 24;\n  trafficCard.fills = [{ type: 'SOLID', color: WHITE }];\n  trafficCard.strokes = [{ type: 'SOLID', color: GRAY_200 }];\n  trafficCard.strokeWeight = 1;\n  trafficCard.paddingLeft = 24;\n  trafficCard.paddingRight = 24;\n  trafficCard.paddingTop = 24;\n  trafficCard.paddingBottom = 24;\n  trafficCard.layoutMode = \"VERTICAL\";\n  trafficCard.itemSpacing = 16;\n\n  const trafficTitle = figma.createText();\n  trafficTitle.fontName = fontBold;\n  trafficTitle.fontSize = 18;\n  trafficTitle.lineHeight = { value: 24, unit: 'PIXELS' };\n  trafficTitle.characters = \"Drive More Traffic and Sales\";\n  trafficTitle.fills = [{ type: 'SOLID', color: INK }];\n\n  const trafficSub = figma.createText();\n  trafficSub.fontName = fontRegular;\n  trafficSub.fontSize = 13;\n  trafficSub.characters = \"Drive more traffic and product sales\";\n  trafficSub.fills = [{ type: 'SOLID', color: GRAY_500 }];\n\n  // 3-Bar Rising Chart\n  const chartFrame = figma.createFrame();\n  chartFrame.name = \"3_Bar_Rising_Chart\";\n  chartFrame.resize(222, 100);\n  chartFrame.layoutMode = \"HORIZONTAL\";\n  chartFrame.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  chartFrame.counterAxisAlignItems = \"MAX\";\n  chartFrame.fills = [];\n  chartFrame.paddingTop = 10;\n\n  const bar1 = figma.createFrame();\n  bar1.resize(56, 45);\n  bar1.cornerRadius = 8;\n  bar1.fills = [{ type: 'SOLID', color: GRAY_200 }];\n\n  const bar2 = figma.createFrame();\n  bar2.resize(56, 70);\n  bar2.cornerRadius = 8;\n  bar2.fills = [{ type: 'SOLID', color: GRAY_800 }];\n\n  const bar3 = figma.createFrame();\n  bar3.resize(56, 95);\n  bar3.cornerRadius = 8;\n  bar3.fills = [{ type: 'SOLID', color: LIME }];\n\n  chartFrame.appendChild(bar1);\n  chartFrame.appendChild(bar2);\n  chartFrame.appendChild(bar3);\n\n  trafficCard.appendChild(trafficTitle);\n  trafficCard.appendChild(trafficSub);\n  trafficCard.appendChild(chartFrame);\n\n  heroRight.appendChild(statCard1);\n  heroRight.appendChild(trafficCard);\n\n  heroTop.appendChild(heroLeft);\n  heroTop.appendChild(heroRight);\n\n  heroSection.appendChild(heroTop);\n  pageFrame.appendChild(heroSection);\n\n  // 3. TRUSTED BY SECTION\n  const trustedSection = figma.createFrame();\n  trustedSection.name = \"Trusted_By_Section\";\n  trustedSection.layoutMode = \"VERTICAL\";\n  trustedSection.layoutAlign = \"STRETCH\";\n  trustedSection.primaryAxisSizingMode = \"AUTO\";\n  trustedSection.paddingLeft = 80;\n  trustedSection.paddingRight = 80;\n  trustedSection.paddingTop = 48;\n  trustedSection.paddingBottom = 48;\n  trustedSection.itemSpacing = 28;\n  trustedSection.counterAxisAlignItems = \"CENTER\";\n  trustedSection.fills = [{ type: 'SOLID', color: WHITE }];\n  trustedSection.strokes = [{ type: 'SOLID', color: GRAY_200 }];\n  trustedSection.strokeWeight = 1;\n\n  const trustedLabel = figma.createText();\n  trustedLabel.fontName = fontSemiBold;\n  trustedLabel.fontSize = 14;\n  trustedLabel.letterSpacing = { value: 1, unit: 'PIXELS' };\n  trustedLabel.characters = \"TRUSTED BY THE WORLD’S BIGGEST BRANDS\";\n  trustedLabel.fills = [{ type: 'SOLID', color: GRAY_500 }];\n\n  const wordmarksRow = figma.createFrame();\n  wordmarksRow.name = \"Client_Wordmarks_Row\";\n  wordmarksRow.layoutMode = \"HORIZONTAL\";\n  wordmarksRow.primaryAxisSizingMode = \"AUTO\";\n  wordmarksRow.itemSpacing = 80;\n  wordmarksRow.counterAxisAlignItems = \"CENTER\";\n  wordmarksRow.fills = [];\n\n  const wordmarks = [\"Paywise\", \"Campfield\", \"Mazeline\"];\n  for (const wm of wordmarks) {\n    const wmTxt = figma.createText();\n    wmTxt.fontName = fontBold;\n    wmTxt.fontSize = 28;\n    wmTxt.characters = wm;\n    wmTxt.fills = [{ type: 'SOLID', color: INK }];\n    wmTxt.opacity = 0.85;\n    wordmarksRow.appendChild(wmTxt);\n  }\n\n  trustedSection.appendChild(trustedLabel);\n  trustedSection.appendChild(wordmarksRow);\n  pageFrame.appendChild(trustedSection);\n\n  // 4. ABOUT SECTION\n  const aboutSection = figma.createFrame();\n  aboutSection.name = \"About_Section\";\n  aboutSection.layoutMode = \"HORIZONTAL\";\n  aboutSection.layoutAlign = \"STRETCH\";\n  aboutSection.primaryAxisSizingMode = \"FIXED\";\n  aboutSection.counterAxisSizingMode = \"AUTO\";\n  aboutSection.paddingLeft = 80;\n  aboutSection.paddingRight = 80;\n  aboutSection.paddingTop = 100;\n  aboutSection.paddingBottom = 100;\n  aboutSection.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  aboutSection.counterAxisAlignItems = \"CENTER\";\n  aboutSection.fills = [{ type: 'SOLID', color: WHITE }];\n\n  const aboutTitle = figma.createText();\n  aboutTitle.fontName = fontBold;\n  aboutTitle.fontSize = 44;\n  aboutTitle.lineHeight = { value: 54, unit: 'PIXELS' };\n  aboutTitle.resize(540, 110);\n  aboutTitle.characters = \"Provide the best service with out-of-the-box ideas\";\n  aboutTitle.fills = [{ type: 'SOLID', color: INK }];\n\n  const aboutBody = figma.createText();\n  aboutBody.fontName = fontRegular;\n  aboutBody.fontSize = 18;\n  aboutBody.lineHeight = { value: 28, unit: 'PIXELS' };\n  aboutBody.resize(580, 140);\n  aboutBody.characters = \"We are a passionate team of digital marketing enthusiasts dedicated to helping businesses succeed in the digital world. With years of experience and a deep understanding of the ever-evolving online landscape, we stay at the forefront of industry trends and technologies.\";\n  aboutBody.fills = [{ type: 'SOLID', color: GRAY_600 }];\n\n  aboutSection.appendChild(aboutTitle);\n  aboutSection.appendChild(aboutBody);\n  pageFrame.appendChild(aboutSection);\n\n  // 5. PROJECTS & VIDEO SECTION\n  const videoSection = figma.createFrame();\n  videoSection.name = \"Projects_And_Video_Section\";\n  videoSection.layoutMode = \"VERTICAL\";\n  videoSection.layoutAlign = \"STRETCH\";\n  videoSection.primaryAxisSizingMode = \"AUTO\";\n  videoSection.paddingLeft = 80;\n  videoSection.paddingRight = 80;\n  videoSection.paddingTop = 80;\n  videoSection.paddingBottom = 100;\n  videoSection.itemSpacing = 48;\n  videoSection.fills = [{ type: 'SOLID', color: GRAY_50 }];\n\n  // Stat & Avatars Top Bar\n  const pvTop = figma.createFrame();\n  pvTop.name = \"Projects_Header_Row\";\n  pvTop.layoutMode = \"HORIZONTAL\";\n  pvTop.layoutAlign = \"STRETCH\";\n  pvTop.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  pvTop.counterAxisAlignItems = \"CENTER\";\n  pvTop.fills = [];\n\n  const pvLeft = figma.createFrame();\n  pvLeft.layoutMode = \"HORIZONTAL\";\n  pvLeft.itemSpacing = 24;\n  pvLeft.counterAxisAlignItems = \"CENTER\";\n  pvLeft.fills = [];\n\n  const stat920 = figma.createText();\n  stat920.fontName = fontBold;\n  stat920.fontSize = 54;\n  stat920.characters = \"920+\";\n  stat920.fills = [{ type: 'SOLID', color: INK }];\n\n  const stat920Label = figma.createText();\n  stat920Label.fontName = fontSemiBold;\n  stat920Label.fontSize = 20;\n  stat920Label.lineHeight = { value: 26, unit: 'PIXELS' };\n  stat920Label.resize(180, 52);\n  stat920Label.characters = \"Projects finished superbly\";\n  stat920Label.fills = [{ type: 'SOLID', color: GRAY_600 }];\n\n  pvLeft.appendChild(stat920);\n  pvLeft.appendChild(stat920Label);\n\n  // Avatars Placeholder\n  const avatarsFrame = figma.createFrame();\n  avatarsFrame.name = \"Avatars_Group\";\n  avatarsFrame.resize(180, 48);\n  avatarsFrame.fills = [];\n\n  for (let i = 0; i < 4; i++) {\n    const av = figma.createFrame();\n    av.name = `Avatar_Placeholder_${i + 1}`;\n    av.resize(44, 44);\n    av.x = i * 32;\n    av.y = 2;\n    av.cornerRadius = 22;\n    av.fills = [{ type: 'SOLID', color: hexToRgb(i % 2 === 0 ? '#D1D5DB' : '#9CA3AF') }];\n    av.strokes = [{ type: 'SOLID', color: WHITE }];\n    av.strokeWeight = 2;\n    avatarsFrame.appendChild(av);\n  }\n\n  const plusBadge = figma.createFrame();\n  plusBadge.name = \"Plus_Avatar_Badge\";\n  plusBadge.resize(44, 44);\n  plusBadge.x = 4 * 32;\n  plusBadge.y = 2;\n  plusBadge.cornerRadius = 22;\n  plusBadge.fills = [{ type: 'SOLID', color: LIME }];\n  plusBadge.strokes = [{ type: 'SOLID', color: WHITE }];\n  plusBadge.strokeWeight = 2;\n  plusBadge.layoutMode = \"HORIZONTAL\";\n  plusBadge.primaryAxisAlignItems = \"CENTER\";\n  plusBadge.counterAxisAlignItems = \"CENTER\";\n  const plusTxt = figma.createText();\n  plusTxt.fontName = fontBold;\n  plusTxt.fontSize = 18;\n  plusTxt.characters = \"+\";\n  plusTxt.fills = [{ type: 'SOLID', color: INK }];\n  plusBadge.appendChild(plusTxt);\n  avatarsFrame.appendChild(plusBadge);\n\n  pvTop.appendChild(pvLeft);\n  pvTop.appendChild(avatarsFrame);\n\n  // Video Placeholder Frame\n  const videoPlaceholder = figma.createFrame();\n  videoPlaceholder.name = \"Video_Placeholder\";\n  videoPlaceholder.layoutAlign = \"STRETCH\";\n  videoPlaceholder.resize(1280, 520);\n  videoPlaceholder.cornerRadius = 24;\n  videoPlaceholder.fills = [{ type: 'SOLID', color: INK }];\n  videoPlaceholder.layoutMode = \"VERTICAL\";\n  videoPlaceholder.primaryAxisAlignItems = \"CENTER\";\n  videoPlaceholder.counterAxisAlignItems = \"CENTER\";\n  videoPlaceholder.itemSpacing = 20;\n\n  // Play Button Circle\n  const playBtn = figma.createFrame();\n  playBtn.name = \"Play_Button\";\n  playBtn.resize(80, 80);\n  playBtn.cornerRadius = 40;\n  playBtn.fills = [{ type: 'SOLID', color: LIME }];\n  playBtn.layoutMode = \"HORIZONTAL\";\n  playBtn.primaryAxisAlignItems = \"CENTER\";\n  playBtn.counterAxisAlignItems = \"CENTER\";\n\n  const playIcon = createInstanceOrFallback(iconPlayComp, 32);\n  playBtn.appendChild(playIcon);\n\n  const videoText = figma.createText();\n  videoText.fontName = fontBold;\n  videoText.fontSize = 18;\n  videoText.letterSpacing = { value: 2, unit: 'PIXELS' };\n  videoText.characters = \"HOW WE WORK\";\n  videoText.fills = [{ type: 'SOLID', color: WHITE }];\n\n  videoPlaceholder.appendChild(playBtn);\n  videoPlaceholder.appendChild(videoText);\n\n  videoSection.appendChild(pvTop);\n  videoSection.appendChild(videoPlaceholder);\n  pageFrame.appendChild(videoSection);\n\n  // 6. CASE STUDIES SECTION\n  const caseSection = figma.createFrame();\n  caseSection.name = \"Case_Studies_Section\";\n  caseSection.layoutMode = \"VERTICAL\";\n  caseSection.layoutAlign = \"STRETCH\";\n  caseSection.primaryAxisSizingMode = \"AUTO\";\n  caseSection.paddingLeft = 80;\n  caseSection.paddingRight = 80;\n  caseSection.paddingTop = 100;\n  caseSection.paddingBottom = 100;\n  caseSection.itemSpacing = 48;\n  caseSection.fills = [{ type: 'SOLID', color: WHITE }];\n\n  // Header & Sub\n  const caseHeader = figma.createFrame();\n  caseHeader.name = \"Case_Studies_Header\";\n  caseHeader.layoutMode = \"VERTICAL\";\n  caseHeader.itemSpacing = 16;\n  caseHeader.fills = [];\n\n  const caseTitle = figma.createText();\n  caseTitle.fontName = fontBold;\n  caseTitle.fontSize = 40;\n  caseTitle.characters = \"Case Studies\";\n  caseTitle.fills = [{ type: 'SOLID', color: INK }];\n\n  const caseSub = figma.createText();\n  caseSub.fontName = fontRegular;\n  caseSub.fontSize = 18;\n  caseSub.characters = \"Real-world examples of how we have helped companies achieve their marketing objectives.\";\n  caseSub.fills = [{ type: 'SOLID', color: GRAY_600 }];\n\n  caseHeader.appendChild(caseTitle);\n  caseHeader.appendChild(caseSub);\n\n  // Filter Pills\n  const filterRow = figma.createFrame();\n  filterRow.name = \"Filter_Pills\";\n  filterRow.layoutMode = \"HORIZONTAL\";\n  filterRow.itemSpacing = 12;\n  filterRow.fills = [];\n\n  const filtersData = [\n    { label: \"All Work\", count: 20, active: false },\n    { label: \"UI/UX Design\", count: 10, active: true },\n    { label: \"Digital Marketing\", count: 5, active: false },\n    { label: \"Branding\", count: 5, active: false }\n  ];\n\n  for (const f of filtersData) {\n    const pill = figma.createFrame();\n    pill.name = `Filter_${f.label.replace(/\\s+/g, '_')}`;\n    pill.layoutMode = \"HORIZONTAL\";\n    pill.paddingLeft = 20;\n    pill.paddingRight = 20;\n    pill.paddingTop = 12;\n    pill.paddingBottom = 12;\n    pill.cornerRadius = 24;\n    pill.itemSpacing = 8;\n    pill.counterAxisAlignItems = \"CENTER\";\n\n    if (f.active) {\n      pill.fills = [{ type: 'SOLID', color: INK }];\n    } else {\n      pill.fills = [{ type: 'SOLID', color: GRAY_100 }];\n    }\n\n    const pillTxt = figma.createText();\n    pillTxt.fontName = fontSemiBold;\n    pillTxt.fontSize = 14;\n    pillTxt.characters = `${f.label} [${f.count}]`;\n    pillTxt.fills = [{ type: 'SOLID', color: f.active ? WHITE : GRAY_800 }];\n\n    pill.appendChild(pillTxt);\n    filterRow.appendChild(pill);\n  }\n\n  // Cards Container (3 Cards)\n  const cardsGrid = figma.createFrame();\n  cardsGrid.name = \"Case_Studies_Grid\";\n  cardsGrid.layoutMode = \"HORIZONTAL\";\n  cardsGrid.layoutAlign = \"STRETCH\";\n  cardsGrid.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  cardsGrid.fills = [];\n\n  // Card 1: Hover State (Image placeholder with \"See Details\", no caption)\n  const card1 = figma.createFrame();\n  card1.name = \"Case_Study_Card_1_Hover\";\n  card1.resize(400, 360);\n  card1.cornerRadius = 20;\n  card1.fills = [{ type: 'SOLID', color: hexToRgb('#2D3748') }];\n  card1.layoutMode = \"VERTICAL\";\n  card1.primaryAxisAlignItems = \"CENTER\";\n  card1.counterAxisAlignItems = \"CENTER\";\n\n  const seeDetailsBtn = figma.createFrame();\n  seeDetailsBtn.name = \"See_Details_Button\";\n  seeDetailsBtn.layoutMode = \"HORIZONTAL\";\n  seeDetailsBtn.paddingLeft = 24;\n  seeDetailsBtn.paddingRight = 24;\n  seeDetailsBtn.paddingTop = 14;\n  seeDetailsBtn.paddingBottom = 14;\n  seeDetailsBtn.cornerRadius = 24;\n  seeDetailsBtn.fills = [{ type: 'SOLID', color: LIME }];\n  const seeDetailsTxt = figma.createText();\n  seeDetailsTxt.fontName = fontBold;\n  seeDetailsTxt.fontSize = 15;\n  seeDetailsTxt.characters = \"See Details\";\n  seeDetailsTxt.fills = [{ type: 'SOLID', color: INK }];\n  seeDetailsBtn.appendChild(seeDetailsTxt);\n  card1.appendChild(seeDetailsBtn);\n\n  // Helper for normal case study cards\n  const createNormalCaseCard = (name, tag, title) => {\n    const card = figma.createFrame();\n    card.name = name;\n    card.resize(400, 360);\n    card.layoutMode = \"VERTICAL\";\n    card.itemSpacing = 16;\n    card.fills = [];\n\n    const imgPlace = figma.createFrame();\n    imgPlace.name = \"Image_Placeholder\";\n    imgPlace.resize(400, 270);\n    imgPlace.cornerRadius = 20;\n    imgPlace.fills = [{ type: 'SOLID', color: CARD_BG_LIGHT }];\n\n    const infoFrame = figma.createFrame();\n    infoFrame.name = \"Card_Info\";\n    infoFrame.layoutMode = \"VERTICAL\";\n    infoFrame.itemSpacing = 6;\n    infoFrame.fills = [];\n\n    const tagTxt = figma.createText();\n    tagTxt.fontName = fontMedium;\n    tagTxt.fontSize = 13;\n    tagTxt.characters = tag;\n    tagTxt.fills = [{ type: 'SOLID', color: GRAY_500 }];\n\n    const titleTxt = figma.createText();\n    titleTxt.fontName = fontBold;\n    titleTxt.fontSize = 18;\n    titleTxt.characters = title;\n    titleTxt.fills = [{ type: 'SOLID', color: INK }];\n\n    infoFrame.appendChild(tagTxt);\n    infoFrame.appendChild(titleTxt);\n\n    card.appendChild(imgPlace);\n    card.appendChild(infoFrame);\n    return card;\n  };\n\n  const card2 = createNormalCaseCard(\"Case_Study_Card_2\", \"Ai Corporation. 2023\", \"Ai Wave - Ai Chatbot Mobile App\");\n  const card3 = createNormalCaseCard(\"Case_Study_Card_3\", \"Lancer Corporation. 2023\", \"App Lancer - Freelance Mobile App\");\n\n  cardsGrid.appendChild(card1);\n  cardsGrid.appendChild(card2);\n  cardsGrid.appendChild(card3);\n\n  caseSection.appendChild(caseHeader);\n  caseSection.appendChild(filterRow);\n  caseSection.appendChild(cardsGrid);\n  pageFrame.appendChild(caseSection);\n\n  // 7. TESTIMONIAL SECTION\n  const testSection = figma.createFrame();\n  testSection.name = \"Testimonial_Section\";\n  testSection.layoutMode = \"VERTICAL\";\n  testSection.layoutAlign = \"STRETCH\";\n  testSection.primaryAxisSizingMode = \"AUTO\";\n  testSection.paddingLeft = 80;\n  testSection.paddingRight = 80;\n  testSection.paddingTop = 100;\n  testSection.paddingBottom = 100;\n  testSection.fills = [{ type: 'SOLID', color: INK }];\n\n  const testCard = figma.createFrame();\n  testCard.name = \"Testimonial_Card\";\n  testCard.layoutMode = \"VERTICAL\";\n  testCard.layoutAlign = \"STRETCH\";\n  testCard.itemSpacing = 40;\n  testCard.fills = [];\n\n  const testQuote = figma.createText();\n  testQuote.fontName = fontMedium;\n  testQuote.fontSize = 28;\n  testQuote.lineHeight = { value: 42, unit: 'PIXELS' };\n  testQuote.characters = \"“They thoroughly analyze our industry and target audience, allowing them to develop customized campaigns that effectively reach and engage our customers. Their creative ideas and cutting-edge techniques have helped us stay ahead of the competition.”\";\n  testQuote.fills = [{ type: 'SOLID', color: WHITE }];\n  testQuote.layoutAlign = \"STRETCH\";\n\n  // Author & Pager Row\n  const testFooterRow = figma.createFrame();\n  testFooterRow.name = \"Testimonial_Footer_Row\";\n  testFooterRow.layoutMode = \"HORIZONTAL\";\n  testFooterRow.layoutAlign = \"STRETCH\";\n  testFooterRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  testFooterRow.counterAxisAlignItems = \"CENTER\";\n  testFooterRow.fills = [];\n\n  // Author info with Avatar\n  const authorFrame = figma.createFrame();\n  authorFrame.name = \"Author_Info\";\n  authorFrame.layoutMode = \"HORIZONTAL\";\n  authorFrame.itemSpacing = 16;\n  authorFrame.counterAxisAlignItems = \"CENTER\";\n  authorFrame.fills = [];\n\n  const avPlace = figma.createFrame();\n  avPlace.name = \"Avatar_Placeholder\";\n  avPlace.resize(56, 56);\n  avPlace.cornerRadius = 28;\n  avPlace.fills = [{ type: 'SOLID', color: GRAY_500 }];\n\n  const authorDetails = figma.createFrame();\n  authorDetails.layoutMode = \"VERTICAL\";\n  authorDetails.itemSpacing = 4;\n  authorDetails.fills = [];\n\n  const authorName = figma.createText();\n  authorName.fontName = fontBold;\n  authorName.fontSize = 18;\n  authorName.characters = \"Michael Kaizer\";\n  authorName.fills = [{ type: 'SOLID', color: WHITE }];\n\n  const authorRole = figma.createText();\n  authorRole.fontName = fontRegular;\n  authorRole.fontSize = 14;\n  authorRole.characters = \"CEO of Campfield Corp\";\n  authorRole.fills = [{ type: 'SOLID', color: GRAY_400 || hexToRgb('#9CA3AF') }];\n\n  authorDetails.appendChild(authorName);\n  authorDetails.appendChild(authorRole);\n\n  authorFrame.appendChild(avPlace);\n  authorFrame.appendChild(authorDetails);\n\n  // Pager & Controls\n  const pagerFrame = figma.createFrame();\n  pagerFrame.name = \"Pager_Controls\";\n  pagerFrame.layoutMode = \"HORIZONTAL\";\n  pagerFrame.itemSpacing = 20;\n  pagerFrame.counterAxisAlignItems = \"CENTER\";\n  pagerFrame.fills = [];\n\n  const pagerTxt = figma.createText();\n  pagerTxt.fontName = fontSemiBold;\n  