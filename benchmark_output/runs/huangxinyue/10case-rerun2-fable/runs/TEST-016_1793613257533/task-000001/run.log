erRadius=rad||0; page.appendChild(c); return c;}\n\n// ---------- COLOR STYLES ----------\nconst COLORS=[[\"brand/primary\",\"#24C8FE\"],[\"brand/deep\",\"#0B9ED1\"],[\"brand/soft\",\"#EAF9FE\"],[\"brand/tint\",\"#F2FBFE\"],\n[\"ink/900\",\"#101C2B\"],[\"ink/700\",\"#33445A\"],[\"ink/500\",\"#7B8896\"],[\"ink/300\",\"#B4BFCB\"],\n[\"line/divider\",\"#E9EFF5\"],[\"surface/subtle\",\"#F5F9FC\"],[\"white\",\"#FFFFFF\"],\n[\"tint/warmup\",\"#FFF0E7\"],[\"tint/yoga\",\"#E6F8F0\"],[\"tint/squats\",\"#EAF2FF\"],[\"tint/lunge\",\"#F3EDFF\"],\n[\"activity/run\",\"#F77D39\"],[\"activity/swim\",\"#27B0E6\"],[\"activity/cycle\",\"#6B5CE7\"],[\"accent/heart\",\"#0074B9\"],[\"state/disabled\",\"#E5EDF3\"]];\nconst styles={};\nfor(const [n,h] of COLORS){\n  let s=figma.getLocalPaintStyles().find(x=>x.name===n);\n  if(!s){s=figma.createPaintStyle();s.name=n;}\n  s.paints=[P(h)]; styles[n]=s.id;\n}\n\n// ---------- TEXT STYLES ----------\nconst TXT=[[\"Display/32\",\"B\",32,40],[\"Title/26\",\"B\",26,32],[\"H2/20\",\"B\",20,26],[\"H3/17\",\"SB\",17,24],\n[\"Body/15\",\"R\",15,23],[\"BodyStrong/15\",\"SB\",15,23],[\"Label/13\",\"M\",13,18],[\"Caption/12\",\"M\",12,16],[\"Micro/11\",\"SB\",11,14],[\"Overline/11\",\"SB\",11,14]];\nfor(const [n,w,s,lh] of TXT){\n  let st=figma.getLocalTextStyles().find(x=>x.name===n);\n  if(!st){st=figma.createTextStyle();}\n  st.name=n; st.fontName=F[w]; st.fontSize=s; st.lineHeight={unit:\"PIXELS\",value:lh};\n}\n\n// ---------- BUTTONS ----------\nfunction button(name,bg,fg,border){\n  const c=comp(name,374,56,bg,28);\n  c.layoutMode=\"HORIZONTAL\"; c.primaryAxisAlignItems=\"CENTER\"; c.counterAxisAlignItems=\"CENTER\";\n  c.primaryAxisSizingMode=\"FIXED\"; c.counterAxisSizingMode=\"FIXED\";\n  T(c,\"Label\",\"Get started\",{w:\"SB\",s:16,c:fg,lh:20});\n  if(border){c.strokes=[P(border)];c.strokeWeight=1.5;c.strokeAlign=\"INSIDE\";}\n  return c;\n}\nconst btnPrimary=button(\"Button / Primary\",\"#24C8FE\",\"#FFFFFF\");\nbtnPrimary.effects=[sh(\"#24C8