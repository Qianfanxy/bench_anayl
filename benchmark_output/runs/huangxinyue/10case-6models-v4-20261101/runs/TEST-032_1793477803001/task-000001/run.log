hild(ticket); ticket.x=36; ticket.y=182;\n\n// Categories\nconst catRow=figma.createFrame(); catRow.name='Categories';\ncatRow.layoutMode='HORIZONTAL'; catRow.primaryAxisSizingMode='FIXED'; catRow.counterAxisSizingMode='AUTO';\ncatRow.resize(358,68); catRow.primaryAxisAlignItems='SPACE_BETWEEN'; catRow.counterAxisAlignItems='MIN'; catRow.fills=[];\nhome.appendChild(catRow); catRow.x=36; catRow.y=384;\nconst catComp=await g('11:9');\nconst catDefs=[['Flights',null],['Hotels','3:40'],['Trains','3:37'],['Ferry','3:33'],['Bus','3:64']];\nfor(const [label,iconId] of catDefs){\n  const inst=catComp.createInstance(); inst.name='Category / '+label;\n  if(iconId){\n    const ic=inst.findOne(n=>n.name==='Icon');\n    if(ic&&ic.type==='INSTANCE'){ ic.swapComponent(await g(iconId)); ic.resize(20,20); recolor(ic,'#007A8C'); }\n  }\n  setT(inst,'Label',label);\n  catRow.appendChild(inst);\n}\n\n// Section headers\nconst sh1=(await g('8:44')).createInstance(); sh1.name='Section / Journey';\nhome.appendChild(sh1); sh1.x=36; sh1.y=474;\nsetT(sh1,'Title','Journey together');\nconst sh2=(await g('8:44')).createInstance(); sh2.name='Section / Hotels';\nhome.appendChild(sh2); sh2.x=36; sh2.y=702;\nsetT(sh2,'Title','Hotel recommendations for you');\n\n// Journey cards\nconst cardsRow=figma.createFrame(); cardsRow.name='Journey Cards';\ncardsRow.layoutMode='HORIZONTAL'; cardsRow.primaryAxisSizingMode='FIXED'; cardsRow.counterAxisSizingMode='AUTO';\ncardsRow.resize(358,180); cardsRow.itemSpacing=11; cardsRow.fills=[];\nhome.appendChild(cardsRow); cardsRow.x=36; cardsRow.y=512;\nconst jcComp=await g('11:14');\nconst j1=jcComp.createInstance(); j1.name='Journey / Mount Bromo';\nconst j2=jcComp.createInstance(); j2.name='Journey / Labengki Sombori';\nconst j3=jcComp.createInstance(); j3.name='Journey / Sailing Komodo';\nconst sombori=await g('4:28'), komodo=await g('4:31');\nconst p2=j2.findOne(n=>n.name==='Photo_Image'); p2.swapComponent(sombori); p2.resize(112,84);\nconst p3=j3.findOne(n=>n