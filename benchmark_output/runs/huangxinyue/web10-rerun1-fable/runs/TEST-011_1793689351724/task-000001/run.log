{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgQOSkvS5JtOhbfehgy3L","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015J5k827syqIzH60Ej333x7","name":"mcp__figma__use_figma","input":{"code":"\nconst PG=await figma.getNodeByIdAsync('9:2');await figma.setCurrentPageAsync(PG);\nfor(const s of ['Regular','Medium','Semi Bold','Bold']){await figma.loadFontAsync({family:'Inter',style:s});}\nconst lib=PG.children.find(function(n){return n.name==='Design Library · Foodieland';});\nfunction byName(nm){return lib.children.find(function(c){return c.name===nm;});}\nconst P={black:'#000000',ink:'#14141A',body:'#5B5B66',muted:'#8C8C99',line:'#EAEAF0',tint:'#E7F9FD',white:'#FFFFFF',fav:'#E5484D',deep:'#2E2E38'};\nfunction hx(h){h=h.replace('#','');return {r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255};}\nfunction sol(h,o){return {type:'SOLID',color:hx(h),opacity:(o===undefined?1:o)};}\nconst W={r:'Regular',m:'Medium',sb:'Semi Bold',b:'Bold'};\nfunction T(p,o,c){\n  const t=figma.createText();t.name=o.name||'T';\n  t.fontName={family:'Inter',style:W[o.st||'r']};\n  t.characters=(c===undefined||c===null)?'':String(c);\n  t.fontSize=o.sz||16;\n  t.lineHeight={unit:'PERCENT',value:(o.lh||1.45)*100};\n  if(o.ls!==undefined){t.letterSpacing={unit:'PERCENT',value:o.ls};}\n  t.fills=[sol(o.c||P.ink)];t.textAlignHorizontal=o.al||'LEFT';\n  p.appendChild(t);\n  t.textAutoResize='NONE';t.resize(o.w||300,10);t.textAutoResize='HEIGHT';\n  if(o.x!==undefined){t.x=o.x;} if(o.y!==undefined){t.y=o.y;}\n  return t;\n}\nfunction F(p,o){\n  const f=figma.createFrame();f.name=o.name||'F';f.resize(o.w,o.h);\n  f.fills=o.fill?[sol(o.fill)]:[];\n  if(o.r){f.cornerRadius=o.r;}\n  if(o.stroke){f.strokes=[sol(o.stroke)];f.strokeWeight=o.sw||1;}\n  if(o.clip){f.clipsContent=true;}\n  p.appendChild(f);\n  if(o.x!==undefined){f.x=o.x;} if(o.y!==undefined){f.y=o.y;}\n  return f;\n}\nfunction IMG(p,o){\n  const r=figma.createRectangle();r.name=o.name||'Image';r.resize(o.w,o.h);\n  r.cornerRadius=o.r||0;r.fills=[{type:'IMAGE',imageHash:o.hash,scaleMode:'FILL'}];\n  p.appendChild(r);\n  if(o.x!==undefined){r.x=o.x;} if(o.y!==undefined){r.y=o.y;}\n  return r;\n}\nasync function IC(p,id,size,x,y,color){\n  const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();p.appendChild(i);\n  i.rescale(size/Math.max(c.width,c.height));\n  i.findAll(function(n){return n.type==='VECTOR';}).forEach(function(v){\n    if(v.fills.length){v.fills=[sol(color)];}\n    if(v.strokes.length){v.strokes=[sol(color)];}\n  });\n  if(x!==undefined){i.x=x;i.y=y;} return i;\n}\n\n// ---- A. direction step: fixed height per step, body auto ----\nconst dirC=byName('Block / Direction Step');\ndirC.fills=[];\ndirC.resize(760,dirC.height);\nconst dBody=dirC.children.find(function(n){return n.name==='Body';});\ndBody.layoutMode='VERTICAL';dBody.itemSpacing=8;\ndBody.primaryAxisSizingMode='AUTO';dBody.counterAxisSizingMode='FIXED';\ndBody.resize(716,10);\ndBody.children.forEach(function(k){\n  if(k.type==='TEXT'){k.textAutoResize='NONE';k.resize(716,10);k.textAutoResize='HEIGHT';}\n});\ndirC.counterAxisSizingMode='AUTO';\n\n// ---- B. article card rebuild with measured stacking ----\nfor(const n of [...lib.children]){if(n.name==='Card / Article'){n.remove();}}\nconst artC=figma.createComponent();artC.name='Card / Article';artC.resize(416,472);artC.fills=[sol(P.white)];\nartC.cornerRadius=24;artC.clipsContent=true;lib.appendChild(artC);artC.x=760;artC.y=2620;\nconst aImg=figma.createFrame();aImg.name='Photo';aImg.resize(416,230);\naImg.fills=[{type:'IMAGE',imageHash:'6dec8dddf4ffcb0c0abffb94735b2140af713fcb',scaleMode:'FILL'}];\nartC.appendChild(aImg);aImg.x=0;aImg.y=0;\nconst aTitle=T(artC,{name:'Title',w:364,sz:20,st:'sb',lh:1.34,x:26,y:256},'Full Guide to Becoming a Professional Chef');\nconst tH=aTitle.height;\nconst aEx=T(artC,{name:'Excerpt',w:364,sz:14,c:P.body,lh:1.55,x:26,y:256+tH+8},'A working head chef on first jobs, long services and what it really takes.');\nconst eH=aEx.height;\nconst aRow=figma.createFrame();aRow.name='Author';aRow.resize(364,34);aRow.fills=[];artC.appendChild(aRow);\naRow.x=26;aRow.y=Math.min(256+tH+8+eH+16,472-34-20);\nconst avComp=byName('Avatar');\nconst aAv=avComp.createInstance();aRow.appendChild(aAv);aAv.rescale(32/48);aAv.x=0;aAv.y=1;aAv.name='Avatar';\nT(aRow,{name:'Name',w:160,sz:13,st:'m',x:44,y:2},'Dianne Russell');\nT(aRow,{name:'Date',w:150,sz:12,c:P.muted,x:44,y:19},'12 November 2021');\n\n// shared\nconst navSet=byName('Navigation / Item');\nconst navCur=navSet.children.find(function(c){return c.name.indexOf('Current')>=0;});\nconst navDef=navSet.children.find(function(c){return c.name.indexOf('Current')<0;});\nconst hdrC=byName('Site / Header');\nfunction makeHeader(parent,current){\n  const h=hdrC.createInstance();parent.appendChild(h);h.x=0;h.y=0;\n  ['Home','Recipes','Blog','Contact','About us'].forEach(function(l){\n    const inst=h.findOne(function(n){return n.name==='Nav_'+l.replace(' ','');});\n    if(!inst){return;}\n    inst.swapComponent(l===current?navCur:navDef);\n    const tt=inst.findOne(function(n){return n.type==='TEXT';});\n    if(tt){tt.characters=l;}\n  });\n}\nconst cardSet=byName('Card / Recipe');\nconst cNo=cardSet.children.find(function(c){return c.name==='Favorite=No';});\nconst cYes=cardSet.children.find(function(c){return c.name==='Favorite=Yes';});\nconst newsC=byName('Section / Newsletter');\nconst footC=byName('Site / Footer');\nconst srowC=byName('List / Recipe Small');\nconst searchC=byName('UI / Search Bar');\nconst pagC=byName('UI / Pagination');\nconst promoC=byName('Card / Promo');\nconst btnC=byName('UI / Button');\nconst btnBlack=btnC.children.find(function(c){return c.name==='Style=Primary, State=Default';});\nconst RECOS=[['Healthy Japanese Fried Rice with Asparagus','Healthy','a8a2f85871e0a64ae8021799559e16d6e570fab4',false],\n['Mixed Tropical Fruit Salad with Superfood Boo