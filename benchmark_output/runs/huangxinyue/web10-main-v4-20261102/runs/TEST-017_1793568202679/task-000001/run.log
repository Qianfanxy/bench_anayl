{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_bdrk_zhctt52c4i3y6h6vb33cnxhmakxl7rrdfjv6jw3u2deakyis6t3q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01HigNMC4dZppFGmcm36tsK2","name":"mcp__figma__use_figma","input":{"code":"const ws=await figma.getNodeByIdAsync('11:2');await figma.setCurrentPageAsync(ws);\nconst F='Source Sans Pro';\nawait Promise.all(['Regular','SemiBold','Bold','Black'].map(s=>figma.loadFontAsync({family:F,style:s})));\nconst hex=h=>{h=h.replace('#','');return {r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255}};\nconst solid=(h,o=1)=>[{type:'SOLID',color:hex(h),opacity:o}];\nconst C={pri:'#F17228',priH:'#D85F18',sec:'#FFB30E',ink:'#212121',body:'#4F4F4F',muted:'#8A8A8A',line:'#EDEDED',surf:'#F5F5F5',soft:'#FFF1E6',white:'#FFFFFF',dark:'#1E1E21',ftx:'#B8B8BD'};\nfunction T(chars,size,style='Regular',color=C.ink,o={}){const t=figma.createText();t.fontName={family:F,style};t.fontSize=size;t.characters=chars;t.fills=solid(color);t.lineHeight={value:Math.round(size*(o.lh||1.3)),unit:'PIXELS'};if(o.w){t.textAutoResize='HEIGHT';t.resize(o.w,t.height);}t.name=o.name||chars.slice(0,30);if(o.align)t.textAlignHorizontal=o.align;return t;}\nfunction AL(name,dir='HORIZONTAL',o={},node){const f=node||figma.createFrame();f.name=name;f.layoutMode=dir;f.primaryAxisSizingMode='AUTO';f.counterAxisSizingMode='AUTO';f.itemSpacing=o.gap||0;const p=o.pad||[0,0,0,0];f.paddingTop=p[0];f.paddingRight=p[1];f.paddingBottom=p[2];f.paddingLeft=p[3];f.fills=o.fill?solid(o.fill):[];if(o.r)f.cornerRadius=o.r;f.counterAxisAlignItems=o.ca||'CENTER';f.primaryAxisAlignItems=o.pa||'MIN';f.clipsContent=false;return f;}\nconst CP=(name,dir,o)=>AL(name,dir,o,figma.createComponent());\nconst get=async id=>await figma.getNodeByIdAsync(id);\nconst IC={search:'9:12',chevR:'9:4',star:'9:14',env:'9:7'};\nasync function icon(k,color,size=24){const c=await get(IC[k]||k);const i=c.createInstance();i.fills=[];i.findAll(n=>n.type==='VECTOR').forEach(v=>{if(v.strokes.length)v.strokes=solid(color);else v.fills=solid(color);});if(size!==24)i.rescale(size/24);i.name='Icon';return i;}\nconst shadow=(a=.08,y=12,r=32,col='#000000')=>({type:'DROP_SHADOW',color:{...hex(col),a},offset:{x:0,y},radius:r,spread:0,visible:true,blendMode:'NORMAL'});\nasync function photo(id,w,h){const i=(await get(id)).createInstance();i.resize(w,h);i.name='Photo';return i;}\nfunction setP(inst,map){const defs=inst.componentProperties;const o={};for(const [k,v] of Object.entries(map)){const key=Object.keys(defs).find(d=>d.split('#')[0]===k);if(key)o[key]=v;}inst.setProperties(o);}\nfunction prop(c,name,node,type='TEXT',def){const k=c.addComponentProperty(name,type,def??node.characters);node.componentPropertyReferences={...(node.componentPropertyReferences||{}),[type==='TEXT'?'characters':'mainComponent']:k};}\nconst grad=(a,b,t=[[1,1,0],[-1,1,0.5]])=>[{type:'GRADIENT_LINEAR',gradientTransform:t,gradientStops:[{position:0,color:{...hex(a),a:1}},{position:1,color:{...hex(b),a:1}}]}];\nconst board=await get('13:2');\nfunction section(title){const s=AL('Section · '+title,'VERTICAL',{gap:24,ca:'MIN'});s.appendChild(T(title,24,'Bold',C.pri,{name:'Section title'}));const row=AL('Row','HORIZONTAL',{gap:32,ca:'MIN'});s.appendChild(row);board.appendChild(s);return row;}\nconst BTN=await get('13:91');const btnVar=(s,st='Default')=>BTN.children.find(c=>c.name===`Style=${s}, State=${st}`);\nconst ids={};\n\n// RESTAURANT CARD\nlet row=section('Restaurant Card (status via Status Pill variant)');\nconst rc=CP('Restaurant Card','VERTICAL',{fill:C.white,r:24,ca:'MIN'});rc.counterAxisSizingMode='FIXED';rc.resize(336,rc.height);rc.clipsContent=true;rc.effects=[shadow(.08,12,32)];\nconst m=figma.createFrame();m.name='Media';m.resize(336,240);m.clipsContent=true;rc.appendChild(m);const p=await photo('9:54',336,240);m.appendChild(p);\nconst bdg=AL('Badges','HORIZONTAL',{gap:8});m.appendChild(bdg);bdg.x=16;bdg.y=16;\nconst bD=(await get('13:164')).createInstance();bD.name='Discount';bdg.appendChild(bD);const bF=(await get('13:168')).createInstance();bF.name='Fast';bdg.appendChild(bF);\nconst body=AL('Body','VERTICAL',{gap:16,pad:[20,20,24,20],ca:'MIN'});rc.appendChild(body);body.layoutSizingHorizontal='FILL';\nconst top=AL('Identity','HORIZONTAL',{gap:16});body.appendChild(top);\nconst lm=(await get('13:180')).createInstance();lm.name='Logo Mark';top.appendChild(lm);\nconst col=AL('Name & rating','VERTICAL',{gap:4,ca:'MIN'});top.appendChild(col);\nconst nm=T('Foodworld',22,'Bold',C.ink,{name:'Name'});col.appendChild(nm);\nconst rt=AL('Rating','HORIZONTAL',{gap:6});rt.appendChild(await icon('star',C.sec,20));const rv=T('46',18,'Bold',C.sec,{name:'Rating'});rt.appendChild(rv);col.appendChild(rt);\nconst stp=(await get('13:179')).children.find(c=>c.name==='Status=Closed').createInstance();stp.name='Status';body.appendChild(stp);\nprop(rc,'Name',nm);prop(rc,'Rating',rv);prop(rc,'Photo',p,'INSTANCE_SWAP','9:54');\nrow.appendChild(rc);ids.rest=rc.id;\n\n// DEAL BANNER\nrow=section('Deal Banner · Layout');\nconst deals=[];\nfor(const L of ['Photo Left','Photo Right']){const c=CP('Layout='+L,'HORIZONTAL',{fill:C.white,r:32,ca:'CENTER'});c.primaryAxisSizingMode='FIXED';c.resize(1440,c.height);c.clipsContent=true;c.effects=[shadow(.08,16,48)];\n const pm=await photo('9:44',720,440);\n const tx=AL('Content','VERTICAL',{gap:24,pad:[64,96,64,96],ca:'MIN'});tx.layoutGrow=1;\n const tt=T('Best deals Crispy Sandwiches',48,'Bold',C.ink,{name:'Title',w:528,lh:1.15});tx.appendChild(tt);\n const tc=T('Enjoy the large size of sandwiches. Complete perfect slice of sandwiches.',20,'Regular',C.body,{name:'Copy',w:528,lh:1.5});tx.appendChild(tc);\n const b=btnVar('Primary').createInstance();setP(b,{Label:'Proceed to order','Trailing icon':true});b.name='Proceed to order';tx.appendChild(b);\n if(L==='Photo Left'){c.appendChild(pm);c.appendChild(tx);}else{c.appendChild(tx);c.appendChild(pm);}\n t