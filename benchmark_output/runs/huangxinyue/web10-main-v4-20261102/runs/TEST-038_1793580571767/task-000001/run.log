dAll(n=>n.type===\"VECTOR\").forEach(v=>{if(v.strokes.length)v.strokes=[S(color)];else if(v.fills.length)v.fills=[S(color)];});\n return i;}\nfunction compFrom(f,name){const c=figma.createComponentFromNode(f);c.name=name;return c;}\n```\n\nWait AL resize when dir set with p/c AUTO then resize — resize sets explicit w/h and switches sizing to FIXED automatically? Setting resize on AL frame sets its size; sizing modes stay AUTO which then re-hug on children append. For fixed frames (o.p=\"FIXED\"/o.c=\"FIXED\") resize works. I'll pass p/c explicitly for fixed.\n\nIcon buttons:\n\n```js\nconst ib=AL(\"ib\",\"HORIZONTAL\",{p:\"FIXED\",c:\"FIXED\",w:52,h:52,bg:C.white,stroke:C.border,r:100,main:\"CENTER\",cross:\"CENTER\"});\nib.appendChild(icon(\"Bell\",C.ink,22));\nconst cIconBtn=compFrom(ib,\"MAC/IconButton\");\n\nconst ibd=AL(\"ibd\",\"HORIZONTAL\",{p:\"FIXED\",c:\"FIXED\",w:52,h:52,bg:C.ink,r:100,main:\"CENTER\",cross:\"CENTER\"});\nibd.appendChild(icon(\"ArrowR\",C.white,20));\nconst cIconBtnDark=compFrom(ibd,\"MAC/IconButton Dark\");\n```\n\nButtons:\n\n```js\nconst bl=AL(\"bl\",\"HORIZONTAL\",{pad:[16,28],gap:10,bg:C.lime,r:100,cross:\"CENTER\",main:\"CENTER\"});\nT(bl,\"Schedule Call\",16,\"SemiBold\",C.ink);\nbl.appendChild(icon(\"ArrowR\",C.ink,20));\nconst cBtnLime=compFrom(bl,\"MAC/Button/Lime\");\n\nconst bo=AL(\"bo\",\"HORIZONTAL\",{pad:[15,27],gap:10,r:100,cross:\"CENTER\",main:\"CENTER\",stroke:C.ink,sw:1.5});\nT(bo,\"View Case Study\",16,\"SemiBold\",C.ink);\nconst cBtnOutline=compFrom(bo,\"MAC/Button/Outline\");\n\nconst bw=AL(\"bw\",\"HORIZONTAL\",{pad:[10,20],bg:C.white,r:100,cross:\"CENTER\",main:\"CENTER\"});\nT(bw,\"See Details\",14,\"SemiBold\",C.ink);\nconst cBtnWhite=compFrom(bw,\"MAC/Button/White\");\n\nconst bd=AL(\"bd\",\"HORIZONTAL\",{pad:[16,28],gap:10,bg:C.ink,r:100,cross:\"CENTER\",main:\"CENTER\"});\nT(bd,\"Get Started\",16,\"SemiBold\",C.white);\nbd.appendChild(icon(\"ArrowR\",C.white,20));\nconst cBtnDarkIcon=compFrom(bd,\"MAC/Button/