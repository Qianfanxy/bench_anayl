18', Photo_Cooking_Step:'7:23', Photo_Hiring:'7:28', Photo_Plantain_Stew:'7:51', Photo_Vegetarian_Lasagna:'7:57',\n  Avatar_Albert_Flores:'7:3', Avatar_Courtney_Henry:'7:59', Avatar_Dianne_Russell:'7:58', Avatar_Foodieland:'7:5',\n  Avatar_John_Smith:'7:4', Avatar_Leslie_Alexander:'7:2', Avatar_Robert_Fox:'7:7', Avatar_Wade_Warren:'7:6',\n  Icon_Arrow_Right:'7:35', Icon_Check:'7:33', Icon_Chevron_Down:'7:34', Icon_Chevron_Right:'7:38', Icon_Comment:'7:36',\n  Icon_Favorite:'7:37', Icon_Fork_Knife:'7:40', Icon_Like:'7:39', Icon_More:'7:41', Icon_Play:'7:42',\n  Icon_Print:'7:43', Icon_Save:'7:44', Icon_Send:'7:45', Icon_Share:'7:46', Icon_Timer:'7:47',\n  Button:'1:28', TextField:'1:31'\n};\nconst ASSETS = figma.createFrame();\nASSETS.name = '■ Assets';\nASSETS.fills = [];\nASSETS.clipsContent = false;\npage.appendChild(ASSETS);\n\nlet mx = 0, my = 0, rowH = 0;\nfor (const [name, id] of Object.entries(mediaIds)) {\n  const src = await figma.getNodeByIdAsync(id);\n  const c = src.clone();\n  c.name = name;\n  ASSETS.appendChild(c);\n  c.x = mx; c.y = my;\n  mx += c.width + 24;\n  rowH = Math.max(rowH, c.height);\n  if (mx > 4600) { mx = 0; my += rowH + 24; rowH = 0; }\n}\nASSETS.resize(4700, my + rowH + 40);\n\nconst map = {};\nfor (const c of ASSETS.children) map[c.name] = c.id;\nreturn { assetsId: ASSETS.id, count: Object.keys(map).length, h: ASSETS.height };","description":"Clone all media and given components into an Assets frame on the Workspace page (retry without clientStorage)"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"eb6a87e1-77d2-4750-aa78-08940da487c1","uuid":"a5317b54-26de-448d-ae32-11db2fb18e0a","timestamp":"2026-11-01T19:58:32.710Z","tool_use_meta":[{"id":"mcp__figma__use_figma_13_7cb416f8","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
