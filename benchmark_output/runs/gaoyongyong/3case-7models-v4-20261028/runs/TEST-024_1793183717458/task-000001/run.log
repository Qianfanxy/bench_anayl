}\n\n  createHistoryItem(366, \"Buy\", \"AAPL\", \"₦200,000\", false);\n  createHistoryItem(422, \"Sell\", \"TLKM\", \"₦150,000\", true);\n  createHistoryItem(478, \"Buy\", \"FB\", \"₦1,000,240\", false);\n  createHistoryItem(534, \"Sell\", \"AAPL\", \"₦1,000,240\", true);\n\n\n  // ----------------------------------------------------\n  // 06_Notification\n  // ----------------------------------------------------\n  const notification = figma.createFrame();\n  notification.name = \"06_Notification\";\n  notification.resize(414, 932);\n  notification.x = 1000;\n  notification.y = 1100;\n  notification.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  workspacePage.appendChild(notification);\n  addShell(notification);\n\n  const notHeader = figma.createFrame();\n  notHeader.name = \"Header_Bar\";\n  notHeader.resize(414, 60);\n  notHeader.x = 0;\n  notHeader.y = 54;\n  notHeader.fills = [];\n  notification.appendChild(notHeader);\n\n  if (iconBack) {\n    const backClone = iconBack.clone();\n    backClone.x = 24;\n    backClone.y = 18;\n    recolorNode(backClone, textDarkColor);\n    notHeader.appendChild(backClone);\n  }\n\n  const notTitle = figma.createText();\n  notTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  notTitle.fontSize = 24;\n  notTitle.characters = \"Notification\";\n  notTitle.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  notTitle.x = 74;\n  notTitle.y = 14;\n  notHeader.appendChild(notTitle);\n\n  function createNotificationRow(y, message, timeText, iconBgColor) {\n    const row = figma.createFrame();\n    row.name = \"Notification_Row\";\n    row.resize(366, 80);\n    row.x = 24;\n    row.y = y;\n    row.fills = [];\n    notification.appendChild(row);\n\n    const thumb = figma.createFrame();\n    thumb.name = \"Thumb_Icon\";\n    thumb.resize(48, 48);\n    thumb.x = 0;\n    thumb.y = 10;\n    thumb.cornerRadius = 24;\n    thumb.fills = [{ type: \"SOLID\", color: iconBgColor }];\n    row.appendChild(thumb);\n\n    const dot = figma.createEllipse();\n    dot.resize(12, 12);\n    dot.x = 18;\n    dot.y = 18;\n    dot.fills = [{ type: \"SOLID\", color: primaryColor }];\n    thumb.appendChild(dot);\n\n    const msg = figma.createText();\n    msg.fontName = { family: \"Inter\", style: \"Medium\" };\n    msg.fontSize = 14;\n    msg.lineHeight = { value: 20, unit: \"PIXELS\" };\n    msg.characters = message;\n    msg.fills = [{ type: \"SOLID\", color: textDarkColor }];\n    msg.resize(294, 40);\n    msg.x = 64;\n    msg.y = 10;\n    row.appendChild(msg);\n\n    const time = figma.createText();\n    time.fontName = { family: \"Inter\", style: \"Regular\" };\n    time.fontSize = 11;\n    time.characters = timeText;\n    time.fills = [{ type: \"SOLID\", color: textGreyColor }];\n    time.x = 64;\n    time.y = 52;\n    row.appendChild(time);\n\n    const line = figma.createLine();\n    line.resize(366, 0);\n    line.x = 24;\n    line.y = y + 80;\n    line.strokes = [{ type: \"SOLID\", color: dividerColor }];\n    line.strokeWeight = 1;\n    notification.appendChild(line);\n  }\n\n  createNotificationRow(130, \"Where do you see yourself in the next ages?\", \"30 secs ago\", { r: 255/255, g: 249/255, b: 235/255 });\n  createNotificationRow(220, \"Check out today's best investor. You'll learn from him.\", \"3 min ago\", { r: 240/255, g: 248/255, b: 243/255 });\n  createNotificationRow(310, \"Apple stocks just increased. Check it out now.\", \"15 min ago\", { r: 245/255, g: 247/255, b: 248/255 });\n\n  console.log(\"Home, Asset Overlay, and Notification screens built successfully!\");\n}\n\nawait buildSecondScreens();\n","description":"Build 04_Home, 05_My_Asset_Overlay, and 06_Notification frames inside Workspace.","fileKey":"1Dyjg6o91wFpVkfahevN0Q"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":105597,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"885502f9-7195-4d21-a7