name='Media'; media.layoutMode='VERTICAL'; media.primaryAxisSizingMode='AUTO';\n  media.counterAxisSizingMode='FIXED'; media.resize(604,200); media.fills=[];\n  const p=phComp.createInstance(); p.name='Placeholder'; p.resize(604,340); media.appendChild(p);\n  const cap=figma.createFrame(); cap.name='Caption'; cap.layoutMode='HORIZONTAL'; cap.primaryAxisSizingMode='FIXED'; cap.counterAxisSizingMode='AUTO'; cap.resize(604,20); cap.primaryAxisAlignItems='SPACE_BETWEEN'; cap.fills=[]; cap.paddingTop=10;\n  cap.appendChild(T(data.num+' — '+data.title,12,F.R,MUTED,{lh:16,ls:0.4}));\n  cap.appendChild(T(data.figure,12,F.R,'#A29A8A',{lh:16,ls:0.4}));\n  media.appendChild(cap);\n  b.appendChild(media);\n  wrap.appendChild(b);\n  return b;\n}\nconst p1=projectBlock('Linked-External',{num:'01',tag:'PROJECT',title:'Goblin Bust',desc:'Goblin concept digital sculpture with human-like skin. Learned a lot of quick tips and look development.',tools:'Sculpted in ZBrush, retopologized and UV-mapped in Maya, textured in Mari, rendered with Arnold.',link:'More shots from this project',external:true,figure:'FIG. 01'});\np1.x=20; p1.y=1250;\nconst p2=projectBlock('Linked-Internal',{num:'02',tag:'PROJECT',title:'Skin Shader Study',desc:'Subsurface weight, specular roughness and diffuse maps generated with procedural and manual techniques.',link:'See case study',external:false,figure:'FIG. 02'});\np2.x=20; p2.y=1620;\nconst p3=projectBlock('Status-WIP',{num:'03',tag:'PROJECT',title:'Creature Concept',desc:'Experimental creature modeling for a school project.',status:true,figure:'FIG. 03'});\np3.x=20; p3.y=1990;\nconst pSet=figma.combineAsVariants([p1,p2,p3],wrap); pSet.name='Project Block'; pSet.x=20; pSet.y=1250;\npSet.layoutMode='VERTICAL'; pSet.primaryAxisSizingMode='AUTO'; pSet.counterAxisSizingMode='AUTO'; pSet.itemSpacing=60; pSet.fills=[];\nreturn JSON.stringify({pSet:pSet.id,variants:[p1.id,p2.id,p3.id]});\n","description":"Create Project Block component with three variants","fileKe