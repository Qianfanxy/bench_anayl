{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011Cgb3M9FaLnbBhLpTcpHcm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01xyLEulL5ASlx2hfoDaWh9X","name":"mcp__figma__use_figma","input":{"code":"\nfor (const s of ['Regular','Medium','Semi Bold','Bold']) await figma.loadFontAsync({family:'Roboto',style:s});\nconst C={bg:'#0E0F13',surface:'#17181E',surface2:'#1F2028',surface3:'#282A33',border:'#2C2E38',text:'#F2F2F2',text2:'#9EA0AD',text3:'#6E7080',brand:'#279646',brandSoft:'#173A26',gain:'#2FBF71',loss:'#F0554B'};\nconst rgb=h=>{h=h.replace('#','');return{r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255};};\nconst paint=h=>[{type:'SOLID',color:rgb(h)}];\nfunction text(parent,name,chars,color,size,weight,lh){const t=figma.createText();t.name=name;t.fontName={family:'Roboto',style:weight||'Regular'};t.characters=chars;t.fontSize=size;t.lineHeight={unit:'PIXELS',value:lh||Math.round(size*1.35)};t.fills=paint(color);parent.appendChild(t);return t;}\nfunction box(name,w,h,fill,radius){const f=figma.createFrame();f.name=name;f.resize(w,h);f.fills=fill?paint(fill):[];f.clipsContent=false;if(radius!==undefined)f.cornerRadius=radius;return f;}\nasync function inst(id,parent,w,h){const n=await figma.getNodeByIdAsync(id);const i=n.createInstance();if(w){i.resize(w,h||w);}parent.appendChild(i);return i;}\nfunction recolor(node,color){for(const t of node.findAll(n=>['VECTOR','ELLIPSE','RECTANGLE'].includes(n.type))){try{t.fills=paint(color);}catch(e){}}}\nconst page=await figma.getNodeByIdAsync('5:2');await figma.setCurrentPageAsync(page);\nconst root=await figma.getNodeByIdAsync('7:11');\n\n// ---- Payment method row ----\nasync function methodRow(name,label,iconId,selected){\n  const c=figma.createComponent();c.name=name;c.resize(343,60);\n  c.fills=paint(selected?C.brandSoft:C.surface);c.cornerRadius=12;\n  if(selected){c.strokes=paint(C.brand);c.strokeWeight=1;c.strokeAlign='INSIDE';}\n  c.layoutMode='HORIZONTAL';c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';\n  c.counterAxisAlignItems='CENTER';c.paddingLeft=14;c.paddingRight=14;c.itemSpacing=12;\n  const ib=box('Icon box',32,32,selected?'#1E4A30':C.surface2,8);c.appendChild(ib);\n  ib.layoutMode='HORIZONTAL';ib.primaryAxisAlignItems='CENTER';ib.counterAxisAlignItems='CENTER';\n  await inst(iconId,ib,18,18);\n  const lb=text(c,'Label',label,C.text,14,'Medium',18);lb.layoutGrow=1;\n  await inst('2:48',c,16,16);\n  root.appendChild(c);return c;\n}\nconst mr1=await methodRow('Method Row · ATM','ATM','2:69',false);\nconst mr2=await methodRow('Method Row · Debit','Kartu Debit','2:75',false);\nconst mr3=await methodRow('Method Row · Mobile','Mobile Banking','2:80',false);\nconst mr4=await methodRow('Method Row · Indomaret','Indomaret','2:87',false);\nconst mr5=await methodRow('Method Row · Alfamart','Alfamart','2:87',true);\n\n// ---- Amount tile ----\nasync function amountTile(name,label,selected){\n  const c=figma.createComponent();c.name=name;c.resize(108,54);\n  c.fills=paint(selected?C.brandSoft:C.surface);c.cornerRadius=12;\n  c.strokes=paint(selected?C.brand:C.border);c.strokeWeight=selected?1.5:1;c.strokeAlign='INSIDE';\n  c.layoutMode='HORIZONTAL';c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';\n  c.primaryAxisAlignItems='CENTER';c.counterAxisAlignItems='CENTER';\n  text(c,'Label',label,selected?C.brand:C.text,14,selected?'Medium':'Regular',18);\n  root.appendChild(c);return c;\n}\nconst at1=await amountTile('Amount Tile · Default','Rp50.000',false);\nconst at2=await amountTile('Amount Tile · Selected','Rp500.000',true);\n\n// ---- Stepper ----\nconst st=figma.createComponent();st.name='Stepper';st.resize(343,36);st.fills=[];\nst.layoutMode='HORIZONTAL';st.primaryAxisSizingMode='FIXED';st.counterAxisSizingMode='FIXED';st.counterAxisAlignItems='CENTER';st.itemSpacing=10;\nconst steps=[[1,'Masukkan Nominal',true],[2,'Pembayaran',false]];\nfor(const [num,label,cur] of steps){\n  const g=box('Step '+num,0,32,null);g.layoutMode='HORIZONTAL';g.primaryAxisSizingMode='AUTO';g.counterAxisSizingMode='FIXED';g.counterAxisAlignItems='CENTER';g.itemSpacing=7;st.appendChild(g);\n  const circle=box('Num',22,22,cur?C.brand:C.surface3,11);g.appendChild(circle);circle.layoutMode='HORIZONTAL';circle.primaryAxisAlignItems='CENTER';circle.counterAxisAlignItems='CENTER';\n  text(circle,'N',String(num),cur?'#FFFFFF':C.text3,11,'Bold',13);\n  text(g,'Label',label,cur?C.text:C.text3,12,'Medium',16);\n  if(num===1){const line=box('Line',0,2,C.border,1);line.layoutGrow=1;line.layoutAlign='CENTER';st.appendChild(line);}\n}\nroot.appendChild(st);\n\n// ---- Key stats row ----\nconst ks=figma.createComponent();ks.name='Keystats Row';ks.resize(343,34);ks.fills=[];\nks.layoutMode='HORIZONTAL';ks.primaryAxisSizingMode='FIXED';ks.counterAxisSizingMode='FIXED';ks.counterAxisAlignItems='CENTER';\ntext(ks,'Label','Previous Close',C.text3,12,'Regular',16);\nconst kv=text(ks,'Value','Rp198',C.text,12,'Medium',16);kv.layoutAlign='INHERIT';\nconst kvf=box('Spacer',0,20,null);ks.insertChild(1,kvf);kvf.layoutGrow=1;\nks.appendChild(kv);\nroot.appendChild(ks);\n\n// ---- Payment detail row ----\nconst pd=figma.createComponent();pd.name='Payment Detail';pd.resize(343,58);\npd.fills=paint(C.surface);pd.cornerRadius=12;pd.layoutMode='HORIZONTAL';pd.primaryAxisSizingMode='FIXED';pd.counterAxisSizingMode='FIXED';\npd.counterAxisAlignItems='CENTER';pd.paddingLeft=14;pd.paddingRight=14;\nconst pdl=box('Left',0,34,null);pdl.layoutMode='VERTICAL';pdl.primaryAxisSizingMode='AUTO';pdl.counterAxisSizingMode='AUTO';pdl.layoutGrow=1;pdl.itemSpacing=2;pd.appendChild(pdl);\ntext(pdl,'Label','Nominal',C.text3,11,'Regular',14);\ntext(pdl,'Value','Rp500.000',C.text,14,'Medium',18);\nawait inst('2:91',pd,18,18);\nroot.appendChild(pd);\n\nreturn 'ok '+[mr1.id,mr2.id,mr3.id,mr4.id,mr5.id,at1.id,at2.id,st.id,ks.id,pd.id].join(',');\n","description":"Create method rows, amount tiles, stepper, keystats row and payment detail","fileKey":"4vKKpRHOlbMS1w0BzHKmKz"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":19,"cache_creation_input_tokens":2220,"cache_read_input_tokens":79821,"cache_creation":{"ephemeral_5m_input_tokens":2220,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"global","speed":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6dc355e0-32b3-4413-a395-2651983398f3","uuid":"5dac858f-6e5e-4528-bbf2-76cb31939b54","timestamp":"2026-10-31T21:40:38.320Z","tool_use_meta":[{"id":"toolu_01xyLEulL5ASlx2hfoDaWh9X","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
