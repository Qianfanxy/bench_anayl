{ty}`);add(f,sh,0,812-sh.height);sh.name='Sheet / '+ty;await homeInd(f);}\n// 09\n{const f=screen('09_Order_Complete',8);res[f.name]=f.id;await statusBar(f);const cf=[[84,176,10,'brand/primary'],[292,160,8,'semantic/warning'],[64,276,6,'semantic/success'],[306,288,12,'brand/tint'],[300,226,6,'brand/primary'],[52,216,8,'semantic/success-tint']];for(const [x,y,d,c] of cf){const e=figma.createEllipse();e.name='Confetti';e.resize(d,d);e.fills=[p(c)];add(f,e,x,y);}\n add(f,inst('Success Mark'),115.5,160);await wrapText(f,'Congratulations!!!','Display','text/primary',24,336,327,'CENTER');await wrapText(f,'Your order has been taken and is being attended to','Body','text/secondary',40,388,295,'CENTER');add(f,btn('Primary','Track order'),24,638);add(f,btn('Outline','Continue shopping'),24,706);await homeInd(f);}\n// 10\n{const f=screen('10_Track_Order',9);res[f.name]=f.id;const h=inst('Screen Header');setP(h,{Title:'Delivery Status'});add(f,h,0,0);await statusBar(f,true);\n const seg=(y,c)=>{const r=figma.createRectangle();r.name='Connector';r.resize(2,16);r.fills=[p(c)];add(f,r,59,y);};\n const st=(n)=>inst('Status Step',n);add(f,st('State=Done, Step=Order Taken'),24,124);seg(196,'semantic/success');add(f,st('State=Done, Step=Order Is Being Prepared'),24,212);seg(284,'semantic/success');const cur=st('State=Current, Step=Order Is Being Delivered');add(f,cur,24,300);const mapY=300+cur.height+12;\n const mf=figma.createFrame();mf.name='Delivery map';mf.resize(327,207);mf.cornerRadius=16;mf.clipsContent=true;mf.fills=[];add(f,mf,24,mapY);mf.appendChild(await media('2:50'));const y4=mapY+207+16;seg(y4-16,'border/default');add(f,st('State=Pending, Step=Order Received'),24,y4);await homeInd(f);}\nsec.y=920;\nreturn res;","description":"Build all 10 screens as instances of the library","fileKey":"G2HC4jdOIMGram1qNF53gG"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":69,"cache_creation_input_tokens":9321,"cache_read_input_toke