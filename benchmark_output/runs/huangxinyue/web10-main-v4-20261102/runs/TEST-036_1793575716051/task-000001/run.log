blish now\n\nAttachments: \"Very important file.figma\", \"Some file.scratch\", \"List of something.xd\", \"Very important file.svg\" — each \"7.5 MB · 3.22.22, 11:15 AM\".\n\nGreat. Now start building. First use_figma call: setup — check fonts available, rename nothing, create section labels? Let me first verify fonts and create the 6 empty screen frames + top-level organization, then components.\n\nActually wait — one important check: the workspace page is 8:2. New frames go to page 8:2. figma.currentPage — the plugin runs in context of... I should explicitly: const page = await figma.getNodeByIdAsync('8:2'); await figma.setCurrentPageAsync(page). Yes, must use setCurrentPageAsync.\n\nAlso load fonts: DM Sans Regular/Medium/Bold. Check available: figma.listAvailableFontsAsync().filter(f => f.fontName.family === 'DM Sans').\n\nHelper functions I'll re-declare in every call (keep compact):\n\n```js\nconst page = await figma.getNodeByIdAsync('8:2');\nawait figma.setCurrentPageAsync(page);\nconst F = (s) => figma.loadFontAsync({family:'DM Sans', style:s});\nawait Promise.all([F('Regular'), F('Medium'), F('Bold')]);\nconst C = {\n  brand:'5051F9', brandSoft:'EDEDFE', brandDark:'3F41D6', blue:'1DA7FF',\n  ink:'14142B', sub:'6E7191', mute:'8C8C9E', faint:'A6A8B8',\n  bg:'F4F5F9', surface:'FFFFFF', border:'E8E9F0', inputBorder:'E1E2E9',\n  green:'2BB673', greenSoft:'E3F6ED', orange:'F79009', orangeSoft:'FEF0E0',\n  red:'EB5757', redSoft:'FDEAEA', teal:'12A594', tealSoft:'E0F5F2', pink:'E548A0', pinkSoft:'FBE7F3',\n  chart2:'C9CAFB'\n};\nconst hex = h => { const n=parseInt(h,16); return {r:((n>>16)&255)/255, g:((n>>8)&255)/255, b:(n&255)/255}; };\nconst solid = (h,o=1) => ({type:'SOLID', color:hex(h), opacity:o});\nfunction txt(chars, size, style, color, opts={}) {\n  const t = figma.createText();\n  t.fontName = {family:'DM Sans', style};\n  t.characters = chars; t.fontSize = size;\n  t.fills = [solid(color, opts.o ?? 1)];\n  if (opts.ls) t.letterSpacing = {unit:'PIXELS', value:opts.ls};\n  if (opts.lh) t.lineHeight = {unit:'PIXELS', value:opts.lh};\n  if (opts.w) t.resize(opts.w, t.height);\n  if (opts.trunc) t.textTruncation = 'ENDING';\n  if (opts.align) t.textAlignHorizontal = opts.align;\n  return t;\n}\nfunction rect(w,h,r,fill,opts={}) { const rc=figma.createRectangle(); rc.resize(w,h); if(fill) rc.fills=[fill]; if(r) rc.cornerRadius=r; if(opts.stroke){rc.strokes=[solid(opts.stroke)];rc.strokeWeight=opts.sw??1;} if(opts.dash) rc.dashPattern=[4,4]; if(opts.fx) rc.effects=opts.fx; return rc; }\nfunction frame(w,h,r,fill,opts={}) { const f=figma.createFrame(); f.resize(w,h); if(fill===null) f.fills=[]; else f.fills=[typeof fill==='string'?solid(fill):fill]; if(r) f.cornerRadius=r; if(opts.stroke){f.strokes=[solid(opts.stroke)]; f.strokeWeight=opts.sw??1;} if(opts.fx) f.effects=opts.fx; if(opts.name) f.name=opts.name; if(opts.clip!==undefined) f.clipsContent=opts.clip; return f; }\nasync function inst(id, parent, x, y, scale) { const c = await figma.getNodeByIdAsync(id); const i = c.createInstance(); parent.appendChild(i); if (x!==undefined) {i.x=x; i.y=y;} if (scale) i.rescale(scale); return i; }\nfunction shadow(a=0.05, y=8, blur=24) { return [{type:'DROP_SHADOW', color:{r:0.08,g:0.08,b:0.17,a}, offset:{x:0,y}, radius:blur, spread:0, visible:true, blendMode:'NORMAL'}]; }\n```\n\nFor icons recolor:\n```js\nfunction recolor(node, h) { const s=solid(h); const walk=n=>{ if('fills' in n && Array.isArray(n.fills) && n.fills.length && n.fills[0].type==='SOLID') n.fills=[s]; if('children' in n) n.children.forEach(walk); }; walk(node); }\n```\nCareful: for instances, setting fills on nested layers is allowed as override. But some icon components might have strokes instead of fills (\"line icons\") — icons described as \"line icons #1A1A1F\". Could be vector fills (path fill forming line shape) or strokes. I'll recolor both fills and strokes: if fills[0] solid → replace; if strokes.length && strokes[0].type==='SOLID' → replace stroke col