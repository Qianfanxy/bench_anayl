adSet.itemSpacing=16;\n\n// ---------- Pay card variants ----------\nawait label('PAYMENT METHOD CARD · State', 1340);\nasync function payCard(name, selected){\n  const c=comp(name,342,76);\n  const bg=figma.createRectangle(); bg.resize(342,76); bg.cornerRadius=16; bg.name='Bg';\n  bg.fills=[{type:'SOLID',color:WHITE}];\n  bg.strokes=[{type:'SOLID',color:selected?RED:LINE}]; bg.strokeWeight=selected?1.5:1;\n  if(selected) bg.effects=CARD_SHADOW;\n  c.appendChild(bg);\n  const tile=figma.createRectangle(); tile.resize(48,48); tile.x=14; tile.y=14; tile.cornerRadius=12; tile.fills=[{type:'SOLID',color:{r:0.965,g:0.949,b:0.941}}]; tile.name='Tile'; c.appendChild(tile);\n  const card=await cloneImg('1:318',32); card.x=14+(48-32)/2; card.y=14+(48-card.height)/2; c.appendChild(card);\n  await T(c,'Credit card',{x:74,y:16,size:15,style:'SemiBold',color:BROWN});\n  await T(c,'Mastercard · 5105 **** **** 0505',{x:74,y:40,size:12,style:'Medium',color:SUB});\n  const radio=figma.createEllipse(); radio.resize(22,22); radio.x=342-22-16; radio.y=(76-22)/2; radio.name='Radio';\n  radio.fills=[{type:'SOLID',color:WHITE}]; radio.strokes=[{type:'SOLID',color:selected?RED:FAINT}]; radio.strokeWeight=selected?6:1.5;\n  c.appendChild(radio);\n  return c;\n}\nconst pcS=await payCard('State=Selected',true);\nconst pcD=await payCard('State=Default',false);\nconst pcSet=figma.combineAsVariants([pcS,pcD], ds);\npcSet.name='DS / Payment Method Card'; pcSet.x=24; pcSet.y=1376; pcSet.itemSpacing=16;\n\n// ---------- Success mark ----------\nawait label('SUCCESS MARK', 1500);\nconst sm=comp('DS / Success Mark',96,96);\nconst sc=figma.createEllipse(); sc.resize(96,96); sc.fills=[{type:'SOLID',color:RED}];\nsc.effects=[{type:'DROP_SHADOW',color:{r:0.937,g:0.165,b:0.224,a:0.35},offset:{x:0,y:12},radius:32,spread:0,visible:true,blendMode:'NORMAL'}];\nsc.name='Circle'; sm.appendChild(sc);\nconst sck=await iconInst(ICONS.check,44,WHITE); sck.x=26; sck.y=26; sm.appendChild(sck);\nsm.x=24; sm.y=1536;\n\nreturn JSON.stringify({iconBtnSet:ibSet2.id, chipSet:chipSet.id, rating:rb.id, portionStepper:ps.id, stepperPill:sp.id, addonSet:adSet.id, payCardSet:pcSet.id, successMark:sm.id});\n","description":"Rebuild DS components with components created inside ds frame (fix same-page error)","fileKey":"xCaQ6D2H3AhzjPBYLooEMF"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"646e8bf7-f7ad-4c70-b0b4-d0ae7901c022","uuid":"b0e49354-d242-45f9-92ea-52dc040b4485","timestamp":"2026-10-28T16:28:02.237Z","tool_use_meta":[{"id":"mcp__figma__use_figma_10_39510161","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
