 i=s.createInstance();parent.appendChild(i);if(scale)i.rescale(scale);i.x=x;i.y=y;return i;}\nfunction useMedia(name,parent,x,y,scale,hex){const s=media.findOne(n=>n.type==='COMPONENT'&&n.name===name);const i=s.createInstance();parent.appendChild(i);if(scale)i.rescale(scale);i.x=x;i.y=y;if(hex)i.findAll(n=>n.type==='VECTOR').forEach(n=>{if(n.fills&&n.fills.length)n.fills=fl(hex);if(n.strokes&&n.strokes.length)n.strokes=fl(hex);});return i;}\nfunction star(p,x,y,size,hex){const s=figma.createVector();s.name='Star';p.appendChild(s);s.vectorPaths=[{windingRule:'NONZERO',data:'M 8 0 L 10.2 5.2 L 15.7 5.6 L 11.4 9.3 L 12.8 14.8 L 8 11.8 L 3.2 14.8 L 4.6 9.3 L 0.3 5.6 L 5.8 5.2 Z'}];s.rescale(size/15.7);s.x=x;s.y=y;s.fills=fl(hex);return s;}\n\n// ---------- 06 Product Detail ----------\nconst D=await figma.getNodeByIdAsync('9:7');[...D.children].forEach(c=>c.remove());D.fills=fl(C.white);\nawait use('Status Bar',D,0,0);\nawait use('Header / Back + Subtitle',D,0,44);\nD.appendChild(rect(D,'Product Image',0,140,414,210,{img:'fcd8fb327405d53c3fc305658bf933818e7e25b8',mode:'FIT'}));\nD.appendChild(txt(D,'Name','Natural Red Apple',{size:24,style:'SemiBold',w:300,h:32,y:360}));\nD.appendChild(txt(D,'Unit','1kg, Price',{size:14,color:C.gray,w:200,h:20,y:396}));\nawait use('Quantity Stepper',D,24,430);\nD.appendChild(txt(D,'Price','$4.99',{size:24,style:'SemiBold',w:90,h:32,align:'RIGHT',x:300,y:434}));\nD.appendChild(rect(D,'Divider 1',24,486,366,1,{fill:'#EFEFEF'}));\nD.appendChild(txt(D,'PD Title','Product Detail',{size:18,style:'SemiBold',w:200,h:26,y:502}));\nconst pdCh=useMedia('Icon_Chevron_Right',D,374,510,0.7,C.gray);pdCh.rotation=-90;\nD.appendChild(txt(D,'Description','Apples are nutritious. Apples may be good for weight loss. Apples may be good for your heart. As part of a healthful and varied diet.',{size:13,color:C.gray,w:360,h:96,y:538,lh:22,alignV:'TOP'}));\nD.appendChild(rect(D,'Divider 2',24,664,366,1,{fill:'#EFEFEF'}));\nD.appendChild(txt(D,'Nutritions','Nutri