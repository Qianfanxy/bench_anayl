{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_9e73eedacdf34c85a5372ec6","name":"mcp__figma__use_figma","input":{"code":"\nconst page = await figma.getNodeByIdAsync('8:2');\nawait figma.setCurrentPageAsync(page);\nfor (const s of ['Regular','Medium','Semi Bold','Bold']) await figma.loadFontAsync({family:'Inter',style:s});\nlet mono=false; try{ await figma.loadFontAsync({family:'Roboto Mono',style:'Medium'}); mono=true; }catch(e){}\nfunction hx(h){const n=parseInt(h,16);return{r:((n>>16)&255)/255,g:((n>>8)&255)/255,b:(n&255)/255};}\nfunction solid(h,o=1){return{type:'SOLID',color:hx(h),opacity:o};}\nfunction T(name,chars,style,size,color,o={}){\n  const t=figma.createText(); t.name=name;\n  t.fontName={family:o.fam||'Inter',style}; t.characters=chars; t.fontSize=size;\n  if(o.ls!==undefined)t.letterSpacing={unit:'PERCENT',value:o.ls};\n  if(o.lh)t.lineHeight={unit:'PIXELS',value:o.lh};\n  t.fills=[solid(color,o.op===undefined?1:o.op)];\n  return t;\n}\nconst N=(id)=>figma.getNodeByIdAsync(id);\nconst IC={};\nfor(const [k,id] of Object.entries({back:'6:3',chev:'6:4',close:'6:7',add:'6:6',help:'6:5',plus:'6:8',share:'6:9'})){ IC[k]=await N(id); }\nfunction icon(key,parent,x,y,size,color){\n  const i=IC[key].createInstance(); parent.appendChild(i); i.resize(size,size); i.x=x; i.y=y;\n  if(color){const s=solid(color); for(const v of i.findAll(n=>n.type==='VECTOR')){ try{ if(v.strokes.length)v.strokes=[s]; if(v.fills.length)v.fills=[s]; }catch(e){} }}\n  return i;\n}\nconst out={mono};\n\n// 1. Button / Secondary\nconst bs=figma.createComponent(); bs.name='Button / Secondary'; bs.resize(343,56);\nbs.fills=[solid('EEEDF2')]; bs.cornerRadius=14;\nbs.layoutMode='HORIZONTAL'; bs.primaryAxisAlignItems='CENTER'; bs.counterAxisAlignItems='CENTER';\nbs.primaryAxisSizingMode='FIXED'; bs.counterAxisSizingMode='FIXED';\nbs.appendChild(T('Label','Cancel','Semi Bold',16,'1A1A1F'));\nout.btnSecondary=bs.id;\n\n// 2. Header / Navigation Bar\nconst hd=figma.createComponent(); hd.name='Header / Navigation Bar'; hd.resize(375,56); hd.fills=[];\nfunction circ(parent,x,name){\n  const f=figma.createFrame(); f.name=name; f.resize(40,40); parent.appendChild(f); f.x=x; f.y=8;\n  f.cornerRadius=20; f.fills=[solid('FFFFFF')]; f.strokes=[solid('ECECF1')]; f.strokeWeight=1;\n  f.effects=[{type:'DROP_SHADOW',color:{r:0.1,g:0.1,b:0.12,a:0.08},offset:{x:0,y:4},radius:12,spread:0,visible:true,blendMode:'NORMAL'}];\n  return f;\n}\nconst L=circ(hd,16,'Left Button'); icon('back',L,8,8,24,'1A1A1F').visible=false;\nconst R=circ(hd,319,'Right Button');\nicon('add',R,8,8,24,'1A1A1F').visible=false;\nicon('share',R,8,8,24,'1A1A1F').visible=false;\nicon('close',R,8,8,24,'1A1A1F').visible=false;\nconst ht=T('Title','Wallet','Semi Bold',18,'1A1A1F',{w:375,h:22,align:'CENTER'}); hd.appendChild(ht); ht.x=0; ht.y=17;\nout.header=hd.id;\n\n// 3. Section Header\nconst sh=figma.createComponent(); sh.name='Section Header'; sh.resize(343,24); sh.fills=[];\nconst st=T('Title','Expenses','Semi Bold',18,'1A1A1F'); sh.appendChild(st); st.x=0; st.y=1;\nconst sa=T('Action','See all','Medium',14,'007AFF'); sh.appendChild(sa); sa.x=343-sa.width; sa.y=5; sa.visible=false;\nout.sectionHeader=sh.id;\n\n// 4. Form / Text Field\nconst tf=figma.createComponent(); tf.name='Form / Text Field';\nconst tfl=T('Label','Card holder’s name','Semi Bold',14,'1A1A1F'); tf.appendChild(tfl);\nconst inp=figma.createFrame(); inp.name='Input'; inp.resize(343,48); inp.cornerRadius=10; inp.fills=[solid('F2F2F7')]; tf.appendChild(inp);\nconst tv=T('Value','Name on card','Regular',16,'8E8E93'); inp.appendChild(tv); tv.x=16; tv.y=14;\ntf.resize(343,71);\ntf.layoutMode='VERTICAL'; tf.itemSpacing=6; tf.primaryAxisSizingMode='AUTO'; tf.counterAxisSizingMode='FIXED';\ninp.layoutAlign='STRETCH';\nout.textField=tf.id; out.textFieldInput=inp.id;\n\n// 5. Row / Transaction\nconst tr=figma.createComponent(); tr.name='Row / Transaction'; tr.resize(311,60); tr.fills=[];\nconst tile=figma.createFrame(); tile.name='Tile'; tile.resize(40,40); tr.appendChild(tile); tile.x=0; tile.y=10; tile.cornerRadius=12; tile.fills=[solid('F2F2F7')];\nconst mer={};\nfor(const [k,id,w,h] of [['Apple','5:5',24,18],['Nike','5:9',26,26],['Uber','5:7',28,17]]){\n  const m=(await N(id)).createInstance(); tile.appendChild(m); m.resize(w,h); m.x=(40-w)/2; m.y=(40-h)/2; m.name=k; m.visible=false; mer[k]=m;\n}\nmer.Apple.visible=true;\nconst rt=T('Title','Nike Air Max 2090','Semi Bold',15,'1A1A1F'); tr.appendChild(rt); rt.x=56; rt.y=12;\nconst rd=T('Date','15 Aug 2020','Regular',12,'9A9AA3'); tr.appendChild(rd); rd.x=56; rd.y=34;\nconst ra=T('Amount','−$243.00','Semi Bold',15,'1A1A1F'); tr.appendChild(ra); ra.x=311-ra.width; ra.y=21;\nout.transactionRow=tr.id;\n\n// 6. Fab / New Payment\nconst fb=figma.createComponent(); fb.name='Fab / New Payment'; fb.resize(52,52); fb.cornerRadius=26; fb.fills=[solid('007AFF')];\nfb.effects=[{type:'DROP_SHADOW',color:{r:0,g:0.39,b:0.87,a:0.35},offset:{x:0,y:8},radius:18,spread:0,visible:true,blendMode:'NORMAL'}];\nicon('plus',fb,14,14,24,'FFFFFF');\nout.fab=fb.id;\n\n// arrange\nconst comps=[bs,hd,sh,tf,tr,fb]; let cx=0;\nfor(const c of comps){ c.x=cx; c.y=1200; cx+=c.width+80; }\nreturn JSON.stringify(out);\n","description":"Create base reusable components (buttons, header, section header, text field, transaction row, FAB) in workspace","fileKey":"KGjmNajqa9on8PzOkCc7Tv"}}],"id":"026e933b-4632-4449-b071-07ea8df7cc4f","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"259a9f97-bab6-42ed-a1f7-e48e66488de3","uuid":"5f465eaa-fb1e-4ea2-84da-a6686501b0b9","timestamp":"2026-10-31T22:37:41.179Z","tool_use_meta":[{"id":"call_9e73eedacdf34c85a5372ec6","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
