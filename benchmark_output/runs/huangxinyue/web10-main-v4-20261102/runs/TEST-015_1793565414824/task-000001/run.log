q=p.length===2?[p[0],p[1],p[0],p[1]]:p;f.paddingTop=q[0];f.paddingRight=q[1];f.paddingBottom=q[2];f.paddingLeft=q[3];f.primaryAxisSizingMode='AUTO';f.counterAxisSizingMode='AUTO';if(o.r)f.cornerRadius=o.r;if(o.align)f.counterAxisAlignItems=o.align;if(o.main)f.primaryAxisAlignItems=o.main;f.clipsContent=false;return f;}\nconst af=(n,d,o)=>setup(figma.createFrame(),n,d,o);const comp=(n,d,o)=>setup(figma.createComponent(),n,d,o);\nfunction fixW(f,w){f.resize(w,f.height);if(f.layoutMode==='VERTICAL'){f.counterAxisSizingMode='FIXED';f.primaryAxisSizingMode='AUTO';}else{f.primaryAxisSizingMode='FIXED';f.counterAxisSizingMode='AUTO';}}\nconst ID={hero:'3:21',MH:['3:27','3:35','3:28','3:29','3:30','3:31','3:32'],main:'3:33',bed:'3:6',bath:'3:5',garage:'3:13',floors:'3:12',cal:'3:7'};\nasync function inst(id){const c=await figma.getNodeByIdAsync(id);return c.createInstance();}\nconst board=await figma.getNodeByIdAsync('9:2');\nasync function section(title,note){const s=af('Section · '+title,'VERTICAL',{gap:16});s.appendChild(await txt(title,'H3','ink'));if(note)s.appendChild(await txt(note,'Small','ink5',{w:1200}));board.appendChild(s);return s;}\nconst btnSet=await figma.getNodeByIdAsync('9:37');const btnP=btnSet.children.find(c=>c.name==='Style=Primary, State=Default');\nconst fSet=await figma.getNodeByIdAsync('9:95');const fD=fSet.children.find(c=>c.name==='State=Default');\nconst clSet=await figma.getNodeByIdAsync('11:91');const clF=clSet.children.find(c=>c.name==='Current=false');const clT=clSet.children.find(c=>c.name==='Current=true');\nconst thSet=await figma.getNodeByIdAsync('11:101');const thD=thSet.children.find(c=>c.name==='State=Default');\nconst fi=await figma.getNodeByIdAsync('11:102');const di=await figma.getNodeByIdAsync('11:110');\nconst setP=(i,name,val)=>{const k=Object.keys(i.componentProperties).find(k=>k.split('#')[0]===name);i.setProperties({[k]:val});};\nfunction setBtn(i,label){i.findOne(n=>n.type==='TEXT').characters=label;}\nconst R={};\n\n// Hero