{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_e03c2896e2614c47a8f30659","name":"mcp__figma__use_figma","input":{"code":"for (const s of [\"Regular\",\"Medium\",\"SemiBold\",\"Bold\"]) await figma.loadFontAsync({family:\"Poppins\",style:s});\nfunction hex(h,o){const n=parseInt(h,16);return {type:\"SOLID\",color:{r:((n>>16)&255)/255,g:((n>>8)&255)/255,b:(n&255)/255},opacity:o===undefined?1:o};}\nfunction txt(chars,style,size,colorHex,opts={}){const t=figma.createText();t.fontName={family:\"Poppins\",style};t.characters=chars;t.fontSize=size;t.fills=[hex(colorHex)];if(opts.ls!==undefined)t.letterSpacing={unit:\"PIXELS\",value:opts.ls};if(opts.lh)t.lineHeight={unit:\"PIXELS\",value:opts.lh};if(opts.deco)t.textDecoration=opts.deco;if(opts.w){t.textAutoResize=\"HEIGHT\";t.resize(opts.w,t.height);}if(opts.align)t.textAlignHorizontal=opts.align;return t;}\nfunction autolayout(name,dir,gap,pT,pR,pB,pL,parent){const f=figma.createFrame();f.name=name;f.layoutMode=dir;f.itemSpacing=gap;f.paddingTop=pT;f.paddingRight=pR;f.paddingBottom=pB;f.paddingLeft=pL;f.primaryAxisSizingMode=\"AUTO\";f.counterAxisSizingMode=\"AUTO\";f.fills=[];if(parent)parent.appendChild(f);return f;}\nfunction frame(name,w,h,parent,x,y){const f=figma.createFrame();f.name=name;if(w)f.resize(w,h);if(parent)parent.appendChild(f);if(x!==undefined)f.x=x;if(y!==undefined)f.y=y;return f;}\nasync function comp(id){return (await figma.getNodeByIdAsync(id)).createInstance();}\nasync function icon(id,size,colorHex,parent,name){const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();i.resize(size,size*(c.height/c.width));i.name=name;if(colorHex){for(const d of i.findAll(n=>[\"VECTOR\",\"BOOLEAN_OPERATION\",\"TEXT\",\"RECTANGLE\"].includes(n.type))){if(\"fills\" in d){try{d.fills=[hex(colorHex)];}catch(e){}}}}if(parent)parent.appendChild(i);return i;}\n\nconst ws = await figma.getNodeByIdAsync(\"15:2\");\nfor (const c of [...ws.children]) if (c.name===\"07_Checkout\") c.remove();\n\nconst F = figma.createFrame();\nF.name=\"07_Checkout\"; F.layoutMode=\"VERTICAL\"; F.itemSpacing=0; F.resize(1440,1000);\nF.primaryAxisSizingMode=\"AUTO\"; F.counterAxisSizingMode=\"FIXED\"; F.fills=[hex(\"FFFFFF\")];\nws.appendChild(F); F.x=0; F.y=8200;\n\nconst hd = await comp(\"19:4\"); F.appendChild(hd);\nconst bn = await comp(\"20:29\"); F.appendChild(bn);\nbn.findOne(n=>n.name===\"Title\").characters=\"Checkout\";\nbn.findOne(n=>n.name===\"CrumbPage\").characters=\"Checkout\";\n\nconst main = autolayout(\"CheckoutMain\",\"HORIZONTAL\",60,60,100,80,100,F);\nmain.resize(1440,10); main.primaryAxisSizingMode=\"FIXED\"; main.counterAxisSizingMode=\"AUTO\";\n\nasync function tf(parent,label,ph,w){\n  const inst = await comp(\"1:26\");\n  inst.findOne(n=>n.name===\"Label\").characters=label;\n  inst.findOne(n=>n.name===\"Placeholder\").characters=ph;\n  parent.appendChild(inst); inst.resize(w,111);\n  return inst;\n}\nasync function select(parent,label,val){\n  const wrap = frame(\"SelectField\",740,111,parent); wrap.fills=[];\n  const inst = await tf(wrap,label,val,740);\n  inst.x=0; inst.y=0;\n  const ch = await icon(\"13:30\",20,\"000000\",wrap,\"Icon_Chevron_Down\");\n  ch.x=700; ch.y=62;\n  return wrap;\n}\n\nconst left = autolayout(\"BillingDetails\",\"VERTICAL\",40,0,0,0,0,main);\nleft.resize(740,10); left.counterAxisSizingMode=\"FIXED\"; left.primaryAxisSizingMode=\"AUTO\";\nleft.appendChild(txt(\"Billing Details\",\"SemiBold\",36,\"000000\"));\n\nconst rowFL = autolayout(\"RowName\",\"HORIZONTAL\",40,0,0,0,0,left);\nawait tf(rowFL,\"First Name\",\"First Name\",350);\nawait tf(rowFL,\"Last Name\",\"Last Name\",350);\nawait tf(left,\"Company Name (Optional)\",\"Company Name (Optional)\",740);\nawait select(left,\"Country / Region\",\"Sri Lanka\");\nawait tf(left,\"Street address\",\"Street address\",740);\nawait tf(left,\"Town / City\",\"Town / City\",740);\nawait select(left,\"Province\",\"Western Province\");\nconst rowZP = autolayout(\"RowZipPhone\",\"HORIZONTAL\",40,0,0,0,0,left);\nawait tf(rowZP,\"ZIP code\",\"ZIP code\",350);\nawait tf(rowZP,\"Phone\",\"Phone\",350);\nawait tf(left,\"Email address\",\"Email address\",740);\n\nconst addWrap = autolayout(\"AdditionalInfo\",\"VERTICAL\",10,0,0,0,0,left);\naddWrap.appendChild(txt(\"Additional information\",\"Medium\",16,\"000000\"));\nconst addBox = frame(\"Input\",740,160,addWrap);\naddBox.fills=[hex(\"FFFFFF\")]; addBox.strokes=[hex(\"9F9F9F\")]; addBox.strokeWeight=1; addBox.cornerRadius=10;\n\nconst pay = autolayout(\"Payment\",\"VERTICAL\",20,0,0,0,0,left);\npay.appendChild(txt(\"Payment\",\"SemiBold\",24,\"000000\"));\nfunction radio(parent,label,selected){\n  const row = autolayout(\"PaymentOption\",\"HORIZONTAL\",15,0,0,0,0,parent);\n  row.counterAxisAlignItems=\"CENTER\";\n  const c = frame(\"Radio\",20,20,row); c.cornerRadius=10; c.fills=[hex(\"FFFFFF\")]; c.strokes=[hex(\"000000\")]; c.strokeWeight=1;\n  if(selected){const d=frame(\"Dot\",10,10,c); d.cornerRadius=5; d.fills=[hex(\"B88E2F\")]; d.x=5; d.y=5;}\n  row.appendChild(txt(label,\"SemiBold\",16,\"000000\"));\n  return row;\n}\nradio(pay,\"Direct Bank Transfer\",true);\nconst bankNote = autolayout(\"BankNote\",\"VERTICAL\",0,0,0,0,35,pay);\nbankNote.appendChild(txt(\"Make your payment directly into our bank account. Please use your Order ID as the payment reference. Your order will not be shipped until the funds have cleared in our account.\",\"Regular\",14,\"898989\",{w:700,lh:22}));\nradio(pay,\"Cash On Delivery\",false);\n\nconst privacy = txt(\"Your personal data will be used to support your experience throughout this website, to manage access to your account, and for other purposes described in our privacy policy.\",\"Regular\",14,\"000000\",{w:740,lh:24});\nleft.appendChild(privacy);\nconst idx = privacy.characters.indexOf(\"privacy policy\");\nprivacy.setRangeTextDecoration(idx,idx+14,\"UNDERLINE\");\n\nconst pob = await comp(\"1:23\"); pob.name=\"BtnPlaceOrder\";\npob.findOne(n=>n.type===\"TEXT\").characters=\"Place order\";\nleft.appendChild(pob); pob.resize(200,56);\n\nconst right = autolayout(\"OrderSummary\",\"VERTICAL\",0,0,0,0,0,main);\nright.resize(440,10); right.counterAxisSizingMode=\"FIXED\"; right.primaryAxisSizingMode=\"AUTO\";\nconst osHead = autolayout(\"SummaryHead\",\"HORIZONTAL\",0,0,0,20,0,right);\nosHead.resize(440,10); osHead.primaryAxisSizingMode=\"FIXED\"; osHead.counterAxisSizingMode=\"AUTO\";\nosHead.primaryAxisAlignItems=\"SPACE_BETWEEN\";\nosHead.appendChild(txt(\"Product\",\"SemiBold\",20,\"000000\"));\nosHead.appendChild(txt(\"Subtotal\",\"SemiBold\",20,\"000000\"));\nconst osDv = frame(\"Divider\",440,1,right); osDv.fills=[hex(\"E5E5E5\")];\nconst osItem = autolayout(\"SummaryItem\",\"HORIZONTAL\",0,25,0,25,0,right);\nosItem.resize(440,10); osItem.primaryAxisSizingMode=\"FIXED\"; osItem.counterAxisSizingMode=\"AUTO\";\nosItem.primaryAxisAlignItems=\"SPACE_BETWEEN\";\nosItem.appendChild(txt(\"Asgaard sofa ×  1\",\"Regular\",16,\"000000\"));\nosItem.appendChild(txt(\"Rs. 250,000.00\",\"Regular\",16,\"B0B0B0\"));\nconst osSub = autolayout(\"SummarySubtotal\",\"HORIZONTAL\",0,0,0,15,0,right);\nosSub.resize(440,10); osSub.primaryAxisSizingMode=\"FIXED\"; osSub.counterAxisSizingMode=\"AUTO\";\nosSub.primaryAxisAlignItems=\"SPACE_BETWEEN\";\nosSub.appendChild(txt(\"Subtotal\",\"Regular\",16,\"000000\"));\nosSub.appendChild(txt(\"Rs. 250,000.00\",\"Regular\",16,\"B0B0B0\"));\nconst osTot = autolayout(\"SummaryTotal\",\"HORIZONTAL\",0,0,0,0,0,right);\nosTot.resize(440,10); osTot.primaryAxisSizingMode=\"FIXED\"; osTot.counterAxisSizingMode=\"AUTO\";\nosTot.primaryAxisAlignItems=\"SPACE_BETWEEN\";\nosTot.appendChild(txt(\"Total\",\"SemiBold\",16,\"000000\"));\nosTot.appendChild(txt(\"Rs. 250,000.00\",\"SemiBold\",20,\"B88E2F\"));\n\nconst strip = await comp(\"20:4\"); F.appendChild(strip);\nconst ft = await comp(\"19:22\"); F.appendChild(ft);\n\nreturn JSON.stringify({id:F.id,h:Math.round(F.height),leftH:Math.round(left.height),rightH:Math.round(right.height)});","description":"Build 07_Checkout frame: header, Checkout banner, billing details form with 10 fields and selects, payment radios, privacy note, Place order button, order summary card, strip, footer","fileKey":"iREO0ZncSJq5Rg5HF95nYG"}}],"id":"2e081288-6c85-4519-a4a7-46306e4d5d8d","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"92572047-04a5-47e6-987f-f20b31e0f66f","uuid":"d4866fb1-430d-46ca-b5ff-de95c92e123c","timestamp":"2026-11-01T20:05:33.358Z","tool_use_meta":[{"id":"call_e03c2896e2614c47a8f30659","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
