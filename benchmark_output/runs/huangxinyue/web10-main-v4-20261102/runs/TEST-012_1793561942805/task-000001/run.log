tion photoBox(name,photo,w,h,r,parent){const f=F(name,'HORIZONTAL',{w,h,r,clip:true,parent});const p=I(photo,w,h,f);p.layoutSizingHorizontal='FILL';p.layoutSizingVertical='FILL';p.name='Photo';return f;}\nconst shadow=[{type:'DROP_SHADOW',color:{r:0,g:0,b:0,a:0.08},offset:{x:0,y:12},radius:32,spread:0,visible:true,blendMode:'NORMAL'}];\nconst board=await figma.getNodeByIdAsync('10:32');\nconst out={};\n// Checkbox\nconst cb=[];\nfor(const on of ['false','true']){const c=comp('Checked='+on,'HORIZONTAL',{w:28,h:28,r:999,main:'CENTER',cross:'CENTER',fill:on==='true'?'brand/ink':'surface/white'}); if(on==='false'){c.strokes=[paint('border/default')];c.strokeWeight=2;} else icon('Icon_Check','text/inverse',18,c).name='Check'; cb.push(c);}\nconst cbs=figma.combineAsVariants(cb,board); cbs.name='Checkbox'; setStyle(cbs); out.cbs=cbs.id;\n// Ingredient item\nconst ii=[];\nfor(const on of ['false','true']){const c=comp('Checked='+on,'HORIZONTAL',{w:840,p:[0,0,28,0],gap:20,cross:'CENTER'}); c.strokes=[paint('border/divider')]; c.strokeTopWeight=0;c.strokeLeftWeight=0;c.strokeRightWeight=0;c.strokeBottomWeight=1;\n const b=cb[on==='true'?1:0].createInstance(); c.appendChild(b); b.name='Checkbox';\n const t=await T('2 cups cooked jasmine rice, chilled overnight','Body L',on==='true'?'text/muted':'text/primary',{parent:c,fillW:true,name:'Label'}); t.fontSize=18; if(on==='true')t.textDecoration='STRIKETHROUGH'; ii.push(c);}\nconst iis=figma.combineAsVariants(ii,board); iis.name='Ingredient Item'; setStyle(iis); iis.layoutMode='VERTICAL'; out.iis=iis.id;\n// Direction step\nconst ds=comp('Direction Step','HORIZONTAL',{w:840,gap:20,p:[0,0,40,0]}); board.appendChild(ds); ds.strokes=[paint('border/divider')]; ds.strokeTopWeight=0;ds.strokeLeftWeight=0;ds.strokeRightWeight=0;ds.strokeBottomWeight=1;\nconst dcb=cb[0].createInstance(); ds.appendChild(dcb); dcb.name='Checkbox';\nconst dcol=F('Content','VERTICAL',{gap:20,parent:ds,fillW:true});\nconst th=F('Heading','HORIZONTAL',{gap:12,parent:dcol}); await T('1.','H3','text/primary',{parent:th,name:'Number'}); await T('Prepare the ingredients','H3','text/primary',{parent:th,name:'Title'});\nawait T('Cut the asparagus, slice the spring onions and beat the eggs. Mix the soy sauce, sesame oil and mirin in a small bowl.','Body L','text/secondary',{parent:dcol,fillW:true,name:'Text'});\nconst sph=photoBox('Step Photo','Photo_Cooking_Step',792,420,24,dcol); sph.layoutSizingHorizontal='FILL';\nawait T('Day-old rice works best: it is drier, so the grains fry separately instead of turning mushy. Break up any clumps before you start.','Body L','text/secondary',{parent:dcol,fillW:true,name:'Note'});\nout.ds=ds.id;\n// Sidebar recipe item\nconst si=comp('Sidebar Recipe Item','HORIZONTAL',{w:400,gap:20,cross:'CENTER'}); board.appendChild(si);\nphotoBox('Thumb','Photo_Chicken_Meatballs',140,110,16,si);\nconst scol=F('Text','VERTICAL',{gap:8,parent:si,fillW:true}); await T('Chicken Meatballs with Cream Cheese','Title','text/primary',{parent:scol,fillW:true,name:'Title'}); await T('By Andreas Paula','Body','text/muted',{parent:scol,name:'Author'});\nout.si=si.id;\n// Author\nconst au=comp('Author','HORIZONTAL',{gap:14,cross:'CENTER'}); board.appendChild(au);\nconst aav=I('Avatar_John_Smith',48,48,au); aav.cornerRadius=999; aav.name='Avatar';\nconst acol=F('Text','VERTICAL',{gap:2,parent:au}); await T('John Smith','Body Strong','text/primary',{parent:acol,name:'Name'}); await T('15 March 2022','Body','text/muted',{parent:acol,name:'Date'});\nout.au=au.id;\n// Meta stat\nconst ms=comp('Meta Stat','HORIZONTAL',{gap:12,cross:'CENTER'}); board.appendChild(ms); icon('Icon_Timer','text/primary',24,ms).name='Icon';\nconst mcol=F('Text','VERTICAL',{gap:2,parent:ms}); await T('PREP TIME','Caps','text/muted',{parent:mcol,name:'Label'}); await T('15 Minutes','Label','text/primary',{parent:mcol,name:'Value'});\nout.ms=ms.id;\n// Article item\nconst ai=comp('Article Item','HORIZONTAL',{w:840,gap:40,cross:'CENTER'}); board.appen