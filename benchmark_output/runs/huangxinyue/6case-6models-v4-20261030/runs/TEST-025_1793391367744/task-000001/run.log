isit pill\nfor(const ch of f9.children){\n  if(ch.type===\"TEXT\"&&ch.characters===\"Flat and Heels\"){ch.y=884;}\n  if(ch.type===\"TEXT\"&&ch.characters===\"Stand a chance to get rewarded\"){ch.y=904;}\n}\n// Sponsored header: 375-wide component -> clamp to 335 and pull right label in\nlet hdrFixed=0;\nfor(const ch of f9.children){\n  if(ch.type===\"INSTANCE\"){\n    const t=ch.findOne(n=>n.type===\"TEXT\"&&n.characters===\"Sponsored\");\n    if(t){ ch.resize(335,32); const lbl=ch.findOne(n=>n.name===\"View all\"); if(lbl){lbl.x=335-20-lbl.width; hdrFixed++;} }\n  }\n}\n// rebuild mini rows\nconst miniC=await M(\"10:34\");\nconst searchI=await M(\"4:49\");\nfunction buildMini(row,data,x,scale){\n  const c=miniC.createInstance();\n  row.appendChild(c);\n  const ts=c.findAll(n=>n.type===\"TEXT\");\n  const nm=ts[0];\n  nm.textAutoResize=\"HEIGHT\";\n  nm.characters=data.name;\n  const pr=c.findOne(n=>n.name===\"Price\");\n  const pts=pr.findAll(n=>n.type===\"TEXT\");\n  pts[0].characters=data.price; pts[1].characters=data.was; pts[2].characters=data.off;\n  const rt=c.findOne(n=>n.name===\"Rating\");\n  const ct=rt.findOne(n=>n.type===\"TEXT\"); if(ct) ct.characters=data.count;\n  if(data.photo){const inner=c.findOne(n=>n.type===\"INSTANCE\"); inner.swapComponent(data.photo);}\n  else { grayOut(c); const ic=searchI.createInstance(); row.appendChild(ic); tint(ic,\"#8F959E\"); ic.resize(32,32); ic.x=x+24; ic.y=24; }\n  c.rescale(scale);\n  nm.resize(c.width, nm.height);\n  pr.resize(c.width, pr.height);\n  try{c.primaryAxisSizingMode=\"AUTO\";}catch(e){}\n  c.x=x; c.y=0;\n  return c;\n}\nconst dr=FR(\"Deal Row\",335,205,null,true); f9.appendChild(dr); dr.x=20; dr.y=478;\nconst dealData=[\n {photo:await M(\"3:116\"),name:\"Women Printed Kurta\",price:\"₹1,500\",was:\"₹2,499\",off:\"40% Off\",count:\"56,890\"},\n {photo:await M(\"3:119\"),name:\"HRX by Hrithik Roshan\",price:\"₹2,499\",was:\"₹4,999\",off:\"50% Off\",count:\"3,44,567\"},\n {photo:null,name:\"Philips BHH88