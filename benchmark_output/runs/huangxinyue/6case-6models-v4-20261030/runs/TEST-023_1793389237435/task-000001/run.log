s.name) t.name=opts.name;\n  if(opts.ls) t.letterSpacing={unit:'PIXELS', value:opts.ls};\n  return t;\n}\nfunction R(parent,x,y,w,h,hex,r=0,opts={}){\n  const rc=figma.createRectangle(); rc.resize(w,h); rc.x=x; rc.y=y;\n  rc.fills = hex? [S(hex, opts.op??1)] : [];\n  if(r) rc.cornerRadius=r; parent.appendChild(rc); if(opts.name) rc.name=opts.name;\n  return rc;\n}\nfunction F(parent,x,y,w,h,hex,r=0,opts={}){\n  const f=figma.createFrame(); f.resize(w,h); f.x=x; f.y=y; f.fills= hex?[S(hex,opts.op??1)]:[];\n  f.cornerRadius=r; if(opts.stroke){f.strokes=[S(opts.stroke)]; f.strokeWeight=opts.sw||1;}\n  f.clipsContent=false; parent.appendChild(f); if(opts.name) f.name=opts.name;\n  return f;\n}\nfunction V(parent, pts, hex, x, y, w=2){\n  const v=figma.createVector();\n  const d=pts.map((p,i)=>`${i?'L':'M'} ${p[0]} ${p[1]}`).join(' ');\n  v.vectorPaths=[{windingRule:'NONE', data:d}];\n  v.strokes=[S(hex)]; v.strokeWeight=w; v.strokeCap='ROUND'; v.strokeJoin='ROUND'; v.fills=[];\n  parent.appendChild(v); v.x=x; v.y=y; return v;\n}\nfunction sparkPts(seed, up, n=7){ // deterministic wiggle\n  const pts=[]; for(let i=0;i<n;i++){ const t=i/(n-1);\n    const w=Math.sin(seed*13.7+i*2.9)*0.18;\n    const base= up? t : 1-t;\n    pts.push([t*100, (1 - Math.min(1,Math.max(0, base + w*(i>0&&i<n-1?1:0.3))))*100]);\n  } return pts;\n}\n```\n\nHmm wait, sparkline vectors: coordinates in path space then v.x/v.y position; size = path bbox (100×100 here), then resize to w×h? After vectorPaths set, node size = 100×100. v.resize(w,h) scales the geometry? Resizing a vector scales its geometry — yes, resize on VectorNode scales the vector network. So: create with 0..100 coords, then v.resize(w,h).\n\nFor the tint helper:\n```js\nfunction tint(node, hex){\n  for(const c of node.findAll(()=>true)){ if('fills' in c && Array.isArray(c.fills) && c.fills.some(f=>f.type==='SOLID')) c.fills=[S(hex)]; }\n  if('fills' in node && Array.isArray(node.fills) && node.fills.some(f=>f.type==='SOLID')) node.fills=[S(hex)];\n}\n```\nCareful: this would tint logo multi-color fills. Use only where intended (splash white-ification, tab icons gray/brand).\n\nNow components. Given Button/TextField by ID:\n```js\nconst btnC = await figma.getNodeByIdAsync('4:168');\nconst tfC = await figma.getNodeByIdAsync('4:174');\nconst sbC = await figma.getNodeByIdAsync('4:180');\nconst hiC = await figma.getNodeByIdAsync('4:191');\nconst media = {}; for (const [k,id] of Object.entries({sym:'3:92', word:'3:95', adobe:'3:101', amazon:'3:104', apple:'3:107', bofa:'3:110', fb:'3:113', nflx:'3:116', avatar:'3:122', phone:'3:125', hand:'3:134', pay:'3:140', eye:'3:143', card:'3:146', home:'3:149', market:'3:152', notif:'3:155', port:'3:158', profile:'3:161', trade:'3:164'})) media[k]=await figma.getNodeByIdAsync(id);\n```\n\nMy components (all on page 5:2, offset far right x=2200+):\n\n1. **btnSecondary** \"Button Secondary\": 327×52 white, radius 12, stroke border; text label brand 16 SemiBold centered — with component property \"Label\"? Component properties viaaddComponentProperty: comp.addComponentProperty('Label','TEXT_SWAP','Sign in'). Text child named \"Label\".\n\n2. **backBtn** \"Back Button\": 40×40 circle white stroke border; chevron: vector M 14 10 L 8 20 L 14 30? Coordinates: within 40×40: path M 16 12 L 10 20 L 16 28.\n\n3. **secHdr** \"Section Header\" variants:\n   - \"Mode=Plain\": 327×24 frame? Components as frames: figma.createComponent() then resize. Title text child name \"Title\" 17 Semi Bold.\n   - \"Mode=Add\": plus button: circle 24 brand-tint with \"+\" brand.\n   combineAsVariants([c1,c2], page) → name \"Section Header\".\n\n4. **stockRow** variants (Property \"Stock\"): NFLX, AAPL, FB, BAC, F, AMZN, ADBE. Each 327×56 white radius 14, children:\n   - logo slot frame \"Logo\" 36×36 at (12,10), bg tint, radius 18? circle-ish radius 10. Logo instance inside rescaled h=26 centered.\n   - ticker \"Ticker\" 15 Semi Bold at (60,9)\n   - company \"Company\" 12 Regular t2 at (60