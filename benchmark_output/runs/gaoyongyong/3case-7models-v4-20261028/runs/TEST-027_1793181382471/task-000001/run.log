Radius;\n  return r;\n}\n\nconst page = await figma.getNodeByIdAsync(\"2004:2\");\nconst statusBar = await figma.getNodeByIdAsync(\"48:43\");\nconst homeInd = await figma.getNodeByIdAsync(\"48:54\");\nconst iconBack = await figma.getNodeByIdAsync(\"6:275\");\n\n// 06_Notification\nconst notif = figma.createFrame();\nnotif.name = \"06_Notification\";\nnotif.resize(414, 932);\nnotif.fills = [{ type: \"SOLID\", color: C.white }];\nnotif.x = 1028;\nnotif.y = 1032;\nnotif.clipsContent = true;\n\n// Status bar\nconst sb = statusBar.createInstance();\nsb.x = 0; sb.y = 0;\nnotif.appendChild(sb);\n\n// Home indicator\nconst hi = homeInd.createInstance();\nhi.x = 0; hi.y = 932 - 34;\nnotif.appendChild(hi);\n\n// Back button\nconst backBtn = figma.createFrame();\nbackBtn.name = \"Back\";\nbackBtn.resize(40, 40);\nbackBtn.cornerRadius = 12;\nbackBtn.fills = [{ type: \"SOLID\", color: C.bg }];\nbackBtn.x = 24; backBtn.y = 60;\nnotif.appendChild(backBtn);\n\nconst backIcon = iconBack.createInstance();\nbackIcon.x = 16; backIcon.y = 13;\nbackBtn.appendChild(backIcon);\n\n// Title\nconst notifTitle = txt(\"Notification\", \"DM Sans\", \"Bold\", 22, C.textPrimary);\nnotifTitle.x = 24; notifTitle.y = 120;\nnotif.appendChild(notifTitle);\n\n// Notifications\nconst notifications = [\n  { msg: \"Where do you see yourself in the next ages?\", time: \"30 secs ago\", img: IMG.notifNextAges },\n  { msg: \"Check out today's best investor. You'll learn from him.\", time: \"3 min ago\", img: null },\n  { msg: \"Apple stocks just increased. Check it out now.\", time: \"15 min ago\", img: IMG.notifApple },\n];\n\nnotifications.forEach((n, i) => {\n  const y = 170 + i * 88;\n\n  // Thumbnail\n  if (n.img) {\n    const thumb = imageRect(n.img, 64, 64, \"CROP\");\n    thumb.x = 24; thumb.y = y;\n    thumb.cornerRadius = 12;\n    notif.appendChild(thumb);\n  } else {\n    // Avatar fallback for \"best investor\"\n    const fallback = rect(64, 64, C.primaryLight, 12);\n    fallback.x = 24; fallback.y = y;\n    notif.appendChild(fallback);\n    const personTxt = txt(\"👤\", \"Inter\", \"Regular\", 28, C.textPrimary);\n    personTxt.x = 24 + 18; personTxt.y = y + 16;\n    notif.appendChild(personTxt);\n  }\n\n  // Message\n  const msgText = txt(n.msg, \"Inter\", \"Regular\", 14, C.textPrimary);\n  msgText.x = 100; msgText.y = y + 4;\n  msgText.textAutoResize = \"HEIGHT\";\n  msgText.resize(290, msgText.height);\n  msgText.lineHeight = { value: 22, unit: \"PIXELS\" };\n  msgText.maxLines = 2;\n  msgText.textTruncation = \"ENDING\";\n  notif.appendChild(msgText);\n\n  // Time\n  const timeText = txt(n.time, \"Inter\", \"Regular\", 12, C.textTertiary);\n  timeText.x = 100; timeText.y = y + 52;\n  notif.appendChild(timeText);\n\n  // Divider\n  if (i < 2) {\n    const div = rect(366, 1, C.divider, 0);\n    div.x = 24; div.y = y + 76;\n    notif.appendChild(div);\n  }\n});\n\npage.appendChild(notif);\nreturn \"06_Notification created: \" + notif.id;\n","description":"Create 06_Notification screen","fileKey":"BxIMHhCjiRBVph4Aa3oNRO"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"3394a1fc-48e8-404f-9f28-7846423ba2bb","uuid":"1a63c45f-468a-47fe-bb57-f39fb8f16c33","timestamp":"2026-10-28T10:14:28.213Z","tool_use_meta":[{"id":"mcp__figma__use_figma_27_a702f986","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
