27,b:.25},gold:{r:.96,g:.65,b:.14},white:{r:1,g:1,b:1}};\nconst solid=(c,a=1)=>({type:'SOLID',color:c,opacity:a});\nfunction rect(w,h,fill,r=0){const n=figma.createRectangle();n.resize(w,h);if(fill)n.fills=[fill];if(r)n.cornerRadius=r;return n;}\nfunction txt(s,{f='Poppins',st='Regular',sz=16,c=C.text,lh,ls,align}={}){const t=figma.createText();t.fontName={family:f,style:st};t.characters=s;t.fontSize=sz;t.fills=[solid(c)];if(lh)t.lineHeight={value:lh,unit:'PIXELS'};if(ls)t.letterSpacing={value:ls,unit:'PIXELS'};if(align)t.textAlignHorizontal=align;return t;}\nfunction frame(name,w,h){const f=figma.createFrame();f.name=name;f.resize(w,h);f.fills=[];return f;}\nasync function inst(id){const c=await figma.getNodeByIdAsync(id);return c.createInstance();}\nfunction recolor(node,color){for(const n of node.findAll(x=>'fills'in x&&x.type!=='TEXT')){try{n.fills=[solid(color)]}catch(e){}}node.fills&&node.type!=='INSTANCE'?0:0;}\n```\nCareful: recolor should skip image fills. Photo components contain image fills — don't recolor those. Only recolor icons. I'll pass only icon instances. But icon vectors may use fills of type SOLID; check `n.fills[0].type==='SOLID'` before overriding to avoid nuking images accidentally:\n```js\nfunction tint(node,color){for(const n of node.findAll(x=>x.type==='VECTOR'||x.type==='BOOLEAN_OPERATION'||x.type==='STAR'||x.type==='ELLIPSE'||x.type==='POLYGON'||x.type==='LINE'||x.type==='RECTANGLE')){const f=n.fills;if(Array.isArray(f)&&f.length&&f[0].type==='SOLID')n.fills=[solid(color)];}}\n```\n\nAuto-layout usage: I'll mostly use absolute positioning with computed y offsets for reliability, since auto-layout via API is verbose. For long pages, manual y stacking with variables is fine and precise. I'll track a cursor `y` and section heights.\n\nGiven the amount of content, precise manual layout is actually easier to control and debug. Let me define per-page build with cursor.\n\nNow think about which masters to build as components (placed in a compon