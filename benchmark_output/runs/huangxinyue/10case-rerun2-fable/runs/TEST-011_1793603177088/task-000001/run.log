fills.length)n.fills=n.fills.map(f=>f.type==='SOLID'?solid(color,f.opacity):f);if('strokes' in n&&n.strokes&&n.strokes.length)n.strokes=n.strokes.map(s=>s.type==='SOLID'?solid(color,s.opacity):s);if('children' in n)n.children.forEach(paint);};paint(i);return i;}\nfunction scr(name,x,y){const f=figma.createFrame();f.name=name;f.resize(393,852);f.x=x;f.y=y;f.fills=[solid(C.white)];f.clipsContent=true;P.appendChild(f);return f;}\nfunction box(n,name,x,y,w,h,o){o=o||{};const f=figma.createFrame();f.name=name;f.x=x;f.y=y;f.resize(w,h);f.fills=o.fill?[solid(o.fill,o.op)]:[];if(o.r)f.cornerRadius=o.r;if(o.stroke){f.strokes=[solid(o.stroke)];f.strokeWeight=o.sw||1;f.strokeAlign='INSIDE';}if(o.clip!==undefined)f.clipsContent=o.clip;if(o.shadow)f.effects=o.shadow;n.appendChild(f);return f;}\nfunction pic(n,name,x,y,w,h,hash,r){const f=figma.createFrame();f.name=name;f.x=x;f.y=y;f.resize(w,h);if(r)f.cornerRadius=r;f.fills=[{type:'IMAGE',imageHash:hash,scaleMode:'FILL'}];n.appendChild(f);return f;}\nfunction inst(n,comp,x,y,w,h,name){const i=comps[comp].createInstance();i.name=name||comp;i.x=x;i.y=y;if(w)i.resize(w,h||i.height);n.appendChild(i);return i;}\nconst s3=scr('03_Explore',0,940);\nbox(s3,'BG',0,0,393,852,{fill:'#FFFFFF'});\ninst(s3,'Type=Explore',0,44);\n// stories: 2 rows of 5/4\nconst stories=box(s3,'Stories',0,102,393,176,{fill:null});\nstories.layoutMode='VERTICAL';stories.primaryAxisSizingMode='FIXED';stories.counterAxisSizingMode='FIXED';stories.paddingLeft=12;stories.paddingRight=12;stories.itemSpacing=8;\nasync function storyRow(list){const r=box(stories,'Row',0,0,369,84,{fill:null});r.layoutMode='HORIZONTAL';r.primaryAxisSizingMode='FIXED';r.counterAxisSizingMode='FIXED';r.itemSpacing=0;r.primaryAxisAlignItems='SPACE_BETWEEN';\n  for(const s of list){const c=box(r,'Story/'+s[0],0,0,66,84,{fill:null});c.layoutMode='VERTICAL';c.primaryAxisAlignItems='CENTER';c.counterAxisAlignItems='CENTER';c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';c.itemS