st titleTxt = figma.createText();\n    titleTxt.fontName = { family: \"Poppins\", style: \"Semi Bold\" };\n    titleTxt.fontSize = 18;\n    titleTxt.characters = item.title;\n    titleTxt.fills = [{ type: 'SOLID', color: TEXT_DARK }];\n    titleTxt.x = 45;\n    titleTxt.y = 15;\n    row.appendChild(titleTxt);\n\n    const chevronIcon = findMediaNode(\"Icon_Chevron_Right\");\n    if (chevronIcon) {\n      const c = chevronIcon.clone();\n      c.x = 345;\n      c.y = 18;\n      row.appendChild(c);\n    }\n\n    const line = figma.createLine();\n    line.x = 0;\n    line.y = 54;\n    line.resize(364, 0);\n    line.strokes = [{ type: 'SOLID', color: BORDER_COLOR }];\n    row.appendChild(line);\n\n    f12.appendChild(row);\n    curY12 += 55;\n  });\n\n  // Action Button: \"Log Out\" (Secondary/Gray button with logout icon)\n  const logoutBtn = figma.createFrame();\n  logoutBtn.name = \"LogOutBtn\";\n  logoutBtn.resize(364, 67);\n  logoutBtn.cornerRadius = 19;\n  logoutBtn.x = 25;\n  logoutBtn.y = 620;\n  logoutBtn.fills = [{ type: 'SOLID', color: BG_GRAY }];\n\n  const logoutTxt = figma.createText();\n  logoutTxt.fontName = { family: \"Poppins\", style: \"Semi Bold\" };\n  logoutTxt.fontSize = 18;\n  logoutTxt.characters = \"Log Out\";\n  logoutTxt.fills = [{ type: 'SOLID', color: PRIMARY }];\n  logoutTxt.textAlignHorizontal = \"CENTER\";\n  logoutTxt.textAlignVertical = \"CENTER\";\n  logoutTxt.resize(364, 67);\n  logoutTxt.x = 0;\n  logoutTxt.y = 0;\n  logoutBtn.appendChild(logoutTxt);\n\n  f12.appendChild(logoutBtn);\n\n  // TabBar Account\n  const compSection = workspace.findOne(n => n.name === \"Reusable Components\");\n  const tabBarAccountMaster = compSection.findOne(n => n.name === \"TabBar_Account\");\n  if (tabBarAccountMaster) {\n    const tb = tabBarAccountMaster.createInstance();\n    tb.x = 0;\n    tb.y = 896 - 85;\n    f12.appendChild(tb);\n  }\n\n  return \"11_Order_Accepted and 12_Account created successfully!\";\n})();","description":"Create 11_Order_Ac