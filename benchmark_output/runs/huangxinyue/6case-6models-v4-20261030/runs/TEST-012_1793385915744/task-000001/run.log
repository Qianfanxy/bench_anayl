='Status Bar';const hi=(await comp('6:54')).createInstance();hi.name='Home Indicator';hi.fills=[];\n if(tabCur){const tb=variant('Tab Bar','Current='+tabCur).createInstance();tb.name='Tab Bar';put(f,tb,0,f.height-92);tb.constraints={horizontal:'MIN',vertical:'MAX'};}\n put(f,hi,0,f.height-34);hi.constraints={horizontal:'MIN',vertical:'MAX'};put(f,sb,0,0);return {sb,hi};}\n// ---- component fixes\nconst pc=myc('Product Card'); pc.paddingLeft=pc.paddingRight=12; pc.paddingTop=16; pc.paddingBottom=14; pc.resize(173,240);\nconst box=pc.findOne(n=>n.name==='Image'); box.layoutSizingHorizontal='FILL';\npc.children.filter(n=>n.name==='Spacer')[0].resize(10,10);\nconst chipMain=myc('Category Chip'), cardMain=myc('Category Card');\nconst fixChip=(c)=>{const m=c.mainComponent; c.fills=m.fills; if(m.strokes&&m.strokes.length) c.strokes=m.strokes;};\n// ---- Home re-layout\nconst home=await comp('18:354');\nconst yMap={'Section · Exclusive Offer':351,'Section · Best Selling':671,'Section · Groceries':991};\nfor(const [n,y] of Object.entries(yMap)) home.findOne(k=>k.name===n).y=y;\nconst rows={'Organic Bananas':401,'Red Apple':401,'Bell Pepper Red':721,'Ginger':721,'Beef Bone':1151,'Broiler Chicken':1151};\nfor(const [n,y] of Object.entries(rows)) home.findOne(k=>k.name==='Product Card · '+n).y=y;\nfor(const n of ['Pulses','Rice']){const c=home.findOne(k=>k.name==='Category · '+n); c.y=1041; fixChip(c);}\nhome.resize(414,1507);\nhome.findOne(k=>k.name==='Tab Bar').y=1415; home.findOne(k=>k.name==='Home Indicator').y=1473;\n// ---- Component sheet tidy\nfor(const n of sec.children){ if(n.y>=1810) n.y+=170; }\nsec.resizeWithoutConstraints(3000,2700);\nconst ids={};\n// 07 Explore\n{const f=screen('07_Explore',6);\n const h=variant('Header','Type=Title').createInstance(); setP(h,{Title:'Find Products'}); h.name='Header'; put(f,h,0,44);\n const s=myc('Search Bar').createInstance(); put(f,s,25,104);\n const cats=[['Fresh Fruits & Vegetable','4:76','Green'],['Cooking Oil & Ghee','4:70','Orange'],['Meat & Fish','4:79','Red'],['Bakery & Snacks','4:64','Purple'],['Dairy & Eggs','4:73','Yellow'],['Beverages','4:67','Blue']];\n let i=0; for(const [nm,img,cl] of cats){const c=variant('Category Card','Color='+cl).createInstance(); setP(c,{Name:nm,Image:img}); c.name='Category · '+nm; fixChip(c); c.children[0].resize(112,76); put(f,c,25+(i%2)*189,172+Math.floor(i/2)*204); i++;}\n await shell(f,'Explore'); ids.s7=f.id;}\n// 08 Beverages\n{const f=screen('08_Beverages',7);\n const h=variant('Header','Type=Back + Title + Filter').createInstance(); setP(h,{Title:'Beverages'}); h.name='Header'; put(f,h,0,44);\n const items=[['Diet Coke','355ml, Price','$1.99','4:37'],['Sprite Can','325ml, Price','$1.50','4:58'],['Apple & Grape Juice','2L, Price','$15.99','4:22'],['Orange Juice','2L, Price','$15.99','4:46'],['Coca Cola Can','325ml, Price','$4.99','4:34'],['Pepsi Can','330ml, Price','$4.99','4:52']];\n let i=0; for(const [n,u,p,img] of items){const c=pc.createInstance(); setP(c,{Name:n,Unit:u,Price:p,Image:img}); c.name='Product Card · '+n; c.findOne(k=>k.name==='Image').children[0].resize(130,90); put(f,c,25+(i%2)*191,104+Math.floor(i/2)*252); i++;}\n await shell(f); ids.s8=f.id;}\n// 09 Cart\n{const f=screen('09_My_Cart',8);\n const h=variant('Header','Type=Title').createInstance(); setP(h,{Title:'My Cart'}); h.name='Header'; put(f,h,0,44);\n const items=[['Bell Pepper Red','1kg, Price','$4.99','4:28'],['Egg Chicken Red','4pcs, Price','$1.99','4:40'],['Organic Bananas','7pcs, Price','$4.99','4:49'],['Ginger','250gm, Price','$2.99','4:43']];\n let y=104; for(const [n,u,p,img] of items){const c=myc('Cart Item').createInstance(); setP(c,{Name:n,Unit:u,Price:p,Image:img}); c.name='Cart Item · '+n; c.findOne(k=>k.name==='Image').children[0].resize(76,66); put(f,c,25,y); y+=c.height;}\n const b=myc('Checkout Button').createInstance(); b.name='Go to Checkout'; put(f,b,25,721);\n await shell(f,'Cart'); ids.s9=f.id; ids.cartEnd=y;\n // 10 Checkout (cart stays behind)\n const o=screen('10_Checkout_Overlay',9);\n const back=f.clone(); back.name='My Cart (behind)'; put(o,back,0,0);\n const scrim=figma.createRectangle(); scrim.name='Scrim'; scrim.resize(414,896); fill(scrim,'surface/scrim',0.45); put(o,scrim,0,0);\n const sheet=figma.createFrame(); sheet.name='Checkout Sheet'; sheet.resize(414,560); fill(sheet,'surface/base'); sheet.topLeftRadius=sheet.topRightRadius=25; sheet.effectStyleId=ES['Nectar/Elevation 3 · Sheet'].id; put(o,sheet,0,336);\n const t=await T('Checkout','Title'); put(sheet,t,25,24);\n const cl=myc('Icon/Close').createInstance(); cl.name='Close'; put(sheet,cl,365,28);\n const div=figma.createRectangle(); div.name='Divider'; div.resize(414,1); fill(div,'border/default'); put(sheet,div,0,72);\n const mk=(kind,label,val)=>{const r=variant('Checkout Row','Value='+kind).createInstance(); const p={Label:label}; if(val)p.Value=val; setP(r,p); r.name='Row · '+label; return r;};\n let ry=73; for(const r of [mk('Text','Delivery','Select Method'),mk('Icon','Payment'),mk('Text','Promo Code','Pick discount'),mk('Text','Total Cost','$14.96')]){put(sheet,r,25,ry); ry+=r.height;}\n const lg=await T('By placing an order you agree to our Terms And Conditions','Caption','text/secondary'); lg.name='Legal'; lg.textAutoResize='HEIGHT'; lg.resize(364,lg.height); put(sheet,lg,25,ry+18);\n const a=lg.characters.indexOf('Terms And Conditions'); lg.setRangeFills(a,a+20,[paint('brand/primary')]); lg.setRangeFontName(a,a+20,{family:'Poppins',style:'Medium'}); lg.setRangeHyperlink&&0;\n const po=(await comp('6:29')).createInstance(); po.setProperties({'Label#6:0':'Place Order'}); po.name='Place Order'; put(sheet,po,25,ry+18+lg.height+18);\n const hi=(await comp('6:54')).createInstance(); hi.name='Home Indicator'; hi.fills=[]; put(o,hi,0,862);\n ids.s10=o.id; ids.sheetBottom=ry+18+lg.height+18+67;}\n// 11 Order Accepted\n{const f=screen('11_Order_Accepted',10);\n const il=(await comp('4:109')).createInstance(); il.rescale(1.4); il.name='Illustration_Order_Accepted'; put(f,il,(414-il.width)/2,150);\n const t=await T('Your Order has been accepted','Title'); t.textAlignHorizontal='CENTER'; t.textAutoResize='HEIGHT'; t.resize(320,t.height); put(f,t,47,410);\n const s=await T('Your items have been placed and are on their way to being processed','Body/Regular','text/secondary'); s.textAlignHorizontal='CENTER'; s.textAutoResize='HEIGHT'; s.resize(320,s.height); put(f,s,47,490);\n const tr=(await comp('6:29')).createInstance(); tr.setProperties({'Label#6:0':'Track Order'}); tr.name='Track Order'; put(f,tr,25,690);\n const bk=variant('Action Button','Type=Secondary').createInstance(); setP(bk,{Label:'Back to home'}); bk.name='Back to home'; put(f,bk,25,769);\n await shell(f); ids.s11=f.id;}\n// 12 Account\n{const f=screen('12_Account',11);\n const av=(await comp('4:103')).createInstance(); av.rescale(0.5); av.name='Avatar_Neutral'; av.cornerRadius=32; av.clipsContent=true; put(f,av,25,60);\n const n=await T('Afsar Hossen','Heading'); put(f,n,104,62);\n const ed=myc('Icon/Edit').createInstance(); ed.name='Edit Name'; ed.rescale(0.75); for(const v of ed.findAll(k=>k.type==='VECTOR')) v.strokes=[paint('brand/primary')]; put(f,ed,104+n.width+8,66);\n const e=await T('imshuvo97@gmail.com','Caption','text/secondary'); put(f,e,104,92);\n const dv=figma.createRectangle(); dv.name='Divider'; dv.resize(414,1); fill(dv,'border/default'); put(f,dv,0,140);\n const rows=[['Orders','4:151'],['My Details','4:145'],['Delivery Address','4:127'],['Payment Methods','4:154'],['Promo Code','4:157'],['Notifications','4:148'],['Help','4:142'],['About','4:115']];\n let y=141; for(const [l,ic] of rows){const r=myc('Account Row').createInstance(); setP(r,{Label:l,Icon:ic}); r.name='Row · '+l; put(f,r,0,y); y+=r.height;}\n const lo=variant('Action Button','Type=Tonal').createInstance(); setP(lo,{Label:'Log Out'}); lo.name='Log Out'; put(f,lo,25,y+14);\n await shell(f,'Account'); ids.s12=f.id; ids.rowsEnd=y;}\nreturn ids;","description":"T