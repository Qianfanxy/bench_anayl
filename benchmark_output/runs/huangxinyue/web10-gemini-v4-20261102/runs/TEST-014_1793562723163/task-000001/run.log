{"type":"assistant","message":{"id":"chatcmpl-202611011957485909725678268d9d6g4ZLxHbs","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_ac1762957fae4c5385aac92d20c0ee32","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  // Let's create the 03_Product frame!\n  \n  await figma.loadFontAsync({ family: \"Archivo Black\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Plus Jakarta Sans\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Plus Jakarta Sans\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Plus Jakarta Sans\", style: \"Semi Bold\" });\n  await figma.loadFontAsync({ family: \"Plus Jakarta Sans\", style: \"Bold\" });\n\n  const wsPage = await figma.getNodeByIdAsync(\"6:2\");\n  \n  // Map of media components\n  const mediaPage = await figma.getNodeByIdAsync(\"1:4\");\n  const mediaMap = {};\n  function findMedia(node) {\n    if (node.type === \"COMPONENT\" || node.type === \"COMPONENT_SET\") {\n      mediaMap[node.name] = node;\n    }\n    if (\"children\" in node) {\n      for (const c of node.children) findMedia(c);\n    }\n  }\n  findMedia(mediaPage);\n\n  function getInstance(name, width, height) {\n    const comp = mediaMap[name];\n    if (!comp) {\n      const r = figma.createFrame();\n      r.name = name;\n      r.resize(width || 24, height || 24);\n      r.fills = [{ type: 'SOLID', color: { r: 0.9, g: 0.9, b: 0.9 } }];\n      return r;\n    }\n    const inst = comp.createInstance();\n    if (width && height) {\n      inst.resize(width, height);\n    }\n    return inst;\n  }\n\n  const C = {\n    black: { r: 0, g: 0, b: 0 },\n    white: { r: 1, g: 1, b: 1 },\n    grayBg: { r: 0.95, g: 0.95, b: 0.95 },\n    grayText: { r: 0.4, g: 0.4, b: 0.4 },\n    grayBorder: { r: 0.9, g: 0.9, b: 0.9 },\n    starYellow: { r: 1, g: 0.75, b: 0 },\n    greenVerified: { r: 0.01, g: 0.75, b: 0.17 },\n    discountBg: { r: 1, g: 0.9, b: 0.9 },\n    discountText: { r: 1, g: 0.2, b: 0.2 }\n  };\n\n  // Shared components\n  function createAnnouncementBar() {\n    const bar = figma.createFrame();\n    bar.name = \"Announcement Bar\";\n    bar.resize(1440, 38);\n    bar.fills = [{ type: 'SOLID', color: C.black }];\n    bar.layoutMode = \"HORIZONTAL\";\n    bar.primaryAxisAlignItems = \"CENTER\";\n    bar.counterAxisAlignItems = \"CENTER\";\n    bar.paddingLeft = 100;\n    bar.paddingRight = 100;\n    bar.itemSpacing = 8;\n\n    const text = figma.createText();\n    text.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    text.fontSize = 14;\n    text.characters = \"Sign up and get 20% off to your first order. \";\n    text.fills = [{ type: 'SOLID', color: C.white }];\n\n    const link = figma.createText();\n    link.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n    link.fontSize = 14;\n    link.characters = \"Sign Up Now\";\n    link.textDecoration = \"UNDERLINE\";\n    link.fills = [{ type: 'SOLID', color: C.white }];\n\n    const spacer = figma.createFrame();\n    spacer.name = \"Spacer\";\n    spacer.resize(1, 1);\n    spacer.fills = [];\n    spacer.layoutGrow = 1;\n\n    const closeIcon = getInstance(\"Icon_Close\", 20, 20);\n\n    bar.appendChild(text);\n    bar.appendChild(link);\n    bar.appendChild(spacer);\n    bar.appendChild(closeIcon);\n    return bar;\n  }\n\n  function createHeader(activeNav) {\n    const header = figma.createFrame();\n    header.name = \"Header\";\n    header.resize(1440, 96);\n    header.fills = [{ type: 'SOLID', color: C.white }];\n    header.layoutMode = \"HORIZONTAL\";\n    header.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    header.counterAxisAlignItems = \"CENTER\";\n    header.paddingLeft = 100;\n    header.paddingRight = 100;\n    header.itemSpacing = 40;\n\n    const logo = figma.createText();\n    logo.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n    logo.fontSize = 32;\n    logo.characters = \"SHOP.CO\";\n    logo.fills = [{ type: 'SOLID', color: C.black }];\n\n    const nav = figma.createFrame();\n    nav.name = \"Navigation\";\n    nav.fills = [];\n    nav.layoutMode = \"HORIZONTAL\";\n    nav.counterAxisAlignItems = \"CENTER\";\n    nav.itemSpacing = 24;\n\n    const items = [\n      { name: \"Shop\", hasChevron: true },\n      { name: \"On Sale\", hasChevron: false },\n      { name: \"New Arrivals\", hasChevron: false },\n      { name: \"Brands\", hasChevron: false }\n    ];\n\n    for (const item of items) {\n      const navItem = figma.createFrame();\n      navItem.name = `Nav_${item.name}`;\n      navItem.fills = [];\n      navItem.layoutMode = \"HORIZONTAL\";\n      navItem.counterAxisAlignItems = \"CENTER\";\n      navItem.itemSpacing = 4;\n\n      const t = figma.createText();\n      const isCurrent = (activeNav === item.name);\n      t.fontName = { family: \"Plus Jakarta Sans\", style: isCurrent ? \"Bold\" : \"Regular\" };\n      t.fontSize = 16;\n      t.characters = item.name;\n      t.fills = [{ type: 'SOLID', color: C.black }];\n\n      navItem.appendChild(t);\n\n      if (item.hasChevron) {\n        const chev = getInstance(\"Icon_Chevron_Down\", 16, 16);\n        navItem.appendChild(chev);\n      }\n      nav.appendChild(navItem);\n    }\n\n    const search = figma.createFrame();\n    search.name = \"Search Field\";\n    search.resize(500, 48);\n    search.fills = [{ type: 'SOLID', color: C.grayBg }];\n    search.cornerRadius = 62;\n    search.layoutMode = \"HORIZONTAL\";\n    search.counterAxisAlignItems = \"CENTER\";\n    search.paddingLeft = 16;\n    search.paddingRight = 16;\n    search.itemSpacing = 12;\n    search.layoutGrow = 1;\n\n    const searchIcon = getInstance(\"Icon_Search\", 20, 20);\n    const searchInput = figma.createText();\n    searchInput.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    searchInput.fontSize = 16;\n    searchInput.characters = \"Search for products...\";\n    searchInput.fills = [{ type: 'SOLID', color: C.grayText }];\n\n    search.appendChild(searchIcon);\n    search.appendChild(searchInput);\n\n    const actions = figma.createFrame();\n    actions.name = \"Actions\";\n    actions.fills = [];\n    actions.layoutMode = \"HORIZONTAL\";\n    actions.counterAxisAlignItems = \"CENTER\";\n    actions.itemSpacing = 14;\n\n    const cartIcon = getInstance(\"Icon_Cart\", 24, 24);\n    cartIcon.name = \"Icon_Cart_Trigger\";\n    const accountIcon = getInstance(\"Icon_Account\", 24, 24);\n\n    actions.appendChild(cartIcon);\n    actions.appendChild(accountIcon);\n\n    header.appendChild(logo);\n    header.appendChild(nav);\n    header.appendChild(search);\n    header.appendChild(actions);\n\n    return header;\n  }\n\n  function createNewsletter() {\n    const container = figma.createFrame();\n    container.name = \"Newsletter Section\";\n    container.resize(1440, 200);\n    container.fills = [];\n    container.layoutMode = \"HORIZONTAL\";\n    container.primaryAxisAlignItems = \"CENTER\";\n\n    const box = figma.createFrame();\n    box.name = \"Newsletter Box\";\n    box.resize(1240, 180);\n    box.fills = [{ type: 'SOLID', color: C.black }];\n    box.cornerRadius = 20;\n    box.layoutMode = \"HORIZONTAL\";\n    box.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    box.counterAxisAlignItems = \"CENTER\";\n    box.paddingLeft = 64;\n    box.paddingRight = 64;\n\n    const title = figma.createText();\n    title.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n    title.fontSize = 32;\n    title.characters = \"STAY UP TO DATE ABOUT\\nOUR LATEST OFFERS\";\n    title.fills = [{ type: 'SOLID', color: C.white }];\n    title.resize(550, 80);\n\n    const form = figma.createFrame();\n    form.name = \"Newsletter Form\";\n    form.fills = [];\n    form.layoutMode = \"VERTICAL\";\n    form.itemSpacing = 14;\n    form.resize(350, 110);\n\n    const emailField = figma.createFrame();\n    emailField.name = \"Email Field\";\n    emailField.resize(350, 48);\n    emailField.fills = [{ type: 'SOLID', color: C.white }];\n    emailField.cornerRadius = 62;\n    emailField.layoutMode = \"HORIZONTAL\";\n    emailField.counterAxisAlignItems = \"CENTER\";\n    emailField.paddingLeft = 16;\n    emailField.itemSpacing = 12;\n\n    const tagIcon = getInstance(\"Icon_Tag\", 20, 20);\n    const emailInput = figma.createText();\n    emailInput.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    emailInput.fontSize = 14;\n    emailInput.characters = \"Enter your email address\";\n    emailInput.fills = [{ type: 'SOLID', color: C.grayText }];\n\n    emailField.appendChild(tagIcon);\n    emailField.appendChild(emailInput);\n\n    const btn = figma.createFrame();\n    btn.name = \"Subscribe Button\";\n    btn.resize(350, 48);\n    btn.fills = [{ type: 'SOLID', color: C.white }];\n    btn.cornerRadius = 62;\n    btn.layoutMode = \"HORIZONTAL\";\n    btn.primaryAxisAlignItems = \"CENTER\";\n    btn.counterAxisAlignItems = \"CENTER\";\n\n    const btnText = figma.createText();\n    btnText.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n    btnText.fontSize = 14;\n    btnText.characters = \"Subscribe to Newsletter\";\n    btnText.fills = [{ type: 'SOLID', color: C.black }];\n\n    btn.appendChild(btnText);\n\n    form.appendChild(emailField);\n    form.appendChild(btn);\n\n    box.appendChild(title);\n    box.appendChild(form);\n\n    container.appendChild(box);\n    return container;\n  }\n\n  function createFooter() {\n    const footer = figma.createFrame();\n    footer.name = \"Footer Component\";\n    footer.resize(1440, 420);\n    footer.fills = [{ type: 'SOLID', color: C.grayBg }];\n    footer.layoutMode = \"VERTICAL\";\n    footer.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    footer.paddingLeft = 100;\n    footer.paddingRight = 100;\n    footer.paddingTop = 50;\n    footer.paddingBottom = 30;\n\n    const topRow = figma.createFrame();\n    topRow.name = \"Footer Main Content\";\n    topRow.resize(1240, 260);\n    topRow.fills = [];\n    topRow.layoutMode = \"HORIZONTAL\";\n    topRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n\n    const brandCol = figma.createFrame();\n    brandCol.name = \"Brand Col\";\n    brandCol.resize(250, 220);\n    brandCol.fills = [];\n    brandCol.layoutMode = \"VERTICAL\";\n    brandCol.itemSpacing = 20;\n\n    const logo = figma.createText();\n    logo.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n    logo.fontSize = 28;\n    logo.characters = \"SHOP.CO\";\n\n    const desc = figma.createText();\n    desc.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    desc.fontSize = 14;\n    desc.characters = \"We have clothes that suit your style and which you’re proud to wear. From women to men.\";\n    desc.fills = [{ type: 'SOLID', color: C.grayText }];\n\n    const socialRow = figma.createFrame();\n    socialRow.name = \"Social Logos\";\n    socialRow.fills = [];\n    socialRow.layoutMode = \"HORIZONTAL\";\n    socialRow.itemSpacing = 12;\n\n    socialRow.appendChild(getInstance(\"Logo_Twitter\", 28, 28));\n    socialRow.appendChild(getInstance(\"Logo_Facebook\", 28, 28));\n    socialRow.appendChild(getInstance(\"Logo_Instagram\", 28, 28));\n    socialRow.appendChild(getInstance(\"Logo_GitHub\", 28, 28));\n\n    brandCol.appendChild(logo);\n    brandCol.appendChild(desc);\n    brandCol.appendChild(socialRow);\n\n    function createLinkCol(title, links) {\n      const col = figma.createFrame();\n      col.name = `Col_${title}`;\n      col.fills = [];\n      col.layoutMode = \"VERTICAL\";\n      col.itemSpacing = 16;\n\n      const t = figma.createText();\n      t.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n      t.fontSize = 16;\n      t.characters = title;\n\n      col.appendChild(t);\n\n      for (const link of links) {\n        const l = figma.createText();\n        l.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n        l.fontSize = 14;\n        l.characters = link;\n        l.fills = [{ type: 'SOLID', color: C.grayText }];\n        col.appendChild(l);\n      }\n      return col;\n    }\n\n    const companyCol = createLinkCol(\"COMPANY\", [\"About\", \"Features\", \"Works\", \"Career\"]);\n    const helpCol = createLinkCol(\"HELP\", [\"Customer Support\", \"Delivery Details\", \"Terms & Conditions\", \"Privacy Policy\"]);\n    const faqCol = createLinkCol(\"FAQ\", [\"Account\", \"Manage Deliveries\", \"Orders\", \"Payments\"]);\n    const resCol = createLinkCol(\"RESOURCES\", [\"Free eBooks\", \"Development Tutorial\", \"How to - Blog\", \"Youtube Playlist\"]);\n\n    topRow.appendChild(brandCol);\n    topRow.appendChild(companyCol);\n    topRow.appendChild(helpCol);\n    topRow.appendChild(faqCol);\n    topRow.appendChild(resCol);\n\n    const divider = figma.createFrame();\n    divider.name = \"Divider\";\n    divider.resize(1240, 1);\n    divider.fills = [{ type: 'SOLID', color: C.grayBorder }];\n\n    const bottomRow = figma.createFrame();\n    bottomRow.name = \"Footer Bottom\";\n    bottomRow.resize(1240, 40);\n    bottomRow.fills = [];\n    bottomRow.layoutMode = \"HORIZONTAL\";\n    bottomRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    bottomRow.counterAxisAlignItems = \"CENTER\";\n\n    const copyText = figma.createText();\n    copyText.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    copyText.fontSize = 14;\n    copyText.characters = \"Shop.co © 2000-2023, All Rights Reserved\";\n    copyText.fills = [{ type: 'SOLID', color: C.grayText }];\n\n    const paymentsRow = figma.createFrame();\n    paymentsRow.name = \"Payment Logos\";\n    paymentsRow.fills = [];\n    paymentsRow.layoutMode = \"HORIZONTAL\";\n    paymentsRow.itemSpacing = 10;\n\n    paymentsRow.appendChild(getInstance(\"Logo_Visa\", 46, 30));\n    paymentsRow.appendChild(getInstance(\"Logo_Mastercard\", 46, 30));\n    paymentsRow.appendChild(getInstance(\"Logo_PayPal\", 46, 30));\n    paymentsRow.appendChild(getInstance(\"Logo_Apple_Pay\", 46, 30));\n    paymentsRow.appendChild(getInstance(\"Logo_Google_Pay\", 46, 30));\n\n    bottomRow.appendChild(copyText);\n    bottomRow.appendChild(paymentsRow);\n\n    footer.appendChild(topRow);\n    footer.appendChild(divider);\n    footer.appendChild(bottomRow);\n\n    return footer;\n  }\n\n  function createRatingNode(score) {\n    const row = figma.createFrame();\n    row.name = \"Rating\";\n    row.fills = [];\n    row.layoutMode = \"HORIZONTAL\";\n    row.counterAxisAlignItems = \"CENTER\";\n    row.itemSpacing = 4;\n\n    const fullStars = Math.floor(score);\n    const hasHalf = (score % 1 !== 0);\n\n    for (let i = 0; i < 5; i++) {\n      if (i < fullStars) {\n        row.appendChild(getInstance(\"Icon_Star\", 18, 18));\n      } else if (i === fullStars && hasHalf) {\n        row.appendChild(getInstance(\"Icon_Star_Half\", 18, 18));\n      } else {\n        const emptyStar = getInstance(\"Icon_Star\", 18, 18);\n        emptyStar.fills = [{ type: 'SOLID', color: { r: 0.8, g: 0.8, b: 0.8 } }];\n        row.appendChild(emptyStar);\n      }\n    }\n\n    const t = figma.createText();\n    t.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    t.fontSize = 14;\n    t.characters = `${score.toFixed(1)}/5`;\n    t.fills = [{ type: 'SOLID', color: C.grayText }];\n    row.appendChild(t);\n\n    return row;\n  }\n\n  function createProductCard(photoName, name, ratingScore, price, oldPrice, discount) {\n    const card = figma.createFrame();\n    card.name = \"Product Card_Trigger\";\n    card.resize(280, 400);\n    card.fills = [];\n    card.layoutMode = \"VERTICAL\";\n    card.itemSpacing = 12;\n\n    const imgWrapper = figma.createFrame();\n    imgWrapper.name = \"Image Wrapper\";\n    imgWrapper.resize(280, 280);\n    imgWrapper.cornerRadius = 16;\n    imgWrapper.fills = [{ type: \"SOLID\", color: C.grayBg }];\n    imgWrapper.layoutMode = \"VERTICAL\";\n    imgWrapper.primaryAxisAlignItems = \"CENTER\";\n    imgWrapper.counterAxisAlignItems = \"CENTER\";\n\n    const photo = getInstance(photoName, 260, 260);\n    imgWrapper.appendChild(photo);\n\n    const title = figma.createText();\n    title.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n    title.fontSize = 16;\n    title.characters = name;\n    title.resize(280, 20);\n\n    const rating = createRatingNode(ratingScore);\n\n    const priceRow = figma.createFrame();\n    priceRow.name = \"Price Row\";\n    priceRow.fills = [];\n    priceRow.layoutMode = \"HORIZONTAL\";\n    priceRow.counterAxisAlignItems = \"CENTER\";\n    priceRow.itemSpacing = 10;\n\n    const pText = figma.createText();\n    pText.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n    pText.fontSize = 18;\n    pText.characters = `$${price}`;\n\n    priceRow.appendChild(pText);\n\n    if (oldPrice) {\n      const opText = figma.createText();\n      opText.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n      opText.fontSize = 16;\n      opText.characters = `$${oldPrice}`;\n      opText.fills = [{ type: 'SOLID', color: C.grayText }];\n      opText.textDecoration = \"STRIKETHROUGH\";\n      priceRow.appendChild(opText);\n    }\n\n    if (discount) {\n      const discTag = figma.createFrame();\n      discTag.name = \"Discount Tag\";\n      discTag.fills = [{ type: 'SOLID', color: C.discountBg }];\n      discTag.cornerRadius = 62;\n      discTag.layoutMode = \"HORIZONTAL\";\n      discTag.paddingLeft = 8;\n      discTag.paddingRight = 8;\n      discTag.paddingTop = 4;\n      discTag.paddingBottom = 4;\n\n      const dt = figma.createText();\n      dt.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n      dt.fontSize = 12;\n      dt.characters = discount;\n      dt.fills = [{ type: 'SOLID', color: C.discountText }];\n\n      discTag.appendChild(dt);\n      priceRow.appendChild(discTag);\n    }\n\n    card.appendChild(imgWrapper);\n    card.appendChild(title);\n    card.appendChild(rating);\n    card.appendChild(priceRow);\n\n    return card;\n  }\n\n  function parseHex(hex) {\n    const r = parseInt(hex.slice(1, 3), 16) / 255;\n    const g = parseInt(hex.slice(3, 5), 16) / 255;\n    const b = parseInt(hex.slice(5, 7), 16) / 255;\n    return { r, g, b };\n  }\n\n  // 3. FRAME 03_Product CREATION\n  const frameProd = figma.createFrame();\n  frameProd.name = \"03_Product\";\n  frameProd.resize(1440, 2700);\n  frameProd.fills = [{ type: 'SOLID', color: C.white }];\n  frameProd.layoutMode = \"VERTICAL\";\n  frameProd.itemSpacing = 0;\n\n  frameProd.appendChild(createAnnouncementBar());\n  frameProd.appendChild(createHeader(\"Shop\"));\n\n  // BREADCRUMB (Home › Shop › Men › T-shirts)\n  const breadcrumb = figma.createFrame();\n  breadcrumb.name = \"Breadcrumb Section\";\n  breadcrumb.resize(1440, 60);\n  breadcrumb.fills = [];\n  breadcrumb.layoutMode = \"HORIZONTAL\";\n  breadcrumb.counterAxisAlignItems = \"CENTER\";\n  breadcrumb.paddingLeft = 100;\n  breadcrumb.paddingRight = 100;\n  breadcrumb.itemSpacing = 8;\n\n  function createBreadcrumbItem(name, isTrigger) {\n    const t = figma.createText();\n    if (isTrigger) {\n      t.name = `Breadcrumb_${name}_Trigger`;\n    }\n    t.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    t.fontSize = 14;\n    t.characters = name;\n    t.fills = [{ type: 'SOLID', color: C.grayText }];\n    return t;\n  }\n\n  breadcrumb.appendChild(createBreadcrumbItem(\"Home\", true));\n  breadcrumb.appendChild(getInstance(\"Icon_Chevron_Right\", 14, 14));\n  breadcrumb.appendChild(createBreadcrumbItem(\"Shop\", true));\n  breadcrumb.appendChild(getInstance(\"Icon_Chevron_Right\", 14, 14));\n  breadcrumb.appendChild(createBreadcrumbItem(\"Men\", false));\n  breadcrumb.appendChild(getInstance(\"Icon_Chevron_Right\", 14, 14));\n\n  const bCurrent = figma.createText();\n  bCurrent.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n  bCurrent.fontSize = 14;\n  bCurrent.characters = \"T-shirts\";\n  bCurrent.fills = [{ type: 'SOLID', color: C.black }];\n  breadcrumb.appendChild(bCurrent);\n\n  frameProd.appendChild(breadcrumb);\n\n  // PRODUCT DETAILS AREA (Gallery Left + Summary Right)\n  const detailsArea = figma.createFrame();\n  detailsArea.name = \"Details Area\";\n  detailsArea.resize(1440, 650);\n  detailsArea.fills = [];\n  detailsArea.layoutMode = \"HORIZONTAL\";\n  detailsArea.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  detailsArea.paddingLeft = 100;\n  detailsArea.paddingRight = 100;\n  detailsArea.itemSpacing = 40;\n\n  // GALLERY (Left)\n  const gallery = figma.createFrame();\n  gallery.name = \"Gallery Component\";\n  gallery.resize(610, 530);\n  gallery.fills = [];\n  gallery.layoutMode = \"HORIZONTAL\";\n  gallery.itemSpacing = 14;\n\n  // Thumbnails (vertical on left of main image)\n  const thumbsCol = figma.createFrame();\n  thumbsCol.name = \"Thumbnails Column\";\n  thumbsCol.fills = [];\n  thumbsCol.layoutMode = \"VERTICAL\";\n  thumbsCol.itemSpacing = 14;\n\n  function createThumb(photoName, selected) {\n    const box = figma.createFrame();\n    box.name = `Thumb_${photoName}`;\n    box.resize(150, 160);\n    box.cornerRadius = 20;\n    box.strokeWeight = selected ? 2 : 1;\n    box.strokes = [{ type: 'SOLID', color: selected ? C.black : C.grayBorder }];\n    box.fills = [{ type: 'SOLID', color: C.grayBg }];\n    box.layoutMode = \"VERTICAL\";\n    box.primaryAxisAlignItems = \"CENTER\";\n    box.counterAxisAlignItems = \"CENTER\";\n\n    const photo = getInstance(photoName, 130, 140);\n    box.appendChild(photo);\n    return box;\n  }\n\n  thumbsCol.appendChild(createThumb(\"Photo_One_Life_TShirt_1\", true));\n  thumbsCol.appendChild(createThumb(\"Photo_One_Life_TShirt_2\", false));\n  thumbsCol.appendChild(createThumb(\"Photo_One_Life_TShirt_3\", false));\n\n  // Main Image (Right of thumbs)\n  const mainImgWrapper = figma.createFrame();\n  mainImgWrapper.name = \"Main Image Wrapper\";\n  mainImgWrapper.resize(444, 508);\n  mainImgWrapper.cornerRadius = 20;\n  mainImgWrapper.fills = [{ type: 'SOLID', color: C.grayBg }];\n  mainImgWrapper.layoutMode = \"VERTICAL\";\n  mainImgWrapper.primaryAxisAlignItems = \"CENTER\";\n  mainImgWrapper.counterAxisAlignItems = \"CENTER\";\n\n  const mainPhoto = getInstance(\"Photo_One_Life_TShirt_1\", 420, 480);\n  mainImgWrapper.appendChild(mainPhoto);\n\n  gallery.appendChild(thumbsCol);\n  gallery.appendChild(mainImgWrapper);\n  detailsArea.appendChild(gallery);\n\n  // SUMMARY & PURCHASE INTERACTION PANEL (Right)\n  const summaryPanel = figma.createFrame();\n  summaryPanel.name = \"Summary Panel\";\n  summaryPanel.resize(590, 600);\n  summaryPanel.fills = [];\n  summaryPanel.layoutMode = \"VERTICAL\";\n  summaryPanel.itemSpacing = 16;\n\n  const sTitle = figma.createText();\n  sTitle.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n  sTitle.fontSize = 40;\n  sTitle.characters = \"ONE LIFE GRAPHIC\\nT-SHIRT\";\n\n  const sRating = createRatingNode(4.5);\n\n  const sPriceRow = figma.createFrame();\n  sPriceRow.name = \"Price Row\";\n  sPriceRow.fills = [];\n  sPriceRow.layoutMode = \"HORIZONTAL\";\n  sPriceRow.counterAxisAlignItems = \"CENTER\";\n  sPriceRow.itemSpacing = 12;\n\n  const spText = figma.createText();\n  spText.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n  spText.fontSize = 32;\n  spText.characters = \"$260\";\n\n  const sopText = figma.createText();\n  sopText.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n  sopText.fontSize = 24;\n  sopText.characters = \"$300\";\n  sopText.fills = [{ type: 'SOLID', color: C.grayText }];\n  sopText.textDecoration = \"STRIKETHROUGH\";\n\n  const sDiscTag = figma.createFrame();\n  sDiscTag.name = \"Discount Tag\";\n  sDiscTag.fills = [{ type: 'SOLID', color: C.discountBg }];\n  sDiscTag.cornerRadius = 62;\n  sDiscTag.layoutMode = \"HORIZONTAL\";\n  sDiscTag.paddingLeft = 12;\n  sDiscTag.paddingRight = 12;\n  sDiscTag.paddingTop = 6;\n  sDiscTag.paddingBottom = 6;\n\n  const sdt = figma.createText();\n  sdt.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n  sdt.fontSize = 14;\n  sdt.characters = \"-13%\";\n  sdt.fills = [{ type: 'SOLID', color: C.discountText }];\n  sDiscTag.appendChild(sdt);\n\n  sPriceRow.appendChild(spText);\n  sPriceRow.appendChild(sopText);\n  sPriceRow.appendChild(sDiscTag);\n\n  const sDesc = figma.createText();\n  sDesc.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n  sDesc.fontSize = 15;\n  sDesc.characters = \"This graphic t-shirt is perfect for any occasion. Crafted from a soft and breathable fabric, it offers superior comfort and style.\";\n  sDesc.fills = [{ type: 'SOLID', color: C.grayText }];\n  sDesc.resize(590, 50);\n\n  const div1 = figma.createFrame(); div1.resize(590, 1); div1.fills = [{ type: 'SOLID', color: C.grayBorder }];\n\n  // Select Colors: olive, teal, navy (olive selected)\n  const colorsSec = figma.createFrame();\n  colorsSec.name = \"Color Picker Section\";\n  colorsSec.fills = [];\n  colorsSec.layoutMode = \"VERTICAL\";\n  colorsSec.itemSpacing = 10;\n\n  const colorsLabel = figma.createText();\n  colorsLabel.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n  colorsLabel.fontSize = 15;\n  colorsLabel.characters = \"Select Colors\";\n  colorsLabel.fills = [{ type: 'SOLID', color: C.grayText }];\n\n  const colorsRow = figma.createFrame();\n  colorsRow.name = \"Colors Row\";\n  colorsRow.fills = [];\n  colorsRow.layoutMode = \"HORIZONTAL\";\n  colorsRow.itemSpacing = 12;\n\n  const productColors = [\n    { name: \"olive\", hex: \"#4F4631\", selected: true },\n    { name: \"teal\", hex: \"#314F4A\" },\n    { name: \"navy\", hex: \"#31344F\" }\n  ];\n\n  for (const pc of productColors) {\n    const sw = figma.createFrame();\n    sw.name = `ColorOption_${pc.name}`;\n    sw.resize(38, 38);\n    sw.cornerRadius = 19;\n    sw.fills = [{ type: 'SOLID', color: parseHex(pc.hex) }];\n    if (pc.selected) {\n      sw.layoutMode = \"HORIZONTAL\";\n      sw.primaryAxisAlignItems = \"CENTER\";\n      sw.counterAxisAlignItems = \"CENTER\";\n      sw.appendChild(getInstance(\"Icon_Check\", 16, 16));\n    }\n    colorsRow.appendChild(sw);\n  }\n  colorsSec.appendChild(colorsLabel);\n  colorsSec.appendChild(colorsRow);\n\n  const div2 = figma.createFrame(); div2.resize(590, 1); div2.fills = [{ type: 'SOLID', color: C.grayBorder }];\n\n  // Choose Size: Small, Medium, Large, X-Large (Large selected)\n  const sizeSec = figma.createFrame();\n  sizeSec.name = \"Size Picker Section\";\n  sizeSec.fills = [];\n  sizeSec.layoutMode = \"VERTICAL\";\n  sizeSec.itemSpacing = 10;\n\n  const sizeLabel = figma.createText();\n  sizeLabel.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n  sizeLabel.fontSize = 15;\n  sizeLabel.characters = \"Choose Size\";\n  sizeLabel.fills = [{ type: 'SOLID', color: C.grayText }];\n\n  const sizeRow = figma.createFrame();\n  sizeRow.name = \"Size Row\";\n  sizeRow.fills = [];\n  sizeRow.layoutMode = \"HORIZONTAL\";\n  sizeRow.itemSpacing = 12;\n\n  const productSizes = [\"Small\", \"Medium\", \"Large\", \"X-Large\"];\n  for (const ps of productSizes) {\n    const chip = figma.createFrame();\n    chip.name = `SizeOption_${ps}`;\n    chip.cornerRadius = 62;\n    const isSel = (ps === \"Large\");\n    chip.fills = [{ type: 'SOLID', color: isSel ? C.black : C.grayBg }];\n    chip.layoutMode = \"HORIZONTAL\";\n    chip.paddingLeft = 16;\n    chip.paddingRight = 16;\n    chip.paddingTop = 10;\n    chip.paddingBottom = 10;\n\n    const ct = figma.createText();\n    ct.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    ct.fontSize = 15;\n    ct.characters = ps;\n    ct.fills = [{ type: 'SOLID', color: isSel ? C.white : C.black }];\n\n    chip.appendChild(ct);\n    sizeRow.appendChild(chip);\n  }\n  sizeSec.appendChild(sizeLabel);\n  sizeSec.appendChild(sizeRow);\n\n  const div3 = figma.createFrame(); div3.resize(590, 1); div3.fills = [{ type: 'SOLID', color: C.grayBorder }];\n\n  // Purchase Actions (- 1 + Stepper and Add to Cart Button)\n  const purchaseRow = figma.createFrame();\n  purchaseRow.name = \"Purchase Control Row\";\n  purchaseRow.fills = [];\n  purchaseRow.layoutMode = \"HORIZONTAL\";\n  purchaseRow.itemSpacing = 20;\n  purchaseRow.resize(590, 52);\n\n  // Stepper\n  const stepper = figma.createFrame();\n  stepper.name = \"Quantity Stepper\";\n  stepper.resize(170, 52);\n  stepper.cornerRadius = 62;\n  stepper.fills = [{ type: 'SOLID', color: C.grayBg }];\n  stepper.layoutMode = \"HORIZONTAL\";\n  stepper.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  stepper.counterAxisAlignItems = \"CENTER\";\n  stepper.paddingLeft = 20;\n  stepper.paddingRight = 20;\n\n  const minusBtn = getInstance(\"Icon_Minus\", 20, 20);\n  const qtyText = figma.createText();\n  qtyText.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n  qtyText.fontSize = 16;\n  qtyText.characters = \"1\";\n  const plusBtn = getInstance(\"Icon_Plus\", 20, 20);\n\n  stepper.appendChild(minusBtn);\n  stepper.appendChild(qtyText);\n  stepper.appendChild(plusBtn);\n\n  // Add to Cart Trigger\n  const cartBtn = figma.createFrame();\n  cartBtn.name = \"Button_AddToCart_Trigger\";\n  cartBtn.resize(400, 52);\n  cartBtn.cornerRadius = 62;\n  cartBtn.fills = [{ type: 'SOLID', color: C.black }];\n  cartBtn.layoutMode = \"HORIZONTAL\";\n  cartBtn.primaryAxisAlignItems = \"CENTER\";\n  cartBtn.counterAxisAlignItems = \"CENTER\";\n\n  const cartBtnText = figma.createText();\n  cartBtnText.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n  cartBtnText.fontSize = 16;\n  cartBtnText.characters = \"Add to Cart\";\n  cartBtnText.fills = [{ type: 'SOLID', color: C.white }];\n\n  cartBtn.appendChild(cartBtnText);\n\n  purchaseRow.appendChild(stepper);\n  purchaseRow.appendChild(cartBtn);\n\n  summaryPanel.appendChild(sTitle);\n  summaryPanel.appendChild(sRating);\n  summaryPanel.appendChild(sPriceRow);\n  summaryPanel.appendChild(sDesc);\n  summaryPanel.appendChild(div1);\n  summaryPanel.appendChild(colorsSec);\n  summaryPanel.appendChild(div2);\n  summaryPanel.appendChild(sizeSec);\n  summaryPanel.appendChild(div3);\n  summaryPanel.appendChild(purchaseRow);\n\n  detailsArea.appendChild(summaryPanel);\n  frameProd.appendChild(detailsArea);\n\n  // TABS (Product Details, Rating & Reviews, FAQs; Rating & Reviews is current)\n  const tabsSection = figma.createFrame();\n  tabsSection.name = \"Tabs Section\";\n  tabsSection.resize(1440, 80);\n  tabsSection.fills = [];\n  tabsSection.layoutMode = \"VERTICAL\";\n  tabsSection.primaryAxisAlignItems = \"CENTER\";\n  tabsSection.paddingLeft = 100;\n  tabsSection.paddingRight = 100;\n\n  const tabsRow = figma.createFrame();\n  tabsRow.name = \"Tabs Row\";\n  tabsRow.resize(1240, 50);\n  tabsRow.fills = [];\n  tabsRow.layoutMode = \"HORIZONTAL\";\n  tabsRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n\n  function createTab(name, active) {\n    const wrapper = figma.createFrame();\n    wrapper.name = `Tab_${name}`;\n    wrapper.resize(400, 50);\n    wrapper.fills = [];\n    wrapper.layoutMode = \"VERTICAL\";\n    wrapper.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    wrapper.counterAxisAlignItems = \"CENTER\";\n\n    const t = figma.createText();\n    t.fontName = { family: \"Plus Jakarta Sans\", style: active ? \"Bold\" : \"Regular\" };\n    t.fontSize = 16;\n    t.characters = name;\n    t.fills = [{ type: 'SOLID', color: active ? C.black : C.grayText }];\n\n    const underline = figma.createFrame();\n    underline.name = \"Underline\";\n    underline.resize(400, active ? 2 : 1);\n    underline.fills = [{ type: 'SOLID', color: active ? C.black : C.grayBorder }];\n\n    wrapper.appendChild(t);\n    wrapper.appendChild(underline);\n    return wrapper;\n  }\n\n  tabsRow.appendChild(createTab(\"Product Details\", false));\n  tabsRow.appendChild(createTab(\"Rating & Reviews\", true));\n  tabsRow.appendChild(createTab(\"FAQs\", false));\n  tabsSection.appendChild(tabsRow);\n  frameProd.appendChild(tabsSection);\n\n  // REVIEWS HEADER & LIST (All Reviews, filter icon, sort Latest dropdown, Write a Review, and 6 cards)\n  const reviewsSection = figma.createFrame();\n  reviewsSection.name = \"Reviews List Section\";\n  reviewsSection.resize(1440, 950);\n  reviewsSection.fills = [];\n  reviewsSection.layoutMode = \"VERTICAL\";\n  reviewsSection.paddingLeft = 100;\n  reviewsSection.paddingRight = 100;\n  reviewsSection.paddingTop = 30;\n  reviewsSection.itemSpacing = 24;\n\n  const rHeader = figma.createFrame();\n  rHeader.name = \"Reviews List Header\";\n  rHeader.resize(1240, 50);\n  rHeader.fills = [];\n  rHeader.layoutMode = \"HORIZONTAL\";\n  rHeader.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  rHeader.counterAxisAlignItems = \"CENTER\";\n\n  const rhTitleCol = figma.createFrame();\n  rhTitleCol.name = \"Title Col\";\n  rhTitleCol.fills = [];\n  rhTitleCol.layoutMode = \"HORIZONTAL\";\n  rhTitleCol.counterAxisAlignItems = \"BASELINE\";\n  rhTitleCol.itemSpacing = 8;\n\n  const rhTitle = figma.createText();\n  rhTitle.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n  rhTitle.fontSize = 24;\n  rhTitle.characters = \"All Reviews\";\n\n  const rhCount = figma.createText();\n  rhCount.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n  rhCount.fontSize = 14;\n  rhCount.characters = \"(451)\";\n  rhCount.fills = [{ type: 'SOLID', color: C.grayText }];\n\n  rhTitleCol.appendChild(rhTitle);\n  rhTitleCol.appendChild(rhCount);\n\n  const rhActions = figma.createFrame();\n  rhActions.name = \"Header Actions\";\n  rhActions.fills = [];\n  rhActions.layoutMode = \"HORIZONTAL\";\n  rhActions.counterAxisAlignItems = \"CENTER\";\n  rhActions.itemSpacing = 10;\n\n  // Filter circle button\n  const rfBtn = figma.createFrame();\n  rfBtn.name = \"Filter Option\";\n  rfBtn.resize(48, 48);\n  rfBtn.cornerRadius = 24;\n  rfBtn.fills = [{ type: 'SOLID', color: C.grayBg }];\n  rfBtn.layoutMode = \"HORIZONTAL\";\n  rfBtn.primaryAxisAlignItems = \"CENTER\";\n  rfBtn.counterAxisAlignItems = \"CENTER\";\n  rfBtn.appendChild(getInstance(\"Icon_Filter\", 20, 20));\n\n  // Sort dropdown\n  const rSort = figma.createFrame();\n  rSort.name = \"Sort Options\";\n  rSort.resize(120, 48);\n  rSort.cornerRadius = 62;\n  rSort.fills = [{ type: 'SOLID', color: C.grayBg }];\n  rSort.layoutMode = \"HORIZONTAL\";\n  rSort.primaryAxisAlignItems = \"CENTER\";\n  rSort.counterAxisAlignItems = \"CENTER\";\n  rSort.itemSpacing = 6;\n\n  const rst = figma.createText();\n  rst.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n  rst.fontSize = 14;\n  rst.characters = \"Latest\";\n  rSort.appendChild(rst);\n  rSort.appendChild(getInstance(\"Icon_Chevron_Down\", 16, 16));\n\n  // Write a Review\n  const writeBtn = figma.createFrame();\n  writeBtn.name = \"Button_WriteReview_Trigger\";\n  writeBtn.resize(160, 48);\n  writeBtn.cornerRadius = 62;\n  writeBtn.fills = [{ type: 'SOLID', color: C.black }];\n  writeBtn.layoutMode = \"HORIZONTAL\";\n  writeBtn.primaryAxisAlignItems = \"CENTER\";\n  writeBtn.counterAxisAlignItems = \"CENTER\";\n\n  const wbt = figma.createText();\n  wbt.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n  wbt.fontSize = 14;\n  wbt.characters = \"Write a Review\";\n  wbt.fills = [{ type: 'SOLID', color: C.white }];\n  writeBtn.appendChild(wbt);\n\n  rhActions.appendChild(rfBtn);\n  rhActions.appendChild(rSort);\n  rhActions.appendChild(writeBtn);\n\n  rHeader.appendChild(rhTitleCol);\n  rHeader.appendChild(rhActions);\n  reviewsSection.appendChild(rHeader);\n\n  // 6 Review Cards Grid (3 rows of 2 cards each)\n  const reviewsGrid = figma.createFrame();\n  reviewsGrid.name = \"Reviews Grid\";\n  reviewsGrid.resize(1240, 700);\n  reviewsGrid.fills = [];\n  reviewsGrid.layoutMode = \"VERTICAL\";\n  reviewsGrid.itemSpacing = 20;\n\n  function createDetailedReviewCard(ratingVal, name, quote, dateStr) {\n    const card = figma.createFrame();\n    card.name = \"Review Card\";\n    card.resize(610, 220);\n    card.cornerRadius = 20;\n    card.strokeWeight = 1;\n    card.strokes = [{ type: 'SOLID', color: C.grayBorder }];\n    card.fills = [{ type: 'SOLID', color: C.white }];\n    card.layoutMode = \"VERTICAL\";\n    card.itemSpacing = 10;\n    card.paddingLeft = 28;\n    card.paddingRight = 28;\n    card.paddingTop = 24;\n    card.paddingBottom = 24;\n\n    // Row 1: Stars + More Icon\n    const r1 = figma.createFrame();\n    r1.name = \"Row 1\";\n    r1.resize(554, 24);\n    r1.fills = [];\n    r1.layoutMode = \"HORIZONTAL\";\n    r1.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    r1.counterAxisAlignItems = \"CENTER\";\n\n    const stars = figma.createFrame();\n    stars.name = \"Stars Row\";\n    stars.fills = [];\n    stars.layoutMode = \"HORIZONTAL\";\n    stars.itemSpacing = 4;\n    const fullStars = Math.floor(ratingVal);\n    const hasHalf = (ratingVal % 1 !== 0);\n    for (let i = 0; i < 5; i++) {\n      if (i < fullStars) {\n        stars.appendChild(getInstance(\"Icon_Star\", 18, 18));\n      } else if (i === fullStars && hasHalf) {\n        stars.appendChild(getInstance(\"Icon_Star_Half\", 18, 18));\n      } else {\n        const emptyStar = getInstance(\"Icon_Star\", 18, 18);\n        emptyStar.fills = [{ type: 'SOLID', color: { r: 0.8, g: 0.8, b: 0.8 } }];\n        stars.appendChild(emptyStar);\n      }\n    }\n\n    r1.appendChild(stars);\n    r1.appendChild(getInstance(\"Icon_More\", 20, 20));\n\n    // Row 2: Name + Verified\n    const r2 = figma.createFrame();\n    r2.name = \"Row 2\";\n    r2.fills = [];\n    r2.layoutMode = \"HORIZONTAL\";\n    r2.counterAxisAlignItems = \"CENTER\";\n    r2.itemSpacing = 6;\n\n    const nt = figma.createText();\n    nt.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n    nt.fontSize = 18;\n    nt.characters = name;\n\n    r2.appendChild(nt);\n    r2.appendChild(getInstance(\"Icon_Verified\", 16, 16));\n\n    // Row 3: Quote\n    const quoteTxt = figma.createText();\n    quoteTxt.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    quoteTxt.fontSize = 14;\n    quoteTxt.characters = quote;\n    quoteTxt.fills = [{ type: 'SOLID', color: C.grayText }];\n    quoteTxt.resize(554, 70);\n\n    // Row 4: Posted Date\n    const dateTxt = figma.createText();\n    dateTxt.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n    dateTxt.fontSize = 13;\n    dateTxt.characters = `Posted on ${dateStr}`;\n    dateTxt.fills = [{ type: 'SOLID', color: C.grayText }];\n\n    card.appendChild(r1);\n    card.appendChild(r2);\n    card.appendChild(quoteTxt);\n    card.appendChild(dateTxt);\n\n    return card;\n  }\n\n  const quotes = [\n    { name: \"Samantha D.\", rating: 4.5, date: \"August 14, 2023\", text: \"“I absolutely love this t-shirt! The design is unique and the fabric feels so comfortable. As a fellow designer, I appreciate the attention to detail. It’s become my favorite go-to shirt.”\" },\n    { name: \"Alex M.\", rating: 4, date: \"August 15, 2023\", text: \"“The t-shirt exceeded my expectations! The colors are vibrant and the print quality is top-notch. Being a UI/UX designer myself, I’m quite picky about aesthetics, and this t-shirt definitely gets a thumbs up from me.”\" },\n    { name: \"Ethan R.\", rating: 3.5, date: \"August 16, 2023\", text: \"“This t-shirt is a must-have for anyone who appreciates good design. The minimalistic yet stylish pattern caught my eye, and the fit is perfect. I can see the designer’s touch in every aspect of this shirt.”\" },\n    { name: \"Olivia P.\", rating: 4, date: \"August 17, 2023\", text: \"“As a UI/UX enthusiast, I value simplicity and functionality. This t-shirt not only represents those principles but also feels great to wear. It’s evident that the designer poured their creativity into making this t-shirt stand out.”\" },\n    { name: \"Liam K.\", rating: 4, date: \"August 18, 2023\", text: \"“This t-shirt is a fusion of comfort and creativity. The fabric is soft, and the design speaks volumes about the designer’s skill. It’s like wearing a piece of art that reflects my passion for both design and fashion.”\" },\n    { name: \"Ava H.\", rating: 4.5, date: \"August 19, 2023\", text: \"“I’m not just wearing a t-shirt; I’m wearing a piece of design philosophy. The intricate details and thoughtful layout of the design make this shirt a conversation starter.”\" }\n  ];\n\n  function createReviewsRow(cList) {\n    const row = figma.createFrame();\n    row.name = \"Reviews Row\";\n    row.fills = [];\n    row.layoutMode = \"HORIZONTAL\";\n    row.itemSpacing = 20;\n    row.appendChild(cList[0]);\n    row.appendChild(cList[1]);\n    return row;\n  }\n\n  const rCards = quotes.map(q => createDetailedReviewCard(q.rating, q.name, q.text, q.date));\n  reviewsGrid.appendChild(createReviewsRow([rCards[0], rCards[1]]));\n  reviewsGrid.appendChild(createReviewsRow([rCards[2], rCards[3]]));\n  reviewsGrid.appendChild(createReviewsRow([rCards[4], rCards[5]]));\n\n  reviewsSection.appendChild(reviewsGrid);\n\n  // Load More Reviews Button\n  const loadMoreBox = figma.createFrame();\n  loadMoreBox.name = \"Load More Reviews Box\";\n  loadMoreBox.resize(1240, 52);\n  loadMoreBox.fills = [];\n  loadMoreBox.layoutMode = \"HORIZONTAL\";\n  loadMoreBox.primaryAxisAlignItems = \"CENTER\";\n\n  const loadMoreBtn = figma.createFrame();\n  loadMoreBtn.name = \"Load More Button\";\n  loadMoreBtn.resize(220, 52);\n  loadMoreBtn.cornerRadius = 62;\n  loadMoreBtn.strokeWeight = 1;\n  loadMoreBtn.strokes = [{ type: 'SOLID', color: C.grayBorder }];\n  loadMoreBtn.fills = [];\n  loadMoreBtn.layoutMode = \"HORIZONTAL\";\n  loadMoreBtn.primaryAxisAlignItems = \"CENTER\";\n  loadMoreBtn.counterAxisAlignItems = \"CENTER\";\n\n  const lmt = figma.createText();\n  lmt.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n  lmt.fontSize = 15;\n  lmt.characters = \"Load More Reviews\";\n  lmt.fills = [{ type: 'SOLID', color: C.black }];\n  loadMoreBtn.appendChild(lmt);\n  loadMoreBox.appendChild(loadMoreBtn);\n\n  reviewsSection.appendChild(loadMoreBox);\n  frameProd.appendChild(reviewsSection);\n\n  // YOU MIGHT ALSO LIKE (4 product cards)\n  const relatedSection = figma.createFrame();\n  relatedSection.name = \"Related Products Section\";\n  relatedSection.resize(1440, 550);\n  relatedSection.fills = [];\n  relatedSection.layoutMode = \"VERTICAL\";\n  relatedSection.primaryAxisAlignItems = \"CENTER\";\n  relatedSection.counterAxisAlignItems = \"CENTER\";\n  relatedSection.itemSpacing = 40;\n  relatedSection.paddingTop = 40;\n\n  const relTitle = figma.createText();\n  relTitle.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n  relTitle.fontSize = 40;\n  relTitle.characters = \"YOU MIGHT ALSO LIKE\";\n\n  const relGrid = figma.createFrame();\n  relGrid.name = \"Related Grid\";\n  relGrid.fills = [];\n  relGrid.layoutMode = \"HORIZONTAL\";\n  relGrid.itemSpacing = 20;\n\n  relGrid.appendChild(createProductCard(\"Photo_Polo_Contrast_Trims\", \"Polo with Contrast Trims\", 4.0, 212, 242, \"-20%\"));\n  relGrid.appendChild(createProductCard(\"Photo_Gradient_Graphic_TShirt\", \"Gradient Graphic T-shirt\", 3.5, 145));\n  relGrid.appendChild(createProductCard(\"Photo_Polo_Tipping_Details\", \"Polo with Tipping Details\", 4.5, 180));\n  relGrid.appendChild(createProductCard(\"Photo_Black_Striped_TShirt\", \"Black Striped T-shirt\", 5.0, 120, 150, \"-30%\"));\n\n  relatedSection.appendChild(relTitle);\n  relatedSection.appendChild(relGrid);\n  frameProd.appendChild(relatedSection);\n\n  // Newsletter & Footer\n  const footerArea = figma.createFrame();\n  footerArea.name = \"Footer Area\";\n  footerArea.resize(1440, 520);\n  footerArea.fills = [];\n  footerArea.layoutMode = \"VERTICAL\";\n  footerArea.itemSpacing = -100;\n\n  footerArea.appendChild(createNewsletter());\n  footerArea.appendChild(createFooter());\n  frameProd.appendChild(footerArea);\n\n  frameProd.x = 3200;\n\n  wsPage.appendChild(frameProd);\n  return `03_Product frame successfully created!`;\n})()","description":"Build the complete \"03_Product\" frame containing product breadcrumbs, detailed picture gallery, purchase controls/stepper, specifications tabs, full list of 6 reviews, and related products area.","fileKey":"E9n8kgrlAPnHZ6rsWuAsab"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":71800,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"bcf2aede-586f-4d33-b1b0-5af74b634ee8","uuid":"54b7761c-95c6-4aec-ae34-95ba5c68115f","timestamp":"2026-11-01T19:58:25.784Z","tool_use_meta":[{"id":"call_ac1762957fae4c5385aac92d20c0ee32","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
