rimaryAxisSizingMode='AUTO';b.counterAxisSizingMode='FIXED';b.paddingLeft=16;b.paddingRight=16;b.paddingTop=12;b.itemSpacing=16;return b;}\n\n// ================= 03 Detail Saham =================\nconst s3=screen('03_Detail_Saham',840);\nawait inst('1:30',s3);\nconst h3=await inst('7:28',s3);h3.x=0;h3.y=44;\n// stock identity\nconst idb=box('Identity',375,96,null);idb.x=0;idb.y=100;idb.layoutMode='HORIZONTAL';idb.primaryAxisSizingMode='FIXED';idb.counterAxisSizingMode='FIXED';\nidb.paddingLeft=16;idb.paddingRight=16;idb.paddingTop=4;idb.itemSpacing=12;idb.counterAxisAlignItems='CENTER';\nconst logo3=await inst('3:45',idb,44,44);logo3.cornerRadius=22;logo3.clipsContent=true;\nconst idText=box('Names',0,60,null);idText.layoutMode='VERTICAL';idText.primaryAxisSizingMode='AUTO';idText.counterAxisSizingMode='AUTO';idText.layoutGrow=1;idText.itemSpacing=1;idb.appendChild(idText);\ntext(idText,'Ticker','GOTO',C.text,18,'Semi Bold',24);\ntext(idText,'Name','GoTo Gojek Tokopedia',C.text3,12,'Regular',16);\nconst idRight=box('Price block',0,60,null);idRight.layoutMode='VERTICAL';idRight.primaryAxisSizingMode='AUTO';idRight.counterAxisSizingMode='AUTO';idRight.counterAxisAlignItems='MAX';idRight.itemSpacing=1;idb.appendChild(idRight);\ntext(idRight,'Price','Rp189',C.text,24,'Bold',30);\ntext(idRight,'Change','−Rp9 (−4,55%)',C.loss,12,'Medium',16);\nconst dayRow=box('Hari ini',375,22,null);dayRow.x=0;dayRow.y=196;dayRow.layoutMode='HORIZONTAL';dayRow.paddingLeft=16;dayRow.paddingRight=16;dayRow.primaryAxisSizingMode='FIXED';dayRow.counterAxisSizingMode='FIXED';dayRow.primaryAxisAlignItems='SPACE_BETWEEN';\ntext(dayRow,'Left','Hari ini',C.text2,12,'Regular',16);\nconst up=await inst('2:13',dayRow,12,12);for(const v of up.findAll(n=>n.type==='VECTOR')){v.fills=paint(C.loss);}\n\n// body\nconst b3=body(s3,712);b3.y=218;b3.paddingTop=8;s3.appendChild(b3);\n\n// chart card\nconst chartCard=box('Chart card',343,232,C.surface,16);b3.appendChild(chartCard);\nchartCard.layoutMode='NONE';\nconst pts=[[197,'6:00'],[199,'10:00'],[194,'14:00'],[196,'18:00'],[192,'22:00'],[189,'2:00']];\nconst px=16, pw=311, plotTop=28, plotH=140;\nconst minV=186,maxV=202;\nconst coords=pts.map((p,i)=>{const x=px+(pw/(pts.length-1))*i;const y=plotTop+plotH-((p[0]-minV)/(maxV-minV))*plotH;return [x,y];});\n// grid lines\nfor(let i=0;i<=3;i++){const gy=plotTop+ (plotH/3)*i;const gl=box('Grid',pw,1,C.surface3,0);chartCard.appendChild(gl);gl.x=px;gl.y=gy;gl.opacity=0.6;}\n// area fill\nlet dArea='M '+coords[0][0]+' '+(plotTop+plotH)+' ';\nfor(const c of coords) dArea+='L '+c[0].toFixed(1)+' '+c[1].toFixed(1)+' ';\ndArea+='L '+coords[coords.length-1][0]+' '+(plotTop+plotH)+' Z';\nconst area=figma.createVector();area.name='Area';area.vectorPaths=[{windingRule:'NONZERO',data:dArea}];\narea.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{...rgb(C.brand),a:0.28}},{position:1,color:{...rgb(C.brand),a:0}}]}];\nchartCard.appendChild(area);\nlet dLine='M '+coords[0][0]+' '+coords[0][1]+' ';\nfor(const c of coords.slice(1)) dLine+='L '+c[0].toFixed(1)+' '+c[1].toFixed(1)+' ';\nconst line=figma.createVector();line.name='Price line';line.vectorPaths=[{windingRule:'NONZERO',data:dLine}];\nline.strokes=[{type:'SOLID',color:rgb(C.text)}];line.strokeWeight=2;line.fills=[];\nchartCard.appendChild(line);\n// highlighted point at 22:00 (index 4)\nconst hp=coords[4];\nconst dot=box('Point',10,10,C.text,5);chartCard.appendChild(dot);dot.x=hp[0]-5;dot.y=hp[1]-5;\nconst dot2=box('Point ring',18,18,C.brand,9);dot2.opacity=0.25;chartCard.appendChild(dot2);dot2.x=hp[0]-9;dot2.y=hp[1]-9;\nconst vline=box('Guide',1,plotH,C.surface3,0);chartCard.appendChild(vline);vline.x=hp[0];vline.y=plotTop;vline.opacity=0.8;\n// tooltip\nconst tip=box('Tooltip',152,62,C.surface3,10);chartCard.appendChild(tip);tip.x=hp[0]-76;tip.y=hp[1]-74;\ntip.layoutMode='VERTICAL';tip.primaryAxisSizingMode='FIXED';tip.counterAxisSizingMode='FIXED';tip.paddingLeft=10;tip.paddingTop=8;tip.itemSpacing=2;\ntext(tip,'Val','Rp192',C.text,14,'Semi Bold',18);\ntext(tip,'Time','28 Okt 2022 - 22:00',C.text2,10,'Regular',13);\ntext(tip,'Vol','Volume: 102K',C.text3,10,'Regular',13);\n// axis labels\nconst axis=box('Axis',343,20,null);chartCard.appendChild(axis);axis.x=0;axis.y=190;\naxis.layoutMode='HORIZONTAL';axis.primaryAxisSizingMode='FIXED';axis.counterAxisSizingMode='FIXED';axis.paddingLeft=16;axis.paddingRight=16;axis.primaryAxisAlignItems='SPACE_BETWEEN';\nfor(const p of pts){text(axis,'T',p[1],C.text3,10,'Regular',13);}\n\n// range tabs\nconst ranges=box('Range tabs',343,34,null);ranges.layoutMode='HORIZONTAL';ranges.primaryAxisSizingMode='FIXED';ranges.counterAxisSizingMode='FIXED';ranges.itemSpacing=6;b3.appendChild(ranges);\nfor(const r of ['1D','5D','1M','6M','YTD','1Y','5Y','MAX']){\n  const on=r==='1D';\n  const c=box('Range '+r,0,34,on?C.brand:null,10);ranges.appendChild(c);\n  c.layoutMode='HORIZONTAL';c.primaryAxisSizingMode='AUTO';c.counterAxisSizingMode='FIXED';c.primaryAxisAlignItems='CENTER';c.counterAxisAlignItems='CENTER';c.paddingLeft=12;c.paddingRight=12;\n  text(c,'Label',r,on?'#FFFFFF':C.text2,12,on?'Medium':'Regular',16);\n}\n\n// actions\nconst acts=box('Actions',343,48,null);acts.layoutMode='HORIZONTAL';acts.primaryAxisSizingMode='FIXED';acts.counterAxisSizingMode='FIXED';acts.itemSpacing=10;b3.appendChild(acts);\nconst beli=await inst('8:4',acts,166,48);beli.resize(166,48);beli.layoutGrow=1;setT(beli,'Label','Beli');\nconst jual=await inst('8:8',acts,166,48);jual.resize(166,48);jual.layoutGrow=1;setT(jual,'Label','Jual');\n\n// compare\nconst cmpHead=box('Compare header',343,22,null);cmpHead.layoutMode='HORIZONTAL';cmpHead.primaryAxisSizingMode='FIXED';cmpHead.counterAxisSizingMode='FIXED';b3.appendChild(cmpHead);\ntext(cmpHead,'Title','Dibandingkan dengan',C.text,15,'Medium',20);\nconst cmp=box('Compare list',343,168,null);cmp.layoutMode='VERTICAL';cmp.primaryAxisSizingMode='AUTO';cmp.counterAxisSizingMode='FIXED';cmp.itemSpacing=0;b3.appendChild(cmp);\nconst cdata=[['Bukalapak Tbk','BUKA','Rp276','+2,82%',true],['Bank Rakyat Indonesia','BBRI','Rp4.630','+0,83%',true],['PT Industri Jamu','SIDO','Rp740','+2,82%',true]];\nfor(const d of cdata){\n  const r=box('Compare row',343,56,null);r.layoutMode='HORIZONTAL';r.primaryAxisSizingMode='FIXED';r.counterAxisSizingMode='FIXED';r.counterAxisAlignItems='CENTER';cmp.appendChild(r);\n  const badge=box('Badge',34,34,C.surface2,17);r.appendChild(badge);badge.layoutMode='HORIZONTAL';badge.primaryAxisAlignItems='CENTER';badge.counterAxisAlignItems='CENTER';\n  text(badge,'B',d[1][0],C.text2,12,'Bold',15);\n  const mid=box('Text',0,34,null);mid.layoutMode='VERTICAL';mid.primaryAxisSizingMode='AUTO';mid.counterAxisSizingMode='AUTO';mid.layoutGrow=1;mid.itemSpacing=1;r.appendChild(mid);\n  text(mid,'Company',d[0],C.text,13,'Regular',17);\n  text(mid,'Ticker',d[1],C.text3,10,'Regular',13);\n  const rt=box('Vals',0,34,null);rt.layoutMode='VERTICAL';rt.primaryAxisSizingMode='AUTO';rt.counterAxisSizingMode='AUTO';rt.counterAxisAlignItems='MAX';rt.itemSpacing=1;r.appendChild(rt);\n  text(rt,'Price',d[2],C.text,13,'Medium',17);\n  text(rt,'Change',d[3],C.gain,10,'Medium',13);\n}\n\n// keystats\nconst ksHead=box('Keystats header',343,22,null);ksHead.layoutMode='HORIZONTAL';ksHead.primaryAxisSizingMode='FIXED';ksHead.counterAxisSizingMode='FIXED';b3.appendChild(ksHead);\ntext(ksHead,'Title','Keystats',C.text,15,'Medium',20);\nconst ksData=[['Previous Close','Rp198'],['Day Range','Rp188 - Rp199'],['Year Range','Rp180 - Rp396'],['Market Cap','694,70T IDR'],['AVG Volume','167,58M'],['P/E Ratio','15,50'],['Dividend Yield','3,76%'],['Primary Exchange','IDX']];\nconst ksList=box('Keystats list',343,272,null);ksList.layoutMode='VERTICAL';ksList.primaryAxisSizingMode='AUTO';ksList.counterAxisSizingMode='FIXED';b3.appendChild(ksList);\nfor(const d of ksData){const r=await inst('20:384',ksList,343,34);setT(r,'Label',d[0]);setT(r,'Value',d[1]);}\n\nreturn '03 