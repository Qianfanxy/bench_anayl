teInstanceAsync)\nasync function instOf(node,parent){ const i = await node.createInstanceAsync(); parent.appendChild(i); return i; }\n\n// status bar + home indicator instances\nconst sb = await instOf(srcSB,f); sb.x=0; sb.y=0;\nconst hi = await instOf(srcHI,f); hi.x=0; hi.y=778;\n\n// helper: text\nasync function txt(parent,chars,font,size,color,x,y){\n const t=figma.createText(); await figma.loadFontAsync(font);\n t.fontName=font; t.characters=chars; t.fontSize=size; t.fills=[solid(color)];\n parent.appendChild(t); t.x=x; t.y=y; return t;\n}\n// helper: rounded rect\nfunction rr(parent,w,h,x,y,fill,radius){\n const r=figma.createRectangle(); parent.appendChild(r);\n r.resize(w,h); r.x=x; r.y=y; r.cornerRadius=radius;\n if(fill) r.fills=[solid(fill)]; else r.fills=[];\n return r;\n}\n// icon instance helper\nasync function icon(id,parent,x,y,size){\n const src=await figma.getNodeByIdAsync(id);\n const i=await src.createInstanceAsync(); parent.appendChild(i);\n const s=size/src.width; i.rescale(s); i.x=x; i.y=y; return i;\n}\n// logo circle: ellipse clip container w/ logo instance inside\nasync function logoCircle(id,parent,cx,cy,d){\n const src=await figma.getNodeByIdAsync(id);\n const i=await src.createInstanceAsync(); parent.appendChild(i);\n const s=d/src.width; i.rescale(s); i.x=cx; i.y=cy; i.cornerRadius=d/2; i.clipsContent=true;\n return i;\n}\nglobalThis.__ctx={f,C,txt,rr,icon,logoCircle,BTN,TF,SB,HI,srcBtn,srcTF,srcSB,srcHI,FONT_R,FONT_M,FONT_B,instOf};\n\n// ---------- HEADER ----------\nawait txt(f,'Aktivitas',FONT_B,20,C.text,16,58);\nawait icon('2:4',f,299,56,24);   // menu\nawait icon('2:7',f,339,56,24);   // settings\n\n// ---------- BALANCE CARD ----------\nconst card=rr(f,343,150,16,96,C.surface,12);\nawait txt(f,'Dana Utama',FONT_R,12,C.textSec,32,112);\nawait txt(f,'Rp2.125.000',FONT_B,24,C.text,32,130);\n// change pill\nconst pill=rr(f,150,22,32,166,{r:0.106,g:0.24,b:0.145},11);\nawait txt(f,'▲ Rp206.920 (10,79%)',FONT_M,11,C.up,40,171);\n// actions\nconst dep=rr(f,165,44,16,210,C.brand,10);\nconst wdr=rr(f,165,44,194,210,C.surfaceHi,10);\nwdr.strokes=[solid(C.stroke)]; wdr.strokeWeight=1;\nawait icon('2:20',f,62,222,20);\nawait txt(f,'Deposit',FONT_M,14,{r:1,g:1,b:1},88,224);\nawait icon('2:27',f,240,222,20);\nawait txt(f,'Tarik',FONT_M,14,C.text,266,224);\nreturn 'frame+shell+header+balance ok · f.id='+f.id;","description":"Set up workspace: clone Button/TextField/shell, create 01_Aktivitas frame, header and balance card"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"941e9e8f-9f13-404f-85a0-b0b25ea4fd23","uuid":"2913728e-f277-49aa-b7ef-24df54ce0bfe","timestamp":"2026-10-31T22:16:19.739Z","tool_use_meta":[{"id":"mcp__figma__use_figma_12_e6ba6e70","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
