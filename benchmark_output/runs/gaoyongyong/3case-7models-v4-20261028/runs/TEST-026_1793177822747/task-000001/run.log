c.resize(size,size); } ic.x=x; ic.y=y; if(color) paint(ic,color); return ic; }\nasync function cmpInst(parent, compId, x, y){ const c = await figma.getNodeByIdAsync(compId); const i = c.createInstance(); parent.appendChild(i); i.x=x; i.y=y; return i; }\nasync function scr(name,x,y){ const f=figma.createFrame(); f.name=name; f.resize(375,812); f.x=x; f.y=y; f.fills=S(C.bg); ws.appendChild(f); await cmpInst(f,A.statusBar,0,0); await cmpInst(f,A.homeInd,0,778); return f; }\nasync function backBtn(parent,x,y){ const b=figma.createFrame(); b.name='Btn / Back'; parent.appendChild(b); b.resize(44,44); b.x=x; b.y=y; b.fills=S(C.white); b.cornerRadius=22; b.strokes=S(C.line); b.strokeWeight=1; b.strokeAlign='INSIDE'; await icon(b,A.iconBack,12,12,20,C.ink); return b; }\n\n// ================= 11_Send =================\nconst f11 = await scr('11_Send', 450, 900);\nawait backBtn(f11, 24, 56);\nconst t11 = await T(f11,'Send',17,700,C.ink,0,0); t11.textAutoResize='NONE'; t11.resize(160,24); t11.textAlignHorizontal='CENTER'; t11.x=80; t11.y=66;\nconst av11 = (await figma.getNodeByIdAsync(A.avatar)).createInstance(); f11.appendChild(av11); av11.resize(44,44); av11.x=307; av11.y=56;\n// Recipient card\nconst rc = figma.createFrame(); rc.name='Recipient'; f11.appendChild(rc);\nrc.resize(327,72); rc.x=24; rc.y=116; rc.fills=S(C.white); rc.cornerRadius=20;\nconst rAv = (await figma.getNodeByIdAsync(A.avatar)).createInstance(); rc.appendChild(rAv); rAv.resize(44,44); rAv.x=14; rAv.y=14;\nawait T(rc,'Bessie Cooper',14,700,C.ink,70,16);\nawait T(rc,'**** **** **** 8820',11,400,C.gray,70,38);\nconst chg = figma.createFrame(); chg.name='Change'; rc.appendChild(chg); chg.resize(66,28); chg.x=247; chg.y=22; chg.fills=S(C.soft); chg.cornerRadius=14;\nconst chT = await T(chg,'Change',10,600,C.deep,0,0); chT.x=(66-chT.width)/2; chT.y=(28-chT.height)/2;\n// Amount\nconst amt = await T(f11,'$500.00',40,700,C.ink,0,0); amt.textAutoResize='NONE'; amt.resize(327,52); amt.textAlignHorizontal='CENTER'; amt.x=24; amt.y=224;\n// Keypad\nconst kp = figma.createFrame(); kp.name='Number Pad'; f11.appendChild(kp);\nkp.resize(327,240); kp.x=24; kp.y=300; kp.fills=[];\nconst keys = ['1','2','3','4','5','6','7','8','9','.','0','⌫'];\nfor(let i=0;i<12;i++){\n  const col=i%3, row=Math.floor(i/3);\n  const k=figma.createFrame(); k.name='Key / '+keys[i]; kp.appendChild(k);\n  k.resize(101,52); k.x=col*113; k.y=row*62; k.fills=S(C.white); k.cornerRadius=14;\n  const kt = await T(k, keys[i], 18, 600, C.ink, 0, 0); kt.x=(101-kt.width)/2; kt.y=(52-kt.height)/2;\n}\n// Send button\nconst sendBtn = figma.createFrame(); sendBtn.name='Btn / Send'; f11.appendChild(sendBtn);\nsendBtn.resize(327,52); sendBtn.x=24; sendBtn.y=570; sendBtn.fills=S(C.pri); sendBtn.cornerRadius=26;\nconst sbT = await T(sendBtn,'Send',15,600,C.ink,0,0); sbT.x=(327-sbT.width)/2; sbT.y=(52-sbT.height)/2;\n\n// ================= 06_Discussion_Forum =================\nconst A2 = { iconMessage:'2006:245', iconBell:'2006:240', iconSearch:'2006:287', iconFilter:'2006:292',\n  iconComment:'2006:310', iconLike:'2006:314', iconDislike:'2006:319', iconVerified:'2006:322', iconMoreH:'2006:298' };\nconst f06 = await scr('06_Discussion_Forum', 900, 900);\nawait backBtn(f06, 24, 56);\nconst t06 = await T(f06,'Discussion Forum',17,700,C.ink,0,0); t06.textAutoResize='NONE'; t06.resize(220,24); t06.textAlignHorizontal='CENTER'; t06.x=78; t06.y=66;\nasync function hdBtn(parent,name,x,icId){ const b=figma.createFrame(); b.name='Btn / '+name; parent.appendChild(b); b.resize(36,36); b.x=x; b.y=60; b.fills=S(C.white); b.cornerRadius=18; b.strokes=S(C.line); b.strokeWeight=1; b.strokeAlign='INSIDE'; await icon(b,icId,9,9,18,C.ink); return b; }\nawait hdBtn(f06,'Messages',271,A2.iconMessage);\nawait hdBtn(f06,'Notifications',315,A2.iconBell);\n// Search + filter\nconst sb = figma.createFrame(); sb.name='Search'; f06.appendChild(sb);\nsb.resize(263,44); sb.x=24; sb.y=112; sb.fills=S(C.white); sb.cornerRadius=22; sb.strokes=S(C.line);