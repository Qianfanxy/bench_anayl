(T('Bayar Sebelum',11,'Regular',C.ter));\ncd.appendChild(T('Minggu, 30 Oktober 2022, 13:32 WIB',13,'Medium',C.txt));\ncd.appendChild(T('00 : 08 : 46',26,'Bold',C.brand));\n\nconst pc=figma.createFrame(); pc.name='Payment Details'; pc.fills=[solid(C.s1)]; pc.cornerRadius=12; pc.layoutMode='VERTICAL'; pc.paddingLeft=14; pc.paddingRight=14; pc.paddingTop=14; pc.paddingBottom=14; pc.itemSpacing=10;\nf.appendChild(pc); pc.x=16; pc.y=253;\nconst rows=[['No Transaksi','FD8U4J38J004093J8U80TJ039','Type=Basic'],['Nominal','Rp500.000','Type=Basic'],['Kode Pembayaran','1111000065665144','Type=Copy']];\nfor (const [l,v,vr] of rows){\n  const vcomp=R.prow.children.find(c=>c.name===vr);\n  const i=vcomp.createInstance(); pc.appendChild(i);\n  txt(i,'Label').characters=l; txt(i,'Value').characters=v;\n}\n\nconst st=R.sect.createInstance(); f.appendChild(st); st.x=16; st.y=416; txt(st,'Title').characters='Panduan Pembayaran';\n\nconst steps=[\n'Catat kode pembayaran di atas dan datang ke gerai Alfamart, Alfa Midi, Lawson atau DAN+DAN terdekat.',\n'Beritahukan ke kasir bahwa Anda ingin melakukan pembayaran.',\n'Kasir akan menanyakan kode pembayaran. Berikan kode pembayaran Anda 1111000065665144.',\n'Kasir akan melakukan konfirmasi data konsumen berupa Nama Merchant, Nama Konsumen, dan Nominal. Lakukan pembayaran ke kasir sejumlah nominal yang disebutkan.',\n'Terima struk sebagai bukti pembayaran sudah sukses dilakukan. Notifikasi pembayaran akan langsung diterima oleh Merchant.',\n'Selesai.'\n];\nsteps.forEach((s,i)=>{\n  const g=R.gstep.createInstance(); f.appendChild(g); g.x=16; g.y=442+i*(0);\n  txt(g,'NumText').characters=String(i+1);\n  const b=txt(g,'Body'); b.characters=s; b.lineHeight={value:15,unit:'PIXELS'};\n});\n// stack guides by measuring heights\nlet gy=442;\nfor (let i=0;i<steps.length;i++){\n  const g=f.children.filter(n=>n.name==='Guide Step')[i];\n  g.y=gy; gy+=g.height+6;\n}\n\nconst bar=figma.createFrame(); bar.name='Action Bar'; bar.fills=[solid(C.s1)]; bar.str