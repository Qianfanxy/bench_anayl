{}; for(const k in inst.componentProperties){const b=k.split('#')[0]; if(vals[b]!==undefined) m[k]=vals[b];} inst.setProperties(m);}\nasync function sectionTitle(t,aside){const r=AL('Section title · '+t,'HORIZONTAL',{w:335,ps:'FIXED',cs:'AUTO',pa:'SPACE_BETWEEN',pad:[8,0,0,0]}); r.appendChild(await T(t,'Heading/20 Bold','text/primary')); if(aside) r.appendChild(await T(aside,'Label/13 Medium','text/secondary')); return r;}\nfunction screen(name,x,h){const f=figma.createFrame(); f.name=name; f.resize(375,h); f.x=x; f.y=0; f.fills=[P('bg/canvas')]; f.clipsContent=true; return f;}\nfunction shell(f,hdr,title){const s=C.status.createInstance(); f.appendChild(s); s.x=0;s.y=0; const h=hdr.createInstance(); h.name='Header'; setP(h,{Title:title}); f.appendChild(h); h.x=0; h.y=44; return h;}\nfunction content(f){const c=AL('Content','VERTICAL',{w:375,ps:'AUTO',cs:'FIXED',gap:16,ca:'CENTER',pad:[8,20,24,20]}); f.appendChild(c); c.x=0; c.y=100; return c;}\nfunction tab(f){const t=C.tabbar.createInstance(); t.name='Tab Bar'; f.appendChild(t); t.x=0; t.y=f.height-t.height; f.numberOfFixedChildren=1; return t;}\nconst ids={};\n// ---- 01\nlet f=screen('01_Expenses',0,1400); shell(f,C.hdrAdd,'Expenses'); let c=content(f);\nconst per=AL('Period','VERTICAL',{w:335,ps:'AUTO',cs:'FIXED',gap:12,ca:'MIN'}); c.appendChild(per);\nconst pp=C.period.createInstance(); pp.name='Period Picker'; per.appendChild(pp);\nconst tot=AL('Total spent','VERTICAL',{gap:0,ca:'MIN'}); per.appendChild(tot);\ntot.appendChild(await T('Total spent','Label/13 Medium','text/secondary'));\nconst big=await T('$1,812','Display/40 Bold','text/primary'); tot.appendChild(big);\nconst bud=C.budget.createInstance(); c.appendChild(bud);\nconst cr=C.credit.createInstance(); cr.name='Credit Score Entry'; c.appendChild(cr);\nc.appendChild(await sectionTitle('Categories','Budget · Spent'));\nconst ca=C.catAuto.createInstance(); ca.name='Category · Auto & transport'; c.appendChild(ca);\nconst cb=C.catBill.createInstance(); cb.name='Category · Bill & Utilities'; c.appendChild(cb);\nconst mo=C.more.createInstance(); mo.name='More categories'; c.appendChild(mo);\nf.resize(375, 100 + c.height + 88);\ntab(f); f.overflowDirection='VERTICAL'; ids.s1=f.id; ids.billCard=cb.id; ids.credit=cr.id;\n// ---- 02\nf=screen('02_Bill',440,812); let h=shell(f,C.hdrAdd,'Bill'); c=content(f); c.itemSpacing=16;\nconst sg=C.seg.createInstance(); sg.name='Segmented Control'; c.appendChild(sg);\nconst sm=C.subSum.createInstance(); c.appendChild(sm);\nc.appendChild(await sectionTitle('Subscriptions','4 active'));\nconst list=AL('Subscription list','VERTICAL',{w:335,ps:'AUTO',cs:'FIXED',gap:10}); c.appendChild(list);\nconst subs=[['Patreon membership','$19.99/mo','2:15'],['Netflix','$12/mo','2:14'],['Apple payment','$19.99/mo','2:13'],['Spotify','$6.99/mo','2:16']];\nfor (const [n,p,l] of subs){const r=C.subRow.createInstance(); r.name='Subscription · '+n; list.appendChild(r); const m={}; for(const k in r.componentProperties){const b=k.split('#')[0]; if(b==='Service')m[k]=n; if(b==='Price')m[k]=p; if(b==='Logo')m[k]=l;} r.setProperties(m);}\ntab(f); ids.s2=f.id; ids.back2=h.findOne(n=>n.name==='Back').id;\n// ---- 03\nf=screen('03_Credit_Score',880,812); h=shell(f,C.hdrNone,'Credit Score'); c=content(f);\nconst card=AL('Score card','VERTICAL',{w:335,ps:'AUTO',cs:'FIXED',gap:0,ca:'CENTER',pad:[16,20,20,20],r:24,fill:'bg/surface'}); card.effectStyleId=(await figma.getLocalEffectStylesAsync()).find(s=>s.name==='Elevation/1 Card').id; c.appendChild(card);\nconst gi=C.gauge.createInstance(); card.appendChild(gi);\nc.appendChild(await sectionTitle('Score factors','3 factors'));\nconst fl=AL('Factor list','VERTICAL',{w:335,ps:'AUTO',cs:'FIXED',gap:10}); c.appendChild(fl);\nfor (const [n,v,r,d] of [['On-time payments','95%','Good','1 missed'],['Credit Utilization','95%','Not bad','-15%'],['Age of credit','8 years','Good','Average age of your accounts']]){const i=(r==='Good'?C.fGood:C.fNot).createInstance(); i.name='Facto