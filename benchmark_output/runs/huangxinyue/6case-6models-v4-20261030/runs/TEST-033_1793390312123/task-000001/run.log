\"children\": [\n      {\n        \"id\": \"6:26\",\n        \"name\": \"GET STARTED\",\n        \"type\": \"TEXT\"\n      }\n    ]\n  },\n  \"textField\": {\n    \"id\": \"6:28\",\n    \"name\": \"Text Field\",\n    \"type\": \"COMPONENT\",\n    \"width\": 342,\n    \"height\": 48,\n    \"children\": [\n      {\n        \"id\": \"6:29\",\n        \"name\": \"Search\",\n        \"type\": \"TEXT\"\n      }\n    ]\n  },\n  \"statusBar\": {\n    \"id\": \"6:32\",\n    \"name\": \"Status Bar\",\n    \"type\": \"COMPONENT\",\n    \"width\": 390,\n    \"height\": 44,\n    \"children\": [\n      {\n        \"id\": \"6:33\",\n        \"name\": \"9:41\",\n        \"type\": \"TEXT\"\n      },\n      {\n        \"id\": \"6:34\",\n        \"name\": \"Signal\",\n        \"type\": \"FRAME\"\n      },\n      {\n        \"id\": \"6:39\",\n        \"name\": \"Wifi\",\n        \"type\": \"ELLIPSE\"\n      },\n      {\n        \"id\": \"6:40\",\n        \"name\": \"Battery\",\n        \"type\": \"FRAME\"\n      }\n    ]\n  },\n  \"homeIndicator\": {\n    \"id\": \"6:42\",\n    \"name\": \"Home Indicator\",\n    \"type\": \"COMPONENT\",\n    \"width\": 390,\n    \"height\": 34,\n    \"children\": [\n      {\n        \"id\": \"6:43\",\n        \"name\": \"Rectangle\",\n        \"type\": \"RECTANGLE\"\n      }\n    ]\n  }\n}"}],"_meta":{"mcpRequestId":"d72ae4f5-bc86-4bdc-bd8f-b967f8f212ea"}},"tool_result_meta":[{"id":"call_fcb21fb110a540d4a27026e1047b1845","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"id":"chatcmpl-202610302001144500823758268d9d6WGSiIAao","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_5b36fe387dd04ddeafc10453c5d0c5e3","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  // Ensure we are on Workspace page\n  let workspace = figma.root.children.find(p => p.name.includes(\"03 · Workspace\") || p.id === \"8:2\");\n  if (!workspace) {\n    workspace = figma.createPage();\n    workspace.name = \"03 · Workspace\";\n  }\n  await figma.setCurrentPageAsync(workspace);\n\n  // Helper function to clone an icon/component by node id or name\n  function getComponent(idOrName) {\n    let node = figma.getNodeById(idOrName);\n    if (!node) {\n      for (const page of figma.root.children) {\n        const found = page.findOne(n => n.name === idOrName);\n        if (found) { node = found; break; }\n      }\n    }\n    if (node) {\n      if (node.type === \"COMPONENT\") return node.createInstance();\n      if (node.type === \"FRAME\" || node.type === \"COMPONENT_SET\") return node.clone();\n    }\n    return null;\n  }\n\n  // Load fonts\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"SemiBold\" });\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Bold\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Bold\" });\n\n  // Colors\n  const BRAND = { r: 0.082, g: 0.451, b: 0.996 }; // #1573FE\n  const BG_LIGHT = { r: 0.97, g: 0.975, b: 0.985 }; // #F7F8FC\n  const SURFACE_WHITE = { r: 1, g: 1, b: 1 };\n  const TEXT_MAIN = { r: 0.08, g: 0.1, b: 0.15 }; // #141A26\n  const TEXT_MUTED = { r: 0.5, g: 0.55, b: 0.62 }; // #808C9E\n  const GAIN = { r: 0.06, g: 0.72, b: 0.51 }; // #10B981\n  const LOSS = { r: 0.94, g: 0.27, b: 0.27 }; // #EF4444\n  const BORDER_COLOR = { r: 0.9, g: 0.92, b: 0.94 };\n\n  // Reusable component builders for bottom navs\n  // 1. Bank Nav Component\n  function createBankNavComponent(activeTab) {\n    const nav = figma.createFrame();\n    nav.name = `Bank_Bottom_Nav_${activeTab}`;\n    nav.resize(390, 84);\n    nav.fills = [{ type: \"SOLID\", color: SURFACE_WHITE }];\n    nav.layoutMode = \"HORIZONTAL\";\n    nav.primaryAxisSizingMode = \"FIXED\";\n    nav.counterAxisSizingMode = \"FIXED\";\n    nav.paddingTop = 8;\n    nav.paddingBottom = 24;\n    nav.itemSpacing = 0;\n    nav.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    nav.counterAxisAlignItems = \"CENTER\";\n\n    const tabs = [\n      { id: \"Trans\", label: \"Trans.\", icon: \"Icon_Tab_Transactions\" },\n      { id: \"Feeds\", label: \"Feeds\", icon: \"Icon_Tab_Feeds\" },\n      { id: \"Home\", label: \"Home\", icon: \"Icon_Tab_Home\" },\n      { id: \"Wallet\", label: \"Wallet\", icon: \"Icon_Tab_Wallet\" },\n      { id: \"Profile\", label: \"Profile\", icon: \"Icon_Tab_Profile\" }\n    ];\n\n    tabs.forEach(tab => {\n      const tabFrame = figma.createFrame();\n      tabFrame.name = `Tab_${tab.id}`;\n      tabFrame.resize(78, 52);\n      tabFrame.fills = [];\n      tabFrame.layoutMode = \"VERTICAL\";\n      tabFrame.counterAxisAlignItems = \"CENTER\";\n      tabFrame.primaryAxisAlignItems = \"CENTER\";\n      tabFrame.itemSpacing = 4;\n\n      const isActive = tab.id === activeTab;\n\n      // Icon\n      const iconInst = getComponent(tab.icon);\n      if (iconInst) {\n        tabFrame.appendChild(iconInst);\n      }\n\n      // Text\n      const text = figma.createText();\n      text.fontName = { family: \"Poppins\", style: isActive ? \"SemiBold\" : \"Regular\" };\n      text.fontSize = 11;\n      text.characters = tab.label;\n      text.fills = [{ type: \"SOLID\", color: isActive ? BRAND : TEXT_MUTED }];\n      tabFrame.appendChild(text);\n\n      nav.appendChild(tabFrame);\n    });\n\n    return nav;\n  }\n\n  // 2. Trade Nav Component\n  function createTradeNavComponent(activeTab) {\n    const nav = figma.createFrame();\n    nav.name = `Trade_Bottom_Nav_${activeTab}`;\n    nav.resize(390, 84);\n    nav.fills = [{ type: \"SOLID\", color: SURFACE_WHITE }];\n    nav.layoutMode = \"HORIZONTAL\";\n    nav.primaryAxisSizingMode = \"FIXED\";\n    nav.counterAxisSizingMode = \"FIXED\";\n    nav.paddingTop = 8;\n    nav.paddingBottom = 24;\n    nav.itemSpacing = 0;\n    nav.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    nav.counterAxisAlignItems = \"CENTER\";\n\n    const tabs = [\n      { id: \"Home\", label: \"Home\", icon: \"Icon_Tab_Home\" },\n      { id: \"Markets\", label: \"Markets\", icon: \"Icon_Tab_Markets\" },\n      { id: \"Exchange\", label: \"Exchange\", icon: \"Icon_Tab_Exchange\" },\n      { id: \"Futures\", label: \"Futures\", icon: \"Icon_Tab_Futures\" },\n      { id: \"Wallets\", label: \"Wallets\", icon: \"Icon_Tab_Wallet\" }\n    ];\n\n    tabs.forEach(tab => {\n      const tabFrame = figma.createFrame();\n      tabFrame.name = `Tab_${tab.id}`;\n      tabFrame.resize(78, 52);\n      tabFrame.fills = [];\n      tabFrame.layoutMode = \"VERTICAL\";\n      tabFrame.counterAxisAlignItems = \"CENTER\";\n      tabFrame.primaryAxisAlignItems = \"CENTER\";\n      tabFrame.itemSpacing = 4;\n\n      const isActive = tab.id === activeTab;\n\n      const iconInst = getComponent(tab.icon);\n      if (iconInst) {\n        tabFrame.appendChild(iconInst);\n      }\n\n      const text = figma.createText();\n      text.fontName = { family: \"Poppins\", style: isActive ? \"SemiBold\" : \"Regular\" };\n      text.fontSize = 11;\n      text.characters = tab.label;\n      text.fills = [{ type: \"SOLID\", color: isActive ? BRAND : TEXT_MUTED }];\n      tabFrame.appendChild(text);\n\n      nav.appendChild(tabFrame);\n    });\n\n    return nav;\n  }\n\n  // Helper to add status bar & home indicator\n  function attachShell(frame) {\n    const statusBar = getComponent(\"6:32\");\n    if (statusBar) {\n      statusBar.x = 0;\n      statusBar.y = 0;\n      frame.appendChild(statusBar);\n    }\n    const homeIndicator = getComponent(\"6:42\");\n    if (homeIndicator) {\n      homeIndicator.x = 0;\n      homeIndicator.y = frame.height - 34;\n      frame.appendChild(homeIndicator);\n    }\n  }\n\n  // Helper to create primary button\n  function createButton(textStr, width = 342, height = 50) {\n    const btn = figma.createFrame();\n    btn.name = \"Button\";\n    btn.resize(width, height);\n    btn.cornerRadius = 25;\n    btn.fills = [{ type: \"SOLID\", color: BRAND }];\n    btn.layoutMode = \"HORIZONTAL\";\n    btn.primaryAxisAlignItems = \"CENTER\";\n    btn.counterAxisAlignItems = \"CENTER\";\n\n    const txt = figma.createText();\n    txt.fontName = { family: \"Poppins\", style: \"SemiBold\" };\n    txt.fontSize = 16;\n    txt.characters = textStr;\n    txt.fills = [{ type: \"SOLID\", color: SURFACE_WHITE }];\n    btn.appendChild(txt);\n    return btn;\n  }\n\n  // Helper to create secondary button\n  function createSecondaryButton(textStr, width = 342, height = 50) {\n    const btn = figma.createFrame();\n    btn.name = \"Button_Secondary\";\n    btn.resize(width, height);\n    btn.cornerRadius = 25;\n    btn.fills = [{ type: \"SOLID\", color: { r: 0.92, g: 0.94, b: 0.98 } }];\n    btn.layoutMode = \"HORIZONTAL\";\n    btn.primaryAxisAlignItems = \"CENTER\";\n    btn.counterAxisAlignItems = \"CENTER\";\n\n    const txt = figma.createText();\n    txt.fontName = { family: \"Poppins\", style: \"SemiBold\" };\n    txt.fontSize = 16;\n    txt.characters = textStr;\n    txt.fills = [{ type: \"SOLID\", color: BRAND }];\n    btn.appendChild(txt);\n    return btn;\n  }\n\n  // -------------------------------------------------------------\n  // FRAME 1: 01_Welcome\n  // -------------------------------------------------------------\n  const f1 = figma.createFrame();\n  f1.name = \"01_Welcome\";\n  f1.resize(390, 844);\n  f1.x = 0; f1.y = 0;\n  f1.fills = [{ type: \"SOLID\", color: SURFACE_WHITE }];\n  attachShell(f1);\n\n  // Content for Welcome\n  const illu = getComponent(\"5:2\");\n  if (illu) {\n    illu.x = (390 - illu.width) / 2;\n    illu.y = 100;\n    f1.appendChild(illu);\n  }\n\n  const copyHeading = figma.createText();\n  copyHeading.fontName = { family: \"Poppins\", style: \"Bold\" };\n  copyHeading.fontSize = 26;\n  copyHeading.textAlignHorizontal = \"CENTER\";\n  copyHeading.characters = \"Manage your finances simply\";\n  copyHeading.resize(320, 70);\n  copyHeading.x = 35; copyHeading.y = 520;\n  copyHeading.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n  f1.appendChild(copyHeading);\n\n  const btnGetStarted = createButton(\"GET STARTED\", 342, 52);\n  btnGetStarted.x = 24; btnGetStarted.y = 660;\n  f1.appendChild(btnGetStarted);\n\n  const loginText = figma.createText();\n  loginText.fontName = { family: \"Poppins\", style: \"Medium\" };\n  loginText.fontSize = 14;\n  loginText.characters = \"Already have an account? Log In\";\n  loginText.x = (390 - 230) / 2; loginText.y = 730;\n  loginText.fills = [{ type: \"SOLID\", color: BRAND }];\n  f1.appendChild(loginText);\n\n\n  // -------------------------------------------------------------\n  // FRAME 2: 02_Photo_ID\n  // -------------------------------------------------------------\n  const f2 = figma.createFrame();\n  f2.name = \"02_Photo_ID\";\n  f2.resize(390, 844);\n  f2.x = 430; f2.y = 0;\n  f2.fills = [{ type: \"SOLID\", color: SURFACE_WHITE }];\n  attachShell(f2);\n\n  // Header back button\n  const iconBack = getComponent(\"2:90\");\n  if (iconBack) {\n    iconBack.x = 24; iconBack.y = 56;\n    f2.appendChild(iconBack);\n  }\n\n  const titlePhotoID = figma.createText();\n  titlePhotoID.fontName = { family: \"Poppins\", style: \"Bold\" };\n  titlePhotoID.fontSize = 24;\n  titlePhotoID.characters = \"Photo ID Card\";\n  titlePhotoID.x = 24; titlePhotoID.y = 100;\n  titlePhotoID.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n  f2.appendChild(titlePhotoID);\n\n  const subPhotoID = figma.createText();\n  subPhotoID.fontName = { family: \"Poppins\", style: \"Regular\" };\n  subPhotoID.fontSize = 14;\n  subPhotoID.characters = \"Please point the camera at the ID card\";\n  subPhotoID.x = 24; subPhotoID.y = 136;\n  subPhotoID.fills = [{ type: \"SOLID\", color: TEXT_MUTED }];\n  f2.appendChild(subPhotoID);\n\n  // ID card scan area\n  const idPlaceholder = getComponent(\"5:5\");\n  if (idPlaceholder) {\n    idPlaceholder.x = (390 - idPlaceholder.width) / 2;\n    idPlaceholder.y = 220;\n    f2.appendChild(idPlaceholder);\n  }\n\n  // Actions: TRY AGAIN & CONTINUE\n  const btnTryAgain = createSecondaryButton(\"TRY AGAIN\", 163, 50);\n  btnTryAgain.x = 24; btnTryAgain.y = 680;\n  f2.appendChild(btnTryAgain);\n\n  const btnContinue = createButton(\"CONTINUE\", 163, 50);\n  btnContinue.x = 203; btnContinue.y = 680;\n  f2.appendChild(btnContinue);\n\n\n  // -------------------------------------------------------------\n  // FRAME 3: 03_Bank_Home\n  // -------------------------------------------------------------\n  const f3 = figma.createFrame();\n  f3.name = \"03_Bank_Home\";\n  f3.resize(390, 844);\n  f3.x = 860; f3.y = 0;\n  f3.fills = [{ type: \"SOLID\", color: BG_LIGHT }];\n  attachShell(f3);\n\n  // Top header (menu, contacts, notifications with unread badge)\n  const header3 = figma.createFrame();\n  header3.resize(342, 44);\n  header3.x = 24; header3.y = 52;\n  header3.fills = [];\n  \n  const iconMenu3 = getComponent(\"2:50\");\n  if (iconMenu3) { iconMenu3.x = 0; iconMenu3.y = 10; header3.appendChild(iconMenu3); }\n  \n  const iconContacts3 = getComponent(\"2:55\");\n  if (iconContacts3) { iconContacts3.x = 264; iconContacts3.y = 10; header3.appendChild(iconContacts3); }\n\n  const iconNotif3 = getComponent(\"2:60\");\n  if (iconNotif3) {\n    iconNotif3.x = 306; iconNotif3.y = 10;\n    header3.appendChild(iconNotif3);\n    // Unread red dot\n    const dot = figma.createEllipse();\n    dot.resize(8, 8);\n    dot.x = 322; dot.y = 10;\n    dot.fills = [{ type: \"SOLID\", color: LOSS }];\n    header3.appendChild(dot);\n  }\n  f3.appendChild(header3);\n\n  // Section: Payment cards\n  const titleCards = figma.createText();\n  titleCards.fontName = { family: \"Poppins\", style: \"Bold\" };\n  titleCards.fontSize = 18;\n  titleCards.characters = \"Payment card\";\n  titleCards.x = 24; titleCards.y = 112;\n  titleCards.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n  f3.appendChild(titleCards);\n\n  // Card 1\n  const card1 = figma.createFrame();\n  card1.resize(300, 160);\n  card1.x = 24; card1.y = 144;\n  card1.cornerRadius = 16;\n  card1.fills = [{ type: \"GRADIENT_LINEAR\", gradientStops: [{ position: 0, color: BRAND }, { position: 1, color: { r: 0.05, g: 0.3, b: 0.8 } }], gradientTransform: [[1, 0, 0], [0, 1, 0]] }];\n  \n  const logoMc1 = getComponent(\"4:129\");\n  if (logoMc1) { logoMc1.x = 220; logoMc1.y = 16; card1.appendChild(logoMc1); }\n  \n  const card1Num = figma.createText();\n  card1Num.fontName = { family: \"Roboto\", style: \"Bold\" };\n  card1Num.fontSize = 16;\n  card1Num.characters = \"3141  5926  5358  9793\";\n  card1Num.x = 20; card1Num.y = 70;\n  card1Num.fills = [{ type: \"SOLID\", color: SURFACE_WHITE }];\n  card1.appendChild(card1Num);\n\n  const card1Holder = figma.createText();\n  card1Holder.fontName = { family: \"Poppins\", style: \"Medium\" };\n  card1Holder.fontSize = 12;\n  card1Holder.characters = \"ALEX MORGAN\\nExp 06/24\";\n  card1Holder.x = 20; card1Holder.y = 110;\n  card1Holder.fills = [{ type: \"SOLID\", color: SURFACE_WHITE }];\n  card1.appendChild(card1Holder);\n  f3.appendChild(card1);\n\n  // Section: Exchange rates\n  const secRateHeader = figma.createFrame();\n  secRateHeader.resize(342, 24);\n  secRateHeader.x = 24; secRateHeader.y = 320;\n  secRateHeader.fills = [];\n  \n  const titleRates = figma.createText();\n  titleRates.fontName = { family: \"Poppins\", style: \"Bold\" };\n  titleRates.fontSize = 18;\n  titleRates.characters = \"Exchange rates\";\n  titleRates.x = 0; titleRates.y = 0;\n  titleRates.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n  secRateHeader.appendChild(titleRates);\n\n  const seeAllRates = figma.createText();\n  seeAllRates.fontName = { family: \"Poppins\", style: \"Medium\" };\n  seeAllRates.fontSize = 13;\n  seeAllRates.characters = \"See all\";\n  seeAllRates.x = 295; seeAllRates.y = 3;\n  seeAllRates.fills = [{ type: \"SOLID\", color: BRAND }];\n  secRateHeader.appendChild(seeAllRates);\n  f3.appendChild(secRateHeader);\n\n  // Exchange rates horizontal row (AUD / EUR / GBP)\n  const ratesRow = figma.createFrame();\n  ratesRow.resize(342, 72);\n  ratesRow.x = 24; ratesRow.y = 352;\n  ratesRow.fills = [];\n  ratesRow.layoutMode = \"HORIZONTAL\";\n  ratesRow.itemSpacing = 12;\n\n  const ratesData = [\n    { curr: \"AUD\", rate: \"$0.80\", change: \"+0.03 (+3.9%)\" },\n    { curr: \"EUR\", rate: \"$1.10\", change: \"+0.03 (+2.8%)\" },\n    { curr: \"GBP\", rate: \"$1.30\", change: \"+0.03 (+2.4%)\" }\n  ];\n\n  ratesData.forEach(r => {\n    const card = figma.createFrame();\n    card.resize(106, 72);\n    card.cornerRadius = 12;\n    card.fills = [{ type: \"SOLID\", color: SURFACE_WHITE }];\n    card.paddingLeft = 10; card.paddingTop = 10;\n\n    const tCurr = figma.createText();\n    tCurr.fontName = { family: \"Poppins\", style: \"Bold\" };\n    tCurr.fontSize = 12; tCurr.characters = r.curr;\n    tCurr.x = 10; tCurr.y = 8;\n    tCurr.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n    card.appendChild(tCurr);\n\n    const tRate = figma.createText();\n    tRate.fontName = { family: \"Roboto\", style: \"Bold\" };\n    tRate.fontSize = 14; tRate.characters = r.rate;\n    tRate.x = 10; tRate.y = 26;\n    tRate.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n    card.appendChild(tRate);\n\n    const tChg = figma.createText();\n    tChg.fontName = { family: \"Roboto\", style: \"Regular\" };\n    tChg.fontSize = 10; tChg.characters = r.change;\n    tChg.x = 10; tChg.y = 48;\n    tChg.fills = [{ type: \"SOLID\", color: GAIN }];\n    card.appendChild(tChg);\n\n    ratesRow.appendChild(card);\n  });\n  f3.appendChild(ratesRow);\n\n  // Section: Transactions\n  const secTxHeader = figma.createFrame();\n  secTxHeader.resize(342, 24);\n  secTxHeader.x = 24; secTxHeader.y = 444;\n  secTxHeader.fills = [];\n  \n  const titleTx = figma.createText();\n  titleTx.fontName = { family: \"Poppins\", style: \"Bold\" };\n  titleTx.fontSize = 18;\n  titleTx.characters = \"Transactions\";\n  titleTx.x = 0; titleTx.y = 0;\n  titleTx.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n  secTxHeader.appendChild(titleTx);\n\n  const seeAllTx = figma.createText();\n  seeAllTx.fontName = { family: \"Poppins\", style: \"Medium\" };\n  seeAllTx.fontSize = 13;\n  seeAllTx.characters = \"See all\";\n  seeAllTx.x = 295; seeAllTx.y = 3;\n  seeAllTx.fills = [{ type: \"SOLID\", color: BRAND }];\n  secTxHeader.appendChild(seeAllTx);\n  f3.appendChild(secTxHeader);\n\n  // 3 Transactions List (Car loans, Mortgage real estate, Personal loans)\n  const txList = [\n    { title: \"Car loans\", icon: \"4:32\", val: \"$13.10\", chg: \"−4.5%\", date: \"Today 9:01 AM\" },\n    { title: \"Mortgage real estate\", icon: \"4:37\", val: \"$15.10\", chg: \"−1.5%\", date: \"Apr 12, 2022 5:01 AM\" },\n    { title: \"Personal loans\", icon: \"4:42\", val: \"$41.10\", chg: \"−6.5%\", date: \"Mar 13, 2022 7:02 PM\" }\n  ];\n\n  let txY = 476;\n  txList.forEach(t => {\n    const row = figma.createFrame();\n    row.resize(342, 64);\n    row.x = 24; row.y = txY;\n    row.cornerRadius = 12;\n    row.fills = [{ type: \"SOLID\", color: SURFACE_WHITE }];\n\n    const ic = getComponent(t.icon);\n    if (ic) { ic.x = 12; ic.y = 20; row.appendChild(ic); }\n\n    const tt = figma.createText();\n    tt.fontName = { family: \"Poppins\", style: \"SemiBold\" };\n    tt.fontSize = 14; tt.characters = t.title;\n    tt.x = 48; tt.y = 12;\n    tt.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n    row.appendChild(tt);\n\n    const td = figma.createText();\n    td.fontName = { family: \"Poppins\", style: \"Regular\" };\n    td.fontSize = 11; td.characters = t.date;\n    td.x = 48; td.y = 34;\n    td.fills = [{ type: \"SOLID\", color: TEXT_MUTED }];\n    row.appendChild(td);\n\n    const tv = figma.createText();\n    tv.fontName = { family: \"Roboto\", style: \"Bold\" };\n    tv.fontSize = 14; tv.characters = t.val;\n    tv.textAlignHorizontal = \"RIGHT\";\n    tv.x = 220; tv.y = 12; tv.resize(110, 20);\n    tv.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n    row.appendChild(tv);\n\n    const tc = figma.createText();\n    tc.fontName = { family: \"Roboto\", style: \"Medium\" };\n    tc.fontSize = 11; tc.characters = t.chg;\n    tc.textAlignHorizontal = \"RIGHT\";\n    tc.x = 220; tc.y = 34; tc.resize(110, 16);\n    tc.fills = [{ type: \"SOLID\", color: LOSS }];\n    row.appendChild(tc);\n\n    f3.appendChild(row);\n    txY += 72;\n  });\n\n  // Attach Bank Nav\n  const nav3 = createBankNavComponent(\"Home\");\n  nav3.x = 0; nav3.y = 760;\n  f3.appendChild(nav3);\n\n\n  // -------------------------------------------------------------\n  // FRAME 4: 04_Bank_Transactions\n  // -------------------------------------------------------------\n  const f4 = figma.createFrame();\n  f4.name = \"04_Bank_Transactions\";\n  f4.resize(390, 844);\n  f4.x = 1290; f4.y = 0;\n  f4.fills = [{ type: \"SOLID\", color: BG_LIGHT }];\n  attachShell(f4);\n\n  // Header: history, currency exchange, notifications\n  const header4 = figma.createFrame();\n  header4.resize(342, 44);\n  header4.x = 24; header4.y = 52;\n  header4.fills = [];\n  \n  const tTitle4 = figma.createText();\n  tTitle4.fontName = { family: \"Poppins\", style: \"Bold\" };\n  tTitle4.fontSize = 20; tTitle4.characters = \"Transactions\";\n  tTitle4.x = 0; tTitle4.y = 8;\n  tTitle4.fills = [{ type: \"SOLID\",