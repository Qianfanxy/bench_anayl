{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_81fb405aed524892827fb0be","name":"mcp__figma__use_figma","input":{"code":"const page = await figma.getNodeByIdAsync(\"4:2\");\nawait figma.setCurrentPageAsync(page);\nfor (const s of [\"Regular\",\"Medium\",\"SemiBold\",\"Bold\",\"ExtraBold\"]) await figma.loadFontAsync({family:\"Nunito\",style:s});\nconst solid=(hex,o=1)=>{const h=hex.replace('#','');return{type:'SOLID',color:{r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255},opacity:o};};\nasync function inst(parent,cid,x,y,name){const m=await figma.getNodeByIdAsync(cid);const i=m.createInstance();i.x=x;i.y=y;if(name)i.name=name;parent.appendChild(i);return i;}\nasync function txt(parent,chars,size,style,hex,name){const t=figma.createText();t.fontName={family:'Nunito',style};t.characters=chars;t.fontSize=size;t.fills=[solid(hex)];t.name=name||'t';parent.appendChild(t);return t;}\nconst out={};\n\n// Sheet/Success component\nconst sh=figma.createComponent();\nsh.name=\"Sheet/Success\";\nsh.x=-560; sh.y=1500;\nsh.layoutMode=\"VERTICAL\";\nsh.primaryAxisSizingMode=\"AUTO\";\nsh.counterAxisSizingMode=\"FIXED\";\nsh.resize(375,100);\nsh.paddingLeft=16; sh.paddingRight=16; sh.paddingTop=10; sh.paddingBottom=24;\nsh.itemSpacing=8;\nsh.cornerRadius=24;\nsh.fills=[solid('#FFFFFF')];\nsh.effects=[{type:'DROP_SHADOW',color:{r:0,g:0,b:0,a:0.18},offset:{x:0,y:-8},radius:40,spread:0,visible:true,blendMode:'NORMAL'}];\npage.appendChild(sh);\nout.sheet=sh.id;\n\n// grabber wrap\nconst gw=figma.createFrame(); gw.name=\"grabWrap\"; gw.resize(343,4); gw.fills=[];\ngw.layoutMode=\"HORIZONTAL\"; gw.primaryAxisSizingMode=\"FIXED\"; gw.counterAxisSizingMode=\"AUTO\";\ngw.primaryAxisAlignItems=\"CENTER\";\nsh.appendChild(gw);\nconst grab=figma.createRectangle(); grab.name=\"grabber\"; grab.resize(36,4); grab.cornerRadius=2; grab.fills=[solid('#E6E8EE')];\ngw.appendChild(grab);\n\n// close row (right-aligned close icon)\nconst crow=figma.createFrame(); crow.name=\"closeRow\"; crow.fills=[];\ncrow.layoutMode=\"HORIZONTAL\"; crow.primaryAxisSizingMode=\"FIXED\"; crow.counterAxisSizingMode=\"AUTO\";\ncrow.primaryAxisAlignItems=\"MAX\";\nsh.appendChild(crow);\ncrow.resize(343,24);\nconst closeIc=await inst(crow,\"2:128\",0,0,\"close\");\ncloseIc.resize(22,22);\nout.close=closeIc.id;\n\nconst sp1=figma.createFrame(); sp1.name=\"sp\"; sp1.fills=[]; sp1.resize(343,24); sh.appendChild(sp1);\n\n// emoji\nconst em=await txt(sh,\"🎉\",52,\"Regular\",\"#2B2D33\",\"emoji\");\nem.textAlignHorizontal=\"CENTER\";\nem.textAutoResize=\"HEIGHT\";\nem.layoutAlign=\"STRETCH\";\n\n// title\nconst ti=await txt(sh,\"You’ve invested!\",18,\"Bold\",\"#2B2D33\",\"title\");\nti.textAlignHorizontal=\"CENTER\"; ti.textAutoResize=\"HEIGHT\"; ti.layoutAlign=\"STRETCH\";\n\nconst sp2=figma.createFrame(); sp2.name=\"sp\"; sp2.fills=[]; sp2.resize(343,4); sh.appendChild(sp2);\n\n// body\nconst body=await txt(sh,\"3,021.00 DAI in the “Aggressive Growth” strategy. You will find the purchased coins in a new pocket.\",12,\"Regular\",\"#70767F\",\"body\");\nbody.textAlignHorizontal=\"CENTER\"; body.textAutoResize=\"HEIGHT\"; body.layoutAlign=\"STRETCH\";\nout.bodyChars=body.characters;\n\nconst sp3=figma.createFrame(); sp3.name=\"sp\"; sp3.fills=[]; sp3.resize(343,20); sh.appendChild(sp3);\n\n// View Pocket button (clone of master Button 3:19 style)\nconst vp=await inst(sh,\"3:19\",0,0,\"viewPocket\");\nvp.resize(343,52);\nconst vpT=vp.findOne(n=>n.type==='TEXT');\nif(vpT){await figma.loadFontAsync(vpT.fontName); vpT.characters=\"View Pocket\";}\nout.viewPocket=vp.id;\n\n// confetti absolute pieces\nconst conf=[[40,120,'#F5C518',8,'r'],[70,180,'#149E53',6,'c'],[310,140,'#E5484D',7,'c'],[330,220,'#565B63',6,'r'],[55,260,'#2B2D33',5,'c'],[300,300,'#F5C518',7,'r'],[90,330,'#149E53',5,'r'],[280,380,'#E5484D',5,'c']];\nfor(const [cx,cy,col,sz,shape] of conf){\n  const c=figma.createRectangle();\n  c.resize(sz,sz); c.fills=[solid(col)];\n  if(shape==='c'){c.cornerRadius=sz/2;}\n  c.name=\"confetti\";\n  sh.appendChild(c);\n  c.layoutPositioning=\"ABSOLUTE\";\n  c.x=cx; c.y=cy;\n}\n\n// instance into 05_Invest_Success\nconst f5=await figma.getNodeByIdAsync(\"10:331\");\nconst si5=sh.createInstance();\nsi5.name=\"sheet\";\nf5.appendChild(si5);\nsi5.x=0; si5.y=812-sh.height;\nout.sheetH=sh.height;\nout.si5y=si5.y;\nreturn JSON.stringify(out);","description":"Build Sheet/Success component (confetti, emoji, copy, View Pocket button) and place instance in 05_Invest_Success","fileKey":"AkAgp4U0sCY7xkZ05uhVkb"}}],"id":"e1ed4ead-4b09-4d0e-b3c4-59d80ffa07eb","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"3b54d81e-1062-44f7-87fa-749cc21f1674","uuid":"cd957cde-9e6a-40b1-9cb3-048c7351a963","timestamp":"2026-10-31T20:06:58.816Z","tool_use_meta":[{"id":"call_81fb405aed524892827fb0be","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
