e=opts.cSize||'AUTO';\n  f.itemSpacing=opts.gap||0;\n  f.paddingLeft=opts.pl||0; f.paddingRight=opts.pr||0; f.paddingTop=opts.pt||0; f.paddingBottom=opts.pb||0;\n  if(opts.align) f.counterAxisAlignItems=opts.align;\n  if(opts.justify) f.primaryAxisAlignItems=opts.justify;\n  return f;\n}\nfunction tint(n,color){ if('fills' in n){ try{n.fills=[solid(color)];}catch(e){} } if('children' in n) n.children.forEach(c=>tint(c,color)); }\nfunction inst(comp, w, h){ const i = comp.createInstance(); if(w&&h) i.resize(w,h); else if(w) i.resize(w, i.height*w/comp.width); return i; }\nfunction newComp(name){ const c=figma.createComponent(); c.name=name; c.fills=[]; c.clipsContent=true; return c; }\n\n// Remove old Chip; build Chip / Timer and Chip / Fork\nconst old = byName('Chip');\nif (old) old.remove();\nfunction chipComp(name, iconName){\n  const c = newComp(name);\n  al(c,'HORIZONTAL',{pl:16,pr:16,pt:8,pb:8,gap:10,align:'CENTER'});\n  c.fills=[solid(BLACK,0.05)]; c.cornerRadius=999;\n  const ic = inst(M[iconName],20,20); tint(ic,BLACK); ic.name='Icon';\n  const t = text('30 Minutes','Medium',14,{alpha:0.6}); t.name='Label';\n  c.appendChild(ic); c.appendChild(t);\n  return c;\n}\n{\n  const a = chipComp('Chip / Timer','Icon_Timer');\n  COMP.appendChild(a); a.x = 560; a.y = 0;\n  const b = chipComp('Chip / Fork','Icon_Fork_Knife');\n  b.findOne(n=>n.name==='Label').characters = 'Western';\n  COMP.appendChild(b); b.x = 720; b.y = 0;\n}\n\nconst built = {};\n\n// ---- Recipe Card (290) ----\n{\n  const c = newComp('Recipe Card');\n  al(c,'VERTICAL',{pt:12,pl:12,pr:12,pb:24,gap:16});\n  c.fills=[solid(WHITE)]; c.cornerRadius=24;\n  c.effects=[{type:'DROP_SHADOW',color:{r:0.1,g:0.2,b:0.25,a:0.06},offset:{x:0,y:12},radius:32,spread:0,visible:true,blendMode:'NORMAL'}];\n  const imgWrap = frame('Image'); imgWrap.cornerRadius=18;\n  const img = inst(M.Photo_Wagyu_Cheeseburger, 266, 180); img.name='Photo';\n  imgWrap.appendChild(img);\n  const fav = byName('Favorite / Default').createInstance();\n  imgWrap.appendChild(fav); fav.x = 266-48-10; fav.y = 10;\n  const t = text('Recipe title','Semi Bold',18,{lh:135}); t.name='Title';\n  t.textAutoResize='HEIGHT'; t.resize(266, t.height);\n  const chips = frame('Meta'); al(chips,'HORIZONTAL',{gap:12});\n  chips.appendChild(byName('Chip / Timer').createInstance());\n  chips.appendChild(byName('Chip / Fork').createInstance());\n  c.appendChild(imgWrap); c.appendChild(t); c.appendChild(chips);\n  t.layoutAlign='STRETCH';\n  c.resize(290, Math.round(c.height));\n  COMP.appendChild(c); c.x = 0; c.y = 360;\n  built['Recipe Card'] = c.id;\n}\n\n// ---- Promo Card ----\n{\n  const c = newComp('Promo Card');\n  al(c,'VERTICAL',{pt:20,pl:20,pr:20,pb:16,gap:8,align:'CENTER'});\n  c.fills=[solid(TINT)]; c.cornerRadius=24;\n  const t = text('Don’t forget to eat healthy food','Semi Bold',20,{align:'CENTER',lh:135}); t.name='Title';\n  t.textAutoResize='HEIGHT'; t.resize(250,t.height);\n  const img = inst(M.Photo_Ad_Salad, 250, 236); img.name='Photo';\n  const url = text('www.foodieland.com','Medium',14,{alpha:0.6,align:'CENTER'}); url.name='URL';\n  c.appendChild(t); c.appendChild(img); c.appendChild(url);\n  c.resize(290, Math.round(c.height));\n  COMP.appendChild(c); c.x = 400; c.y = 360;\n  built['Promo Card'] = c.id;\n}\n\n// ---- Mini Recipe Item ----\n{\n  const c = newComp('Mini Recipe Item');\n  al(c,'HORIZONTAL',{gap:20,align:'CENTER'});\n  const imgWrap = frame('Image'); imgWrap.cornerRadius=16;\n  const img = inst(M.Photo_Chicken_Meatballs, 180, 120); img.name='Photo';\n  imgWrap.appendChild(img);\n  const col = frame('Text'); al(col,'VERTICAL',{gap:10});\n  const t = text('Chicken Meatballs with Cream Cheese','Semi Bold',18,{lh:135}); t.name='Title';\n  t.textAutoResize='HEIGHT'; t.resize(160, t.height);\n  const by = text('By Andreas Paula','Medium',14,{alpha:0.6}); by.name='Byline';\n  col.appendChild(t); col.appendChild(by);\n  c.appendChild(imgWrap); c.appendChild(col);\n  col.layoutGrow = 1;\n  c.re