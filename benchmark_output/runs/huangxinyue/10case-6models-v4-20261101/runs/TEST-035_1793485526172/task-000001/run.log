{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_050cdffb8bab470997c4db0e","name":"mcp__figma__use_figma","input":{"code":"\nconst page = await figma.getNodeByIdAsync('8:2');\nawait figma.setCurrentPageAsync(page);\nfor (const s of ['Regular','Medium','Semi Bold','Bold']) await figma.loadFontAsync({family:'Inter',style:s});\nawait figma.loadFontAsync({family:'Roboto Mono',style:'Medium'});\nfunction hx(h){const n=parseInt(h,16);return{r:((n>>16)&255)/255,g:((n>>8)&255)/255,b:(n&255)/255};}\nfunction solid(h,o=1){return{type:'SOLID',color:hx(h),opacity:o};}\nfunction T(name,chars,style,size,color,o={}){\n  const t=figma.createText(); t.name=name;\n  t.fontName={family:'Inter',style}; t.characters=chars; t.fontSize=size;\n  if(o.ls!==undefined)t.letterSpacing={unit:'PERCENT',value:o.ls};\n  t.fills=[solid(color,o.op===undefined?1:o.op)];\n  return t;\n}\nconst N=(id)=>figma.getNodeByIdAsync(id);\nconst out={};\nfunction screen(name,x,fill){\n  const f=figma.createFrame(); f.name=name; f.resize(375,812); f.x=x; f.y=100; f.fills=[solid(fill)];\n  return f;\n}\nasync function shell(parent){\n  const sb=(await N('1:33')).createInstance(); parent.appendChild(sb); sb.x=0; sb.y=0; sb.name='Status Bar';\n  const hi=(await N('1:44')).createInstance(); parent.appendChild(hi); hi.x=0; hi.y=778; hi.name='Home Indicator';\n}\nfunction cap(chars,x){ const t=T('Caption '+chars,chars,'Semi Bold',16,'8A8A93'); figma.currentPage.appendChild(t); t.x=x; t.y=60; }\nconst MERS={Apple:{id:'5:5',w:24,h:18},Nike:{id:'5:9',w:26,h:26},Uber:{id:'5:7',w:28,h:17}};\nconst ROWS=[['Nike','Nike Air Max 2090','15 Aug 2020','−$243.00','1A1A1F'],['Apple','iPad Pro 2020','10 Aug 2020','−$799.00','1A1A1F'],['Uber','Uber','5 Mar 2020','+$50.00','34C759']];\nasync function txRows(parent,y){\n  const card=figma.createFrame(); card.name='Transactions List'; parent.appendChild(card);\n  card.resize(343,204); card.x=16; card.y=y; card.cornerRadius=16; card.fills=[solid('FFFFFF')];\n  card.effects=[{type:'DROP_SHADOW',color:{r:0.1,g:0.1,b:0.12,a:0.08},offset:{x:0,y:8},radius:20,spread:0,visible:true,blendMode:'NORMAL'}];\n  const rcomp=await N('11:24');\n  for(let i=0;i<3;i++){\n    const r=rcomp.createInstance(); card.appendChild(r); r.x=16; r.y=12+i*60; r.name='Row '+(i+1);\n    r.findOne(n=>n.name==='Title').characters=ROWS[i][1];\n    r.findOne(n=>n.name==='Date').characters=ROWS[i][2];\n    const a=r.findOne(n=>n.name==='Amount'); a.characters=ROWS[i][3]; a.fills=[solid(ROWS[i][4])];\n    const m=MERS[ROWS[i][0]]; const mi=(await N(m.id)).createInstance(); card.appendChild(mi);\n    mi.resize(m.w,m.h); mi.x=16+(40-m.w)/2; mi.y=12+i*60+10+(40-m.h)/2; mi.name='Merchant '+ROWS[i][0];\n    if(i<2){ const d=figma.createRectangle(); card.appendChild(d); d.resize(255,1); d.x=72; d.y=72+i*60; d.fills=[solid('EDEDF2')]; d.name='Divider'; }\n  }\n  return card;\n}\n\n// ---------- 03_Wallet ----------\nconst f3=screen('03_Wallet',950,'F5F5F9');\nawait shell(f3);\nconst h3=(await N('11:4')).createInstance(); f3.appendChild(h3); h3.x=0; h3.y=56; h3.name='Header';\nconst ibk=(await N('15:57')).createInstance(); f3.appendChild(ibk); ibk.x=16; ibk.y=64; ibk.name='Btn Back';\nconst iad=(await N('15:60')).createInstance(); f3.appendChild(iad); iad.x=319; iad.y=64; iad.name='Btn Add Card';\nconst pcard=(await N('12:9')).createInstance(); f3.appendChild(pcard); pcard.x=16; pcard.y=112; pcard.name='Current Card';\npcard.strokes=[solid('007AFF')]; pcard.strokeWeight=2; pcard.strokeAlign='OUTSIDE';\nconst d1=figma.createRectangle(); f3.appendChild(d1); d1.resize(16,6); d1.x=165.5; d1.y=323; d1.cornerRadius=3; d1.fills=[solid('007AFF')]; d1.name='Dot 1';\nconst d2=figma.createEllipse(); f3.appendChild(d2); d2.resize(6,6); d2.x=189.5; d2.y=323; d2.fills=[solid('D6D6DE')]; d2.name='Dot 2';\nconst d3=figma.createEllipse(); f3.appendChild(d3); d3.resize(6,6); d3.x=203.5; d3.y=323; d3.fills=[solid('D6D6DE')]; d3.name='Dot 3';\nconst ofT=T('Card Count','1 of 3','Medium',11,'9A9AA3'); f3.appendChild(ofT); ofT.x=16; ofT.y=320;\nconst promo=(await N('12:36')).createInstance(); f3.appendChild(promo); promo.x=16; promo.y=352; promo.name='Promo';\nconst sec3=(await N('11:17')).createInstance(); f3.appendChild(sec3); sec3.x=16; sec3.y=468; sec3.name='Section Transactions';\nsec3.findOne(n=>n.name==='Title').characters='Transactions';\nconst list3=await txRows(f3,496);\nout.f3=f3.id; out.btnBack3=ibk.id; out.btnAdd3=iad.id;\ncap('03 · Wallet',950);\n\n// ---------- 04_Add_Card ----------\nconst f4=screen('04_Add_Card',1425,'F5F5F9');\nawait shell(f4);\nconst h4=(await N('11:4')).createInstance(); f4.appendChild(h4); h4.x=0; h4.y=56; h4.name='Header';\nconst iad4=(await N('15:60')).createInstance(); f4.appendChild(iad4); iad4.x=319; iad4.y=64; iad4.name='Btn Add Card';\nconst pcard4=(await N('12:9')).createInstance(); f4.appendChild(pcard4); pcard4.x=16; pcard4.y=112; pcard4.name='Current Card';\nconst dim=figma.createRectangle(); f4.appendChild(dim); dim.resize(375,812); dim.x=0; dim.y=0; dim.fills=[solid('12101A',0.45)]; dim.name='Scrim';\nconst sheet=figma.createFrame(); f4.appendChild(sheet); sheet.name='Sheet';\nsheet.resize(375,590); sheet.x=0; sheet.y=222;\nsheet.topLeftRadius=28; sheet.topRightRadius=28; sheet.fills=[solid('FFFFFF')];\nsheet.effects=[{type:'DROP_SHADOW',color:{r:0,g:0,b:0,a:0.18},offset:{x:0,y:-8},radius:32,spread:0,visible:true,blendMode:'NORMAL'}];\nconst grab=figma.createRectangle(); sheet.appendChild(grab); grab.resize(36,5); grab.x=169.5; grab.y=10; grab.cornerRadius=2.5; grab.fills=[solid('D9D9E0')]; grab.name='Grabber';\nconst hsh=(await N('11:4')).createInstance(); sheet.appendChild(hsh); hsh.x=0; hsh.y=20; hsh.name='Header';\nhsh.findOne(n=>n.name==='Title').characters='Add new card';\nconst icl=(await N('15:64')).createInstance(); sheet.appendChild(icl); icl.x=319; icl.y=28; icl.name='Btn Close';\nconst prev=(await N('12:19')).createInstance(); sheet.appendChild(prev); prev.x=20; prev.y=84; prev.name='Card Preview';\nconst tfc=await N('11:20');\nconst f1_=tfc.createInstance(); sheet.appendChild(f1_); f1_.resize(335,71); f1_.x=20; f1_.y=270; f1_.name='Field Card Holder';\nconst f2_=tfc.createInstance(); sheet.appendChild(f2_); f2_.resize(335,71); f2_.x=20; f2_.y=349; f2_.name='Field Card Number';\nf2_.findOne(n=>n.name==='Label').characters='Card number';\nconst val=f2_.findOne(n=>n.name==='Value');\nval.fontName={family:'Roboto Mono',style:'Medium'}; val.characters='5412 7534 0089 2216'; val.fontSize=15; val.fills=[solid('1A1A1F')];\nconst inp=f2_.findOne(n=>n.name==='Input');\ninp.fills=[solid('FFFFFF')]; inp.strokes=[solid('007AFF')]; inp.strokeWeight=1.5;\nconst mc=(await N('6:11')).createInstance(); sheet.appendChild(mc); mc.resize(39,26); mc.x=300; mc.y=383; mc.name='Detected Mastercard';\nconst f3_=tfc.createInstance(); sheet.appendChild(f3_); f3_.resize(161,71); f3_.x=20; f3_.y=428; f3_.name='Field Expiry';\nf3_.findOne(n=>n.name==='Label').characters='Expiry Date';\nf3_.findOne(n=>n.name==='Value').characters='MM / YY';\nconst f4_=tfc.createInstance(); sheet.appendChild(f4_); f4_.resize(161,71); f4_.x=194; f4_.y=428; f4_.name='Field CVV';\nf4_.findOne(n=>n.name==='Label').characters='CVV';\nf4_.findOne(n=>n.name==='Value').characters='123';\nconst hlp=(await N('6:5')).createInstance(); sheet.appendChild(hlp); hlp.resize(24,24); hlp.x=323; hlp.y=462; hlp.name='Help';\nconst btn4=(await N('1:23')).createInstance(); sheet.appendChild(btn4); btn4.resize(335,52); btn4.x=20; btn4.y=511; btn4.name='Button Add New Card';\nbtn4.findOne(n=>n.type==='TEXT').characters='Add new card';\nconst hi2=(await N('1:44')).createInstance(); f4.appendChild(hi2); hi2.x=0; hi2.y=778; hi2.name='Home Indicator';\nout.f4=f4.id; out.btnClose4=icl.id; out.btnAddNew4=btn4.id;\ncap('04 · Add Card',1425);\nreturn JSON.stringify(out);\n","description":"Build screens 03_Wallet and 04_Add_Card with sheet presentation and focused card number field","fileKey":"KGjmNajqa9on8PzOkCc7Tv"}}],"id":"48817c