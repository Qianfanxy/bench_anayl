=f11.findOne(n=>n.name==='Header'&&n.parent===f11);\nif(old.type==='FRAME'){ const inst=ho.createInstance(); f11.insertChild(f11.children.indexOf(old),inst); inst.x=0; inst.y=44; inst.name='Header'; const k=Object.keys(inst.componentProperties).find(p=>p.startsWith('Title')); inst.setProperties({[k]:'Profile'}); old.remove(); log.push('11 header → component'); }\n// Fixed-on-scroll shell for tall frames: fixed children must be last in the layer list\nconst names=['01_Splash','02_Onboarding','03_Sign_Up_Empty','03_Sign_Up_Filled','04_Verify_Phone','05_Verify_Code','06_Welcome','07_Home','08_Portfolio','09_Stock_Detail','10_Confirm_Order','11_Profile'];\nfor(const nm of names){ const f=ws.children.find(n=>n.name===nm); if(f.height<=812) continue;\n  const sb=f.children.find(n=>n.name==='Status Bar'); const bot=f.children.find(n=>n.name==='Main Navigation'||n.name==='Home Indicator');\n  await sb.setFillStyleIdAsync(P['Surface/Base'].id); f.appendChild(sb); f.appendChild(bot); f.numberOfFixedChildren=2; log.push(nm+' fixed='+f.numberOfFixedChildren+' overflow='+f.overflowDirection); }\nconst audit={};\nfor(const nm of names){ const f=ws.children.find(n=>n.name===nm); const r=[]; if(f.reactions.length) r.push('frame→'+(await figma.getNodeByIdAsync(f.reactions[0].actions[0].destinationId)).name);\n  for(const n of f.findAll(x=>'reactions' in x && x.reactions.length)){ r.push(n.name+'→'+(await figma.getNodeByIdAsync(n.reactions[0].actions[0].destinationId)).name); }\n  audit[nm]={size:f.width+'x'+f.height,links:r}; }\nconst rootOf=n=>{let p=n;while(p.parent&&p.parent.type!=='PAGE')p=p.parent;return p.name;};\nconst fonts=[...new Set(ws.findAll(n=>n.type==='TEXT').map(t=>t.fontName===figma.mixed?'mixed':t.fontName.family))];\nreturn {log,audit,fonts,top:ws.children.map(n=>n.name+' '+n.id),flows:ws.flowStartingPoints};","description":"Fix chart outlines, slash, extra copy, profile header, fixed-on-scroll shell; audit","fileKey":"6A76LajyrMFNXzfkp2i7QL"}}],"container":null,"