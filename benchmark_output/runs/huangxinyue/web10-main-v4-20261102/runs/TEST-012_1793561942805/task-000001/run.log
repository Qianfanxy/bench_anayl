oto_Wagyu_Cheeseburger_Alt'],['Healthy Japanese Fried Rice with Asparagus','Healthy',0,'Photo_Japanese_Fried_Rice'],['Cauliflower Walnut Vegetarian Taco Meat','Eastern',0,'Photo_Cauliflower_Taco']];\nconst {f,body}=page('04_Blog_Post',4620,'Blog'); let fr;\ntry{\nconst art=F('Article','VERTICAL',{gap:64,cross:'CENTER',parent:body,fillW:true});\nconst ah=F('Article Header','VERTICAL',{gap:32,cross:'CENTER',parent:art,fillW:true});\nawait T('Full Guide to Becoming a Professional Chef','Display','text/primary',{parent:ah,w:900,align:'CENTER',name:'Title'});\nconst by=F('Byline','HORIZONTAL',{gap:20,cross:'CENTER',parent:ah}); const av=I('Avatar_Dianne_Russell',48,48,by); av.cornerRadius=999;\nawait T('Dianne Russell','Body Strong','text/primary',{parent:by}); F('Divider','HORIZONTAL',{w:1,h:28,fill:'border/default',parent:by}); await T('12 November 2021','Body L','text/muted',{parent:by});\nawait T('We asked a working head chef about first jobs, long services and what it really takes to make it in a professional kitchen.','Body L','text/secondary',{parent:ah,w:760,align:'CENTER',name:'Intro'});\nconst hero=F('Hero Photo','HORIZONTAL',{w:1280,h:600,r:40,clip:true,parent:art}); const hp=I('Photo_Blog_Chef',1280,600,hero); hp.layoutSizingHorizontal='FILL'; hp.layoutSizingVertical='FILL';\nconst cols=F('Article Body','HORIZONTAL',{gap:80,parent:art});\nconst share=F('Share','VERTICAL',{gap:24,w:120,cross:'CENTER',parent:cols}); await T('SHARE THIS ON:','Caps','text/primary',{parent:share,align:'CENTER',w:120});\nfor(const l of ['Logo_Facebook','Logo_Twitter','Logo_Instagram']){const b=F(l,'HORIZONTAL',{w:52,h:52,r:999,main:'CENTER',cross:'CENTER',fill:'brand/tint',parent:share});I(l,null,null,b);}\nconst txt=F('Q&A','VERTICAL',{w:840,gap:48,parent:cols});\nconst qa=[['How did you start out in the food industry?','I started washing dishes in a small family restaurant when I was sixteen. Watching the line cooks every night made me want to be on the other side of the pass, and after two years the chef finally let me prep vegetables.'],['What do you like most about your job?','The rhythm of service. Hours of preparation come down to a few intense minutes, and when a full dining room goes quiet because everyone is eating, it feels like the whole team has done something together.'],['Do you cook at home on your days off?','Yes, but simply. I cook the food I grew up with: rice, eggs and whatever vegetables look good at the market. Home cooking is where I remember why I love food.'],['What would your advice be to young people looking to get their foot in the door?','Start anywhere and be the person who shows up early. Ask questions, taste everything and write down what you learn.'],['What is the biggest misconception that people have about being a professional chef?','That it is all creativity. Most of the job is consistency: making the same dish perfectly two hundred times a night, keeping the kitchen clean and looking after your team.']];\nfor(let i=0;i<5;i++){const b=F('Q'+(i+1),'VERTICAL',{gap:20,parent:txt,fillW:true});await T(qa[i][0],'H2','text/primary',{parent:b,fillW:true,name:'Question'});const a=await T(qa[i][1],'Body L','text/secondary',{parent:b,fillW:true,name:'Answer'});a.fontSize=18;a.lineHeight={unit:'PIXELS',value:32};\n if(i===2){const ph=F('Inline Photo','HORIZONTAL',{h:480,r:30,clip:true,parent:txt,fillW:true});const p=I('Photo_Cooking_Step',840,480,ph);p.layoutSizingHorizontal='FILL';p.layoutSizingVertical='FILL';}\n if(i===3){const q=F('Pull Quote','HORIZONTAL',{gap:24,p:[40,48],r:30,fill:'brand/tint',parent:txt,fillW:true});F('Bar','HORIZONTAL',{w:4,fill:'brand/ink',parent:q,fillH:true});await T('“Technique can be taught; curiosity and reliability can’t.”','Quote','text/primary',{parent:q,fillW:true,name:'Quote'});}}\nbody.appendChild(C.nl.createInstance());\nconst rec=F('Recommended recipes','VERTICAL',{gap:56,cross:'CENTER',parent:body,fillW:true});\nawait T('Check out the delicious recipes','H1','text/primary',{par