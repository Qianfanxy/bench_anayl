xisAlignItems=o.main;f.clipsContent=false;return f;}\nconst af=(n,d,o)=>setup(figma.createFrame(),n,d,o);const comp=(n,d,o)=>setup(figma.createComponent(),n,d,o);\nfunction fixW(f,w){const p=f.primaryAxisSizingMode;f.resize(w,f.height);if(f.layoutMode==='VERTICAL'){f.counterAxisSizingMode='FIXED';f.primaryAxisSizingMode='AUTO';}else{f.primaryAxisSizingMode='FIXED';}}\nconst ID={agents:'3:20',MH:['3:27','3:35','3:28','3:29','3:30','3:31','3:32'],client:'3:18',kayley:'3:19',check:'3:8',bed:'3:6'};\nasync function inst(id){const c=await figma.getNodeByIdAsync(id);return c.createInstance();}\nasync function icon(id,k){const i=await inst(id);i.fills=[];for(const v of i.findAll(x=>x.type==='VECTOR')){if(v.strokes.length)v.strokes=paint(k);if(v.fills.length)v.fills=paint(k);}return i;}\nfunction setLayout(set,dir,gap,wrapW){set.layoutMode=dir;set.itemSpacing=gap;set.paddingTop=set.paddingBottom=set.paddingLeft=set.paddingRight=32;set.primaryAxisSizingMode='AUTO';set.counterAxisSizingMode='AUTO';if(wrapW){set.layoutWrap='WRAP';set.counterAxisSpacing=gap;set.primaryAxisSizingMode='FIXED';set.resize(wrapW,set.height);} set.fills=[{type:'SOLID',color:{r:1,g:1,b:1}}];set.cornerRadius=12;set.strokes=[{type:'SOLID',color:{r:0.6,g:0.4,b:1}}];set.dashPattern=[6,4];set.counterAxisAlignItems='MIN';}\nconst board=await figma.getNodeByIdAsync('9:2');\nasync function section(title,note){const s=af('Section · '+title,'VERTICAL',{gap:16});s.appendChild(await txt(title,'H3','ink'));if(note)s.appendChild(await txt(note,'Small','ink5',{w:1200}));board.appendChild(s);return s;}\nconst btnSet=await figma.getNodeByIdAsync('9:37');const btnP=btnSet.children.find(c=>c.name==='Style=Primary, State=Default');const btnL=btnSet.children.find(c=>c.name==='Style=Link, State=Default');\nconst ffSet=await figma.getNodeByIdAsync('9:130');const ffS=ffSet.children.find(c=>c.name==='Type=Single, State=Default');const ffM=ffSet.children.find(c=>c.name==='Type=Multiline, State=Default');\nfunction setBtn(i,label){i.findOne(n=>n.type==='TEXT').characters=label;}\nconst R={};\n\n// Testimonial Client\nconst clV=[];\nfor(const cur of ['false','true']){const c=comp(`Current=${cur}`,'HORIZONTAL',{gap:14,pad:[12,20,12,12],align:'CENTER',r:40});\n if(cur==='true'){await fill(c,'white');await stroke(c,'brand',2);c.effects=ES['Elevation/1 Card'].effects;}else{c.opacity=1;}\n const a=await inst(ID.client);a.name='Avatar_Client';a.resize(56,56);a.cornerRadius=28;if(cur==='false')a.opacity=0.6;c.appendChild(a);\n const tx=af('Text','VERTICAL',{gap:2});tx.appendChild(await txt('Leo Madrigal','Body Strong',cur==='true'?'ink':'ink5',{name:'Name'}));tx.appendChild(await txt('Client','Small',cur==='true'?'brand6':'ink5',{name:'Role'}));c.appendChild(tx);clV.push(c);}\nlet s=await section('Testimonial Client','Avatar_Client · name · “Client”. Current = white pill with amber border; others are muted.');\nconst clSet=figma.combineAsVariants(clV,s);clSet.name='Testimonial Client';setLayout(clSet,'HORIZONTAL',24);\nconst pcn=clSet.addComponentProperty('Name','TEXT','Leo Madrigal');for(const v of clSet.children)v.findOne(n=>n.name==='Name').componentPropertyReferences={characters:pcn};R.client=clSet.id;\n\n// Gallery Thumbnail\nconst thV=[];\nfor(const st of ['Default','Hover','Selected']){const c=comp(`State=${st}`,'HORIZONTAL',{r:8});c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';c.resize(158,108);c.clipsContent=true;\n const p=await inst(ID.MH[0]);p.name='Photo';p.layoutAlign='STRETCH';p.layoutGrow=1;c.appendChild(p);\n if(st==='Selected'){c.strokes=paint('brand');c.strokeWeight=3;c.strokeAlign='INSIDE';}\n if(st==='Hover'){c.strokes=paint('white');c.strokeWeight=2;c.strokeAlign='INSIDE';c.effects=ES['Elevation/2 Raised'].effects;}\n if(st==='Default'){p.opacity=0.85;}\n thV.push(c);}\ns=await section('Gallery Thumbnail','Default (slightly dimmed) · Hover · Selected (3px amber inner border). On 02_Property nothing is selected — the main photo is shown.');\nconst thSet=figma.combineAsVariants(thV,s);thSet.name='Gallery Thumbnail';setLayout(thSet,'HORIZONTAL',24);\nconst pth=thSet.addComponentProperty('Photo','INSTANCE_SWAP',ID.MH[0]);for(const v of thSet.children)v.findOne(n=>n.name==='Photo').componentPropertyReferences={mainComponent:pth};R.thumb=thSet.id;\n\n// Feature Item\nconst fi=comp('Feature Item','HORIZONTAL',{gap:12,align:'CENTER'});\nconst ck=await inst(ID.check);ck.fills=[];const vs=ck.findAll(x=>x.type==='VECTOR');for(const v of vs){if(v.fills.length)v.fills=paint('tint');if(v.strokes.length)v.strokes=paint('brand6');}ck.name='Icon_Check';fi.appendChild(ck);\nconst fit=await txt('Air conditioning','Body','ink7',{name:'Label'});fi.appendChild(fit);\nconst pfi=fi.addComponentProperty('Label','TEXT','Air conditioning');fit.componentPropertyReferences={characters:pfi};\ns=await section('Feature Item','Icon_Check (amber on amber tint) + feature label.');s.appendChild(fi);R.feature=fi.id;\n\n// Detail Item\nconst di=comp('Detail Item','HORIZONTAL',{gap:14,align:'CENTER'});\nconst disc=af('Icon disc','HORIZONTAL',{align:'CENTER',main:'CENTER',r:24});disc.primaryAxisSizingMode='FIXED';disc.counterAxisSizingMode='FIXED';disc.resize(48,48);await fill(disc,'tint');\nconst bi=await icon(ID.bed,'brand6');bi.name='Icon';bi.rescale(1.4);disc.appendChild(bi);di.appendChild(disc);\nconst dit=await txt('4 Bedrooms','Body Strong','ink',{name:'Value'});di.appendChild(dit);\nconst pdi=di.addComponentProperty('Value','TEXT','4 Bedrooms');dit.componentPropertyReferences={characters:pdi};\nconst pdic=di.addComponentProperty('Icon','INSTANCE_SWAP',ID.bed);bi.componentPropertyReferences={mainComponent:pdic};\ns=await section('Detail Item','Icon (swap: Bed / Bath / Garage / Floors / Calendar) in an amber-tint disc + value.');s.appendChild(di);R.detail=di.id;\n\n// Agency Section\nconst agV=[];\nfor(const lay of ['Image Left','Image Right']){const c=comp(`Layout=${lay}`,'HORIZONTAL',{gap:96,align:'CENTER'});\n const p=await inst(ID.agents);p.name='Photo_Agents_Meeting';p.resize(588,460);p.cornerRadius=20;\n const tc=af('Copy','VERTICAL',{gap:24});fixW(tc,516);\n const acc=figma.createRectangle();acc.name='Accent';acc.resize(48,4);acc.cornerRadius=2;acc.fills=paint('brand');tc.appendChild(acc);\n tc.appendChild(await txt('You’re in good hands','H2','ink',{name:'Title',w:516}));\n tc.appendChild(await txt('Our agents have helped more than 2,000 families buy, sell and rent. We listen first, explain every step and stay with you until the keys are in your hand.','Body L','ink7',{name:'Body',w:516}));\n const lb=btnL.createInstance();setBtn(lb,'Learn more');lb.name='Button · Learn more';tc.appendChild(lb);\n if(lay==='Image Left'){c.appendChild(p);c.appendChild(tc);}else{c.appendChild(tc);c.appendChild(p);}\n agV.push(c);}\ns=await section('Agency Section','Agency intro block · photo + title + copy + Learn more. Alternates image side.');\nconst agSet=figma.combineAsVariants(agV,s);agSet.name='Agency Section';setLayout(agSet,'VERTICAL',48);\nconst pat=agSet.addComponentProperty('Title','TEXT','You’re in good hands');const pab=agSet.addComponentProperty('Body','TEXT','Our agents have helped more than 2,000 families buy, sell and rent. We listen first, explain every step and stay with you until the keys are in your hand.');\nfor(const v of agSet.children){v.findOne(n=>n.name==='Title').componentPropertyReferences={characters:pat};v.findOne(n=>n.name==='Body').componentPropertyReferences={characters:pab};}R.agency=agSet.id;\n\n// CTA Band\nconst cta=comp('CTA Band','HORIZONTAL',{pad:[64,80],align:'CENTER',main:'SPACE_BETWEEN',r:24});fixW(cta,1200);await fill(cta,'tint');cta.clipsContent=true;\nconst cc=af('Copy','VERTICAL',{gap:16});cc.appendChild(await txt('Ready to sell your home?','H2','ink'));cc.appendChild(await txt('Get a free valuation and a clear plan to sell at the right price, on your timeline.','Body L','ink7',{w:560}));cta.appendChild(cc);\nconst cb=btnP.createInstance();setBtn(cb,'Learn more');cb.name='Button · Learn more';cta.appendChild(cb);\ns=await section('CTA Band','Call to action · amber-tint band, radius 24.');s.appendChild(cta);R.cta=cta.id;\n\n// Agent Contact\nconst ac=comp('Agent Contact','VERTICAL',{gap:24,pad:[32,32]});fixW(ac,384);await fill(ac,'white');await stroke(ac,'line');ac.cornerRadius=16;ac.effects=ES['Elevation/2 Raised'].effects;\nac.appendChild(await txt('Contact the agent','Overline','ink5',{upper:true}));\nconst ag=af('Agent','HORIZONTAL',{gap:16,align:'CENTER'});const av=await inst(ID.kayley);av.name='Avatar_Kayley_Hall';av.resize(64,64);av.cornerRadius=32;ag.appendChild(av);\nconst an=af('Agent text','VERTICAL',{gap:4});an.appendChild(await txt('Kayley Hall','H4','ink'));const vp=await txt('View profile','Small Strong','brand6',{name:'View profile'});vp.textDecoration='UNDERLINE';an.appendChild(vp);ag.appendChild(an);ac.appendChild(ag);\nconst d=figma.createRectangle();d.name='Divider';d.resize(320,1);d.fills=paint('line');d.layoutAlign='STRETCH';ac.appendChild(d);\nconst form=af('Form','VERTICAL',{gap:16});form.layoutAlign='STRETCH';\nfor(const [l,p] of [['Name','Full name'],['Phone','+1 (555) 000-0000'],['Email','you@example.com']]){const i=ffS.createInstance();i.name='Field · '+l;i.layoutAlign='STRETCH';i.findOne(n=>n.name==='Label').characters=l;i.findOne(n=>n.name==='Placeholder').characters=p;form.appendChild(i);}\nconst mi=ffM.createInstance();mi.name='Field · Message';mi.layoutAlign='STRETCH';form.appendChild(mi);\nconst sb=btnP.createInstance();setBtn(sb,'Contact agent');sb.name='Button · Contact agent';sb.layoutAlign='STRETCH';sb.primaryAxisAlignItems='CENTER';form.appendChild(sb);\nac.appendChild(form);\ns=await section('Agent Contact','Avatar_Kayley_Hall · Kayley Hall · View profile · Name / Phone / Email / Message form (Form Field instances) · Contact agent.');s.appendChild(ac);R.contact=ac.id;\nreturn R;","description":"Build client, thumbnail, feature, detail, agency, CTA, contact components","fileKey":"3KZ3B4yH0x44BL8SAdaR