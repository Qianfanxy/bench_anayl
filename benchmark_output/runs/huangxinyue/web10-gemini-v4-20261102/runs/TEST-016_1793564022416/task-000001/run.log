;\n  }\n\n  // Create frame 02_Timeline\n  const frame = figma.createFrame();\n  frame.name = \"02_Timeline\";\n  frame.resize(1440, 1024);\n  frame.x = 1500;\n  frame.y = 0;\n  frame.fills = [{ type: 'SOLID', color: { r: 0.97, g: 0.975, b: 0.99 } }];\n\n  // 1. Sidebar (active: Timeline)\n  const sidebar = figma.createFrame();\n  sidebar.name = \"Sidebar\";\n  sidebar.resize(80, 1024);\n  sidebar.x = 0; sidebar.y = 0;\n  sidebar.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  sidebar.layoutMode = \"VERTICAL\";\n  sidebar.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  sidebar.counterAxisAlignItems = \"CENTER\";\n  sidebar.paddingTop = 24; sidebar.paddingBottom = 24;\n\n  const topGroup = figma.createFrame();\n  topGroup.layoutMode = \"VERTICAL\";\n  topGroup.counterAxisAlignItems = \"CENTER\";\n  topGroup.itemSpacing = 36;\n  topGroup.fills = [];\n\n  const logoContainer = figma.createFrame();\n  logoContainer.layoutMode = \"VERTICAL\";\n  logoContainer.counterAxisAlignItems = \"CENTER\";\n  logoContainer.itemSpacing = 4;\n  logoContainer.fills = [];\n  logoContainer.appendChild(getAsset(\"Logo_Octom\", 36));\n  const logoText = figma.createText();\n  logoText.characters = \"OCTOM.\";\n  logoText.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  logoText.fontSize = 10;\n  logoText.fills = [{ type: 'SOLID', color: { r: 0.314, g: 0.318, b: 0.976 } }];\n  logoContainer.appendChild(logoText);\n  topGroup.appendChild(logoContainer);\n\n  const navItems = [\n    { name: 'Dashboard', icon: 'Icon_Nav_Dashboard', key: 'Dashboard' },\n    { name: 'Timeline', icon: 'Icon_Nav_Timeline', key: 'Timeline' },\n    { name: 'Task', icon: 'Icon_Nav_Task', key: 'Task' },\n    { name: 'Settings', icon: 'Icon_Nav_Settings', key: 'Settings' },\n    { name: 'Messages', icon: 'Icon_Nav_Messages', key: 'Messages' },\n    { name: 'Files', icon: 'Icon_Nav_Files', key: 'Files' }\n  ];\n\n  const navContainer = figma.createFrame();\n  navContainer.layoutMode = \"VERTICAL\";\n  navContainer.counterAxisAlignItems = \"CENTER\";\n  navContainer.itemSpacing = 14;\n  navContainer.fills = [];\n\n  for (const item of navItems) {\n    const navBtn = figma.createFrame();\n    navBtn.name = `Nav_${item.key}`;\n    navBtn.resize(48, 48);\n    navBtn.cornerRadius = 12;\n    navBtn.layoutMode = \"HORIZONTAL\";\n    navBtn.primaryAxisAlignItems = \"CENTER\";\n    navBtn.counterAxisAlignItems = \"CENTER\";\n    if (item.key === 'Timeline') {\n      navBtn.fills = [{ type: 'SOLID', color: { r: 0.314, g: 0.318, b: 0.976 } }];\n    } else {\n      navBtn.fills = [];\n    }\n    navBtn.appendChild(getAsset(item.icon, 24));\n    navContainer.appendChild(navBtn);\n  }\n  topGroup.appendChild(navContainer);\n  sidebar.appendChild(topGroup);\n  frame.appendChild(sidebar);\n\n  // 2. Top bar\n  const topbar = figma.createFrame();\n  topbar.name = \"Topbar\";\n  topbar.resize(1360, 72);\n  topbar.x = 80; topbar.y = 0;\n  topbar.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  topbar.layoutMode = \"HORIZONTAL\";\n  topbar.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  topbar.counterAxisAlignItems = \"CENTER\";\n  topbar.paddingLeft = 32; topbar.paddingRight = 32;\n\n  const searchBox = figma.createFrame();\n  searchBox.resize(320, 40);\n  searchBox.cornerRadius = 10;\n  searchBox.fills = [{ type: 'SOLID', color: { r: 0.96, g: 0.965, b: 0.98 } }];\n  searchBox.layoutMode = \"HORIZONTAL\";\n  searchBox.counterAxisAlignItems = \"CENTER\";\n  searchBox.paddingLeft = 14; searchBox.itemSpacing = 10;\n  searchBox.appendChild(getAsset(\"Icon_Search\", 18));\n  const searchText = figma.createText();\n  searchText.characters = \"Search anything...\";\n  searchText.fontName = { family: \"DM Sans\", style: \"Regular\" };\n  searchText.fontSize = 14;\n  searchText.fills = [{ type: 'SOLID', color: { r: 0.6, g: 0.6, b: 0.65 } }];\n  searchBox.appendChild(searchText);\n  topbar.appendChild(searchBox);\n\n  const rightGroup = figma.createFrame();\n  rightGroup.layoutMode = \"HORIZONTAL\";\n  rightGroup.counterAxisAlignItems = \"CENTER\";\n  rightGroup.itemSpacing = 20;\n  rightGroup.fills = [];\n\n  const notifBtn = figma.createFrame();\n  notifBtn.resize(40, 40);\n  notifBtn.cornerRadius = 10;\n  notifBtn.fills = [{ type: 'SOLID', color: { r: 0.96, g: 0.965, b: 0.98 } }];\n  const bell = getAsset(\"Icon_Bell\", 20);\n  bell.x = 10; bell.y = 10;\n  notifBtn.appendChild(bell);\n  const badge = figma.createFrame();\n  badge.resize(16, 16);\n  badge.cornerRadius = 8;\n  badge.fills = [{ type: 'SOLID', color: { r: 0.98, g: 0.3, b: 0.3 } }];\n  badge.x = 22; badge.y = 6;\n  badge.layoutMode = \"HORIZONTAL\";\n  badge.primaryAxisAlignItems = \"CENTER\";\n  badge.counterAxisAlignItems = \"CENTER\";\n  const badgeText = figma.createText();\n  badgeText.characters = \"2\";\n  badgeText.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  badgeText.fontSize = 10;\n  badgeText.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  badge.appendChild(badgeText);\n  notifBtn.appendChild(badge);\n  rightGroup.appendChild(notifBtn);\n\n  const userMenu = figma.createFrame();\n  userMenu.layoutMode = \"HORIZONTAL\";\n  userMenu.counterAxisAlignItems = \"CENTER\";\n  userMenu.itemSpacing = 10;\n  userMenu.fills = [];\n  userMenu.appendChild(getAsset(\"Avatar_Current_User\", 40));\n  const userName = figma.createText();\n  userName.characters = \"Dristin Watson\";\n  userName.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  userName.fontSize = 14;\n  userName.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n  userMenu.appendChild(userName);\n  userMenu.appendChild(getAsset(\"Icon_Chevron_Down\", 16));\n  rightGroup.appendChild(userMenu);\n  topbar.appendChild(rightGroup);\n  frame.appendChild(topbar);\n\n  // 3. Content Container (x: 104, y: 92, w: 1312, h: 908)\n  const content = figma.createFrame();\n  content.name = \"Content\";\n  content.resize(1312, 908);\n  content.x = 104; content.y = 92;\n  content.fills = [];\n  content.layoutMode = \"VERTICAL\";\n  content.itemSpacing = 20;\n\n  // Header row (w: 1312)\n  const header = figma.createFrame();\n  header.name = \"TimelineHeader\";\n  header.resize(1312, 56);\n  header.cornerRadius = 16;\n  header.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  header.paddingLeft = 24; header.paddingRight = 24;\n  header.layoutMode = \"HORIZONTAL\";\n  header.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  header.counterAxisAlignItems = \"CENTER\";\n\n  // Left: Timeline title + date controls\n  const hLeft = figma.createFrame();\n  hLeft.layoutMode = \"HORIZONTAL\";\n  hLeft.counterAxisAlignItems = \"CENTER\";\n  hLeft.itemSpacing = 24;\n  hLeft.fills = [];\n\n  const titleTxt = figma.createText();\n  titleTxt.characters = \"Timeline\";\n  titleTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  titleTxt.fontSize = 20;\n  titleTxt.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n  hLeft.appendChild(titleTxt);\n\n  const dateCtrl = figma.createFrame();\n  dateCtrl.layoutMode = \"HORIZONTAL\";\n  dateCtrl.counterAxisAlignItems = \"CENTER\";\n  dateCtrl.itemSpacing = 12;\n  dateCtrl.fills = [];\n\n  const todayBtn = figma.createFrame();\n  todayBtn.paddingLeft = 12; todayBtn.paddingRight = 12;\n  todayBtn.paddingTop = 6; todayBtn.paddingBottom = 6;\n  todayBtn.cornerRadius = 8;\n  todayBtn.fills = [{ type: 'SOLID', color: { r: 0.94, g: 0.94, b: 0.98 } }];\n  const todayTxt = figma.createText();\n  todayTxt.characters = \"Today\";\n  todayTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  todayTxt.fontSize = 13;\n  todayTxt.fills = [{ type: 'SOLID', color: { r: 0.314, g: 0.318, b: 0.976 } }];\n  todayBtn.appendChild(todayTxt);\n  dateCtrl.appendChild(todayBtn);\n\n  dateCtrl.appendChild(getAsset(\"Icon_Chevron_Left\", 18));\n  const dateTxt = figma.createText();\n  dateTxt.characters = \"June 20, 2022\";\n  dateTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  dateTxt.fontSize = 14;\n  dateTxt.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n  dateCtrl.appendChild(dateTxt);\n  dateCtrl.appendChild(getAsset(\"Icon_Chevron_Right\", 18));\n  hLeft.appendChild(dateCtrl);\n  header.appendChild(hLeft);\n\n  // Right: Invite + team avatars with +5\n  const hRight = figma.createFrame();\n  hRight.layoutMode = \"HORIZONTAL\";\n  hRight.counterAxisAlignItems = \"CENTER\";\n  hRight.itemSpacing = 16;\n  hRight.fills = [];\n\n  const inviteTxt = figma.createText();\n  inviteTxt.characters = \"+ Invite\";\n  inviteTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  inviteTxt.fontSize = 13;\n  inviteTxt.fills = [{ type: 'SOLID', color: { r: 0.314, g: 0.318, b: 0.976 } }];\n  hRight.appendChild(inviteTxt);\n\n  const teamAv = figma.createFrame();\n  teamAv.layoutMode = \"HORIZONTAL\";\n  teamAv.itemSpacing = -8;\n  teamAv.fills = [];\n  teamAv.appendChild(getAsset(\"Avatar_Cris_Morich\", 32));\n  teamAv.appendChild(getAsset(\"Avatar_Charmie\", 32));\n  teamAv.appendChild(getAsset(\"Avatar_Jason_Mandala\", 32));\n\n  const plus5 = figma.createFrame();\n  plus5.resize(32, 32);\n  plus5.cornerRadius = 16;\n  plus5.fills = [{ type: 'SOLID', color: { r: 0.9, g: 0.9, b: 0.95 } }];\n  plus5.layoutMode = \"HORIZONTAL\";\n  plus5.primaryAxisAlignItems = \"CENTER\";\n  plus5.counterAxisAlignItems = \"CENTER\";\n  const p5Txt = figma.createText();\n  p5Txt.characters = \"+5\";\n  p5Txt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  p5Txt.fontSize = 12;\n  p5Txt.fills = [{ type: 'SOLID', color: { r: 0.4, g: 0.4, b: 0.45 } }];\n  plus5.appendChild(p5Txt);\n  teamAv.appendChild(plus5);\n  hRight.appendChild(teamAv);\n\n  header.appendChild(hRight);\n  content.appendChild(header);\n\n  // Main Split Row: Left Timeline Gantt (w: 960), Right Complete Task Card (w: 332)\n  const splitRow = figma.createFrame();\n  splitRow.name = \"SplitRow\";\n  splitRow.resize(1312, 820);\n  splitRow.layoutMode = \"HORIZONTAL\";\n  splitRow.itemSpacing = 20;\n  splitRow.fills = [];\n\n  // Left Gantt Main Card\n  const ganttCard = figma.createFrame();\n  ganttCard.name = \"GanttCard\";\n  ganttCard.resize(960, 820);\n  ganttCard.cornerRadius = 16;\n  ganttCard.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  ganttCard.paddingTop = 20; ganttCard.paddingBottom = 20;\n  ganttCard.paddingLeft = 24; ganttCard.paddingRight = 24;\n  ganttCard.layoutMode = \"VERTICAL\";\n  ganttCard.itemSpacing = 16;\n\n  // Day scale header: S 04 … S 21 (18 consecutive days)\n  const scaleRow = figma.createFrame();\n  scaleRow.name = \"DayScaleRow\";\n  scaleRow.resize(912, 32);\n  scaleRow.layoutMode = \"HORIZONTAL\";\n  scaleRow.counterAxisAlignItems = \"CENTER\";\n  scaleRow.fills = [{ type: 'SOLID', color: { r: 0.97, g: 0.975, b: 0.99 } }];\n  scaleRow.cornerRadius = 8;\n  scaleRow.paddingLeft = 260; // Leave space for Phase label column\n\n  const dayScaleGrid = figma.createFrame();\n  dayScaleGrid.resize(652, 32);\n  dayScaleGrid.layoutMode = \"HORIZONTAL\";\n  dayScaleGrid.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  dayScaleGrid.counterAxisAlignItems = \"CENTER\";\n  dayScaleGrid.fills = [];\n\n  const days = [\"S 04\", \"M 05\", \"T 06\", \"W 07\", \"T 08\", \"F 09\", \"S 10\", \"S 11\", \"M 12\", \"T 13\", \"W 14\", \"T 15\", \"F 16\", \"S 17\", \"S 18\", \"M 19\", \"T 20\", \"S 21\"];\n  days.forEach((d) => {\n    const dTxt = figma.createText();\n    dTxt.characters = d;\n    dTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n    dTxt.fontSize = 11;\n    dTxt.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.55 } }];\n    dayScaleGrid.appendChild(dTxt);\n  });\n  scaleRow.appendChild(dayScaleGrid);\n  ganttCard.appendChild(scaleRow);\n\n  // Phases and Timeline Bars\n  const phasesData = [\n    {\n      name: \"UX Research\",\n      avatars: [\"Avatar_Cris_Morich\"],\n      bars: [\n        { label: \"Profile 48%\", startDay: 1, length: 5, color: { r: 0.314, g: 0.318, b: 0.976 } },\n        { label: \"Menu 54%\", startDay: 6, length: 6, color: { r: 0.2, g: 0.75, b: 0.4 } },\n        { label: \"Settings 39%\", startDay: 12, length: 5, color: { r: 1, g: 0.6, b: 0.2 } }\n      ]\n    },\n    {\n      name: \"Information Architecture\",\n      avatars: [\"Avatar_Charmie\"],\n      bars: [\n        { label: \"Login 48%\", startDay: 2, length: 6, color: { r: 0.314, g: 0.318, b: 0.976 } },\n        { label: \"Services 54%\", startDay: 9, length: 7, color: { r: 0.2, g: 0.75, b: 0.4 } }\n      ]\n    },\n    {\n      name: \"Design Phase\",\n      subhead: \"Build Wireframe, User Interface Design\",\n      avatars: [\"Avatar_Jason_Mandala\", \"Avatar_Charlie_Chu\"],\n      bars: [\n        { label: \"Testimonials 69%\", startDay: 3, length: 7, color: { r: 0.9, g: 0.3, b: 0.4 } },\n        { label: \"Menu 61%\", startDay: 8, length: 5, color: { r: 0.314, g: 0.318, b: 0.976 } },\n        { label: \"Homepage 48%\", startDay: 13, length: 5, color: { r: 0.2, g: 0.75, b: 0.4 } }\n      ]\n    },\n    {\n      name: \"Prototyping\",\n      avatars: [\"Avatar_Claudia_Maudi\"],\n      bars: [\n        { label: \"Our Portfolio 63%\", startDay: 5, length: 8, color: { r: 1, g: 0.6, b: 0.2 } }\n      ]\n    },\n    {\n      name: \"Development\",\n      subhead: \"Back-End Development, Front-End Development\",\n      avatars: [\"Avatar_Killan_James\", \"Avatar_Novita\"],\n      bars: [\n        { label: \"Profile 48%\", startDay: 7, length: 6, color: { r: 0.314, g: 0.318, b: 0.976 } },\n        { label: \"Services 54%\", startDay: 12, length: 6, color: { r: 0.2, g: 0.75, b: 0.4 } }\n      ]\n    }\n  ];\n\n  for (const p of phasesData) {\n    const pGroup = figma.createFrame();\n    pGroup.name = `Phase_${p.name.replace(/\\s+/g, '')}`;\n    pGroup.resize(912, 120);\n    pGroup.layoutMode = \"VERTICAL\";\n    pGroup.itemSpacing = 8;\n    pGroup.fills = [];\n\n    // Phase Header: Name + subhead + member avatars + Icon_More\n    const pHead = figma.createFrame();\n    pHead.resize(912, 28);\n    pHead.layoutMode = \"HORIZONTAL\";\n    pHead.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    pHead.counterAxisAlignItems = \"CENTER\";\n    pHead.fills = [];\n\n    const pTitleGroup = figma.createFrame();\n    pTitleGroup.layoutMode = \"HORIZONTAL\";\n    pTitleGroup.counterAxisAlignItems = \"CENTER\";\n    pTitleGroup.itemSpacing = 8;\n    pTitleGroup.fills = [];\n\n    const pTxt = figma.createText();\n    pTxt.characters = p.name;\n    pTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n    pTxt.fontSize = 14;\n    pTxt.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n    pTitleGroup.appendChild(pTxt);\n\n    if (p.subhead) {\n      const subTxt = figma.createText();\n      subTxt.characters = `(${p.subhead})`;\n      subTxt.fontName = { family: \"DM Sans\", style: \"Regular\" };\n      subTxt.fontSize = 12;\n      subTxt.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.55 } }];\n      pTitleGroup.appendChild(subTxt);\n    }\n    pHead.appendChild(pTitleGroup);\n\n    const pMeta = figma.createFrame();\n    pMeta.layoutMode = \"HORIZONTAL\";\n    pMeta.counterAxisAlignItems = \"CENTER\";\n    pMeta.itemSpacing = 12;\n    pMeta.fills = [];\n\n    const pAvs = figma.createFrame();\n    pAvs.layoutMode = \"HORIZONTAL\";\n    pAvs.itemSpacing = -6;\n    pAvs.fills = [];\n    for (const av of p.avatars) {\n      pAvs.appendChild(getAsset(av, 24));\n    }\n    pMeta.appendChild(pAvs);\n    pMeta.appendChild(getAsset(\"Icon_More\", 18));\n    pHead.appendChild(pMeta);\n\n    pGroup.appendChild(pHead);\n\n    // Bars container area\n    const barsTrack = figma.createFrame();\n    barsTrack.name = \"BarsTrack\";\n    barsTrack.resize(912, 76);\n    barsTrack.fills = [{ type: 'SOLID', color: { r: 0.985, g: 0.985, b: 0.995 } }];\n    barsTrack.cornerRadius = 8;\n\n    // Render bars inside track\n    // day step width = 652 / 18 = ~36.2px\n    const dayW = 36.2;\n    const startX = 260;\n\n    p.bars.forEach((b, idx) => {\n      const barFrame = figma.createFrame();\n      barFrame.name = `Bar_${b.label.replace(/\\s+/g, '')}`;\n      barFrame.resize(b.length * dayW, 26);\n      barFrame.x = startX + (b.startDay - 1) * dayW;\n      barFrame.y = 8 + (idx % 2) * 32;\n      barFrame.cornerRadius = 6;\n      barFrame.fills = [{ type: 'SOLID', color: b.color }];\n      barFrame.layoutMode = \"HORIZONTAL\";\n      barFrame.primaryAxisAlignItems = \"CENTER\";\n      barFrame.counterAxisAlignItems = \"CENTER\";\n\n      const bTxt = figma.createText();\n      bTxt.characters = b.label;\n      bTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n      bTxt.fontSize = 11;\n      bTxt.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n      barFrame.appendChild(bTxt);\n\n      barsTrack.appendChild(barFrame);\n    });\n\n    pGroup.appendChild(barsTrack);\n    ganttCard.appendChild(pGroup);\n  }\n\n  splitRow.appendChild(ganttCard);\n\n  // Right Complete Task Card (w: 332)\n  const completeCard = figma.createFrame();\n  completeCard.name = \"CompleteTaskCard\";\n  completeCard.resize(332, 820);\n  completeCard.cornerRadius = 16;\n  completeCard.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  completeCard.paddingTop = 24; completeCard.paddingBottom = 24;\n  completeCard.paddingLeft = 20; completeCard.paddingRight = 20;\n  completeCard.layoutMode = \"VERTICAL\";\n  completeCard.itemSpacing = 20;\n\n  const ctHeader = figma.createFrame();\n  ctHeader.resize(292, 28);\n  ctHeader.layoutMode = \"HORIZONTAL\";\n  ctHeader.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  ctHeader.counterAxisAlignItems = \"CENTER\";\n  ctHeader.fills = [];\n\n  const ctTitle = figma.createText();\n  ctTitle.characters = \"Complete Task\";\n  ctTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  ctTitle.fontSize = 18;\n  ctTitle.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n  ctHeader.appendChild(ctTitle);\n  ctHeader.appendChild(getAsset(\"Icon_More\", 20));\n  completeCard.appendChild(ctHeader);\n\n  // Line chart of 7 points: 67, 73, 53, 47, 39, 27, 27 (highlighted point: the last)\n  const chartBox = figma.createFrame();\n  chartBox.name = \"CompleteTaskChart\";\n  chartBox.resize(292, 300);\n  chartBox.cornerRadius = 12;\n  chartBox.fills = [{ type: 'SOLID', color: { r: 0.98, g: 0.98, b: 0.995 } }];\n\n  // 7 points plotting\n  const points = [67, 73, 53, 47, 39, 27, 27];\n  // map values to y coordinates (min 27 -> y: 220, max 73 -> y: 60)\n  const px = [20, 60, 100, 140, 180, 220, 260];\n  const py = points.map(v => 240 - (v - 20) * 3);\n\n  // Draw vector path connecting points\n  const pathData = `M ${px[0]} ${py[0]} L ${px[1]} ${py[1]} L ${px[2]} ${py[2]} L ${px[3]} ${py[3]} L ${px[4]} ${py[4]} L ${px[5]} ${py[5]} L ${px[6]} ${py[6]}`;\n  const chartLine = figma.createVector();\n  chartLine.vectorPaths = [{ windingRule: \"NONZERO\", data: pathData }];\n  chartLine.strokes = [{ type: 'SOLID', color: { r: 0.314, g: 0.318, b: 0.976 } }];\n  chartLine.strokeWeight = 3;\n  chartBox.appendChild(chartLine);\n\n  // Plot point circles & labels\n  points.forEach((val, idx) => {\n    const isLast = idx === points.length - 1;\n    const dot = figma.createEllipse();\n    dot.resize(isLast ? 12 : 8, isLast ? 12 : 8);\n    dot.x = px[idx] - (isLast ? 6 : 4);\n    dot.y = py[idx] - (isLast ? 6 : 4);\n    dot.fills = [{ type: 'SOLID', color: isLast ? { r: 0.314, g: 0.318, b: 0.976 } : { r: 0.6, g: 0.6, b: 0.7 } }];\n    if (isLast) {\n      dot.strokes = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n      dot.strokeWeight = 2;\n    }\n    chartBox.appendChild(dot);\n\n    // Label for each point\n    const pLbl = figma.createText();\n    pLbl.characters = String(val);\n    pLbl.fontName = { family: \"DM Sans\", style: isLast ? \"Bold\" : \"Regular\" };\n    pLbl.fontSize = 11;\n    pLbl.fills = [{ type: 'SOLID', color: isLast ? { r: 0.314, g: 0.318, b: 0.976 } : { r: 0.5, g: 0.5, b: 0.55 } }];\n    pLbl.x = px[idx] - 8;\n    pLbl.y = py[idx] - 22;\n    chartBox.appendChild(pLbl);\n  });\n\n  completeCard.appendChild(chartBox);\n\n  // Additional completion details summary\n  const summaryBox = figma.createFrame();\n  summaryBox.resize(292, 140);\n  summaryBox.cornerRadius = 12;\n  summaryBox.fills = [{ type: 'SOLID', color: { r: 0.94, g: 0.94, b: 0.98 } }];\n  summaryBox.paddingTop = 16; summaryBox.paddingBottom = 16;\n  summaryBox.paddingLeft = 16; summaryBox.paddingRight = 16;\n  summaryBox.layoutMode = \"VERTICAL\";\n  summaryBox.itemSpacing = 8;\n\n  const sumTitle = figma.createText();\n  sumTitle.characters = \"Current Completion Rate\";\n  sumTitle.fontName = { family: \"DM Sans\", style: \"Medium\" };\n  sumTitle.fontSize = 12;\n  sumTitle.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.55 } }];\n  summaryBox.appendChild(sumTitle);\n\n  const sumVal = figma.createText();\n  sumVal.characters = \"27% Task Remaining\";\n  sumVal.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  sumVal.fontSize = 20;\n  sumVal.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n  summaryBox.appendChild(sumVal);\n\n  const sumDesc = figma.createText();\n  sumDesc.characters = \"73% of overall project deliverables completed on schedule.\";\n  sumDesc.fontName = { family: \"DM Sans\", style: \"Regular\" };\n  sumDesc.fontSize = 12;\n  sumDesc.fills = [{ type: 'SOLID', color: { r: 0.4, g: 0.4, b: 0.45 } }];\n  summaryBox.appendChild(sumDesc);\n\n  completeCard.appendChild(summaryBox);\n  splitRow.appendChild(completeCard);\n\n  content.appendChild(splitRow);\n  frame.appendChild(content);\n\n  return \"02_Timeline successfully built\";\n}\n\nreturn await buildFrame02();\n","description":"Build 02_Timeline frame on Workspace page","fileKey":"ysVFKAVp9vIXGyYMO8MY33"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":39816,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":26942},"context_management":null},"parent_tool_use_id":null,"session_id":"06fbff5f-a7