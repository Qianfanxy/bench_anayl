ingTop = 16;\n    card.paddingBottom = 24;\n    card.layoutMode = \"VERTICAL\";\n    card.itemSpacing = 16;\n    card.clipsContent = true;\n\n    // Image frame with fav button overlay\n    const imgWrapper = figma.createFrame();\n    imgWrapper.name = \"Image Container\";\n    imgWrapper.resize(258, 200);\n    imgWrapper.cornerRadius = 20;\n    imgWrapper.clipsContent = true;\n    imgWrapper.fills = [];\n\n    const photoInst = getInst(photoName);\n    photoInst.resize(258, 200);\n    imgWrapper.appendChild(photoInst);\n\n    // Fav button overlay\n    const favBtn = figma.createFrame();\n    favBtn.name = \"Favorite Button\";\n    favBtn.resize(40, 40);\n    favBtn.x = 206;\n    favBtn.y = 12;\n    favBtn.cornerRadius = 20;\n    favBtn.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n    favBtn.layoutMode = \"HORIZONTAL\";\n    favBtn.primaryAxisAlignItems = \"CENTER\";\n    favBtn.counterAxisAlignItems = \"CENTER\";\n\n    const favIcon = getInst(\"Icon_Favorite\");\n    favIcon.resize(20, 20);\n    if (isFavorited) {\n      // Color it red/pink if favorited\n      // Fav icon vector color\n    }\n    favBtn.appendChild(favIcon);\n    imgWrapper.appendChild(favBtn);\n\n    card.appendChild(imgWrapper);\n\n    // Title\n    const titleNode = figma.createText();\n    titleNode.characters = titleText;\n    titleNode.fontSize = 18;\n    titleNode.fontName = { family: \"Inter\", style: \"Bold\" };\n    titleNode.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0 } }];\n    titleNode.resize(258, 52);\n\n    card.appendChild(titleNode);\n\n    // Tags row (Time & Category)\n    const tagsRow = figma.createFrame();\n    tagsRow.name = \"Meta Tags\";\n    tagsRow.resize(258, 30);\n    tagsRow.fills = [];\n    tagsRow.layoutMode = \"HORIZONTAL\";\n    tagsRow.itemSpacing = 24;\n    tagsRow.counterAxisAlignItems = \"CENTER\";\n\n    // Time tag\n    const timeTag = figma.createFrame();\n    timeTag.name = \"Time\";\n    timeTag.fills = [];\n    timeTag.layoutMode = \"HORIZONTAL\";\n    timeTag.itemSpacing = 8;\n    timeTag.counterAxisAlignItems = \"CENTER\";\n\n    const timerIcon = getInst(\"Icon_Timer\");\n    timerIcon.resize(18, 18);\n    timeTag.appendChild(timerIcon);\n\n    const timeTxt = figma.createText();\n    timeTxt.characters = timeText;\n    timeTxt.fontSize = 14;\n    timeTxt.fontName = { family: \"Inter\", style: \"Medium\" };\n    timeTxt.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0, a: 0.6 } }];\n    timeTag.appendChild(timeTxt);\n\n    tagsRow.appendChild(timeTag);\n\n    // Category tag\n    const catTag = figma.createFrame();\n    catTag.name = \"Category\";\n    catTag.fills = [];\n    catTag.layoutMode = \"HORIZONTAL\";\n    catTag.itemSpacing = 8;\n    catTag.counterAxisAlignItems = \"CENTER\";\n\n    const catIcon = getInst(\"Icon_Fork_Knife\");\n    catIcon.resize(18, 18);\n    catTag.appendChild(catIcon);\n\n    const catTxt = figma.createText();\n    catTxt.characters = categoryText;\n    catTxt.fontSize = 14;\n    catTxt.fontName = { family: \"Inter\", style: \"Medium\" };\n    catTxt.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0, a: 0.6 } }];\n    catTag.appendChild(catTxt);\n\n    tagsRow.appendChild(catTag);\n\n    card.appendChild(tagsRow);\n\n    return card;\n  }\n\n  // --- BUILD 01_HOME ---\n  const homeFrame = figma.createFrame();\n  homeFrame.name = \"01_Home\";\n  homeFrame.resize(1440, 5200);\n  homeFrame.x = 0;\n  homeFrame.y = 0;\n  homeFrame.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  workspace.appendChild(homeFrame);\n\n  let currentY = 0;\n\n  // Header\n  const header = createHeader(\"Home\");\n  header.x = 80;\n  header.y = 40;\n  homeFrame.appendChild(header);\n\n  currentY = 160;\n\n  // 1. Featured Recipe Banner\n  const heroBanner = figma.createFrame();\n  heroBanner.name = \"Featured Recipe Hero\";\n  heroBanner.resize(1280, 580);\n  heroBanner.x = 80;\n  heroBanner.y = currentY;\n  heroBanner.fills = [{ type: \"SOLID\", color: { r: 0.9058823529, g: 0.9764705882, b: 0.9921568627 } }];\n  heroBanner.cornerRadius = 40;\n  heroBanner.clipsContent = true;\n\n  // Left Content\n  const heroLeft = figma.createFrame();\n  heroLeft.name = \"Hero Left Content\";\n  heroLeft.resize(540, 460);\n  heroLeft.x = 60;\n  heroLeft.y = 60;\n  heroLeft.fills = [];\n  heroLeft.layoutMode = \"VERTICAL\";\n  heroLeft.itemSpacing = 24;\n\n  // Hot recipes tag\n  const hotTag = figma.createFrame();\n  hotTag.name = \"Hot Recipes Tag\";\n  hotTag.resize(160, 40);\n  hotTag.cornerRadius = 20;\n  hotTag.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  hotTag.layoutMode = \"HORIZONTAL\";\n  hotTag.itemSpacing = 8;\n  hotTag.paddingLeft = 16;\n  hotTag.paddingRight = 16;\n  hotTag.counterAxisAlignItems = \"CENTER\";\n\n  const hotIcon = getInst(\"Icon_Hot_Recipes\");\n  hotIcon.resize(20, 20);\n  hotTag.appendChild(hotIcon);\n\n  const hotTxt = figma.createText();\n  hotTxt.characters = \"Hot Recipes\";\n  hotTxt.fontSize = 14;\n  hotTxt.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n  hotTag.appendChild(hotTxt);\n\n  heroLeft.appendChild(hotTag);\n\n  // Title\n  const heroTitle = figma.createText();\n  heroTitle.characters = \"Spicy delicious chicken wings\";\n  heroTitle.fontSize = 54;\n  heroTitle.fontName = { family: \"Inter\", style: \"Bold\" };\n  heroTitle.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0 } }];\n  heroTitle.resize(540, 130);\n  heroLeft.appendChild(heroTitle);\n\n  // Desc\n  const heroDesc = figma.createText();\n  heroDesc.characters = \"Crispy outside, juicy inside and coated in a sticky, spicy glaze — these wings are ready in 30 minutes and disappear even faster.\";\n  heroDesc.fontSize = 16;\n  heroDesc.fontName = { family: \"Inter\", style: \"Regular\" };\n  heroDesc.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0, a: 0.6 } }];\n  heroDesc.resize(540, 50);\n  heroLeft.appendChild(heroDesc);\n\n  // Meta row (Time & Category tags)\n  const heroMetaRow = figma.createFrame();\n  heroMetaRow.name = \"Hero Meta Tags\";\n  heroMetaRow.resize(540, 40);\n  heroMetaRow.fills = [];\n  heroMetaRow.layoutMode = \"HORIZONTAL\";\n  heroMetaRow.itemSpacing = 16;\n  heroMetaRow.counterAxisAlignItems = \"CENTER\";\n\n  const timerTag = figma.createFrame();\n  timerTag.resize(130, 36);\n  timerTag.cornerRadius = 18;\n  timerTag.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0, a: 0.05 } }];\n  timerTag.layoutMode = \"HORIZONTAL\";\n  timerTag.itemSpacing = 8;\n  timerTag.paddingLeft = 14;\n  timerTag.paddingRight = 14;\n  timerTag.counterAxisAlignItems = \"CENTER\";\n  const tIcon = getInst(\"Icon_Timer\");\n  tIcon.resize(18, 18);\n  timerTag.appendChild(tIcon);\n  const tTxt = figma.createText();\n  tTxt.characters = \"30 Minutes\";\n  tTxt.fontSize = 14;\n  tTxt.fontName = { family: \"Inter\", style: \"Medium\" };\n  timerTag.appendChild(tTxt);\n\n  const catTag2 = figma.createFrame();\n  catTag2.resize(110, 36);\n  catTag2.cornerRadius = 18;\n  catTag2.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0, a: 0.05 } }];\n  catTag2.layoutMode = \"HORIZONTAL\";\n  catTag2.itemSpacing = 8;\n  catTag2.paddingLeft = 14;\n  catTag2.paddingRight = 14;\n  catTag2.counterAxisAlignItems = \"CENTER\";\n  const cIcon = getInst(\"Icon_Fork_Knife\");\n  cIcon.resize(18, 18);\n  catTag2.appendChild(cIcon);\n  const cTxt = figma.createText();\n  cTxt.characters = \"Chicken\";\n  cTxt.fontSize = 14;\n  cTxt.fontName = { family: \"Inter\", style: \"Medium\" };\n  catTag2.appendChild(cTxt);\n\n  heroMetaRow.appendChild(timerTag);\n  heroMetaRow.appendChild(catTag2);\n  heroLeft.appendChild(heroMetaRow);\n\n  // Author & View Recipes button row\n  const heroBottomRow = figma.createFrame();\n  heroBottomRow.name = \"Author & Button\";\n  heroBottomRow.resize(540, 60);\n  heroBottomRow.fills = [];\n  heroBottomRow.layoutMode = \"HORIZONTAL\";\n  heroBottomRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  heroBottomRow.counterAxisAlignItems = \"CENTER\";\n\n  const authorFrame = figma.createFrame();\n  authorFrame.name = \"Author\";\n  authorFrame.fills = [];\n  authorFrame.layoutMode = \"HORIZONTAL\";\n  authorFrame.itemSpacing = 16;\n  authorFrame.counterAxisAlignItems = \"CENTER\";\n\n  const avatar = getInst(\"Avatar_John_Smith\");\n  avatar.resize(50, 50);\n  authorFrame.appendChild(avatar);\n\n  const authorTextFrame = figma.createFrame();\n  authorTextFrame.fills = [];\n  authorTextFrame.layoutMode = \"VERTICAL\";\n  authorTextFrame.itemSpacing = 4;\n\n  const aName = figma.createText();\n  aName.characters = \"John Smith\";\n  aName.fontSize = 16;\n  aName.fontName = { family: \"Inter\", style: \"Bold\" };\n\n  const aDate = figma.createText();\n  aDate.characters = \"15 March 2022\";\n  aDate.fontSize = 14;\n  aDate.fontName = { family: \"Inter\", style: \"Medium\" };\n  aDate.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0, a: 0.6 } }];\n\n  authorTextFrame.appendChild(aName);\n  authorTextFrame.appendChild(aDate);\n  authorFrame.appendChild(authorTextFrame);\n\n  heroBottomRow.appendChild(authorFrame);\n\n  // View Recipes button\n  const viewBtn = figma.createFrame();\n  viewBtn.name = \"View Recipes Button\";\n  viewBtn.resize(180, 54);\n  viewBtn.cornerRadius = 16;\n  viewBtn.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0 } }];\n  viewBtn.layoutMode = \"HORIZONTAL\";\n  viewBtn.itemSpacing = 12;\n  viewBtn.primaryAxisAlignItems = \"CENTER\";\n  viewBtn.counterAxisAlignItems = \"CENTER\";\n\n  const btnText = figma.createText();\n  btnText.characters = \"View Recipes\";\n  btnText.fontSize = 14;\n  btnText.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n  btnText.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  viewBtn.appendChild(btnText);\n\n  const playIcon = getInst(\"Icon_Play\");\n  playIcon.resize(20, 20);\n  viewBtn.appendChild(playIcon);\n\n  heroBottomRow.appendChild(viewBtn);\n\n  heroLeft.appendChild(heroBottomRow);\n\n  heroBanner.appendChild(heroLeft);\n\n  // Hero Right Image & Badge\n  const heroRight = figma.createFrame();\n  heroRight.name = \"Hero Right Image Container\";\n  heroRight.resize(600, 580);\n  heroRight.x = 680;\n  heroRight.y = 0;\n  heroRight.fills = [];\n\n  const heroPhoto = getInst(\"Photo_Hero_Chicken_Wings\");\n  heroPhoto.resize(600, 580);\n  heroRight.appendChild(heroPhoto);\n\n  // Round badge \"Handpicked Recipes\"\n  const badge = figma.createFrame();\n  badge.name = \"Badge Handpicked Recipes\";\n  badge.resize(120, 120);\n  badge.cornerRadius = 60;\n  badge.x = -50;\n  badge.y = 40;\n  badge.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0 } }];\n  badge.layoutMode = \"VERTICAL\";\n  badge.primaryAxisAlignItems = \"CENTER\";\n  badge.counterAxisAlignItems = \"CENTER\";\n\n  const badgeTxt = figma.createText();\n  badgeTxt.characters = \"Handpicked\\nRecipes\";\n  badgeTxt.fontSize = 13;\n  badgeTxt.fontName = { family: \"Inter\", style: \"Bold\" };\n  badgeTxt.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  badgeTxt.textAlignHorizontal = \"CENTER\";\n  badge.appendChild(badgeTxt);\n\n  heroRight.appendChild(badge);\n\n  heroBanner.appendChild(heroRight);\n\n  currentY += 580 + 80;\n\n  // 2. Categories Section\n  const catSection = figma.createFrame();\n  catSection.name = \"Categories Section\";\n  catSection.resize(1280, 240);\n  catSection.x = 80;\n  catSection.y = currentY;\n  catSection.fills = [];\n\n  const catHeader = figma.createFrame();\n  catHeader.name = \"Header Row\";\n  catHeader.resize(1280, 40);\n  catHeader.fills = [];\n  catHeader.layoutMode = \"HORIZONTAL\";\n  catHeader.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  catHeader.counterAxisAlignItems = \"CENTER\";\n\n  const catTitle = figma.createText();\n  catTitle.characters = \"Categories\";\n  catTitle.fontSize = 36;\n  catTitle.fontName = { family: \"Inter\", style: \"Bold\" };\n  catHeader.appendChild(catTitle);\n\n  const viewAllBtn = figma.createFrame();\n  viewAllBtn.name = \"View All Categories\";\n  viewAllBtn.resize(200, 44);\n  viewAllBtn.cornerRadius = 16;\n  viewAllBtn.fills = [{ type: \"SOLID\", color: { r: 0.9058823529, g: 0.9764705882, b: 0.9921568627 } }];\n  viewAllBtn.layoutMode = \"HORIZONTAL\";\n  viewAllBtn.primaryAxisAlignItems = \"CENTER\";\n  viewAllBtn.counterAxisAlignItems = \"CENTER\";\n  const viewAllTxt = figma.createText();\n  viewAllTxt.characters = \"View All Categories\";\n  viewAllTxt.fontSize = 14;\n  viewAllTxt.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n  viewAllBtn.appendChild(viewAllTxt);\n  catHeader.appendChild(viewAllBtn);\n\n  catSection.appendChild(catHeader);\n\n  // Categories grid (6 tiles)\n  const catGrid = figma.createFrame();\n  catGrid.name = \"Categories Grid\";\n  catGrid.resize(1280, 170);\n  catGrid.y = 70;\n  catGrid.fills = [];\n  catGrid.layoutMode = \"HORIZONTAL\";\n  catGrid.itemSpacing = 24;\n\n  const categoriesData = [\n    { name: \"Breakfast\", img: \"Category_Breakfast\" },\n    { name: \"Vegan\", img: \"Category_Vegan\" },\n    { name: \"Meat\", img: \"Category_Meat\" },\n    { name: \"Dessert\", img: \"Category_Dessert\" },\n    { name: \"Lunch\", img: \"Category_Lunch\" },\n    { name: \"Chocolate\", img: \"Category_Chocolate\" }\n  ];\n\n  categoriesData.forEach(c => {\n    const tile = figma.createFrame();\n    tile.name = `Category - ${c.name}`;\n    tile.resize(193, 170);\n    tile.cornerRadius = 24;\n    tile.fills = [{ type: \"SOLID\", color: { r: 0.96, g: 0.97, b: 0.98 } }];\n    tile.layoutMode = \"VERTICAL\";\n    tile.primaryAxisAlignItems = \"CENTER\";\n    tile.counterAxisAlignItems = \"CENTER\";\n    tile.itemSpacing = 16;\n\n    const img = getInst(c.img);\n    img.resize(80, 80);\n    tile.appendChild(img);\n\n    const txt = figma.createText();\n    txt.characters = c.name;\n    txt.fontSize = 16;\n    txt.fontName = { family: \"Inter\", style: \"Bold\" };\n    tile.appendChild(txt);\n\n    catGrid.appendChild(tile);\n  });\n\n  catSection.appendChild(c