ing', 13, 'Bold', WHITE, {name:'Label'}); cyl.x=42; cyl.y=76; cy.appendChild(cyl);\n  const cyv = T('32 Min', 12, 'Regular', WHITE, {name:'Value'}); cyv.opacity=0.75; cyv.x=300; cyv.y=77; cy.appendChild(cyv);\n  // Sleep + Water\n  const sl = await inst(C.metric, f, 20, 606, 'Tile - Sleep');\n  sl.findOne(n=>n.name==='Value').characters='7.5';\n  sl.findOne(n=>n.name==='Unit').characters='hrs';\n  sl.findOne(n=>n.name==='Label').characters='Sleep';\n  sl.findOne(n=>n.name==='Chip').fills=[S('#ECE7FC')];\n  const sli = sl.findOne(n=>n.name==='Icon'); const slm = await node(I.Icon_Sleep); await sli.swapComponent(slm); recolorAll(sli, '#7C5CE0');\n  const heights=[10,16,22,13]; let bx=32;\n  for (const h of heights) { const b = figma.createRectangle(); b.resize(6,h); b.x=bx; b.y=470-h; b.cornerRadius=2; b.fills=[S('#7C5CE0')]; b.name='Sleep Bar'; f.appendChild(b); bx+=10; }\n  const wa = await inst(C.metric, f, 200, 606, 'Tile - Water');\n  wa.findOne(n=>n.name==='Value').characters='6';\n  wa.findOne(n=>n.name==='Unit').characters='/8 Cups';\n  wa.findOne(n=>n.name==='Label').characters='Water';\n  wa.findOne(n=>n.name==='Chip').fills=[S('#E0F1FA')];\n  const wai = wa.findOne(n=>n.name==='Icon'); const wam = await node(I.Icon_Water); await wai.swapComponent(wam); recolorAll(wai, '#2E9BD6');\n  for (let i=0;i<8;i++) { const d = figma.createEllipse(); d.resize(8,8); d.x=212+i*13; d.y=462; d.fills=[S(i<6 ? '#2E9BD6' : '#E0F1FA')]; d.name='Water Dot'; f.appendChild(d); }\n  const ku = T('Keep it Up! 💪', 15, 'Bold', DARK, {name:'Keep It Up', align:'CENTER'}); ku.textAutoResize='HEIGHT'; ku.resize(390,ku.height); ku.x=0; ku.y=728; f.appendChild(ku);\n  const tb = await inst(C.tabBar, f, 0, 756, 'Tab Bar');\n  const anItem = tb.findOne(n=>n.name==='Analytics'); const onC = await node(C.tabOn_Analytics); await anItem.swapComponent(onC);\n  await inst(DEF.homeInd, f, 0, 810, 'Home Indicator');\n}\nreturn JSON.stringify(out);","description":"Build frames 04_Workout and 05_Analy