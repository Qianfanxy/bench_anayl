 sb1 = statusBar.createInstance();\nsb1.x = 0; sb1.y = 0;\nwelcome.appendChild(sb1);\nconst hi1 = homeInd.createInstance();\nhi1.x = 0; hi1.y = 932 - 34;\nwelcome.appendChild(hi1);\n\nconst illust = imageRect(IMG.welcomeIllust, 300, 274, \"FIT\");\nillust.x = (414 - 300) / 2;\nillust.y = 100;\nwelcome.appendChild(illust);\n\nconst title = txt(\"Stay on top of your finance with us.\", \"DM Sans\", \"Bold\", 28, C.textPrimary);\ntitle.x = 30; title.y = 420;\ntitle.textAutoResize = \"HEIGHT\";\ntitle.resize(354, title.height);\nwelcome.appendChild(title);\n\nconst subtitle = txt(\"We are your new financial advisors to recommend the best investments for you.\", \"Inter\", \"Regular\", 15, C.textSecondary);\nsubtitle.x = 30; subtitle.y = 500;\nsubtitle.textAutoResize = \"HEIGHT\";\nsubtitle.resize(354, subtitle.height);\nsubtitle.lineHeight = { value: 24, unit: \"PIXELS\" };\nwelcome.appendChild(subtitle);\n\nconst btnCreate = btnComp.createInstance();\nbtnCreate.x = 30; btnCreate.y = 600;\nconst lbl1 = btnCreate.findOne(n => n.name === \"Label\");\nif (lbl1) lbl1.characters = \"Create account\";\nwelcome.appendChild(btnCreate);\n\n// Login button (secondary)\nconst btnLogin = figma.createFrame();\nbtnLogin.name = \"Button/Secondary\";\nbtnLogin.resize(354, 60);\nbtnLogin.cornerRadius = 20;\nbtnLogin.fills = [{ type: \"SOLID\", color: C.white }];\nbtnLogin.strokes = [{ type: \"SOLID\", color: C.primary }];\nbtnLogin.strokeWeight = 1.5;\nbtnLogin.x = 30; btnLogin.y = 676;\nwelcome.appendChild(btnLogin);\n\nconst loginLbl = txt(\"Login\", \"Inter\", \"Semi Bold\", 17, C.primary);\nloginLbl.x = (354 - loginLbl.width) / 2;\nloginLbl.y = (60 - loginLbl.height) / 2;\nbtnLogin.appendChild(loginLbl);\n\npage.appendChild(welcome);\nreturn \"02_Welcome created: \" + welcome.id;\n","description":"Create 02_Welcome screen","fileKey":"BxIMHhCjiRBVph4Aa3oNRO"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"3394a1fc-48e8-404f-9f28-7846423ba2bb","uuid":"0f5756b3-eb