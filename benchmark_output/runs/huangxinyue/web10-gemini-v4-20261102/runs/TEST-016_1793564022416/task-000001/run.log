ow bottom: time, link, comments, progress bar & percentage\n    const rowBot = figma.createFrame();\n    rowBot.name = \"RowBottom\";\n    rowBot.resize(792, 24);\n    rowBot.layoutMode = \"HORIZONTAL\";\n    rowBot.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    rowBot.counterAxisAlignItems = \"CENTER\";\n    rowBot.fills = [];\n\n    const metaLeft = figma.createFrame();\n    metaLeft.layoutMode = \"HORIZONTAL\";\n    metaLeft.counterAxisAlignItems = \"CENTER\";\n    metaLeft.itemSpacing = 16;\n    metaLeft.fills = [];\n\n    // Time\n    const timeFrame = figma.createFrame();\n    timeFrame.layoutMode = \"HORIZONTAL\";\n    timeFrame.counterAxisAlignItems = \"CENTER\";\n    timeFrame.itemSpacing = 6;\n    timeFrame.fills = [];\n    timeFrame.appendChild(getAsset(\"Icon_Clock\", 14));\n    const timeTxt = figma.createText();\n    timeTxt.characters = t.time;\n    timeTxt.fontName = { family: \"DM Sans\", style: \"Regular\" };\n    timeTxt.fontSize = 12;\n    timeTxt.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.55 } }];\n    timeFrame.appendChild(timeTxt);\n    metaLeft.appendChild(timeFrame);\n\n    // Link\n    const linkFrame = figma.createFrame();\n    linkFrame.layoutMode = \"HORIZONTAL\";\n    linkFrame.counterAxisAlignItems = \"CENTER\";\n    linkFrame.itemSpacing = 6;\n    linkFrame.fills = [];\n    linkFrame.appendChild(getAsset(\"Icon_Link\", 14));\n    const linkTxt = figma.createText();\n    linkTxt.characters = t.link;\n    linkTxt.fontName = { family: \"DM Sans\", style: \"Regular\" };\n    linkTxt.fontSize = 12;\n    linkTxt.fills = [{ type: 'SOLID', color: { r: 0.314, g: 0.318, b: 0.976 } }];\n    linkFrame.appendChild(linkTxt);\n    metaLeft.appendChild(linkFrame);\n\n    // Comments\n    const commFrame = figma.createFrame();\n    commFrame.layoutMode = \"HORIZONTAL\";\n    commFrame.counterAxisAlignItems = \"CENTER\";\n    commFrame.itemSpacing = 6;\n    commFrame.fills = [];\n    commFrame.appendChild(getAsset(\"Icon_Comment\", 14));\