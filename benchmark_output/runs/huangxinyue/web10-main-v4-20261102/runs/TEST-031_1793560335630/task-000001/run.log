{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_933dbc89c517407d95330d11","name":"mcp__figma__use_figma","input":{"code":"for (const s of [\"Regular\",\"Medium\",\"SemiBold\",\"Bold\"]) await figma.loadFontAsync({family:\"Poppins\",style:s});\nconst out = {};\nfunction hex(h,o){const n=parseInt(h,16);return {type:\"SOLID\",color:{r:((n>>16)&255)/255,g:((n>>8)&255)/255,b:(n&255)/255},opacity:o===undefined?1:o};}\nfunction txt(chars,style,size,colorHex,opts={}){const t=figma.createText();t.fontName={family:\"Poppins\",style};t.characters=chars;t.fontSize=size;t.fills=[hex(colorHex)];if(opts.ls!==undefined)t.letterSpacing={unit:\"PIXELS\",value:opts.ls};if(opts.lh)t.lineHeight={unit:\"PIXELS\",value:opts.lh};if(opts.deco)t.textDecoration=opts.deco;if(opts.w){t.textAutoResize=\"HEIGHT\";t.resize(opts.w,t.height);}if(opts.align)t.textAlignHorizontal=opts.align;return t;}\nfunction autolayout(name,dir,gap,pT,pR,pB,pL,parent){const f=figma.createFrame();f.name=name;f.layoutMode=dir;f.itemSpacing=gap;f.paddingTop=pT;f.paddingRight=pR;f.paddingBottom=pB;f.paddingLeft=pL;f.primaryAxisSizingMode=\"AUTO\";f.counterAxisSizingMode=\"AUTO\";f.fills=[];if(parent)parent.appendChild(f);return f;}\nfunction frame(name,w,h,parent,x,y){const f=figma.createFrame();f.name=name;if(w)f.resize(w,h);if(parent)parent.appendChild(f);if(x!==undefined)f.x=x;if(y!==undefined)f.y=y;return f;}\nasync function comp(id){return (await figma.getNodeByIdAsync(id)).createInstance();}\nasync function icon(id,size,colorHex,parent,name){const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();i.resize(size,size*(c.height/c.width));i.name=name;if(colorHex){for(const d of i.findAll(n=>[\"VECTOR\",\"BOOLEAN_OPERATION\",\"TEXT\",\"RECTANGLE\"].includes(n.type))){if(\"fills\" in d){try{d.fills=[hex(colorHex)];}catch(e){}}}}if(parent)parent.appendChild(i);return i;}\n\n// test corrected reactions shape\nconst tmp = figma.createFrame(); tmp.resize(10,10);\ntry { tmp.reactions = [{trigger:{type:\"ON_CLICK\"}, action:{type:\"NODE\", destinationId:\"19:4\", transition:{type:\"INSTANT\"}}}]; out.reactionsInstant = \"OK\"; } catch(e){ out.reactionsInstant = \"FAIL: \"+e.message.slice(0,200); }\ntmp.remove();\nconst tmp2 = figma.createFrame(); tmp2.resize(10,10);\ntry { tmp2.reactions = [{trigger:{type:\"ON_CLICK\"}, action:{type:\"NODE\", destinationId:\"19:4\", transition:{type:\"DISSOLVE\", duration:0.3}}}]; out.reactionsDissolve = \"OK\"; } catch(e){ out.reactionsDissolve = \"FAIL: \"+e.message.slice(0,200); }\ntmp2.remove();\n\nconst ws = await figma.getNodeByIdAsync(\"15:2\");\n\n// ============ FEATURE STRIP ============\nconst FS = figma.createComponent(); FS.name=\"FeatureStrip\"; ws.appendChild(FS); FS.x=3300; FS.y=760;\nFS.layoutMode=\"HORIZONTAL\"; FS.primaryAxisSizingMode=\"FIXED\"; FS.counterAxisSizingMode=\"FIXED\"; FS.resize(1440,280);\nFS.primaryAxisAlignItems=\"SPACE_BETWEEN\"; FS.counterAxisAlignItems=\"CENTER\"; FS.paddingLeft=110; FS.paddingRight=110;\nFS.fills=[hex(\"FBF1E7\")]; FS.description=\"Feature strip: High Quality / Warranty Protection / Free Shipping / 24 / 7 Support.\";\nconst feats = [[\"13:38\",\"High Quality\",\"crafted from top materials\"],[\"13:42\",\"Warranty Protection\",\"Over 2 years\"],[\"13:25\",\"Free Shipping\",\"Order over Rs. 150,000\"],[\"13:41\",\"24 / 7 Support\",\"Dedicated support\"]];\nfor (const [icd,tt,ss] of feats){\n  const row = autolayout(\"Feat\",\"HORIZONTAL\",16,0,0,0,0,FS); row.counterAxisAlignItems=\"CENTER\";\n  await icon(icd,52,\"24252B\",row,\"Icon\");\n  const col = autolayout(\"FeatText\",\"VERTICAL\",4,0,0,0,0,row);\n  col.appendChild(txt(tt,\"SemiBold\",18,\"24252B\"));\n  col.appendChild(txt(ss,\"Regular\",13,\"898989\"));\n}\n\n// ============ PAGE BANNER ============\nconst PB = figma.createComponent(); PB.name=\"PageBanner\"; ws.appendChild(PB); PB.x=3300; PB.y=1120;\nPB.resize(1440,316); PB.clipsContent=true; PB.fills=[hex(\"FBF1E7\")];\nPB.description=\"Page title banner. Override Title and CrumbPage text per page.\";\nconst bph = await comp(\"13:16\"); bph.resize(1440,316); bph.name=\"BannerPhoto\"; PB.appendChild(bph); bph.x=0; bph.y=0;\nconst bov = figma.createRectangle(); bov.resize(1440,316); bov.fills=[hex(\"FFFFFF\",0.35)]; bov.name=\"Overlay\"; PB.appendChild(bov); bov.x=0; bov.y=0;\nconst bcol = autolayout(\"Content\",\"VERTICAL\",14,0,0,0,0,PB); bcol.counterAxisAlignItems=\"CENTER\";\nbcol.resize(1440,bcol.height); bcol.counterAxisSizingMode=\"FIXED\";\nconst btitle = txt(\"Shop\",\"SemiBold\",48,\"24252B\"); btitle.name=\"Title\"; bcol.appendChild(btitle);\nconst bc = autolayout(\"Breadcrumb\",\"HORIZONTAL\",10,0,0,0,0,bcol); bc.counterAxisAlignItems=\"CENTER\";\nconst bh = txt(\"Home\",\"Medium\",16,\"24252B\"); bh.name=\"CrumbHome\"; bc.appendChild(bh);\nawait icon(\"13:46\",18,\"24252B\",bc,\"CrumbIcon\");\nconst bp = txt(\"Shop\",\"Regular\",16,\"24252B\"); bp.name=\"CrumbPage\"; bc.appendChild(bp);\nbcol.y = Math.round((316-bcol.height)/2);\n\n// ============ PRODUCT CARD ============\nconst PC = figma.createComponent(); PC.name=\"Product Card\"; ws.appendChild(PC); PC.x=3300; PC.y=1520;\nPC.layoutMode=\"VERTICAL\"; PC.resize(300,100); PC.primaryAxisSizingMode=\"AUTO\"; PC.counterAxisSizingMode=\"FIXED\";\nPC.fills=[hex(\"FFFFFF\")]; PC.description=\"Default product card. Override Photo (swapComponent), Name, Description, Price, OldPrice, Badge.\";\nconst pw = frame(\"PhotoWrap\",300,280,PC); pw.fills=[hex(\"F4F3EF\")]; pw.clipsContent=true;\nconst ph = await comp(\"13:21\"); ph.resize(300,280); ph.name=\"Photo\"; pw.appendChild(ph); ph.x=0; ph.y=0;\nconst badge = frame(\"Badge\",48,48,pw); badge.x=236; badge.y=16; badge.cornerRadius=8; badge.fills=[hex(\"E97132\")]; badge.visible=false;\nconst bt = txt(\"-30%\",\"SemiBold\",14,\"FFFFFF\"); bt.name=\"BadgeLabel\"; badge.appendChild(bt); bt.x=(48-bt.width)/2; bt.y=(48-bt.height)/2;\nconst ta = autolayout(\"Info\",\"VERTICAL\",6,22,24,26,24,PC);\nconst nm = txt(\"Syltherine\",\"SemiBold\",22,\"24252B\"); nm.name=\"Name\"; ta.appendChild(nm);\nconst ds = txt(\"Stylish cafe chair\",\"Medium\",15,\"898989\"); ds.name=\"Description\"; ta.appendChild(ds);\nconst pr = autolayout(\"PriceRow\",\"HORIZONTAL\",14,8,0,0,0,ta); pr.counterAxisAlignItems=\"CENTER\";\nconst p1 = txt(\"Rs. 2,500,000.00\",\"SemiBold\",20,\"24252B\"); p1.name=\"Price\"; pr.appendChild(p1);\nconst p2 = txt(\"Rs. 3,500,000.00\",\"Regular\",16,\"B0B0B0\"); p2.name=\"OldPrice\"; p2.textDecoration=\"STRIKETHROUGH\"; pr.appendChild(p2);\n\n// ============ PRODUCT CARD HOVER ============\nconst PH = figma.createComponent(); PH.name=\"Product Card Hover\"; ws.appendChild(PH); PH.x=3300; PH.y=2100;\nPH.layoutMode=\"VERTICAL\"; PH.resize(300,100); PH.primaryAxisSizingMode=\"AUTO\"; PH.counterAxisSizingMode=\"FIXED\";\nPH.fills=[hex(\"FFFFFF\")]; PH.description=\"Hover product card (Leviosa): overlay with Add to cart + Share/Compare/Like. Compare is prototype link to 05_Comparison.\";\nconst phw = frame(\"PhotoWrap\",300,280,PH); phw.fills=[hex(\"F4F3EF\")]; phw.clipsContent=true;\nconst hph = await comp(\"13:17\"); hph.resize(300,280); hph.name=\"Photo\"; phw.appendChild(hph); hph.x=0; hph.y=0;\nconst hov = frame(\"Overlay\",300,280,phw); hov.fills=[hex(\"24252B\",0.66)]; hov.x=0; hov.y=0;\nconst oc = autolayout(\"OverlayContent\",\"VERTICAL\",16,0,0,0,0,hov); oc.counterAxisAlignItems=\"CENTER\";\nconst add = frame(\"AddToCartBtn\",268,48,oc); add.fills=[hex(\"FFFFFF\")]; add.cornerRadius=2;\nconst at = txt(\"Add to cart\",\"SemiBold\",16,\"B88E2F\"); add.appendChild(at); at.x=(268-at.width)/2; at.y=(48-at.height)/2;\nconst acts = autolayout(\"Actions\",\"HORIZONTAL\",22,0,0,0,0,oc);\nfor (const [icd,lb] of [[\"13:51\",\"Share\"],[\"13:47\",\"Compare\"],[\"13:53\",\"Like\"]]){\n  const a = autolayout(\"Act_\"+lb,\"HORIZONTAL\",8,0,0,0,0,acts); a.counterAxisAlignItems=\"CENTER\";\n  await icon(icd,16,\"FFFFFF\",a,\"Icon_\"+lb);\n  a.appendChild(txt(lb,\"Medium\",14,\"FFFFFF\"));\n}\noc.x = Math.round((300-oc.width)/2); oc.y = Math.round((280-oc.height)/2);\nconst hta = autolayout(\"Info\",\"VERTICAL\",6,22,24,26,24,PH);\nconst hnm = txt(\"Leviosa\",\"SemiBold\",22,\"24252B\"); hnm.name=\"Name\"; hta.appendChild(hnm);\nconst hds = txt(\"Stylish cafe chair\",\"Medium\",15,\"898989\"); hds.name=\"Description\"; hta.appendChild(hds);\nconst hpr = autolayout(\"PriceRow\",\"HORIZONTAL\",14,8,0,0,0,hta); hpr.counterAxisAlignItems=\"CENTER\";\nconst hp1 = txt(\"Rs. 2,500,000.00\",\"SemiBold\",20,\"24252B\"); hp1.name=\"Price\"; hpr.appendChild(hp1);\n\n// ============ PAGINATION ============\nconst PG = figma.createComponent(); PG.name=\"Pagination\"; ws.appendChild(PG); PG.x=3300; PG.y=2700;\nPG.layoutMode=\"HORIZONTAL\"; PG.primaryAxisSizingMode=\"AUTO\"; PG.counterAxisSizingMode=\"AUTO\"; PG.itemSpacing=12;\nPG.fills=[]; PG.description=\"Pagination, current page 1. Circles 44px.\";\nasync function pgCircle(parent,label,active){const c=frame(\"Pg_\"+label,44,44,parent);c.cornerRadius=22;c.fills=[hex(active?\"B88E2F\":\"FBF1E7\")];const t=txt(label,\"Medium\",16,active?\"FFFFFF\":\"3A3A3A\");c.appendChild(t);t.x=(44-t.width)/2;t.y=(44-t.height)/2;return c;}\nawait pgCircle(PG,\"1\",true); await pgCircle(PG,\"2\",false); await pgCircle(PG,\"3\",false);\nconst nx = frame(\"Pg_Next\",null,null,PG); nx.resize(52,44); nx.fills=[];\nconst nxt = txt(\"Next\",\"Medium\",14,\"3A3A3A\"); nx.appendChild(nxt); nxt.x=(52-nxt.width)/2; nxt.y=(44-nxt.height)/2;\n\n// ============ BLOG POST CARD ============\nconst BP = figma.createComponent(); BP.name=\"Blog Post Card\"; ws.appendChild(BP); BP.x=3300; BP.y=2800;\nBP.layoutMode=\"HORIZONTAL\"; BP.primaryAxisSizingMode=\"AUTO\"; BP.counterAxisSizingMode=\"AUTO\"; BP.itemSpacing=32;\nBP.fills=[]; BP.description=\"Blog post card. Override Photo (swapComponent), Category, Title, Excerpt.\";\nconst bpw = frame(\"PhotoWrap\",250,250,BP); bpw.cornerRadius=12; bpw.clipsContent=true; bpw.fills=[hex(\"F4F3EF\")];\nconst bpi = await comp(\"13:5\"); bpi.resize(250,250); bpi.name=\"Photo\"; bpw.appendChild(bpi); bpi.x=0; bpi.y=0;\nconst bcc = autolayout(\"Content\",\"VERTICAL\",10,0,0,0,0,BP);\nconst meta = autolayout(\"Meta\",\"HORIZONTAL\",24,0,0,0,0,bcc); meta.counterAxisAlignItems=\"CENTER\";\nconst m1 = autolayout(\"M_Author\",\"HORIZONTAL\",8,0,0,0,0,meta); m1.counterAxisAlignItems=\"CENTER\";\nawait icon(\"13:45\",18,\"898989\",m1,\"Icon_User\"); m1.appendChild(txt(\"Admin\",\"Regular\",14,\"3A3A3A\"));\nconst m2 = autolayout(\"M_Date\",\"HORIZONTAL\",8,0,0,0,0,meta); m2.counterAxisAlignItems=\"CENTER\";\nawait icon(\"13:37\",18,\"898989\",m2,\"Icon_Calendar\"); m2.appendChild(txt(\"14 Oct 2022\",\"Regular\",14,\"3A3A3A\"));\nconst m3 = autolayout(\"M_Cat\",\"HORIZONTAL\",8,0,0,0,0,meta); m3.counterAxisAlignItems=\"CENTER\";\nawait icon(\"13:27\",18,\"898989\",m3,\"Icon_Tag\"); const mcat = txt(\"Wood\",\"Regular\",14,\"3A3A3A\"); mcat.name=\"Category\"; m3.appendChild(mcat);\nconst bti = txt(\"Going all-in with millennial design\",\"SemiBold\",22,\"24252B\",{w:520,lh:32}); bti.name=\"Title\"; bcc.appendChild(bti);\nconst bex = txt(\"Soft pastels, rounded silhouettes and natural wood: how millennial design took over the living room, and how to make it feel personal rather than borrowed from a feed.\",\"Regular\",14,\"898989\",{w:520,lh:22}); bex.name=\"Excerpt\"; bcc.appendChild(bex);\nconst brm = txt(\"Read more\",\"Medium\",14,\"24252B\"); brm.name=\"ReadMore\"; brm.textDecoration=\"UNDERLINE\"; bcc.appendChild(brm);\n\nout.FS=FS.id; out.PB=PB.id; out.PC=PC.id; out.PC_h=PC.height; out.PH=PH.id; out.PG=PG.id; out.BP=BP.id; out.BP_h=BP.height;\nreturn JSON.stringify(out);","description":"Test corrected reactions shape; build FeatureStrip, PageBanner, ProductCard, Hover card, Pagination, BlogPostCard masters","fileKey":"iREO0ZncSJq5Rg5HF95nYG"}}],"id":"65233e92-ef52-4ca4-b5a6-6c451070d699","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"