   const c = src.findOne(n=>n.name===nm).clone(); bg.appendChild(c); c.x=0; c.y=y;\n  }\n  const dim = rect('Dim', 375, 812, 'Dim/Overlay', 0); bg.appendChild(dim); dim.opacity = opacity;\n  return bg;\n}\n\nconst prev = page.findOne(n=>n.name==='04_Invest_Amount'); if(prev) prev.remove();\nconst root = frame('04_Invest_Amount', 375, 812, 'Surface/Canvas');\nput(page, root, 1320, 0); root.clipsContent = true;\nbackdrop(root, 0.45);\n\nconst sheet = frame('Sheet', 375, 700, 'Surface/White', 28);\nput(root, sheet, 0, 112);\nsheet.effects = es['Elevation/Sheet']; sheet.clipsContent = true;\nput(sheet, rect('Grabber', 36, 5, 'Border/Medium', 3), 169, 10);\n\n// header\nconst back = frame('Back', 32, 32, 'Surface/Subtle', 16); put(sheet, back, 20, 24);\nconst bi = await inst('6:88','Back Icon'); bi.rescale(0.66); put(back, bi, 9, 9);\nput(sheet, txt('Invest to Strategy', 17, 'B', 'Ink/900', 240, {lh:22, align:'CENTER'}), 68, 29).name='Title';\nconst swapBtn = frame('Swap', 32, 32, 'Surface/Subtle', 16); put(sheet, swapBtn, 323, 24);\nconst sw = await inst('6:76','Swap Icon'); sw.rescale(0.66); put(swapBtn, sw, 8, 8);\n\n// amount\nconst amountRow = frame('Amount', 375, 96, 'Surface/White');\nput(sheet, amountRow, 0, 76);\nconst daiLogo = await inst('6:24','DAI Logo'); daiLogo.rescale(40/40); put(amountRow, daiLogo, 24, 24);\nput(amountRow, txt('DAI', 12, 'B', 'Ink/400', 60, {lh:15}), 72, 16).name='Currency';\nconst amt = txt('3,021', 46, 'XB', 'Ink/900', 260, {lh:54, ls:-1.4});\nput(amountRow, amt, 70, 32);\nconst caret = rect('Caret', 2.5, 40, 'Chart/B', 1); put(amountRow, caret, 72 + amt.width + 4, 40);\n\n// balance + max\nconst balRow = frame('Balance Row', 375, 34, 'Surface/White');\nput(sheet, balRow, 0, 176);\nput(balRow, txt('Balance 3,045.86 DAI', 12, 'M', 'Ink/400', 200, {lh:16}), 24, 8).name='Balance';\nconst maxChip = frame('Max', 56, 26, 'Surface/Subtle', 13); put(balRow, maxChip, 295, 3);\nput(maxChip, txt('Max', 11, 'B', 'Ink/900', 40, {lh:14, align:'CENTER'}), 8, 6).name='Label';\n\n// gas note\nconst gas = frame('Gas Note', 200, 22, 'Gain/BG', 11); put(sheet, gas, 87, 216);\nput(gas, txt('⛽️ No gas, free investments', 10, 'B', 'Gain', 190, {lh:13, align:'CENTER'}), 5, 4).name='Label';\n\n// keypad\nconst pad = frame('Keypad', 339, 268, 'Surface/White');\nput(sheet, pad, 18, 254);\nconst keyComp = await figma.getNodeByIdAsync('7:83');\nconst keys = [['1',''],['2','ABC'],['3','DEF'],['4','GHI'],['5','JKL'],['6','MNO'],['7','PQRS'],['8','TUV'],['9','WXYZ'],[',',''],['0',''],['⌫','']];\nkeys.forEach(([main,sub],i)=>{\n  const col = i % 3, rowi = Math.floor(i/3);\n  const x = col * 113.5, y = rowi * 64;\n  if (main === '⌫') {\n    const kb = frame('Backspace Key', 104, 56, 'Surface/Subtle', 16); put(pad, kb, x, y);\n    const ic = await inst('6:82','Backspace Icon'); put(kb, ic, 40, 19);\n  } else {\n    const c = keyComp.createInstance(); c.name = 'Key ' + main; put(pad, c, x, y);\n    c.findOne(n=>n.name==='Main').characters = main;\n    c.findOne(n=>n.name==='Sub').characters = sub;\n  }\n});\n\n// footer CTA\nconst footer = frame('Sheet Footer', 375, 98, 'Surface/White');\nput(sheet, footer, 0, 602);\nfooter.strokes = paint('Border/Subtle'); footer.strokeWeight=1; footer.strokeAlign='INSIDE';\nfooter.effects = es['Elevation/Sheet'];\nconst btnSrc = await figma.getNodeByIdAsync('7:45');\nconst hold = btnSrc.createInstance(); hold.name='Hold to Invest';\ntry { hold.resize(327, 52); } catch(e) {}\nput(footer, hold, 24, 22);\nconst htxt = hold.findOne(n=>n.type==='TEXT');\nif (htxt) {\n  htxt.characters = 'Hold to Invest';\n  htxt.textAlignHorizontal = 'CENTER';\n  try { htxt.x = 100; } catch(e) {}\n}\n// face id icon drawn over the button label area as a sibling of the footer\nconst fid = await inst('6:70','Face ID'); fid.rescale(0.84); put(footer, fid, 90, 36);\n\nreturn JSON.stringify({ id: root.id, amountW: Math.round(amt.width) });","description":"Build 04_Invest_Amount: back and swap header, DAI amount 3,021 being entered with caret, balance and Max, gas note, 12-key keypad and Hold to Invest footer","fileKey":"DahEt2glvB09pBFT66GiDO"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":9107,"input_tokens":55,"cache_read_input_tokens":116533,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":9107}},"context_management":null},"parent_tool_use_id":null,"session_id":"7fa41065-9ea8-4467-818a-aa7f032bdf86","uuid":"7788b3c8-0498-4299-ac6d-26e7c54baf79","timestamp":"2026-10-31T19:49:34.280Z","tool_use_meta":[{"id":"toolu_01wZ2w7M3A8qxPcJTRdHzZSC","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
