&& p.fills.length) p.fills = [S(color)];\n    if (p.strokes && p.strokes.length) p.strokes = [S(color)];\n  }\n}\n\nconst iconSrc = {\n  \"Icon/Activity\":\"3:16\",\"Icon/Back\":\"3:17\",\"Icon/Clock\":\"3:18\",\"Icon/Cycling\":\"3:19\",\n  \"Icon/Heart\":\"3:20\",\"Icon/Home\":\"3:21\",\"Icon/Menu\":\"3:22\",\"Icon/More\":\"3:23\",\"Icon/Play\":\"3:24\",\n  \"Icon/PlaySmall\":\"3:25\",\"Icon/Profile\":\"3:26\",\"Icon/Running\":\"3:27\",\"Icon/Search\":\"3:28\",\n  \"Icon/Settings\":\"3:29\",\"Icon/Swimming\":\"3:30\"\n};\nconst comps = {};\nlet CY = 0;\nfor (const name of Object.keys(iconSrc)) {\n  const src = await figma.getNodeByIdAsync(iconSrc[name]);\n  const copy = src.clone();\n  PAGE.appendChild(copy);\n  copy.x = -700; copy.y = CY;\n  comps[name] = copy;\n  CY += Math.max(48, copy.height + 8);\n}\nrecolor(comps[\"Icon/Activity\"], GRAY);\nrecolor(comps[\"Icon/Back\"], INK);\nrecolor(comps[\"Icon/Clock\"], BRAND);\nrecolor(comps[\"Icon/Cycling\"], VIOLET);\nrecolor(comps[\"Icon/Heart\"], RED);\nrecolor(comps[\"Icon/Home\"], BRAND);\nrecolor(comps[\"Icon/Menu\"], INK);\nrecolor(comps[\"Icon/More\"], INK);\nrecolor(comps[\"Icon/Play\"], WHITE);\nrecolor(comps[\"Icon/PlaySmall\"], WHITE);\nrecolor(comps[\"Icon/Profile\"], GRAY);\nrecolor(comps[\"Icon/Running\"], ORANGE);\nrecolor(comps[\"Icon/Search\"], MUTED);\nrecolor(comps[\"Icon/Settings\"], GRAY);\nrecolor(comps[\"Icon/Swimming\"], BLUE);\n\nfunction iconInst(name, w){\n  const inst = comps[name].createInstance();\n  const sw = inst.width, sh = inst.height;\n  inst.resize(w, sh * (w/sw));\n  return inst;\n}\n\nconst tabDefs = [\n  [\"Home\",\"Icon/Home\"],[\"Activity\",\"Icon/Activity\"],[\"Profile\",\"Icon/Profile\"],[\"Settings\",\"Icon/Settings\"]\n];\nconst tabBar = frame(null, \"TabBar\", 414, 96);\ntabBar.fills = [S(WHITE)];\ntabBar.effects = [{type:\"DROP_SHADOW\", color:{r:0.098,g:0.11,b:0.137,a:0.08}, offset:{x:0,y:-4}, radius:24, spread:0, visible:true, blendMode:\"NORMAL\"}];\ntabBar.layoutMode = \"HORIZONTAL\";\ntabBar.primaryAxisSizingMode = \"FIXED\";\ntabBar.counterAxisSizingMode = \"FIXED\";\ntabBar.paddingTop = 12; tabBar.paddingBottom = 34;\ntabBar.itemSpacing = 0;\nfor (const pair of tabDefs) {\n  const label = pair[0], icon = pair[1];\n  const it = frame(tabBar, \"Tab/\" + label, 103.5, 50);\n  it.layoutMode = \"VERTICAL\";\n  it.counterAxisAlignItems = \"CENTER\";\n  it.primaryAxisAlignItems = \"CENTER\";\n  it.itemSpacing = 4;\n  const ic = iconInst(icon, 22);\n  it.appendChild(ic);\n  const lt = await text(label, \"Medium\", 11, GRAY, {parent:it});\n  it.counterAxisSizingMode = \"FIXED\"; it.primaryAxisSizingMode = \"FIXED\";\n  it.resize(103.5, 50);\n}\nconst tabBarComp = figma.createComponentFromNode(tabBar);\ntabBarComp.name = \"TabBar\";\ntabBarComp.x = -1600; tabBarComp.y = 0;\n\nreturn JSON.stringify({tabBar: tabBarComp.id, icons: Object.fromEntries(Object.entries(comps).map(e => [e[0], e[1].id]))});","description":"Create icon component copies and TabBar component on workspace page"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"3dd82475-447e-4a4a-b1d4-9abeb6ff2aa0","uuid":"0083b66e-5cea-4a02-8d5e-a57026e4c241","timestamp":"2026-11-01T14:29:20.891Z","tool_use_meta":[{"id":"mcp__figma__use_figma_18_0e3b9f72","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
