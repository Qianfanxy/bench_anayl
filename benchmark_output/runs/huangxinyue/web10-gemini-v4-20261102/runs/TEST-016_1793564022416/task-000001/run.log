Child(getAsset(\"Icon_Chevron_Down\", 16));\n  rightGroup.appendChild(userMenu);\n  topbar.appendChild(rightGroup);\n  frame.appendChild(topbar);\n\n  // 3. Main Content (x: 104, y: 92, w: 1312, h: 908)\n  const content = figma.createFrame();\n  content.name = \"Content\";\n  content.resize(1312, 908);\n  content.x = 104; content.y = 92;\n  content.fills = [];\n  content.layoutMode = \"VERTICAL\";\n  content.itemSpacing = 20;\n\n  // Header row: \"🔥 Task\" · team avatars with +6 · add (Icon_Plus)\n  const header = figma.createFrame();\n  header.name = \"TaskHeader\";\n  header.resize(1312, 56);\n  header.cornerRadius = 16;\n  header.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  header.paddingLeft = 24; header.paddingRight = 24;\n  header.layoutMode = \"HORIZONTAL\";\n  header.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  header.counterAxisAlignItems = \"CENTER\";\n\n  const hLeft = figma.createFrame();\n  hLeft.layoutMode = \"HORIZONTAL\";\n  hLeft.counterAxisAlignItems = \"CENTER\";\n  hLeft.itemSpacing = 16;\n  hLeft.fills = [];\n\n  const taskTitle = figma.createText();\n  taskTitle.characters = \"🔥 Task\";\n  taskTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  taskTitle.fontSize = 20;\n  taskTitle.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n  hLeft.appendChild(taskTitle);\n  header.appendChild(hLeft);\n\n  // Header right: Member (25) · View All · team avatars with +6 · add (Icon_Plus)\n  const hRight = figma.createFrame();\n  hRight.layoutMode = \"HORIZONTAL\";\n  hRight.counterAxisAlignItems = \"CENTER\";\n  hRight.itemSpacing = 20;\n  hRight.fills = [];\n\n  const memFrame = figma.createFrame();\n  memFrame.layoutMode = \"HORIZONTAL\";\n  memFrame.itemSpacing = 8;\n  memFrame.fills = [];\n  const memCount = figma.createText();\n  memCount.characters = \"Member (25)\";\n  memCount.fontName = { family: \"DM Sans\", style: \"Medium\" };\n  memCount.fontSize = 13;\n  memCount.fills = [{ type: 'SOLID', color: { r: