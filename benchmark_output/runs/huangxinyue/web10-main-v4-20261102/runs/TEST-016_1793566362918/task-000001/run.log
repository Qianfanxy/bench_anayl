.name);\nfor(const [n,sz,st] of types){ if(!ets.includes('OCTOM/'+n)){const ts=figma.createTextStyle(); ts.name='OCTOM/'+n; ts.fontName={family:'DM Sans',style:st}; ts.fontSize=sz; ts.lineHeight={value:Math.round(sz*1.4),unit:'PIXELS'};} }\nconst root=AL('Design System · OCTOM','VERTICAL',32,48); root.fills=S('FFFFFF'); root.cornerRadius=24;\nroot.appendChild(T('Design System · OCTOM',32,'Bold'));\nroot.appendChild(T('Grid: 96 px icon sidebar + 88 px top bar; 32 px page margins; 24 px gutters; 8 pt spacing scale. Cards: radius 16, controls 10–12, chips 6/999. Elevation: card 0 4 24 rgba(28,28,77,.06); active nav 0 6 14 brand 30%; focus ring 4 px brand 16%.',14,'Regular','6E7191'));\nconst sw=AL('Colors','HORIZONTAL',16); sw.layoutWrap='WRAP'; sw.resize(1400,10); sw.layoutSizingHorizontal='FIXED'; sw.counterAxisSpacing=16;\nfor(const [n,h] of tokens){const c=AL(n,'VERTICAL',8); const r=figma.createRectangle(); r.resize(160,72); r.cornerRadius=12; r.fills=S(h); r.strokes=S('E9EAF2'); c.appendChild(r); c.appendChild(T(n,12,'SemiBold')); c.appendChild(T('#'+h,12,'Regular','6E7191')); sw.appendChild(c);}\nroot.appendChild(sw);\nconst ty=AL('Type Scale','VERTICAL',12); for(const [n,sz,st] of types){ty.appendChild(T(n+' — Search Inspiration for project',sz,st));} root.appendChild(ty);\nconst rs=AL('Radii & Spacing','HORIZONTAL',24); for(const [n,r] of [['Chip 6',6],['Control 10',10],['Icon btn 12',12],['Nav 14',14],['Card 16',16]]){const c=AL(n,'VERTICAL',8); const f=figma.createRectangle(); f.resize(72,72); f.cornerRadius=r; f.fills=S('EEEEFF'); f.strokes=S('5051F9'); c.appendChild(f); c.appendChild(T(n,12,'Medium','6E7191')); rs.appendChild(c);}\nfor(const s of [4,8,12,16,24,32]){const c=AL('Space '+s,'VERTICAL',8); const f=figma.createRectangle(); f.resize(s,72); f.fills=S('5051F9',0.3); c.appendChild(f); c.appendChild(T(String(s),12,'Medium','6E7191')); rs.appendChild(c);}\nroot.appendChild(rs);\nroot.x=0; root.y=1200+2094+120;\nreturn root.id;","description":"Create d