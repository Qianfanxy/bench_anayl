e}`;\n    card.resize(350, 84);\n    card.cornerRadius = 16;\n    card.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n    card.layoutMode = \"HORIZONTAL\";\n    card.counterAxisAlignItems = \"CENTER\";\n    card.paddingLeft = 12;\n    card.paddingRight = 16;\n    card.itemSpacing = 14;\n    card.layoutAlign = \"STRETCH\";\n\n    const imgThumb = figma.createFrame();\n    imgThumb.resize(60, 60);\n    imgThumb.cornerRadius = 12;\n    imgThumb.clipsContent = true;\n    const photoInst = item.photo.createInstance();\n    photoInst.resize(60, 60);\n    imgThumb.appendChild(photoInst);\n    card.appendChild(imgThumb);\n\n    const details = figma.createFrame();\n    details.layoutMode = \"VERTICAL\";\n    details.itemSpacing = 6;\n    details.fills = [];\n    details.layoutGrow = 1;\n\n    const topRow = figma.createFrame();\n    topRow.layoutMode = \"HORIZONTAL\";\n    topRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    topRow.counterAxisAlignItems = \"CENTER\";\n    topRow.fills = [];\n    topRow.layoutAlign = \"STRETCH\";\n\n    const nameTxt = figma.createText();\n    nameTxt.fontName = { family: \"Lato\", style: \"Bold\" };\n    nameTxt.fontSize = 15;\n    nameTxt.characters = item.name;\n    nameTxt.fills = [{ type: 'SOLID', color: { r: 0.098, g: 0.129, b: 0.149 } }];\n    topRow.appendChild(nameTxt);\n\n    const tag = figma.createFrame();\n    tag.paddingLeft = 8;\n    tag.paddingRight = 8;\n    tag.paddingTop = 3;\n    tag.paddingBottom = 3;\n    tag.cornerRadius = 6;\n    tag.fills = [{ type: 'SOLID', color: { r: 0.94, g: 0.96, b: 0.98 } }];\n    const tagTxt = figma.createText();\n    tagTxt.fontName = { family: \"Lato\", style: \"Medium\" };\n    tagTxt.fontSize = 11;\n    tagTxt.characters = item.level;\n    tagTxt.fills = [{ type: 'SOLID', color: { r: 0.4, g: 0.45, b: 0.5 } }];\n    tag.appendChild(tagTxt);\n    topRow.appendChild(tag);\n\n    details.appendChild(topRow);\n\n    const goalTxt = figma.createText();\n    goalTxt.fontName = { fa