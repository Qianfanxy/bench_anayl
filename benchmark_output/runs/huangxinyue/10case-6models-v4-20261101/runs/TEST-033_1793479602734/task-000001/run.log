{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_6fdeaa3a9b5b4f80a4bb420d","name":"mcp__figma__use_figma","input":{"code":"const link=(node,dest)=>{ node.reactions=[{trigger:{type:'ON_TAP'},action:{type:'NODE',destinationId:dest,navigation:'NAVIGATE'}}]; };\nconst f1=await figma.getNodeByIdAsync('16:2');\nconst f2=await figma.getNodeByIdAsync('17:2');\nconst f3=await figma.getNodeByIdAsync('18:2');\nconst f4=await figma.getNodeByIdAsync('20:2');\nconst f5=await figma.getNodeByIdAsync('20:117');\nconst f6=await figma.getNodeByIdAsync('21:2');\nconst done=[];\n\n// 01: Deposit -> 04, tabs\nconst acts=f1.findOne(n=>n.name==='Actions');\nlink(acts.children[0],'20:2'); done.push('01 Deposit->04');\nconst tb1=f1.findOne(n=>n.type==='INSTANCE'&&n.componentId==='8:11');\nlink(tb1.findOne(n=>n.name==='Tab / Trending'),'17:2'); done.push('01 TabTrending->02');\nlink(tb1.findOne(n=>n.name==='Tab / Top Up'),'20:2'); done.push('01 TabTopUp->04');\n\n// 02: GOTO row -> 03, tabs\nconst rows2=f2.children.filter(n=>n.name==='Stock Row');\nlink(rows2[1],'18:2'); done.push('02 GOTO row->03');\nconst tb2=f2.findOne(n=>n.type==='INSTANCE'&&n.componentId==='8:11');\nlink(tb2.findOne(n=>n.name==='Tab / Aktivitas'),'16:2'); done.push('02 TabAktivitas->01');\nlink(tb2.findOne(n=>n.name==='Tab / Top Up'),'20:2'); done.push('02 TabTopUp->04');\n\n// 03: back -> 02\nconst hd3=f3.findOne(n=>n.type==='INSTANCE'&&n.componentId==='8:51');\nlink(hd3.findOne(n=>n.name==='Back'),'17:2'); done.push('03 Back->02');\n\n// 04: Alfamart row -> 05, back -> 01\nconst mrows=f4.children.filter(n=>n.name==='Method Row');\nlink(mrows[4],'20:117'); done.push('04 Alfamart->05');\nconst hd4=f4.findOne(n=>n.type==='INSTANCE'&&n.componentId==='8:43');\nlink(hd4.findOne(n=>n.name==='Back'),'16:2'); done.push('04 Back->01');\n\n// 05: Bayar -> 06, back/Ganti -> 04\nconst bay=f5.children.find(n=>n.type==='INSTANCE'&&n.componentId==='1:22');\nlink(bay,'21:2'); done.push('05 Bayar->06');\nconst hd5