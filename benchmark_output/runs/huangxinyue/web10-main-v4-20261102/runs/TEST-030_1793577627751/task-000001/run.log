;f.paddingBottom=112;f.paddingLeft=80;\n  f.itemSpacing=52;f.resize(1440,10);f.fills=fills||[];\n  main.appendChild(f);f.layoutSizingHorizontal='FILL';return f;\n}\nfunction heading(parent,eyebrow,title,desc,rightText){\n  const head=figma.createFrame();head.name='Section header';head.layoutMode='HORIZONTAL';\n  head.primaryAxisSizingMode='FIXED';head.counterAxisSizingMode='AUTO';head.resize(1280,10);\n  head.primaryAxisAlignItems='SPACE_BETWEEN';head.counterAxisAlignItems='MAX';head.itemSpacing=60;head.fills=[];\n  parent.appendChild(head);head.layoutSizingHorizontal='FILL';\n  const l=figma.createFrame();l.name='Heading';l.layoutMode='VERTICAL';l.primaryAxisSizingMode='AUTO';l.counterAxisSizingMode='AUTO';l.itemSpacing=14;l.fills=[];head.appendChild(l);\n  l.appendChild(T(eyebrow,12,'SemiBold',C.orange,{ls:2}));\n  l.appendChild(T(title,44,'SemiBold',C.text,{name:'Title'}));\n  if(desc) l.appendChild(T(desc,15,'Regular',C.sub,{lh:26,width:560,name:'Section desc'}));\n  if(rightText){const r=T(rightText,13,'Medium',C.muted,{width:220,lh:22,name:'Section meta'});r.textAlignHorizontal='RIGHT';head.appendChild(r);}\n  return head;\n}\nconst exp=newSection('Experience',[solid('#101013')]);\nheading(exp,'CAREER','Experience','Eight years of shipping backend systems, search infrastructure and large-scale data platforms.','2016 — NOW');\nconst list=figma.createFrame();list.name='Experience list';list.layoutMode='VERTICAL';list.primaryAxisSizingMode='AUTO';list.counterAxisSizingMode='FIXED';\nlist.resize(1280,10);list.itemSpacing=16;list.fills=[];exp.appendChild(list);list.layoutSizingHorizontal='FILL';\nconst descTexts=[\n'As a Lead Software Engineer at Searchlight, I played a pivotal role in developing innovative solutions for Searchlight’s core search algorithms. Collaborating with a dynamic team of engineers, I contributed to the enhancement of search accuracy and efficiency, optimizing user experiences for millions of users worldwide.',\n'At Meridian Social, I served as a Software Engineer, focusing on the design and implementation of backend systems for the social media company’s dynamic platform. Working on projects that involved large-scale data processing and user engagement features, I leveraged my expertise to ensure seamless functionality and scalability.',\n'During my tenure at Orchard Computing, I worked as a Junior Software Engineer and contributed to the architecture of mission-critical software projects. I helped design scalable and efficient systems as part of a cross-functional team.'];\nconst itemIds=['10:81','10:91','10:101'];\nconst metas=[['Searchlight','Nov 2019 – Present'],['Meridian Social','Jan 2017 – Oct 2019'],['Orchard Computing','Jan 2016 – Dec 2016']];\nfor(let i=0;i<3;i++){\n  const inst=await clone(itemIds[i]);list.appendChild(inst);inst.name='ExperienceItem / '+metas[i][0];inst.layoutSizingHorizontal='FILL';\n  inst.findOne(n=>n.name==='Description').characters=descTexts[i];\n  inst.findOne(n=>n.name==='Company').characters=metas[i][0];\n  inst.findOne(n=>n.name==='Dates').characters=metas[i][1];\n}\nreturn {projH:proj.height, expH:exp.height, items:list.children.map(c=>c.height)};","description":"Complete Projects cards and Experience section","fileKey":"rWatUx8u9ogpUtH7IHQ5Wt"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":70801,"input_tokens":1,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":70801}},"context_management":null},"parent_tool_use_id":null,"session_id":"ad70c2ff-9331-4674-b010-6cfed35c5750","uuid":"a40da0cf-57e1-4e2a-8e76-949be319a035","timestamp":"2026-11-02T00:11:07.789Z","tool_use_meta":[{"id":"toolu_01pUOv7kMeqDM7xnWEmapCXX","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
