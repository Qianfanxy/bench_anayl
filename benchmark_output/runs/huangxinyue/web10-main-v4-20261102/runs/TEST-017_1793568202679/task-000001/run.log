{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_bdrk_lxqafp6p5kqm7rmxkmai6w4mcxuk6waulr3bghdalwx2ul4ornvq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01G26e8cxGdtgvDTpxN37xVo","name":"mcp__figma__use_figma","input":{"code":"const ws=await figma.getNodeByIdAsync('11:2');await figma.setCurrentPageAsync(ws);\nconst F='Source Sans Pro';\nawait Promise.all(['Regular','SemiBold','Bold','Black'].map(s=>figma.loadFontAsync({family:F,style:s})));\nconst hex=h=>{h=h.replace('#','');return {r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255}};\nconst solid=(h,o=1)=>[{type:'SOLID',color:hex(h),opacity:o}];\nconst C={pri:'#F17228',priH:'#D85F18',sec:'#FFB30E',ink:'#212121',body:'#4F4F4F',muted:'#8A8A8A',line:'#EDEDED',surf:'#F5F5F5',soft:'#FFF1E6',softH:'#FFE2CC',cream:'#FFF8EC',white:'#FFFFFF'};\nfunction T(chars,size,style='Regular',color=C.ink,o={}){const t=figma.createText();t.fontName={family:F,style};t.fontSize=size;t.characters=chars;t.fills=solid(color);t.lineHeight={value:Math.round(size*(o.lh||1.3)),unit:'PIXELS'};if(o.w){t.textAutoResize='HEIGHT';t.resize(o.w,t.height);}t.name=o.name||chars.slice(0,30);if(o.align)t.textAlignHorizontal=o.align;return t;}\nfunction AL(name,dir='HORIZONTAL',o={},node){const f=node||figma.createFrame();f.name=name;f.layoutMode=dir;f.primaryAxisSizingMode='AUTO';f.counterAxisSizingMode='AUTO';f.itemSpacing=o.gap||0;const p=o.pad||[0,0,0,0];f.paddingTop=p[0];f.paddingRight=p[1];f.paddingBottom=p[2];f.paddingLeft=p[3];f.fills=o.fill?solid(o.fill):[];if(o.r)f.cornerRadius=o.r;f.counterAxisAlignItems=o.ca||'CENTER';f.primaryAxisAlignItems=o.pa||'MIN';f.clipsContent=false;return f;}\nconst CP=(name,dir,o)=>AL(name,dir,o,figma.createComponent());\nconst get=async id=>await figma.getNodeByIdAsync(id);\nconst IC={search:'9:12',chevR:'9:4',chevL:'9:3',tag:'9:19',clock:'9:5',map:'9:9',moto:'9:10',bag:'9:13',star:'9:14',user:'9:21',env:'9:7',disc:'9:6',track:'9:20',quick:'9:11',sLoc:'9:16',sOrd:'9:17',sPay:'9:18',sEnj:'9:15'};\nasync function icon(k,color,size=24){const c=await get(IC[k]||k);const i=c.createInstance();i.fills=[];i.findAll(n=>n.type==='VECTOR').forEach(v=>{if(v.strokes.length)v.strokes=solid(color);else v.fills=solid(color);});if(size!==24)i.rescale(size/24);i.name='Icon';return i;}\nconst shadow=(a=.08,y=12,r=32,col='#000000')=>({type:'DROP_SHADOW',color:{...hex(col),a},offset:{x:0,y},radius:r,spread:0,visible:true,blendMode:'NORMAL'});\nasync function photo(id,w,h){const i=(await get(id)).createInstance();i.resize(w,h);i.name='Photo';return i;}\nfunction setP(inst,map){const defs=inst.componentProperties;const o={};for(const [k,v] of Object.entries(map)){const key=Object.keys(defs).find(d=>d.split('#')[0]===k);if(key)o[key]=v;}inst.setProperties(o);}\nfunction prop(c,name,node,type='TEXT',def){const k=c.addComponentProperty(name,type,def??node.characters);node.componentPropertyReferences={...(node.componentPropertyReferences||{}),[type==='TEXT'?'characters':type==='BOOLEAN'?'visible':'mainComponent']:k};}\nconst board=await get('13:2');\nfunction section(title){const s=AL('Section · '+title,'VERTICAL',{gap:24,ca:'MIN'});s.appendChild(T(title,24,'Bold',C.pri,{name:'Section title'}));const row=AL('Row','HORIZONTAL',{gap:32,ca:'MIN'});s.appendChild(row);board.appendChild(s);return row;}\nconst BTN=await get('13:91');const btnVar=(s,st='Default')=>BTN.children.find(c=>c.name===`Style=${s}, State=${st}`);\nconst ids={};\n\n// HEADER\nlet row=section('Header');\nconst hd=CP('Header','HORIZONTAL',{pad:[20,240,20,240],fill:C.white,pa:'SPACE_BETWEEN'});hd.primaryAxisSizingMode='FIXED';hd.resize(1920,96);hd.counterAxisSizingMode='AUTO';hd.effects=[shadow(.06,4,24)];\nconst logo=(await get('9:27')).createInstance();logo.rescale(0.875);hd.appendChild(logo);\nconst loc=AL('Deliver to','HORIZONTAL',{gap:10});loc.appendChild(await icon('map',C.pri));\nloc.appendChild(T('Deliver to:',18,'Bold',C.ink));loc.appendChild(T('Current Location',18,'Regular',C.muted));loc.appendChild(T('Mohammadpur Bus Stand, Dhaka',18,'Bold',C.ink,{name:'Address'}));hd.appendChild(loc);\nconst acts=AL('Actions','HORIZONTAL',{gap:16});\nconst sb=btnVar('Ghost').createInstance();setP(sb,{Label:'Search Food','Leading icon':true,'Trailing icon':false,Icon:IC.search});acts.appendChild(sb);\nconst lb=btnVar('Soft').createInstance();setP(lb,{Label:'Login','Leading icon':true,'Trailing icon':false,Icon:IC.user});acts.appendChild(lb);\nhd.appendChild(acts);row.appendChild(hd);ids.header=hd.id;\n\n// DISCOUNT CARD\nrow=section('Discount Card · Step Card · Feature Item');\nconst dc=CP('Discount Card','VERTICAL',{gap:16,ca:'MIN'});\nconst pf=figma.createFrame();pf.name='Media';pf.resize(336,336);pf.cornerRadius=20;pf.clipsContent=true;pf.fills=solid(C.surf);dc.appendChild(pf);\nconst ph=await photo('9:31',336,336);pf.appendChild(ph);\nconst off=AL('Off Badge','HORIZONTAL',{pad:[10,18,10,18],r:14});off.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[1,0,0],[0,1,0]],gradientStops:[{position:0,color:{...hex(C.pri),a:1}},{position:1,color:{...hex(C.sec),a:1}}]}];off.effects=[shadow(.2,6,16)];\nconst offT=T('15% Off',32,'Black',C.white,{name:'Percent',lh:1.1});off.appendChild(offT);pf.appendChild(off);off.x=16;off.y=336-16-off.height;off.constraints={horizontal:'MIN',vertical:'MAX'};\nconst dn=T('Spring Salad',24,'Bold',C.ink,{name:'Dish'});dc.appendChild(dn);\nconst days=AL('Days Pill','HORIZONTAL',{pad:[6,14,6,14],r:999,fill:C.soft,gap:6});days.appendChild(await icon('clock',C.pri,18));const dt=T('6 Days Remaining',16,'Bold',C.pri,{name:'Days'});days.appendChild(dt);dc.appendChild(days);\nprop(dc,'Percent',offT);prop(dc,'Dish',dn);prop(dc,'Days',dt);prop(dc,'Photo',ph,'INSTANCE_SWAP','9:31');\nrow.appendChild(dc);ids.discount=dc.id;\n\n// STEP CARD\nconst sc=CP('Step Card','VERTICAL',{gap:20,pad:[40,32,40,32],fill:C.white,r:24});sc.primaryAxisSizingMode='AUTO';sc.counterAxisSizingMode='FIXED';sc.resize(336,sc.height);sc.effects=[shadow(.06,10,30,'#B5540F')];\nconst circ=AL('Icon Circle','HORIZONTAL',{pa:'CENTER',ca:'CENTER'});circ.primaryAxisSizingMode='FIXED';circ.counterAxisSizingMode='FIXED';circ.resize(112,112);circ.cornerRadius=56;circ.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[1,1,0],[-1,1,0.5]],gradientStops:[{position:0,color:{...hex(C.sec),a:1}},{position:1,color:{...hex(C.pri),a:1}}]}];circ.effects=[shadow(.3,10,24,C.pri)];\nconst si=await icon('sLoc',C.white,48);circ.appendChild(si);sc.appendChild(circ);\nconst st=T('Select location',26,'Bold',C.ink,{name:'Title',align:'CENTER'});sc.appendChild(st);\nconst sx=T('Choose the location where your food will be delivered.',18,'Regular',C.body,{name:'Text',w:272,align:'CENTER',lh:1.5});sc.appendChild(sx);\nprop(sc,'Title',st);prop(sc,'Text',sx);prop(sc,'Icon',si,'INSTANCE_SWAP',IC.sLoc);\nrow.appendChild(sc);ids.step=sc.id;\n\n// FEATURE ITEM\nconst fi=CP('Feature Item','HORIZONTAL',{gap:20});\nconst fc=AL('Icon Circle','HORIZONTAL',{pa:'CENTER',ca:'CENTER',fill:C.white});fc.primaryAxisSizingMode='FIXED';fc.counterAxisSizingMode='FIXED';fc.resize(72,72);fc.cornerRadius=36;fc.effects=[shadow(.12,6,16)];\nconst fic=await icon('disc',C.pri,36);fc.appendChild(fic);fi.appendChild(fc);\nconst ft=T('Daily Discounts',26,'Bold',C.white,{name:'Title'});fi.appendChild(ft);\nprop(fi,'Title',ft);prop(fi,'Icon',fic,'INSTANCE_SWAP',IC.disc);\nconst fwrap=AL('bg','HORIZONTAL',{pad:[24,24,24,24],fill:C.pri,r:16});fwrap.appendChild(fi);row.appendChild(fwrap);ids.feature=fi.id;\n\n// ITEM CARD (Default / Hover)\nrow=section('Popular Item Card · State');\nconst items=[];\nfor(const s of ['Default','Hover']){const c=CP('State='+s,'VERTICAL',{gap:12,pad:[16,16,20,16],fill:C.white,r:24,ca:'MIN'});c.counterAxisSizingMode='FIXED';c.resize(264,c.height);\n if(s==='Hover'){c.effects=[shadow(.12,16,40)];}else{c.strokes=solid(C.line);c.strokeWeight=1;}\n const m=figma.createFrame();m.name='Media';m.resize(232,232);m.cornerRadius=16;m.clipsContent=true;c.appendChild(m);const p=await photo('9:50',232,232);m.appendChild(p);\n c.appendChild(T('Cheese Burger',22,'Bold',C.ink,{name:'Name'}));\n const r=AL('Restaurant','HORIZONTAL',{gap:6});r.appendChild(await icon('map',C.pri,18));r.appendChild(T('Burger Arena',16,'SemiBold',C.muted,{name:'Restaurant'}));c.appendChild(r);\n c.appendChild(T('$3.88',28,'Bold',C.ink,{name:'Price'}));\n const ob=(await get('1:28')).createInstance();ob.name='Order Now';c.appendChild(ob);ob.layoutSizingHorizontal='FILL';ob.resize(232,52);ob.findOne(n=>n.type==='TEXT').characters='Order Now';\n if(s==='Hover'){ob.fills=solid(C.priH);}\n items.push(c);}\nconst iset=figma.combineAsVariants(items,row);iset.name='Popular Item Card';AL('Popular Item Card','HORIZONTAL',{gap:32,pad:[24,24,24,24],fill:'#EFEFEF',r:16,ca:'MIN'},iset);\nfor(const [k,def] of [['Name','Cheese Burger'],['Restaurant','Burger Arena'],['Price','$3.88']]){const key=iset.addComponentProperty(k,'TEXT',def);iset.children.forEach(c=>c.findOne(n=>n.name===k&&n.type==='TEXT').componentPropertyReferences={characters:key});}\nconst ipk=iset.addComponentProperty('Photo','INSTANCE_SWAP','9:50');iset.children.forEach(c=>c.findOne(n=>n.name==='Photo').componentPropertyReferences={mainComponent:ipk});\nids.item=iset.id;\n\n// CATEGORY TILE\nrow=section('Food Category Tile · State');\nconst cats=[];\nfor(const s of ['Default','Hover']){const c=CP('State='+s,'VERTICAL',{gap:20,ca:'CENTER'});\n const m=figma.createFrame();m.name='Media';m.resize(212,212);m.cornerRadius=106;m.clipsContent=true;c.appendChild(m);const p=await photo('9:37',212,212);m.appendChild(p);\n if(s==='Hover'){m.strokes=solid(C.pri);m.strokeWeight=5;m.strokeAlign='INSIDE';c.effects=[];m.effects=[shadow(.25,12,28,C.pri)];}\n c.appendChild(T('Pizza',22,'Bold',s==='Hover'?C.pri:C.ink,{name:'Name',align:'CENTER'}));cats.push(c);}\nconst cset=figma.combineAsVariants(cats,row);cset.name='Food Category Tile';AL('Food Category Tile','HORIZONTAL',{gap:32,pad:[24,24,24,24],fill:C.white,r:16,ca:'MIN'},cset);\nconst cnk=cset.addComponentProperty('Name','TEXT','Pizza');const cpk=cset.addComponentProperty('Photo','INSTANCE_SWAP','9:37');\ncset.children.forEach(c=>{c.findOne(n=>n.name==='Name').componentPropertyReferences={characters:cnk};c.findOne(n=>n.name==='Photo').componentPropertyReferences={mainComponent:cpk};});\nids.cat=cset.id;\nreturn ids;","description":"Create header, discount, step, feature, item card, category tile components","fileKey":"nNa8Gsj0yGpnGfKLYRu7xU"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":18911,"cache_read_input_tokens":17096,"cache_creation":{"ephemeral_5m_input_tokens":18911,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8d84beb6-d490-4e82-87ae-33d251e21179","uuid":"0a60b8b4-eb35-4fec-8b01-6a674f37e985","timestamp":"2026-11-01T21:27:57.325Z","tool_use_meta":[{"id":"toolu_bdrk_01G26e8cxGdtgvDTpxN37xVo","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
