{"type":"assistant","message":{"id":"chatcmpl-20261101195541180217098268d9d6As29FEsz","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_3012d72c5c1d4a73b17bd73d4739f99b","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  // Let's create the 01_Home frame!\n  // Width 1440, height is auto (let's say 2400)\n  \n  // Make sure fonts are loaded (just in case)\n  await figma.loadFontAsync({ family: \"Archivo Black\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Plus Jakarta Sans\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Plus Jakarta Sans\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Plus Jakarta Sans\", style: \"Semi Bold\" });\n  await figma.loadFontAsync({ family: \"Plus Jakarta Sans\", style: \"Bold\" });\n\n  const wsPage = await figma.getNodeByIdAsync(\"6:2\");\n  \n  // Map of media components\n  const mediaPage = await figma.getNodeByIdAsync(\"1:4\");\n  const mediaMap = {};\n  function findMedia(node) {\n    if (node.type === \"COMPONENT\" || node.type === \"COMPONENT_SET\") {\n      mediaMap[node.name] = node;\n    }\n    if (\"children\" in node) {\n      for (const c of node.children) findMedia(c);\n    }\n  }\n  findMedia(mediaPage);\n\n  function getInstance(name, width, height) {\n    const comp = mediaMap[name];\n    if (!comp) {\n      const r = figma.createFrame();\n      r.name = name;\n      r.resize(width || 24, height || 24);\n      r.fills = [{ type: 'SOLID', color: { r: 0.9, g: 0.9, b: 0.9 } }];\n      return r;\n    }\n    const inst = comp.createInstance();\n    if (width && height) {\n      inst.resize(width, height);\n    }\n    return inst;\n  }\n\n  const C = {\n    black: { r: 0, g: 0, b: 0 },\n    white: { r: 1, g: 1, b: 1 },\n    grayBg: { r: 0.95, g: 0.95, b: 0.95 },\n    grayText: { r: 0.4, g: 0.4, b: 0.4 },\n    grayBorder: { r: 0.9, g: 0.9, b: 0.9 },\n    starYellow: { r: 1, g: 0.75, b: 0 },\n    greenVerified: { r: 0.01, g: 0.75, b: 0.17 },\n    discountBg: { r: 1, g: 0.9, b: 0.9 },\n    discountText: { r: 1, g: 0.2, b: 0.2 }\n  };\n\n  // Build Shared UI Blocks\n  function createAnnouncementBar() {\n    const bar = figma.createFrame();\n    bar.name = \"Announcement Bar\";\n    bar.resize(1440, 38);\n    bar.fills = [{ type: 'SOLID', color: C.black }];\n    bar.layoutMode = \"HORIZONTAL\";\n    bar.primaryAxisAlignItems = \"CENTER\";\n    bar.counterAxisAlignItems = \"CENTER\";\n    bar.paddingLeft = 100;\n    bar.paddingRight = 100;\n    bar.itemSpacing = 8;\n\n    const text = figma.createText();\n    text.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    text.fontSize = 14;\n    text.characters = \"Sign up and get 20% off to your first order. \";\n    text.fills = [{ type: 'SOLID', color: C.white }];\n\n    const link = figma.createText();\n    link.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n    link.fontSize = 14;\n    link.characters = \"Sign Up Now\";\n    link.textDecoration = \"UNDERLINE\";\n    link.fills = [{ type: 'SOLID', color: C.white }];\n\n    const spacer = figma.createFrame();\n    spacer.name = \"Spacer\";\n    spacer.resize(1, 1);\n    spacer.fills = [];\n    spacer.layoutGrow = 1;\n\n    const closeIcon = getInstance(\"Icon_Close\", 20, 20);\n\n    bar.appendChild(text);\n    bar.appendChild(link);\n    bar.appendChild(spacer);\n    bar.appendChild(closeIcon);\n    return bar;\n  }\n\n  function createHeader(activeNav) {\n    const header = figma.createFrame();\n    header.name = \"Header\";\n    header.resize(1440, 96);\n    header.fills = [{ type: 'SOLID', color: C.white }];\n    header.layoutMode = \"HORIZONTAL\";\n    header.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    header.counterAxisAlignItems = \"CENTER\";\n    header.paddingLeft = 100;\n    header.paddingRight = 100;\n    header.itemSpacing = 40;\n\n    const logo = figma.createText();\n    logo.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n    logo.fontSize = 32;\n    logo.characters = \"SHOP.CO\";\n    logo.fills = [{ type: 'SOLID', color: C.black }];\n\n    const nav = figma.createFrame();\n    nav.name = \"Navigation\";\n    nav.fills = [];\n    nav.layoutMode = \"HORIZONTAL\";\n    nav.counterAxisAlignItems = \"CENTER\";\n    nav.itemSpacing = 24;\n\n    const items = [\n      { name: \"Shop\", hasChevron: true },\n      { name: \"On Sale\", hasChevron: false },\n      { name: \"New Arrivals\", hasChevron: false },\n      { name: \"Brands\", hasChevron: false }\n    ];\n\n    for (const item of items) {\n      const navItem = figma.createFrame();\n      navItem.name = `Nav_${item.name}`;\n      navItem.fills = [];\n      navItem.layoutMode = \"HORIZONTAL\";\n      navItem.counterAxisAlignItems = \"CENTER\";\n      navItem.itemSpacing = 4;\n\n      const t = figma.createText();\n      const isCurrent = (activeNav === item.name);\n      t.fontName = { family: \"Plus Jakarta Sans\", style: isCurrent ? \"Bold\" : \"Regular\" };\n      t.fontSize = 16;\n      t.characters = item.name;\n      t.fills = [{ type: 'SOLID', color: C.black }];\n\n      navItem.appendChild(t);\n\n      if (item.hasChevron) {\n        const chev = getInstance(\"Icon_Chevron_Down\", 16, 16);\n        navItem.appendChild(chev);\n      }\n      nav.appendChild(navItem);\n    }\n\n    const search = figma.createFrame();\n    search.name = \"Search Field\";\n    search.resize(500, 48);\n    search.fills = [{ type: 'SOLID', color: C.grayBg }];\n    search.cornerRadius = 62;\n    search.layoutMode = \"HORIZONTAL\";\n    search.counterAxisAlignItems = \"CENTER\";\n    search.paddingLeft = 16;\n    search.paddingRight = 16;\n    search.itemSpacing = 12;\n    search.layoutGrow = 1;\n\n    const searchIcon = getInstance(\"Icon_Search\", 20, 20);\n    const searchInput = figma.createText();\n    searchInput.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    searchInput.fontSize = 16;\n    searchInput.characters = \"Search for products...\";\n    searchInput.fills = [{ type: 'SOLID', color: C.grayText }];\n\n    search.appendChild(searchIcon);\n    search.appendChild(searchInput);\n\n    const actions = figma.createFrame();\n    actions.name = \"Actions\";\n    actions.fills = [];\n    actions.layoutMode = \"HORIZONTAL\";\n    actions.counterAxisAlignItems = \"CENTER\";\n    actions.itemSpacing = 14;\n\n    const cartIcon = getInstance(\"Icon_Cart\", 24, 24);\n    cartIcon.name = \"Icon_Cart_Trigger\";\n    const accountIcon = getInstance(\"Icon_Account\", 24, 24);\n\n    actions.appendChild(cartIcon);\n    actions.appendChild(accountIcon);\n\n    header.appendChild(logo);\n    header.appendChild(nav);\n    header.appendChild(search);\n    header.appendChild(actions);\n\n    return header;\n  }\n\n  function createNewsletter() {\n    const container = figma.createFrame();\n    container.name = \"Newsletter Section\";\n    container.resize(1440, 200);\n    container.fills = [];\n    container.layoutMode = \"HORIZONTAL\";\n    container.primaryAxisAlignItems = \"CENTER\";\n\n    const box = figma.createFrame();\n    box.name = \"Newsletter Box\";\n    box.resize(1240, 180);\n    box.fills = [{ type: 'SOLID', color: C.black }];\n    box.cornerRadius = 20;\n    box.layoutMode = \"HORIZONTAL\";\n    box.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    box.counterAxisAlignItems = \"CENTER\";\n    box.paddingLeft = 64;\n    box.paddingRight = 64;\n\n    const title = figma.createText();\n    title.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n    title.fontSize = 32;\n    title.characters = \"STAY UP TO DATE ABOUT\\nOUR LATEST OFFERS\";\n    title.fills = [{ type: 'SOLID', color: C.white }];\n    title.resize(550, 80);\n\n    const form = figma.createFrame();\n    form.name = \"Newsletter Form\";\n    form.fills = [];\n    form.layoutMode = \"VERTICAL\";\n    form.itemSpacing = 14;\n    form.resize(350, 110);\n\n    const emailField = figma.createFrame();\n    emailField.name = \"Email Field\";\n    emailField.resize(350, 48);\n    emailField.fills = [{ type: 'SOLID', color: C.white }];\n    emailField.cornerRadius = 62;\n    emailField.layoutMode = \"HORIZONTAL\";\n    emailField.counterAxisAlignItems = \"CENTER\";\n    emailField.paddingLeft = 16;\n    emailField.itemSpacing = 12;\n\n    const tagIcon = getInstance(\"Icon_Tag\", 20, 20);\n    const emailInput = figma.createText();\n    emailInput.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    emailInput.fontSize = 14;\n    emailInput.characters = \"Enter your email address\";\n    emailInput.fills = [{ type: 'SOLID', color: C.grayText }];\n\n    emailField.appendChild(tagIcon);\n    emailField.appendChild(emailInput);\n\n    const btn = figma.createFrame();\n    btn.name = \"Subscribe Button\";\n    btn.resize(350, 48);\n    btn.fills = [{ type: 'SOLID', color: C.white }];\n    btn.cornerRadius = 62;\n    btn.layoutMode = \"HORIZONTAL\";\n    btn.primaryAxisAlignItems = \"CENTER\";\n    btn.counterAxisAlignItems = \"CENTER\";\n\n    const btnText = figma.createText();\n    btnText.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n    btnText.fontSize = 14;\n    btnText.characters = \"Subscribe to Newsletter\";\n    btnText.fills = [{ type: 'SOLID', color: C.black }];\n\n    btn.appendChild(btnText);\n\n    form.appendChild(emailField);\n    form.appendChild(btn);\n\n    box.appendChild(title);\n    box.appendChild(form);\n\n    container.appendChild(box);\n    return container;\n  }\n\n  function createFooter() {\n    const footer = figma.createFrame();\n    footer.name = \"Footer Component\";\n    footer.resize(1440, 420);\n    footer.fills = [{ type: 'SOLID', color: C.grayBg }];\n    footer.layoutMode = \"VERTICAL\";\n    footer.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    footer.paddingLeft = 100;\n    footer.paddingRight = 100;\n    footer.paddingTop = 50;\n    footer.paddingBottom = 30;\n\n    const topRow = figma.createFrame();\n    topRow.name = \"Footer Main Content\";\n    topRow.resize(1240, 260);\n    topRow.fills = [];\n    topRow.layoutMode = \"HORIZONTAL\";\n    topRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n\n    const brandCol = figma.createFrame();\n    brandCol.name = \"Brand Col\";\n    brandCol.resize(250, 220);\n    brandCol.fills = [];\n    brandCol.layoutMode = \"VERTICAL\";\n    brandCol.itemSpacing = 20;\n\n    const logo = figma.createText();\n    logo.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n    logo.fontSize = 28;\n    logo.characters = \"SHOP.CO\";\n\n    const desc = figma.createText();\n    desc.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    desc.fontSize = 14;\n    desc.characters = \"We have clothes that suit your style and which you’re proud to wear. From women to men.\";\n    desc.fills = [{ type: 'SOLID', color: C.grayText }];\n\n    const socialRow = figma.createFrame();\n    socialRow.name = \"Social Logos\";\n    socialRow.fills = [];\n    socialRow.layoutMode = \"HORIZONTAL\";\n    socialRow.itemSpacing = 12;\n\n    socialRow.appendChild(getInstance(\"Logo_Twitter\", 28, 28));\n    socialRow.appendChild(getInstance(\"Logo_Facebook\", 28, 28));\n    socialRow.appendChild(getInstance(\"Logo_Instagram\", 28, 28));\n    socialRow.appendChild(getInstance(\"Logo_GitHub\", 28, 28));\n\n    brandCol.appendChild(logo);\n    brandCol.appendChild(desc);\n    brandCol.appendChild(socialRow);\n\n    function createLinkCol(title, links) {\n      const col = figma.createFrame();\n      col.name = `Col_${title}`;\n      col.fills = [];\n      col.layoutMode = \"VERTICAL\";\n      col.itemSpacing = 16;\n\n      const t = figma.createText();\n      t.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n      t.fontSize = 16;\n      t.characters = title;\n\n      col.appendChild(t);\n\n      for (const link of links) {\n        const l = figma.createText();\n        l.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n        l.fontSize = 14;\n        l.characters = link;\n        l.fills = [{ type: 'SOLID', color: C.grayText }];\n        col.appendChild(l);\n      }\n      return col;\n    }\n\n    const companyCol = createLinkCol(\"COMPANY\", [\"About\", \"Features\", \"Works\", \"Career\"]);\n    const helpCol = createLinkCol(\"HELP\", [\"Customer Support\", \"Delivery Details\", \"Terms & Conditions\", \"Privacy Policy\"]);\n    const faqCol = createLinkCol(\"FAQ\", [\"Account\", \"Manage Deliveries\", \"Orders\", \"Payments\"]);\n    const resCol = createLinkCol(\"RESOURCES\", [\"Free eBooks\", \"Development Tutorial\", \"How to - Blog\", \"Youtube Playlist\"]);\n\n    topRow.appendChild(brandCol);\n    topRow.appendChild(companyCol);\n    topRow.appendChild(helpCol);\n    topRow.appendChild(faqCol);\n    topRow.appendChild(resCol);\n\n    const divider = figma.createFrame();\n    divider.name = \"Divider\";\n    divider.resize(1240, 1);\n    divider.fills = [{ type: 'SOLID', color: C.grayBorder }];\n\n    const bottomRow = figma.createFrame();\n    bottomRow.name = \"Footer Bottom\";\n    bottomRow.resize(1240, 40);\n    bottomRow.fills = [];\n    bottomRow.layoutMode = \"HORIZONTAL\";\n    bottomRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    bottomRow.counterAxisAlignItems = \"CENTER\";\n\n    const copyText = figma.createText();\n    copyText.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    copyText.fontSize = 14;\n    copyText.characters = \"Shop.co © 2000-2023, All Rights Reserved\";\n    copyText.fills = [{ type: 'SOLID', color: C.grayText }];\n\n    const paymentsRow = figma.createFrame();\n    paymentsRow.name = \"Payment Logos\";\n    paymentsRow.fills = [];\n    paymentsRow.layoutMode = \"HORIZONTAL\";\n    paymentsRow.itemSpacing = 10;\n\n    paymentsRow.appendChild(getInstance(\"Logo_Visa\", 46, 30));\n    paymentsRow.appendChild(getInstance(\"Logo_Mastercard\", 46, 30));\n    paymentsRow.appendChild(getInstance(\"Logo_PayPal\", 46, 30));\n    paymentsRow.appendChild(getInstance(\"Logo_Apple_Pay\", 46, 30));\n    paymentsRow.appendChild(getInstance(\"Logo_Google_Pay\", 46, 30));\n\n    bottomRow.appendChild(copyText);\n    bottomRow.appendChild(paymentsRow);\n\n    footer.appendChild(topRow);\n    footer.appendChild(divider);\n    footer.appendChild(bottomRow);\n\n    return footer;\n  }\n\n  // RATING BUILDER HELPER\n  function createRatingNode(score) {\n    const row = figma.createFrame();\n    row.name = \"Rating\";\n    row.fills = [];\n    row.layoutMode = \"HORIZONTAL\";\n    row.counterAxisAlignItems = \"CENTER\";\n    row.itemSpacing = 4;\n\n    const fullStars = Math.floor(score);\n    const hasHalf = (score % 1 !== 0);\n\n    for (let i = 0; i < 5; i++) {\n      if (i < fullStars) {\n        row.appendChild(getInstance(\"Icon_Star\", 18, 18));\n      } else if (i === fullStars && hasHalf) {\n        row.appendChild(getInstance(\"Icon_Star_Half\", 18, 18));\n      } else {\n        // Gray/empty star\n        const emptyStar = getInstance(\"Icon_Star\", 18, 18);\n        emptyStar.fills = [{ type: 'SOLID', color: { r: 0.8, g: 0.8, b: 0.8 } }];\n        row.appendChild(emptyStar);\n      }\n    }\n\n    const t = figma.createText();\n    t.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    t.fontSize = 14;\n    t.characters = `${score.toFixed(1)}/5`;\n    t.fills = [{ type: 'SOLID', color: C.grayText }];\n    row.appendChild(t);\n\n    return row;\n  }\n\n  // PRODUCT CARD COMPONENT\n  function createProductCard(photoName, name, ratingScore, price, oldPrice, discount) {\n    const card = figma.createFrame();\n    card.name = \"Product Card\";\n    card.resize(280, 400);\n    card.fills = [];\n    card.layoutMode = \"VERTICAL\";\n    card.itemSpacing = 12;\n\n    const imgWrapper = figma.createFrame();\n    imgWrapper.name = \"Image Wrapper\";\n    imgWrapper.resize(280, 280);\n    imgWrapper.cornerRadius = 16;\n    imgWrapper.fills = [{ type: \"SOLID\", color: C.grayBg }];\n    imgWrapper.layoutMode = \"VERTICAL\";\n    imgWrapper.primaryAxisAlignItems = \"CENTER\";\n    imgWrapper.counterAxisAlignItems = \"CENTER\";\n\n    const photo = getInstance(photoName, 260, 260);\n    imgWrapper.appendChild(photo);\n\n    const title = figma.createText();\n    title.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n    title.fontSize = 16;\n    title.characters = name;\n    title.resize(280, 20);\n\n    const rating = createRatingNode(ratingScore);\n\n    const priceRow = figma.createFrame();\n    priceRow.name = \"Price Row\";\n    priceRow.fills = [];\n    priceRow.layoutMode = \"HORIZONTAL\";\n    priceRow.counterAxisAlignItems = \"CENTER\";\n    priceRow.itemSpacing = 10;\n\n    const pText = figma.createText();\n    pText.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n    pText.fontSize = 18;\n    pText.characters = `$${price}`;\n\n    priceRow.appendChild(pText);\n\n    if (oldPrice) {\n      const opText = figma.createText();\n      opText.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n      opText.fontSize = 16;\n      opText.characters = `$${oldPrice}`;\n      opText.fills = [{ type: 'SOLID', color: C.grayText }];\n      opText.textDecoration = \"STRIKETHROUGH\";\n      priceRow.appendChild(opText);\n    }\n\n    if (discount) {\n      const discTag = figma.createFrame();\n      discTag.name = \"Discount Tag\";\n      discTag.fills = [{ type: 'SOLID', color: C.discountBg }];\n      discTag.cornerRadius = 62;\n      discTag.layoutMode = \"HORIZONTAL\";\n      discTag.paddingLeft = 8;\n      discTag.paddingRight = 8;\n      discTag.paddingTop = 4;\n      discTag.paddingBottom = 4;\n\n      const dt = figma.createText();\n      dt.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n      dt.fontSize = 12;\n      dt.characters = discount;\n      dt.fills = [{ type: 'SOLID', color: C.discountText }];\n\n      discTag.appendChild(dt);\n      priceRow.appendChild(discTag);\n    }\n\n    card.appendChild(imgWrapper);\n    card.appendChild(title);\n    card.appendChild(rating);\n    card.appendChild(priceRow);\n\n    return card;\n  }\n\n  // 1. FRAME 01_Home CREATION\n  const frameHome = figma.createFrame();\n  frameHome.name = \"01_Home\";\n  frameHome.resize(1440, 2500);\n  frameHome.fills = [{ type: 'SOLID', color: C.white }];\n  \n  // Layout constraints: VERTICAL Auto-Layout frame\n  frameHome.layoutMode = \"VERTICAL\";\n  frameHome.itemSpacing = 0;\n\n  // Add Announcement Bar and Header\n  frameHome.appendChild(createAnnouncementBar());\n  frameHome.appendChild(createHeader(\"None\"));\n\n  // HERO SECTION\n  const hero = figma.createFrame();\n  hero.name = \"Hero Section\";\n  hero.resize(1440, 663);\n  hero.fills = [{ type: 'SOLID', color: { r: 0.95, g: 0.95, b: 0.95 } }];\n  hero.layoutMode = \"HORIZONTAL\";\n  hero.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  hero.paddingLeft = 100;\n  hero.paddingRight = 100;\n  hero.paddingTop = 60;\n  hero.paddingBottom = 0;\n\n  // Left side of hero\n  const heroLeft = figma.createFrame();\n  heroLeft.name = \"Hero Info\";\n  heroLeft.resize(600, 550);\n  heroLeft.fills = [];\n  heroLeft.layoutMode = \"VERTICAL\";\n  heroLeft.itemSpacing = 30;\n\n  const heroTitle = figma.createText();\n  heroTitle.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n  heroTitle.fontSize = 56;\n  heroTitle.characters = \"FIND CLOTHES\\nTHAT MATCH\\nYOUR STYLE\";\n  heroTitle.resize(600, 200);\n\n  const heroCopy = figma.createText();\n  heroCopy.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n  heroCopy.fontSize = 16;\n  heroCopy.characters = \"Browse through our diverse range of meticulously crafted garments, designed to bring out your individuality and cater to your sense of style.\";\n  heroCopy.fills = [{ type: 'SOLID', color: C.grayText }];\n  heroCopy.resize(550, 60);\n\n  // Shop Now Button\n  const shopNowBtn = figma.createFrame();\n  shopNowBtn.name = \"Button_ShopNow_Trigger\";\n  shopNowBtn.resize(210, 52);\n  shopNowBtn.cornerRadius = 62;\n  shopNowBtn.fills = [{ type: 'SOLID', color: C.black }];\n  shopNowBtn.layoutMode = \"HORIZONTAL\";\n  shopNowBtn.primaryAxisAlignItems = \"CENTER\";\n  shopNowBtn.counterAxisAlignItems = \"CENTER\";\n\n  const shopNowText = figma.createText();\n  shopNowText.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n  shopNowText.fontSize = 16;\n  shopNowText.characters = \"Shop Now\";\n  shopNowText.fills = [{ type: 'SOLID', color: C.white }];\n  shopNowBtn.appendChild(shopNowText);\n\n  // Stats\n  const statsRow = figma.createFrame();\n  statsRow.name = \"Stats Row\";\n  statsRow.fills = [];\n  statsRow.layoutMode = \"HORIZONTAL\";\n  statsRow.itemSpacing = 32;\n\n  function createStat(val, desc) {\n    const col = figma.createFrame();\n    col.name = \"Stat Column\";\n    col.fills = [];\n    col.layoutMode = \"VERTICAL\";\n    col.itemSpacing = 4;\n\n    const vText = figma.createText();\n    vText.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n    vText.fontSize = 40;\n    vText.characters = val;\n\n    const dText = figma.createText();\n    dText.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    dText.fontSize = 15;\n    dText.characters = desc;\n    dText.fills = [{ type: 'SOLID', color: C.grayText }];\n\n    col.appendChild(vText);\n    col.appendChild(dText);\n    return col;\n  }\n\n  statsRow.appendChild(createStat(\"200+\", \"International Brands\"));\n  statsRow.appendChild(createStat(\"2,000+\", \"High-Quality Products\"));\n  statsRow.appendChild(createStat(\"30,000+\", \"Happy Customers\"));\n\n  heroLeft.appendChild(heroTitle);\n  heroLeft.appendChild(heroCopy);\n  heroLeft.appendChild(shopNowBtn);\n  heroLeft.appendChild(statsRow);\n\n  // Right side of hero (contains Photo_Hero and sparkles)\n  const heroRight = figma.createFrame();\n  heroRight.name = \"Hero Image Container\";\n  heroRight.resize(550, 603);\n  heroRight.fills = [];\n\n  const heroPhoto = getInstance(\"Photo_Hero\", 500, 600);\n  heroPhoto.x = 25;\n  heroPhoto.y = 3;\n\n  // Add 2 Sparkles\n  const sparkle1 = getInstance(\"Icon_Sparkle\", 56, 56);\n  sparkle1.x = 480;\n  sparkle1.y = 80;\n  \n  const sparkle2 = getInstance(\"Icon_Sparkle\", 40, 40);\n  sparkle2.x = 10;\n  sparkle2.y = 280;\n\n  heroRight.appendChild(heroPhoto);\n  heroRight.appendChild(sparkle1);\n  heroRight.appendChild(sparkle2);\n\n  hero.appendChild(heroLeft);\n  hero.appendChild(heroRight);\n  frameHome.appendChild(hero);\n\n  // BRANDS STRIP\n  const brandsStrip = figma.createFrame();\n  brandsStrip.name = \"Brands Strip\";\n  brandsStrip.resize(1440, 122);\n  brandsStrip.fills = [{ type: 'SOLID', color: C.black }];\n  brandsStrip.layoutMode = \"HORIZONTAL\";\n  brandsStrip.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  brandsStrip.counterAxisAlignItems = \"CENTER\";\n  brandsStrip.paddingLeft = 100;\n  brandsStrip.paddingRight = 100;\n\n  const brands = [\"NORDE\", \"ATELIER K\", \"MONVALE\", \"RIVA\", \"CASSEL\"];\n  for (const b of brands) {\n    const bt = figma.createText();\n    bt.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n    bt.fontSize = 32;\n    bt.characters = b;\n    bt.fills = [{ type: 'SOLID', color: C.white }];\n    brandsStrip.appendChild(bt);\n  }\n  frameHome.appendChild(brandsStrip);\n\n  // NEW ARRIVALS\n  const arrivals = figma.createFrame();\n  arrivals.name = \"New Arrivals Section\";\n  arrivals.resize(1440, 600);\n  arrivals.fills = [];\n  arrivals.layoutMode = \"VERTICAL\";\n  arrivals.primaryAxisAlignItems = \"CENTER\";\n  arrivals.counterAxisAlignItems = \"CENTER\";\n  arrivals.itemSpacing = 32;\n  arrivals.paddingTop = 60;\n  arrivals.paddingBottom = 40;\n\n  const arrivalsTitle = figma.createText();\n  arrivalsTitle.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n  arrivalsTitle.fontSize = 40;\n  arrivalsTitle.characters = \"NEW ARRIVALS\";\n\n  const arrivalsGrid = figma.createFrame();\n  arrivalsGrid.name = \"Arrivals Grid\";\n  arrivalsGrid.fills = [];\n  arrivalsGrid.layoutMode = \"HORIZONTAL\";\n  arrivalsGrid.itemSpacing = 20;\n\n  // New Arrivals cards data\n  arrivalsGrid.appendChild(createProductCard(\"Photo_TShirt_Tape_Details\", \"T-shirt with Tape Details\", 4.5, 120));\n  arrivalsGrid.appendChild(createProductCard(\"Photo_Skinny_Fit_Jeans\", \"Skinny Fit Jeans\", 3.5, 240, 260, \"-20%\"));\n  arrivalsGrid.appendChild(createProductCard(\"Photo_Checkered_Shirt\", \"Checkered Shirt\", 4.5, 180));\n  arrivalsGrid.appendChild(createProductCard(\"Photo_Sleeve_Striped_TShirt\", \"Sleeve Striped T-shirt\", 4.5, 130, 160, \"-30%\"));\n\n  // View All Button\n  const viewAllBtn1 = figma.createFrame();\n  viewAllBtn1.name = \"Button_ViewAll1_Trigger\";\n  viewAllBtn1.resize(180, 52);\n  viewAllBtn1.cornerRadius = 62;\n  viewAllBtn1.strokeWeight = 1;\n  viewAllBtn1.strokes = [{ type: 'SOLID', color: C.grayBorder }];\n  viewAllBtn1.fills = [];\n  viewAllBtn1.layoutMode = \"HORIZONTAL\";\n  viewAllBtn1.primaryAxisAlignItems = \"CENTER\";\n  viewAllBtn1.counterAxisAlignItems = \"CENTER\";\n\n  const vat1 = figma.createText();\n  vat1.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n  vat1.fontSize = 16;\n  vat1.characters = \"View All\";\n  vat1.fills = [{ type: 'SOLID', color: C.black }];\n  viewAllBtn1.appendChild(vat1);\n\n  arrivals.appendChild(arrivalsTitle);\n  arrivals.appendChild(arrivalsGrid);\n  arrivals.appendChild(viewAllBtn1);\n  frameHome.appendChild(arrivals);\n\n  // DIVIDER line\n  const divLine1 = figma.createFrame();\n  divLine1.name = \"Divider Line\";\n  divLine1.resize(1440, 1);\n  divLine1.fills = [{ type: 'SOLID', color: C.grayBorder }];\n  frameHome.appendChild(divLine1);\n\n  // TOP SELLING\n  const topSelling = figma.createFrame();\n  topSelling.name = \"Top Selling Section\";\n  topSelling.resize(1440, 600);\n  topSelling.fills = [];\n  topSelling.layoutMode = \"VERTICAL\";\n  topSelling.primaryAxisAlignItems = \"CENTER\";\n  topSelling.counterAxisAlignItems = \"CENTER\";\n  topSelling.itemSpacing = 32;\n  topSelling.paddingTop = 60;\n  topSelling.paddingBottom = 40;\n\n  const sellingTitle = figma.createText();\n  sellingTitle.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n  sellingTitle.fontSize = 40;\n  sellingTitle.characters = \"TOP SELLING\";\n\n  const sellingGrid = figma.createFrame();\n  sellingGrid.name = \"Selling Grid\";\n  sellingGrid.fills = [];\n  sellingGrid.layoutMode = \"HORIZONTAL\";\n  sellingGrid.itemSpacing = 20;\n\n  sellingGrid.appendChild(createProductCard(\"Photo_Vertical_Striped_Shirt\", \"Vertical Striped Shirt\", 5.0, 212, 232, \"-20%\"));\n  sellingGrid.appendChild(createProductCard(\"Photo_Courage_Graphic_TShirt\", \"Courage Graphic T-shirt\", 4.0, 145));\n  sellingGrid.appendChild(createProductCard(\"Photo_Loose_Fit_Bermuda_Shorts\", \"Loose Fit Bermuda Shorts\", 3.0, 80));\n  sellingGrid.appendChild(createProductCard(\"Photo_Faded_Skinny_Jeans\", \"Faded Skinny Jeans\", 4.5, 210));\n\n  const viewAllBtn2 = figma.createFrame();\n  viewAllBtn2.name = \"Button_ViewAll2_Trigger\";\n  viewAllBtn2.resize(180, 52);\n  viewAllBtn2.cornerRadius = 62;\n  viewAllBtn2.strokeWeight = 1;\n  viewAllBtn2.strokes = [{ type: 'SOLID', color: C.grayBorder }];\n  viewAllBtn2.fills = [];\n  viewAllBtn2.layoutMode = \"HORIZONTAL\";\n  viewAllBtn2.primaryAxisAlignItems = \"CENTER\";\n  viewAllBtn2.counterAxisAlignItems = \"CENTER\";\n\n  const vat2 = figma.createText();\n  vat2.fontName = { family: \"Plus Jakarta Sans\", style: \"Medium\" };\n  vat2.fontSize = 16;\n  vat2.characters = \"View All\";\n  vat2.fills = [{ type: 'SOLID', color: C.black }];\n  viewAllBtn2.appendChild(vat2);\n\n  topSelling.appendChild(sellingTitle);\n  topSelling.appendChild(sellingGrid);\n  topSelling.appendChild(viewAllBtn2);\n  frameHome.appendChild(topSelling);\n\n  // BROWSE BY DRESS STYLE\n  const dressStyle = figma.createFrame();\n  dressStyle.name = \"Dress Style Section\";\n  dressStyle.resize(1440, 866);\n  dressStyle.fills = [];\n  dressStyle.layoutMode = \"VERTICAL\";\n  dressStyle.primaryAxisAlignItems = \"CENTER\";\n  dressStyle.counterAxisAlignItems = \"CENTER\";\n  dressStyle.paddingLeft = 100;\n  dressStyle.paddingRight = 100;\n\n  const styleBox = figma.createFrame();\n  styleBox.name = \"Style Box\";\n  styleBox.resize(1240, 800);\n  styleBox.cornerRadius = 40;\n  styleBox.fills = [{ type: 'SOLID', color: { r: 0.95, g: 0.95, b: 0.95 } }];\n  styleBox.layoutMode = \"VERTICAL\";\n  styleBox.primaryAxisAlignItems = \"CENTER\";\n  styleBox.counterAxisAlignItems = \"CENTER\";\n  styleBox.itemSpacing = 20;\n\n  const styleTitle = figma.createText();\n  styleTitle.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n  styleTitle.fontSize = 40;\n  styleTitle.characters = \"BROWSE BY DRESS STYLE\";\n\n  const row1 = figma.createFrame();\n  row1.name = \"Style Row 1\";\n  row1.fills = [];\n  row1.layoutMode = \"HORIZONTAL\";\n  row1.itemSpacing = 20;\n\n  // Casual tile (30% wide or 400x289)\n  const casualTile = figma.createFrame();\n  casualTile.name = \"Casual Tile_Trigger\";\n  casualTile.resize(400, 289);\n  casualTile.cornerRadius = 20;\n  casualTile.fills = [{ type: 'SOLID', color: C.white }];\n  \n  const casualPhoto = getInstance(\"Photo_Style_Casual\", 400, 289);\n  const ct = figma.createText();\n  ct.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n  ct.fontSize = 32;\n  ct.characters = \"Casual\";\n  ct.x = 36;\n  ct.y = 28;\n  casualTile.appendChild(casualPhoto);\n  casualTile.appendChild(ct);\n\n  // Formal tile (70% wide or 680x289)\n  const formalTile = figma.createFrame();\n  formalTile.name = \"Formal Tile\";\n  formalTile.resize(680, 289);\n  formalTile.cornerRadius = 20;\n  formalTile.fills = [{ type: 'SOLID', color: C.white }];\n\n  const formalPhoto = getInstance(\"Photo_Style_Formal\", 680, 289);\n  const ft = figma.createText();\n  ft.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n  ft.fontSize = 32;\n  ft.characters = \"Formal\";\n  ft.x = 36;\n  ft.y = 28;\n  formalTile.appendChild(formalPhoto);\n  formalTile.appendChild(ft);\n\n  row1.appendChild(casualTile);\n  row1.appendChild(formalTile);\n\n  const row2 = figma.createFrame();\n  row2.name = \"Style Row 2\";\n  row2.fills = [];\n  row2.layoutMode = \"HORIZONTAL\";\n  row2.itemSpacing = 20;\n\n  // Party tile (70% wide or 680x289)\n  const partyTile = figma.createFrame();\n  partyTile.name = \"Party Tile\";\n  partyTile.resize(680, 289);\n  partyTile.cornerRadius = 20;\n  partyTile.fills = [{ type: 'SOLID', color: C.white }];\n\n  const partyPhoto = getInstance(\"Photo_Style_Party\", 680, 289);\n  const pt = figma.createText();\n  pt.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n  pt.fontSize = 32;\n  pt.characters = \"Party\";\n  pt.x = 36;\n  pt.y = 28;\n  partyTile.appendChild(partyPhoto);\n  partyTile.appendChild(pt);\n\n  // Gym tile (30% wide or 400x289)\n  const gymTile = figma.createFrame();\n  gymTile.name = \"Gym Tile\";\n  gymTile.resize(400, 289);\n  gymTile.cornerRadius = 20;\n  gymTile.fills = [{ type: 'SOLID', color: C.white }];\n\n  const gymPhoto = getInstance(\"Photo_Style_Gym\", 400, 289);\n  const gt = figma.createText();\n  gt.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n  gt.fontSize = 32;\n  gt.characters = \"Gym\";\n  gt.x = 36;\n  gt.y = 28;\n  gymTile.appendChild(gymPhoto);\n  gymTile.appendChild(gt);\n\n  row2.appendChild(partyTile);\n  row2.appendChild(gymTile);\n\n  styleBox.appendChild(styleTitle);\n  styleBox.appendChild(row1);\n  styleBox.appendChild(row2);\n  dressStyle.appendChild(styleBox);\n  frameHome.appendChild(dressStyle);\n\n  // CUSTOMER REVIEWS SECTION\n  const reviews = figma.createFrame();\n  reviews.name = \"Customer Reviews Section\";\n  reviews.resize(1440, 360);\n  reviews.fills = [];\n  reviews.layoutMode = \"VERTICAL\";\n  reviews.primaryAxisAlignItems = \"CENTER\";\n  reviews.paddingLeft = 100;\n  reviews.paddingRight = 100;\n  reviews.itemSpacing = 40;\n\n  const reviewsTop = figma.createFrame();\n  reviewsTop.name = \"Reviews Top\";\n  reviewsTop.resize(1240, 60);\n  reviewsTop.fills = [];\n  reviewsTop.layoutMode = \"HORIZONTAL\";\n  reviewsTop.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  reviewsTop.counterAxisAlignItems = \"CENTER\";\n\n  const rtTitle = figma.createText();\n  rtTitle.fontName = { family: \"Archivo Black\", style: \"Regular\" };\n  rtTitle.fontSize = 40;\n  rtTitle.characters = \"OUR HAPPY CUSTOMERS\";\n\n  const arrowRow = figma.createFrame();\n  arrowRow.name = \"Arrow Row\";\n  arrowRow.fills = [];\n  arrowRow.layoutMode = \"HORIZONTAL\";\n  arrowRow.itemSpacing = 16;\n\n  arrowRow.appendChild(getInstance(\"Icon_Arrow_Left\", 24, 24));\n  arrowRow.appendChild(getInstance(\"Icon_Arrow_Right\", 24, 24));\n\n  reviewsTop.appendChild(rtTitle);\n  reviewsTop.appendChild(arrowRow);\n\n  const reviewGrid = figma.createFrame();\n  reviewGrid.name = \"Review Cards Grid\";\n  reviewGrid.fills = [];\n  reviewGrid.layoutMode = \"HORIZONTAL\";\n  reviewGrid.itemSpacing = 20;\n\n  // Review card helper\n  function createReviewCard(name, quote) {\n    const card = figma.createFrame();\n    card.name = \"Review Card\";\n    card.resize(400, 240);\n    card.cornerRadius = 20;\n    card.strokeWeight = 1;\n    card.strokes = [{ type: 'SOLID', color: C.grayBorder }];\n    card.fills = [{ type: 'SOLID', color: C.white }];\n    card.layoutMode = \"VERTICAL\";\n    card.itemSpacing = 12;\n    card.paddingLeft = 32;\n    card.paddingRight = 32;\n    card.paddingTop = 28;\n    card.paddingBottom = 28;\n\n    // Stars row\n    const stars = figma.createFrame();\n    stars.name = \"Stars Row\";\n    stars.fills = [];\n    stars.layoutMode = \"HORIZONTAL\";\n    stars.itemSpacing = 6;\n    for (let i = 0; i < 5; i++) {\n      stars.appendChild(getInstance(\"Icon_Star\", 20, 20));\n    }\n\n    // Name row with Verified\n    const nameRow = figma.createFrame();\n    nameRow.name = \"Name Row\";\n    nameRow.fills = [];\n    nameRow.layoutMode = \"HORIZONTAL\";\n    nameRow.counterAxisAlignItems = \"CENTER\";\n    nameRow.itemSpacing = 6;\n\n    const nt = figma.createText();\n    nt.fontName = { family: \"Plus Jakarta Sans\", style: \"Bold\" };\n    nt.fontSize = 18;\n    nt.characters = name;\n\n    const vMark = getInstance(\"Icon_Verified\", 16, 16);\n\n    nameRow.appendChild(nt);\n    nameRow.appendChild(vMark);\n\n    // Quote\n    const qt = figma.createText();\n    qt.fontName = { family: \"Plus Jakarta Sans\", style: \"Regular\" };\n    qt.fontSize = 14;\n    qt.characters = quote;\n    qt.fills = [{ type: 'SOLID', color: C.grayText }];\n    qt.resize(336, 100);\n\n    card.appendChild(stars);\n    card.appendChild(nameRow);\n    card.appendChild(qt);\n\n    return card;\n  }\n\n  reviewGrid.appendChild(createReviewCard(\"Sarah M.\", \"“I’m blown away by the quality and style of the clothes I received from Shop.co. From casual wear to elegant dresses, every piece I’ve bought has exceeded my expectations.”\"));\n  reviewGrid.appendChild(createReviewCard(\"Alex K.\", \"“Finding clothes that align with my personal style used to be a challenge until I discovered Shop.co. The range of options they offer is truly remarkable, catering to a variety of tastes and occasions.”\"));\n  reviewGrid.appendChild(createReviewCard(\"James L.\", \"“As someone who’s always on the lookout for unique fashion pieces, I’m thrilled to have stumbled upon Shop.co. The selection of clothes is not only diverse but also on-point with the latest trends.”\"));\n\n  reviews.appendChild(reviewsTop);\n  reviews.appendChild(reviewGrid);\n  frameHome.appendChild(reviews);\n\n  // NEWSLETTER & FOOTER (newsletter sits overlapping or stacked above the footer)\n  const footerArea = figma.createFrame();\n  footerArea.name = \"Footer Area\";\n  footerArea.resize(1440, 520);\n  footerArea.fills = [];\n  footerArea.layoutMode = \"VERTICAL\";\n  footerArea.itemSpacing = -100; // Overlap newsletter slightly above footer\n\n  footerArea.appendChild(createNewsletter());\n  footerArea.appendChild(createFooter());\n  \n  frameHome.appendChild(footerArea);\n\n  // Auto-resize height to content\n  frameHome.resize(1440, 4800); // Fixed size to be safe or keep auto layout height\n\n  wsPage.appendChild(frameHome);\n  return `01_Home frame successfully created!`;\n})()","description":"Build the complete \"01_Home\" desktop frame containing all required elements, layout sections, stats, cards, brand strip, custom ratings, and product assets.","fileKey":"E9n8kgrlAPnHZ6rsWuAsab"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":36453,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"bcf2aede-586f-4d33-b1b0-5af74b634ee8","uuid":"831cabb9-a7d9-454c-87f9-92ed602b6173","timestamp":"2026-11-01T19:56:08.087Z","tool_use_meta":[{"id":"call_3012d72c5c1d4a73b17bd73d4739f99b","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
