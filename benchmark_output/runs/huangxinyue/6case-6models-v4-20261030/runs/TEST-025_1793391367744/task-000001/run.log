s y=170/235/300 (3rd \"Confirm Password\"), legal 12 (29,382) w317, \"Create Account\"=2:24 (29,440) fontSize 18, divider y=530, socials y=562, linkRow \"I Already Have an Account\"+\"Login\" y=660. 07_Forgot_Password 14:200 (x=2950): back 4:60 (20,64), title 24 centered y=160, info 12 centered (48,208) w280, email (29,280), \"Submit\" (29,360). 08_Get_Started 14:222 (x=3425): title 28 (20,90), sub 14 (20,134), photo 3:68 288×360 (44,190), \"Get Started\"=2:24 (29,690) 18. 09_Home 16:187 (x=100, y=200, 375×1780): status(0,0), header 8:52 (20,52), search 8:61 (20,108), Banner 335×140 r12 (20,172) [3:110 fill + 30% black overlay + \"40–50% OFF\" 22 Bold white (16,28) + \"Now in all products\" 12 (16,62) + \"All colours\" 10 @85% (16,82) + Shop Now pill 78×26 r13 white (16,100) w/ 10 SemiBold #F83758 + 3 dots y=124 (slide2 active: 16×6 at x=153, others 6×6 @50%)]; 6 categories 55×55 r27.5 x=20+i*64 y=332 + labels 11 y=394; \"Deal of the Day\" section (20,428)+\"View all\", \"22h 55m 20s remaining\" 11 (20,456), Deal Row clip 335×200 (20,478): 4 mini cards w=90 x=i*96 [3:116,3:119,Philips grayed+search icon 32 on row at (i*96+29,29),3:122]; \"All Featured\" (20,694), chips Sort (20,724)/Filter (100,724); \"Special Offers 😱\" 18 (20,772); 3:101 162×120 (20,802), 3:104 162×120 (193,802), 3:107 335×120 (20,938); \"New Arrivals\"+\"View all\" (20,1074), 3:98 335×120 (20,1104), \"Summer' 25 Collections\" 14 white (36,1192); \"Sponsored\"+\"up to 50% Off\" (20,1240), 3:182 335×120 (20,1270); \"Trending Products\"+\"View all\" (20,1406), \"Last Date 28/02/22\" (20,1434), Trending Row clip 335×200 (20,1456): 5 minis w=72 x=i*76 [3:125,3:128,Mammon grayed+icon 28 (i*76+22,22),3:131,3:134]; nav \"Active=Home\" (0,1696)\n   - **Helper pattern (re-declare EVERY call)**:\n```js\nconst page = await figma.getNodeByIdAsync(\"5:2\");\nawait figma.setCurrentPageAsync(page);\nfor (const s of [\"Regular\",\"Medium\",\"SemiBold\",\"Bold\"]) await figma.loadFontAsync({family:\"Montserrat\",style:s});\nasync function M(id){return await figma.getNodeByIdAsync(id);}\nfunction hex(h){const n=parseInt(h.slice(1),16);return{r:((n>>16)&255)/255,g:((n>>8)&255)/255,b:(n&255)/255};}\nfunction solid(h,o){return{type:\"SOLID\",color:hex(h),opacity:o===undefined?1:o};}\nfunction T(chars,size,style,color){const t=figma.createText();t.fontName={family:\"Montserrat\",style};t.characters=chars;t.fontSize=size;t.fills=[solid(color)];return t;}\nfunction R(w,h,r,fill){const rc=figma.createRectangle();rc.resize(w,h);rc.cornerRadius=r;rc.fills=[solid(fill)];return rc;}\nfunction FR(name,w,h,fill,clip){const f=figma.createFrame();f.name=name;f.resize(w,h);f.fills=fill?[solid(fill)]:[];f.clipsContent=!!clip;return f;}\nfunction tint(node,color){const s=[solid(color)];for(const d of node.findAll(()=>true)){if(\"fills\" in d){try{d.fills=s;}catch(e){}}}if(\"fills\" in node){try{node.fills=s;}catch(e){}}}\nfunction setT(inst,chars,size){const ts=inst.findAll(n=>n.type===\"TEXT\");if(ts[0]){ts[0].characters=chars;if(size)ts[0].fontSize=size;}}\n// no-photo gray fallback (override nested IMAGE fill; icon goes on PARENT frame, never inside instance):\nfunction grayOut(card){const inner=card.findOne(n=>n.type===\"INSTANCE\");if(!inner)return;const cands=[inner,...inner.findAll(x=>true)];for(const cd of cands){if(\"fills\" in cd&&Array.isArray(cd.fills)&&cd.fills.length&&cd.fills[0].type===\"IMAGE\"){cd.fills=[solid(\"#F0F0F0\")];break;}}}\n```\n   - **VERBATIM FIXED DATA (from 0:1, required word-for-word)**:\n     - Deal of the Day: \"Women Printed Kurta · ₹1,500 · was ₹2,499 · 40% Off · 56,890 ratings\" · \"HRX by Hrithik Roshan · ₹2,499 · was ₹4,999 · 50% Off · 3,44,567 ratings\" · \"Philips BHH880/10 · 'Hair Straightening Brush With Keratin Infused Bristles (Black).' · ₹999 · was ₹1,999 · 50% Off · 6,46,776 ratings · no photo supplied\" · \"TITAN Men Watch- 1806N · 'This Titan watch in Black color is I wanted to buy for a long time' · ₹1,500 · was ₹3,500 · 57% Off · 15,007 ratin