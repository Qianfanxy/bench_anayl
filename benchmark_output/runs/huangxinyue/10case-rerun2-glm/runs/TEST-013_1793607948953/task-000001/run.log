{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_377bada5092147118cafcd39","name":"mcp__figma__use_figma","input":{"code":"const page = await figma.getNodeByIdAsync('4:2');\nawait figma.setCurrentPageAsync(page);\nfor (const s of ['Regular','Medium','SemiBold','Bold']) await figma.loadFontAsync({family:'DM Sans',style:s});\nconst C={brand:'#6347EB',surface:'#FFFFFF',ink:'#1A1A1F',ink2:'#63636E',ink3:'#9C9CA6',line:'#ECECF1',good:'#12A66B',goodTint:'#E1F5EC',warn:'#DD8500',warnTint:'#FBF0DC',tile:'#F4F4F8'};\nfunction hex(h){const n=parseInt(h.slice(1),16);return{r:(n>>16&255)/255,g:(n>>8&255)/255,b:(n&255)/255};}\nfunction solid(h,o){return{type:'SOLID',color:hex(h),opacity:o===undefined?1:o};}\nfunction txt(chars,size,style,color,o){o=o||{};const t=figma.createText();t.fontName={family:'DM Sans',style:style};t.characters=chars;t.fontSize=size;t.fills=[solid(color,o.op)];if(o.ls!==undefined)t.letterSpacing={unit:'PIXELS',value:o.ls};if(o.name)t.name=o.name;if(o.w!==undefined){t.textAutoResize='HEIGHT';t.resize(o.w,t.height);t.textAlignHorizontal='CENTER';}return t;}\nfunction stack(dir,gap,o){o=o||{};const f=figma.createFrame();f.layoutMode=dir;f.itemSpacing=gap;f.fills=[];f.primaryAxisSizingMode=o.hugP?'AUTO':'FIXED';f.counterAxisSizingMode=o.hugC?'AUTO':'FIXED';f.counterAxisAlignItems=o.align||'MIN';f.primaryAxisAlignItems=o.dist||'MIN';if(o.radius)f.cornerRadius=o.radius;if(o.fill)f.fills=[o.fill];if(o.pad!==undefined){f.paddingTop=o.pad;f.paddingBottom=o.pad;f.paddingLeft=o.pad;f.paddingRight=o.pad;}if(o.pv!==undefined){f.paddingTop=o.pv;f.paddingBottom=o.pv;}if(o.ph!==undefined){f.paddingLeft=o.ph;f.paddingRight=o.ph;}return f;}\nfunction recolor(node,color){const vs=node.findAll(function(n){return n.type==='VECTOR';});for(const v of vs){if(v.strokes&&v.strokes.length)v.strokes=[solid(color)];}}\nconst shadow={type:'DROP_SHADOW',color:{r:0.07,g:0.07,b:0.12,a:0.05},offset:{x:0,y:4},radius:14,spread:0,visible:true,blendMode:'NORMAL'};\n\n// ---- Subscription Row ----\nconst sr=figma.createComponent();sr.name='Subscription Row';sr.x=1600;sr.y=1060;\nsr.layoutMode='HORIZONTAL';sr.itemSpacing=12;\nsr.paddingTop=12;sr.paddingBottom=12;sr.paddingLeft=12;sr.paddingRight=14;\nsr.primaryAxisSizingMode='FIXED';sr.counterAxisSizingMode='AUTO';sr.resize(343,68);\nsr.counterAxisAlignItems='CENTER';\nsr.fills=[solid(C.surface)];sr.cornerRadius=14;sr.effects=[shadow];\nconst lt=stack('HORIZONTAL',0,{align:'CENTER',dist:'CENTER'});lt.name='LogoTile';lt.resize(44,44);lt.cornerRadius=12;lt.fills=[solid(C.tile)];\nconst pat=await figma.getNodeByIdAsync('2:15');\nconst lg=pat.createInstance();lg.name='Logo';lg.rescale(0.75);\nlt.appendChild(lg);sr.appendChild(lt);\nconst snm=txt('Patreon membership',14,'Medium',C.ink,{name:'Name'});snm.layoutGrow=1;\nsr.appendChild(snm);\nsr.appendChild(txt('$19.99/mo',13,'SemiBold',C.ink,{name:'Price'}));\nconst ICONS={ChevRight:'2:6'};\nconst chev=(await figma.getNodeByIdAsync(ICONS.ChevRight)).createInstance();chev.name='Icon_ChevRight';recolor(chev,C.ink3);chev.rescale(18/24);\nsr.appendChild(chev);\n\n// ---- Subscription Summary Card ----\nconst sc=figma.createComponent();sc.name='Subscription Summary Card';sc.x=1600;sc.y=1180;\nsc.layoutMode='VERTICAL';sc.itemSpacing=6;\nsc.paddingTop=18;sc.paddingBottom=18;sc.paddingLeft=18;sc.paddingRight=18;\nsc.primaryAxisSizingMode='AUTO';sc.counterAxisSizingMode='FIXED';sc.resize(343,100);\nsc.fills=[solid(C.brand)];sc.cornerRadius=16;sc.effects=[shadow];\nsc.appendChild(txt('Your monthly payment for subscriptions',13,'Medium','#FFFFFF',{op:0.85}));\nsc.appendChild(txt('$58.97',32,'Bold','#FFFFFF'));\n\n// ---- Factor Row ----\nconst fr=figma.createComponent();fr.name='Factor Row';fr.x=1600;fr.y=1330;\nfr.layoutMode='HORIZONTAL';fr.itemSpacing=8;\nfr.paddingTop=14;fr.paddingBottom=14;fr.paddingLeft=16;fr.paddingRight=16;\nfr.primaryAxisSizingMode='FIXED';fr.counterAxisSizingMode='AUTO';fr.resize(343,64);\nfr.primaryAxisAlignItems='SPACE_BETWEEN';fr.counterAxisAlignItems='CENTER';\nfr.fills=[solid(C.surface)];fr.cornerRadius=14;fr.effects=[shadow];\nconst fl=stack('VERTICAL',3,{hugP:true,hugC:true});\nfl.appendChild(txt('On-time payments',14,'Medium',C.ink,{name:'Name'}));\nfl.appendChild(txt('1 missed',12,'Regular',C.ink2,{name:'Detail'}));\nfr.appendChild(fl);\nconst rv=stack('HORIZONTAL',10,{hugP:true,hugC:true,align:'CENTER'});\nrv.appendChild(txt('95%',15,'Bold',C.ink,{name:'Value'}));\nconst chip=stack('HORIZONTAL',0,{hugP:true,hugC:true,align:'CENTER'});chip.name='Chip';\nchip.paddingTop=4;chip.paddingBottom=4;chip.paddingLeft=10;chip.paddingRight=10;chip.cornerRadius=999;chip.fills=[solid(C.goodTint)];\nchip.appendChild(txt('Good',12,'SemiBold',C.good,{name:'Rating'}));\nrv.appendChild(chip);\nfr.appendChild(rv);\n\n// ---- Credit Gauge Card ----\nconst gc=figma.createComponent();gc.name='Credit Gauge Card';gc.x=1600;gc.y=1450;\ngc.layoutMode='VERTICAL';gc.itemSpacing=12;\ngc.paddingTop=20;gc.paddingBottom=20;gc.paddingLeft=20;gc.paddingRight=20;\ngc.primaryAxisSizingMode='AUTO';gc.counterAxisSizingMode='FIXED';gc.resize(343,100);\ngc.counterAxisAlignItems='CENTER';\ngc.fills=[solid(C.surface)];gc.cornerRadius=16;gc.effects=[shadow];\nconst gg=figma.createFrame();gg.name='Gauge';gg.resize(200,104);gg.clipsContent=true;gg.fills=[];\nconst et=figma.createEllipse();et.name='GaugeTrack';et.resize(200,200);et.x=0;et.y=0;\net.arcData={startingAngle:Math.PI,endingAngle:2*Math.PI,innerRadius:0.82};et.fills=[solid(C.line)];\nconst ef=figma.createEllipse();ef.name='GaugeFill';ef.resize(200,200);ef.x=0;ef.y=0;\nef.arcData={startingAngle:Math.PI,endingAngle:Math.PI+(260/450)*Math.PI,innerRadius:0.82};ef.fills=[solid(C.brand)];\ngg.appendChild(et);gg.appendChild(ef);\ngg.appendChild(txt('660',44,'Bold',C.ink,{w:200,name:'Score'}));\ngg.children[2].y=38;\ngc.appendChild(gg);\nconst ur=stack('HORIZONTAL',8,{hugC:true,align:'CENTER',dist:'SPACE_BETWEEN'});ur.name='RangeRow';\nur.primaryAxisSizingMode='FIXED';ur.resize(200,20);\nur.appendChild(txt('400',11,'Regular',C.ink3));\nconst mid=stack('HORIZONTAL',8,{hugP:true,hugC:true,align:'CENTER'});mid.name='Mid';\nconst gchip=stack('HORIZONTAL',0,{hugP:true,hugC:true,align:'CENTER'});gchip.name='Chip';\ngchip.paddingTop=4;gchip.paddingBottom=4;gchip.paddingLeft=10;gchip.paddingRight=10;gchip.cornerRadius=999;gchip.fills=[solid(C.goodTint)];\ngchip.appendChild(txt('Good',13,'SemiBold',C.good,{name:'Rating'}));\nmid.appendChild(gchip);\nmid.appendChild(txt('+6pts',13,'SemiBold',C.good,{name:'Delta'}));\nur.appendChild(mid);\nur.appendChild(txt('850',11,'Regular',C.ink3));\ngc.appendChild(ur);\ngc.appendChild(txt('Last update on 20 Jul 2020',12,'Regular',C.ink3,{name:'Updated'}));\nreturn {sr:sr.id,sc:sc.id,fr:fr.id,gc:gc.id,srH:sr.height,scH:sc.height,frH:fr.height,gcH:gc.height};","description":"Create Subscription Row, Subscription Summary Card, Factor Row, Credit Gauge Card components","fileKey":"Lpmrb2cZGL1jkibhtHwaxj"}}],"id":"04bd7827-a04b-4e91-a2b1-f1c3688b5ee7","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"88fa287b-e3f1-4759-ae42-7b214809a163","uuid":"357ac787-eeeb-4cfe-b84e-869c625b92d4","timestamp":"2026-11-02T08:49:03.809Z","tool_use_meta":[{"id":"call_377bada5092147118cafcd39","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
