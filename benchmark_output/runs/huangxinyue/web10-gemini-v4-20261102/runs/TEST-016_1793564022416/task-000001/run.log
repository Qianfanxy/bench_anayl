      tagFrame.paddingLeft = 8; tagFrame.paddingRight = 8;\n      tagFrame.paddingTop = 2; tagFrame.paddingBottom = 2;\n      tagFrame.cornerRadius = 4;\n      let tagBg = { r: 0.94, g: 0.94, b: 1 };\n      let tagFg = { r: 0.314, g: 0.318, b: 0.976 };\n      if (c.tag === \"Research\") {\n        tagBg = { r: 0.94, g: 0.98, b: 0.94 };\n        tagFg = { r: 0.2, g: 0.7, b: 0.3 };\n      } else if (c.tag === \"Planning\") {\n        tagBg = { r: 1, g: 0.96, b: 0.92 };\n        tagFg = { r: 0.9, g: 0.5, b: 0.1 };\n      }\n      tagFrame.fills = [{ type: 'SOLID', color: tagBg }];\n      const tagText = figma.createText();\n      tagText.characters = c.tag;\n      tagText.fontName = { family: \"DM Sans\", style: \"Bold\" };\n      tagText.fontSize = 10;\n      tagText.fills = [{ type: 'SOLID', color: tagFg }];\n      tagFrame.appendChild(tagText);\n      tagTitleGroup.appendChild(tagFrame);\n\n      const titleTxt = figma.createText();\n      titleTxt.characters = c.title;\n      titleTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n      titleTxt.fontSize = 13;\n      titleTxt.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n      tagTitleGroup.appendChild(titleTxt);\n      card.appendChild(tagTitleGroup);\n\n      // Date + avatars + metadata row\n      const botRow = figma.createFrame();\n      botRow.resize(200, 24);\n      botRow.layoutMode = \"HORIZONTAL\";\n      botRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n      botRow.counterAxisAlignItems = \"CENTER\";\n      botRow.fills = [];\n\n      // Date\n      const dateFrame = figma.createFrame();\n      dateFrame.layoutMode = \"HORIZONTAL\";\n      dateFrame.counterAxisAlignItems = \"CENTER\";\n      dateFrame.itemSpacing = 4;\n      dateFrame.fills = [];\n      dateFrame.appendChild(getAsset(\"Icon_Calendar\", 12));\n      const dateTxt = figma.createText();\n      dateTxt.characters = c.date;\n      dateTxt.fontName = { family: \"DM Sans\", style: \"Regular\" };\n      dateTxt.fontS