h=\"46\" height=\"15\" />\n          </frame>\n          <frame id=\"19:617\" name=\"Action\" x=\"84\" y=\"0\" width=\"56\" height=\"83\">\n            <instance id=\"19:618\" name=\"Action Button\" x=\"0\" y=\"0\" width=\"56\" height=\"56\" />\n            <text id=\"19:621\" name=\"Label\" x=\"2.5\" y=\"68\" width=\"51\" height=\"15\" />\n          </frame>\n        </frame>\n      </frame>\n      <text id=\"19:622\" name=\"Intro\" x=\"80\" y=\"282\" width=\"1280\" height=\"54\" />\n    </frame>\n    <frame id=\"19:623\" name=\"Video\" x=\"0\" y=\"459\" width=\"1440\" height=\"648\">\n      <frame id=\"19:624\" name=\"Cover\" x=\"80\" y=\"8\" width=\"1280\" height=\"600\">\n        <instance id=\"19:625\" name=\"Photo\" x=\"0\" y=\"0\" width=\"1280\" height=\"600\" />\n        <instance id=\"19:626\" name=\"Play Button\" x=\"604\" y=\"264\" width=\"72\" height=\"72\" />\n      </frame>\n    </frame>\n    <frame id=\"19:717\" name=\"Ingredients &amp; Nutrition\" x=\"0\" y=\"1107\" width=\"1440\" height=\"667\">\n      <frame id=\"19:718\" name=\"Ingredients\" x=\"80\" y=\"16\" width=\"820\" height=\"603\">\n        <text id=\"19:719\" name=\"Ingredients\" x=\"0\" y=\"0\" width=\"179\" height=\"39\" />\n        <frame id=\"19:720\" name=\"Group\" x=\"0\" y=\"63\" width=\"700\" height=\"317\">\n          <text id=\"19:721\" name=\"Group Title\" x=\"0\" y=\"0\" width=\"116\" height=\"22\" />\n          <instance id=\"19:722\" name=\"Ingredient Item / Checked\" x=\"0\" y=\"30\" width=\"700\" height=\"51\" />\n          <instance id=\"19:728\" name=\"Ingredient Item / Unchecked\" x=\"0\" y=\"89\" width=\"700\" height=\"51\" />\n          <instance id=\"19:731\" name=\"Ingredient Item / Unchecked\" x=\"0\" y=\"148\" width=\"700\" height=\"51\" />\n          <instance id=\"19:734\" name=\"Ingredient Item / Unchecked\" x=\"0\" y=\"207\" width=\"700\" height=\"51\" />\n          <instance id=\"19:737\" name=\"Ingredient Item / Unchecked\" x=\"0\" y=\"266\" width=\"700\" height=\"51\" />\n        </frame>\n        <frame id=\"19:740\" name=\"Group\" x=\"0\" y=\"404\" width=\"700\" height=\"199\">\n          <text id=\"19:741\" name=\"Group Title\" x=\"0\" y=\"0\" width=\"118\" height=\"22\" />\n          <instance id=\"19:742\" name=\"Ingredient Item / Unchecked\" x=\"0\" y=\"30\" width=\"700\" height=\"51\" />\n          <instance id=\"19:745\" name=\"Ingredient Item / Unchecked\" x=\"0\" y=\"89\" width=\"700\" height=\"51\" />\n          <instance id=\"19:748\" name=\"Ingredient Item / Unchecked\" x=\"0\" y=\"148\" width=\"700\" height=\"51\" />\n        </frame>\n      </frame>\n      <frame id=\"19:751\" name=\"Nutrition Panel\" x=\"964\" y=\"16\" width=\"360\" height=\"448\">\n        <text id=\"19:752\" name=\"Nutrition Information\" x=\"32\" y=\"32\" width=\"226\" height=\"27\" />\n        <instance id=\"19:753\" name=\"Nutrition Row\" x=\"32\" y=\"75\" width=\"296\" height=\"48\" />\n        <instance id=\"19:756\" name=\"Nutrition Row\" x=\"32\" y=\"139\" width=\"296\" height=\"48\" />\n        <instance id=\"19:759\" name=\"Nutrition Row\" x=\"32\" y=\"203\" width=\"296\" height=\"48\" />\n        <instance id=\"19:762\" name=\"Nutrition Row\" x=\"32\" y=\"267\" width=\"296\" height=\"48\" />\n        <instance id=\"19:765\" name=\"Nutrition Row\" x=\"32\" y=\"331\" width=\"296\" height=\"48\" />\n        <text id=\"19:768\" name=\"Note\" x=\"32\" y=\"395\" width=\"296\" height=\"21\" />\n      </frame>\n    </frame>\n    <frame id=\"19:769\" name=\"Directions &amp; Other\" x=\"0\" y=\"1774\" width=\"1440\" height=\"1390\">\n      <frame id=\"19:770\" name=\"Directions\" x=\"80\" y=\"16\" width=\"820\" height=\"1318\">\n        <text id=\"19:771\" name=\"Directions\" x=\"0\" y=\"0\" width=\"161\" height=\"39\" />\n        <frame id=\"19:772\" name=\"Step\" x=\"0\" y=\"63\" width=\"317\" height=\"735\">\n          <frame id=\"19:773\" name=\"Checkbox\" x=\"0\" y=\"8\" width=\"24\" height=\"24\" />\n          <frame id=\"19:774\" name=\"Content\" x=\"44\" y=\"8\" width=\"273\" height=\"702\">\n            <text id=\"19:775\" name=\"1.\" x=\"0\" y=\"0\" width=\"18\" height=\"29\" />\n            <text id=\"19:776\" name=\"Prepare the ingredients\" x=\"0\" y=\"43\" width=\"273\" height=\"29\" />\n            <text id=\"19:777\" name=\"Cut the asparagus, slice the spring onions and beat the eggs. Mix the soy sauce, sesame oil and mirin in a small bowl.\" x=\"0\" y=\"86\" width=\"273\" height=\"104\" />\n            <frame id=\"19:778\" name=\"Step Photo\" x=\"0\" y=\"204\" width=\"760\" height=\"380\">\n              <instance id=\"19:779\" name=\"Photo_Cooking_Step\" x=\"0\" y=\"0\" width=\"760\" height=\"380\" />\n            </frame>\n            <text id=\"19:780\" name=\"Day-old rice works best: it is drier, so the grains fry separately instead of turning mushy. Break up any clumps before you start.\" x=\"0\" y=\"598\" width=\"273\" height=\"104\" />\n          </frame>\n        </frame>\n        <frame id=\"19:781\" name=\"Step\" x=\"0\" y=\"822\" width=\"390\" height=\"223\">\n          <frame id=\"19:782\" name=\"Checkbox\" x=\"0\" y=\"8\" width=\"24\" height=\"24\" />\n          <frame id=\"19:783\" name=\"Content\" x=\"44\" y=\"8\" width=\"346\" height=\"190\">\n            <text id=\"19:784\" name=\"2.\" x=\"0\" y=\"0\" width=\"22\" height=\"29\" />\n            <text id=\"19:785\" name=\"Cook the eggs and asparagus\" x=\"0\" y=\"43\" width=\"346\" height=\"29\" />\n            <text id=\"19:786\" name=\"Heat the oil in a wok over high heat. Scramble the eggs until just set, push them to the side, then stir-fry the asparagus for 2 minutes until bright green and still crisp.\" x=\"0\" y=\"86\" width=\"346\" height=\"104\" />\n          </frame>\n        </frame>\n        <frame id=\"19:787\" name=\"Step\" x=\"0\" y=\"1069\" width=\"315\" height=\"249\">\n          <frame id=\"19:788\" name=\"Checkbox\" x=\"0\" y=\"8\" width=\"24\" height=\"24\" />\n          <frame id=\"19:789\" name=\"Content\" x=\"44\" y=\"8\" width=\"271\" height=\"216\">\n            <text id=\"19:790\" name=\"3.\" x=\"0\" y=\"0\" width=\"23\" height=\"29\" />\n            <text id=\"19:791\" name=\"Fry the rice and season\" x=\"0\" y=\"43\" width=\"271\" height=\"29\" />\n            <text id=\"19:792\" name=\"Add the rice and toss for 3–4 minutes until hot and lightly toasted. Pour over the sauce, fold in the eggs and spring onions, and serve right away.\" x=\"0\" y=\"86\" width=\"271\" height=\"130\" />\n          </frame>\n        </frame>\n      </frame>\n      <frame id=\"19:793\" name=\"Sidebar\" x=\"964\" y=\"16\" width=\"360\" height=\"927\">\n        <frame id=\"19:794\" name=\"Other Recipe\" x=\"0\" y=\"0\" width=\"360\" height=\"449\">\n          <text id=\"19:795\" name=\"Other Recipe\" x=\"0\" y=\"0\" width=\"154\" height=\"29\" />\n          <instance id=\"19:796\" name=\"Mini Recipe Item\" x=\"0\" y=\"49\" width=\"360\" height=\"120\" />\n          <instance id=\"19:802\" name=\"Mini Recipe Item\" x=\"0\" y=\"189\" width=\"360\" height=\"120\" />\n          <instance id=\"19:808\" name=\"Mini Recipe Item\" x=\"0\" y=\"329\" width=\"360\" height=\"120\" />\n        </frame>\n        <instance id=\"19:814\" name=\"Promo Card\" x=\"0\" y=\"481\" width=\"360\" height=\"446\" />\n      </frame>\n    </frame>\n    <frame id=\"19:818\" name=\"Recommended\" x=\"0\" y=\"3164\" width=\"1440\" height=\"507\">\n      <text id=\"19:819\" name=\"Title\" x=\"80\" y=\"48\" width=\"474\" height=\"39\" />\n      <frame id=\"19:820\" name=\"Row\" x=\"80\" y=\"127\" width=\"1280\" height=\"348\">\n        <instance id=\"19:821\" name=\"Card / Mixed Tropical Fruit Salad with Superfood Boosts\" x=\"0\" y=\"0\" width=\"290\" height=\"348\" />\n        <instance id=\"19:839\" name=\"Card / Big and Juicy Wagyu Beef Cheeseburger\" x=\"322\" y=\"0\" width=\"290\" height=\"348\" />\n        <instance id=\"19:857\" name=\"Card / Healthy Japanese Fried Rice with Asparagus\" x=\"644\" y=\"0\" width=\"290\" height=\"348\" />\n        <instance id=\"19:875\" name=\"Card / Cauliflower Walnut Vegetarian Taco Meat\" x=\"966\" y=\"0\" width=\"290\" height=\"348\" />\n      </frame>\n    </frame>\n    <frame id=\"19:895\" name=\"Newsletter\" x=\"0\" y=\"3671\" width=\"1440\" height=\"612\">\n      <instance id=\"19:896\" name=\"Newsletter Card\" x=\"300\" y=\"32\" width=\"840\" height=\"500\" />\n    </frame>\n    <instance id=\"19:908\" name=\"Footer\" x=\"0\" y=\"4283\" width=\"1440\" height=\"234\" />\n  </frame>\n  <frame id=\"21:734\" name=\"03_Blog\" x=\"3360\" y=\"3940\" width=\"1440\" height=\"2872\">\n    <instance id=\"21:735\" name=\"Header\" x=\"0\" y=\"0\" width=\"1440\" height=\"91\" />\n    <frame id=\"21:769\" name=\"Intro &amp; Search\" x=\"0\" y=\"91\" width=\"1440\" height=\"323\">\n      <text id=\"21:770\" name=\"Title\" x=\"574\" y=\"72\" width=\"292\" height=\"53\" />\n      <text id=\"21:771\" name=\"Copy\" x=\"496\" y=\"149\" width=\"448\" height=\"26\" />\n      <instance id=\"21:772\" name=\"Search Bar\" x=\"420\" y=\"199\" width=\"600\" height=\"68\" />\n    </frame>\n    <frame id=\"21:776\" name=\"Articles &amp; Sidebar\" x=\"0\" y=\"414\" width=\"1440\" height=\"1508\">\n      <frame id=\"21:777\" name=\"Articles\" x=\"80\" y=\"16\" width=\"800\" height=\"1460\">\n        <instance id=\"21:778\" name=\"Article Item\" x=\"0\" y=\"0\" width=\"800\" height=\"210\" />\n        <instance id=\"21:789\" name=\"Article Item\" x=\"0\" y=\"250\" width=\"800\" height=\"210\" />\n        <instance id=\"21:800\" name=\"Article Item\" x=\"0\" y=\"500\" width=\"800\" height=\"210\" />\n        <instance id=\"21:811\" name=\"Article Item\" x=\"0\" y=\"750\" width=\"800\" height=\"210\" />\n        <instance id=\"21:822\" name=\"Article Item\" x=\"0\" y=\"1000\" width=\"800\" height=\"210\" />\n        <instance id=\"21:833\" name=\"Article Item\" x=\"0\" y=\"1250\" width=\"800\" height=\"210\" />\n      </frame>\n      <frame id=\"21:844\" name=\"Sidebar\" x=\"944\" y=\"16\" width=\"360\" height=\"935\">\n        <frame id=\"21:845\" name=\"Tasty Recipes\" x=\"0\" y=\"0\" width=\"360\" height=\"449\">\n          <text id=\"21:846\" name=\"Tasty Recipes\" x=\"0\" y=\"0\" width=\"165\" height=\"29\" />\n          <instance id=\"21:847\" name=\"Mini Recipe Item\" x=\"0\" y=\"49\" width=\"360\" height=\"120\" />\n          <instance id=\"21:853\" name=\"Mini Recipe Item\" x=\"0\" y=\"189\" width=\"360\" height=\"120\" />\n          <instance id=\"21:859\" name=\"Mini Recipe Item\" x=\"0\" y=\"329\" width=\"360\" height=\"120\" />\n        </frame>\n        <instance id=\"21:865\" name=\"Promo Card\" x=\"0\" y=\"489\" width=\"360\" height=\"446\" />\n      </frame>\n    </frame>\n    <frame id=\"21:869\" name=\"Pagination\" x=\"0\" y=\"1922\" width=\"1440\" height=\"104\">\n      <instance id=\"21:870\" name=\"Pagination Item / Current\" x=\"521\" y=\"8\" width=\"48\" height=\"48\" />\n      <instance id=\"21:872\" name=\"Pagination Item / Default\" x=\"585\" y=\"8\" width=\"48\" height=\"48\" />\n      <instance id=\"21:874\" name=\"Pagination Item / Default\" x=\"649\" y=\"8\" width=\"48\" height=\"48\" />\n      <instance id=\"21:876\" name=\"Pagination Item / Default\" x=\"713\" y=\"8\" width=\"48\" height=\"48\" />\n      <instance id=\"21:878\" name=\"Pagination Item / Default\" x=\"777\" y=\"8\" width=\"48\" height=\"48\" />\n      <text id=\"21:880\" name=\"Ellipsis\" x=\"841\" y=\"22.5\" width=\"14\" height=\"19\" />\n      <instance id=\"21:881\" name=\"Pagination Item / Next\" x=\"871\" y=\"8\" width=\"48\" height=\"48\" />\n    </frame>\n    <frame id=\"21:884\" name=\"Newsletter\" x=\"0\" y=\"2026\" width=\"1440\" height=\"612\">\n      <instance id=\"21:885\" name=\"Newsletter Card\" x=\"300\" y=\"32\" width=\"840\" height=\"500\" />\n    </frame>\n    <instance id=\"21:897\" name=\"Footer\" x=\"0\" y=\"2638\" width=\"1440\" height=\"234\" />\n  </frame>\n  <frame id=\"24:883\" name=\"04_Blog_Post\" x=\"5040\" y=\"3940\" width=\"1440\" height=\"3755\">\n    <instance id=\"24:884\" name=\"Header\" x=\"0\" y=\"0\" width=\"1440\" height=\"91\" />\n    <frame id=\"24:918\" name=\"Article Header\" x=\"0\" y=\"91\" width=\"1440\" height=\"379\">\n      <text id=\"24:919\" name=\"Title\" x=\"230\" y=\"72\" width=\"980\" height=\"57\" />\n      <frame id=\"24:920\" name=\"Meta\" x=\"532\" y=\"157\" width=\"376\" height=\"96\">\n        <instance id=\"24:921\" name=\"Avatar_Dianne_Russell\" x=\"0\" y=\"0\" width=\"96\" height=\"96\" />\n        <text id=\"24:922\" name=\"Dianne Russell\" x=\"108\" y=\"39\" width=\"107\" height=\"18\" />\n        <ellipse id=\"24:923\" name=\"Ellipse\" x=\"227\" y=\"46\" width=\"4\" height=\"4\" />\n        <text id=\"24:924\" name=\"12 November 2021\" x=\"243\" y=\"39\" width=\"133\" height=\"18\" />\n      </frame>\n      <text id=\"24:925\" name=\"Intro\" x=\"310\" y=\"281\" width=\"820\" height=\"58\" />\n    </frame>\n    <frame id=\"24:926\" name=\"Article Photo\" x=\"0\" y=\"470\" width=\"1440\" height=\"608\">\n      <frame id=\"24:927\" name=\"Cover\" x=\"80\" y=\"0\" width=\"1280\" height=\"560\">\n        <instance id=\"24:928\" name=\"Photo_Blog_Chef\" x=\"0\" y=\"0\" width=\"1280\" height=\"560\" />\n      </frame>\n    </frame>\n    <frame id=\"24:929\" name=\"Article Body\" x=\"0\" y=\"1078\" width=\"1440\" height=\"1324\">\n      <frame id=\"24:930\" name=\"Q&amp;A\" x=\"230\" y=\"16\" width=\"980\" height=\"101\">\n        <text id=\"24:931\" name=\"How did you start out in the food industry?\" x=\"0\" y=\"0\" width=\"980\" height=\"31\" />\n        <text id=\"24:932\" name=\"I started washing dishes in a small family restaurant when I was sixteen. Watching the line cooks every night made me want to be on the other side of the pass, and after two years the chef finally let me prep vegetables.\" x=\"0\" y=\"45\" width=\"980\" height=\"56\" />\n      </frame>\n      <frame id=\"24:933\" name=\"Q&amp;A\" x=\"230\" y=\"149\" width=\"980\" height=\"101\">\n        <text id=\"24:934\" name=\"What do you like most about your job?\" x=\"0\" y=\"0\" width=\"980\" height=\"31\" />\n        <text id=\"24:935\" name=\"The rhythm of service. Hours of preparation come down to a few intense minutes, and when a full dining room goes quiet because everyone is eating, it feels like the whole team has done something together.\" x=\"0\" y=\"45\" width=\"980\" height=\"56\" />\n      </frame>\n      <frame id=\"24:936\" name=\"Q&amp;A\" x=\"230\" y=\"282\" width=\"980\" height=\"101\">\n        <text id=\"24:937\" name=\"Do you cook at home on your days off?\" x=\"0\" y=\"0\" width=\"980\" height=\"31\" />\n        <text id=\"24:938\" name=\"Yes, but simply. I cook the food I grew up with: rice, eggs and whatever vegetables look good at the market. Home cooking is where I remember why I love food.\" x=\"0\" y=\"45\" width=\"980\" height=\"56\" />\n      </frame>\n      <frame id=\"24:939\" name=\"Photo\" x=\"230\" y=\"415\" width=\"980\" height=\"460\">\n        <instance id=\"24:940\" name=\"Photo_Cooking_Step\" x=\"0\" y=\"0\" width=\"980\" height=\"460\" />\n      </frame>\n      <frame id=\"24:941\" name=\"Pull Quote\" x=\"230\" y=\"907\" width=\"980\" height=\"52\">\n        <text id=\"24:942\" name=\"“Technique can be taught; curiosity and reliability can’t.”\" x=\"32\" y=\"8\" width=\"948\" height=\"36\" />\n      </frame>\n      <frame id=\"24:943\" name=\"Q&amp;A\" x=\"230\" y=\"991\" width=\"980\" height=\"73\">\n        <text id=\"24:944\" name=\"What would your advice be to young people looking to get their foot in the door?\" x=\"0\" y=\"0\" width=\"980\" height=\"31\" />\n        <text id=\"24:945\" name=\"Start anywhere and be the person who shows up early. Ask questions, taste everything and write down what you learn.\" x=\"0\" y=\"45\" width=\"980\" height=\"28\" />\n      </frame>\n      <frame id=\"24:946\" name=\"Q&amp;A\" x=\"230\" y=\"1096\" width=\"980\" height=\"101\">\n        <text id=\"24:947\" name=\"What is the biggest misconception that people have about being a professional chef?\" x=\"0\" y=\"0\" width=\"980\" height=\"31\" />\n        <text id=\"24:948\" name=\"That it is all creativity. Most of the job is consistency: making the same dish perfectly two hundred times a night, keeping the kitchen clean and looking after your team.\" x=\"0\" y=\"45\" width=\"980\" height=\"56\" />\n      </frame>\n      <frame id=\"24:949\" name=\"Share\" x=\"230\" y=\"1229\" width=\"297\" height=\"47\">\n        <text id=\"24:950\" name=\"SHARE THIS ON:\" x=\"0\" y=\"28\" width=\"135\" height=\"16\" />\n        <instance id=\"24:951\" name=\"Social Group\" x=\"151\" y=\"25\" width=\"146\" height=\"22\" />\n      </frame>\n    </frame>\n    <frame id=\"24:963\" name=\"Recommended\" x=\"0\" y=\"2402\" width=\"1440\" height=\"507\">\n      <text id=\"24:964\" name=\"Title\" x=\"80\" y=\"48\" width=\"493\" height=\"39\" />\n      <frame id=\"24:965\" name=\"Row\" x=\"80\" y=\"127\" width=\"1280\" height=\"348\">\n        <instance id=\"24:966\" name=\"Card / Mixed Tropical Fruit Salad with Superfood Boosts\" x=\"0\" y=\"0\" width=\"290\" height=\"348\" />\n        <instance id=\"24:984\" name=\"Card / Big and Juicy Wagyu Beef Cheeseburger\" x=\"322\" y=\"0\" width=\"290\" height=\"348\" />\n        <instance id=\"24:1002\" name=\"Card / Healthy Japanese Fried Rice with Asparagus\" x=\"644\" y=\"0\" width=\"290\" height=\"348\" />\n        <instance id=\"24:1020\" name=\"Card / Cauliflower Walnut Vegetarian Taco Meat\" x=\"966\" y=\"0\" width=\"290\" height=\"348\" />\n      </frame>\n    </frame>\n    <frame id=\"24:1040\" name=\"Newsletter\" x=\"0\" y=\"2909\" width=\"1440\" height=\"612\">\n      <instance id=\"24:1041\" name=\"Newsletter Card\" x=\"300\" y=\"32\" width=\"840\" height=\"500\" />\n    </frame>\n    <instance id=\"24:1053\" name=\"Footer\" x=\"0\" y=\"3521\" width=\"1440\" height=\"234\" />\n  </frame>\n  <frame id=\"24:1078\"