c,\"Caret\");\nbc.appendChild(txt(\"Shop\",\"Medium\",16,\"24252B\"));\nawait icon(\"13:46\",14,\"24252B\",bc,\"Caret\");\nconst crumb3 = txt(\"Asgaard sofa\",\"Regular\",16,\"898989\"); bc.appendChild(crumb3);\n// main: gallery + summary\nconst main = autolayout(\"Main\",\"HORIZONTAL\",64,24,54,60,54,F); main.resize(1440,main.height); main.counterAxisSizingMode=\"FIXED\";\nconst gal = autolayout(\"Gallery\",\"VERTICAL\",12,0,0,0,0,main);\nawait photoFrame(gal,\"MainPhoto\",550,530,0,0,8,\"13:4\");\nconst thumbs = autolayout(\"Thumbs\",\"HORIZONTAL\",16,0,0,0,0,gal);\nfor (const pid of [\"13:14\",\"13:15\",\"13:64\",\"13:13\"]) await photoFrame(thumbs,\"Thumb\",107,107,0,0,6,pid);\nconst sum = autolayout(\"Summary\",\"VERTICAL\",24,0,0,0,0,main); sum.resize(620,sum.height); sum.counterAxisSizingMode=\"FIXED\";\nsum.appendChild(txt(\"Asgaard sofa\",\"SemiBold\",34,\"24252B\"));\nconst pr = txt(\"Rs. 250,000.00\",\"SemiBold\",24,\"B0B0B0\"); sum.appendChild(pr);\nconst dv1 = frame(\"Div\",620,1,sum); dv1.fills=[hex(\"E5E5E5\")];\nconst rate = autolayout(\"Rating\",\"HORIZONTAL\",14,0,0,0,0,sum); rate.counterAxisAlignItems=\"CENTER\";\nfor (let i=0;i<4;i++){ const st=await icon(\"13:31\",22,\"FFC700\",rate,\"Star\"); }\nawait icon(\"13:52\",22,\"FFC700\",rate,\"StarHalf\");\nconst dv2 = frame(\"Div2\",2,1,rate); dv2.fills=[hex(\"9F9F9F\")]; dv2.resize(1,22);\nrate.appendChild(txt(\"204 Customer Reviews\",\"Regular\",14,\"3A3A3A\"));\nsum.appendChild(txt(\"Setting the bar as one of the most comfortable sofas in its class, the Asgaard is a compact, sturdy three-seater with a solid-wood frame and deep, soft cushions.\",\"Regular\",14,\"3A3A3A\",{lh:24,w:620}));\nconst sizeRow = autolayout(\"SizeRow\",\"VERTICAL\",12,0,0,0,0,sum);\nsizeRow.appendChild(txt(\"Size\",\"SemiBold\",14,\"B0B0B0\"));\nconst sizeOpts = autolayout(\"SizeOpts\",\"HORIZONTAL\",12,0,0,0,0,sizeRow);\nfor (const [label,sel] of [[\"L\",true],[\"XL\",false],[\"XS\",false]]){\n  const b = frame(\"Size_\"+l