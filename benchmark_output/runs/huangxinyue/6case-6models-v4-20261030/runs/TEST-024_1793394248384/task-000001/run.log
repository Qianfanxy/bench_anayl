ction mediaInst(name,parent){const m=MASTER[name].createInstance();parent.appendChild(m);return m;}\nfunction statusBar(parent,white){const s=MASTER[\"Status Bar\"].createInstance();parent.appendChild(s);s.x=0;s.y=0;s.fills=[];recolor(s,white?\"#FFFFFF\":\"#181725\");return s;}\nfunction homeInd(parent,white,y){const h=MASTER[\"Home Indicator\"].createInstance();parent.appendChild(h);h.x=0;h.y=y;h.fills=[];recolor(h,white?\"#FFFFFF\":\"#181725\");return h;}\nfunction hotspot(parent,name,x,y,w,h){const r=figma.createRectangle();parent.appendChild(r);r.x=x;r.y=y;r.resize(w,h);r.fills=[];r.name=name;return r;}\nfunction listRow(parent,y,label,iconName){const r=MASTER[\"List Entry\"].createInstance();parent.appendChild(r);r.x=24;r.y=y;findTxt(r).characters=label;const ei=findN(r,n=>n.name===\"EntryIcon\");ei.swapComponent(MASTER[iconName]);const s=Math.min(24/ei.width,24/ei.height);if(s<1)ei.resize(ei.width*s,ei.height*s);recolor(ei,C.dark);return r;}\nconst TB=findN(figma.root,n=>n.type===\"COMPONENT_SET\"&&n.name===\"Tab Bar\");\nconst f12=figma.createFrame();WS.appendChild(f12);f12.x=1542;f12.y=2450;f12.resize(414,896);f12.name=\"12_Account\";f12.fills=[F(C.white)];f12.clipsContent=true;\nstatusBar(f12,false);\nconst av=mediaInst(\"Avatar_Neutral\",f12);av.x=24;av.y=56;av.resize(64,64);\nconst nm=txt(\"Afsar Hossen\",20,\"SemiBold\",C.dark);f12.appendChild(nm);nm.x=104;nm.y=62;\nconst pc=icn(P.PENCIL,16,C.brand);f12.appendChild(pc);pc.x=104+nm.width+10;pc.y=62+Math.round((nm.height-16)/2);pc.name=\"Btn/EditName\";\nconst em=txt(\"imshuvo97@gmail.com\",14,\"Regular\",C.gray);f12.appendChild(em);em.x=104;em.y=94;\nconst dv=figma.createRectangle();f12.appendChild(dv);dv.x=24;dv.y=140;dv.resize(366,1);dv.fills=[F(C.border)];\nconst rows=[[\"Orders\",\"Icon_Orders\"],[\"My Details\",\"Icon_My_Details\"],[\"Delivery Address\",\"Icon_Delivery_Address\"],[\"Payment Methods\",\"Icon_Payment\"],[\"Promo Code\",\"Icon_Promo\"],[\"Notifications\",\"Icon_Notifications\"],[\"Help\