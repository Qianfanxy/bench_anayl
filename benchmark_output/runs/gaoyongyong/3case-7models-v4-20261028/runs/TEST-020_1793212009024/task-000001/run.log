kes.length>0)ch.strokes=[paint];if('fills'in ch&&ch.fills&&ch.fills.length>0&&ch.type!=='TEXT')ch.fills=[paint];}}\nconst IM={Avatar:'2:65',FlagUSA:'2:63',Icon_ChevronDown:'2:17',Icon_Bell:'2:6',Icon_Message:'2:7',Icon_ArrowUpRight:'2:9',Icon_Plus:'2:10',sb:'6:110',hi:'6:122'};\nconst COMP={};for(const k in IM)COMP[k]=await figma.getNodeByIdAsync(IM[k]);\nconst CM={};for(const id of (await figma.getNodeByIdAsync('2003:2')).children.filter(n=>n.type==='COMPONENT'))CM[id.name]=id;\nfunction inst(key,p,x,y,w,h){const i=COMP[key].createInstance();i.resize(w,h||w);i.x=x;i.y=y;p.appendChild(i);return i;}\nfunction cinst(name,p,x,y){const i=CM[name].createInstance();i.x=x;i.y=y;p.appendChild(i);return i;}\n// ============ 03_Home_My_Balance ============\nconst f=await figma.getNodeByIdAsync('2005:4');\nconst sb=inst('sb',f,0,0,375,44);sb.fills=[];\n// header\nconst av=inst('Avatar',f,20,52,48,48);av.name='Avatar';\nT(f,'Hi, Esaaa!',{s:18,st:'SemiBold',x:80,y:54});\nT(f,'Aug 20, 2023',{s:11.5,c:C.muted,st:'Regular',x:80,y:78});\nconst msg=cinst('Header Icon · Message',f,263,56);msg.name='Messages';\nconst bel=cinst('Header Icon · Bell',f,311,56);bel.name='Notifications';\n// view switch\ncinst('View Switch · Active=My Balance',f,20,116).name='ViewSwitch';\n// balance card\nconst grad={type:'GRADIENT_LINEAR',gradientTransform:[[1,0,0],[0,1,0]],gradientStops:[{position:0,color:{r:0.83,g:0.79,b:1,a:1}},{position:1,color:{r:0.66,g:0.61,b:0.97,a:1}}]};\nconst bc=FR(f,{w:335,h:148,x:20,y:172,r:20,grad:grad,name:'Balance Card',effects:[SH(8,24,0.10)]});\nT(bc,'Your Balance',{s:12.5,c:C.ink,o:0.65,x:20,y:18});\nT(bc,'$190,008.03',{s:32,st:'SemiBold',x:20,y:44});\nconst chip1=FR(bc,{w:52,h:24,x:20,y:104,f:C.white,o:0.4,r:12,name:'Trend'});\nT(chip1,'+8%',{s:12,st:'SemiBold',c:C.success}).x=(52-T(bc,'+8%',{s:12,st:'SemiBold',c:C.success}).width)/2;\n// fix: the above created stray text; simpler below\nchip1.children[0].x=(52-chip1.children[0].width)/2;chip1.children[0].y=6;\nconst cur=FR(bc,{w:78,h:28,x:237,y:102,f:C.white,r:14,name:'Currency'});\ninst('FlagUSA',cur,10,7,14,14);\nT(cur,'USD',{s:11,x:29,y:7});\nconst cv=inst('Icon_ChevronDown',cur,56,8,12);tintIcon(cv,C.muted);\n// action row\ncinst('Action · Send',f,20,340).name='ActionSend';\ncinst('Action · Receive',f,149.5,340).name='ActionReceive';\ncinst('Action · Add',f,279,340).name='ActionAdd';\n// financial health card\nconst fh=FR(f,{w:335,h:148,x:20,y:436,f:C.card,r:16,name:'Financial Health',effects:[SH(6,18,0.05)]});\nT(fh,'Financial health',{s:14,st:'SemiBold',x:16,y:14});\nT(fh,'Latest 7 days',{s:11,c:C.muted,st:'Regular',x:236,y:16});\nconst ar=inst('Icon_ArrowUpRight',fh,303,13,16);tintIcon(ar,C.deep);\n// bar chart: baseline y=118, top 48, maxH 66 for 50K scale (10K floor)\nconst days=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];const vals=[24,35,45,22,34,18,30];\nT(fh,'50K',{s:8.5,c:C.muted,st:'Regular',x:8,y:44});\nT(fh,'10K',{s:8.5,c:C.muted,st:'Regular',x:8,y:112});\nvals.forEach((v,i)=>{const h=(v-10)/40*66;const bx=40+i*40;const isMax=v===45;const bar=FR(fh,{w:22,h:h,x:bx,y:118-h,f:isMax?C.deep:C.primary,r:6,name:'Bar '+days[i]});T(fh,days[i],{s:9.5,c:i===2?C.deep:C.muted,st:'Regular'}).x=bx+11-T(fh,days[i],{s:9.5,c:C.muted,st:'Regular'}).width/2;});\n// fix stray day labels: reposition last created each loop handled inline above (each label centered by its own width)\n// transfer list card\nconst tl=FR(f,{w:335,h:108,x:20,y:600,f:C.card,r:16,name:'Transfer List',effects:[SH(6,18,0.05)]});\nT(tl,'Transfer list',{s:14,st:'SemiBold',x:16,y:14});\nconst addChip=FR(tl,{w:58,h:26,x:261,y:12,f:C.deepSoft,r:13,name:'AddContact'});\nconst ap=inst('Icon_Plus',addChip,8,6,14);tintIcon(ap,C.deep);\nT(addChip,'Add',{s:11.5,c:C.deep,x:26,y:5});\nconst names=['Bessie Cooper','Devon Lane','Eleanor Pena','Jenny Wilson','Cody Fisher'];\nnames.forEach((nm,i)=>{const c=cinst('Contact · Person',tl,6+i*64.8,40);c.findOne(n=>n.name==='Name').characters=nm;if(i===0)c.name='Contact Bessie Cooper