eft = 24; bar.paddingRight = 24;\n\n    const tabs = [\n      { name: \"Home\", icon: mediaMap.Icon_Home },\n      { name: \"Explore\", icon: mediaMap.Icon_Explore },\n      { name: \"Analytics\", icon: mediaMap.Icon_Analytics },\n      { name: \"Profile\", icon: mediaMap.Icon_Profile }\n    ];\n\n    const tabNodes = {};\n\n    for (const t of tabs) {\n      const item = figma.createFrame();\n      item.name = `Tab_${t.name}`;\n      item.layoutMode = \"VERTICAL\";\n      item.primaryAxisAlignItems = \"CENTER\";\n      item.counterAxisAlignItems = \"CENTER\";\n      item.itemSpacing = 4;\n      item.fills = [];\n\n      const iconInst = t.icon.createInstance();\n      item.appendChild(iconInst);\n\n      const label = figma.createText();\n      label.fontName = { family: \"Lato\", style: t.name === activeTabName ? \"Bold\" : \"Medium\" };\n      label.fontSize = 11;\n      label.characters = t.name;\n      label.fills = [{\n        type: 'SOLID',\n        color: t.name === activeTabName ? { r: 0.098, g: 0.129, b: 0.149 } : { r: 0.6, g: 0.64, b: 0.68 }\n      }];\n      item.appendChild(label);\n\n      bar.appendChild(item);\n      tabNodes[t.name] = item;\n    }\n\n    return { bar, tabNodes };\n  }\n\n  // Top status bar\n  const sb = sourceStatusBar.createInstance();\n  sb.x = 0; sb.y = 0;\n  f5.appendChild(sb);\n\n  // Scroll Content\n  const scrollContent = figma.createFrame();\n  scrollContent.name = \"Scroll_Content\";\n  scrollContent.resize(390, 693);\n  scrollContent.x = 0; scrollContent.y = 47;\n  scrollContent.fills = [];\n  scrollContent.layoutMode = \"VERTICAL\";\n  scrollContent.itemSpacing = 20;\n  scrollContent.paddingLeft = 20;\n  scrollContent.paddingRight = 20;\n  scrollContent.paddingTop = 12;\n  scrollContent.paddingBottom = 24;\n  scrollContent.clipsContent = true;\n\n  // Header: \"Today Report\"\n  const headerRow = figma.createFrame();\n  headerRow.layoutMode = \"HORIZONTAL\";\n  headerRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  head