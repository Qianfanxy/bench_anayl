2\">\n          <text id=\"3:29\" name=\"Case-study cards (in order)\" x=\"20\" y=\"20\" width=\"190\" height=\"20\" />\n          <text id=\"3:30\" name=\"1 · hover state: image placeholder with “See Details” (no caption shown) 2 · “Ai Corporation. 2023” — “Ai Wave - Ai Chatbot Mobile App” 3 · “Lancer Corporation. 2023” — “App Lancer - Freelance Mobile App”\" x=\"20\" y=\"48\" width=\"380\" height=\"114\" />\n        </frame>\n        <frame id=\"3:31\" name=\"FAQ (in order)\" x=\"444\" y=\"0\" width=\"420\" height=\"315\">\n          <text id=\"3:32\" name=\"FAQ (in order)\" x=\"20\" y=\"20\" width=\"96\" height=\"20\" />\n          <text id=\"3:33\" name=\"Why is digital marketing important for my business? — expanded: “Digital marketing allows businesses to reach and engage with a wider audience, generate leads, drive website traffic, and increase brand visibility. It provides measurable results, allows for targeted marketing efforts, and enables businesses to adapt and optimize their strategies based on data and insights.” How can digital marketing help improve my website’s visibility? How long does it take to see results from digital marketing efforts? How do you measure the success of digital marketing campaigns?\" x=\"20\" y=\"48\" width=\"380\" height=\"247\" />\n        </frame>\n        <frame id=\"3:34\" name=\"Articles (in order; all “5 min read”)\" x=\"888\" y=\"0\" width=\"420\" height=\"296\">\n          <text id=\"3:35\" name=\"Articles (in order; all “5 min read”)\" x=\"20\" y=\"20\" width=\"232\" height=\"20\" />\n          <text id=\"3:36\" name=\"How a Digital Marketing Agency Can Boost Your Business — “We are the top digital marketing agency for branding corp. We offer a full range of services to help clients improve their search engine rankings.” The Latest Trends and Strategies with a Digital Marketing Agency — “Working with this digital marketing agency has been a true partnership. They have taken the time to understand our business and industry.” Maximizing ROI with the Expertise of a Digital Marketing Agency — “What sets this digital marketing agency apart is their commitment to transparency and collaboration. They keep us informed every step of the way.”\" x=\"20\" y=\"48\" width=\"380\" height=\"228\" />\n        </frame>\n        <frame id=\"3:37\" name=\"Footer\" x=\"0\" y=\"339\" width=\"420\" height=\"315\">\n          <text id=\"3:38\" name=\"Footer\" x=\"20\" y=\"20\" width=\"45\" height=\"20\" />\n          <text id=\"3:39\" name=\"Logo_MAC · “We offer a comprehensive suite of digital marketing services that cover all aspects of your online presence. From SEO and social media marketing to content creation and PPC advertising, we have the expertise and resources to handle your diverse marketing needs.” Social: Logo_Facebook · Logo_Twitter · Logo_LinkedIn · Logo_Instagram Navigation: Service · Agency · Case Study · Resources · Contact Licence: Privacy Policy · Copyright · Email Address Contact: (406) 555-0120 (Icon_Phone) · hey@example.com (Icon_Mail) · 2972 Westheimer Rd. Santa Ana, Illinois 85486 (Icon_Map_Pin)\" x=\"20\" y=\"48\" width=\"380\" height=\"247\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"3:40\" name=\"What is fixed · what is yours\" x=\"64\" y=\"2603\" width=\"1312\" height=\"312\">\n      <text id=\"3:41\" name=\"What is fixed · what is yours\" x=\"0\" y=\"0\" width=\"328\" height=\"35\" />\n      <frame id=\"3:42\" name=\"Fixed vs yours\" x=\"0\" y=\"51\" width=\"1312\" height=\"261\">\n        <frame id=\"3:43\" name=\"Fixed (given)\" x=\"0\" y=\"0\" width=\"644\" height=\"201\">\n          <text id=\"3:44\" name=\"Fixed (given)\" x=\"24\" y=\"24\" width=\"103\" height=\"23\" />\n          <text id=\"3:45\" name=\"• Frame name • Must-include content (what, not how) • All data and copy • Brand colors #99EA48 and #010205, and Plus Jakarta Sans • Media: logo, social logos, icons • Default Button\" x=\"24\" y=\"57\" width=\"596\" height=\"120\" />\n        </frame>\n        <frame id=\"3:46\" name=\"Yours (designer decides)\" x=\"668\" y=\"0\" width=\"644\" height=\"261\">\n          <text id=\"3:47\" name=\"Yours (designer decides)\" x=\"24\" y=\"24\" width=\"197\" height=\"23\" />\n          <text id=\"3:48\" name=\"• Layout, grid, grouping, order and emphasis of every section • All other colors: neutrals, text, light / dark section backgrounds, surfaces, borders, chart and progress colors, selected filter, error / disabled • Type scale, spacing, radii, elevation • All states: current filter, card hover, expanded / collapsed FAQ, hover • Header with dropdown triggers, stat and chart cards, client wordmark row, video block, filter tags, case-study card, testimonial with pager, FAQ accordion, article card, CTA banner, footer • How image placeholders are sized and placed\" x=\"24\" y=\"57\" width=\"596\" height=\"180\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"3:49\" name=\"How it is evaluated\" x=\"64\" y=\"2963\" width=\"1312\" height=\"259\">\n      <text id=\"3:50\" name=\"How it is evaluated\" x=\"0\" y=\"0\" width=\"222\" height=\"35\" />\n      <text id=\"3:51\" name=\"Your file is compared with this brief on coverage, data and flow — not on visual similarity to any original.\" x=\"0\" y=\"51\" width=\"1312\" height=\"22\" />\n      <text id=\"3:52\" name=\"1. Checklist coverage 2. Data &amp; copy accuracy 3. Information hierarchy across sections 4. Visual quality &amp; consistency of your own system 5. Component reuse 6. State design (current filter, card hover, expanded FAQ)\" x=\"0\" y=\"89\" width=\"1312\" height=\"132\" />\n      <text id=\"3:53\" name=\"Deliverable: the link to your own Figma file containing the 1 named frame, your components.\" x=\"0\" y=\"237\" width=\"1312\" height=\"22\" />\n    </frame>\n  </frame>\n</canvas>"},{"type":"text","text":"IMPORTANT: After you call this tool, you MUST call get_design_context if trying to implement the design, since this tool only returns metadata. If you do not call get_design_context, the agent will not be able to implement the design."}],"_meta":{"mcpRequestId":"89476f94-2a5b-40c8-9935-90581eb0a3bd"}},"tool_result_meta":[{"id":"mcp__figma__get_metadata_2_46411786","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
