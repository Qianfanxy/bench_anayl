sible:true, blendMode:\"NORMAL\"}];\n\n// ---- Comp / Subscription Row ----\nconst sr = figma.createFrame(); sr.name=\"Comp / Subscription Row\"; sr.resize(343,68);\nsr.fills=S(C.white); sr.cornerRadius=16; sr.effects=SHADOW;\nsr.layoutMode=\"HORIZONTAL\"; sr.paddingLeft=16; sr.paddingRight=16; sr.itemSpacing=12; sr.counterAxisAlignItems=\"CENTER\";\nconst logoC = await figma.getNodeByIdAsync(\"2:15\"); const li = logoC.createInstance(); li.resize(36,36);\nsr.appendChild(li);\nconst mid = figma.createFrame(); mid.fills=[]; mid.layoutMode=\"VERTICAL\"; mid.itemSpacing=2; mid.layoutGrow=1;\nmid.appendChild(mkText(\"Subscription\",14,\"Bold\",C.ink));\nmid.appendChild(mkText(\"$0/mo\",12,\"Medium\",C.sec));\nsr.appendChild(mid);\nconst chv = await iconInst(\"2:6\", C.ter, 20); sr.appendChild(chv);\nconst srComp = figma.createComponentFromNode(sr); srComp.name=\"Comp / Subscription Row\";\nkit.appendChild(srComp);\n\n// ---- Comp / Factor Row ----\nconst fr = figma.createFrame(); fr.name=\"Comp / Factor Row\"; fr.resize(343,72);\nfr.fills=S(C.white); fr.cornerRadius=16; fr.effects=SHADOW;\nfr.layoutMode=\"HORIZONTAL\"; fr.paddingLeft=16; fr.paddingRight=16; fr.itemSpacing=12; fr.counterAxisAlignItems=\"CENTER\";\nconst midF = figma.createFrame(); midF.fills=[]; midF.layoutMode=\"VERTICAL\"; midF.itemSpacing=3; midF.layoutGrow=1;\nmidF.appendChild(mkText(\"Factor\",14,\"Bold\",C.ink));\nconst det = mkText(\"detail\",12,\"Medium\",C.sec); det.name=\"detail\"; midF.appendChild(det);\nfr.appendChild(midF);\nconst right = figma.createFrame(); right.fills=[]; right.layoutMode=\"HORIZONTAL\"; right.itemSpacing=8; right.counterAxisAlignItems=\"CENTER\";\nright.appendChild(mkText(\"0%\",14,\"Bold\",C.ink));\nconst chip = figma.createFrame(); chip.name=\"chip\"; chip.fills=S(C.greenSoft); chip.cornerRadius=8;\nchip.layoutMode=\"HORIZONTAL\"; chip.paddingLeft=8; chip.paddingRight=8; chip.paddingTop=3; chip.paddingBottom=3;\nchip.appendChild(mkText(\"Good\",11,\"Bold\",C.green));\nright.appendChild(chip);\nfr.appendChild(right);\nconst frComp = figma.createComponentFromNode(fr); frComp.name=\"Comp / Factor Row\";\nkit.appendChild(frComp);\n\n// ---- Comp / Credit Card (dial) ----\nconst cc = figma.createFrame(); cc.name=\"Comp / Credit Card\"; cc.resize(343,264);\ncc.fills=S(C.white); cc.cornerRadius=24; cc.effects=SHADOW;\n// dial container\nconst dial = figma.createFrame(); dial.name=\"dial\"; dial.resize(220,140); dial.x=61.5; dial.y=20; dial.fills=[];\n// arc segments: semicircle from 180° (left) to 360° (right), rotate values in degrees where 0 = pointing right, positive CW\nconst segs = [\n  { name:\"seg 400-500\", color:{r:0.902,g:0.376,b:0.325}, start:180 },\n  { name:\"seg 500-600\", color:{r:0.949,g:0.729,b:0.278}, start:216 },\n  { name:\"seg 600-700\", color:{r:0.906,g:0.816,b:0.345}, start:252 },\n  { name:\"seg 700-800\", color:{r:0.545,g:0.765,b:0.396}, start:288 },\n  { name:\"seg 800-850\", color:{r:0.141,g:0.663,b:0.42},  start:324 }\n];\nconst ARC_SIZE = 200;\nfor (const sg of segs){\n  const e = figma.createEllipse(); e.name=sg.name; e.resize(ARC_SIZE,ARC_SIZE);\n  e.arcData = { startingAngle:0, endingAngle:Math.PI*36/180, innerRadius:0.86 };\n  e.fills = S(sg.color); e.rotation = sg.start;\n  dial.appendChild(e); e.x = 10; e.y = 10;\n}\nconst inner = figma.createRectangle(); inner.resize(220,70); inner.fills=S(C.white); dial.appendChild(inner); inner.x=0; inner.y=70;\n// score text\nconst scoreT = mkText(\"660\",44,\"Bold\",C.ink); scoreT.name=\"score\";\ncc.appendChild(scoreT); scoreT.x = (343-scoreT.width)/2; scoreT.y = 62;\n// badge\nconst badge = figma.createFrame(); badge.name=\"badge\"; badge.cornerRadius=10;\nbadge.layoutMode=\"HORIZONTAL\"; badge.itemSpacing=6; badge.paddingLeft=10; badge.paddingRight=10; badge.paddingTop=4; badge.paddingBottom=4;\nbadge.fills=S(C.greenSoft);\nbadge.appendChild(mkText(\"Good\",12,\"Bold\",C.green));\nconst up = mkText(\"+6pts\",12,\"Bold\",C.brand); badge.appendChild(up);\ncc.appendChild(badge); badge.x = (343-badge.width)/2; badge.y = 120;\n// range labels\nconst rl = mkText(\"400\",12,\"Medium\",C.ter); cc.appendChild(rl); rl.x=24; rl.y=172;\nconst rr = mkText(\"850\",12,\"Medium\",C.ter); cc.appendChild(rr); rr.x=343-24-rr.width; rr.y=172;\n// update\nconst upd = mkText(\"Last update on 20 Jul 2020\",12,\"Medium\",C.ter);\ncc.appendChild(upd); upd.x=(343-upd.width)/2; upd.y=214;\n// divider\nconst dv = figma.createRectangle(); dv.resize(295,1); dv.fills=S(C.border); cc.appendChild(dv); dv.x=24; dv.y=202;\nconst ccComp = figma.createComponentFromNode(cc); ccComp.name=\"Comp / Credit Card\";\nkit.appendChild(ccComp);\n\nreturn JSON.stringify({sub:srComp.id, factor:frComp.id, credit:ccComp.id});","description":"Create Subscription Row, Factor Row, Credit Card components"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"55f02ba1-1af6-4956-ab29-2f9700c86fb2","uuid":"4206c5a4-8651-4af8-aab0-b381b808d95a","timestamp":"2026-11-02T13:50:23.569Z","tool_use_meta":[{"id":"mcp__figma__use_figma_19_8bb1ab6f","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
