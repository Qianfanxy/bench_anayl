;if(clear)s.fills=[];add(f,s,0,0);return s;};\nconst homeInd=async f=>add(f,await media('3:42'),0,778);\nconst hero=(f,h)=>{const r=figma.createFrame();r.name='Hero';r.resize(375,h);r.fills=[p('brand/primary')];r.bottomLeftRadius=24;r.bottomRightRadius=24;add(f,r,0,0);return r;};\nconst wrapText=async(f,str,style,color,x,y,w,align)=>{const t=await T(str,style,color);add(f,t,x,y);t.textAutoResize='HEIGHT';t.resize(w,t.height);if(align)t.textAlignHorizontal=align;return t;};\nconst res={};\n// 01\n{const f=screen('01_Splash',0);res[f.name]=f.id;const l=await media('2:8');l.resize(190,147.5);add(f,l,92.5,332);await statusBar(f);await homeInd(f);}\n// 02\n{const f=screen('02_Welcome',1);res[f.name]=f.id;hero(f,480);const b=await media('2:32');b.fills=b.fills;add(f,b,37,178);const d=await media('2:38');add(f,d,248,104);\n await statusBar(f,true);await wrapText(f,'Get The Freshest Fruit Salad Combo','Heading/H1','text/primary',24,508,327);await wrapText(f,'We deliver the best and freshest fruit salad in town. Order for a combo today!!!','Body','text/secondary',24,588,327);const c=btn('Primary','Let’s Continue');add(f,c,24,706);await homeInd(f);}\n// 03\n{const f=screen('03_Name',2);res[f.name]=f.id;hero(f,460);const b=await media('2:35');b.resize(271,253);add(f,b,52,176);const d=await media('2:38');add(f,d,32,92);\n await statusBar(f,true);await wrapText(f,'What is your firstname?','Heading/H2','text/primary',24,500,327);const fi=inst('Field','State=Filled');fi.name='First name';fi.findOne(x=>x.type==='INSTANCE'&&x.name==='Text Field').setProperties({'Placeholder#3:1':'Tony'});add(f,fi,24,540);const c=btn('Primary','Start Ordering');add(f,c,24,706);await homeInd(f);}\n// 04\n{const f=screen('04_Home',3);res[f.name]=f.id;await statusBar(f);add(f,inst('Menu Button'),24,50);const be=add(f,inst('Basket Entry'),295,48);be.name='My basket';\n const g=await wrapText(f,'Hello Tony, What fruit salad combo do you want today?','Heading/H2','text/primary',24,102,327);g.setRangeFontName(0,11,{family:'Nunito',style:'Regular'});\n add(f,inst('Search Bar'),24,172);add(f,inst('Filter Button'),303,172);\n await wrapText(f,'Recommended Combo','Heading/H2','text/primary',24,236,327);\n const cards=[['Honey lime combo','₦2,000','Honey lime','On'],['Berry mango combo','₦8,000','Berry mango','Off']];let i=0;\n for(const [n,pr,ph,fav] of cards){const c=inst('Product Card',`Favourite=${fav}`);setP(c,{Name:n,Price:pr});c.findOne(x=>x.name==='Photo').setProperties({Product:ph});c.name=n;add(f,c,24+i*170,272);i++;}\n const tabs=figma.createFrame();tabs.name='Categories';tabs.fills=[];tabs.layoutMode='HORIZONTAL';tabs.primaryAxisSizingMode='FIXED';tabs.counterAxisSizingMode='AUTO';tabs.primaryAxisAlignItems='SPACE_BETWEEN';tabs.resize(327,36);add(f,tabs,24,468);\n for(const [l,s] of [['Hottest','Selected'],['Popular','Default'],['New combo','Default'],['Top','Default']]){const t=inst('Category Tab',`State=${s}`);setP(t,{Label:l});t.name=l;tabs.appendChild(t);}\n i=0;for(const [n,ph] of [['Quinoa fruit salad','Quinoa'],['Tropical fruit salad','Tropical'],['Melon fruit salad','Melon']]){const r=inst('Product Row','Favourite=Off');setP(r,{Name:n,Price:'₦10,000'});r.findOne(x=>x.name==='Photo').setProperties({Product:ph});r.name=n;add(f,r,24,516+i*80);i++;}\n await homeInd(f);}\n// 05\n{const f=screen('05_Product_Quinoa',4);res[f.name]=f.id;const hr=hero(f,330);hr.bottomLeftRadius=0;hr.bottomRightRadius=0;const q=await media('2:20');q.resize(255,170);add(f,q,60,104);await statusBar(f,true);const bk=inst('Back Button');add(f,bk,24,52);\n const pn=figma.createFrame();pn.name='Details';pn.resize(375,512);pn.fills=[p('surface/page')];pn.topLeftRadius=24;pn.topRightRadius=24;add(f,pn,0,300);\n await wrapText(f,'Quinoa Fruit Salad','Heading/H1','text/primary',24,324,327);\n const qr=figma.createFrame();qr.name='Quantity and price';qr.fills=[];qr.layoutMode='HORIZONTAL';qr.primaryAxisSizingMode='FIXED';qr.counterAxisSizingMode='AUTO';qr.primaryAxisAlignItems='SPACE_BETWEE