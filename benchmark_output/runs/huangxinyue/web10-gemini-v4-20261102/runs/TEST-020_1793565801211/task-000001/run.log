con_Mail\");\n\n  // Colors\n  const COLOR_BG = { r: 0.05, g: 0.05, b: 0.07 }; // #0D0D12\n  const COLOR_SURFACE = { r: 0.09, g: 0.09, b: 0.12 }; // #17171F\n  const COLOR_SURFACE_HOVER = { r: 0.13, g: 0.13, b: 0.18 }; // #21212E\n  const COLOR_CARD_BG = { r: 0.08, g: 0.08, b: 0.11 }; // #14141C\n  const COLOR_BORDER = { r: 0.16, g: 0.16, b: 0.22 }; // #292938\n  \n  const COLOR_TEXT_PRIMARY = { r: 0.96, g: 0.96, b: 0.98 }; // #F5F5FA\n  const COLOR_TEXT_SECONDARY = { r: 0.65, g: 0.65, b: 0.72 }; // #A6A6B8\n  const COLOR_TEXT_MUTED = { r: 0.45, g: 0.45, b: 0.52 }; // #737385\n\n  const COLOR_ORANGE = { r: 0.835, g: 0.286, b: 0.114 }; // #D5491D\n  const COLOR_BLUE = { r: 0.075, g: 0.451, b: 0.82 }; // #1373D1\n\n  function recolorNode(node, color) {\n    if (\"fills\" in node && Array.isArray(node.fills)) {\n      node.fills = [{ type: 'SOLID', color: color }];\n    }\n    if (\"children\" in node) {\n      for (const child of node.children) {\n        recolorNode(child, color);\n      }\n    }\n  }\n\n  // --- REUSABLE COMPONENTS IN WORKSPACE ---\n\n  // 1. Company Mark Component\n  const companyMarkComp = figma.createComponent();\n  companyMarkComp.name = \"Company Mark / Initials\";\n  companyMarkComp.resize(56, 56);\n  companyMarkComp.cornerRadius = 12;\n  companyMarkComp.fills = [{ type: 'SOLID', color: COLOR_SURFACE_HOVER }];\n  companyMarkComp.strokes = [{ type: 'SOLID', color: COLOR_BORDER }];\n  companyMarkComp.strokeWeight = 1;\n  companyMarkComp.layoutMode = \"HORIZONTAL\";\n  companyMarkComp.primaryAxisAlignItems = \"CENTER\";\n  companyMarkComp.counterAxisAlignItems = \"CENTER\";\n\n  const markText = figma.createText();\n  markText.name = \"Initials\";\n  markText.fontName = { family: \"Poppins\", style: \"Bold\" };\n  markText.fontSize = 20;\n  markText.characters = \"S\";\n  markText.fills = [{ type: 'SOLID', color: COLOR_ORANGE }];\n  companyMarkComp.appendChild(markText);\n\n  // 2. Nav Item Component\n  const navItemComp = figma.createComponent();\n  navItemComp.name = \"Nav Item\";\n  navItemComp.layoutMode = \"HORIZONTAL\";\n  navItemComp.paddingLeft = 18;\n  navItemComp.paddingRight = 18;\n  navItemComp.paddingTop = 8;\n  navItemComp.paddingBottom = 8;\n  navItemComp.cornerRadius = 20;\n  \n  const navText = figma.createText();\n  navText.name = \"Label\";\n  navText.fontName = { family: \"Poppins\", style: \"Medium\" };\n  navText.fontSize = 15;\n  navText.characters = \"Home\";\n  navText.fills = [{ type: 'SOLID', color: COLOR_TEXT_PRIMARY }];\n  navItemComp.appendChild(navText);\n\n  // 3. Project Card Component\n  const projectCardComp = figma.createComponent();\n  projectCardComp.name = \"Project Card\";\n  projectCardComp.layoutMode = \"VERTICAL\";\n  projectCardComp.resize(600, 420);\n  projectCardComp.cornerRadius = 16;\n  projectCardComp.fills = [{ type: 'SOLID', color: COLOR_CARD_BG }];\n  projectCardComp.strokes = [{ type: 'SOLID', color: COLOR_BORDER }];\n  projectCardComp.strokeWeight = 1;\n  projectCardComp.itemSpacing = 0;\n  projectCardComp.clipsContent = true;\n\n  const imgContainer = figma.createFrame();\n  imgContainer.name = \"Image Container\";\n  imgContainer.layoutMode = \"HORIZONTAL\";\n  imgContainer.primaryAxisAlignItems = \"CENTER\";\n  imgContainer.counterAxisAlignItems = \"CENTER\";\n  imgContainer.resize(600, 280);\n  imgContainer.fills = [{ type: 'SOLID', color: { r: 0.06, g: 0.06, b: 0.08 } }];\n  imgContainer.layoutAlign = \"STRETCH\";\n\n  const cardContent = figma.createFrame();\n  cardContent.name = \"Content\";\n  cardContent.layoutMode = \"VERTICAL\";\n  cardContent.paddingLeft = 24;\n  cardContent.paddingRight = 24;\n  cardContent.paddingTop = 20;\n  cardContent.paddingBottom = 24;\n  cardContent.itemSpacing = 8;\n  cardContent.layoutAlign = \"STRETCH\";\n  cardContent.fills = [];\n\n  const clickTag = figma.createText();\n  clickTag.name = \"Tag\";\n  clickTag.fontName = { family: \"Poppins\", style: \"Semi Bold\" };\n  clickTag.fontSize = 12;\n  clickTag.characters = \"CLICK HERE TO VISIT\";\n  clickTag.fills = [{ type: 'SOLID', color: COLOR_ORANGE }];\n\n  const cardHeaderRow = figma.createFrame();\n  cardHeaderRow.name = \"Header Row\";\n  cardHeaderRow.layoutMode = \"HORIZONTAL\";\n  cardHeaderRow.layoutAlign = \"STRETCH\";\n  cardHeaderRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  cardHeaderRow.counterAxisAlignItems = \"CENTER\";\n  cardHeaderRow.fills = [];\n\n  const cardTitle = figma.createText();\n  cardTitle.name = \"Title\";\n  cardTitle.fontName = { family: \"Poppins\", style: \"Bold\" };\n  cardTitle.fontSize = 22;\n  cardTitle.characters = \"HTML TUTORIAL\";\n  cardTitle.fills = [{ type: 'SOLID', color: COLOR_TEXT_PRIMARY }];\n\n  cardHeaderRow.appendChild(cardTitle);\n\n  if (iconArrow) {\n    const arrowInst = iconArrow.createInstance();\n    recolorNode(arrowInst, COLOR_TEXT_PRIMARY);\n    cardHeaderRow.appendChild(arrowInst);\n  }\n\n  cardContent.appendChild(clickTag);\n  cardContent.appendChild(cardHeaderRow);\n  projectCardComp.appendChild(imgContainer);\n  projectCardComp.appendChild(cardContent);\n\n  // 4. Experience Entry Component\n  const expCardComp = figma.createComponent();\n  expCardComp.name = \"Experience Entry\";\n  expCardComp.layoutMode = \"HORIZONTAL\";\n  expCardComp.paddingLeft = 32;\n  expCardComp.paddingRight = 32;\n  expCardComp.paddingTop = 32;\n  expCardComp.paddingBottom = 32;\n  expCardComp.cornerRadius = 16;\n  expCardComp.itemSpacing = 24;\n  expCardComp.layoutAlign = \"STRETCH\";\n  expCardComp.fills = [{ type: 'SOLID', color: COLOR_SURFACE }];\n  expCardComp.strokes = [{ type: 'SOLID', color: COLOR_BORDER }];\n  expCardComp.strokeWeight = 1;\n\n  const markInst = companyMarkComp.createInstance();\n  expCardComp.appendChild(markInst);\n\n  const expContent = figma.createFrame();\n  expContent.name = \"Exp Content\";\n  expContent.layoutMode = \"VERTICAL\";\n  expContent.itemSpacing = 12;\n  expContent.layoutGrow = 1;\n  expContent.fills = [];\n\n  const expHeaderRow = figma.createFrame();\n  expHeaderRow.name = \"Exp Header\";\n  expHeaderRow.layoutMode = \"HORIZONTAL\";\n  expHeaderRow.layoutAlign = \"STRETCH\";\n  expHeaderRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  expHeaderRow.counterAxisAlignItems = \"CENTER\";\n  expHeaderRow.fills = [];\n\n  const expTitle = figma.createText();\n  expTitle.name = \"Role & Company\";\n  expTitle.fontName = { family: \"Poppins\", style: \"Bold\" };\n  expTitle.fontSize = 20;\n  expTitle.characters = \"Lead Software Engineer at Searchlight\";\n  expTitle.fills = [{ type: 'SOLID', color: COLOR_TEXT_PRIMARY }];\n\n  const expDate = figma.createText();\n  expDate.name = \"Dates\";\n  expDate.fontName = { family: \"Poppins\", style: \"Medium\" };\n  expDate.fontSize = 14;\n  expDate.characters = \"Nov 2019 – Present\";\n  expDate.fills = [{ type: 'SOLID', color: COLOR_ORANGE }];\n\n  expHeaderRow.appendChild(expTitle);\n  expHeaderRow.appendChild(expDate);\n\n  const expDesc = figma.createText();\n  expDesc.name = \"Description\";\n  expDesc.fontName = { family: \"Poppins\", style: \"Regular\" };\n  expDesc.fontSize = 15;\n  expDesc.lineHeight = { value: 160, unit: 'PERCENT' };\n  expDesc.characters = \"As a Lead Software Engineer at Searchlight, I played a pivotal role in developing innovative solutions for Searchlight’s core search algorithms. Collaborating with a dynamic team of engineers, I contributed to the enhancement of search accuracy and efficiency, optimizing user experiences for millions of users worldwide.\";\n  expDesc.fills = [{ type: 'SOLID', color: COLOR_TEXT_SECONDARY }];\n  expDesc.layoutAlign = \"STRETCH\";\n\n  expContent.appendChild(expHeaderRow);\n  expContent.appendChild(expDesc);\n  expCardComp.appendChild(expContent);\n\n  // Position components out of main frame space\n  companyMarkComp.x = 1600; companyMarkComp.y = 0;\n  navItemComp.x = 1600; navItemComp.y = 100;\n  projectCardComp.x = 1600; projectCardComp.y = 200;\n  expCardComp.x = 1600; expCardComp.y = 700;\n\n\n  // --- BUILD MAIN FRAME 01_Home ---\n  const homeFrame = figma.createFrame();\n  homeFrame.name = \"01_Home\";\n  homeFrame.resize(1440, 2800);\n  homeFrame.fills = [{ type: 'SOLID', color: COLOR_BG }];\n  homeFrame.layoutMode = \"VERTICAL\";\n  homeFrame.primaryAxisSizingMode = \"AUTO\";\n  homeFrame.itemSpacing = 0;\n\n  // 1. HEADER\n  const header = figma.createFrame();\n  header.name = \"Header\";\n  header.layoutMode = \"HORIZONTAL\";\n  header.resize(1440, 100);\n  header.paddingLeft = 80;\n  header.paddingRight = 80;\n  header.paddingTop = 24;\n  header.paddingBottom = 24;\n  header.layoutAlign = \"STRETCH\";\n  header.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  header.counterAxisAlignItems = \"CENTER\";\n  header.fills = [{ type: 'SOLID', color: COLOR_BG }];\n  header.strokes = [{ type: 'SOLID', color: COLOR_BORDER }];\n  header.strokeWeight = 1;\n\n  if (logoABM) {\n    const logoInst = logoABM.createInstance();\n    logoInst.resize(110, 62);\n    header.appendChild(logoInst);\n  }\n\n  const navContainer = figma.createFrame();\n  navContainer.name = \"Nav Menu\";\n  navContainer.layoutMode = \"HORIZONTAL\";\n  navContainer.itemSpacing = 8;\n  navContainer.paddingLeft = 8;\n  navContainer.paddingRight = 8;\n  navContainer.paddingTop = 6;\n  navContainer.paddingBottom = 6;\n  navContainer.cornerRadius = 24;\n  navContainer.fills = [{ type: 'SOLID', color: COLOR_SURFACE }];\n  navContainer.strokes = [{ type: 'SOLID', color: COLOR_BORDER }];\n  navContainer.strokeWeight = 1;\n\n  const navItemsData = [\n    { name: \"Home\", active: true },\n    { name: \"Projects\", active: false },\n    { name: \"Experience\", active: false },\n    { name: \"Contact\", active: false }\n  ];\n\n  for (const item of navItemsData) {\n    const nItem = navItemComp.createInstance();\n    const txtNode = nItem.findOne(n => n.name === \"Label\");\n    if (txtNode) txtNode.characters = item.name;\n\n    if (item.active) {\n      nItem.fills = [{ type: 'SOLID', color: COLOR_ORANGE }];\n      if (txtNode) txtNode.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n    } else {\n      nItem.fills = [];\n      if (txtNode) txtNode.fills = [{ type: 'SOLID', color: COLOR_TEXT_SECONDARY }];\n    }\n    navContainer.appendChild(nItem);\n  }\n\n  header.appendChild(navContainer);\n  homeFrame.appendChild(header);\n\n  // 2. HERO SECTION\n  const heroSection = figma.createFrame();\n  heroSection.name = \"Hero Section\";\n  heroSection.layoutMode = \"HORIZONTAL\";\n  heroSection.paddingLeft = 80;\n  heroSection.paddingRight = 80;\n  heroSection.paddingTop = 100;\n  heroSection.paddingBottom = 100;\n  heroSection.itemSpacing = 60;\n  heroSection.layoutAlign = \"STRETCH\";\n  heroSection.counterAxisAlignItems = \"CENTER\";\n  heroSection.fills = [];\n\n  const heroLeft = figma.createFrame();\n  heroLeft.name = \"Avatar Column\";\n  heroLeft.layoutMode = \"VERTICAL\";\n  heroLeft.primaryAxisAlignItems = \"CENTER\";\n  heroLeft.counterAxisAlignItems = \"CENTER\";\n  heroLeft.fills = [];\n\n  const avatarWrapper = figma.createFrame();\n  avatarWrapper.name = \"Avatar Wrapper\";\n  avatarWrapper.resize(240, 240);\n  avatarWrapper.cornerRadius = 120;\n  avatarWrapper.fills = [{ type: 'SOLID', color: COLOR_SURFACE }];\n  avatarWrapper.strokes = [{ type: 'SOLID', color: COLOR_ORANGE }];\n  avatarWrapper.strokeWeight = 4;\n  avatarWrapper.layoutMode = \"HORIZONTAL\";\n  avatarWrapper.primaryAxisAlignItems = \"CENTER\";\n  avatarWrapper.counterAxisAlignItems = \"CENTER\";\n\n  if (photoAvatar) {\n    const avatarInst = photoAvatar.createInstance();\n    avatarInst.resize(220, 220);\n    avatarInst.cornerRadius = 110;\n    avatarWrapper.appendChild(avatarInst);\n  }\n  heroLeft.appendChild(avatarWrapper);\n\n  const heroRight = figma.createFrame();\n  heroRight.name = \"Hero Text Column\";\n  heroRight.layoutMode = \"VERTICAL\";\n  heroRight.itemSpacing = 24;\n  heroRight.layoutGrow = 1;\n  heroRight.fills = [];\n\n  const heroHeadline = figma.createText