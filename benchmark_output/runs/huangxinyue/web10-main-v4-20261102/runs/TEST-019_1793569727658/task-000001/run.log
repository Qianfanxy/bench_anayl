='Logo';logo.setRangeFills(2,3,[paint('accent')]);c.appendChild(logo);\nconst n=frame('Navigation','HORIZONTAL');n.itemSpacing=40;n.counterAxisAlignItems='CENTER';\nfor(const l of ['Work','About','Playground','Contact']){const i=(l===pg?navV('Current'):navV('Default')).createInstance();i.name='Nav/'+l;setLabel(i,l);n.appendChild(i);}\nc.appendChild(n);hv.push(c);sec.appendChild(c);}\nconst header=figma.combineAsVariants(hv,sec);header.name='Header';header.layoutMode='VERTICAL';header.itemSpacing=24;header.paddingLeft=header.paddingRight=header.paddingTop=header.paddingBottom=24;header.primaryAxisSizingMode='AUTO';header.counterAxisSizingMode='AUTO';header.x=40;header.y=960;header.fills=[paint('surface')];header.cornerRadius=8;header.strokes=[{type:'SOLID',color:{r:0.6,g:0.35,b:0.95}}];header.dashPattern=[6,4];\n// Footer\nconst ft=figma.createComponent();ft.name='Footer';ft.layoutMode='HORIZONTAL';ft.resize(1440,120);ft.primaryAxisSizingMode='FIXED';ft.counterAxisSizingMode='AUTO';ft.primaryAxisAlignItems='SPACE_BETWEEN';ft.counterAxisAlignItems='CENTER';ft.paddingLeft=ft.paddingRight=120;ft.paddingTop=40;ft.paddingBottom=48;ft.fills=[paint('bg')];\nft.strokes=[paint('divider')];ft.strokeTopWeight=1;ft.strokeBottomWeight=0;ft.strokeLeftWeight=0;ft.strokeRightWeight=0;ft.strokeAlign='INSIDE';\nconst cp=await txt('Deniz Arslan ⏤ 2020','Small','text-secondary');cp.name='Copyright';ft.appendChild(cp);\nconst so=frame('Social','HORIZONTAL');so.itemSpacing=32;for(const l of ['Artstation','LinkedIn','Twitter']){const i=tlV('S').createInstance();i.name='Social/'+l;setLabel(i,l);so.appendChild(i);}ft.appendChild(so);\nsec.appendChild(ft);ft.x=40;ft.y=1260;\n// Status tag\nconst tag=figma.createComponent();tag.name='StatusTag';tag.layoutMode='HORIZONTAL';tag.primaryAxisSizingMode='AUTO';tag.counterAxisSizingMode='AUTO';tag.counterAxisAlignItems='CENTER';tag.itemSpacing=8;tag.paddingLeft=12;tag.paddingRight=14;tag.paddingTop=6;tag.paddingBottom=6;tag.cornerRadius=999;tag.fills