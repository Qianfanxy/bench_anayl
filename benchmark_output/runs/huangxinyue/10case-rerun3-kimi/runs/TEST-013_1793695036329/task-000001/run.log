Transform:[[scale,0,0],[0,scale,0]]}]; return inst; }\nfunction spacer(w,h){ const s=rect(w,h,null,0); s.fills=[]; return s; }\n\nconst xSet = await figma.getNodeByIdAsync('26:239');\nconst tbSet = await figma.getNodeByIdAsync('15:134');\nconst sbSet = await figma.getNodeByIdAsync('15:155');\n\nconst f = figma.createFrame(); f.name='03_Explore'; f.resize(390,844); f.fills=[{type:'SOLID',color:C('#F4F6F8')}]; f.x=920; f.y=0; WS.appendChild(f);\nf.layoutMode='VERTICAL'; f.primaryAxisSizingMode='FIXED'; f.counterAxisSizingMode='FIXED'; f.itemSpacing=0;\n\nconst scroll = figma.createFrame(); scroll.name='Content'; scroll.fills=[];\nscroll.layoutMode='VERTICAL'; scroll.paddingLeft=24; scroll.paddingRight=24; scroll.paddingTop=63; scroll.itemSpacing=0; scroll.counterAxisSizingMode='FIXED'; scroll.primaryAxisSizingMode='FIXED'; scroll.resize(390,756);\nf.appendChild(scroll);\n\nconst header=txt('Explore',20,'Black','#192126'); header.name='header'; scroll.appendChild(header);\nscroll.appendChild(spacer(1,16));\n\n// Banner\nconst banner=figma.createFrame(); banner.name='Banner'; banner.resize(342,124); banner.fills=[{type:'SOLID',color:C('#192126')}]; banner.cornerRadius=20;\nconst bph=photoInst('Photo_Quarantine_Workout',152,124,20,1.35); bph.x=190; bph.y=0; banner.appendChild(bph);\nconst bgrad=rect(200,124,null,0); bgrad.x=120; bgrad.y=0;\nbgrad.fills=[{type:'GRADIENT_LINEAR', gradientTransform:[[1,0,0],[0,1,0]], gradientStops:[{position:0,color:{r:0.098,g:0.129,b:0.149,a:1}},{position:1,color:{r:0.098,g:0.129,b:0.149,a:0}}]}];\n// rotate gradient horizontally: gradientTransform maps; use rotation via transform: for horizontal, transform = [[0,-1,1],[1,0,0]]? We'll compute below.\nbanner.appendChild(bgrad);\nconst bt=txt('Best Quarantine\\nWorkout',16,'Black','#FFFFFF'); bt.lineHeight={value:22,unit:'PIXELS'}; bt.x=18; bt.y=26; banner.appendChild(bt);\nconst smChip=rect(96,26,'#BBF246',13); smChip.x=18; smChip.y=124-18-26; banner.appendChild(smChip);\nconst smT=txt('See