await txt(cc,price,12,'SemiBold',brand,'price');\n      const chT=await txt(cc,ch,11,'SemiBold',dir==='gain'?gain:loss,'change');\n      chT.textAutoResize='NONE';chT.resize(54,14);chT.textAlignHorizontal='RIGHT';\n      cc.resizeWithoutConstraints(343,26);\n      ids.coinRow[name]=cc.id;\n    }\n\n    // ---- Row/Share factory ----\n    ids.share={};\n    const SHARES=[[\"Polygon (MATIC)\",\"MATIC\",\"2:35\",\"50.00%\"],[\"Decentraland (MANA)\",\"MANA\",\"2:47\",\"25.00%\"],[\"PancakeSwap (CAKE)\",\"CAKE\",\"2:44\",\"12.50%\"],[\"Dogecoin (DOGE)\",\"DOGE\",\"2:29\",\"6.25%\"],[\"Maker (MKR)\",\"MKR\",\"2:50\",\"6.25%\"]];\n    for(const [name,tick,cid,pct] of SHARES){\n      const cc=newComp('Row/Share · '+name,343,24);\n      cc.layoutMode='HORIZONTAL';cc.primaryAxisSizingMode='FIXED';cc.counterAxisSizingMode='FIXED';\n      cc.paddingLeft=8;cc.paddingRight=8;cc.itemSpacing=8;cc.counterAxisAlignItems='CENTER';cc.fills=[];\n      await coin(cid,18,cc,'logo');\n      await txt(cc,name,12,'Medium',brand,'name');\n      spacer(cc);\n      const pt=await txt(cc,pct,12,'SemiBold',brand,'pct');\n      pt.textAutoResize='NONE';pt.resize(56,16);pt.textAlignHorizontal='RIGHT';\n      cc.resizeWithoutConstraints(343,24);\n      ids.share[name]=cc.id;\n    }\n\n    // ---- Header/Wallet ----\n    c=newComp('Header/Wallet',343,44);\n    c.layoutMode='HORIZONTAL';c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';\n    c.itemSpacing=10;c.counterAxisAlignItems='CENTER';c.fills=[];\n    const av=(await figma.getNodeByIdAsync(\"2:65\")).createInstance();av.name='avatar';av.resize(40,40);c.appendChild(av);\n    const col=vcol('col',1);c.appendChild(col);\n    await txt(col,'My Wallet',15,'Bold',brand,'title');\n    await txt(col,'0xc8...320f',11,'Medium',ink3,'addr');\n    spacer(c);\n    const sb=figma.createFrame();sb.name='scanBtn';sb.resize(40,40);sb.cornerRadius=20;sb.fills=[solid(white)];sb.layoutMode='HORIZONTAL';sb.primaryAxisSizingMode='FIXED';sb.counterAxisSi