t Row'));\nconst btc8=rows8.find(r=>{const t=findKid(r,'ticker');return t&&t.characters==='BTC';});\nL(btc8,ids['10']);\n// bank nav on 03,04,05\nconst navMap={'tab Trans.':'04','tab Home':'03','tab Profile':'05'};\n['03','04','05'].forEach(k=>{\n  const scr=byName({03:'03_Bank_Home',04:'04_Bank_Transactions',05:'05_Profile'}[k]);\n  const nav=scr.children.find(c=>c.name==='Bank Nav Bar');\n  nav.children.forEach(tab=>{if(navMap[tab.name])L(tab,ids[navMap[tab.name]]);});\n});\n// trade nav on 07,08,09,10\nconst tMap={'tab Home':'07','tab Markets':'08','tab Exchange':'09'};\n['07','08','09','10'].forEach(k=>{\n  const scr=byName({07:'07_Trade_Home',08:'08_Market',09:'09_Exchange_Stock',10:'10_Exchange_Crypto'}[k]);\n  const nav=scr.children.find(c=>c.name==='Trade Nav Bar');\n  nav.children.forEach(tab=>{if(tMap[tab.name])L(tab,ids[tMap[tab.name]]);});\n});\nreturn JSON.stringify({ids,count});","description":"Wire all prototype links between the 10 frames"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"2a07d38d-5d51-448b-bf79-cabdc4345135","uuid":"c88f78a1-c152-4fd0-9ba7-b0f9f484d2ab","timestamp":"2026-10-30T23:06:10.178Z","tool_use_meta":[{"id":"mcp__figma__use_figma_37_f8e5d8a7","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
