 'MIN'; f.counterAxisAlignItems = o.cross || 'MIN';\n  f.primaryAxisSizingMode = 'AUTO'; f.counterAxisSizingMode = 'AUTO'; return f;\n}\nfunction solid(n, c) { n.fills = [{ type: 'SOLID', color: c }]; }\nfunction gap(n, px) { const s = F('gap'); s.resize(px, px); n.appendChild(s); return s; }\nconst compById = async id => await figma.getNodeByIdAsync(id);\nconst compByName = async name => await figma.getNodeByIdAsync(lib.findOne(n => n.type === 'COMPONENT' && n.name === name).id);\nfunction eyebrow(txt) { return T(txt, { size: 13, style: 'Bold', color: C.amberD, ls: 16 }); }\n\nconst home = await figma.getNodeByIdAsync('16:164');\n\n// ---------- About section (2 agency intros) ----------\nconst about = F('About'); solid(about, C.white);\nAL(about, { dir: 'VERTICAL', gap: 80, pad: [96, 80, 96, 80] });\nhome.appendChild(about); about.layoutSizingHorizontal = 'FILL';\n\nasync function introRow(eyebrowTxt, heading, copy, imgRight) {\n  const rowF = F('Intro row'); AL(rowF, { dir: 'HORIZONTAL', gap: 72, cross: 'CENTER' });\n  about.appendChild(rowF); rowF.layoutSizingHorizontal = 'FILL';\n  const txtCol = F('Text'); AL(txtCol, { dir: 'VERTICAL', gap: 16 });\n  const imgCol = F('Photo'); imgCol.cornerRadius = 20; imgCol.clipsContent = true;\n  if (imgRight) { rowF.appendChild(txtCol); rowF.appendChild(imgCol); }\n  else { rowF.appendChild(imgCol); rowF.appendChild(txtCol); }\n  txtCol.layoutSizingHorizontal = 'FILL';\n  imgCol.layoutSizingHorizontal = 'FIXED'; imgCol.layoutSizingVertical = 'FIXED';\n  imgCol.resize(560, 380);\n  const photo = (await compById('3:20')).createInstance();\n  imgCol.appendChild(photo); photo.resize(560, 380);\n  txtCol.appendChild(eyebrow(eyebrowTxt));\n  txtCol.appendChild(T(heading, { size: 36, style: 'Bold', ls: -1, lh: 44 }));\n  const copyT = T(copy, { size: 17, color: C.body, lh: 28 });\n  txtCol.appendChild(copyT); copyT.layoutSizingHorizontal = 'FILL';\n  gap(txtCol, 8);\n  const link = (await compByName('Link / Arrow')).createInstance();\n  link.findOne(n => n.type === 'TEXT').characters = 'Learn more';\n  txtCol.appendChild(link);\n  return rowF;\n}\n\nawait introRow(\n  'WHY NORTHGATE',\n  'You’re in good hands',\n  'Our agents have helped more than 2,000 families buy, sell and rent. We listen first, explain every step and stay with you until the keys are in your hand.',\n  true\n);\nawait introRow(\n  'LOCAL KNOWLEDGE',\n  'Local experts on every street',\n  'We live where we work. From school catchments to the quietest blocks, we can tell you what the listing photos don’t.',\n  false\n);\n\n// ---------- Testimonial ----------\nconst testi = F('Testimonial'); solid(testi, C.dark);\nAL(testi, { dir: 'VERTICAL', gap: 40, pad: [96, 240, 96, 240], align: 'CENTER', cross: 'CENTER' });\nhome.appendChild(testi); testi.layoutSizingHorizontal = 'FILL';\nconst quote = T('“Kayley and the team found us a home we love in under a month. They knew every street, never pushed us, and we always felt in good hands.”', { size: 28, style: 'Medium', color: C.white, lh: 42, align: 'CENTER' });\ntesti.appendChild(quote); quote.layoutSizingHorizontal = 'FILL';\nconst clientsRow = F('Clients'); AL(clientsRow, { dir: 'HORIZONTAL', gap: 12 });\ntesti.appendChild(clientsRow);\nconst clientComp = await compByName('Testimonial / Client');\nconst clientCurComp = await compByName('Testimonial / Client / Current');\nfor (const [name, isCurrent] of [['Leo Madrigal', true], ['Owen Brooks', false], ['Mia Chen', false]]) {\n  const ci = isCurrent ? clientCurComp.createInstance() : clientComp.createInstance();\n  const texts = ci.findAll(n => n.type === 'TEXT');\n  const nameT = texts.find(t => t.fontSize === 15);\n  const roleT = texts.find(t => t.fontSize === 12);\n  if (nameT) nameT.characters = name;\n  if (roleT) roleT.characters = 'Client';\n  clientsRow.appendChild(ci);\n}\n\n// ---------- CTA band ----------\nconst cta = F('CTA'); solid(cta, C.tint);\nAL(cta, { dir: 'HORIZONTAL', pad: [96, 80, 96, 80], align: 'SPACE_BETWEEN', cross: 'CENTER' });\nhome.appendChild(cta); cta.layoutSizingHorizontal = 'FILL';\nconst ctaLeft = F('Text'); AL(ctaLeft, { dir: 'VERTICAL', gap: 16 });\ncta.appendChild(ctaLeft);\nctaLeft.appendChild(eyebrow('SELL WITH US'));\nctaLeft.appendChild(T('Ready to sell your home?', { size: 40, style: 'Bold', ls: -1 }));\nconst ctaCopy = T('Get a free valuation and a clear plan to sell at the right price, on your timeline.', { size: 17, color: C.body, lh: 28 });\nctaLeft.appendChild(ctaCopy);\nctaLeft.layoutSizingHorizontal = 'FIXED'; ctaLeft.resize(620, ctaLeft.height);\nconst ctaLink = (await compByName('Link / Arrow')).createInstance();\nctaLink.findOne(n => n.type === 'TEXT').characters = 'Learn more';\ncta.appendChild(ctaLink);\n\n// ---------- Footer ----------\nhome.appendChild((await compByName('Footer')).createInstance());\n\nreturn JSON.stringify({ homeH: Math.round(home.height) });\n","description":"Build 01_Home step 3: about intros, testimonial, CTA, footer"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"8420bd2b-08e1-4650-9759-ee0744cf2f7f","uuid":"7dedab3f-5f56-4fb5-972c-3e1b10ee7943","timestamp":"2026-11-02T00:06:13.565Z","tool_use_meta":[{"id":"mcp__figma__use_figma_51_abf81deb","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
