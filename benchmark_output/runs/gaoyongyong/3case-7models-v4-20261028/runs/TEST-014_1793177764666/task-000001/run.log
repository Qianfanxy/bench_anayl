p:12,w:355,h:116}); c.appendChild(car); car.clipsContent=true; car.overflowDirection='HORIZONTAL';\nfor(const [art,num,exp,pri] of [['Green','**** **** **** 3447','09/24',true],['Pink','**** **** **** 8821','03/26',false],['Purple','**** **** **** 5104','11/25',false]]){const p=await inst('2010:440','Art='+art); setP(p,{Number:num,Expiry:exp,'Show Primary':pri}); p.name='Card '+num.slice(-4); car.appendChild(p); p.rescale(0.63);}\nconst xsh=await inst('2009:341'); setP(xsh,{Title:'Transactions',Action:'See all','Show Action':true}); xsh.name='Transactions header'; add(c,xsh,{fillW:true});\nawait txList(c);\nawait finish(f,{nav:'Profile'}); out.s08=f.id;\nf=await screen('09_Analytics',8);\nawait header(f,'Analytics',{'Show Avatar':true,'Show More':true});\nc=content(f,112,12);\nconst sw=await inst('2008:296','View=Income'); sw.name='Income / Expenses'; c.appendChild(sw);\nconst tot=Fr('Totals',{dir:'HORIZONTAL',gap:11}); add(c,tot,{fillW:true});\nfor(const [l,v,tk,dk] of [['Total income','$29,231.03','brand/primary',true],['Total expenses','$1,999.00','surface/default',false]]){const k=Fr(l,{dir:'VERTICAL',gap:4,pad:[14,16],r:20,fill:tk,fx:dk?null:'Elevation/Card'}); add(tot,k,{grow:true}); k.appendChild(await T(l,'Caption/Medium',dk?'text/primary':'text/secondary')); k.appendChild(await T(v,'Heading/H2','text/primary','Value'));}\nconst bd=Fr('Income breakdown',{dir:'VERTICAL',gap:12,pad:[16],r:24,fill:'surface/default',ai:'CENTER',fx:'Elevation/Card'}); add(c,bd,{fillW:true});\nconst bdh=Fr('Header',{dir:'HORIZONTAL',jc:'SPACE_BETWEEN',ai:'CENTER'}); add(bd,bdh,{fillW:true}); bdh.appendChild(await T('Income breakdown','Heading/H3'));\nconst per=await inst('2014:1174'); per.name='Period'; bdh.appendChild(per);\nconst dn=await inst('2010:602'); dn.rescale(0.85); bd.appendChild(dn);\nconst lg=Fr('Legend',{dir:'VERTICAL',gap:0}); add(bd,lg,{fillW:true});\nfor(const [l,a,s,tk] of [['Sales','$15,190.00','52%','chart/1'],['Investment','$11,451.03','39%','chart/2'],['Other