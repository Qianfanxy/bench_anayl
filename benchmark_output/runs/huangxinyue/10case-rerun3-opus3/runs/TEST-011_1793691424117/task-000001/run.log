ame(); f.name=name; f.fills=fill?solid(fill,o.op??1):[]; if(o.r!=null) f.cornerRadius=o.r; if(o.w) f.resize(o.w,o.h||o.w); return f;}\nfunction recolor(n,color){ if('children' in n) n.children.forEach(c=>{ if(c.fills&&c.fills.length&&c.fills[0].visible!==false) c.fills=solid(color); if(c.strokes&&c.strokes.length) c.strokes=solid(color); recolor(c,color);}); }\nasync function icon(name,color,size=24){const comp=await figma.getNodeByIdAsync(ICON[name]); const i=comp.createInstance(); i.name='Icon_'+name; if(size!==24) i.rescale(size/24); recolor(i,color); return i;}\nasync function photo(id,w,h,r){const c=await figma.getNodeByIdAsync(id); const i=c.createInstance(); i.name='Photo'; i.resize(w,h); if(r!=null) i.cornerRadius=r; return i;}\nconst shadow=(a=0.08,y=8,r=24)=>[{type:'DROP_SHADOW',color:{r:0.098,g:0.129,b:0.149,a},offset:{x:0,y},radius:r,spread:0,visible:true,blendMode:'NORMAL'}];\nfunction comp(name){const c=figma.createComponent(); c.name=name; c.fills=[]; return c;}\nconst dk=hex(C.dark);\nconst grad=(tr,stops)=>[{type:'GRADIENT_LINEAR',gradientTransform:tr,gradientStops:stops.map(([p,a])=>({position:p,color:{...dk,a}}))}];\nconst V=[[0,1,0],[-1,0,1]], H=[[1,0,0],[0,1,0]];\nfunction circleBtn(size,fill,op=1){const f=F('Play Button',fill,{op,r:size/2,w:size,h:size}); return f;}\nfunction bindSet(set,nodeName,prop,def){const k=set.addComponentProperty(prop,'TEXT',def); set.children.forEach(v=>{const n=v.findOne(x=>x.name===nodeName&&x.type==='TEXT'); if(n) n.componentPropertyReferences={characters:k};}); }\nfunction bindSwap(set,photoDef){const k=set.addComponentProperty('Photo','INSTANCE_SWAP',photoDef); const vs=set.type==='COMPONENT_SET'?set.children:[set]; vs.forEach(v=>{const n=v.findOne(x=>x.name==='Photo'&&x.type==='INSTANCE'); n.componentPropertyReferences={mainComponent:k};});}\nfunction bindText(c,node,prop){const k=c.addComponentProperty(prop,'TEXT',node.characters); node.componentPropertyReferences={characters:k};}\nconst lib=await figma.getNode