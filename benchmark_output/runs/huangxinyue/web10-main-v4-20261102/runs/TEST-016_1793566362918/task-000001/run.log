dir:'H',gap:6,pad:[0,16],ai:'CENTER',jc:'CENTER',h:40,r:10,fill:C.brandSoft}); b3.appendChild(T('+ Invite',14,'SB',C.brand,'Label')); b3.layoutSizingHorizontal='HUG'; put(b3,180,1720); out.b3=b3.id;\nconst ibs=[]; for(const st of ['Primary','Soft','Outline']){const c=CP('Style='+st,{dir:'H',ai:'CENTER',jc:'CENTER',w:40,h:40,r:12,fill:st==='Primary'?C.brand:st==='Soft'?C.brandSoft:C.white,stroke:st==='Outline'?C.border:null}); c.appendChild(await icon('Plus',st==='Primary'?C.white:st==='Soft'?C.brand:C.text,20)); sec.appendChild(c); ibs.push(c);}\nconst ibSet=figma.combineAsVariants(ibs,sec); ibSet.name='Icon Button'; ibSet.layoutMode='HORIZONTAL'; ibSet.itemSpacing=12; ibSet.paddingLeft=ibSet.paddingRight=ibSet.paddingTop=ibSet.paddingBottom=12; ibSet.layoutSizingHorizontal='HUG';ibSet.layoutSizingVertical='HUG'; ibSet.x=320; ibSet.y=1720; out.ib=ibSet.id;\n// Tags\nconst tagC={Design:C.brand,Research:C.cyan,Planning:C.orange,Content:C.green}; const tags=[];\nfor(const [k,col] of Object.entries(tagC)){const c=CP('Type='+k,{dir:'H',pad:[3,10],r:6,fill:col,fo:0.12}); c.appendChild(T(k,12,'SB',col,'Label')); sec.appendChild(c); tags.push(c);}\nconst tagSet=figma.combineAsVariants(tags,sec); tagSet.name='Tag'; tagSet.layoutMode='HORIZONTAL'; tagSet.itemSpacing=12; tagSet.paddingLeft=tagSet.paddingRight=tagSet.paddingTop=tagSet.paddingBottom=12; tagSet.layoutSizingHorizontal='HUG';tagSet.layoutSizingVertical='HUG'; tagSet.x=520; tagSet.y=1720; out.tag=tagSet.id;\n// Segment tab\nconst segs=[]; for(const st of ['Default','Current']){const c=CP('State='+st,{dir:'H',pad:[6,14],r:8,fill:st==='Current'?C.white:null}); if(st==='Current') c.effects=[{type:'DROP_SHADOW',color:{r:.11,g:.11,b:.3,a:.08},offset:{x:0,y:2},radius:6,spread:0,visible:true,blendMode:'NORMAL'}]; c.appendChild(T('Monthly',13,st==='Current'?'SB':'M',st==='Current'?C.brand:C.text2,'Label')); sec.appendChild(c); segs.push(c);}\nconst segSet=figma.combineAsVariants(segs,sec); segSet.name='Segment Tab'; segSet.layoutMode='HORIZONTAL'; segSet.itemSpacing=12; segSet.paddingLeft=segSet.paddingRight=segSet.paddingTop=segSet.paddingBottom=12; segSet.layoutSizingHorizontal='HUG';segSet.layoutSizingVertical='HUG'; segSet.fills=S(C.bg); segSet.x=860; segSet.y=1720; out.seg=segSet.id;\n// Settings tab\nconst sts=[]; for(const st of ['Default','Hover','Current']){const c=CP('State='+st,{dir:'H',pad:[12,4],fill:null}); c.strokes=S(st==='Current'?C.brand:st==='Hover'?C.muted:C.white,st==='Default'?0:1); c.strokeAlign='INSIDE'; c.strokeTopWeight=0;c.strokeLeftWeight=0;c.strokeRightWeight=0;c.strokeBottomWeight=2; c.appendChild(T('My details',14,st==='Current'?'SB':'M',st==='Current'?C.brand:st==='Hover'?C.text:C.text2,'Label')); sec.appendChild(c); sts.push(c);}\nconst stSet=figma.combineAsVariants(sts,sec); stSet.name='Settings Tab'; stSet.layoutMode='HORIZONTAL'; stSet.itemSpacing=16; stSet.paddingLeft=stSet.paddingRight=stSet.paddingTop=stSet.paddingBottom=12; stSet.layoutSizingHorizontal='HUG';stSet.layoutSizingVertical='HUG'; stSet.x=1100; stSet.y=1720; out.st=stSet.id;\n// Chip\nconst chip=CP('Collaborator Chip',{dir:'H',gap:6,pad:[4,12,4,4],ai:'CENTER',r:999,fill:C.bg}); add(chip,await av('Charmie',24),T('Angela',13,'M',C.text,'Name')); put(chip,1400,1720); out.chip=chip.id;\n// Stat card\nconst sc=CP('Stat Card',{dir:'V',gap:16,pad:20,w:276,r:16,fill:C.white,shadow:1});\nconst r1=F('Top',{dir:'H',gap:12,ai:'CENTER'}); const icw=F('Icon Wrap',{dir:'H',ai:'CENTER',jc:'CENTER',w:44,h:44,r:12,fill:C.brand,fo:0.12}); icw.appendChild(await icon('Checklist',C.brand,22));\nconst lv=F('Text',{dir:'V',gap:0}); add(lv,T('Task Completed',13,'M',C.text2,'Label'),T('08',26,'B',C.text,'Value'));\nconst sp=figma.createVector(); sp.name='Trend'; sp.vectorPaths=[{windingRule:'NONE',data:'M 0 30 C 10 30 14 18 24 20 C 34 22 38 8 48 10 C 58 12 62 24 72 14 C 78 8 82 4 88 2'}]; sp.strokes=S(C.brand); sp.strokeWeight=2.5; sp.strokeCap='ROUND'; sp.fills=[];\nadd(r1,icw,lv); fillW(lv); const top=F('Header',{dir:'H',ai:'CENTER',jc:'SPACE_BETWEEN'}); add(top,r1,sp);\nconst ch=figma.createText(); ch.fontName={family:'DM Sans',style:'Regular'}; ch.fontSize=13; ch.characters='10+ more from last week'; ch.fills=S(C.text2); ch.setRangeFontName(0,3,{family:'DM Sans',style:'Bold'}); ch.setRangeFills(0,3,S(C.green)); ch.name='Change';\nadd(sc,top,ch); fillW(top); put(sc,40,1820); out.sc=sc.id;\n// Task row\nconst tr=CP('Task Row',{dir:'H',gap:20,pad:[16,20],ai:'CENTER',w:820,r:14,fill:C.bg});\nconst play=F('Play',{dir:'H',ai:'CENTER',jc:'CENTER',w:44,h:44,r:22,fill:C.brand}); play.appendChild(await icon('Play',C.white,18));\nconst sf=F('Start',{dir:'V',gap:4,w:112}); const tm=F('Time',{dir:'H',gap:6,ai:'CENTER'}); add(tm,await icon('Clock',C.brand,16),T('9.00 am',14,'SB',C.text,'Time')); add(sf,T('Start from',12,'R',C.muted,'Caption'),tm); sf.layoutSizingVertical='HUG';\nconst dv=F('Divider',{w:1,h:40,fill:C.border});\nconst body=F('Body',{dir:'V',gap:6}); const meta=F('Meta',{dir:'H',gap:16,ai:'CENTER'});\nconst lk=F('Link',{dir:'H',gap:6,ai:'CENTER'}); add(lk,await icon('Link',C.text2,16),T('inspiration.example.com',13,'R',C.text2,'URL'));\nconst cm=F('Comments',{dir:'H',gap:6,ai:'CENTER'}); add(cm,await icon('Comment',C.text2,16),T('8 comments',13,'R',C.text2,'Count'));\nadd(meta,lk,cm); add(body,T('Search Inspiration for project',15,'SB',C.text,'Title'),meta);\nconst pr=F('Progress',{dir:'V',gap:8,w:150}); const pt=T('24% complete',12,'M',C.text2,'Percent'); const track=F('Track',{w:150,h:6,r:3,fill:C.border}); const bar=figma.createRectangle(); bar.name='Fill'; bar.resize(36,6); bar.cornerRadius=3; bar.fills=S(C.brand); track.appendChild(bar); add(pr,pt,track); pr.layoutSizingVertical='HUG';\nconst rem=F('Reminder',{dir:'H',gap:6,pad:[0,14],ai:'CENTER',h:38,r:10,fill:C.white,stroke:C.border}); add(rem,await icon('Bell',C.brand,16),T('Reminder',13,'M',C.text,'Label'));\nadd(tr,play,sf,dv,body,pr,rem); fillW(body); put(tr,360,1820); out.tr=tr.id;\n// Message row set\nco