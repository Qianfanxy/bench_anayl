{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_91da9ca2bf9f419eb3514a7d","name":"mcp__figma__use_figma","input":{"code":"const page = await figma.getNodeByIdAsync(\"5:2\");\nawait figma.setCurrentPageAsync(page);\nasync function M(id){return await figma.getNodeByIdAsync(id);}\nfunction hex(h){const n=parseInt(h.slice(1),16);return{r:((n>>16)&255)/255,g:((n>>8)&255)/255,b:(n&255)/255};}\nfunction solid(h,o){return{type:\"SOLID\",color:hex(h),opacity:o===undefined?1:o};}\nfunction nav(dest){return[{trigger:{type:\"ON_CLICK\"},action:{type:\"NODE\",destinationId:dest,navigation:\"NAVIGATE\"}}];}\nconst ID={s1:\"13:39\",s2:\"13:59\",s3:\"13:85\",s4:\"13:113\",s5:\"14:108\",s6:\"14:151\",s7:\"14:200\",s8:\"14:222\",s9:\"17:345\",s10:\"18:345\",s11:\"19:527\",s12:\"20:619\",s13:\"21:637\",s14:\"21:707\",s15:\"21:731\"};\nasync function F(id){return await M(id);}\nfunction txt(fr,chars){return fr.children.find(n=>n.type===\"TEXT\"&&n.characters===chars);}\nfunction compInst(fr,cid){return fr.children.filter(n=>n.type===\"INSTANCE\"&&n.mainComponent&&n.mainComponent.id===cid);}\nfunction wire(node,dest){node.reactions=nav(dest);}\nconst f1=await F(ID.s1);\nf1.reactions=[{trigger:{type:\"AFTER_DELAY\",timeout:2000},action:{type:\"NODE\",destinationId:ID.s2,navigation:\"NAVIGATE\"}},{trigger:{type:\"ON_CLICK\"},action:{type:\"NODE\",destinationId:ID.s2,navigation:\"NAVIGATE\"}}];\nconst f2=await F(ID.s2); wire(compInst(f2,\"12:67\")[0],ID.s3); wire(txt(f2,\"Skip\"),ID.s5);\nconst f3=await F(ID.s3); wire(compInst(f3,\"12:67\")[0],ID.s4); wire(compInst(f3,\"12:70\")[0],ID.s2); wire(txt(f3,\"Skip\"),ID.s5);\nconst f4=await F(ID.s4); wire(compInst(f4,\"12:67\")[0],ID.s5); wire(compInst(f4,\"12:70\")[0],ID.s3); wire(txt(f4,\"Skip\"),ID.s5);\nconst f5=await F(ID.s5);\nwire(compInst(f5,\"2:24\")[0],ID.s8);\nwire(txt(f5,\"Forgot Password?\"),ID.s7);\nwire(txt(f5,\"Sign Up\"),ID.s6);\nconst f6=await F(ID.s6);\nwire(compInst(f6,\"2:24\")[0],ID.s8);\nwire(txt(f6,\"Login\"),ID.s5);\nconst f7=await F(ID.s7);\nwire(compInst(f7,\"4:60\")[0],ID.s5);\nwire(compInst(f7,\"2:24\")[0],ID.s5);\nconst f8=await F(ID.s8);\nwire(compInst(f8,\"2:24\")[0],ID.s9);\nfunction addTabs(fr,navY,map){\n  for(const k of Object.keys(map)){\n    const i=parseInt(k);\n    const hs=figma.createRectangle(); hs.resize(75,84); hs.fills=[solid(\"#FFFFFF\",0.02)];\n    hs.name=\"Hotspot · Tab \"+[\"Home\",\"Wishlist\",\"Cart\",\"Search\",\"Setting\"][i];\n    fr.appendChild(hs); hs.x=i*75; hs.y=navY;\n    wire(hs,map[k]);\n  }\n}\nconst f9=await F(ID.s9);\naddTabs(f9,1696,{2:ID.s12,4:ID.s15});\nconst trendHdr=f9.findOne(n=>n.type===\"TEXT\"&&n.characters===\"Trending Products\");\nlet hp=trendHdr; while(hp&&hp.type!==\"INSTANCE\")hp=hp.parent;\nif(hp){const hs=figma.createRectangle();hs.resize(80,30);hs.fills=[solid(\"#FFFFFF\",0.02)];hs.name=\"Hotspot · View all\";f9.appendChild(hs);hs.x=hp.x+hp.width-78;hs.y=hp.y-5;wire(hs,ID.s10);}\nconst spons=f9.children.find(n=>n.type===\"INSTANCE\"&&Math.abs(n.y-1300)<2);\nif(spons)wire(spons,ID.s11);\nconst f10=await F(ID.s10);\naddTabs(f10,1906,{0:ID.s9,2:ID.s12,4:ID.s15});\nconst f11=await F(ID.s11);\nwire(compInst(f11,\"4:60\")[0],ID.s9);\nconst gtc=compInst(f11,\"12:70\").find(i=>{const t=i.findAll(n=>n.type===\"TEXT\");return t[0]&&t[0].characters===\"Go to cart\";});\nif(gtc)wire(gtc,ID.s12);\naddTabs(f11,1596,{0:ID.s9,2:ID.s12,4:ID.s15});\nconst f12=await F(ID.s12);\nwire(compInst(f12,\"4:60\")[0],ID.s11);\nwire(compInst(f12,\"2:24\")[0],ID.s13);\nconst f13=await F(ID.s13);\nwire(compInst(f13,\"4:60\")[0],ID.s12);\nwire(compInst(f13,\"2:24\")[0],ID.s14);\naddTabs(f13,728,{0:ID.s9,4:ID.s15});\nconst f14=await F(ID.s14);\nconst dlg=f14.children.find(n=>n.type===\"FRAME\"&&n.name===\"Success Dialog\");\nif(dlg)wire(dlg,ID.s9);\nconst f15=await F(ID.s15);\nwire(compInst(f15,\"4:60\")[0],ID.s9);\nreturn JSON.stringify({wired:true});","description":"Wire all prototype reactions: splash auto-advance, onboarding flow, auth links, nav tab hotspots, purchase flow","fileKey":"tB1sUry3dJDspx8uxl0ftc"}}],"id":"40cb0984-5b1e-4a59-a7f3-fa8481008753","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"27c02197-3252-480f-900a-884ff728e974","uuid":"8eda5669-263c-49ff-a06e-01ec6693c35b","timestamp":"2026-10-30T20:51:35.190Z","tool_use_meta":[{"id":"call_91da9ca2bf9f419eb3514a7d","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
