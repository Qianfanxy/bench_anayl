  "raw_behavior_definitions": {
    "screen_coverage": "Fraction of required final-named screens with at least one successful screenshot targeting a final root frame ID. Whole-page/composite screenshots do not count; old/replaced IDs do not count. Denominator from full delivered requirement text, not truncated artifact brief.",
    "recheck_coverage": "Fraction of required final screens with a successful screenshot, an intervening successful mutation script after receiving its result, and a later successful screenshot of the same final frame ID. The mutation may affect another screen; this is an observable sequence, not proof of visual repair.",
    "script_error_rate": "Observed error results / use_figma calls. Detect explicit is_error/success=false and error prefixes; not all logical failures or rendering problems.",
    "audit_read_calls": "Successful use_figma script without detected mutation, containing a node traversal and text/reaction/name/count inspection. Does not prove correctness or full acceptance.",
    "instance_write_share": "Fraction of successful mutation scripts syntactically containing createInstance or clone. Code presence is not executed instance count, supplied-media reuse, or semantic fidelity.",
    "prewrite_inspection_calls": "Metadata or non-mutating use_figma calls before the first mutation script. Does not prove understanding of requirements.",
    "recovery_next3_rate": "Among script errors, fraction followed by a successful mutation within the next three tool calls. The successful operation may be unrelated to the error."
  }
