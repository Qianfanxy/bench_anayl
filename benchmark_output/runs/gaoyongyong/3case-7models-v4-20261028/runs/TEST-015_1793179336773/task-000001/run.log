='Focused') box.effects=[{type:'DROP_SHADOW',color:{r:0.19,g:0.63,b:0.38,a:0.18},offset:{x:0,y:0},radius:0,spread:4,visible:true,blendMode:'NORMAL'}];\n val.characters = (state==='Empty'||state==='Focused')?ph:(state==='Error'?'jonas.macroni@invest':filledVal);\n val.fills=[P((state==='Empty'||state==='Focused')?'text/tertiary':'text/primary')];\n if(pw==='Yes'){ const tg=await T('Show','Body/Strong',(state==='Empty')?'text/tertiary':'brand/primary'); tg.name='Show/Hide'; wrap.appendChild(tg); tg.x=366-24-tg.width; tg.y=19; tg.constraints={horizontal:'MAX',vertical:'MIN'}; }\n const helper=await T(state==='Error'?'Enter a valid email address':(pw==='Yes'?'At least 8 characters':'We’ll send you a confirmation link'),'Body/Regular',state==='Error'?'semantic/error':'text/secondary'); helper.name='Helper';\n c.appendChild(helper); helper.visible = state==='Error';\n fcs.push(c);\n}\nconst fset=figma.combineAsVariants(fcs,board); fset.name='Form Field';\nconst pL=fset.addComponentProperty('Label','TEXT','Email address');\nconst pH=fset.addComponentProperty('Helper','TEXT','Helper text');\nconst pHV=fset.addComponentProperty('Show helper','BOOLEAN',false);\nfor(const c of fset.children){ const l=c.findOne(n=>n.name==='Label'); const h=c.findOne(n=>n.name==='Helper'); const lc=l.characters, hc=h.characters, hv=h.visible; l.componentPropertyReferences={characters:pL}; h.componentPropertyReferences={characters:pH,visible:pHV}; }\nAL(fset,'HORIZONTAL',{gap:24,pad:[16,16,16,16],fill:'surface/base',radius:16}); fset.layoutWrap='WRAP'; fset.counterAxisSpacing=24; fset.primaryAxisSizingMode='FIXED'; fset.resize(1600,10); place(fset,48,840); out.fset=fset.id;\nout.fprops=fset.componentPropertyDefinitions;\nreturn out;","description":"Build Action Button variants and Form Field states on the supplied base components"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":69,"cache_creation_input_tokens":47898,"cache_read_input_tokens