\n\nconst hero = figma.createFrame();\nf.appendChild(hero);\nhero.name = \"VideoCover\";\nhero.resize(414, 300);\nhero.x = 0; hero.y = 0;\nhero.fills = [S(TINT)];\nhero.clipsContent = true;\n\nconst cover = (await figma.getNodeByIdAsync(\"3:11\")).createInstance();\nhero.appendChild(cover);\ncover.resize(180, 270);\ncover.x = 117; cover.y = 30;\n\nconst backBg = figma.createEllipse(); hero.appendChild(backBg);\nbackBg.resize(36,36); backBg.x = 20; backBg.y = 56; backBg.fills = [S(WHITE)];\nconst backIc = iconInst(\"Icon/Back\", 14);\nhero.appendChild(backIc); backIc.x = 31; backIc.y = 67;\nconst moreBg = figma.createEllipse(); hero.appendChild(moreBg);\nmoreBg.resize(36,36); moreBg.x = 358; moreBg.y = 56; moreBg.fills = [S(WHITE)];\nconst moreIc = iconInst(\"Icon/More\", 10);\nhero.appendChild(moreIc); moreIc.x = 371; moreIc.y = 60;\n\nconst playBg = figma.createEllipse(); hero.appendChild(playBg);\nplayBg.resize(56,56); playBg.x = 179; playBg.y = 122; playBg.fills = [S(BRAND)];\nplayBg.effects = [{type:\"DROP_SHADOW\", color:{r:0.1412,g:0.7843,b:0.9961,a:0.4}, offset:{x:0,y:6}, radius:16, spread:0, visible:true, blendMode:\"NORMAL\"}];\nconst playIc = iconInst(\"Icon/Play\", 18);\nhero.appendChild(playIc); playIc.x = 200; playIc.y = 135;\n\nconst sb = (await figma.getNodeByIdAsync(\"8:53\")).createInstance();\nf.appendChild(sb); sb.x = 0; sb.y = 0;\n\nawait text(f, \"Warm up\", \"Extra Bold\", 26, INK, 24, 320, 350);\n\n// Tags (manual)\nfunction tag(label, iconName, x){\n  const t = figma.createFrame();\n  f.appendChild(t);\n  t.name = \"Tag/\" + label;\n  t.fills = [S(TINT)]; t.cornerRadius = 15;\n  t.layoutMode = \"HORIZONTAL\";\n  t.counterAxisAlignItems = \"CENTER\";\n  t.itemSpacing = 6;\n  t.paddingLeft = 12; t.paddingRight = 12; t.paddingTop = 8; t.paddingBottom = 8;\n  const ic = iconInst(iconName, 12); t.appendChild(ic);\n  const tx = figma.createText(); t.appendChild(tx);\n  tx.fontName = {family:\"Inter\", style:\"Medium\"};\n  tx.characters = label; tx.fontSize = 12; tx.fills = [S(INK)];\n  t.x = x; t.y = 362;\n  return t;\n}\ntag(\"37.10 mins\", \"Icon/Clock\", 24);\ntag(\"Running\", \"Icon/Running\", 140);\n\nawait text(f, \"Warm up properly before exercising to prevent injury and make your workouts more effective.\", \"Regular\", 13.5, GRAY, 24, 404, 366, 22);\n\nawait text(f, \"Exercises\", \"Bold\", 18, INK, 24, 458, null);\n\nconst photoMap = {1:\"3:8\", 2:\"3:7\", 3:\"3:12\", 4:\"3:6\", 5:\"3:10\", 6:\"3:11\", 7:\"3:9\", 8:\"3:4\", 9:\"3:5\", 10:\"3:14\"};\nconst durations = {1:\"02.30\",2:\"02.00\",3:\"03.20\",4:\"02.30\",5:\"05.30\",6:\"06.10\",7:\"04.50\",8:\"03.30\",9:\"01.30\",10:\"05.20\"};\nlet ry = 492;\nfor (let i = 1; i <= 10; i++) {\n  const r = figma.createFrame();\n  f.appendChild(r);\n  r.name = \"ExerciseRow/\" + i;\n  r.resize(366, 76);\n  r.x = 24; r.y = ry;\n  r.fills = [S(WHITE)];\n  r.cornerRadius = 16;\n  r.effects = [SHADOW];\n  const thumb = figma.createFrame();\n  r.appendChild(thumb);\n  thumb.name = \"Thumb\";\n  thumb.resize(56, 56);\n  thumb.x = 12; thumb.y = 10;\n  thumb.fills = [S(TINT)];\n  thumb.cornerRadius = 12;\n  thumb.clipsContent = true;\n  const photo = (await figma.getNodeByIdAsync(photoMap[i])).createInstance();\n  const ratio = photo.width / photo.height;\n  if (ratio >= 1) photo.resize(56 * ratio, 56);\n  else photo.resize(56, 56 / ratio);\n  thumb.appendChild(photo);\n  photo.x = (56 - photo.width) / 2;\n  photo.y = (56 - photo.height) / 2;\n  await text(r, \"Exercise \" + i, \"Semi Bold\", 15, INK, 84, 17, null);\n  await text(r, durations[i] + \" Minutes\", \"Regular\", 12, GRAY, 84, 42, null);\n  const pbg = figma.createEllipse(); r.appendChild(pbg);\n  pbg.resize(32,32); pbg.x = 318; pbg.y = 22; pbg.fills = [S(BRAND)];\n  const pi = iconInst(\"Icon/PlaySmall\", 11);\n  r.appendChild(pi); pi.x = 331; pi.y = 31;\n  ry += 84;\n}\n\nconst tbComp = await figma.getNodeByIdAsync(\"7:87\");\nconst tb = tbComp.createInstance();\nf.appendChild(tb);\ntb.x = 0; tb.y = 800;\nfor (const it of tb.children) {\n  const label = it.name.replace(\"Tab/\",\"\");\n  const active = label === \"Home\";\n  const ic = it.children[0]; const lt = it.children[1];\n  const paintNodes = ic.findAll(n => n.type===\"VECTOR\"||n.type===\"RECTANGLE\"||n.type===\"ELLIPSE\");\n  const col = active ? BRAND : GRAY;\n  for (const p of paintNodes){ if (Array.isArray(p.fills)&&p.fills.length) p.fills=[{type:\"SOLID\",color:col}]; if (p.strokes&&p.strokes.length) p.strokes=[{type:\"SOLID\",color:col}]; }\n  lt.fills = [{type:\"SOLID\",color: active ? BRAND : GRAY}];\n  lt.fontName = {family:\"Inter\", style: active ? \"Semi Bold\" : \"Medium\"};\n}\n\nreturn JSON.stringify({frame: f.id, backBtn: backBg.id, activityTab: tb.children[1].id});","description":"Build 03_Warm_Up frame (fixed icon IDs)"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"3dd82475-447e-4a4a-b1d4-9abeb6ff2aa0","uuid":"38a77c94-f88e-4d5a-894c-fdf7cf831218","timestamp":"2026-11-01T14:41:51.243Z","tool_use_meta":[{"id":"mcp__figma__use_figma_49_d5e258f5","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
