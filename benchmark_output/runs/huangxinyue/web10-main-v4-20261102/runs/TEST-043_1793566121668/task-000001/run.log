\"x\":240},{\"name\":\"Deal Prev\",\"type\":\"FRAME\",\"y\":1424,\"h\":56,\"x\":860},{\"name\":\"Deal Next\",\"type\":\"FRAME\",\"y\":1424,\"h\":56,\"x\":1696},{\"name\":\"Deal Slide Card\",\"type\":\"INSTANCE\",\"y\":1522,\"h\":131,\"x\":1090},{\"name\":\"Slide Indicator\",\"type\":\"FRAME\",\"y\":1772,\"h\":8,\"x\":1140},{\"name\":\"New Arrivals\",\"type\":\"FRAME\",\"y\":1952,\"h\":1347,\"x\":240},{\"name\":\"FASCO\",\"type\":\"TEXT\",\"y\":2535,\"h\":18,\"x\":-374},{\"name\":\"FASCO\",\"type\":\"TEXT\",\"y\":2535,\"h\":18,\"x\":76},{\"name\":\"FASCO\",\"type\":\"TEXT\",\"y\":2535,\"h\":18,\"x\":526},{\"name\":\"FASCO\",\"type\":\"TEXT\",\"y\":3059,\"h\":18,\"x\":-374},{\"name\":\"FASCO\",\"type\":\"TEXT\",\"y\":3059,\"h\":18,\"x\":76},{\"name\":\"FASCO\",\"type\":\"TEXT\",\"y\":3059,\"h\":18,\"x\":526},{\"name\":\"Collection Banner\",\"type\":\"INSTANCE\",\"y\":3419,\"h\":560,\"x\":240},{\"name\":\"Testimonials\",\"type\":\"FRAME\",\"y\":4099,\"h\":569,\"x\":240},{\"name\":\"Features\",\"type\":\"FRAME\",\"y\":3879,\"h\":160,\"x\":240}]"}],"_meta":{"mcpRequestId":"bfbe9818-be4c-4fee-a9e9-4b154ada873d"}},"tool_result_meta":[{"id":"mcp__figma__use_figma_26_e7118647","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
