[0],{s:9,c:C.loss,x:16,y:y+2});T(ob,a[1],{s:9,c:C.t2,x:0,y:y+2,align:'RIGHT'});});\nR(ob,14,112,322,1,{f:C.line});\nT(ob,'29,198.24',{s:10,c:C.gain,x:16,y:116,wd:150});\nT(ob,'+3.73%',{s:8,c:C.gain,x:170,y:118,align:'RIGHT'});\nbids.forEach((b,i)=>{const y=136+i*17;R(ob,14,y,322*(parseFloat(b[1])/0.2104),14,{f:C.gain,a:0.12,r:4});T(ob,b[0],{s:9,c:C.gain,x:16,y:y+2});T(ob,b[1],{s:9,c:C.t2,x:0,y:y+2,align:'RIGHT'});});\n// ---- order form 432..700 ----\nof.y=432; of.resize(350,268);\nconst findT=(ch)=>of.findAll(n=>n.type==='TEXT'&&n.characters===ch)[0];\nof.children.filter(k=>k.name==='seg').forEach(k=>k.y=10);\nconst lim=of.children.find(k=>k.name==='limit'); if(lim)lim.y=44;\nconst typeLbl=findT('Type'); if(typeLbl)typeLbl.y=52;\nconst sts=of.children.filter(k=>k.name==='stepper');\nif(sts[0]){sts[0].y=72;sts[0].resize(326,42);}\nif(sts[1]){sts[1].y=134;sts[1].resize(326,42);}\nof.children.filter(k=>k.name==='pct').forEach(p=>p.y=182);\nconst sep=of.children.filter(k=>k.type==='RECTANGLE'&&Math.round(k.width)===326&&Math.round(k.height)===1);\nsep.forEach(r=>r.y=216);\nconst tot=findT('Total'); if(tot)tot.y=227;\nconst totv=findT('1,459.90 USDT'); if(totv)totv.y=225;\nconst avail=findT('Available 2,500.00 USDT'); if(avail)avail.y=247;\n// ---- Buy BTC 708..750 ----\nbuy.y=708; buy.resize(350,42);\nconst bl=buy.children.find(c=>c.type==='TEXT'); if(bl){bl.y=12;bl.resize(350,bl.height);bl.x=0;}\n// ---- trade tab bar ----\nconst bar=(await figma.getNodeByIdAsync('15:161')).createInstance(); // Trade Tab Bar / Tab=Exchange\ns10.appendChild(bar);bar.x=0;bar.y=756;\n// wire its tabs\nconst m={'Home':'20:300','Markets':'20:468','Exchange':'21:388'};\nconst log=[];\nfor(const [label,tid] of Object.entries(m)){\n  const t=bar.findAll(n=>n.type==='TEXT'&&n.characters===label)[0];\n  if(t&&label!=='Exchange'){try{t.reactions=[{trigger:{type:'ON_CLICK'},actions:[{type:'NODE',destinationId:tid,navigation:'NAVIGATE',transition:{type:'DISSOLVE',easing:{type:'EASE_OUT'},duration: