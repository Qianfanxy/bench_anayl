e();\n  h3.name = \"Header\";\n  h3.resize(375, 56);\n  h3.x = 0; h3.y = 44;\n  h3.fills = [];\n  h3.layoutMode = \"HORIZONTAL\";\n  h3.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  h3.counterAxisAlignItems = \"CENTER\";\n  h3.paddingLeft = 16; h3.paddingRight = 16;\n\n  const backBtn = getInstance(\"2:52\");\n  if (backBtn) h3.appendChild(backBtn);\n\n  const h3Right = figma.createFrame();\n  h3Right.name = \"Header Actions\";\n  h3Right.fills = [];\n  h3Right.layoutMode = \"HORIZONTAL\";\n  h3Right.itemSpacing = 16;\n  const addIcon = getInstance(\"2:30\");\n  const shareIcon = getInstance(\"2:58\");\n  const starIcon = getInstance(\"2:61\");\n  if (addIcon) h3Right.appendChild(addIcon);\n  if (shareIcon) h3Right.appendChild(shareIcon);\n  if (starIcon) h3Right.appendChild(starIcon);\n  h3.appendChild(h3Right);\n\n  f3.appendChild(h3);\n\n  // Content Scroll Container (03 has no tab bar, but fixed bottom Beli / Jual action bar)\n  // Action bar height: 70px. Header: 44+56=100. Height = 812 - 100 - 70 = 642.\n  const scroll3 = figma.createFrame();\n  scroll3.name = \"Content Scroll\";\n  scroll3.resize(375, 642);\n  scroll3.x = 0; scroll3.y = 100;\n  scroll3.fills = [];\n  scroll3.layoutMode = \"VERTICAL\";\n  scroll3.itemSpacing = 20;\n  scroll3.paddingLeft = 16; scroll3.paddingRight = 16; scroll3.paddingBottom = 20;\n\n  // Stock Header Info Block: Logo_GOTO · GOTO · GoTo Gojek Tokopedia · Rp189 · falling −Rp9 (−4,55%) · “Hari ini”\n  const stockHeader = figma.createFrame();\n  stockHeader.name = \"Stock Header Block\";\n  stockHeader.resize(343, 76);\n  stockHeader.fills = [];\n  stockHeader.layoutMode = \"VERTICAL\";\n  stockHeader.itemSpacing = 6;\n\n  const topInfo = figma.createFrame();\n  topInfo.fills = [];\n  topInfo.layoutMode = \"HORIZONTAL\";\n  topInfo.itemSpacing = 12;\n  topInfo.counterAxisAlignItems = \"CENTER\";\n\n  const gotoLogo = getInstance(\"3:45\");\n  if (gotoLogo) {\n    gotoLogo.resize(40, 40);\n    topInfo.appendChild(gotoLogo);\n  }\n\n  const titleGroup = figma.createFrame();\n  titleGroup.fills = [];\n  titleGroup.layoutMode = \"VERTICAL\";\n  titleGroup.itemSpacing = 2;\n\n  const tTxt = figma.createText();\n  tTxt.fontName = { family: \"Roboto\", style: \"Bold\" };\n  tTxt.characters = \"GOTO\";\n  tTxt.fontSize = 18;\n  tTxt.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n  titleGroup.appendChild(tTxt);\n\n  const cTxt = figma.createText();\n  cTxt.fontName = { family: \"Roboto\", style: \"Regular\" };\n  cTxt.characters = \"GoTo Gojek Tokopedia\";\n  cTxt.fontSize = 12;\n  cTxt.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  titleGroup.appendChild(cTxt);\n\n  topInfo.appendChild(titleGroup);\n  stockHeader.appendChild(topInfo);\n\n  // Price row: Rp189 · falling −Rp9 (−4,55%) · “Hari ini”\n  const priceRow = figma.createFrame();\n  priceRow.fills = [];\n  priceRow.layoutMode = \"HORIZONTAL\";\n  priceRow.counterAxisAlignItems = \"BASELINE\";\n  priceRow.itemSpacing = 8;\n\n  const prTxt = figma.createText();\n  prTxt.fontName = { family: \"Roboto\", style: \"Bold\" };\n  prTxt.characters = \"Rp189\";\n  prTxt.fontSize = 26;\n  prTxt.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n  priceRow.appendChild(prTxt);\n\n  const chTxt = figma.createText();\n  chTxt.fontName = { family: \"Roboto\", style: \"Medium\" };\n  chTxt.characters = \"−Rp9 (−4,55%)\";\n  chTxt.fontSize = 13;\n  chTxt.fills = [{ type: 'SOLID', color: RED_LOSS }];\n  priceRow.appendChild(chTxt);\n\n  const dayTxt = figma.createText();\n  dayTxt.fontName = { family: \"Roboto\", style: \"Regular\" };\n  dayTxt.characters = \"Hari ini\";\n  dayTxt.fontSize = 12;\n  dayTxt.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  priceRow.appendChild(dayTxt);\n\n  stockHeader.appendChild(priceRow);\n  scroll3.appendChild(stockHeader);\n\n  // Chart Container with Line Chart, highlighted point, tooltip & Time Axis\n  // Time axis 6:00 – 2:00: 6:00 (197), 10:00 (199), 14:00 (194), 18:00 (196), 22:00 (192), 2:00 (189)\n  // Tooltip on 22:00 point: Rp192 · 28 Okt 2022 - 22:00 · Volume: 102K\n  const chartBox = figma.createFrame();\n  chartBox.name = \"Chart Box\";\n  chartBox.resize(343, 200);\n  chartBox.fills = [{ type: 'SOLID', color: CARD_BG }];\n  chartBox.cornerRadius = 12;\n  chartBox.layoutMode = \"NONE\"; // absolute positioning inside chart box for line, points, tooltip\n\n  // Draw chart line vector path\n  const chartLine = figma.createVector();\n  chartLine.name = \"Chart Line Path\";\n  // Chart relative coordinates: width ~300, height ~100\n  // Points (x, y):\n  // 6:00  (20, 40)  -> 197\n  // 10:00 (75, 20)  -> 199\n  // 14:00 (130, 70) -> 194\n  // 18:00 (185, 50) -> 196\n  // 22:00 (240, 90) -> 192 (Highlighted point)\n  // 2:00  (295, 120)-> 189\n  chartLine.vectorPaths = [{\n    windingRule: \"NONZERO\",\n    data: \"M 20 40 L 75 20 L 130 70 L 185 50 L 240 90 L 295 120\"\n  }];\n  chartLine.strokes = [{ type: 'SOLID', color: RED_LOSS }];\n  chartLine.strokeWeight = 2;\n  chartLine.x = 24; chartLine.y = 20;\n  chartBox.appendChild(chartLine);\n\n  // Highlighted Point at 22:00 (x: 24+240 = 264, y: 20+90 = 110)\n  const dot = figma.createEllipse();\n  dot.name = \"Highlighted Point\";\n  dot.resize(10, 10);\n  dot.x = 264 - 5; dot.y = 110 - 5;\n  dot.fills = [{ type: 'SOLID', color: RED_LOSS }];\n  dot.strokes = [{ type: 'SOLID', color: TEXT_WHITE }];\n  dot.strokeWeight = 2;\n  chartBox.appendChild(dot);\n\n  // Tooltip Frame at highlighted point\n  const tooltip = figma.createFrame();\n  tooltip.name = \"Chart Tooltip\";\n  tooltip.resize(190, 44);\n  tooltip.x = 150; tooltip.y = 45;\n  tooltip.fills = [{ type: 'SOLID', color: { r: 0.07, g: 0.09, b: 0.11 } }];\n  tooltip.cornerRadius = 8;\n  tooltip.strokes = [{ type: 'SOLID', color: BORDER_COLOR }];\n  tooltip.strokeWeight = 1;\n  tooltip.layoutMode = \"VERTICAL\";\n  tooltip.paddingLeft = 8; tooltip.paddingRight = 8; tooltip.paddingTop = 6; tooltip.paddingBottom = 6;\n  tooltip.itemSpacing = 2;\n\n  const tt1 = figma.createText();\n  tt1.fontName = { family: \"Roboto\", style: \"Bold\" };\n  tt1.characters = \"Rp192 · 28 Okt 2022 - 22:00\";\n  tt1.fontSize = 11;\n  tt1.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n  tooltip.appendChild(tt1);\n\n  const tt2 = figma.createText();\n  tt2.fontName = { family: \"Roboto\", style: \"Regular\" };\n  tt2.characters = \"Volume: 102K\";\n  tt2.fontSize = 10;\n  tt2.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  tooltip.appendChild(tt2);\n\n  chartBox.appendChild(tooltip);\n\n  // Time Axis Labels Row\n  const timeAxis = figma.createFrame();\n  timeAxis.name = \"Time Axis\";\n  timeAxis.resize(310, 20);\n  timeAxis.x = 16; timeAxis.y = 165;\n  timeAxis.fills = [];\n  timeAxis.layoutMode = \"HORIZONTAL\";\n  timeAxis.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  timeAxis.counterAxisAlignItems = \"CENTER\";\n\n  const times = [\"6:00\", \"10:00\", \"14:00\", \"18:00\", \"22:00\", \"2:00\"];\n  times.forEach(tm => {\n    const txt = figma.createText();\n    txt.fontName = { family: \"Roboto\", style: tm === \"22:00\" ? \"Bold\" : \"Regular\" };\n    txt.characters = tm;\n    txt.fontSize = 11;\n    txt.fills = [{ type: 'SOLID', color: tm === \"22:00\" ? TEXT_WHITE : TEXT_MUTED }];\n    timeAxis.appendChild(txt);\n  });\n  chartBox.appendChild(timeAxis);\n\n  scroll3.appendChild(chartBox);\n\n  // Range Tabs: 1D · 5D · 1M · 6M · YTD · 1Y · 5Y · MAX · current: 1D\n  const rangeTabs = figma.createFrame();\n  rangeTabs.name = \"Range Tabs\";\n  rangeTabs.resize(343, 32);\n  rangeTabs.fills = [];\n  rangeTabs.layoutMode = \"HORIZONTAL\";\n  rangeTabs.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  rangeTabs.counterAxisAlignItems = \"CENTER\";\n\n  const ranges = [\"1D\", \"5D\", \"1M\", \"6M\", \"YTD\", \"1Y\", \"5Y\", \"MAX\"];\n  ranges.forEach(r => {\n    const isAct = r === \"1D\";\n    const rBtn = figma.createFrame();\n    rBtn.name = `Range_${r}`;\n    rBtn.resize(36, 28);\n    rBtn.fills = isAct ? [{ type: 'SOLID', color: RED_LOSS }] : [];\n 