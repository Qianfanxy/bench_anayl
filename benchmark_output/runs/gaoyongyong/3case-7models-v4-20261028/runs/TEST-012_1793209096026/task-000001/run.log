id';col.fills=[];col.layoutMode='VERTICAL';col.itemSpacing=4;\n  f.appendChild(col);col.layoutGrow=1;\n  const n=txt(name,15,'Semi Bold','DM Sans',C.t1,20);n.name='bank_name';col.appendChild(n);\n  const nu=txt(number,13,'Regular','Inter',C.t2,17);nu.name='bank_number';col.appendChild(nu);\n  const h=txt(holder,11,'Regular','Inter',C.t3,15);h.name='holder';col.appendChild(h);\n  const mo=await icon('6:278',20,C.t3);mo.name='more';f.appendChild(mo);\n  const c=figma.createComponent();c.resize(354,88);c.fills=[];c.appendChild(f);f.x=0;f.y=0;f.remove();\n  c.name='BankCard';return c;\n}\nconst bc=await bankCard('5:78','Bank of America','0182128xxx','Jonas Macroni');bc.x=2360;bc.y=1800;\n\n// ---------- NotificationRow ----------\nasync function notifRow(thumbId,msg,time){\n  const f=figma.createFrame();f.name='NotificationRow';f.resize(354,76);f.fills=S(C.white);\n  f.cornerRadius=16;f.strokes=S(C.line);f.strokeWeight=1;\n  f.layoutMode='HORIZONTAL';f.paddingTop=12;f.paddingBottom=12;f.paddingLeft=12;f.paddingRight=12;f.itemSpacing=12;\n  f.counterAxisAlignItems='CENTER';\n  const th=await figma.getNodeByIdAsync(thumbId);const ti=th.createInstance();ti.resize(52,52);ti.cornerRadius=12;f.appendChild(ti);\n  const col=figma.createFrame();col.name='mid';col.fills=[];col.layoutMode='VERTICAL';col.itemSpacing=5;\n  f.appendChild(col);col.layoutGrow=1;\n  const m=txt(msg,13,'Medium','Inter',C.t1,18);m.name='message';m.textAutoResize='HEIGHT';col.appendChild(m);m.layoutAlign='STRETCH';\n  const t=txt(time,11,'Regular','Inter',C.t3,15);t.name='time';col.appendChild(t);\n  const c=figma.createComponent();c.resize(354,76);c.fills=[];c.appendChild(f);f.x=0;f.y=0;f.remove();\n  c.name='NotificationRow';return c;\n}\nconst nr=await notifRow('5:70','Where do you see yourself in the next ages?','30 secs ago');nr.x=2780;nr.y=1800;\n\nJSON.stringify({navHome:navHome.id,navAccount:navAccount.id,planCard:pc.id,articleCard:ac.id,listRow:lr.id,historyRow:hr.id,bankCard:bc.id,notifRow:nr.id