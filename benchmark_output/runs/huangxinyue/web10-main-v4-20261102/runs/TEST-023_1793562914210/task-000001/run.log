 photo(parent,id,x,y,w,h){\n  const src=await figma.getNodeByIdAsync(id);\n  const inst=src.createInstance();\n  parent.appendChild(inst);\n  inst.name=src.name; inst.resize(w,h); inst.x=x; inst.y=y;\n  inst.fills=[{type:'IMAGE',scaleMode:'FILL',imageHash:src.fills[0].imageHash}];\n  return inst;\n}\nasync function btn(parent,x,y,w,label,kind,h){\n  const src=await figma.getNodeByIdAsync('1:24');\n  const b=src.createInstance();\n  parent.appendChild(b);\n  b.resize(w,h||58); b.x=x; b.y=y;\n  if(kind==='outline'){\n    b.fills=fill(P.white);\n    b.strokes=[{type:'SOLID',color:rgb('#D8D2C6'),opacity:1}];\n    b.strokeWeight=1; b.strokeAlign='INSIDE';\n    b.findOne(n=>n.type==='TEXT').fills=fill(P.ink);\n  }\n  const t=b.findOne(n=>n.type==='TEXT');\n  t.characters=label; t.fontSize=14;\n  return b;\n}\nasync function socialBtn(parent,x,y,w,label,id,hash){\n  const b=box(parent,'Social Button',x,y,w,60,{stroke:'#DED9CF',r:10,fill:P.white});\n  const src=await figma.getNodeByIdAsync(id);\n  const g=src.createInstance();\n  b.appendChild(g);\n  g.resize(22,22);\n  g.fills=[{type:'IMAGE',scaleMode:'FIT',imageHash:hash}];\n  const t=tx(b,'Label',0,18,{t:label,s:13,w:'Medium',c:P.ink});\n  const totalW=22+10+t.width;\n  g.x=(w-totalW)/2; g.y=19; t.x=g.x+32;\n  return b;\n}\nasync function fieldAt(parent,x,y,w,label,ph){\n  const src=await figma.getNodeByIdAsync(w>=400?'29:1300':'29:1304');\n  const i=src.createInstance();\n  parent.appendChild(i);\n  i.x=x; i.y=y; i.resize(w,84);\n  i.children.find(n=>n.name==='Label').characters=label;\n  if(ph){ const p=i.children.find(n=>n.name==='Placeholder'); if(p) p.characters=ph; }\n  return i;\n}\nasync function shell(name,x,y,photoId,tagline){\n  const f=figma.createFrame();\n  ws.appendChild(f);\n  f.name=name; f.resize(1920,1080); f.x=x; f.y=y;\n  f.fills=fill(P.cream); f.clipsContent=true;\n  const mp=box(f,'Media Panel',0,0,840,1080,{fill:P.sand,clip:true});\n  await photo(mp,photoId,0,0,840,1080);\n  const sc=box(mp,'Scrim