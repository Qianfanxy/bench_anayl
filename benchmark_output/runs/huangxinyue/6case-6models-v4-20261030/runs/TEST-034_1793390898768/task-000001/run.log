Text = completeBtn.findOne(n => n.type === \"TEXT\");\n    if (btnText) {\n      btnText.characters = \"Complete Order\";\n    }\n    cardSheet.appendChild(completeBtn);\n  }\n\n  f08.appendChild(cardSheet);\n\n  // --- 09_Order_Complete ---\n  const f09 = createFrame(\"09_Order_Complete\", 3400, 0);\n  await addShell(f09);\n\n  const successCheckOrig = await getOrig(\"2:128\");\n  if (successCheckOrig) {\n    const successIcon = successCheckOrig.createInstance();\n    successIcon.x = (375 - successIcon.width) / 2;\n    successIcon.y = 200;\n    f09.appendChild(successIcon);\n  }\n\n  const congratsText = figma.createText();\n  congratsText.characters = \"Congratulations!!!\";\n  congratsText.fontName = { family: \"Nunito\", style: \"Bold\" };\n  congratsText.fontSize = 24;\n  congratsText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n  congratsText.x = (375 - 200) / 2;\n  congratsText.y = 360;\n  f09.appendChild(congratsText);\n\n  const subText = figma.createText();\n  subText.characters = \"Your order has been taken and is being attended to\";\n  subText.fontName = { family: \"Nunito\", style: \"Regular\" };\n  subText.fontSize = 16;\n  subText.fills = [{ type: 'SOLID', color: { r: 0.35, g: 0.35, b: 0.35 } }];\n  subText.textAlignHorizontal = \"CENTER\";\n  subText.resize(280, 48);\n  subText.x = (375 - 280) / 2;\n  subText.y = 405;\n  f09.appendChild(subText);\n\n  if (buttonOrig) {\n    const trackBtn = buttonOrig.createInstance();\n    trackBtn.x = 24;\n    trackBtn.y = 520;\n    trackBtn.name = \"Track order\";\n    const btnText = trackBtn.findOne(n => n.type === \"TEXT\");\n    if (btnText) {\n      btnText.characters = \"Track order\";\n    }\n    f09.appendChild(trackBtn);\n  }\n\n  const continueBtn = figma.createFrame();\n  continueBtn.name = \"Continue shopping\";\n  continueBtn.resize(327, 56);\n  continueBtn.x = 24;\n  continueBtn.y = 596;\n  continueBtn.cornerRadius = 10;\n  continueBtn.strokes = [{ type: 'SOLID', color: brandPrimaryColor }];\n  continueBtn.strokeWeight = 1;\n  continueBtn.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n\n  const contText = figma.createText();\n  contText.characters = \"Continue shopping\";\n  contText.fontName = { family: \"Nunito\", style: \"Bold\" };\n  contText.fontSize = 16;\n  contText.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n  contText.x = 94;\n  contText.y = 17;\n  continueBtn.appendChild(contText);\n\n  f09.appendChild(continueBtn);\n\n  // --- 10_Track_Order ---\n  const f10 = createFrame(\"10_Track_Order\", 3825, 0);\n  f10.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n  await addShell(f10);\n\n  if (iconBackOrig) {\n    const goBackBtn = figma.createFrame();\n    goBackBtn.name = \"Go back\";\n    goBackBtn.resize(80, 32);\n    goBackBtn.x = 24;\n    goBackBtn.y = 56;\n    goBackBtn.cornerRadius = 16;\n    goBackBtn.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n    \n    const backIcon = iconBackOrig.createInstance();\n    backIcon.x = 8;\n    backIcon.y = 4;\n    goBackBtn.appendChild(backIcon);\n\n    const backText = figma.createText();\n    backText.characters = \"Go back\";\n    backText.fontName = { family: \"Nunito\", style: \"SemiBold\" };\n    backText.fontSize = 12;\n    backText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n    backText.x = 28;\n    backText.y = 8;\n    goBackBtn.appendChild(backText);\n\n    f10.appendChild(goBackBtn);\n  }\n\n  const trackTitle = figma.createText();\n  trackTitle.characters = \"Delivery Status\";\n  trackTitle.fontName = { family: \"Nunito\", style: \"Bold\" };\n  trackTitle.fontSize = 24;\n  trackTitle.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  trackTitle.x = 120;\n  trackTitle.y = 56;\n  f10.appendChild(trackTitle);\n\n  const mapOrig = await getOrig(\"2:50\");\n  if (mapOrig) {\n    const mapContainer = figma.createFrame();\n    mapContainer.name = \"Map Container\";\n    mapContainer.resize(375, 220);\n    mapContainer.x = 0;\n    mapContainer.y = 108;\n    mapContainer.fills = [];\n\n    const map = mapOrig.createInstance();\n    map.x = 0;\n    map.y = 0;\n    mapContainer.appendChild(map);\n\n    f10.appendChild(mapContainer);\n  }\n\n  const stepsSheet = figma.createFrame();\n  stepsSheet.name = \"Steps Sheet\";\n  stepsSheet.resize(375, 450);\n  stepsSheet.x = 0;\n  stepsSheet.y = 328;\n  stepsSheet.cornerRadius = 24;\n  stepsSheet.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n\n  const iconDoneOrig = await getOrig(\"2:140\");\n  const stepTakenOrig = await getOrig(\"2:41\");\n  const stepPreparedOrig = await getOrig(\"2:44\");\n  const stepDeliveringOrig = await getOrig(\"2:47\");\n  const iconCallOrig = await getOrig(\"2:134\");\n\n  const stepsData = [\n    { name: \"Order Taken\", status: \"done\", photoOrig: stepTakenOrig, subtitle: null },\n    { name: \"Order Is Being Prepared\", status: \"done\", photoOrig: stepPreparedOrig, subtitle: null },\n    { name: \"Order Is Being Delivered\", status: \"current\", photoOrig: stepDeliveringOrig, subtitle: \"Your delivery agent is coming\" },\n    { name: \"Order Received\", status: \"pending\", photoOrig: null, subtitle: null }\n  ];\n\n  let stepY = 32;\n  for (let i = 0; i < stepsData.length; i++) {\n    const st = stepsData[i];\n    const stepRow = figma.createFrame();\n    stepRow.name = `StepRow_${st.name}`;\n    stepRow.resize(327, 70);\n    stepRow.x = 24;\n    stepRow.y = stepY;\n    stepRow.fills = [];\n\n    if (st.photoOrig) {\n      const img = st.photoOrig.createInstance();\n      img.resize(48, 48);\n      img.x = 0;\n      img.y = 0;\n      stepRow.appendChild(img);\n    } else {\n      const pendingCircle = figma.createEllipse();\n      pendingCircle.resize(48, 48);\n      pendingCircle.x = 0;\n      pendingCircle.y = 0;\n      pendingCircle.fills = [{ type: 'SOLID', color: { r: 0.93, g: 0.93, b: 0.93 } }];\n      stepRow.appendChild(pendingCircle);\n    }\n\n    const sTitle = figma.createText();\n    sTitle.characters = st.name;\n    sTitle.fontName = { family: \"Nunito\", style: st.status === \"pending\" ? \"Regular\" : \"Bold\" };\n    sTitle.fontSize = 15;\n    sTitle.fills = [{ type: 'SOLID', color: st.status === \"pending\" ? { r: 0.6, g: 0.6, b: 0.6 } : brandDarkColor }];\n    sTitle.x = 64;\n    sTitle.y = st.subtitle ? 4 : 14;\n    stepRow.appendChild(sTitle);\n\n    if (st.subtitle) {\n      const sSub = figma.createText();\n      sSub.characters = st.subtitle;\n      sSub.fontName = { family: \"Nunito\", style: \"Regular\" };\n      sSub.fontSize = 12;\n      sSub.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.5 } }];\n      sSub.x = 64;\n      sSub.y = 26;\n      stepRow.appendChild(sSub);\n    }\n\n    if (st.status === \"done\" && iconDoneOrig) {\n      const doneCheck = iconDoneOrig.createInstance();\n      doneCheck.x = 295;\n      doneCheck.y = 12;\n      stepRow.appendChild(doneCheck);\n    } else if (st.status === \"current\" && iconCallOrig) {\n      const callBtn = iconCallOrig.createInstance();\n      callBtn.x = 285;\n      callBtn.y = 8;\n      callBtn.name = \"call the delivery agent\";\n      stepRow.appendChild(callBtn);\n    }\n\n    stepsSheet.appendChild(stepRow);\n    stepY += 82;\n  }\n\n  f10.appendChild(stepsSheet);\n\n  // Set prototype reactions\n  f01.reactions = [{\n    trigger: { type: 'AFTER_TIMEOUT', timeout: 1.5 },\n    actions: [{ type: 'NODE', destinationId: f02.id, navigation: 'NAVIGATE', transition: null }]\n  }];\n\n  const findNodeByName = (root, name) => {\n    if (!root) return null;\n    if (root.name === name) return root;\n    if (root.children) {\n      for (const child of root.children) {\n        const res = findNodeByName(child, name);\n        if (res) return res;\n      }\n    }\n    return null;\n  };\n\n  const setClickReaction = (fromNode, toNode) => {\n    if (fromNode && toNode) {\n      fromNode.reactions = [{\n        trigger: { type: 'ON_CLICK' },\n        actions: [{ type: 'NODE', destinationId: toNode.id, navigation: 'NAVIGATE', transition: null }]\n      }];\n    }\n  };\n\n  setClickReaction(findNodeByName(f02, \"Button\"), f03);\n  setClickReaction(findNodeByName(f03, \"Button\"), f04);\n  setClickReaction(findNodeByName(f04, \"Card_Quinoa fruit salad\"), f05);\n  setClickReaction(findNodeByName(f04, \"My basket entry\"), f06);\n  setClickReaction(findNodeByName(f05, \"Go back\"), f04);\n  setClickReaction(findNodeByName(f05, \"Button\"), f06);\n  setClickReaction(findNodeByName(f06, \"Go back\"), f04);\n  setClickReaction(findNodeByName(f06, \"Button\"), f07);\n  setClickReaction(findNodeByName(f07, \"close\"), f06);\n  setClickReaction(findNodeByName(f07, \"Pay with card\"), f08);\n  setClickReaction(findNodeByName(f07, \"Pay on delivery\"), f09);\n  setClickReaction(findNodeByName(f08, \"close\"), f06);\n  setClickReaction(findNodeByName(f08, \"Complete Order\"), f09);\n  setClickReaction(findNodeByName(f09, \"Track order\"), f10);\n  setClickReaction(findNodeByName(f09, \"Continue shopping\"), f04);\n  setClickReaction(findNodeByName(f10, \"Go back\"), f04);\n\n  return \"All 10 frames and reactions created cleanly in a single script\";\n})()","description":"Create all 10 frames and set prototype connections in 03 · Workspace in one clean script","fileKey":"jiYwYdVVeh1sSSwCPVx5uG"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":50912,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":48219},"context_management":null},"parent_tool_use_id":null,"session_id":"cda7a16c-453d-4dc3-870a-25e4b7be3132","uuid":"d31f2c7f-4626-4280-8f0b-bb9961c321fb","timestamp":"2026-10-30T20:17:34.448Z","tool_use_meta":[{"id":"call_1b993ca0a52c4ae78200c9708a1a966d","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
