text id=\"7:96\" name=\"Use these values verbatim.\" x=\"0\" y=\"51\" width=\"1312\" height=\"22\" />\n      <frame id=\"7:97\" name=\"Data blocks\" x=\"0\" y=\"89\" width=\"1312\" height=\"822\">\n        <frame id=\"7:98\" name=\"Home copy\" x=\"0\" y=\"0\" width=\"420\" height=\"258\">\n          <text id=\"7:99\" name=\"Home copy\" x=\"20\" y=\"20\" width=\"78\" height=\"20\" />\n          <text id=\"7:100\" name=\"Deals Of The Month: Hand-picked styles at their best prices this month — once the timer runs out, the deals are gone. New Arrivals: Fresh pieces just landed: easy dresses, cosy knits and everyday shirts for the new season. Instagram: Tag @fasco to be featured — real outfits from our community, styled your way. Testimonials: Real reviews from people who shop with FASCO. Newsletter: Be the first to hear about new arrivals, exclusive deals and styling tips. No spam — unsubscribe anytime.\" x=\"20\" y=\"48\" width=\"380\" height=\"190\" />\n        </frame>\n        <frame id=\"7:101\" name=\"Collection banner (01, 02, 03)\" x=\"444\" y=\"0\" width=\"420\" height=\"201\">\n          <text id=\"7:102\" name=\"Collection banner (01, 02, 03)\" x=\"20\" y=\"20\" width=\"204\" height=\"20\" />\n          <text id=\"7:103\" name=\"Men Collection · Classic Gentleman Item labels: Flat Cap · Cotton Shirt · Suspender · Leather Shoes DESCRIPTION: A sharp, vintage-inspired look built around a wool flat cap, a crisp cotton shirt and classic suspenders. Easy to dress up or down, and made to last for years. Size: M · $100.00 · Buy Now\" x=\"20\" y=\"48\" width=\"380\" height=\"133\" />\n        </frame>\n        <frame id=\"7:104\" name=\"New Arrivals cards (01, in order)\" x=\"888\" y=\"0\" width=\"420\" height=\"182\">\n          <text id=\"7:105\" name=\"New Arrivals cards (01, in order)\" x=\"20\" y=\"20\" width=\"220\" height=\"20\" />\n          <text id=\"7:106\" name=\"Shiny Dress (Photo_Shiny_Dress) · Long Dress (Photo_Long_Dress) · Full Sweater (Photo_Full_Sweater) · White Dress (Photo_White_Dress) · Colorful Dress (Photo_Colorful_Dress) · White Shirt (Photo_White_Shirt) Each: brand FASCO · 5-star rating · (4.1k) Customer Reviews · $95.50 · Almost Sold Out\" x=\"20\" y=\"48\" width=\"380\" height=\"114\" />\n        </frame>\n        <frame id=\"7:107\" name=\"Testimonials (01, in order)\" x=\"0\" y=\"282\" width=\"420\" height=\"258\">\n          <text id=\"7:108\" name=\"Testimonials (01, in order)\" x=\"20\" y=\"20\" width=\"178\" height=\"20\" />\n          <text id=\"7:109\" name=\"Suzan B. · UI Designer (Avatar_Suzan_B) — “The items I ordered were the best investment I ever made. I can’t say enough about your quality service.” James K. · Traveler (Avatar_James_K) — “You won’t regret it. I would like to personally thank you for your outstanding product. Absolutely wonderful!” Megen W. · UI Designer (Avatar_Megen_W) — “Just what I was looking for. Thank you for making it painless, pleasant and, most of all, hassle-free! All products are great.” All: 5-star rating\" x=\"20\" y=\"48\" width=\"380\" height=\"190\" />\n        </frame>\n        <frame id=\"7:110\" name=\"People Also Loved (03)\" x=\"444\" y=\"282\" width=\"420\" height=\"125\">\n          <text id=\"7:111\" name=\"People Also Loved (03)\" x=\"20\" y=\"20\" width=\"160\" height=\"20\" />\n          <text id=\"7:112\" name=\"Copy: Shoppers who looked at this jacket also loved these deals — grab them before the timer runs out. Slides, countdown and card as in Deals Of The Month.\" x=\"20\" y=\"48\" width=\"380\" height=\"57\" />\n        </frame>\n        <frame id=\"7:113\" name=\"Shop products (02, in order)\" x=\"888\" y=\"282\" width=\"420\" height=\"296\">\n          <text id=\"7:114\" name=\"Shop products (02, in order)\" x=\"20\" y=\"20\" width=\"194\" height=\"20\" />\n          <text id=\"7:115\" name=\"Rounded Red Hat · $8.00 (Photo_Rounded_Red_Hat) Linen-blend Shirt · $17.00 · Sold Out (Photo_Linen_Blend_Shirt) Long-sleeve Coat · $106.00 (Photo_Long_Sleeve_Coat) Boxy Denim Hat · $25.00 (Photo_Boxy_Denim_Hat) Linen Plain Top · $25.00 (Photo_Linen_Plain_Top) Oversized T-shirt · $11.00 · old $14.00 (Photo_Oversized_TShirt) Polarised Sunglasses · $18.00 · old $21.00 (Photo_Polarised_Sunglasses) Rockstar Jacket · $22.00 (Photo_Rockstar_Jacket) Dotted Black Dress · $20.00 (Photo_Dotted_Black_Dress)\" x=\"20\" y=\"48\" width=\"380\" height=\"228\" />\n        </frame>\n        <frame id=\"7:116\" name=\"Denim Jacket (03–06)\" x=\"0\" y=\"602\" width=\"420\" height=\"220\">\n          <text id=\"7:117\" name=\"Denim Jacket (03–06)\" x=\"20\" y=\"20\" width=\"153\" height=\"20\" />\n          <text id=\"7:118\" name=\"Brand FASCO · rating with (3) reviews · $39.00 · old $59.00 · Save 33% Sizes M · L · XL · XXL (selected M) · Colors Blue · Black · Lilac (selected Blue) Quantity 1 · 24 people are viewing this right now · Sale ends in 00 : 05 : 59 : 47 · Only 9 item(s) left in stock! Estimated Delivery: Jul 30 - Aug 03 · Free Shipping &amp; Returns: On all orders over $75\" x=\"20\" y=\"48\" width=\"380\" height=\"152\" />\n        </frame>\n        <frame id=\"7:119\" name=\"Cart &amp; checkout totals\" x=\"444\" y=\"602\" width=\"420\" height=\"163\">\n          <text id=\"7:120\" name=\"Cart &amp; checkout totals\" x=\"20\" y=\"20\" width=\"153\" height=\"20\" />\n          <text id=\"7:121\" name=\"Cart (04, 05): Denim Jacket · Color : Blue · 1 × $39.00 · Subtotal $39.00 · Buy $36.00 more and get Free Shipping · gift wrap “For $10.00 please wrap the product” unchecked Checkout (06): Subtotal $39.00 · Shipping $40.00 · Total $79.00\" x=\"20\" y=\"48\" width=\"380\" height=\"95\" />\n        </frame>\n        <frame id=\"7:122\" name=\"Features strip\" x=\"888\" y=\"602\" width=\"420\" height=\"144\">\n          <text id=\"7:123\" name=\"Features strip\" x=\"20\" y=\"20\" width=\"95\" height=\"20\" />\n          <text id=\"7:124\" name=\"High Quality · crafted from top materials (Icon_Trophy) Warranty Protection · Over 2 years (Icon_Guarantee) Free Shipping · Order over $75 (Icon_Shipping) 24 / 7 Support · Dedicated support (Icon_Support)\" x=\"20\" y=\"48\" width=\"380\" height=\"76\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"7:125\" name=\"What is fixed · what is yours\" x=\"64\" y=\"5143\" width=\"1312\" height=\"332\">\n      <text id=\"7:126\" name=\"What is fixed · what is yours\" x=\"0\" y=\"0\" width=\"328\" height=\"35\" />\n      <frame id=\"7:127\" name=\"Fixed vs yours\" x=\"0\" y=\"51\" width=\"1312\" height=\"281\">\n        <frame id=\"7:128\" name=\"Fixed (given)\" x=\"0\" y=\"0\" width=\"644\" height=\"221\">\n          <text id=\"7:129\" name=\"Fixed (given)\" x=\"24\" y=\"24\" width=\"103\" height=\"23\" />\n          <text id=\"7:130\" name=\"• Frame list and exact names • Must-include content per frame (what, not how) • Navigation structure and links • All data and copy • Brand color #000000, Volkhov and Poppins • Media: photos, avatars, sign-in logos, icons • Default Button, default Text Field\" x=\"24\" y=\"57\" width=\"596\" height=\"140\" />\n        </frame>\n        <frame id=\"7:131\" name=\"Yours (designer decides)\" x=\"668\" y=\"0\" width=\"644\" height=\"281\">\n          <text id=\"7:132\" name=\"Yours (designer decides)\" x=\"24\" y=\"24\" width=\"197\" height=\"23\" />\n          <text id=\"7:133\" name=\"• Layout, grid, grouping, order and emphasis on every page • All other colors: neutrals, text, backgrounds / surfaces, sale and discount, rating, stock / urgency, links, error / disabled • Type scale (which levels use Volkhov), spacing, radii, elevation • All states: current nav item, current tab, current slide, selected size / color / view, sold out, checked, focused field, current page, cart count • Headers, footers, hero collage, brand strip, countdown, deal slider, tabs, product cards, collection banner, feature strip, Instagram strip, testimonial cards, newsletter, filters, gallery, pickers, stepper, mini cart, cart table, checkout form, order summary, auth cards • How photos are cropped and placed\" x=\"24\" y=\"57\" width=\"596\" height=\"200\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"7:134\" name=\"How it is evaluated\" x=\"64\" y=\"5523\" width=\"1312\" height=\"281\">\n      <text id=\"7:135\" name=\"How it is evaluated\" x=\"0\" y=\"0\" width=\"222\" height=\"35\" />\n      <text id=\"7:136\" name=\"Your file is compared with this brief on coverage, data and flow — not on visual similarity to any original.\" x=\"0\" y=\"51\" width=\"1312\" height=\"22\" />\n      <text id=\"7:137\" name=\"1. Checklist coverage per frame 2. Data &amp; copy accuracy 3. Flow &amp; prototype completeness 4. Information hierarchy 5. Visual quality &amp; consistency of your own system 6. Component reuse 7. State design (current nav, tabs, selected options, sold out, cart count)\" x=\"0\" y=\"89\" width=\"1312\" height=\"154\" />\n      <text id=\"7:138\" name=\"Deliverable: the link to your own Figma file containing the 11 named frames, your components and the prototype.\" x=\"0\" y=\"259\" width=\"1312\" height=\"22\" />\n    </frame>\n  </frame>\n</canvas>"},{"type":"text","text":"IMPORTANT: After you call this tool, you MUST call get_design_context if trying to implement the design, since this tool only returns metadata. If you do not call get_design_context, the agent will not be able to implement the design."}],"_meta":{"mcpRequestId":"4b8a945a-2726-4a28-8449-cbb29756330c"}},"tool_result_meta":[{"id":"toolu_01Q9azs2luWj2rkYqWlRuRSU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
