ode = 'FIXED';\nsummary.resize(505, 10);\nsummary.paddingLeft = 24; summary.paddingRight = 24; summary.paddingTop = 24; summary.paddingBottom = 24;\nsummary.itemSpacing = 24;\nsummary.cornerRadius = 20;\nsummary.fills = H.solid('#FFFFFF');\nsummary.strokes = H.rgba('#000000', 0.1);\nsummary.strokeWeight = 1;\n\nsummary.appendChild(H.text('Order Summary', 24, 'Bold', '#000000'));\n\nfunction summaryRow(label, value, opts = {}) {\n  const r = figma.createFrame();\n  r.fills = [];\n  r.layoutMode = 'HORIZONTAL';\n  r.primaryAxisSizingMode = 'FIXED';\n  r.counterAxisSizingMode = 'AUTO';\n  r.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  r.layoutAlign = 'STRETCH';\n  r.appendChild(H.text(label, opts.big ? 20 : 16, opts.big ? 'Bold' : 'Regular', '#000000', 'Plus Jakarta Sans', opts.big ? 1 : 0.6));\n  r.appendChild(H.text(value, opts.big ? 24 : 16, 'Bold', opts.color || '#000000'));\n  return r;\n}\nsummary.appendChild(summaryRow('Subtotal', '$565'));\nsummary.appendChild(summaryRow('Discount (-20%)', '-$113', { color: '#FF3333' }));\nsummary.appendChild(summaryRow('Delivery Fee', '$15'));\n\nconst sumDiv = figma.createRectangle();\nsumDiv.resize(457, 1);\nsumDiv.fills = H.rgba('#000000', 0.1);\nsumDiv.layoutAlign = 'STRETCH';\nsummary.appendChild(sumDiv);\n\nsummary.appendChild(summaryRow('Total', '$467', { big: true }));\n\n// Promo\nconst promoRow = figma.createFrame();\npromoRow.fills = [];\npromoRow.layoutMode = 'HORIZONTAL';\npromoRow.itemSpacing = 12;\npromoRow.counterAxisSizingMode = 'FIXED';\npromoRow.primaryAxisSizingMode = 'AUTO';\npromoRow.counterAxisAlignItems = 'CENTER';\npromoRow.layoutAlign = 'STRETCH';\n\nconst promoField = figma.createFrame();\npromoField.layoutMode = 'HORIZONTAL';\npromoField.paddingLeft = 16; promoField.paddingRight = 16;\npromoField.counterAxisAlignItems = 'CENTER';\npromoField.itemSpacing = 12;\npromoField.cornerRadius = 62;\npromoField.fills = H.solid('#F0F0F0');\npromoField.primaryAxisSizingMode = 'FIXED';\npromoField.counterAxisSizingMode = 'FIXED';\npromoField.layoutGrow = 1;\npromoField.resize(280, 48);\nconst ti = tagIcon.createInstance();\nti.resize(24, 24);\nti.opacity = 0.4;\npromoField.appendChild(ti);\npromoField.appendChild(H.text('Add promo code', 16, 'Regular', '#000000', 'Plus Jakarta Sans', 0.4));\npromoRow.appendChild(promoField);\n\nconst applyBtn = figma.createFrame();\napplyBtn.layoutMode = 'HORIZONTAL';\napplyBtn.paddingLeft = 24; applyBtn.paddingRight = 24;\napplyBtn.paddingTop = 14; applyBtn.paddingBottom = 14;\napplyBtn.counterAxisSizingMode = 'AUTO';\napplyBtn.primaryAxisSizingMode = 'AUTO';\napplyBtn.counterAxisAlignItems = 'CENTER';\napplyBtn.primaryAxisAlignItems = 'CENTER';\napplyBtn.cornerRadius = 62;\napplyBtn.fills = H.solid('#000000');\napplyBtn.appendChild(H.text('Apply', 14, 'Medium', '#FFFFFF'));\npromoRow.appendChild(applyBtn);\nsummary.appendChild(promoRow);\n\n// Go to Checkout button — detach instance approach\nconst checkoutBtn = figma.createFrame();\ncheckoutBtn.name = 'Button / Go to Checkout';\ncheckoutBtn.layoutMode = 'HORIZONTAL';\ncheckoutBtn.counterAxisAlignItems = 'CENTER';\ncheckoutBtn.primaryAxisAlignItems = 'CENTER';\ncheckoutBtn.itemSpacing = 8;\ncheckoutBtn.primaryAxisSizingMode = 'FIXED';\ncheckoutBtn.counterAxisSizingMode = 'FIXED';\ncheckoutBtn.resize(457, 60);\ncheckoutBtn.cornerRadius = 62;\ncheckoutBtn.fills = H.solid('#000000');\ncheckoutBtn.layoutAlign = 'STRETCH';\nconst cbTxt = H.text('Go to Checkout', 16, 'Medium', '#FFFFFF');\ncheckoutBtn.appendChild(cbTxt);\nconst arrowI = arrowRight.createInstance();\narrowI.resize(20, 20);\narrowI.fills = H.solid('#FFFFFF');\ncheckoutBtn.appendChild(arrowI);\nsummary.appendChild(checkoutBtn);\n\ncontent.appendChild(summary);\n\nreturn { summaryId: summary.id };\n","description":"Build Order Summary for 04_Cart","fileKey":"5S6WFXEo4QEfJTtE7MFltz"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"c5b3498c-81e1-408a-9e23-797293d6b873","uuid":"77b7dbc0-9a46-4161-9d0e-88e82e6bff43