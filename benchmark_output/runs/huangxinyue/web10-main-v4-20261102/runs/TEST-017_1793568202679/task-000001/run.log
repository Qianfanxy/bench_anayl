env:'9:7'};\nasync function icon(k,color,size=24){const c=await comp(IC[k]);const i=c.createInstance();i.fills=[];i.findAll(n=>n.type==='VECTOR').forEach(v=>v.fills=solid(color));if(size!==24)i.rescale(size/24);i.name='Icon';return i;}\nconst shadow=(a=.08,y=12,r=32,col='#000000')=>({type:'DROP_SHADOW',color:{...hex(col),a},offset:{x:0,y},radius:r,spread:0,visible:true,blendMode:'NORMAL'});\n\n// root components board\nconst board=AL('Components · FoodWagon','VERTICAL',{gap:64,pad:[80,80,80,80],fill:'#FAFAFA',ca:'MIN'});board.x=2100;board.y=0;board.cornerRadius=24;\nboard.appendChild(T('Components · FoodWagon',48,'Bold',C.ink,{name:'Title'}));\nfunction section(title){const s=AL('Section · '+title,'VERTICAL',{gap:24,ca:'MIN'});s.appendChild(T(title,24,'Bold',C.pri,{name:'Section title'}));const row=AL('Row','HORIZONTAL',{gap:32,ca:'MIN'});s.appendChild(row);board.appendChild(s);return row;}\n\n// BUTTON set\nlet row=section('Button · Style × State');\nconst styles={Primary:{d:[C.pri,C.white,C.white],h:[C.priH,C.white,C.white]},Secondary:{d:[C.white,C.pri,C.pri],h:[C.soft,C.priH,C.priH]},Soft:{d:[C.soft,C.pri,C.pri],h:[C.softH,C.priH,C.priH]},Ghost:{d:[null,C.ink,C.pri],h:[C.soft,C.pri,C.pri]}};\nconst btns=[];\nfor(const [s,v] of Object.entries(styles)){for(const st of ['Default','Hover','Disabled']){\n const spec=st==='Disabled'?[s==='Ghost'?null:C.dis,C.disTx,C.disTx]:(st==='Hover'?v.h:v.d);\n const c=figma.createComponent();c.name=`Style=${s}, State=${st}`;c.layoutMode='HORIZONTAL';c.primaryAxisSizingMode='AUTO';c.counterAxisSizingMode='AUTO';c.paddingTop=c.paddingBottom=16;c.paddingLeft=c.paddingRight=s==='Ghost'?16:28;c.itemSpacing=10;c.cornerRadius=12;c.counterAxisAlignItems='CENTER';c.primaryAxisAlignItems='CENTER';\n c.fills=spec[0]?solid(spec[0]):[];\n if(s==='Primary'&&st!=='Disabled')c.effects=[shadow(.28,8,20,C.pri)];\n if(s==='Secondary'&&st!=='Disabled')c.effects=[shadow(.10,6,16)];\n const li=await icon('search',spec[2]);li.name='Leading Icon';c.appendChild(li);\n const l=T('Button',18,'Bold',spec[1],{name:'Label'});c.appendChild(l);\n const ti=await icon('chevR',spec[2]);ti.name='Trailing Icon';c.appendChild(ti);\n btns.push(c);}}\nconst bset=figma.combineAsVariants(btns,row);bset.name='Button';bset.layoutMode='HORIZONTAL';bset.layoutWrap='WRAP';bset.counterAxisSpacing=24;bset.itemSpacing=24;bset.resize(760,100);bset.primaryAxisSizingMode='FIXED';bset.counterAxisSizingMode='AUTO';bset.paddingTop=bset.paddingBottom=bset.paddingLeft=bset.paddingRight=24;bset.fills=solid('#E9E9E9');bset.cornerRadius=16;\nconst kL=bset.addComponentProperty('Label','TEXT','Button');\nconst kLI=bset.addComponentProperty('Leading icon','BOOLEAN',false);\nconst kTI=bset.addComponentProperty('Trailing icon','BOOLEAN',true);\nconst kIc=bset.addComponentProperty('Icon','INSTANCE_SWAP',IC.search);\nfor(const c of bset.children){const [li,l,ti]=c.children;l.componentPropertyReferences={characters:kL};li.componentPropertyReferences={visible:kLI,mainComponent:kIc};ti.componentPropertyReferences={visible:kTI};}\n\n// Carousel arrow\nrow=section('Carousel Arrow · Direction × State');\nconst arrs=[];\nfor(const d of ['Prev','Next'])for(const st of ['Default','Hover','Disabled']){const c=figma.createComponent();c.name=`Direction=${d}, State=${st}`;c.resize(48,48);c.cornerRadius=24;c.layoutMode='HORIZONTAL';c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';c.primaryAxisAlignItems='CENTER';c.counterAxisAlignItems='CENTER';\nconst f=st==='Default'?C.pri:st==='Hover'?C.priH:C.dis;c.fills=solid(f);if(st!=='Disabled')c.effects=[shadow(.25,6,14,C.pri)];\nc.appendChild(await icon(d==='Prev'?'chevL':'chevR',st==='Disabled'?C.disTx:C.white));arrs.push(c);}\nconst aset=figma.combineAsVariants(arrs,row);aset.name='Carousel Arrow';aset.layoutMode='HORIZONTAL';aset.itemSpacing=16;aset.paddingTop=aset.paddingBottom=aset.paddingLeft=aset.paddingRight=24;aset.fills=solid('#E9E9E9');aset.cornerRadius=16;\n\n// Hero tab\nrow=section('Hero Tab · State');\nconst tabs=[];\nfor(const st of ['Current','Default','Hover']){const c=figma.createComponent();c.name=`State=${st}`;c.layoutMode='HORIZONTAL';c.primaryAxisSizingMode='AUTO';c.counterAxisSizingMode='AUTO';c.paddingTop=c.paddingBottom=12;c.paddingLeft=c.paddingRight=20;c.itemSpacing=10;c.cornerRadius=10;c.counterAxisAlignItems='CENTER';\nconst [bg,tx,ic,w]=st==='Current'?[C.soft,C.pri,C.pri,'Bold']:st==='Hover'?[C.surf,C.ink,C.ink,'SemiBold']:[null,C.muted,C.muted,'SemiBold'];c.fills=bg?solid(bg):[];\nconst i=await icon('moto',ic);c.appendChild(i);c.appendChild(T('Delivery',18,w,tx,{name:'Label'}));tabs.push(c);}\nconst tset=figma.combineAsVariants(tabs,row);tset.name='Hero Tab';tset.layoutMode='HORIZONTAL';tset.itemSpacing=16;tset.paddingTop=tset.paddingBottom=tset.paddingLeft=tset.paddingRight=24;tset.fills=solid('#FFFFFF');tset.cornerRadius=16;\nconst tL=tset.addComponentProperty('Label','TEXT','Delivery');const tI=tset.addComponentProperty('Icon','INSTANCE_SWAP',IC.moto);\nfor(const c of tset.children){c.children[1].componentPropertyReferences={characters:tL};c.children[0].componentPropertyReferences={mainComponent:tI};}\n\n// Field with icon (built on the given Text Field)\nrow=section('Field · State (built on 02 Text Field)');\nconst tf=await comp('1:31');const fields=[];\nfor(const st of ['Default','Focused','Filled']){const c=figma.createComponent();c.name=`State=${st}`;const inst=tf.createInstance();c.appendChild(inst);\n inst.children[0].visible=false;const inp=inst.findOne(n=>n.name==='Input');inp.paddingLeft=52;inst.layoutSizingHorizontal='FIXED';\n c.resize(420,56);inst.x=0;inst.y=0;inst.constraints={horizontal:'STRETCH',vertical:'STRETCH'};\n if(st==='Focused'){inp.fills=solid(C.white);inp.strokes=solid(C.pri);inp.strokeWeight=2;inp.effects=[shadow(.18,0,0,C.pri)];inp.effects=[{type:'DROP_SHADOW',color:{...hex(C.pri),a:.18},offset:{x:0,y:0},radius:0,spread:4,visible:true,blendMode:'NORMAL'}];}\n const ph=inst.findOne(n=>n.name==='Placeholder');ph.characters='Enter Your Address';if(st==='Filled')ph.fills=solid(C.ink);\n c.fills=[];const i=await icon('map',st==='Default'?C.muted:C.pri);c.appendChild(i);i.x=18;i.y=16;i.constraints={horizontal:'MIN',vertical:'CENTER'};fields.push(c);}\nconst fset=figma.combineAsVariants(fields,row);fset.name='Field / Icon';fset.layoutMode='HORIZONTAL';fset.itemSpacing=24;fset.paddingTop=fset.paddingBottom=fset.paddingLeft=fset.paddingRight=24;fset.fills=solid('#FFFFFF');fset.cornerRadius=16;\nconst fI=fset.addComponentProperty('Icon','INSTANCE_SWAP',IC.map);\nfor(const c of fset.children){c.children[1].componentPropertyReferences={mainComponent:fI};}\n\n// Badges & status\nrow=section('Badges, Status, Logo Mark');\nasync function badge(name,ik,label,bg){const c=figma.createComponent();c.name=name;c.layoutMode='HORIZONTAL';c.primaryAxisSizingMode='AUTO';c.counterAxisSizingMode='AUTO';c.paddingTop=c.paddingBottom=6;c.paddingLeft=10;c.paddingRight=12;c.itemSpacing=6;c.cornerRadius=8;c.counterAxisAlignItems='CENTER';c.fills=solid(bg);const i=await icon(ik,C.white,18);c.appendChild(i);const t=T(label,16,'Bold',C.white,{name:'Label'});c.appendChild(t);const k=c.addComponentProperty('Label','TEXT',label);t.componentPropertyReferences={characters:k};row.appendChild(c);return c;}\nconst bD=await badge('Badge / Discount','tag','20% off',C.pri);\nconst bF=await badge('Badge / Fast','clock','Fast',C.sec);\nconst sts=[];\nfor(const [st,lab,bg,tx] of [['Open','Open Now',C.okBg,C.okTx],['Closed','Opens tomorrow',C.clBg,C.clTx]]){const c=figma.createComponent();c.name='Status='+st;c.layoutMode='HORIZONTAL';c.primaryAxisSizingMode='AUTO';c.counterAxisSizingMode='AUTO';c.paddingTop=c.paddingBottom=6;c.paddingLeft=c.paddingRight=12;c.itemSpacing=8;c.cornerRadius=999;c.counterAxisAlignItems='CENTER';c.fills=solid(bg);const d=figma.createEllipse();d.name='Dot';d.resize(8,8);d.fills=solid(tx);c.appendChild(d);c.appendChild(T(lab,15,'Bold',tx,{name:'Label'}));sts.push(c);}\nconst sset=figma.combineAsVariants(sts,row);sset.name='Status Pill';sset.layoutMode='HORIZONTAL';sset.itemSpacing=16;sset.paddingTop=sset.paddingBottom=sset.paddingLeft=sset.paddingRight=16;sset.fills=solid('#FFFFFF');sset.cornerRadius=16;\nconst lm=figma.createComponent();lm.name='Logo Mark';lm.resize(64,64);lm.cornerRadius=16;lm.layoutMode='HORIZONTAL';lm.primaryAxisSizingMode='FIXED';lm.counterAxisSizingMode='FIXED';lm.primaryAxisAlignItems='CENTER';lm.counterAxisAlignItems='CENTER';\nlm.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[1,1,0],[-1,1,0.5]],gradientStops:[{position:0,color:{...hex(C.sec),a:1}},{position:1,color:{...hex(C.pri),a:1}}]}];lm.strokes=solid(C.white);lm.strokeWeight=3;lm.effects=[shadow(.12,4,12)];\nconst lt=T('FW',22,'Black',C.white,{name:'Initials'});lm.appendChild(lt);const lk=lm.addComponentProperty('Initials','TEXT','FW');lt.componentPropertyReferences={characters:lk};row.appendChild(lm);\nreturn {board:board.id,bset:bset.id,aset:aset.id,tset:tset.id,fset:fset.id,bD:bD.id,bF:bF.id,sset:sset.id,lm:lm.id};","description":"Create component board with buttons, arrows, tabs, fields, badges","fileKey":"nNa8Gsj0yGpnGfKLYRu7xU"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":11391,"cache_read_input_tokens":8893,"cache_creation":{"ephemeral_5m_input_tokens":11391,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8d84beb6-d490-4e82-87ae-33d251e21179","uuid":"1d165d93-e48c-431b-88e8-7ced5c750132","timestamp":"2026-11-01T21:26:05.607Z","tool_use_meta":[{"id":"toolu_bdrk_01HhESVR98gMnAYFWrsGczVD","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
