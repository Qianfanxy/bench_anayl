='FIXED';}}\n if(o.r!=null) f.cornerRadius=o.r; if(o.stroke){f.strokes=[P(o.stroke)]; f.strokeWeight=1; f.strokeAlign='INSIDE';} if(o.fx) f.effectStyleId=ES[o.fx].id; return f;}\nfunction add(p,c,o={}){p.appendChild(c); if(o.fillW) c.layoutSizingHorizontal='FILL'; if(o.fillH) c.layoutSizingVertical='FILL'; return c;}\nfunction tint(node,tok){const w=n=>{ if('strokes' in n && n.strokes.length && n.strokes[0].type==='SOLID') n.strokes=[P(tok)]; if('fills' in n && n.fills!==figma.mixed && n.fills.length && n.fills[0].type==='SOLID'){const c=n.fills[0].color; if(c.r<0.2&&c.g<0.2&&c.b<0.2) n.fills=[P(tok)];} if('children' in n) n.children.forEach(w);}; w(node);}\nasync function I(id){return (await N(id)).createInstance();}\n\n// container\nconst lib=Fr('Design System · Components',{dir:'VERTICAL',gap:56,pad:[64],fill:'surface/background',r:32});\nlib.x=0; lib.y=1000;\nasync function section(title){const s=Fr(title,{dir:'VERTICAL',gap:20}); add(s,await T(title,'Heading/H2')); lib.appendChild(s); const row=Fr('row',{dir:'HORIZONTAL',gap:32,ai:'MIN'}); s.appendChild(row); return row;}\n\n// ---- Icon Button\nlet row=await section('Icon Button');\nconst ib=Fr('Icon Button',{comp:true,dir:'HORIZONTAL',w:44,h:44,r:22,fill:'surface/default',stroke:'border/default',ai:'CENTER',jc:'CENTER'});\nconst ibIcon=await I('2:8'); ib.appendChild(ibIcon);\nconst swapKey=ib.addComponentProperty('Icon','INSTANCE_SWAP','2:8'); ibIcon.componentPropertyReferences={mainComponent:swapKey};\nrow.appendChild(ib);\n// Avatar component (sized)\nconst av=Fr('Avatar',{comp:true,w:40,h:40}); const avI=await I('2:65'); av.appendChild(avI); avI.rescale(40/48); avI.x=0; avI.y=0; row.appendChild(av);\n\n// ---- Buttons extended\nrow=await section('Button · states (extends 02 Button)');\nconst btnSpecs=[['Primary','Default','brand/primary','text/primary',null],['Primary','Pressed','brand/primary-pressed','text/primary',null],['Primary','Disabled','semantic/disabled','semantic/disabled-text',null],['Secondary','Default','surface/default','text/primary','border/strong'],['Secondary','Pressed','surface/background','text/primary','border/strong'],['Dark','Default','surface/dark','text/on-dark',null],['Destructive','Default','semantic/error-soft','semantic/error',null]];\nconst btns=[];\nfor(const [s,st,f,t,stroke] of btnSpecs){const b=Fr(`Style=${s}, State=${st}`,{comp:true,dir:'HORIZONTAL',w:335,h:52,r:26,fill:f,stroke,ai:'CENTER',jc:'CENTER',gap:8}); const tx=await T('Continue','Button/Label',t); tx.name='Label'; b.appendChild(tx); btns.push(b);}\nconst bset=figma.combineAsVariants(btns,row); bset.name='Button Extended'; bset.layoutMode='VERTICAL'; bset.itemSpacing=12; bset.paddingTop=bset.paddingBottom=bset.paddingLeft=bset.paddingRight=16; bset.primaryAxisSizingMode='AUTO'; bset.counterAxisSizingMode='AUTO';\nconst blk=bset.addComponentProperty('Label','TEXT','Continue'); bset.children.forEach(c=>c.findOne(n=>n.name==='Label').componentPropertyReferences={characters:blk});\n// small button\nconst sbs=[];\nfor(const [s,st,f,t,stroke] of [['Primary','Default','brand/primary','text/primary',null],['Primary','Pressed','brand/primary-pressed','text/primary',null],['Secondary','Default','surface/default','text/primary','border/strong'],['Destructive','Default','semantic/error-soft','semantic/error',null]]){const b=Fr(`Style=${s}, State=${st}`,{comp:true,dir:'HORIZONTAL',pad:[8,16],r:18,fill:f,stroke,ai:'CENTER',jc:'CENTER',gap:6}); const tx=await T('Pay now','Label/Medium',t); tx.name='Label'; b.appendChild(tx); sbs.push(b);}\nconst sset=figma.combineAsVariants(sbs,row); sset.name='Button Small'; sset.layoutMode='VERTICAL'; sset.itemSpacing=12; sset.paddingTop=sset.paddingBottom=sset.paddingLeft=sset.paddingRight=16; sset.primaryAxisSizingMode='AUTO'; sset.counterAxisSizingMode='AUTO';\nconst slk=sset.addComponentProperty('Label','TEXT','Pay now'); sset.children.forEach(c=>c.findOne(n=>n.name==='Label').componentPropertyReferences={characters:slk});\n\n// ---- Tab bar\nrow=a