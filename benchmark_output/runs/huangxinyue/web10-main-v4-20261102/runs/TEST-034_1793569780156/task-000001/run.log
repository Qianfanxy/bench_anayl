ls = [];\n  for (let c = 0; c < 2; c++) {\n    const [nm, rt, q, dt] = revData[r * 2 + c];\n    const rc = await inst('11:77');\n    rc.setProperties({ 'Rating#11:11': RATING[rt], 'Date#11:12': dt });\n    rc.findOne(n => n.name === 'name').characters = nm;\n    rc.findOne(n => n.name === 'quote').characters = q;\n    row.appendChild(rc);\n  }\n  sec.appendChild(row);\n}\nconst lm = await inst('9:102');\nlm.children[0].characters = 'Load More Reviews';\nlm.resize(218, 52);\nsec.appendChild(lm);\n// you might also like\nconst also = figma.createFrame();\nalso.name = 'section-also';\nalso.layoutMode = 'VERTICAL';\nalso.primaryAxisSizingMode = 'AUTO'; also.counterAxisSizingMode = 'FIXED';\nalso.resize(1240, 10);\nalso.counterAxisAlignItems = 'CENTER';\nalso.itemSpacing = 40;\nalso.fills = [];\nconst h = figma.createText();\nh.fontName = { family: 'Archivo Black', style: 'Regular' };\nh.characters = 'YOU MIGHT ALSO LIKE';\nh.fontSize = 32;\nh.fills = [S('#000000')];\nalso.appendChild(h);\nconst row2 = figma.createFrame();\nrow2.layoutMode = 'HORIZONTAL';\nrow2.primaryAxisSizingMode = 'AUTO'; row2.counterAxisSizingMode = 'AUTO';\nrow2.itemSpacing = 20;\nrow2.fills = [];\nfor (const d of [\n  { n: 'Polo with Contrast Trims', r: '4.0', pr: '$212', old: '$242', dc: '-20%', p: '4:40' },\n  { n: 'Gradient Graphic T-shirt', r: '3.5', pr: '$145', p: '4:35' },\n  { n: 'Polo with Tipping Details', r: '4.5', pr: '$180', p: '4:41' },\n  { n: 'Black Striped T-shirt', r: '5.0', pr: '$120', old: '$150', dc: '-30%', p: '4:32' }\n]) row2.appendChild(await makeCard(d));\nalso.appendChild(row2);\ncontent.appendChild(also);\ncontent.appendChild(await inst('10:37'));\nframe.appendChild(await inst('10:46'));\nreturn JSON.stringify({ done: '03 assembled' });","description":"Assemble 03_Product frame content","fileKey":"v7DhK3JEKoEZ85CKjv3t3x"}}],"id":"4e7079f4-9b57-4bbc-a947-648687b18783","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usag