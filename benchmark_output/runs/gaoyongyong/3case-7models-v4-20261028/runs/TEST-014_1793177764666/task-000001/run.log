'space/16':16,'space/20':20,'space/24':24,'space/32':32,'radius/sm':8,'radius/md':12,'radius/lg':16,'radius/xl':24,'radius/full':999})){const vr=figma.variables.createVariable(k,ncol,'FLOAT'); vr.setValueForMode(nm,v);}\nconst styles=[['Display/Balance',32,'SemiBold',40],['Heading/H1',24,'SemiBold',32],['Heading/H2',18,'SemiBold',24],['Heading/H3',16,'SemiBold',22],['Body/Medium',14,'Medium',20],['Body/Regular',14,'Regular',22],['Label/Medium',13,'Medium',18],['Caption/Regular',12,'Regular',16],['Caption/Medium',12,'Medium',16],['Micro/Medium',10,'Medium',14],['Button/Label',15,'Medium',20]];\nfor(const [n,s,w,lh] of styles){const st=figma.createTextStyle(); st.name=n; st.fontName={family:F,style:w}; st.fontSize=s; st.lineHeight={unit:'PIXELS',value:lh};}\nconst e=figma.createEffectStyle(); e.name='Elevation/Card'; e.effects=[{type:'DROP_SHADOW',color:{r:0.08,g:0.08,b:0.13,a:0.06},offset:{x:0,y:8},radius:24,spread:0,visible:true,blendMode:'NORMAL'}];\nconst e2=figma.createEffectStyle(); e2.name='Elevation/Nav'; e2.effects=[{type:'DROP_SHADOW',color:{r:0.08,g:0.08,b:0.13,a:0.08},offset:{x:0,y:-4},radius:20,spread:0,visible:true,blendMode:'NORMAL'}];\nreturn {col:col.id, n:Object.keys(tokens).length};"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":11050,"cache_read_input_tokens":21795,"cache_creation":{"ephemeral_5m_input_tokens":11050,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9b6cf0bf-bc44-403b-a903-8b507b85de29","uuid":"64a13556-4435-4292-86f9-9a092241c6e2","timestamp":"2026-10-28T08:58:35.490Z","tool_use_meta":[{"id":"toolu_bdrk_01GA8vK9vgLErDf4SCQyWeKy","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
