C.ink)];if(o.ls!==undefined)t.letterSpacing={unit:'PERCENT',value:o.ls};if(o.lh)t.lineHeight={unit:'PIXELS',value:o.lh};if(o.w){t.textAutoResize='HEIGHT';t.resize(o.w,t.height);}t.name=o.name||chars.slice(0,28);p.appendChild(t);t.x=x;t.y=y;if(o.al)t.textAlignHorizontal=o.al;return t;}\nfunction ico(p,k,x,y,w,h,col){const n=I(k);if(w)n.resize(w,h||w);n.x=x;n.y=y;n.fills=[];if(col)for(const c of n.children){if('fills'in c&&Array.isArray(c.fills)&&c.fills.length&&c.fills[0].type==='SOLID')c.fills=[S(col)];}p.appendChild(n);return n;}\nfunction compo(name,w,h){const c=figma.createComponent();c.name=name;c.resize(w,h);c.fills=[];page.appendChild(c);return c;}\nfunction findOne(n,name){if('children'in n){for(const c of n.children){if(c.name===name)return c;const r=findOne(c,name);if(r)return r;}}return null;}\nfunction btnLabel(b,label){const t=b.findOne(n=>n.type==='TEXT');try{t.constraints={horizontal:'CENTER',vertical:'CENTER'};}catch(e){}t.characters=label;const w=b.width,hh=b.height;b.resize(w+1,hh);b.resize(w,hh);return b;}\n\n// ---- Site Header ----\nconst hd=compo('Site Header',1440,104);hd.fills=[S(C.white)];\nhd.strokes=[S(C.line)];hd.strokeWeight=1;hd.strokeTopWeight=0;hd.strokeLeftWeight=0;hd.strokeRightWeight=0;hd.strokeBottomWeight=1;\nconst lg=I('logo');lg.x=64;lg.y=28;hd.appendChild(lg);lg.name='Logo';\nconst navs=['Home','Recipes','Blog','Contact','About us'];let nx=620;\nfor(const n of navs){const t=tx(hd,n,16,'m',C.body,nx,42,{name:'Nav/'+n});nx+=t.width+36;}\nico(hd,'fb',1272,42,10,20);ico(hd,'tw',1312,43,22,18);ico(hd,'ig',1354,41,22,22);\nhd.x=-3400;hd.y=0;\n\n// ---- Site Footer ----\nconst ft=compo('Site Footer',1440,208);ft.fills=[S(C.white)];\nft.strokes=[S(C.line)];ft.strokeWeight=1;ft.strokeTopWeight=1;ft.strokeLeftWeight=0;ft.strokeRightWeight=0;ft.strokeBottomWeight=0;\nconst lg2=I('logo');lg2.x=64;lg2.y=44;ft.appendChild(lg2);lg2.name='Logo';\nconst links=['Recipes','Blog','Contact','About us'];let lw=0;const ltexts=[];\nfor(const L of links){const t=tx(ft,L,15,'m',C.ink,0,62,{name:'Lnk/'+L});lw+=t.width;ltexts.push(t);}lw+=3*36;\nlet lx=1376-lw;for(const t of ltexts){t.x=lx;lx+=t.width+36;}\ntx(ft,'Simple, tasty recipes for every day.',15,'r',C.body,64,112,{name:'Tagline'});\nconst dv=rc(ft,64,152,1312,1,0,'Divider');dv.fills=[S(C.line)];\ntx(ft,'© 2020 Foodieland. All rights reserved.',13,'r',C.muted,64,176,{name:'Copyright'});\nico(ft,'fb',1272,172,10,20);ico(ft,'tw',1312,173,22,18);ico(ft,'ig',1354,171,22,22);\nft.x=-3400;ft.y=240;\n\n// ---- Newsletter Card ----\nconst nl=compo('Newsletter Card',1312,232);nl.fills=[S(C.tint)];nl.cornerRadius=28;\nim(nl,'veggies',40,104,165,120,'FIT',0,'Decor Veggies');\nim(nl,'leaf',1096,16,88,120,'FIT',0,'Decor Leaf');\nim(nl,'salad',1192,92,115,120,'FIT',0,'Decor Salad');\ntx(nl,'Deliciousness to your inbox',28,'b',C.ink,0,44,{w:1312,al:'CENTER',name:'Title'});\ntx(nl,'Get new recipes and cooking tips in your inbox every week. No spam, unsubscribe anytime.',15,'r',C.body,0,88,{w:1312,al:'CENTER',name:'Copy'});\nconst fld=I('field');nl.appendChild(fld);fld.name='Email Field';fld.x=382;fld.y=107;\nconst lab=findOne(fld,'Label');lab.visible=false;\nconst inp=findOne(fld,'Input');inp.resize(372,60);\nconst pl=findOne(fld,'Placeholder');pl.characters='Your email address...';\nconst sb=btnLabel(I('btn'),'Subscribe');nl.appendChild(sb);sb.name='Subscribe Button';sb.x=770;sb.y=136;\nnl.x=-3400;nl.y=520;\n\n// ---- Promo Card ----\nconst pc=compo('Promo Card',1312,220);pc.fills=[S(C.tint)];pc.cornerRadius=28;\nim(pc,'adv',1024,0,240,220,'FIT',0,'Ad Photo');\ntx(pc,\"Don't forget to eat healthy food\",28,'b',C.ink,72,52,{w:440,lh:36,name:'Title'});\nconst lk=tx(pc,'www.foodieland.com',16,'sb',C.ink,72,150,{name:'Link'});lk.textDecoration='UNDERLINE';\npc.x=-3400;pc.y=840;\n\n// ---- Recipe Card set ----\nfunction buildCard(){const c=compo('tmp',300,356);c.fills=[];\nconst ph=rc(c,0,0,300,260,24,'Photo');\nconst bd=fr(c,236,16,48,48,'FavBadge',C.white,999);bd.effects=[SHA