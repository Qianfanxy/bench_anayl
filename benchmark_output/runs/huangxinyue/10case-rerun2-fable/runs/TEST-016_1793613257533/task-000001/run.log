l)]:[]; c.cornerRadius=rad||0; page.appendChild(c); return c;}\nfunction icon(parent,compId,size,color,x,y,name){\n  const c=figma.getNodeById(compId); const inst=c.createInstance(); parent.appendChild(inst);\n  inst.rescale(size/inst.width);\n  inst.findAll(n=>n.type===\"VECTOR\").forEach(v=>{ if(v.fills&&v.fills.length) v.fills=[P(color)]; if(v.strokes&&v.strokes.length) v.strokes=[P(color)]; });\n  inst.x=x===undefined?0:x; inst.y=y===undefined?0:y; if(name) inst.name=name;\n  return inst;\n}\nfunction img(parent,compId,w,h,x,y,mode){\n  const c=figma.getNodeById(compId); const inst=c.createInstance(); parent.appendChild(inst);\n  inst.rescale(w/inst.width); inst.x=x; inst.y=y;\n  if(h!==undefined){ inst.resize(w,h); }\n  if(mode && \"scaleFactor\" in inst) inst.scaleFactor=mode;\n  return inst;\n}\nfunction photo(parent,compId,w,h,x,y,fit){\n  const wrap=box(parent, \"Photo Wrap\", w,h,x,y,null,0); wrap.clipsContent=true;\n  const c=figma.getNodeById(compId); const inst=c.createInstance();\n  const s = fit===\"cover\" ? Math.max(w/inst.width, h/inst.height) : Math.min(w/inst.width, h/inst.height);\n  inst.rescale(s);\n  wrap.appendChild(inst);\n  inst.x=(w-inst.width)/2; inst.y=(h-inst.height)/2;\n  return wrap;\n}\n\n// styles\nconst COLORS=[[\"brand/primary\",\"#24C8FE\"],[\"brand/deep\",\"#0B9ED1\"],[\"ink/900\",\"#101C2B\"],[\"ink/700\",\"#33445A\"],[\"ink/500\",\"#7B8896\"],[\"ink/300\",\"#B4BFCB\"],[\"line/divider\",\"#E9EFF5\"],[\"surface/subtle\",\"#F5F9FC\"],[\"white\",\"#FFFFFF\"],[\"tint/warmup\",\"#FFF0E7\"],[\"tint/yoga\",\"#E6F8F0\"],[\"tint/squats\",\"#EAF2FF\"],[\"tint/lunge\",\"#F3EDFF\"],[\"activity/run\",\"#F77D39\"],[\"activity/swim\",\"#27B0E6\"],[\"activity/cycle\",\"#6B5CE7\"],[\"accent/heart\",\"#0074B9\"],[\"state/disabled\",\"#E5EDF3\"]];\nfor(const [n,h] of COLORS){ let s=figma.getLocalPaintStyles().find(x=>x.name===n); if(!s){s=figma.createPaintStyle();s.name=n;} s.paints=[P(h)]; }\nfor(const [n,w,s,lh] of [[\"Display/32\",\"B\",32,40],[\"Title/26\",\"B\",26,32],[\"H2/20\",\"B\",20,26],[\"H3/17\",\"SB\",17,24],[\"Body/15\",\"R\",15,23],[\"BodyStrong/15\",\"SB\",15,23],[\"Label/13\",\"M\",13,18],[\"Caption/12\",\"M\",12,16],[\"Micro/11\",\"SB\",11,14]]){\n  let st=figma.getLocalTextStyles().find(x=>x.name===n); if(!st) st=figma.createTextStyle();\n  st.name=n; st.fontName=F[w]; st.fontSize=s; st.lineHeight={unit:\"PIXELS\",value:lh};\n}\n\n// buttons\nfunction button(name,bg,fg,border){\n  const c=comp(name,374,56,bg,28);\n  c.layoutMode=\"HORIZONTAL\"; c.primaryAxisAlignItems=\"CENTER\"; c.counterAxisAlignItems=\"CENTER\";\n  c.primaryAxisSizingMode=\"FIXED\"; c.counterAxisSizingMode=\"FIXED\";\n  T(c,\"Label\",\"Get started\",{w:\"SB\",s:16,c:fg,lh:20});\n  if(border){c.strokes=[P(border)];c.strokeWeight=1.5;c.strokeAlign=\"INSIDE\";}\n  return c;\n}\nconst btnPrimary=button(\"Button / Primary\",\"#24C8FE\",\"#FFFFFF\"); btnPrimary.effects=[sh(\"#24C8FE\",0.38,12,26)];\nconst btnPressed=button(\"Button / Pressed\",\"#0B9ED1\",\"#FFFFFF\");\nconst btnSecondary=button(\"Button / Secondary\",\"#FFFFFF\",\"#101C2B\",\"#DCE7F0\");\nconst btnDisabled=button(\"Button / Disabled\",\"#E5EDF3\",\"#B4BFCB\");\nbtnPrimary.x=0;btnPrimary.y=0;btnPressed.x=0;btnPressed.y=90;btnSecondary.x=0;btnSecondary.y=180;btnDisabled.x=0;btnDisabled.y=270;\n\n// tab bars\nconst TABS=[[\"Home\",\"3:21\"],[\"Activity\",\"3:16\"],[\"Profile\",\"3:26\"],[\"Settings\",\"3:29\"]];\nconst tabBars={};\nTABS.forEach(([label],idx)=>{\n  const c=comp(\"Tab Bar / \"+label,414,84,\"#FFFFFF\");\n  c.strokes=[P(\"#E9EFF5\")]; c.strokeWeight=1; c.strokeAlign=\"INSIDE\"; c.effects=[sh(\"#101C2B\",0.05,-8,24)];\n  TABS.forEach(([l2,ic2],i)=>{\n    const active=i===idx;\n    const slot=box(c,\"Tab · \"+l2,92,54,13+i*97,7,null,16);\n    slot.layoutMode=\"VERTICAL\"; slot.primaryAxisAlignItems=\"CENTER\"; slot.counterAxisAlignItems=\"CENTER\";\n    slot.primaryAxisSizingMode=\"FIXED\"; slot.counterAxisSizingMode=\"FIXED\"; slot.itemSpacing=4;