list.layoutSizingHorizontal='FILL';\nconst descTexts=[\n'As a Lead Software Engineer at Searchlight, I played a pivotal role in developing innovative solutions for Searchlight’s core search algorithms. Collaborating with a dynamic team of engineers, I contributed to the enhancement of search accuracy and efficiency, optimizing user experiences for millions of users worldwide.',\n'At Meridian Social, I served as a Software Engineer, focusing on the design and implementation of backend systems for the social media company’s dynamic platform. Working on projects that involved large-scale data processing and user engagement features, I leveraged my expertise to ensure seamless functionality and scalability.',\n'During my tenure at Orchard Computing, I worked as a Junior Software Engineer and contributed to the architecture of mission-critical software projects. I helped design scalable and efficient systems as part of a cross-functional team.'];\nconst itemIds=['10:81','10:91','10:101'];\nconst metas=[['Searchlight','Nov 2019 – Present'],['Meridian Social','Jan 2017 – Oct 2019'],['Orchard Computing','Jan 2016 – Dec 2016']];\nfor(let i=0;i<3;i++){\n  const inst=await clone(itemIds[i]);inst.name='ExperienceItem / '+metas[i][0];\n  list.appendChild(inst);inst.layoutSizingHorizontal='FILL';\n  inst.findOne(n=>n.name==='Description').characters=descTexts[i];\n  inst.findOne(n=>n.name==='Company').characters=metas[i][0];\n  inst.findOne(n=>n.name==='Dates').characters=metas[i][1];\n}\n// CONTACT\nconst contact=sec('Contact');contact.paddingBottom=0;\ncontact.strokes=[solid(C.border)];contact.strokeWeight=1;contact.strokeAlign='INSIDE';contact.strokeTopWeight=1;contact.strokeLeftWeight=0;contact.strokeRightWeight=0;contact.strokeBottomWeight=0;\nsecHeader(contact,'GET IN TOUCH','Contact',null,null);\nconst cGrid=figma.createFrame();cGrid.name='Contact columns';cGrid.layoutMode='HORIZONTAL';cGrid.primaryAxisSizingMode='FIXED';cGrid.counterAxisSizingMode='AUTO';\ncGrid.resize(1280,10);cGrid.itemSpacing=80;cGrid.counterAxisAlignItems='MIN';cGrid.fills=[];contact.appendChild(cGrid);cGrid.layoutSizingHorizontal='FILL';\nconst cLeft=figma.createFrame();cLeft.name='Contact copy';cLeft.layoutMode='VERTICAL';cLeft.primaryAxisSizingMode='AUTO';cLeft.counterAxisSizingMode='FIXED';\ncLeft.resize(660,10);cLeft.itemSpacing=28;cLeft.fills=[];cGrid.appendChild(cLeft);\ncLeft.appendChild(T('Seasoned Full Stack Software Engineer with over 8 years of hands-on experience in designing and implementing robust, scalable, and innovative web solutions. Adept at leveraging a comprehensive skill set encompassing front-end and back-end technologies.',19,'Regular','#C9C9D2',{lh:34,name:'Contact body'}));\nconst emailRow=figma.createFrame();emailRow.name='Email row';emailRow.layoutMode='HORIZONTAL';emailRow.primaryAxisSizingMode='AUTO';emailRow.counterAxisSizingMode='AUTO';\nemailRow.itemSpacing=14;emailRow.counterAxisAlignItems='CENTER';emailRow.paddingTop=18;emailRow.paddingBottom=18;emailRow.paddingLeft=22;emailRow.paddingRight=26;\nemailRow.cornerRadius=100;emailRow.fills=[solid(C.elevated)];emailRow.strokes=[solid(C.border)];emailRow.strokeWeight=1;\ncLeft.appendChild(emailRow);\nconst mail=await clone('3:3');mail.resize(22,22);const mv=mail.findOne(n=>n.type==='VECTOR');if(mv)mv.fills=[solid(C.orange)];emailRow.appendChild(mail);\nemailRow.appendChild(T('abm@example.com',18,'Medium',C.text,{name:'Email address'}));\nconst ctaRow=figma.createFrame();ctaRow.name='Social row';ctaRow.layoutMode='HORIZONTAL';ctaRow.primaryAxisSizingMode='AUTO';ctaRow.counterAxisSizingMode='AUTO';\nctaRow.itemSpacing=12;ctaRow.counterAxisAlignItems='CENTER';ctaRow.fills=[];cLeft.appendChild(ctaRow);\nfor(const id of ['7:60','7:66','7:72']){ctaRow.appendChild(await clone(id));}\nconst cRight=figma.createFrame();cRight.name='Contact card';cRight.layoutMode='VERTICAL';cRight.primaryAxisSizingMode='AUTO';cRight.counterAxisSizingMode='FIXED';\ncRight.resize(520,10);cRight.itemSpacing=24;cRight.paddingTop=36;cRight.paddingRight=36;cRight.paddingBottom=36;cRight.paddingLeft=36;\ncRight.cornerRadius=24;cRight.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[1,0.4,0],[0,1,0]],gradientStops:[{position:0,color:Object.assign(rgb('#1B1210'),{a:1})},{position:1,color:Object.assign(rgb('#101826'),{a:1})}]}];\ncRight.strokes=[solid('#2E2E3A')];cRight.strokeWeight=1;cGrid.appendChild(cRight);\ncRight.appendChild(T('OPEN TO PROJECTS',11,'SemiBold',C.orange,{ls:2}));\ncRight.appendChild(T('Let’s build something\\nreliable together.',26,'SemiBold',C.text,{lh:34}));\ncRight.appendChild(await clone('7:41'));\ncRight.appendChild(T('Typically replies within a day.',13,'Regular',C.muted,{name:'Reply note'}));\nconst footer=figma.createFrame();footer.name='Footer';footer.layoutMode='HORIZONTAL';footer.primaryAxisSizingMode='FIXED';footer.counterAxisSizingMode='AUTO';\nfooter.resize(1280,96);footer.primaryAxisAlignItems='SPACE_BETWEEN';footer.counterAxisAlignItems='CENTER';footer.fills=[];\ncontact.appendChild(footer);footer.layoutSizingHorizontal='FILL';\nconst fLogo=await clone('3:4');fLogo.resize(96,54);footer.appendChild(fLogo);\nfooter.appendChild(T('© 2024 ABM. Built with care.',13,'Regular',C.muted,{name:'Copyright'}));\nconst fnav=figma.createFrame();fnav.name='Footer nav';fnav.layoutMode='HORIZONTAL';fnav.primaryAxisSizingMode='AUTO';fnav.counterAxisSizingMode='AUTO';\nfnav.itemSpacing=28;fnav.counterAxisAlignItems='CENTER';fnav.fills=[];footer.appendChild(fnav);\nfor(const l of ['Home','Projects','Experience','Contact']) fnav.appendChild(T(l,13,'Medium',C.sub,{name:'Link / '+l}));\nreturn {mainH:main.height, kids:main.children.map(c=>[c.id,c.name,c.height])};","description":"Build remaining sections of 01_Home","fileKey":"rWatUx8u9ogpUtH7IHQ5Wt"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":61338,"input_tokens":1,"cache_read_input_tok