e===\"LINE\"){try{if(l.fills&&l.fills.length&&l.fills[0].visible!==false)l.fills=c;}catch(e){}try{if(l.strokes&&l.strokes.length&&l.strokes[0].visible!==false)l.strokes=c;}catch(e){}}if(l.type===\"TEXT\")l.fills=c;if(\"children\"in l){for(const k2 of l.children)walk(k2);}};walk(n);}\n     function mediaInst(name,parent){const m=MASTER[name].createInstance();parent.appendChild(m);return m;}\n     function statusBar(parent,white){const s=MASTER[\"Status Bar\"].createInstance();parent.appendChild(s);s.x=0;s.y=0;s.fills=[];recolor(s,white?\"#FFFFFF\":\"#181725\");return s;}\n     function homeInd(parent,white,y){const h=MASTER[\"Home Indicator\"].createInstance();parent.appendChild(h);h.x=0;h.y=y;h.fills=[];recolor(h,white?\"#FFFFFF\":\"#181725\");return h;}\n     const SH=(y,r,a)=>[{type:\"DROP_SHADOW\",color:{r:0,g:0,b:0,a:a},offset:{x:0,y:y},radius:r,visible:true,blendMode:\"NORMAL\"}];\n     function hotspot(parent,name,x,y,w,h){const r=figma.createRectangle();parent.appendChild(r);r.x=x;r.y=y;r.resize(w,h);r.fills=[];r.name=name;return r;}\n     function centered(parent,ch,sz,st,col,y){const t=txt(ch,sz,st,col,414);parent.appendChild(t);t.textAlignHorizontal=\"CENTER\";t.x=0;t.y=y;return t;}\n     function circleBtn(parent,x,y,name){const cb=MASTER[\"Circle Button\"].createInstance();parent.appendChild(cb);cb.x=x;cb.y=y;cb.name=name;return cb;}\n     ```\n     Custom-frame builders (reuse verbatim for fixes):\n     ```js\n     function prodCard(parent,x,y,name,title,unit,price,imgName){const c=figma.createFrame();parent.appendChild(c);c.x=x;c.y=y;c.resize(171,206);c.cornerRadius=18;c.fills=[F(C.white)];c.strokes=[F(C.border)];c.effects=SH(4,16,0.06);c.name=name;const im=figma.createFrame();c.appendChild(im);im.x=12;im.y=12;im.resize(147,86);im.fills=[];im.clipsContent=true;im.name=\"Image\";const m=mediaInst(imgName,im);const s=Math.min(130/m.width,80/m.height);m.resize(m.width*s,m.height*s);m.x=(147-m.width)/2;m.y=(86-m.height)/2;const nm=txt(title,16,\"Medium\",C