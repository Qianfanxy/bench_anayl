layoutSizingHorizontal='FILL';if(o.fillH)f.layoutSizingVertical='FILL';}return f;}\nasync function T(chars,style,color='text/primary',o={}){const t=figma.createText();t.fontName={family:'Inter',style:'Regular'};t.characters=chars;await t.setTextStyleIdAsync(S[style].id);t.fills=[paint(color)];if(o.name)t.name=o.name;if(o.align)t.textAlignHorizontal=o.align;if(o.parent){o.parent.appendChild(t);if(o.fillW){t.layoutSizingHorizontal='FILL';t.textAutoResize='HEIGHT';}}if(o.w){t.resize(o.w,t.height);t.textAutoResize='HEIGHT';}return t;}\nfunction I(name,w,h,parent){const i=M[name].createInstance();if(w)i.resize(w,h);if(parent)parent.appendChild(i);return i;}\nfunction icon(name,color,size=24,parent){const i=I(name,null,null,parent);if(size!==i.width)i.rescale(size/i.width);if(color)i.findAll(n=>n.type==='VECTOR').forEach(v=>v.fills=[paint(color)]);return i;}\nconst N=async id=>await figma.getNodeByIdAsync(id);\nconst C={hdr:await N('11:9'),ftr:await N('11:31'),navCur:await N('11:6'),rcOff:await N('12:34'),rcOn:await N('12:53'),promo:await N('12:76'),nl:await N('12:110'),author:await N('13:84'),ingOff:await N('13:59'),ingOn:await N('13:63'),step:await N('13:68'),side:await N('13:78'),stat:await N('13:89'),nut:await N('13:146')};\nfunction swapPhoto(inst,photo){const p=inst.findOne(n=>n.name==='Photo'&&n.type==='INSTANCE');p.swapComponent(M[photo]);p.layoutSizingHorizontal='FILL';p.layoutSizingVertical='FILL';}\nfunction card(parent,[title,cat,fav,photo],w){const i=(fav?C.rcOn:C.rcOff).createInstance();parent.appendChild(i);if(w)i.resize(w,i.height);i.findOne(n=>n.name==='Title').characters=title;i.findOne(n=>n.name==='Category Label').characters=cat;swapPhoto(i,photo);i.name='Recipe Card / '+title;return i;}\nfunction page(name,x,cur){const f=F(name,'VERTICAL',{w:1440,fill:'surface/white',cross:'CENTER'});f.x=x;f.y=0;f.clipsContent=true;const h=C.hdr.createInstance();f.appendChild(h);h.findOne(n=>n.name==='Nav / '+cur).swapComponent(C.navCur);const body=F('Content','VERTICAL',{w:1440,gap:120,p:[64,80,120,80],cross:'CENTER',parent:f});return {f,body};}\nconst vdiv=p=>F('Divider','HORIZONTAL',{w:1,h:48,fill:'border/divider',parent:p});\nconst more4=[['Mixed Tropical Fruit Salad with Superfood Boosts','Healthy',1,'Photo_Tropical_Fruit_Salad'],['Big and Juicy Wagyu Beef Cheeseburger','Western',0,'Photo_Wagyu_Cheeseburger_Alt'],['Healthy Japanese Fried Rice with Asparagus','Healthy',0,'Photo_Japanese_Fried_Rice'],['Cauliflower Walnut Vegetarian Taco Meat','Eastern',0,'Photo_Cauliflower_Taco']];\nconst {f,body}=page('02_Recipe',1540,'Recipes');\nconst top=F('Recipe Header','VERTICAL',{gap:48,parent:body,fillW:true});\nconst tr=F('Title Row','HORIZONTAL',{main:'SPACE_BETWEEN',cross:'MAX',parent:top,fillW:true});\nconst tl=F('Title & Meta','VERTICAL',{gap:32,parent:tr});\nawait T('Healthy Japanese Fried Rice with Asparagus','Display','text/primary',{parent:tl,w:860,name:'Title'});\nconst meta=F('Recipe Meta','HORIZONTAL',{gap:32,cross:'CENTER',parent:tl});\nmeta.appendChild(C.author.createInstance()); vdiv(meta);\nconst s1=C.stat.createInstance(); meta.appendChild(s1); s1.findOne(n=>n.name==='Value').characters='15 Minutes'; s1.name='Prep Time'; vdiv(meta);\nconst s2=C.stat.createInstance(); meta.appendChild(s2); s2.findOne(n=>n.name==='Label').characters='COOK TIME'; s2.name='Cook Time'; vdiv(meta);\nconst s3=C.stat.createInstance(); meta.appendChild(s3); s3.findOne(n=>n.name==='Label').visible=false; s3.findOne(n=>n.name==='Value').characters='Healthy'; s3.findOne(n=>n.name==='Icon').swapComponent(M['Icon_Fork_Knife']); s3.name='Category';\ns3.findOne(n=>n.name==='Icon').findAll(n=>n.type==='VECTOR').forEach(v=>v.fills=[paint('text/primary')]);\nconst acts=F('Actions','HORIZONTAL',{gap:32,parent:tr});\nfor(const [ic,l] of [['Icon_Print','PRINT'],['Icon_Share','SHARE']]){const a=F('Action / '+l,'VERTICAL',{gap:10,cross:'CENTER',parent:acts});const c=F('Icon','HORIZONTAL',{w:72,h:72,r:999,main:'CENTER',cross:'CENTER',fill:'brand/tint',parent