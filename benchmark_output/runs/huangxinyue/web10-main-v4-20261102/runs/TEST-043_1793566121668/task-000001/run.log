t:{x:0,y},radius:blur,spread:0,visible:true,blendMode:'NORMAL'}];return n;}\nasync function PIC(id,w,h,r=0){const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();i.resize(w,h);if(r)i.cornerRadius=r;return i;}\nfunction paintDeep(n,c){if('fills'in n&&Array.isArray(n.fills)&&n.fills.some(x=>x.type==='SOLID'))try{n.fills=n.fills.map(x=>x.type==='SOLID'?S(c):x)}catch(e){};if('strokes'in n&&Array.isArray(n.strokes)&&n.strokes.length)try{n.strokes=n.strokes.map(x=>x.type==='SOLID'?S(c):x)}catch(e){};if(n.children)n.children.forEach(x=>paintDeep(x,c));}\nasync function ICO(id,w,c=C.txt){const n=await figma.getNodeByIdAsync(id);const i=n.createInstance();const h=i.height*w/i.width;i.resize(w,h);if(c)paintDeep(i,c);return i;}\nfunction TXT0(inst,name,s){const n=inst.findOne(x=>x.name===name&&x.type==='TEXT');if(n)n.characters=s;return n;}\n```\n\nNote: top-level await is allowed in Figma plugin async context? use_figma code runs as async function body presumably. I'll write `await` directly (the earlier test call used await fine).\n\nComponents to create in Call A:\n\n1. Btn/Black: frame auto h? create: `const b=figma.createComponent();` set name 'Btn/Black'; AL horizontal gap 0 pad [32,0,32,0], main CENTER cross CENTER, cw FIXED h56? Set counterAxisSizingMode 'FIXED' then resize h? Simpler: pad [32,16,32,16] with text 16 lh 24 → h=56. Let text define height: Poppins 16 line-height default ~24.8? Explicitly set lineHeight 24px → 24+32=56. radius 10, fill ink, text white Poppins Medium? Given button uses Regular 16. Use Regular. Name text child 'Label'.\n\n2. Btn/Ghost: same but fill white, stroke ink, text ink.\n\n3. Btn/Red? Not needed.\n\n4. UI/Tag: pad [14,8,14,8] border line r20 text Poppins Regular 13 sub→ink? Text ink 13. h≈ 24? text 13 lh 18 + 16 = 34.\n\n5. SizeBox: 48×48 fixed, border line r8, text Poppins 14 txt centered. Selected: border ink 1.5 + fill ink text white? Selected = black fill white text (strong). Create two comps: 'SizeBox' & 'SizeBox/S