{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_1aa18060d824416b83a80c5f","name":"mcp__figma__use_figma","input":{"code":"for (const f of [['Archivo Black','Regular'],['Plus Jakarta Sans','Regular'],['Plus Jakarta Sans','Medium'],['Plus Jakarta Sans','SemiBold'],['Plus Jakarta Sans','Bold'],['Inter','Regular']]) {\n  await figma.loadFontAsync({family: f[0], style: f[1]});\n}\nconst ws = await figma.getNodeByIdAsync('6:2');\nconst frame = await figma.getNodeByIdAsync('16:2');\nconst RATING = { '5.0': '9:11', '4.5': '9:27', '4.0': '9:43', '3.5': '9:59', '3.0': '9:75' };\nasync function inst(id) { return (await figma.getNodeByIdAsync(id)).createInstance(); }\nfunction hcenter(width) {\n  const f = figma.createFrame();\n  f.layoutMode = 'VERTICAL';\n  f.primaryAxisSizingMode = 'AUTO';\n  f.counterAxisSizingMode = 'FIXED';\n  f.resize(width, 10);\n  f.counterAxisAlignItems = 'CENTER';\n  f.fills = [];\n  return f;\n}\nasync function makeCard(d) {\n  const c = await inst('11:2');\n  c.setProperties({\n    'Photo#11:0': d.p,\n    'Rating#11:1': RATING[d.r],\n    'Name#11:2': d.n,\n    'Score#11:3': d.r + '/5',\n    'Price#11:4': d.pr,\n    'OldPrice#11:5': d.old || '$0',\n    'Discount#11:6': d.dc || '-0%',\n    'ShowOld#11:7': !!d.old,\n    'ShowDiscount#11:8': !!d.old\n  });\n  const photo = c.children[0].children[0];\n  photo.resize(187, 280);\n  return c;\n}\nasync function sectionHeading(label, arrows) {\n  const s = figma.createFrame();\n  s.layoutMode = 'HORIZONTAL';\n  s.primaryAxisSizingMode = 'AUTO';\n  s.counterAxisSizingMode = 'AUTO';\n  s.counterAxisAlignItems = 'CENTER';\n  s.itemSpacing = 24;\n  s.fills = [];\n  const t = figma.createText();\n  t.fontName = { family: 'Archivo Black', style: 'Regular' };\n  t.characters = label;\n  t.fontSize = 32;\n  t.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  s.appendChild(t);\n  if (arrows) {\n    for (const [iid, tint] of [['4:4', '#000000'], ['4:6', '#000000']]) {\n      const comp = await figma.getNodeByIdAsync(iid);\n      const ic = comp.createInstance();\n      ic.resize(24, 24);\n      ic.fills = [];\n      const walk = n => {\n        if ('fills' in n && Array.isArray(n.fills) && n.fills.length && n.type !== 'INSTANCE') { try { n.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }]; } catch (e) {} }\n        if ('children' in n) n.children.forEach(walk);\n      };\n      ic.children.forEach(walk);\n      s.appendChild(ic);\n    }\n  }\n  return s;\n}\nasync function productsSection(label, data) {\n  const sec = figma.createFrame();\n  sec.name = 'section-' + label;\n  sec.layoutMode = 'VERTICAL';\n  sec.primaryAxisSizingMode = 'AUTO';\n  sec.counterAxisSizingMode = 'FIXED';\n  sec.resize(1240, 10);\n  sec.counterAxisAlignItems = 'CENTER';\n  sec.itemSpacing = 40;\n  sec.fills = [];\n  sec.appendChild(await sectionHeading(label, false));\n  const row = figma.createFrame();\n  row.layoutMode = 'HORIZONTAL';\n  row.primaryAxisSizingMode = 'AUTO';\n  row.counterAxisSizingMode = 'AUTO';\n  row.itemSpacing = 20;\n  row.fills = [];\n  for (const d of data) row.appendChild(await makeCard(d));\n  sec.appendChild(row);\n  const va = await inst('9:102');\n  va.children[0].characters = 'View All';\n  va.resize(218, 52);\n  sec.appendChild(va);\n  return sec;\n}\n// --- build ---\nconst ab = await inst('10:2');\nframe.appendChild(ab);\nconst hd = await inst('10:7');\nframe.appendChild(hd);\nconst content = figma.createFrame();\ncontent.name = 'content';\ncontent.layoutMode = 'VERTICAL';\ncontent.primaryAxisSizingMode = 'AUTO';\ncontent.counterAxisSizingMode = 'FIXED';\ncontent.resize(1440, 10);\ncontent.paddingLeft = 100; content.paddingRight = 100;\ncontent.paddingTop = 40; content.paddingBottom = 64;\ncontent.itemSpacing = 64;\ncontent.fills = [];\nframe.appendChild(content);\ncontent.appendChild(await inst('15:2')); // Hero\ncontent.appendChild(await inst('15:26')); // Brand Strip\ncontent.appendChild(await productsSection('NEW ARRIVALS', [\n  { n: 'T-shirt with Tape Details', r: '4.5', pr: '$120', p: '4:48' },\n  { n: 'Skinny Fit Jeans', r: '3.5', pr: '$240', old: '$260', dc: '-20%', p: '4:42' },\n  { n: 'Checkered Shirt', r: '4.5', pr: '$180', p: '4:33' },\n  { n: 'Sleeve Striped T-shirt', r: '4.5', pr: '$130', old: '$160', dc: '-30%', p: '4:43' }\n]));\ncontent.appendChild(await productsSection('TOP SELLING', [\n  { n: 'Vertical Striped Shirt', r: '5.0', pr: '$212', old: '$232', dc: '-20%', p: '4:51' },\n  { n: 'Courage Graphic T-shirt', r: '4.0', pr: '$145', p: '4:49' },\n  { n: 'Loose Fit Bermuda Shorts', r: '3.0', pr: '$80', p: '4:37' },\n  { n: 'Faded Skinny Jeans', r: '4.5', pr: '$210', p: '4:34' }\n]));\n// Dress style section\n{\n  const sec = figma.createFrame();\n  sec.name = 'section-dressstyle';\n  sec.layoutMode = 'VERTICAL';\n  sec.primaryAxisSizingMode = 'AUTO';\n  sec.counterAxisSizingMode = 'FIXED';\n  sec.resize(1240, 10);\n  sec.counterAxisAlignItems = 'CENTER';\n  sec.itemSpacing = 40;\n  sec.fills = [];\n  sec.appendChild(await sectionHeading('BROWSE BY DRESS STYLE', false));\n  const row = figma.createFrame();\n  row.layoutMode = 'HORIZONTAL';\n  row.primaryAxisSizingMode = 'AUTO';\n  row.counterAxisSizingMode = 'AUTO';\n  row.itemSpacing = 65;\n  row.fills = [];\n  const tiles = [['Casual', '4:44', 293], ['Formal', '4:45', 330], ['Party', '4:47', 275], ['Gym', '4:46', 147]];\n  for (const [label, pid, w] of tiles) {\n    const t = await inst('11:41');\n    t.setProperties({ 'Photo#11:9': pid, 'Label#11:10': label });\n    t.resize(w, 220);\n    row.appendChild(t);\n  }\n  sec.appendChild(row);\n  content.appendChild(sec);\n}\n// Happy customers\n{\n  const sec = figma.createFrame();\n  sec.name = 'section-reviews';\n  sec.layoutMode = 'VERTICAL';\n  sec.primaryAxisSizingMode = 'AUTO';\n  sec.counterAxisSizingMode = 'FIXED';\n  sec.resize(1240, 10);\n  sec.counterAxisAlignItems = 'CENTER';\n  sec.itemSpacing = 40;\n  sec.fills = [];\n  sec.appendChild(await sectionHeading('OUR