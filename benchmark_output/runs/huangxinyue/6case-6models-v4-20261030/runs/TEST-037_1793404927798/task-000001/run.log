.name]=c;\n\nasync function shell(f){ const sb=await inst(\"2:34\",375,44); sb.x=0;sb.y=0;f.appendChild(sb); const hi=await inst(\"2:45\",375,34); hi.x=0;hi.y=778;f.appendChild(hi); }\n\n// ===== 01_Splash =====\n{\n  const f = scr[\"01_Splash\"];\n  f.fills=[{type:\"SOLID\",color:C.primary}];\n  const logo = await inst(\"4:11\",220,80); logo.x=(375-220)/2; logo.y=340; f.appendChild(logo);\n  const tag = T(\"Fashion & Lifestyle Shopping\",14,\"Medium\",C.white); tag.x=(375-tag.width)/2; tag.y=440; f.appendChild(tag);\n  // recolor logo to white: instance children vectors — set fills\n  function recolor(n){ if(\"fills\" in n && n.type!==\"INSTANCE\"){ try{n.fills=[{type:\"SOLID\",color:C.white}];}catch(e){} } if(\"children\" in n) for(const c of n.children) recolor(c); }\n  recolor(logo);\n  const tag2 = T(\"Shop smart. Look stylish.\",11,\"Regular\",{r:1,g:1,b:1,a:1}); tag2.fills=[{type:\"SOLID\",color:C.white,opacity:0.85}]; tag2.x=(375-tag2.width)/2; tag2.y=700; f.appendChild(tag2);\n}\n\n// ===== onboarding builder =====\nasync function onboarding(frameName, mediaId, mediaW, mediaH, title, body, step, hasPrev, ctaLabel){\n  const f = scr[frameName];\n  const skip = T(\"Skip\",14,\"SemiBold\",C.gray); skip.x=327-skip.width; skip.y=60; f.appendChild(skip); skip.name=\"Skip\";\n  let prev=null;\n  if (hasPrev){ prev = T(\"Prev\",14,\"SemiBold\",C.gray); prev.x=48; prev.y=60; f.appendChild(prev); prev.name=\"Prev\"; }\n  const img = await inst(mediaId, mediaW, mediaH);\n  // scale media to 300 wide preserving ratio\n  const sc = 300/mediaW; img.resize(300, mediaH*sc);\n  img.x=(375-300)/2; img.y=140; f.appendChild(img);\n  const titleT = T(title,24,\"Bold\",C.ink,{align:\"CENTER\"}); titleT.x=40; titleT.y=470; titleT.resize(295,titleT.height); f.appendChild(titleT);\n  const bodyT = T(body,14,\"Regular\",C.gray,{align:\"CENTER\",lh:22}); bodyT.x=48; bodyT.y=512; bodyT.resize(279,66); f.appendChild(bodyT);\n  // dots\n  for (let i=0;i<3;i++){ const d=R(i+1===step?24:8,8,i+1===step?C.primary:C.border,4); d.x=166+i*16; d.y=620; f.appendChild(d); }\n  const btn = await inst(\"2:24\"); btn.x=29; btn.y=672; f.appendChild(btn);\n  btn.name = ctaLabel===\"Get Started\"?\"GetStartedBtn\":\"NextBtn\";\n  const lbl = btn.findOne(n=>n.type===\"TEXT\"); if(lbl){ lbl.characters=ctaLabel; lbl.x=(317-lbl.width)/2; }\n  return {skip, prev, btn};\n}\nconst ob2 = await onboarding(\"02_Onboarding_Choose_Products\",\"3:59\",180,180,\"Choose Products\",\"Browse thousands of products across fashion, beauty, electronics and more.\",1,false,\"Next\");\nconst ob3 = await onboarding(\"03_Onboarding_Make_Payment\",\"3:62\",269,180,\"Make Payment\",\"Pay securely with your saved cards, PayPal or Apple Pay.\",2,true,\"Next\");\nconst ob4 = await onboarding(\"04_Onboarding_Get_Your_Order\",\"3:65\",180,180,\"Get Your Order\",\"Track your order until it arrives at your door.\",3,true,\"Get Started\");\n\nreturn \"01-04 done\";","description":"Build 01_Splash and three onboarding screens"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"14b42764-d761-4609-9d48-7eed784bda72","uuid":"d5e1fb10-a791-48a6-9436-33d5feb3ba4e","timestamp":"2026-10-31T00:15:17.835Z","tool_use_meta":[{"id":"mcp__figma__use_figma_19_a8d58158","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
