=\"3811\" width=\"1312\" height=\"281\">\n      <text id=\"7:128\" name=\"What is fixed · what is yours\" x=\"0\" y=\"0\" width=\"328\" height=\"36\" />\n      <frame id=\"7:129\" name=\"Fixed vs yours\" x=\"0\" y=\"52\" width=\"1312\" height=\"229\">\n        <frame id=\"7:130\" name=\"Fixed (given)\" x=\"0\" y=\"0\" width=\"644\" height=\"229\">\n          <text id=\"7:131\" name=\"Fixed (given)\" x=\"24\" y=\"24\" width=\"103\" height=\"24\" />\n          <text id=\"7:132\" name=\"• Frame list and exact names • Must-include content per frame (what, not how) • Navigation structure and links • All data and copy • Brand primary color #1573FE + Poppins and Roboto • Media: logos, coin icons, banners, avatar, ID card placeholder, icons • Default Button, default Text Field, platform shell\" x=\"24\" y=\"58\" width=\"596\" height=\"147\" />\n        </frame>\n        <frame id=\"7:133\" name=\"Yours (designer decides)\" x=\"668\" y=\"0\" width=\"644\" height=\"229\">\n          <text id=\"7:134\" name=\"Yours (designer decides)\" x=\"24\" y=\"24\" width=\"197\" height=\"24\" />\n          <text id=\"7:135\" name=\"• Layout, grouping, order and emphasis on every screen • All other colors: neutrals, text, surfaces, light / dark mode, gain / loss, semantic and chart colors • Type scale, spacing, radii, elevation • All states: selected, pressed, disabled, unread, rising / falling • Headers, both bottom navigations and all business components • Chart styling (weekly spending, budget, trends, order book depth)\" x=\"24\" y=\"58\" width=\"596\" height=\"147\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"7:136\" name=\"How it is evaluated\" x=\"64\" y=\"4140\" width=\"1312\" height=\"291\">\n      <text id=\"7:137\" name=\"How it is evaluated\" x=\"0\" y=\"0\" width=\"222\" height=\"36\" />\n      <text id=\"7:138\" name=\"Your file is compared with the brief on coverage, data and flow — not on visual similarity to any reference.\" x=\"0\" y=\"52\" width=\"1312\" height=\"23\" />\n      <text id=\"7:139\" name=\"1. Checklist coverage per frame 2. Data &amp; copy accuracy 3. Flow &amp; prototype completeness 4. Information hierarchy 5. Visual quality &amp; consistency of your own system 6. Component reuse 7. State design (current tabs and switches, selected day, unread notifications, gains vs losses, amount being entered)\" x=\"0\" y=\"91\" width=\"1312\" height=\"161\" />\n      <text id=\"7:140\" name=\"Deliverable: the link to your own Figma file containing the 10 named frames, your components and the prototype.\" x=\"0\" y=\"268\" width=\"1312\" height=\"23\" />\n    </frame>\n  </frame>\n</canvas>"},{"type":"text","text":"IMPORTANT: After you call this tool, you MUST call get_design_context if trying to implement the design, since this tool only returns metadata. If you do not call get_design_context, the agent will not be able to implement the design."}],"_meta":{"mcpRequestId":"09d3823c-2153-4ad0-a135-586321011479"}},"tool_result_meta":[{"id":"call_1d53117e6ac14b84a39997bc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
