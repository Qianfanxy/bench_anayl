#EAEEF1', red:'#D9553F', redSoft:'#FBE3DA', blue:'#3E9BE0' };\n\nfunction rect(w,h,color,r){ const n=figma.createRectangle(); n.resize(w,h); n.fills = color? [{type:'SOLID',color:C(color)}] : []; if(r!==undefined) n.cornerRadius=r; return n; }\nfunction txt(chars,size,style,color,opts={}){ const t=figma.createText(); t.fontName={family:'Lato',style}; t.characters=chars; t.fontSize=size; t.fills=[{type:'SOLID',color:C(color)}]; if(opts.lh) t.lineHeight={value:opts.lh,unit:'PIXELS'}; if(opts.align) t.textAlignHorizontal=opts.align; if(opts.w){ t.textAutoResize='HEIGHT'; t.resize(opts.w,100); t.textAutoResize='HEIGHT'; } return t; }\n```\nHmm resize text with w: createText default autoResize WIDTH_AND_HEIGHT; setting resize(w, h) when WIDTH_AND_HEIGHT errors? Set textAutoResize='HEIGHT' first then resize(w,10). OK.\n\nicon helper (async due to getNodeById):\n```js\nconst ICONS = { Analytics:'5:21', Back:'5:23', Chevron:'5:19', Cycling:'5:18', Explore:'5:22', Fire:'5:20', Heart:'5:24', Home:'5:25', Play:'5:26', Profile:'5:27', Search:'5:28', Sleep:'5:29', Steps:'5:30', Timer:'5:31', Water:'5:32' };\nasync function icon(name,size,color){ const comp=await figma.getNodeByIdAsync(ICONS[name]); const i=comp.createInstance(); if(size!==24) i.resize(size,size); i.fills=[]; const paint=[{type:'SOLID',color:C(color)}]; const walk=n=>{ if(n.type==='VECTOR'){ try{n.fills=paint;}catch(e){} } (n.children||[]).forEach(walk); }; walk(i); return i; }\n```\n\nphoto cover:\n```js\nconst PHOTOS = { Onboarding:'5:13', BackwardLunges:'5:2', BellyFat:'5:4', Biceps:'5:15', Hand:'5:5', JumpingJacks:'5:6', KneePushUp:'5:9', Leg:'5:7', LoseFat:'5:8', LowerBody:'5:10', Plank:'5:11', PushUp:'5:12', Quarantine:'5:17', SitUp:'5:16', Squats:'5:14', Map:'5:3' };\nasync function photoCover(name,w,h,r){ const comp=await figma.getNodeByIdAsync(PHOTOS[name]); const f=figma.createFrame(); f.name='photo/'+name; f.resize(w,h); f.clipsContent=true; if(r) f.cornerRadius=r; f.fills=[]; const i=comp.createInstance(); const s=Math.max(w/comp.width, h/comp.height); const iw=comp.width*s, ih=comp.height*s; i.resize(iw,ih); i.x=(w-iw)/2; i.y=(h-ih)/2; f.appendChild(i); return f; }\n```\nNote: instance resize keeps aspect? resize(iw,ih) with derived s preserves aspect ✓.\n\nPhoto instances created by createInstance are added to current page; then appendChild moves into frame ✓. Inside components: creating component then append children works.\n\nBut careful: photoCover inside a COMPONENT for PlanRow etc: the photo instance inside component; per screen-instance I need to SWAP the photo instance to another photo: nested instance swap ✓ via swapInstance(otherComp). The clip frame is a regular frame inside component → its child instance accessible in instances as nested node. ✓\n\nNow components:\n\n```js\n// ---- LevelTag variants\nasync function makeTag(label, bg, fg){\n  const comp = figma.createComponent(); comp.name='level='+label;\n  const t = txt(label,10,'Bold',fg); comp.appendChild(t);\n  const w = Math.ceil(t.width)+18; comp.resize(w,22); comp.cornerRadius=11;\n  comp.fills=[{type:'SOLID',color:C(bg)}];\n  t.x=(comp.width-t.width)/2; t.y=(22-t.height)/2; t.name='label';\n  return comp;\n}\nconst tagB = await makeTag('Beginner', COL.limeSoft, COL.limeDark);\nconst tagI = await makeTag('Intermediate', COL.chipGray, COL.charcoal);\nconst tagE = await makeTag('Expert', COL.redSoft, COL.red);\n```\nThen combine: place them first: set x,y positions, append to WS, then combineAsVariants([tagB,tagI,tagE], WS); rename property later via variantGroupProperties? `set.variantGroupProperties` → rename key 'Property 1' to 'level': combined.variantGroupProperties['Property 1'].name? Actually: `vs.variantGroupProperties` returns object; to rename: vs.editVariantGroupProperty? Hmm API: `componentSet.variantGroupProperties` read-only? There's no direct rename... Actually ComponentSetNode has `variantGroupProperties` (readonly map). To rename property you can... I recall you CAN mutate via 