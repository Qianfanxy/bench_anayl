ze(size,size); tintV(i,color); i.x=x;i.y=y; return i; };\nconst photo=(parent,name,x,y,w,h,r)=>{ const c=P(name); const i=c.createInstance(); parent.appendChild(i); i.name=name; i.fills=[{type:'IMAGE',imageHash:c.fills[0].imageHash,scaleMode:'FILL'}]; i.resize(w,h); if(r) i.cornerRadius=r; i.x=x;i.y=y; return i; };\nconst frame=(parent,x,y,w,h,fill,name,r)=>{ const f=figma.createFrame(); parent.appendChild(f); f.name=name||'Frame'; f.resize(w,h); f.fills=fill?[solid(fill)]:[]; if(r) f.cornerRadius=r; f.x=x;f.y=y; return f; };\nconst headerInst=(parent,cur)=>{ const v=lib.findOne(n=>n.type==='COMPONENT'&&n.name==='Current='+(cur||'none')); const i=v.createInstance(); parent.appendChild(i); i.name='SiteHeader'; i.x=0;i.y=0; return i; };\nconst footerInst=(parent,y)=>{ const i=B('SiteFooter').createInstance(); parent.appendChild(i); i.name='SiteFooter'; i.x=0;i.y=y; return i; };\nconst btn=(parent,label,style,x,y)=>{ const c=lib.findOne(n=>n.type==='COMPONENT'&&n.name==='Style='+style); const i=c.createInstance(); parent.appendChild(i); i.name='Button_'+label; const t=i.findOne(n=>n.type==='TEXT'); if(t) t.characters=label; i.x=x;i.y=y; return i; };\nconst products=[\n {name:'Syltherine',desc:'Stylish cafe chair',price:'Rs. 2,500,000.00',old:'Rs. 3,500,000.00',badge:'-30%',photo:'Photo_Product_Syltherine'},\n {name:'Leviosa',desc:'Stylish cafe chair',price:'Rs. 2,500,000.00',old:null,badge:null,photo:'Photo_Product_Leviosa'},\n {name:'Lolito',desc:'Luxury big sofa',price:'Rs. 7,000,000.00',old:'Rs. 14,000,000.00',badge:'-50%',photo:'Photo_Product_Lolito'},\n {name:'Respira',desc:'Outdoor bar table and stool',price:'Rs. 500,000.00',old:null,badge:'New',photo:'Photo_Product_Respira'}\n];\nconst mkCard=(parent,p,x,y,state)=>{\n  const v=cardSet.children.find(c=>c.name==='State='+(state||'Default'));\n  const i=v.createInstance(); parent.appendChild(i); i.name='ProductCard_'+p.name;\n  const ph=i.findOne(n=>n.name==='Photo'); if(ph){ const c=P(p.photo); ph.fills=[{type:'IM