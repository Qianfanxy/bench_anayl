{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgQMp1JTd209vBENMMuLR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01osFZi7b7FEqE0Oo41zIWZn","name":"mcp__figma__use_figma","input":{"code":"\nconst PG=await figma.getNodeByIdAsync('9:2');await figma.setCurrentPageAsync(PG);\nfor(const s of ['Regular','Medium','Semi Bold','Bold'])await figma.loadFontAsync({family:'Inter',style:s});\nconst LIB=await figma.getNodeByIdAsync('11:2');\nconst PAL={black:'#000000',ink:'#14141A',body:'#5B5B66',muted:'#8C8C99',line:'#EAEAF0',surface:'#F6F7F8',tint:'#E7F9FD',white:'#FFFFFF',fav:'#E5484D'};\nfunction hx(h){h=h.replace('#','');return{r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255};}\nfunction solid(h,o){return{type:'SOLID',color:hx(h),opacity:o===undefined?1:o};}\nconst W={r:'Regular',m:'Medium',sb:'Semi Bold',b:'Bold'};\nfunction TT(p,o,c){const t=figma.createText();t.name=o.name||'T';t.fontName={family:'Inter',style:W[o.st||'r']};t.characters=c;t.fontSize=o.sz||16;t.lineHeight={unit:'PERCENT',value:(o.lh||1.45)*100};if(o.ls!==undefined)t.letterSpacing={unit:'PERCENT',value:o.ls};t.fills=[solid(o.c||PAL.ink)];t.textAlignHorizontal=o.al||'LEFT';p.appendChild(t);t.textAutoResize='HEIGHT';t.resize(o.w||300,12);t.x=o.x||0;t.y=o.y||0;return t;}\nfunction FF(p,o){const f=figma.createFrame();f.name=o.name||'F';f.resize(o.w,o.h);f.fills=o.fill?[solid(o.fill)]:[];if(o.r)f.cornerRadius=o.r;if(o.stroke){f.strokes=[solid(o.stroke)];f.strokeWeight=o.sw||1;}if(o.clip)f.clipsContent=true;if(o.ef)f.effects=o.ef;p.appendChild(f);f.x=o.x||0;f.y=o.y||0;return f;}\nfunction IMG(p,o){const r=figma.createRectangle();r.name=o.name||'Image';r.resize(o.w,o.h);r.cornerRadius=o.r||0;r.fills=[{type:'IMAGE',imageHash:o.hash,scaleMode:'FILL'}];p.appendChild(r);r.x=o.x||0;r.y=o.y||0;return r;}\nconst IDS={fb:'7:48',ig:'7:49',tw:'7:50',timer:'7:47',fork:'7:40',fav:'7:37',play:'7:42',arrow:'7:35',hot:'7:70',more:'7:41'};\nasync function IC(p,id,size,x,y,color){const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();p.appendChild(i);const k=Math.max(c.width,c.height);i.rescale(size/k);i.findAll(n=>n.type==='VECTOR').forEach(v=>{if(v.fills.length)v.fills=[solid(color)];if(v.strokes.length)v.strokes=[solid(color)];});if(x!==undefined){i.x=x;i.y=y;}return i;}\nasync function CI(p,id,x,y,w){const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();p.appendChild(i);i.rescale(w/c.width);i.x=x;i.y=y;return i;}\n\n// ---------- REBUILD RECIPE CARD ----------\nfor(const n of [...LIB.children]) if(n.name==='Card / Recipe') n.remove();\nfunction mkCard(fav){\n  const c=figma.createComponent();c.name='Favorite='+(fav?'Yes':'No');c.resize(302,326);c.fills=[];\n  const ph=FF(c,{name:'Photo',w:302,h:220,r:20,clip:true,x:0,y:0});\n  IMG(ph,{w:302,h:220,hash:'a8a2f85871e0a64ae8021799559e16d6e570fab4'});\n  const fb=FF(c,{name:'FavBtn',w:40,h:40,fill:PAL.white,r:20,x:248,y:12});\n  fb.effects=[{type:'DROP_SHADOW',color:{r:0,g:0,b:0,a:0.12},offset:{x:0,y:4},radius:10,spread:0,visible:true,blendMode:'NORMAL'}];\n  const heart=figma.createNodeFromSvg('<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M12 20.4l-1.45-1.32C5.4 14.36 2 11.28 2 7.5 2 4.42 4.42 2 7.5 2c1.74 0 3.41.81 4.5 2.09C13.09 2.81 14.76 2 16.5 2 19.58 2 22 4.42 22 7.5c0 3.78-3.4 6.86-8.55 11.58L12 20.4z\" fill=\"'+(fav?PAL.fav:'#1A1A22')+'\"/></svg>');\n  heart.name='Heart';fb.appendChild(heart);heart.x=11;heart.y=11;\n  TT(c,{name:'Title',w:302,sz:18,st:'sb',lh:1.4,x:0,y:238},'Healthy Japanese Fried Rice with Asparagus');\n  return c;\n}\nconst cNo=mkCard(false),cYes=mkCard(true);\n// meta added to both after combine so instances inherit\nconst rcSet=figma.combineAsVariants([cNo,cYes],LIB);rcSet.name='Card / Recipe';rcSet.x=60;rcSet.y=1130;\nfunction addMeta(c){\n  IC(c,IDS.timer,18,0,300,PAL.muted);\n  TT(c,{name:'Time',w:90,sz:14,c:PAL.muted,x:24,y:298},'30 Minutes');\n  IC(c,IDS.fork,18,116,300,PAL.muted);\n  TT(c,{name:'Category',w:140,sz:14,c:PAL.muted,x:140,y:298},'Healthy');\n}\nawait addMeta(cNo);await addMeta(cYes);\n\n// ---------- PROMO BANNER ----------\nfor(const n of [...LIB.children]) if(n.name==='Card / Promo Banner') n.remove();\nconst pb=figma.createComponent();pb.name='Card / Promo Banner';pb.resize(1280,300);pb.fills=[solid(PAL.tint)];pb.cornerRadius=32;pb.clipsContent=true;LIB.appendChild(pb);pb.x=60;pb.y=2280;\nconst pbImg=FF(pb,{name:'Photo',w:420,h:300,x:0,y:0});IMG(pbImg,{w:420,h:300,hash:'df2aff7269d68d065424bc94eae150fd3b422ce4'});\nTT(pb,{name:'PromoTitle',w:520,sz:34,st:'b',lh:1.2,ls:-0.5,x:480,y:96},'Don’t forget to eat healthy food');\nTT(pb,{name:'PromoUrl',w:420,sz:15,c:PAL.body,x:480,y:186},'www.foodieland.com');\nconst pbBtn=await figma.getNodeByIdAsync('11:5');\nconst pbInst=pbBtn.createInstance();pb.appendChild(pbInst);pbInst.x=480;pbInst.y=224;pbInst.findOne(n=>n.type==='TEXT').characters='Learn More';\nconst pdec=await figma.getNodeByIdAsync('7:14');const pdi=pdec.createInstance();pb.appendChild(pdi);pdi.rescale(90/120);pdi.x=1160;pdi.y=170;\n\n// ---------- HOME ----------\nfor(const n of [...PG.children]) if(n.name==='01_Home') n.remove();\nconst home=figma.createFrame();home.name='01_Home';home.resize(1440,1000);home.x=0;home.y=0;home.fills=[solid(PAL.white)];home.clipsContent=false;PG.appendChild(home);\n\n// header instance\nconst hdrComp=await figma.getNodeByIdAsync('13:20');\nconst hdr=hdrComp.createInstance();home.appendChild(hdr);hdr.x=0;hdr.y=0;\n\n// HERO\nconst hero=FF(home,{name:'Hero',w:1440,h:560,x:0,y:104});\nconst hl=FF(hero,{name:'Copy',w:560,h:400,x:80,y:70});\nconst eb=FF(hl,{name:'Eyebrow',w:190,h:38,fill:PAL.tint,r:19,x:0,y:0});\nawait IC(eb,IDS.hot,22,16,8,'#0F6E78');\nTT(eb,{name:'HotLabel',w:140,sz:14,st:'sb',ls:5,c:'#0F6E78',x:46,y:9},'Hot Recipes');\nTT(hl,{name:'H1',w:560,sz:54,st:'b',lh:1.12,ls:-1.5,x:0,y:62},'Spicy delicious chicken wings');\nTT(hl,{name:'Body',w:470,sz:16,c:PAL.body,lh:1.65,x:0,y:196},'Crispy outside, juicy inside and coated in a sticky, spicy glaze — these wings are ready in 30 minutes and disappear even faster.');\n// meta chips\nawait IC(hl,IDS.timer,18,4,282,PAL.ink);TT(hl,{name:'mtime',w:90,sz:14,c:PAL.body,x:28,y:278},'30 Minutes');\nawait IC(hl,IDS.fork,18,132,282,PAL.ink);TT(hl,{name:'mcat',w:80,sz:14,c:PAL.body,x:156,y:278},'Chicken');\n// author\nconst avComp=await figma.getNodeByIdAsync('13:2');\nconst av=avComp.createInstance();hl.appendChild(av);av.rescale(40/48);av.x=250;av.y=269;\nTT(hl,{name:'aname',w:150,sz:14,st:'sb',x:300,y:268},'John Smith');\nTT(hl,{name:'adate',w:150,sz:12,c:PAL.muted,x:300,y:288},'15 March 2022');\n// CTA\nconst btnComp=await figma.getNodeByIdAsync('11:5');\nconst cta=btnComp.createInstance();hl.appendChild(cta);cta.x=0;cta.y=326;cta.findOne(n=>n.type==='TEXT').characters='View Recipes';\ncta.paddingLeft=24;cta.paddingRight=28;cta.paddingTop=18;cta.paddingBottom=18;\nconst plw=FF(cta,{name:'PlayWrap',w:32,h:32,fill:PAL.white,r:16,x:24,y:14});\nawait IC(plw,IDS.play,13,9,9,PAL.black);\n// hero media\nconst hm=FF(hero,{name:'Media',w:660,h:470,x:720,y:40});\nconst blob=figma.createEllipse();blob.name='Tint';blob.resize(500,500);blob.fills=[solid(PAL.tint)];hm.appendChild(blob);blob.x=110;blob.y=10;\nIMG(hm,{name:'HeroPhoto',w:620,h:420,hash:'4a576da13bc911ad9fbca47b72fa857356e78980',r:28,x:30,y:25});\nconst badge=FF(hm,{name:'Badge',w:132,h:132,fill:PAL.black,r:66,x:-6,y:290});\nTT(badge,{name:'b1',w:110,sz:15,st:'sb',c:PAL.white,al:'CENTER',lh:1.25,x:11,y:44},'Handpicked');\nTT(badge,{name:'b2',w:110,sz:15,st:'sb',c:PAL.white,al:'CENTER',lh:1.25,x:11,y:66},'Recipes');\nconst dtc=await figma.getNodeByIdAsync('7:14');const di=dtc.createInstance();hm.appendChild(di);di.rescale(64/120);di.x=576;di.y=-6;\nconst dic=await figma.getNodeByIdAsync('7:12');const dio=dic.createInstance();hm.appendChild(dio);dio.rescale(74/120);dio.x=-24;dio.y=-18;\n\n// CATEGORIES\nconst cat=FF(home,{name:'Categories',w:1440,h:330,x:0,y:664});\nTT(cat,{name:'CatTitle',w:600,sz:40,st:'b',ls:-1,x:80,y:0},'Categories');\nconst va=FF(cat,{name:'ViewAll',w:230,h:52,fill:PAL.white,r:16,stroke:PAL.line,sw:1.5,x:1130,y:0});\nTT(va,{name:'vat',w:150,sz:15,st:'sb',x:24,y:14},'View All Categories');\nconst tileSet=await figma.getNodeByIdAsync('11:60');\nconst tileNames=['Name=Breakfast','Name=Lunch','Name=Meat','Name=Vegan','Name=Dessert','Name=Chocolate'];\nfor(let i=0;i<6;i++){\n  const comp=tileSet.children.find(c=>c.name===tileNames[i]);\n  const ti=comp.createInstance();cat.appendChild(ti);ti.x=80+i*212;ti.y=92;\n}\ncat.resize(1440,280);\n\n// CHEF PROMO\nconst chef=FF(home,{name:'ChefPromo',w:1280,h:440,fill:PAL.tint,r:32,x:80,y:1010});\nchef.clipsContent=true;\nconst chefImg=FF(chef,{name:'Photo',w:520,h:440,x:0,y:0});\nIMG(chefImg,{w:520,h:440,hash:'53be7a4eb46d964a5461312afca21e0f577d1bae'});\nconst dtx=await figma.getNodeByIdAsync('7:14');const dx=dtx.createInstance();chef.appendChild(dx);dx.rescale(80/120);dx.x=470;dx.y=120;\nconst don=await figma.getNodeByIdAsync('7:12');const dnx=don.createInstance();chef.appendChild(dnx);dnx.rescale(76/120);dnx.x=498;dnx.y=300;\nTT(chef,{name:'ChefH',w:620,sz:40,st:'b',lh:1.22,ls:-1,x:610,y:96},'Everyone can be a chef in their own kitchen');\nTT(chef,{name:'ChefBody',w:520,sz:16,c:PAL.body,lh:1.65,x:610,y:214},'Step-by-step recipes, clear timings and tips from our cooks help you make restaurant-quality food at home.');\nconst learn=btnComp.createInstance();chef.appendChild(learn);learn.x=610;learn.y=316;learn.findOne(n=>n.type==='TEXT').characters='Learn More';\nreturn {home:home.id,cards:[cNo.id,cYes.id],promoBanner:pb.id};\n","description":"Rebuild recipe card with meta, add promo banner, build Home hero/categories/chef promo","fileKey":"KBfh4lzngcd72ozCVtDt2c"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standar