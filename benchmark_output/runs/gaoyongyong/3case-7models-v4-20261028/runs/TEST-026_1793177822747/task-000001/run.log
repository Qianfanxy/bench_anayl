de = 'AUTO';\nlib.paddingLeft = lib.paddingRight = lib.paddingTop = lib.paddingBottom = 24;\nws.appendChild(lib);\nconst map = {};\nfor (const [name, id] of Object.entries(ids)) {\n  const src = await figma.getNodeByIdAsync(id);\n  if (!src) { map[name] = 'MISSING'; continue; }\n  const c = src.clone();\n  lib.appendChild(c);\n  c.name = name;\n  map[name] = c.id;\n}\nreturn JSON.stringify(map);","description":"Switch to workspace page, load fonts, clone all library assets","fileKey":"LoWw4yZnsmEbrzRZ2AMTxG"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"4ae3e056-c163-4c22-ba71-93fbd4764287","uuid":"b61dee89-8070-42a7-89cc-b7857acc410a","timestamp":"2026-10-28T09:11:51.333Z","tool_use_meta":[{"id":"mcp__figma__use_figma_11_17d2dce5","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
