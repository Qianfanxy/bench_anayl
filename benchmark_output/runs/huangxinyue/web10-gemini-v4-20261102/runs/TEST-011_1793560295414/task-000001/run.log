{"type":"assistant","message":{"id":"chatcmpl-202611011918282104566148268d9d6WHy74Kei","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_9d4050c681f44ad9b5f141b46611d0f3","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Semi Bold\" });\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Bold\" });\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Light\" });\n\n  const workspace = figma.root.children.find(p => p.name.includes(\"03\"));\n  await figma.setCurrentPageAsync(workspace);\n\n  const mediaMap = {\n    \"Logo_Facebook\": \"13:44\", \"Logo_Furniro\": \"13:3\", \"Logo_LinkedIn\": \"13:35\", \"Logo_Twitter\": \"13:36\",\n    \"Photo_Hero\": \"13:9\", \"Photo_Page_Banner\": \"13:16\", \"Photo_Asgaard_Sofa\": \"13:4\", \"Photo_Cloud_Sofa_1\": \"13:7\",\n    \"Photo_Cloud_Sofa_2\": \"13:8\", \"Photo_Maya_Sofa\": \"13:13\", \"Photo_Outdoor_Sofa_Set\": \"13:14\",\n    \"Photo_Outdoor_Sofa_Set_Alt\": \"13:15\", \"Photo_Product_Grifo\": \"13:73\", \"Photo_Product_Leviosa\": \"13:17\",\n    \"Photo_Product_Lolito\": \"13:18\", \"Photo_Product_Muggo\": \"13:19\", \"Photo_Product_Pingky\": \"13:67\",\n    \"Photo_Product_Potty\": \"13:66\", \"Photo_Product_Respira\": \"13:20\", \"Photo_Product_Syltherine\": \"13:21\",\n    \"Photo_Stuart_Sofa\": \"13:64\", \"Photo_Inspiration_2\": \"13:10\", \"Photo_Inspiration_3\": \"13:11\",\n    \"Photo_Inspiration_Inner_Peace\": \"13:12\", \"Photo_Range_Bedroom\": \"13:22\", \"Photo_Range_Dining\": \"13:23\",\n    \"Photo_Range_Living\": \"13:24\", \"Photo_Setup_1\": \"13:69\", \"Photo_Setup_2\": \"13:72\", \"Photo_Setup_3\": \"13:58\",\n    \"Photo_Setup_4\": \"13:70\", \"Photo_Setup_5\": \"13:59\", \"Photo_Setup_6\": \"13:60\", \"Photo_Setup_7\": \"13:61\",\n    \"Photo_Setup_8\": \"13:62\", \"Photo_Setup_9\": \"13:63\", \"Photo_Blog_1\": \"13:5\", \"Photo_Blog_2\": \"13:68\",\n    \"Photo_Blog_3\": \"13:6\", \"Photo_Recent_1\": \"13:65\", \"Photo_Recent_2\": \"13:71\", \"Photo_Recent_3\": \"13:55\",\n    \"Photo_Recent_4\": \"13:56\", \"Photo_Recent_5\": \"13:57\", \"Icon_Account\": \"13:33\", \"Icon_Arrow_Right\": \"13:49\",\n    \"Icon_Calendar\": \"13:37\", \"Icon_Cart\": \"13:26\", \"Icon_Cart_Close\": \"13:39\", \"Icon_Chevron_Down\": \"13:30\",\n    \"Icon_Chevron_Right\": \"13:46\", \"Icon_Clock\": \"13:54\", \"Icon_Compare\": \"13:47\", \"Icon_Delete\": \"13:28\",\n    \"Icon_Filter\": \"13:50\", \"Icon_Grid\": \"13:48\", \"Icon_Guarantee\": \"13:42\", \"Icon_Heart\": \"13:53\",\n    \"Icon_Location\": \"13:29\", \"Icon_Phone\": \"13:32\", \"Icon_Remove\": \"13:43\", \"Icon_Search\": \"13:40\",\n    \"Icon_Share\": \"13:51\", \"Icon_Shipping\": \"13:25\", \"Icon_Star\": \"13:31\", \"Icon_Star_Half\": \"13:52\",\n    \"Icon_Support\": \"13:41\", \"Icon_Tag\": \"13:27\", \"Icon_Trophy\": \"13:38\", \"Icon_User\": \"13:45\", \"Icon_View_List\": \"13:34\"\n  };\n\n  function createAssetInstance(id) {\n    const node = figma.getNodeById(id);\n    if (!node) return figma.createFrame();\n    if (node.type === \"COMPONENT\") {\n      return node.createInstance();\n    }\n    return node.clone();\n  }\n\n  const GOLD = { r: 0.7215686, g: 0.5568627, b: 0.1843137 }; // #B88E2F\n  const DARK = { r: 0.2, g: 0.2, b: 0.2 }; // #333333\n  const LIGHT_BG = { r: 0.976, g: 0.965, b: 0.945 }; // #F9F1E7\n  const WHITE = { r: 1, g: 1, b: 1 };\n  const GRAY_TEXT = { r: 0.533, g: 0.533, b: 0.533 }; // #898989\n  const GRAY_BORDER = { r: 0.85, g: 0.85, b: 0.85 };\n\n  function buildHeader(currentNav = null) {\n    const header = figma.createFrame();\n    header.name = \"Header\";\n    header.resize(1440, 100);\n    header.fills = [{ type: 'SOLID', color: WHITE }];\n\n    const logoGroup = figma.createFrame();\n    logoGroup.name = \"Logo Group\";\n    logoGroup.layoutMode = \"HORIZONTAL\";\n    logoGroup.counterAxisAlignItems = \"CENTER\";\n    logoGroup.itemSpacing = 5;\n    logoGroup.fills = [];\n    logoGroup.appendChild(createAssetInstance(mediaMap[\"Logo_Furniro\"]));\n    const titleText = figma.createText();\n    titleText.fontName = { family: \"Poppins\", style: \"Bold\" };\n    titleText.fontSize = 34;\n    titleText.characters = \"Furniro\";\n    titleText.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    logoGroup.appendChild(titleText);\n    logoGroup.x = 54;\n    logoGroup.y = 29;\n    header.appendChild(logoGroup);\n\n    const navGroup = figma.createFrame();\n    navGroup.name = \"Navigation\";\n    navGroup.layoutMode = \"HORIZONTAL\";\n    navGroup.itemSpacing = 75;\n    navGroup.fills = [];\n    [\"Home\", \"Shop\", \"About\", \"Contact\"].forEach(item => {\n      const txt = figma.createText();\n      txt.name = item;\n      txt.fontSize = 16;\n      if (item === currentNav) {\n        txt.fontName = { family: \"Poppins\", style: \"Semi Bold\" };\n        txt.fills = [{ type: 'SOLID', color: GOLD }];\n      } else {\n        txt.fontName = { family: \"Poppins\", style: \"Medium\" };\n        txt.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n      }\n      txt.characters = item;\n      navGroup.appendChild(txt);\n    });\n    navGroup.x = 505;\n    navGroup.y = 38;\n    header.appendChild(navGroup);\n\n    const iconGroup = figma.createFrame();\n    iconGroup.name = \"Icons\";\n    iconGroup.layoutMode = \"HORIZONTAL\";\n    iconGroup.itemSpacing = 45;\n    iconGroup.fills = [];\n    [\"Icon_Account\", \"Icon_Search\", \"Icon_Heart\", \"Icon_Cart\"].forEach(ic => {\n      iconGroup.appendChild(createAssetInstance(mediaMap[ic]));\n    });\n    iconGroup.x = 1093;\n    iconGroup.y = 36;\n    header.appendChild(iconGroup);\n    return header;\n  }\n\n  function buildFooter() {\n    const footer = figma.createFrame();\n    footer.name = \"Footer\";\n    footer.resize(1440, 505);\n    footer.fills = [{ type: 'SOLID', color: WHITE }];\n\n    const border = figma.createRectangle();\n    border.resize(1440, 1);\n    border.fills = [{ type: 'SOLID', color: GRAY_BORDER }];\n    border.x = 0;\n    border.y = 0;\n    footer.appendChild(border);\n\n    const leftCol = figma.createFrame();\n    leftCol.name = \"Brand Col\";\n    leftCol.layoutMode = \"VERTICAL\";\n    leftCol.itemSpacing = 50;\n    leftCol.fills = [];\n    const brandName = figma.createText();\n    brandName.fontName = { family: \"Poppins\", style: \"Bold\" };\n    brandName.fontSize = 24;\n    brandName.characters = \"Furniro.\";\n    brandName.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    leftCol.appendChild(brandName);\n    const addr = figma.createText();\n    addr.fontName = { family: \"Poppins\", style: \"Regular\" };\n    addr.fontSize = 16;\n    addr.characters = \"400 University Drive Suite 200\\nCoral Gables, FL 33134 USA\";\n    addr.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n    leftCol.appendChild(addr);\n    leftCol.x = 100;\n    leftCol.y = 48;\n    footer.appendChild(leftCol);\n\n    const linksCol = figma.createFrame();\n    linksCol.name = \"Links Col\";\n    linksCol.layoutMode = \"VERTICAL\";\n    linksCol.itemSpacing = 46;\n    linksCol.fills = [];\n    const linksHead = figma.createText();\n    linksHead.fontName = { family: \"Poppins\", style: \"Medium\" };\n    linksHead.fontSize = 16;\n    linksHead.characters = \"Links\";\n    linksHead.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n    linksCol.appendChild(linksHead);\n    const linksList = figma.createFrame();\n    linksList.layoutMode = \"VERTICAL\";\n    linksList.itemSpacing = 46;\n    linksList.fills = [];\n    [\"Home\", \"Shop\", \"About\", \"Contact\", \"Blog\"].forEach(l => {\n      const t = figma.createText();\n      t.name = l;\n      t.fontName = { family: \"Poppins\", style: \"Medium\" };\n      t.fontSize = 16;\n      t.characters = l;\n      t.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n      linksList.appendChild(t);\n    });\n    linksCol.appendChild(linksList);\n    linksCol.x = 523;\n    linksCol.y = 48;\n    footer.appendChild(linksCol);\n\n    const helpCol = figma.createFrame();\n    helpCol.name = \"Help Col\";\n    helpCol.layoutMode = \"VERTICAL\";\n    helpCol.itemSpacing = 46;\n    helpCol.fills = [];\n    const helpHead = figma.createText();\n    helpHead.fontName = { family: \"Poppins\", style: \"Medium\" };\n    helpHead.fontSize = 16;\n    helpHead.characters = \"Help\";\n    helpHead.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n    helpCol.appendChild(helpHead);\n    const helpList = figma.createFrame();\n    helpList.layoutMode = \"VERTICAL\";\n    helpList.itemSpacing = 46;\n    helpList.fills = [];\n    [\"Payment Options\", \"Returns\", \"Privacy Policies\"].forEach(l => {\n      const t = figma.createText();\n      t.name = l;\n      t.fontName = { family: \"Poppins\", style: \"Medium\" };\n      t.fontSize = 16;\n      t.characters = l;\n      t.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n      helpList.appendChild(t);\n    });\n    helpCol.appendChild(helpList);\n    helpCol.x = 710;\n    helpCol.y = 48;\n    footer.appendChild(helpCol);\n\n    const newsCol = figma.createFrame();\n    newsCol.name = \"Newsletter Col\";\n    newsCol.layoutMode = \"VERTICAL\";\n    newsCol.itemSpacing = 46;\n    newsCol.fills = [];\n    const newsHead = figma.createText();\n    newsHead.fontName = { family: \"Poppins\", style: \"Medium\" };\n    newsHead.fontSize = 16;\n    newsHead.characters = \"Newsletter\";\n    newsHead.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n    newsCol.appendChild(newsHead);\n    const formRow = figma.createFrame();\n    formRow.layoutMode = \"HORIZONTAL\";\n    formRow.itemSpacing = 11;\n    formRow.fills = [];\n    const inputWrap = figma.createFrame();\n    inputWrap.layoutMode = \"VERTICAL\";\n    inputWrap.itemSpacing = 3;\n    inputWrap.fills = [];\n    const inputTxt = figma.createText();\n    inputTxt.fontName = { family: \"Poppins\", style: \"Regular\" };\n    inputTxt.fontSize = 14;\n    inputTxt.characters = \"Enter Your Email Address\";\n    inputTxt.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n    inputWrap.appendChild(inputTxt);\n    const line1 = figma.createRectangle();\n    line1.resize(200, 1);\n    line1.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    inputWrap.appendChild(line1);\n    formRow.appendChild(inputWrap);\n    const btnWrap = figma.createFrame();\n    btnWrap.layoutMode = \"VERTICAL\";\n    btnWrap.itemSpacing = 3;\n    btnWrap.fills = [];\n    const btnTxt = figma.createText();\n    btnTxt.fontName = { family: \"Poppins\", style: \"Medium\" };\n    btnTxt.fontSize = 14;\n    btnTxt.characters = \"SUBSCRIBE\";\n    btnTxt.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    btnWrap.appendChild(btnTxt);\n    const line2 = figma.createRectangle();\n    line2.resize(75, 1);\n    line2.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    btnWrap.appendChild(line2);\n    formRow.appendChild(btnWrap);\n    newsCol.appendChild(formRow);\n    newsCol.x = 948;\n    newsCol.y = 48;\n    footer.appendChild(newsCol);\n\n    const copyLine = figma.createRectangle();\n    copyLine.resize(1240, 1);\n    copyLine.fills = [{ type: 'SOLID', color: GRAY_BORDER }];\n    copyLine.x = 100;\n    copyLine.y = 430;\n    footer.appendChild(copyLine);\n\n    const copyright = figma.createText();\n    copyright.fontName = { family: \"Poppins\", style: \"Regular\" };\n    copyright.fontSize = 16;\n    copyright.characters = \"2023 Furniro. All rights reserved\";\n    copyright.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    copyright.x = 100;\n    copyright.y = 450;\n    footer.appendChild(copyright);\n    return footer;\n  }\n\n  function buildFeaturesStrip() {\n    const strip = figma.createFrame();\n    strip.name = \"Features Strip\";\n    strip.resize(1440, 270);\n    strip.fills = [{ type: 'SOLID', color: LIGHT_BG }];\n    strip.layoutMode = \"HORIZONTAL\";\n    strip.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    strip.counterAxisAlignItems = \"CENTER\";\n    strip.paddingLeft = 53;\n    strip.paddingRight = 53;\n\n    const features = [\n      { icon: \"Icon_Trophy\", title: \"High Quality\", desc: \"crafted from top materials\" },\n      { icon: \"Icon_Guarantee\", title: \"Warranty Protection\", desc: \"Over 2 years\" },\n      { icon: \"Icon_Shipping\", title: \"Free Shipping\", desc: \"Order over Rs. 150,000\" },\n      { icon: \"Icon_Support\", title: \"24 / 7 Support\", desc: \"Dedicated support\" }\n    ];\n\n    features.forEach(f => {\n      const item = figma.createFrame();\n      item.name = f.title;\n      item.layoutMode = \"HORIZONTAL\";\n      item.itemSpacing = 10;\n      item.counterAxisAlignItems = \"CENTER\";\n      item.fills = [];\n\n      item.appendChild(createAssetInstance(mediaMap[f.icon]));\n\n      const textGroup = figma.createFrame();\n      textGroup.layoutMode = \"VERTICAL\";\n      textGroup.itemSpacing = 2;\n      textGroup.fills = [];\n\n      const t = figma.createText();\n      t.fontName = { family: \"Poppins\", style: \"Bold\" };\n      t.fontSize = 25;\n      t.characters = f.title;\n      t.fills = [{ type: 'SOLID', color: DARK }];\n      textGroup.appendChild(t);\n\n      const d = figma.createText();\n      d.fontName = { family: \"Poppins\", style: \"Medium\" };\n      d.fontSize = 20;\n      d.characters = f.desc;\n      d.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n      textGroup.appendChild(d);\n\n      item.appendChild(textGroup);\n      strip.appendChild(item);\n    });\n    return strip;\n  }\n\n  function buildPageBanner(title, breadcrumbs) {\n    const banner = figma.createFrame();\n    banner.name = \"Page Title & Breadcrumb\";\n    banner.resize(1440, 316);\n    banner.fills = [];\n\n    const bgPhoto = createAssetInstance(mediaMap[\"Photo_Page_Banner\"]);\n    bgPhoto.resize(1440, 316);\n    bgPhoto.x = 0;\n    bgPhoto.y = 0;\n    banner.appendChild(bgPhoto);\n\n    const content = figma.createFrame();\n    content.name = \"Content\";\n    content.layoutMode = \"VERTICAL\";\n    content.primaryAxisAlignItems = \"CENTER\";\n    content.counterAxisAlignItems = \"CENTER\";\n    content.itemSpacing = 5;\n    content.fills = [];\n\n    content.appendChild(createAssetInstance(mediaMap[\"Logo_Furniro\"]));\n\n    const t = figma.createText();\n    t.fontName = { family: \"Poppins\", style: \"Medium\" };\n    t.fontSize = 48;\n    t.characters = title;\n    t.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    content.appendChild(t);\n\n    const bcRow = figma.createFrame();\n    bcRow.layoutMode = \"HORIZONTAL\";\n    bcRow.itemSpacing = 6;\n    bcRow.counterAxisAlignItems = \"CENTER\";\n    bcRow.fills = [];\n\n    breadcrumbs.forEach((bc, idx) => {\n      const bcTxt = figma.createText();\n      bcTxt.fontName = { family: \"Poppins\", style: idx === breadcrumbs.length - 1 ? \"Light\" : \"Bold\" };\n      bcTxt.fontSize = 16;\n      bcTxt.characters = bc;\n      bcTxt.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n      bcRow.appendChild(bcTxt);\n\n      if (idx < breadcrumbs.length - 1) {\n        bcRow.appendChild(createAssetInstance(mediaMap[\"Icon_Chevron_Right\"]));\n      }\n    });\n    content.appendChild(bcRow);\n\n    content.x = (1440 - content.width) / 2;\n    content.y = (316 - content.height) / 2;\n    banner.appendChild(content);\n    return banner;\n  }\n\n  // Helper function to build standard input field\n  function createInputField(label, defaultValue = \"\", isDropdown = false, width = 453, height = 75) {\n    const field = figma.createFrame();\n    field.name = label;\n    field.layoutMode = \"VERTICAL\";\n    field.itemSpacing = 12;\n    field.fills = [];\n\n    const lbl = figma.createText();\n    lbl.fontName = { family: \"Poppins\", style: \"Medium\" };\n    lbl.fontSize = 16;\n    lbl.characters = label;\n    lbl.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    field.appendChild(lbl);\n\n    const input = figma.createFrame();\n    input.resize(width, height);\n    input.cornerRadius = 10;\n    input.strokes = [{ type: 'SOLID', color: GRAY_BORDER }];\n    input.strokeWeight = 1;\n    input.fills = [{ type: 'SOLID', color: WHITE }];\n\n    const val = figma.createText();\n    val.fontName = { family: \"Poppins\", style: \"Regular\" };\n    val.fontSize = 16;\n    val.characters = defaultValue;\n    val.fills = [{ type: 'SOLID', color: defaultValue ? { r: 0, g: 0, b: 0 } : GRAY_TEXT }];\n    val.x = 24;\n    val.y = (height - val.height) / 2;\n    input.appendChild(val);\n\n    if (isDropdown) {\n      const chv = createAssetInstance(mediaMap[\"Icon_Chevron_Down\"]);\n      chv.x = width - 40;\n      chv.y = (height - 24) / 2;\n      input.appendChild(chv);\n    }\n\n    field.appendChild(input);\n    return field;\n  }\n\n  // --- BUILD 07_Checkout ---\n  const checkoutPage = figma.createFrame();\n  checkoutPage.name = \"07_Checkout\";\n  checkoutPage.resize(1440, 2100);\n  checkoutPage.fills = [{ type: 'SOLID', color: WHITE }];\n\n  // 1. Header (no item current)\n  checkoutPage.appendChild(buildHeader(null));\n\n  // 2. Banner\n  const banner = buildPageBanner(\"Checkout\", [\"Home\", \"Checkout\"]);\n  banner.y = 100;\n  checkoutPage.appendChild(banner);\n\n  // 3. Main Content Section (Billing Details + Order Summary & Payment)\n  const mainCheckout = figma.createFrame();\n  mainCheckout.name = \"Checkout Main\";\n  mainCheckout.resize(1240, 1100);\n  mainCheckout.x = 100;\n  mainCheckout.y = 480;\n  mainCheckout.fills = [];\n\n  // Left Column: Billing Details\n  const billingCol = figma.createFrame();\n  billingCol.name = \"Billing Details\";\n  billingCol.layoutMode = \"VERTICAL\";\n  billingCol.itemSpacing = 30;\n  billingCol.fills = [];\n\n  const bTitle = figma.createText();\n  bTitle.fontName = { family: \"Poppins\", style: \"Bold\" };\n  bTitle.fontSize = 36;\n  bTitle.characters = \"Billing details\";\n  bTitle.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  billingCol.appendChild(bTitle);\n\n  // Name Row (First Name, Last Name)\n  const nameRow = figma.createFrame();\n  nameRow.layoutMode = \"HORIZONTAL\";\n  nameRow.itemSpacing = 31;\n  nameRow.fills = [];\n  nameRow.appendChild(createInputField(\"First Name\", \"\", false, 211, 75));\n  nameRow.appendChild(createInputField(\"Last Name\", \"\", false, 211, 75));\n  billingCol.appendChild(nameRow);\n\n  billingCol.appendChild(createInputField(\"Company Name (Optional)\", \"\", false, 453, 75));\n  billingCol.appendChild(createInputField(\"Country / Region\", \"Sri Lanka\", true, 453, 75));\n  billingCol.appendChild(createInputField(\"Street address\", \"\", false, 453, 75));\n  billingCol.appendChild(createInputField(\"Town / City\", \"\", false, 453, 75));\n  billingCol.appendChild(createInputField(\"Province\", \"Western Province\", true, 453, 75));\n  billingCol.appendChild(createInputField(\"ZIP code\", \"\", false, 453, 75));\n  billingCol.appendChild(createInputField(\"Phone\", \"\", false, 453, 75));\n  billingCol.appendChild(createInputField(\"Email address\", \"\", false, 453, 75));\n  billingCol.appendChild(createInputField(\"Additional information\", \"\", false, 453, 75));\n\n  billingCol.x = 0;\n  billingCol.y = 0;\n  mainCheckout.appendChild(billingCol);\n\n  // Right Column: Order Summary & Payment Options (608px wide)\n  const orderCol = figma.createFrame();\n  orderCol.name = \"Order & Payment\";\n  orderCol.resize(533, 1000);\n  orderCol.x = 707;\n  orderCol.y = 0;\n  orderCol.fills = [];\n\n  // Order Summary Table\n  const orderSummary = figma.createFrame();\n  orderSummary.name = \"Order Summary\";\n  orderSummary.layoutMode = \"VERTICAL\";\n  orderSummary.itemSpacing = 22;\n  orderSummary.fills = [];\n\n  // Header row\n  const sumHead = figma.createFrame();\n  sumHead.layoutMode = \"HORIZONTAL\";\n  sumHead.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  sumHead.resize(533, 36);\n  sumHead.fills = [];\n  const shProd = figma.createText();\n  shProd.fontName = { family: \"Poppins\", style: \"Medium\" };\n  shProd.fontSize = 24;\n  shProd.characters = \"Product\";\n  shProd.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  sumHead.appendChild(shProd);\n\n  const shSub = figma.createText();\n  shSub.fontName = { family: \"Poppins\", style: \"Medium\" };\n  shSub.fontSize = 24;\n  shSub.characters = \"Subtotal\";\n  shSub.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  sumHead.appendChild(shSub);\n  orderSummary.appendChild(sumHead);\n\n  // Item row\n  const itemRow = figma.createFrame();\n  itemRow.layoutMode = \"HORIZONTAL\";\n  itemRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  itemRow.resize(533, 24);\n  itemRow.fills = [];\n  const irName = figma.createText();\n  irName.fontName = { family: \"Poppins\", style: \"Regular\" };\n  irName.fontSize = 16;\n  irName.characters = \"Asgaard sofa\";\n  irName.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n  const irQty = figma.createText();\n  irQty.fontName = { family: \"Poppins\", style: \"Medium\" };\n  irQty.fontSize = 12;\n  irQty.characters = \"  X  1\";\n  irQty.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  \n  const irWrap = figma.createFrame();\n  irWrap.layoutMode = \"HORIZONTAL\";\n  irWrap.itemSpacing = 8;\n  irWrap.fills = [];\n  irWrap.appendChild(irName);\n  irWrap.appendChild(irQty);\n  itemRow.appendChild(irWrap);\n\n  const irVal = figma.createText();\n  irVal.fontName = { family: \"Poppins\", style: \"Light\" };\n  irVal.fontSize = 16;\n  irVal.characters = \"Rs. 250,000.00\";\n  irVal.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  itemRow.appendChild(irVal);\n  orderSummary.appendChild(itemRow);\n\n  // Subtotal row\n  const subRow = figma.createFrame();\n  subRow.layoutMode = \"HORIZONTAL\";\n  subRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  subRow.resize(533, 24);\n  subRow.fills = [];\n  const sName = figma.createText();\n  sName.fontName = { family: \"Poppins\", style: \"Regular\" };\n  sName.fontSize = 16;\n  sName.characters = \"Subtotal\";\n  sName.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  subRow.appendChild(sName);\n\n  const sVal = figma.createText();\n  sVal.fontName = { family: \"Poppins\", style: \"Light\" };\n  sVal.fontSize = 16;\n  sVal.characters = \"Rs. 250,000.00\";\n  sVal.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  subRow.appendChild(sVal);\n  orderSummary.appendChild(subRow);\n\n  // Total row\n  const totRow = figma.createFrame();\n  totRow.layoutMode = \"HORIZONTAL\";\n  totRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  totRow.resize(533, 36);\n  totRow.fills = [];\n  const tName = figma.createText();\n  tName.fontName = { family: \"Poppins\", style: \"Regular\" };\n  tName.fontSize = 16;\n  tName.characters = \"Total\";\n  tName.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  totRow.appendChild(tName);\n\n  const tVal = figma.createText();\n  tVal.fontName = { family: \"Poppins\", style: \"Bold\" };\n  tVal.fontSize = 24;\n  tVal.characters = \"Rs. 250,000.00\";\n  tVal.fills = [{ type: 'SOLID', color: GOLD }];\n  totRow.appendChild(tVal);\n  orderSummary.appendChild(totRow);\n\n  orderCol.appendChild(orderSummary);\n\n  // Divider\n  const sumDiv = figma.createRectangle();\n  sumDiv.resize(533, 1);\n  sumDiv.fills = [{ type: 'SOLID', color: GRAY_BORDER }];\n  sumDiv.y = 200;\n  orderCol.appendChild(sumDiv);\n\n  // Payment Options\n  const paymentSec = figma.createFrame();\n  paymentSec.name = \"Payment Options\";\n  paymentSec.layoutMode = \"VERTICAL\";\n  paymentSec.itemSpacing = 20;\n  paymentSec.fills = [];\n\n  // Option 1: Direct Bank Transfer (Selected)\n  const opt1Header = figma.createFrame();\n  opt1Header.layoutMode = \"HORIZONTAL\";\n  opt1Header.itemSpacing = 15;\n  opt1Header.counterAxisAlignItems = \"CENTER\";\n  opt1Header.fills = [];\n\n  const opt1Dot = figma.createFrame();\n  opt1Dot.resize(14, 14);\n  opt1Dot.cornerRadius = 7;\n  opt1Dot.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  opt1Header.appendChild(opt1Dot);\n\n  const opt1Txt = figma.createText();\n  opt1Txt.fontName = { family: \"Poppins\", style: \"Medium\" };\n  opt1Txt.fontSize = 16;\n  opt1Txt.characters = \"Direct Bank Transfer\";\n  opt1Txt.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  opt1Header.appendChild(opt1Txt);\n  paymentSec.appendChild(opt1Header);\n\n  // Option 1 Note\n  const opt1Note = figma.createText();\n  opt1Note.fontName = { family: \"Poppins\", style: \"Light\" };\n  opt1Note.fontSize = 14;\n  opt1Note.characters = \"Make your payment directly into our bank account. Please use your Order ID as the payment reference. Your order will not be shipped until the funds have cleared in our account.\";\n  opt1Note.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n  opt1Note.resize(533, 60);\n  paymentSec.appendChild(opt1Note);\n\n  // Option 2: Cash On Delivery\n  const opt2Header = figma.createFrame();\n  opt2Header.layoutMode = \"HORIZONTAL\";\n  opt2Header.itemSpacing = 15;\n  opt2Header.counterAxisAlignItems = \"CENTER\";\n  opt2Header.fills = [];\n\n  const opt2Dot = figma.createFrame();\n  opt2Dot.resize(14, 14);\n  opt2Dot.cornerRadius = 7;\n  opt2Dot.strokes = [{ type: 'SOLID', color: GRAY_TEXT }];\n  opt2Dot.strokeWeight = 1;\n  opt2Dot.fills = [];\n  opt2Header.appendChild(opt2Dot);\n\n  const opt2Txt = figma.createText();\n  opt2Txt.fontName = { family: \"Poppins\", style: \"Medium\" };\n  opt2Txt.fontSize = 16;\n  opt2Txt.characters = \"Cash On Delivery\";\n  opt2Txt.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n  opt2Header.appendChild(opt2Txt);\n  paymentSec.appendChild(opt2Header);\n\n  // Privacy note\n  const privacyTxt = figma.createText();\n  privacyTxt.fontName = { family: \"Poppins\", style: \"Light\" };\n  privacyTxt.fontSize = 14;\n  privacyTxt.characters = \"Your personal data will be used to support your experience throughout this website, to manage access to your account, and for other purposes described in our privacy policy.\";\n  privacyTxt.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  privacyTxt.resize(533, 60);\n  // Highlight \"privacy policy\" in bold\n  const pIndex = privacyTxt.characters.indexOf(\"privacy policy\");\n  if (pIndex !== -1) {\n    privacyTxt.setRangeFontName(pIndex, pIndex + \"privacy policy\".length, { family: \"Poppins\", style: \"Semi Bold\" });\n  }\n  paymentSec.appendChild(privacyTxt);\n\n  // Place order Button\n  const placeBtn = figma.createFrame();\n  placeBtn.name = \"Place order\";\n  placeBtn.resize(318, 64);\n  placeBtn.cornerRadius = 15;\n  placeBtn.strokes = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  placeBtn.strokeWeight = 1;\n  placeBtn.fills = [];\n  const placeTxt = figma.createText();\n  placeTxt.fontName = { family: \"Poppins\", style: \"Regular\" };\n  placeTxt.fontSize = 20;\n  placeTxt.characters = \"Place order\";\n  placeTxt.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n  placeBtn.appendChild(placeTxt);\n  placeTxt.x = (318 - placeTxt.width) / 2;\n  placeTxt.y = (64 - placeTxt.height) / 2;\n  paymentSec.appendChild(placeBtn);\n\n  paymentSec.y = 230;\n  orderCol.appendChild(paymentSec);\n\n  mainCheckout.appendChild(orderCol);\n\n  checkoutPage.appendChild(mainCheckout);\n\n  // 4. Features Strip\n  const strip = buildFeaturesStrip();\n  strip.y = 1750;\n  checkoutPage.appendChild(strip);\n\n  // 5. Footer\n  const chFooter = buildFooter();\n  chFooter.y = 2020;\n  checkoutPage.appendChild(chFooter);\n\n  checkoutPage.resize(1440, 2525);\n\n  return \"Checkout page created successfully!\";\n})();","description":"Implement 07_Checkout frame with billing details, order summary, payment options and place order action","fileKey":"lyAJXJy8GatyIPzWRh2m00"}}],"stop