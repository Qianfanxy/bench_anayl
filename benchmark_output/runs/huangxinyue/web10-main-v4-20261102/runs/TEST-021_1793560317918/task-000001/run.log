=0;\nheaderInst(cd,'Shop');\n// inactive product page behind\nconst bg=frame(cd,0,100,1440,1100,'#FFFFFF','ProductBehind');\nphoto(bg,'Photo_Asgaard_Sofa',100,120,500,500,10);\ntxt(bg,'Asgaard sofa',42,'SemiBold',C.ink,820,140,{lh:52});\ntxt(bg,'Rs. 250,000.00',24,'Medium',C.muted,820,206,{lh:34});\ntxt(bg,'Setting the bar as one of the most comfortable sofas in its class, the Asgaard is a compact, sturdy three-seater with a solid-wood frame and deep, soft cushions.',16,'Regular',C.body,820,270,{lh:26,w:440});\nconst dim=figma.createRectangle(); cd.appendChild(dim); dim.name='Scrim'; dim.resize(1440,1100); dim.fills=[solid('#1A1A1F',0.5)]; dim.x=0; dim.y=100;\n// drawer\nconst dr=frame(cd,940,100,500,1100,'#FFFFFF','CartDrawer');\ntxt(dr,'Shopping Cart',28,'SemiBold',C.ink,40,40,{lh:38});\nicon(dr,'Icon_Cart_Close',20,C.ink,436,44);\nconst hr=figma.createRectangle(); dr.appendChild(hr); hr.name='Rule'; hr.resize(420,1); hr.fills=[solid(C.line)]; hr.x=40; hr.y=104;\nphoto(dr,'Photo_Asgaard_Sofa',40,132,120,100,8);\ntxt(dr,'Asgaard sofa',18,'Medium',C.ink,180,140,{lh:26});\ntxt(dr,'1 × Rs. 250,000.00',16,'Regular',C.body,180,176,{lh:24});\nconst rm=figma.createEllipse(); dr.appendChild(rm); rm.name='RemoveBtn'; rm.resize(22,22); rm.fills=[solid('#9F9F9F')]; rm.x=418; rm.y=140;\nicon(dr,'Icon_Remove',12,'#FFFFFF',418+5,140+5);\nconst hr2=figma.createRectangle(); dr.appendChild(hr2); hr2.name='Rule2'; hr2.resize(420,1); hr2.fills=[solid(C.line)]; hr2.x=40; hr2.y=260;\ntxt(dr,'Subtotal',16,'Regular',C.body,40,300,{lh:24});\ntxt(dr,'Rs. 250,000.00',18,'SemiBold',C.gold,270,298,{lh:26});\nconst hr3=figma.createRectangle(); dr.appendChild(hr3); hr3.name='Rule3'; hr3.resize(420,1); hr3.fills=[solid(C.line)]; hr3.x=40; hr3.y=348;\nconst acts=frame(dr,40,392,420,130,'#FFFFFF','DrawerActions');\nconst ad=[['Cart','Dark'],['Checkout','Primary'],['Comparison','Outline']];\nad.forEach(([l,s],k)=>{ const b=btn(acts,l,s,0,k*44); b.paddingLeft=0; b.paddingRight=0; b.paddingTop=6; b.p