= opts.x;\n  if (opts.y != null) t.y = opts.y;\n  return t;\n}\nfunction frame(parent, name, w, h){\n  const f = figma.createFrame();\n  if (parent) parent.appendChild(f); else PAGE.appendChild(f);\n  f.name = name; f.resize(w,h); f.fills = [];\n  return f;\n}\nfunction rect(parent, name, x, y, w, h, color, radius){\n  const r = figma.createRectangle();\n  parent.appendChild(r); r.name = name;\n  r.x = x; r.y = y; r.resize(w,h);\n  if (color) r.fills = [S(color)]; else r.fills = [];\n  if (radius) r.cornerRadius = radius;\n  return r;\n}\n\n// ---------- Icon component copies (colored to our palette) ----------\nconst iconSrc = {\n  \"Icon/Activity\":\"3:16\",\"Icon/Back\":\"3:17\",\"Icon/Clock\":\"3:18\",\"Icon/Cycling\":\"3:19\",\n  \"Icon/Heart\":\"3:20\",\"Icon/Home\":\"3:21\",\"Icon/Menu\":\"3:22\",\"Icon/More\":\"3:23\",\"Icon/Play\":\"3:24\",\n  \"Icon/PlaySmall\":\"3:25\",\"Icon/Profile\":\"3:26\",\"Icon/Running\":\"3:27\",\"Icon/Search\":\"3:28\",\n  \"Icon/Settings\":\"3:29\",\"Icon/Swimming\":\"3:30\"\n};\nconst comps = {};\nconst CY = 0;\nfor (const [name, id] of Object.entries(iconSrc)) {\n  const src = await figma.getNodeByIdAsync(id);\n  const copy = src.clone();\n  PAGE.appendChild(copy);\n  copy.x = -700; copy.y = CY;\n  comps[name] = copy;\n  CY += Math.max(48, copy.height + 8);\n}\n// recolor helper: set fills on all descendant paint nodes of a node\nfunction recolor(node, color){\n  const paints = node.findAll(n => n.type===\"VECTOR\"||n.type===\"RECTANGLE\"||n.type===\"ELLIPSE\"||n.type===\"POLYGON\"||n.type===\"STAR\"||n.type===\"TEXT\");\n  for (const p of paints) {\n    // keep vector strokes if fills empty\n    if (Array.isArray(p.fills) && p.fills.length) p.fills = [S(color)];\n    if (p.strokes && p.strokes.length) p.strokes = [S(color)];\n  }\n}\n// default icon colors\nrecolor(comps[\"Icon/Activity\"], GRAY);\nrecolor(comps[\"Icon/Back\"], INK);\nrecolor(comps[\"Icon/Clock\"], BRAND);\nrecolor(comps[\"Icon/Cycling\"], VIOLET);\nrecolor(comps[\"Icon/Heart\"], RED);\nrecolor(comps[\"Icon/Home\"], BRAND);\nrecolor(comps[\"Icon/Menu\"], INK);\nrecolor(comps[\"Icon/More\"], INK);\nrecolor(comps[\"Icon/Play\"], WHITE);\nrecolor(comps[\"Icon/PlaySmall\"], WHITE);\nrecolor(comps[\"Icon/Profile\"], GRAY);\nrecolor(comps[\"Icon/Running\"], ORANGE);\nrecolor(comps[\"Icon/Search\"], MUTED);\nrecolor(comps[\"Icon/Settings\"], GRAY);\nrecolor(comps[\"Icon/Swimming\"], BLUE);\n\n// ---------- Tab bar component ----------\nfunction iconInst(name, w, h){\n  const inst = comps[name].createInstance();\n  const sw = inst.width, sh = inst.height;\n  inst.resize(w, h * (w/sw) * (sh/h || 1)); // proportional\n  inst.resize(w, sh * (w/sw));\n  return inst;\n}\nconst tabDefs = [\n  [\"Home\",\"Icon/Home\"],[\"Activity\",\"Icon/Activity\"],[\"Profile\",\"Icon/Profile\"],[\"Settings\",\"Icon/Settings\"]\n];\nconst tabBar = frame(null, \"TabBar\", 414, 96);\ntabBar.x = -1600; tabBar.y = 0;\ntabBar.fills = [S(WHITE)];\ntabBar.effects = [{type:\"DROP_SHADOW\", color:{r:0.098,g:0.11,b:0.137,a:0.08}, offset:{x:0,y:-4}, radius:24, spread:0, visible:true, blendMode:\"NORMAL\"}];\ntabBar.layoutMode = \"HORIZONTAL\";\ntabBar.primaryAxisSizingMode = \"FIXED\";\ntabBar.counterAxisSizingMode = \"FIXED\";\ntabBar.paddingTop = 12; tabBar.paddingBottom = 34;\ntabBar.itemSpacing = 0;\nfor (const [label, icon] of tabDefs) {\n  const it = frame(tabBar, \"Tab/\" + label, 103.5, 50);\n  it.fills = [];\n  it.layoutMode = \"VERTICAL\";\n  it.counterAxisAlignItems = \"CENTER\";\n  it.primaryAxisAlignItems = \"CENTER\";\n  it.itemSpacing = 4;\n  const ic = iconInst(icon, 22, 22);\n  it.appendChild(ic);\n  const lt = await text(label, \"Medium\", 11, GRAY, {parent:it});\n  it.counterAxisSizingMode = \"FIXED\"; it.primaryAxisSizingMode = \"FIXED\";\n  it.resize(103.5, 50);\n}\nconst tabBarComp = figma.createComponentFromNode(tabBar);\ntabBarComp.name = \"TabBar\";\ntabBarComp.x = -1600; tabBarComp.y = 0;\n\n// helper: build a tab bar instance with active tab\nasync function tabBarInstance(activeLabel){\n  const inst = tabBarComp.createInstance();\n  for (const it of inst.children) {\n    const label = it.name.replace(\"Tab/\",\"\");\n    const active = label === activeLabel;\n    const ic = it.children[0]; const lt = it.children[1];\n    const paintNodes = ic.findAll(n => n.type===\"VECTOR\"||n.type===\"RECTANGLE\"||n.type===\"ELLIPSE\");\n    const col = active ? BRAND : GRAY;\n    for (const p of paintNodes){ if (Array.isArray(p.fills)&&p.fills.length) p.fills=[S(col)]; if (p.strokes&&p.strokes.length) p.strokes=[S(col)]; }\n    lt.fills = [S(active ? BRAND : GRAY)];\n    lt.fontName = {family:\"Inter\", style: active ? \"Semi Bold\" : \"Medium\"};\n  }\n  return inst;\n}\n\n// persist helpers to plugin data not possible; return IDs we need later\nreturn JSON.stringify({tabBar: tabBarComp.id, icons: Object.fromEntries(Object.entries(comps).map(([k,v])=>[k,v.id]))});","description":"Create icon component copies and TabBar component on workspace page"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"3dd82475-447e-4a4a-b1d4-9abeb6ff2aa0","uuid":"dbaa4229-ed10-4b94-bf43-2cdedc584097","timestamp":"2026-11-01T14:28:52.275Z","tool_use_meta":[{"id":"mcp__figma__use_figma_17_b95adeed","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
