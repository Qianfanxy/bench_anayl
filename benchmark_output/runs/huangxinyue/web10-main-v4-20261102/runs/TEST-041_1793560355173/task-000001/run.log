{ if(!comps[id]) comps[id]=await figma.getNodeByIdAsync(id); return comps[id]; }\nasync function inst(id,w,h){ const c=await comp(id); const i=c.createInstance(); if(w&&h) i.resize(w,h); return i; }\nasync function icon(id,size,colorHex){ const c=await comp(id); const i=c.createInstance(); const s=size/Math.max(c.width,c.height); i.rescale(s); if(colorHex){ const rec=n=>{ if('fills' in n && Array.isArray(n.fills) && n.fills.some(f=>f.type==='SOLID')) n.fills=[sol(colorHex)]; if('children' in n) n.children.forEach(rec); }; rec(i);} return i; }\nfunction stretchFill(parent,n){ parent.appendChild(n); n.layoutAlign='STRETCH'; n.primaryAxisSizingMode='FIXED'; n.counterAxisSizingMode='AUTO'; }\n\nconst chk=figma.createFrame(); chk.name='07_Checkout'; chk.resize(1440,100); chk.fills=[sol(C.white)];\nchk.layoutMode='VERTICAL'; chk.itemSpacing=0; chk.primaryAxisSizingMode='AUTO'; chk.counterAxisSizingMode='FIXED'; chk.clipsContent=true;\nconst hI=(await comp('18:2')).createInstance(); hI.layoutAlign='STRETCH'; chk.appendChild(hI);\nconst bI=(await comp('18:20')).createInstance(); bI.layoutAlign='STRETCH'; chk.appendChild(bI);\nbI.findOne(n=>n.name==='Title').characters='Checkout';\nbI.findOne(n=>n.name==='Crumb current').characters='Checkout';\n\nconst body=fr('Checkout body'); body.fills=[sol(C.white)]; al(body,{mode:'HORIZONTAL',gap:100,pad:[60,100,50,100]});\nconst form=fr('Billing details'); al(form,{mode:'VERTICAL',gap:26});\nform.appendChild(txt('Billing details',36,F.sb,C.ink,{name:'Section title'}));\nconst nameRow=fr('Name row'); al(nameRow,{mode:'HORIZONTAL',gap:30});\nconst mkField=async(label,ph,w,val,withChev)=>{\n  const col=fr('Field/'+label); al(col,{mode:'VERTICAL',gap:14});\n  col.appendChild(txt(label,16,F.med,C.ink,{name:'Label'}));\n  const inp=fr('Input'); inp.fills=[sol(C.white)]; inp.cornerRadius=10; inp.strokes=[sol(C.muted)]; inp.strokeWeight=1;\n  al(inp,{mode:'HORIZONTAL',main: withChev?'SPACE_BETWEEN':'MIN',cross:'CENTER',pad:[0,16,0,16]}); inp.primaryAxisSizingMode='FIXED'; inp.counterAxisSizingMode='FIXED'; inp.resize(w,60);\n  inp.appendChild(txt(val!==undefined?val:ph,16,F.reg, val!==undefined?C.ink:C.muted,{name:'Value'}));\n  if(withChev) inp.appendChild(await icon('13:30',20,C.ink));\n  col.appendChild(inp); return col;\n};\nnameRow.appendChild(await mkField('First Name','',212));\nnameRow.appendChild(await mkField('Last Name','',212));\nform.appendChild(nameRow);\nform.appendChild(await mkField('Company Name (Optional)','',454));\nform.appendChild(await mkField('Country / Region','',454,'Sri Lanka',true));\nform.appendChild(await mkField('Street address','',454));\nform.appendChild(await mkField('Town / City','',454));\nform.appendChild(await mkField('Province','',454,'Western Province',true));\nform.appendChild(await mkField('ZIP code','',454));\nform.appendChild(await mkField('Phone','',454));\nform.appendChild(await mkField('Email address','',454));\nform.appendChild(await mkField('Additional information','Additional information',454));\nbody.appendChild(form);\n\nconst right=fr('Order panel'); al(right,{mode:'VERTICAL',gap:20,pad:[30,38,60,38]}); right.fills=[sol(C.white)]; right.primaryAxisSizingMode='AUTO'; right.counterAxisSizingMode='AUTO';\nconst sumHead=fr('Sum head'); al(sumHead,{mode:'HORIZONTAL',main:'SPACE_BETWEEN'}); sumHead.primaryAxisSizingMode='FIXED'; sumHead.resize(534,24);\nsumHead.appendChild(txt('Product',24,F.med,C.ink)); sumHead.appendChild(txt('Subtotal',24,F.med,C.ink));\nright.appendChild(sumHead);\nconst r1=fr('R1'); al(r1,{mode:'HORIZONTAL',main:'SPACE_BETWEEN',cross:'CENTER'}); r1.primaryAxisSizingMode='FIXED'; r1.resize(534,24);\nconst r1l=fr('R1L'); al(r1l,{mode:'HORIZONTAL',gap:11,cross:'CENTER'}); r1l.appendChild(txt('Asgaard sofa',16,F.reg,C.muted,{name:'Item'})); r1l.appendChild(txt('X',12,F.med,C.ink)); r1l.appendChild(txt('1',16,F.med,C.ink));\nr1.appendChild(r1l); r1.appendChild(txt('Rs. 250,000.00',16,F.light,C.ink,{name:'Item price'})); right.appendChild(r1)