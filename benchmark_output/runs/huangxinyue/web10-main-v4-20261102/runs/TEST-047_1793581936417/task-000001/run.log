3529,g:0.89411765,b:0.83529412}, YELLOW_TINT={r:1,g:0.95686275,b:0.84313725};\n\n// ============ DISCOUNTS ============\nconst discountsCon = await figma.getNodeByIdAsync('13:17');\nconst dData = [\n  ['15%', 'Spring Salad',  '6 Days Remaining', '9:31'],\n  ['10%', 'Farfalle Salad','6 Days Remaining', '9:32'],\n  ['25%', 'Buddha Bowl',   '7 Days Remaining', '9:51'],\n  ['20%', 'Red Curry Soup','8 Days Remaining', '9:33'],\n];\nconst cw = 416, gap = 24, dh = 400;\ndData.forEach(([pct, name, days, photoId], i) => {\n  const x = i * (cw + gap);\n  const card = figma.createFrame();\n  card.name = 'Discount Card · ' + name;\n  card.resize(cw, dh);\n  card.x = x; card.y = 0;\n  card.fills = [{type:'SOLID', color: WHITE}];\n  card.cornerRadius = 20;\n  card.effects=[{type:'DROP_SHADOW',color:{r:0.2,g:0.12,b:0.02,a:0.08},offset:{x:0,y:16},radius:32,spread:0,visible:true,blendMode:'NORMAL'}];\n  discountsCon.appendChild(card);\n  const photo = instCover(photoId, 0, 0, cw, 240, card);\n  // percent badge on photo\n  const badge = rect(card, 20, 176, 110, 84, YELLOW, 14);\n  const bT1 = text(card, pct, 30, 'Bold', WHITE, 20, 186);\n  const bT2 = text(card, 'Off', 15, 'Bold', WHITE, 20, 224);\n  // center the pct text in badge\n  const pctW = bT1.width + 4 + bT2.width;\n  const bx = 20 + (110 - Math.max(bT1.width, 30))/2;\n  bT1.x = bx;\n  bT2.x = 20 + (110 - bT2.width)/2;\n  text(card, name, 22, 'Bold', INK, 20, 288);\n  const daysT = text(card, days, 15, 'Bold', GRAY, 20, 326);\n  const dot = rect(card, 20, 0, 0, 0, null, 0); // placeholder no-op\n  dot.remove();\n  const chip = rect(card, 20, 352, 14, 14, ORANGE, 7);\n  chip.y = 354;\n  daysT.y = 350;\n  daysT.x = 42;\n});\n\n// ============ HOW IT WORKS ============\nconst howCon = await figma.getNodeByIdAsync('13:18');\ntext(howCon, 'How does it work', 44, 'Bold', INK, 0, 0).x = (1480 - text(howCon,'',1,'Regular',INK,-999,-999).width); // placeholder fix below\n// simpler: recreate title centered\nconst title = howCon.findAll(n=>n.type==='TEXT')[0];\nconst steps = [\n  ['Select location', 'Choose the location where your food will be delivered.', '9:16'],\n  ['Choose order', 'Check over hundreds of menus to pick your favorite food.', '9:17'],\n  ['Pay advanced', 'It’s quick, safe, and simple. Select several methods of payment.', '9:18'],\n  ['Enjoy meals', 'Food is made and delivered directly to your home.', '9:15'],\n];\nconst sw = 340, sgap = 40;\nsteps.forEach(([t, d, iconId], i) => {\n  const x = i * (sw + sgap);\n  const card = figma.createFrame();\n  card.name = 'Step · ' + t;\n  card.resize(sw, 240);\n  card.x = x; card.y = 160;\n  card.fills = [];\n  howCon.appendChild(card);\n  const iconWrap = figma.createFrame();\n  iconWrap.name = 'Icon';\n  iconWrap.resize(88, 88);\n  iconWrap.x = (sw-88)/2; iconWrap.y = 0;\n  iconWrap.fills = [{type:'SOLID', color: ORANGE_TINT}];\n  iconWrap.cornerRadius = 44;\n  card.appendChild(iconWrap);\n  const ic = inst(iconId, 22, 22, iconWrap, 44);\n  for (const v of ic.findAll(n=>n.type==='VECTOR')) v.fills=[{type:'SOLID',color:ORANGE}];\n  const tt = text(card, t, 24, 'Bold', INK, 0, 116);\n  tt.x = (sw - tt.width)/2;\n  const dt = text(card, d, 16, 'Regular', GRAY, 0, 156);\n  dt.resize(sw, 60);\n  dt.textAlignHorizontal = 'CENTER';\n  dt.x = 0;\n});\n// connector line behind icons\nconst line = rect(howCon, 170, 202, 1140, 3, YELLOW, 1.5);\nline.opacity = 0.6;\nhowCon.insertChild(1, line);\n// fix title centering: rebuild\nconst oldTitle = title;\noldTitle.characters = 'How does it work';\noldTitle.fontSize = 44;\noldTitle.fontName = {family:'Source Sans Pro', style:'Bold'};\noldTitle.fills = [{type:'SOLID', color: INK}];\noldTitle.x = (1480 - oldTitle.width)/2;\noldTitle.y = 0;\nconst stray = howCon.findOne(n=>n.type==='TEXT' && n.characters==='');\nif (stray) stray.remove();\nreturn 'discounts+how ok';\n","description":"Build Discounts (4 cards) and How it works (title + 4 steps with connector)","fileKey":"vxs2YHWWLo4u0YPXrkb2yt"}}],"contex