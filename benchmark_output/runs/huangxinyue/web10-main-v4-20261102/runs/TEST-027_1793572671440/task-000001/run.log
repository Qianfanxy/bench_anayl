wait comp(id);const i=c.createInstance();p.appendChild(i);i.resize(w,h);i.x=x;i.y=y;if(name)i.name=name;return i;}\nfunction recolor(n,hex){if(n.strokes&&n.strokes.length)n.strokes=[solid(hex)];if(n.fills&&n.fills.length&&n.fills[0].type==='SOLID')n.fills=[solid(hex)];if(n.children)for(const c of n.children)recolor(c,hex);}\nasync function ic(p,id,x,y,s,hex){const i=await inst(p,id,x,y,s,s);i.fills=[];recolor(i,hex);return i;}\nfunction grad(a,b){return {type:'GRADIENT_LINEAR',gradientTransform:[[1,0,0],[0,1,0]],gradientStops:[{position:0,color:rgba(a)},{position:1,color:rgba(b)}]};}\n\nconst lib=await figma.getNodeByIdAsync('16:15');\nconst yStart=399+940;\n\n// ---------- RESTAURANT CARD ----------\nfunction restCard(){\n  const f=figma.createComponent(); f.name='Restaurant Card'; lib.appendChild(f);\n  f.resize(300,352); f.fills=[]; f.clipsContent=false;\n  const card=frame(f,'Card',0,0,300,352,'#FFFFFF',18,true);\n  card.strokes=[solid('#F0E8DF')]; card.strokeWeight=1; card.strokeAlign='INSIDE';\n  card.effects=[{type:'DROP_SHADOW',color:rgba('#7A5230',0.09),offset:{x:0,y:8},radius:24,spread:0,visible:true,blendMode:'NORMAL'}];\n  const ph=frame(card,'Photo',0,0,300,176,null,0,true);\n  inst(ph,'9:54',0,0,300,176,'Photo');\n  // discount badge\n  const db=frame(card,'Discount badge',14,14,82,30,C.primary,999,true);\n  const tagIc=await ic(db,'9:19',10,9,13,'#FFFFFF');\n  txt(db,'Discount label','20% off',27,7,58,{size:12,weight:'Bold',color:'#FFFFFF',lh:17});\n  // fast badge\n  const fb=frame(card,'Fast badge',210,14,76,30,'#FFFFFF',999,true);\n  fb.effects=[{type:'DROP_SHADOW',color:rgba('#000000',0.12),offset:{x:0,y:4},radius:12,spread:0,visible:true,blendMode:'NORMAL'}];\n  await ic(fb,'9:5',10,9,13,C.ink);\n  txt(fb,'Fast label','Fast',27,7,50,{size:12,weight:'Bold',color:C.ink,lh:17});\n  // logo mark\n  const mark=frame(card,'Initials mark',18,152,56,56,'#F17228',16,true);\n  mark.fills=[grad('#FF8A3D','#F17228')];\n  mark.strokes=[solid('#FFFFFF')]; mark.strokeWeight=3; mark.strokeAlign='INSIDE';\n  txt(mark,'Initials','FW',0,14,56,{size:18,weight:'Bold',color:'#FFFFFF',lh:26,align:'CENTER',ls:0.5});\n  txt(card,'Name','Foodworld',18,220,270,{size:19,weight:'Bold',color:C.ink,lh:26});\n  // rating\n  const rt=frame(card,'Rating',18,254,120,26,null,0,false);\n  await ic(rt,'9:14',2,4,16,'#FFB30E');\n  txt(rt,'Rating value','46',22,1,80,{size:15,weight:'SemiBold',color:C.ink,lh:22});\n  // status\n  const st=frame(card,'Status Open Now',18,292,150,36,null,0,false);\n  const dot=rect(st,'Dot',0,13,8,8,C.green,4);\n  txt(st,'Status text','Open Now',16,7,140,{size:13,weight:'SemiBold',color:C.green,lh:20});\n  return f;\n}\nconst rc=restCard(); rc.x=40; rc.y=yStart;\ntxt(lib,'rc cap','Restaurant Card · badges + initials mark + rating + open status',40,yStart-22,900,{size:12,weight:'Bold',color:C.ink2});\n\n// closed variant\nfunction restClosed(){\n  const f=figma.createComponent(); f.name='Restaurant Card · Opens tomorrow'; lib.appendChild(f);\n  f.resize(300,352); f.fills=[]; f.clipsContent=false;\n  const card=frame(f,'Card',0,0,300,352,'#FFFFFF',18,true);\n  card.strokes=[solid('#F0E8DF')]; card.strokeWeight=1; card.strokeAlign='INSIDE';\n  const ph=frame(card,'Photo',0,0,300,176,null,0,true);\n  inst(ph,'9:56',0,0,300,176,'Photo');\n  const veil=rect(ph,'Closed veil',0,0,300,176,'#1A1A1F',0); veil.fills=[solid('#1A1A1F',0.18)];\n  const db=frame(card,'Discount badge',14,14,82,30,C.primary,999,true);\n  await ic(db,'9:19',10,9,13,'#FFFFFF');\n  txt(db,'Discount label','15% off',27,7,58,{size:12,weight:'Bold',color:'#FFFFFF',lh:17});\n  const fb=frame(card,'Fast badge',210,14,76,30,'#FFFFFF',999,true);\n  await ic(fb,'9:5',10,9,13,C.ink);\n  txt(fb,'Fast label','Fast',27,7,50,{size:12,weight:'Bold',color:C.ink,lh:17});\n  const mark=frame(card,'Initials mark',18,152,56,56,null,16,true);\n  mark.fills=[grad('#7C7C88','#5B5B66')];\n  mark.strokes=[solid('#FFFFFF')]; mark.strokeWeight=3; mark.strokeAlign='INSIDE';\n  txt(mark,'Initials','PH',0,14,56,{size:18,weight:'Bold',color:'#FFFFFF',lh:26,align:'CENTER'});\n  txt(card,'Name','Pizzahub',18,220,270,{size:19,weight:'Bold',color:C.ink,lh:26});\n  const rt=frame(card,'Rating',18,254,120,26,null,0,false);\n  await ic(rt,'9:14',2,4,16,'#FFB30E');\n  txt(rt,'Rating value','40',22,1,80,{size:15,weight:'SemiBold',color:C.ink,lh:22});\n  const st=frame(card,'Status Opens tomorrow',18,292,200,36,null,0,false);\n  rect(st,'Dot',0,13,8,8,'#B3AAA1',4);\n  txt(st,'Status text','Opens tomorrow',16,7,180,{size:13,weight:'SemiBold',color:'#8A8078',lh:20});\n  f.x=380; f.y=yStart;\n  return f;\n}\nawait restClosed();\n\n// ---------- POPULAR ITEM CARD ----------\nfunction itemCard(){\n  const f=figma.createComponent(); f.name='Item Card'; lib.appendChild(f);\n  f.resize(288,392); f.fills=[]; f.clipsContent=false;\n  const card=frame(f,'Card',0,0,288,392,'#FFFFFF',18,true);\n  const ph=frame(card,'Photo',0,0,288,208,'#FFF3E7',0,true);\n  inst(ph,'9:50',0,0,288,208,'Photo');\n  txt(card,'Name','Cheese Burger',20,228,250,{size:20,weight:'Bold',color:C.ink,lh:26});\n  const rl=frame(card,'Restaurant',20,262,250,24,null,0,false);\n  await ic(rl,'9:9',0,3,16,C.primary);\n  txt(rl,'Restaurant name','Burger Arena',22,0,220,{size:13,color:C.muted,lh:20});\n  txt(card,'Price','$3.88',20,296,200,{size:21,weight:'Bold',color:C.ink,lh:28});\n  const btn=frame(card,'Order Now button',20,336,248,44,C.primary,10,true);\n  txt(btn,'Order label','Order Now',0,11,248,{size:14,weight:'Bold',color:'#FFFFFF',lh:22,align:'CENTER'});\n  return f;\n}\nconst itc=itemCard(); itc.x=400; itc.y=yStart;\ntxt(lib,'itc cap','Item Card · popular items',400,yStart-22,600,{size:12,weight:'Bold',color:C.ink2});\n\n// ---------- DEAL BANNER ----------\nasync function dealCard(title,body,photoId,x){\n  const f=figma.createComponent(); f.name='Deal Banner · '+title; lib.appendChild(f);\n  f.resize(600,236); f.fills=[]; f.clipsContent=false;\n  const card=frame(f,'Card',0,0,600,236,'#F