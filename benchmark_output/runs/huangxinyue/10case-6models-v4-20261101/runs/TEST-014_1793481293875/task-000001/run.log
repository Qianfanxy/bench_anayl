{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_bdrk_pyglevoifnl2ee7eh7y43ez4zm3bqroj4vfej7tkw4qjnybz6w2a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_012uRPquSuBExH5uRGKxkHj5","name":"mcp__figma__use_figma","input":{"code":"const P=await figma.getNodeByIdAsync('7:2'); await figma.setCurrentPageAsync(P);\nawait Promise.all(['Regular','Medium','Semi Bold','Bold','Extra Bold'].map(s=>figma.loadFontAsync({family:'Inter',style:s})));\nconst V=Object.fromEntries((await figma.variables.getLocalVariablesAsync('COLOR')).map(v=>[v.name,v]));\nconst TS=Object.fromEntries((await figma.getLocalTextStylesAsync()).map(s=>[s.name,s]));\nconst ES=Object.fromEntries((await figma.getLocalEffectStylesAsync()).map(s=>[s.name,s]));\nconst paint=(n,o=1)=>{const v=V[n];const c=Object.values(v.valuesByMode)[0];const p=figma.variables.setBoundVariableForPaint({type:'SOLID',color:{r:c.r,g:c.g,b:c.b}},'color',v);return o===1?p:{...p,opacity:o};};\nconst T=async(s,st,c='Text/Primary')=>{const t=figma.createText();await t.setTextStyleIdAsync(TS[st].id);t.characters=s;t.fills=[paint(c)];return t;};\nconst media=await figma.getNodeByIdAsync('1:4'); await media.loadAsync();\nconst M=Object.fromEntries(media.findAll(n=>n.type==='COMPONENT').map(c=>[c.name,c]));\nconst icon=(n,c='Text/Primary',s=24,fill=false)=>{const i=M[n].createInstance();i.name=n;i.fills=[];i.findAll(x=>x.type==='VECTOR').forEach(v=>{if(v.strokes.length)v.strokes=[paint(c)];if(v.fills.length&&v.fills[0].type==='SOLID'&&v.fills[0].color.r<0.3)v.fills=[paint(c)];if(fill)v.fills=[paint(c)];});if(s!==24)i.rescale(s/24);return i;};\nconst pic=(n,w,h,r=0)=>{const i=M[n].createInstance();i.name='Photo';i.resize(w,h);if(r)i.cornerRadius=r;return i;};\nconst AL=(name,dir='HORIZONTAL',o={})=>{const f=figma.createFrame();f.name=name;f.layoutMode=dir;f.primaryAxisSizingMode='AUTO';f.counterAxisSizingMode='AUTO';f.fills=[];Object.assign(f,o);return f;};\nconst fix=(f,w,h)=>{f.resize(w,h);f.primaryAxisSizingMode='FIXED';f.counterAxisSizingMode='FIXED';};\nconst grad=(a='Brand/Plum',b='Brand/Orchid')=>{const ca=Object.values(V[a].valuesByMode)[0],cb=Object.values(V[b].valuesByMode)[0];return {type:'GRADIENT_LINEAR',gradientTransform:[[0.8,0.6,-0.2],[-0.6,0.8,0.4]],gradientStops:[{position:0,color:{...ca,a:1}},{position:1,color:{...cb,a:1}}]};};\nconst scrim=(a0,a1)=>({type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{r:0.1,g:0.04,b:0.1,a:a0}},{position:1,color:{r:0.1,g:0.04,b:0.1,a:a1}}]});\nconst H=await figma.getNodeByIdAsync('10:2');\nconst place=(n,x,y)=>{H.appendChild(n);n.x=x;n.y=y;};\nconst label=async(s,x,y)=>{const t=await T(s,'Label/Semi Bold 14','Text/Secondary');place(t,x,y);};\nconst setStyle=(S,dir='HORIZONTAL')=>{S.layoutMode=dir;S.itemSpacing=16;S.paddingLeft=S.paddingRight=S.paddingTop=S.paddingBottom=16;S.primaryAxisSizingMode='AUTO';S.counterAxisSizingMode='AUTO';S.fills=[paint('Surface/Background')];S.cornerRadius=16;};\nconst swapProp=(c,node,name,def)=>{const k=c.addComponentProperty(name,'INSTANCE_SWAP',M[def].id);node.componentPropertyReferences={mainComponent:k};return k;};\nconst textProp=(c,node,name)=>{const k=c.addComponentProperty(name,'TEXT',node.characters);node.componentPropertyReferences={characters:k};return k;};\nconst ids={};\n// ---- Story Avatar\nconst saV=[];\nfor (const ty of ['Your Story','Unseen','Seen']){\n const c=figma.createComponent();c.name='Type='+ty;c.layoutMode='VERTICAL';c.counterAxisAlignItems='CENTER';c.itemSpacing=6;c.primaryAxisSizingMode='AUTO';c.counterAxisSizingMode='FIXED';c.resize(72,10);c.fills=[];\n const ring=AL('Ring','HORIZONTAL',{primaryAxisAlignItems:'CENTER',counterAxisAlignItems:'CENTER'});fix(ring,68,68);ring.cornerRadius=34;\n ring.fills=ty==='Unseen'?[grad()]:ty==='Seen'?[paint('Surface/Border')]:[];if(ty==='Your Story'){ring.strokes=[paint('Surface/Border')];ring.strokeWeight=1.5;ring.dashPattern=[4,3];}\n const inner=AL('Gap','HORIZONTAL',{primaryAxisAlignItems:'CENTER',counterAxisAlignItems:'CENTER'});fix(inner,63,63);inner.cornerRadius=32;inner.fills=[paint('Surface/Background')];\n const ph=pic(ty==='Your Story'?'Portrait_Sarah_Payne':'Portrait_Claire_Smith',58,58,29);inner.appendChild(ph);ring.appendChild(inner);c.appendChild(ring);\n if(ty==='Your Story'){const b=AL('Add Badge','HORIZONTAL',{primaryAxisAlignItems:'CENTER',counterAxisAlignItems:'CENTER'});fix(b,24,24);b.cornerRadius=12;b.fills=[paint('Brand/Plum')];b.strokes=[paint('Surface/Background')];b.strokeWeight=2;b.appendChild(icon('Icon_Plus','Text/On Dark',14));ring.appendChild(b);b.layoutPositioning='ABSOLUTE';b.x=46;b.y=46;}\n const nm=await T(ty==='Your Story'?'Your Story':'Claire','Caption/Medium 12',ty==='Seen'?'Text/Secondary':'Text/Primary');c.appendChild(nm);\n saV.push(c);H.appendChild(c);}\nconst SA=figma.combineAsVariants(saV,H);SA.name='Story Avatar';setStyle(SA);\nconst sak=SA.addComponentProperty('Name','TEXT','Claire');const sap=SA.addComponentProperty('Photo','INSTANCE_SWAP',M['Portrait_Claire_Smith'].id);\nSA.children.forEach(v=>{v.findOne(n=>n.type==='TEXT').componentPropertyReferences={characters:sak};v.findOne(n=>n.name==='Photo').componentPropertyReferences={mainComponent:sap};});\nplace(SA,1500,96);await label('Story Avatar · Type (Your Story / Unseen / Seen)',1500,72);ids.SA=SA.id;\n// ---- Feed Post\nconst fpV=[];\nfor (const st of ['Default','Liked']){\n const c=figma.createComponent();c.name='State='+st;c.layoutMode='VERTICAL';c.primaryAxisSizingMode='AUTO';c.counterAxisSizingMode='FIXED';c.resize(353,10);c.paddingLeft=c.paddingRight=c.paddingTop=12;c.paddingBottom=8;c.itemSpacing=12;c.cornerRadius=24;c.fills=[paint('Surface/Background')];c.effectStyleId=ES['Elevation/Card'].id;\n const top=AL('Author','HORIZONTAL',{counterAxisAlignItems:'CENTER',itemSpacing:10});top.layoutAlign='STRETCH';top.primaryAxisSizingMode='FIXED';\n const av=pic('Portrait_Noemi_Slater',40,40,20);av.name='Avatar';top.appendChild(av);const nm=await T('Noemi Slater','Label/Semi Bold 16');top.appendChild(nm);nm.layoutGrow=1;\n const more=icon('Icon_More','Text/Secondary');top.appendChild(more);c.appendChild(top);\n const ph=pic('Post_Noemi_Slater',329,300,18);c.appendChild(ph);\n const act=AL('Actions','HORIZONTAL',{counterAxisAlignItems:'CENTER',itemSpacing:4});act.layoutAlign='STRETCH';act.primaryAxisSizingMode='FIXED';\n const mk=(ic,col,fill)=>{const b=AL('Action/'+ic.replace('Icon_',''),'HORIZONTAL',{primaryAxisAlignItems:'CENTER',counterAxisAlignItems:'CENTER'});fix(b,40,40);b.cornerRadius=20;if(fill)b.fills=[paint('Brand/Orchid Tint')];b.appendChild(icon(ic,col,24,fill));return b;};\n act.appendChild(mk('Icon_Like',st==='Liked'?'Semantic/Like':'Text/Primary',st==='Liked'));act.appendChild(mk('Icon_Chat','Text/Primary',false));\n c.appendChild(act);fpV.push(c);H.appendChild(c);}\nconst FP=figma.combineAsVariants(fpV,H);FP.name='Feed Post';setStyle(FP);FP.fills=[paint('Surface/Subtle')];\nconst fk=FP.addComponentProperty('Name','TEXT','Noemi Slater');const fa=FP.addComponentProperty('Avatar','INSTANCE_SWAP',M['Portrait_Noemi_Slater'].id);const fph=FP.addComponentProperty('Photo','INSTANCE_SWAP',M['Post_Noemi_Slater'].id);\nFP.children.forEach(v=>{v.findOne(n=>n.type==='TEXT'&&n.parent.name==='Author').componentPropertyReferences={characters:fk};v.findOne(n=>n.name==='Avatar').componentPropertyReferences={mainComponent:fa};v.findOne(n=>n.name==='Photo').componentPropertyReferences={mainComponent:fph};});\nplace(FP,1500,330);await label('Feed Post · State (Default / Liked)',1500,306);ids.FP=FP.id;\n// ---- Media Tile\nconst mtV=[];\nfor (const ty of ['Photo','Video']){\n const c=figma.createComponent();c.name='Type='+ty;c.resize(115,152);c.cornerRadius=12;c.clipsContent=true;c.fills=[];\n const ph=pic(ty==='Video'?'Claire_01_Video_Ocean':'Claire_02',115,152);c.appendChild(ph);ph.constraints={horizontal:'STRETCH',vertical:'STRETCH'};\n if(ty==='Video'){const g=figma.createRectangle();g.na