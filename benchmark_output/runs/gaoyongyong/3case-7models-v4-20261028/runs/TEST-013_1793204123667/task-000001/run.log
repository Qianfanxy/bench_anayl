clone(); p.name='10_Profile'; p.x=4770; p.y=0;\nfor(const n of p.children.slice()) n.remove();\n\nconst sb2=await figma.getNodeByIdAsync('2008:8'); const sbi=sb2.createInstance(); p.appendChild(sbi); sbi.x=0; sbi.y=0;\n\n// header band\nconst head=AF('profile_header','VERTICAL',10,[8,16,20,16]); head.fills=S('FFF1F0'); head.counterAxisAlignItems='CENTER';\nconst gear=await figma.getNodeByIdAsync('2008:106');\nconst gw=figma.createFrame(); gw.name='settings'; gw.resize(36,36); gw.fills=S(WHITE); gw.cornerRadius=18; gw.clipsContent=false;\nconst gi=gear.createInstance(); gi.rescale(20/24); gi.x=8; gi.y=8; gw.appendChild(gi);\nhead.appendChild(gw); gw.layoutPositioning='AUTO';\nconst av=await figma.getNodeByIdAsync('2008:25'); av.rescale(88/120); head.appendChild(av);\nhead.appendChild(T('Sophia Patel',20,'Bold',INK));\nhead.appendChild(T('sophiapatel@gmail.com',13,'Regular',SUB));\nconst editBtn=AF('btn_edit_profile','HORIZONTAL',8,[9,16,9,16]); editBtn.fills=S(WHITE); editBtn.cornerRadius=14; editBtn.counterAxisAlignItems='CENTER';\nconst pen=await figma.getNodeByIdAsync('2008:116'); const pi=pen.createInstance(); pi.rescale(16/24); editBtn.appendChild(pi);\neditBtn.appendChild(T('Edit Profile',13,'SemiBold',RED));\nhead.appendChild(editBtn);\np.appendChild(head); head.x=0; head.y=44; head.resize(430,head.height); head.layoutSizingHorizontal='FILL';\n// center the gear on the right\ngw.layoutPositioning='ABSOLUTE'; gw.x=378; gw.y=8;\n\nconst content=AF('content','VERTICAL',14,[16,16,16,16]); content.fills=S(BG); content.clipsContent=true;\np.appendChild(content); content.x=0; content.y=44+head.height; content.resize(430,932-(44+head.height)-90);\ncontent.layoutSizingHorizontal='FILL'; content.primaryAxisSizingMode='FIXED';\n\n// stats\nconst stats=AF('stats','HORIZONTAL',10,[0,0,0,0]);\nasync function stat(num,label){const c=AF('stat','VERTICAL',2,[12,10,12,10]); c.fills=S(WHITE); c.cornerRadius=16; c.counterAxisAlignItems='CENTER';\n c.appendChild(T(num,18,'Bold',RED)); c.appendChild(T(label,12,'Regular',SUB)); stats.appendChild(c); c.layoutGrow=1; c.layoutSizingHorizontal='FILL';}\nawait stat('24','Orders'); await stat('6','Saved Items'); await stat('3','Coupons');\ncontent.appendChild(stats); stats.layoutSizingHorizontal='FILL';\n\n// address card\nconst addr=AF('card_address','HORIZONTAL',12,[14,14,14,14]); addr.fills=S(WHITE); addr.cornerRadius=16; addr.counterAxisAlignItems='CENTER';\nconst pin=await figma.getNodeByIdAsync('2008:53');\nconst pw=figma.createFrame(); pw.resize(40,40); pw.fills=S('FFF1F0'); pw.cornerRadius=20; pw.clipsContent=false;\nconst pii=pin.createInstance(); pii.rescale(20/24); pii.x=10; pii.y=10; pw.appendChild(pii); addr.appendChild(pw);\nconst ac=AF('ac','VERTICAL',4,[0,0,0,0]);\nac.appendChild(T('Home Address',14,'SemiBold',INK));\nac.appendChild(T('123 Main St, Apartment 4A, New York, NY',12,'Regular',SUB,18));\naddr.appendChild(ac); ac.layoutGrow=1;\nconst chev=await figma.getNodeByIdAsync('2008:95'); const cvi=chev.createInstance(); cvi.rescale(18/24); addr.appendChild(cvi);\ncontent.appendChild(addr); addr.layoutSizingHorizontal='FILL';\n\n// menu list\nfunction cardList(title){const c=AF('card_'+title,'VERTICAL',0,[4,14,4,14]); c.fills=S(WHITE); c.cornerRadius=16; content.appendChild(c); c.layoutSizingHorizontal='FILL'; return c;}\nasync function item(parent,label,iconId,right,iconColor){\n  const r=AF('item_'+label,'HORIZONTAL',12,[13,0,13,0]); r.counterAxisAlignItems='CENTER';\n  const iw=figma.createFrame(); iw.resize(32,32); iw.fills=S(BG); iw.cornerRadius=10; iw.clipsContent=false;\n  const ii=(await figma.getNodeByIdAsync(iconId)).createInstance(); ii.rescale(18/24); ii.x=7; ii.y=7; iw.appendChild(ii); r.appendChild(iw);\n  r.appendChild(T(label,14,'Medium',INK));\n  const s=spacer(); r.appendChild(s); s.layoutGrow=1;\n  if(right) r.appendChild(T(right,13,'Regular',iconColor||SUB));\n  const cv=(await figma.getNodeByIdAsync('2008:95')).createInstance(); cv.rescale(16/24); r.appendChild(