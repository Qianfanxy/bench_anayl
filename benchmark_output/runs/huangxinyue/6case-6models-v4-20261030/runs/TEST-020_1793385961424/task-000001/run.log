.max(1.4,size/14);n.findAll(c=>('strokes' in c)).forEach(c=>{try{if(c.strokes&&c.strokes.length){c.strokeWeight=wgt;c.strokes=solid(color);}if(c.fills&&c.fills.length&&c.fills[0].type==='SOLID'&&c.type==='VECTOR'){c.fills=solid(color)}}catch(e){}});return n}\nfunction fr(p,name,x,y,w,h,fill,r,clips){const f=figma.createFrame();f.name=name;f.resize(w,h);f.x=x;f.y=y;f.fills=fill?solid(fill):[];if(r!=null)f.cornerRadius=r;f.clipsContent=clips!==false;p.appendChild(f);return f}\nfunction tx(p,name,x,y,w,chars,o={}){const t=figma.createText();p.appendChild(t);t.name=name;t.fontName={family:o.f||'Nunito',style:o.w||'Regular'};t.fontSize=o.s||15;t.characters=chars;t.fills=solid(o.c||C.ink);if(o.lh)t.lineHeight={unit:'PIXELS',value:o.lh};else t.lineHeight={unit:'AUTO'};if(o.ls)t.letterSpacing={unit:'PIXELS',value:o.ls};t.textAlignHorizontal=o.align||'LEFT';t.textAutoResize='HEIGHT';t.resize(w,10);t.x=x;t.y=y;return t}\nfunction comp(name,x,y,w,h){const c=figma.createComponent();c.name=name;c.resize(w,h);c.x=x;c.y=y;c.fills=[];c.clipsContent=false;SEC.appendChild(c);return c}\nconst SEC=figma.createSection();P.appendChild(SEC);SEC.name='Components · Chat Bot AI';SEC.x=0;SEC.y=4400;SEC.resize(1560,1180);SEC.fills=solid('#FFFFFF');\ntx(SEC,'lib-title',24,28,900,'Components · states, headers, bubbles, sheets and business pieces',{f:'Bricolage Grotesque',w:'SemiBold',s:20,c:C.ink});\ntx(SEC,'lib-sub',24,60,900,'Primary • Secondary • Destructive • Disabled • Ghost · tabs · chat item · image tile · export row · setting row · message bubbles · sheet · dialog',{s:12,c:C.muted});\n\nfunction btn(name,x,y,label,fill,textColor,borderColor){const c=comp(name,x,y,380,56);c.fills=fill?solid(fill):[];c.cornerRadius=36;c.clipsContent=false;if(borderColor){c.strokes=solid(borderColor);c.strokeWeight=1.5;}\n const t=tx(c,'label',0,16,380,label,{f:'Nunito',w:'SemiBold',s:17,c:textColor,align:'CENTER'});return c;}\nbtn('Button/Primary',24,108,'Continue',C.primary,'#FFFFFF');\nbtn('Button/Secondary',24,188,'Cancel',C.surface,C.ink,C.line);\nbtn('Button/Destructive',24,268,'Delete',C.error,'#FFFFFF');\nbtn('Button/Disabled',24,348,'Continue','#EFECF2','#A9A2B2');\nbtn('Button/Ghost',24,428,'Sign out',null,C.primary);\nfunction tab(name,x,y,label,active){const c=comp(name,x,y,Math.max(84,label.length*8+34),38);c.fills=active?solid(C.primary):solid(C.surface);c.cornerRadius=19;c.strokes=active?[]:solid(C.line);c.strokeWeight=1;tx(c,'label',0,9,c.width,label,{w:'SemiBold',s:13,c:active?'#FFFFFF':C.ink2,align:'CENTER'});return c}\ntab('Tab/Active',440,108,'Chats',true);tab('Tab/Default',548,108,'Archived',false);\nconst ib=comp('Icon Button',690,108,40,40);ib.fills=solid(C.soft);ib.cornerRadius=20;icn('menu',ib,10,10,20,C.primary,2);\nconst ib2=comp('Icon Button · ghost',750,108,40,40);ib2.fills=[];ib2.cornerRadius=20;icn('back',ib2,8,8,24,C.ink,2.2);\n// chat list item\nconst ci=comp('Chat List Item',440,196,380,66);ci.fills=solid(C.surface);\ntx(ci,'q',16,8,272,'How can I forget a bad memory?',{w:'SemiBold',s:14,lh:19,c:C.ink});\ntx(ci,'time',292,9,72,'28 mins ago',{w:'SemiBold',s:10,c:C.muted,align:'RIGHT'});\ntx(ci,'prev',16,47,348,'Forgetting a bad memory entirely may be challenging…',{s:12,lh:16,c:C.muted});\n// image tile\nconst tile=comp('Image Tile',440,300,118,118);tile.cornerRadius=16;tile.fills=solid(C.line2);tile.clipsContent=true;const ti=inst('mug',tile,-32,0,182,118);ti.name='art';\n// export row\nconst er=comp('Export Row',440,450,380,70);er.fills=solid(C.surface);\nicn('pdf',er,8,19,32,null,1);tx(er,'title',52,13,268,'How can I forget a bad memory?',{w:'SemiBold',s:14,c:C.ink});tx(er,'meta',52,35,200,'DEC 30, 2023  ·  2.16 MB',{s:11,c:C.muted});icn('up',er,336,27,16,C.muted,1.6).rotation=45;\n// setting row\nconst sr=comp('Setting Row',440,556,380,60);sr.fills=solid(C.surface);\nicn('premium',sr,14,18,24,C.primary,2);tx(sr,'label',50,12,240,'Theme',{w:'SemiBold',s:14,c:C.ink});tx(sr,'value',50,32,260,'System default',{s:11,c:C.muted});icn('up'