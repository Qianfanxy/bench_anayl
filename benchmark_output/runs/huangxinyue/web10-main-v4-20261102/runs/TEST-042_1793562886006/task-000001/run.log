and 44,686 others','Semi Bold',12); lt.name='Liked';\n  liked.appendChild(lt);\n  const cap = frame('Caption'); al(cap,'HORIZONTAL',{pl:14,pr:14,pb:6});\n  const caption = text('Caption','Regular',12,{lh:150,alpha:0.85}); caption.name='Caption';\n  caption.textAutoResize='HEIGHT'; caption.resize(262, caption.height);\n  cap.appendChild(caption);\n  const dateRow = frame('Date'); al(dateRow,'HORIZONTAL',{pl:14,pr:14,pb:14});\n  const dt = text('September 19','Regular',11,{alpha:0.5}); dt.name='Date';\n  dateRow.appendChild(dt);\n  c.appendChild(head); c.appendChild(photoWrap); c.appendChild(acts); c.appendChild(liked); c.appendChild(cap); c.appendChild(dateRow);\n  head.layoutAlign='STRETCH'; photoWrap.layoutAlign='STRETCH'; acts.layoutAlign='STRETCH'; liked.layoutAlign='STRETCH'; cap.layoutAlign='STRETCH'; dateRow.layoutAlign='STRETCH';\n  c.resize(290, Math.round(c.height));\n  COMP.appendChild(c); c.x = 1300; c.y = 360;\n  built['Instagram Post'] = c.id;\n}\n\n// ---- Ingredient Item / Unchecked & Checked ----\nfunction ingredientItem(name, checked, label){\n  const c = newComp(name);\n  al(c,'HORIZONTAL',{pt:16,pb:16,gap:16,align:'CENTER'});\n  c.strokes=[solid(BLACK,0.1)]; c.strokeBottomWeight=1; c.strokeTopWeight=0; c.strokeLeftWeight=0; c.strokeRightWeight=0;\n  const box = frame('Checkbox'); box.resize(24,24); box.cornerRadius=999;\n  if(checked){ box.fills=[solid(BLACK)]; const ck = inst(M.Icon_Check,14,14); tint(ck,WHITE); box.appendChild(ck); ck.x=5; ck.y=5; }\n  else { box.strokes=[solid(BLACK,0.3)]; box.strokeWeight=1.5; }\n  const t = text(label,'Regular',18, checked?{alpha:0.35}:{}); t.name='Label';\n  if(checked) t.textDecoration='STRIKETHROUGH';\n  c.appendChild(box); c.appendChild(t);\n  t.layoutGrow=1;\n  c.resize(700, Math.round(c.height));\n  return c;\n}\n{\n  const a = ingredientItem('Ingredient Item / Unchecked', false, 'Ingredient');\n  COMP.appendChild(a); a.x = 1750; a.y = 360;\n  built['Ingredient Item / Unchecked'] = a.id;\n  const b = ingredientItem('Ingredient Item / Checked', true, 'Ingredient');\n  COMP.appendChild(b); b.x = 1750; b.y = 460;\n  built['Ingredient Item / Checked'] = b.id;\n}\n\n// ---- Nutrition Row ----\n{\n  const c = newComp('Nutrition Row');\n  al(c,'HORIZONTAL',{pt:14,pb:14,gap:8});\n  c.strokes=[solid(BLACK,0.1)]; c.strokeBottomWeight=1; c.strokeTopWeight=0; c.strokeLeftWeight=0; c.strokeRightWeight=0;\n  const k = text('Calories','Regular',16,{alpha:0.6}); k.name='Key';\n  const v = text('219.9 kcal','Semi Bold',16); v.name='Value';\n  c.appendChild(k); c.appendChild(v);\n  k.layoutGrow=1;\n  c.resize(320, Math.round(c.height));\n  COMP.appendChild(c); c.x = 2600; c.y = 360;\n  built['Nutrition Row'] = c.id;\n}\n\n// ---- Pagination items ----\n{\n  const a = newComp('Pagination Item / Default');\n  al(a,'HORIZONTAL',{align:'CENTER',justify:'CENTER'});\n  const ta = text('1','Medium',16,{alpha:0.7}); ta.name='Label';\n  a.appendChild(ta); a.resize(48,48);\n  COMP.appendChild(a); a.x = 3050; a.y = 360;\n  built['Pagination Item / Default'] = a.id;\n\n  const b = newComp('Pagination Item / Current');\n  al(b,'HORIZONTAL',{align:'CENTER',justify:'CENTER'});\n  b.fills=[solid(BLACK)]; b.cornerRadius=12;\n  const tb = text('1','Semi Bold',16,{fills:[solid(WHITE)]}); tb.name='Label';\n  b.appendChild(tb); b.resize(48,48);\n  COMP.appendChild(b); b.x = 3110; b.y = 360;\n  built['Pagination Item / Current'] = b.id;\n\n  const d = newComp('Pagination Item / Next');\n  al(d,'HORIZONTAL',{align:'CENTER',justify:'CENTER'});\n  d.fills=[solid(TINT)]; d.cornerRadius=12;\n  const ic = inst(M.Icon_Chevron_Right,20,20); tint(ic,BLACK);\n  d.appendChild(ic); d.resize(48,48);\n  COMP.appendChild(d); d.x = 3170; d.y = 360;\n  built['Pagination Item / Next'] = d.id;\n}\n\nCOMP.resize(4400, 900);\nreturn built;","description":"Build business components: chips (timer/fork), recipe card, promo card, mini item, Instagram post, ingredients, nutrition, pagination"}}],"context_management":null},"paren