it compById('3:21')).createInstance();\nhPhotoWrap.appendChild(heroPhoto); heroPhoto.resize(620, 480);\n\n// --- Listings section ---\nconst listings = F('Listings'); solid(listings, C.paper);\nAL(listings, { dir: 'VERTICAL', gap: 48, pad: [96, 80, 96, 80] });\nhome.appendChild(listings); listings.layoutSizingHorizontal = 'FILL';\n\nconst lHead = F('Heading'); AL(lHead, { dir: 'HORIZONTAL', align: 'SPACE_BETWEEN', cross: 'MAX' });\nlistings.appendChild(lHead); lHead.layoutSizingHorizontal = 'FILL';\nconst lHeadL = F('left'); AL(lHeadL, { dir: 'VERTICAL', gap: 12 });\nlHeadL.appendChild(eyebrow('OUR LISTINGS'));\nlHeadL.appendChild(T('Find your next place to live', { size: 40, style: 'Bold', ls: -1 }));\nlHead.appendChild(lHeadL);\nconst seeAll = (await compByName('Link / Arrow')).createInstance();\nseeAll.findOne(n => n.type === 'TEXT').characters = 'See all listings';\nlHead.appendChild(seeAll);\n\nconst filter = F('Search filters'); solid(filter, C.white);\nfilter.cornerRadius = 16;\nfilter.strokes = [{ type: 'SOLID', color: C.border }]; filter.strokeWeight = 1;\nfilter.effects = [{ type: 'DROP_SHADOW', color: { r: 0.07, g: 0.07, b: 0.09, a: 0.06 }, offset: { x: 0, y: 8 }, radius: 24, spread: 0, visible: true, blendMode: 'NORMAL' }];\nAL(filter, { dir: 'HORIZONTAL', gap: 16, pad: [20, 20, 20, 20], cross: 'MAX' });\nlistings.appendChild(filter); filter.layoutSizingHorizontal = 'FILL';\nconst filterComp = await compByName('Field / Filter');\nfor (const [lab, ph] of [['Looking for', 'Any'], ['Location', 'All locations'], ['Property Type', 'Any type'], ['Price', 'Any price']]) {\n  const f = filterComp.createInstance();\n  labelText(f).characters = lab;\n  phText(f).characters = ph;\n  filter.appendChild(f);\n  f.layoutSizingHorizontal = 'FILL';\n}\nconst searchBtn = btnIconComp.createInstance();\nsearchBtn.findOne(n => n.type === 'TEXT').characters = 'Search';\nfilter.appendChild(searchBtn);\n\n// --- Listing cards ---\nconst cardComp = await compByName('Listing / Card');\nconst cardData = [\n  ['Malto House', '4 bd', '2 ba', '1,650 sq ft', '3:22'],\n  ['Birchwood Villa', '4 bd', '2 ba', '1,720 sq ft', '3:23'],\n  ['Cedar Lane House', '4 bd', '2 ba', '1,580 sq ft', '3:24'],\n  ['Harbor View Loft', '4 bd', '2 ba', '1,610 sq ft', '3:25'],\n  ['Maple Court House', '4 bd', '2 ba', '1,690 sq ft', '3:26'],\n  ['Willow Creek Home', '4 bd', '2 ba', '1,640 sq ft', '3:34'],\n];\nconst homeCards = [];\nfor (let r = 0; r < 2; r++) {\n  const rowF = F('Row ' + (r + 1)); AL(rowF, { dir: 'HORIZONTAL', gap: 32 });\n  listings.appendChild(rowF); rowF.layoutSizingHorizontal = 'FILL';\n  for (let cix = 0; cix < 3; cix++) {\n    const [name, bd, ba, area, photoId] = cardData[r * 3 + cix];\n    const card = cardComp.createInstance(); card.name = 'Listing · ' + name;\n    const pw = card.findOne(n => n.name === 'Photo');\n    pw.children[0].swapComponent(await compById(photoId));\n    card.findOne(n => n.type === 'TEXT' && n.fontSize === 20).characters = name;\n    const texts = card.findAll(n => n.type === 'TEXT' && n.fontSize === 14);\n    texts[0].characters = bd; texts[1].characters = ba; texts[2].characters = area;\n    rowF.appendChild(card);\n    card.layoutSizingHorizontal = 'FILL';\n    homeCards.push(card);\n  }\n}\nreturn JSON.stringify({ homeH: Math.round(home.height), cards: homeCards.length });\n","description":"Build 01_Home: hero, listings, filter bar, 6 cards — fixed labelText helper"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"8420bd2b-08e1-4650-9759-ee0744cf2f7f","uuid":"67c09c50-364f-4e1f-8de4-f873a531ffe7","timestamp":"2026-11-02T00:05:32.970Z","tool_use_meta":[{"id":"mcp__figma__use_figma_50_00e01ad2","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
