ndChild(i);\n  i.rescale(size/Math.max(c.width,c.height));\n  i.findAll(function(n){return n.type==='VECTOR';}).forEach(function(v){\n    if(v.fills.length){v.fills=[sol(color)];}\n    if(v.strokes.length){v.strokes=[sol(color)];}\n  });\n  i.x=x;i.y=y;return i;\n}\nconst IDS={timer:'7:47',fork:'7:40',play:'7:42',print:'7:43',share:'7:46'};\n\n// fix direction step naming\nconst dirC=await figma.getNodeByIdAsync('18:120');\nconst dbody=dirC.children[1];\ndbody.children[0].name='Title';dbody.children[1].name='Text';\n\n// Home heading fix\nconst home=await figma.getNodeByIdAsync('23:71');\nconst sec2=home.children.find(function(n){return n.name==='MoreRecipes';});\nif(sec2){const tt=sec2.children.find(function(c){return c.name==='Title';});if(tt){tt.resize(1120,10);tt.x=160;tt.fontSize=38;}}\n\nconst navSet=await figma.getNodeByIdAsync('11:35');\nconst navCur=navSet.children.find(function(c){return c.name.indexOf('Current')>=0;});\nconst navDef=navSet.children.find(function(c){return c.name.indexOf('Current')<0;});\nconst hdrC=await figma.getNodeByIdAsync('13:20');\nfunction makeHeader(parent,current){\n  const h=hdrC.createInstance();parent.appendChild(h);h.x=0;h.y=0;\n  ['Home','Recipes','Blog','Contact','About us'].forEach(function(l){\n    const inst=h.findOne(function(n){return n.name==='Nav_'+l.replace(' ','');});\n    if(!inst){return;}\n    if(l===current){inst.swapComponent(navCur);}else{inst.swapComponent(navDef);}\n    const t=inst.findOne(function(n){return n.type==='TEXT';});\n    if(t){t.characters=l;}\n  });\n  return h;\n}\nconst avC=await figma.getNodeByIdAsync('13:2');\n\nconst rec=figma.createFrame();rec.name='02_Recipe';rec.resize(1440,1000);rec.x=1600;rec.y=0;\nrec.fills=[sol(P.white)];PG.appendChild(rec);\nmakeHeader(rec,'Recipes');\n\nT(rec,{name:'Title',w:960,sz:50,st:'b',lh:1.15,ls:-1.4,al:'CENTER',x:240,y:150},'Healthy Japanese Fried Rice with Asparagus');\n\nconst meta=F(rec,{name:'MetaRow',w:1000,h:56,x:200,y:240});\nconst av=avC.createIns