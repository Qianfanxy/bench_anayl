orizontal='FILL';\n  const l=await T(top,'Portfolio value','Small Medium','Text/On Brand',{name:'Label'}); l.opacity=0.8;\n  const eye=await AL(top,{name:'Show / hide value',dir:'HORIZONTAL',w:32,h:32,main:'CENTER',cross:'CENTER',radius:16}); eye.fills=[{type:'SOLID',color:{r:1,g:1,b:1},opacity:0.16}];\n  const ei=(await N('3:143')).createInstance(); ei.rescale(0.75); eye.appendChild(ei); await tint(ei,'Text/On Brand');\n  if(vis==='Hidden'){ const sl=figma.createRectangle(); sl.name='Hidden slash'; sl.resize(22,1.5); sl.rotation=-35; await fill(sl,'Text/On Brand'); eye.appendChild(sl); sl.layoutPositioning='ABSOLUTE'; sl.x=6; sl.y=22; }\n  const val=await T(c,vis==='Shown'?'$13,240.11':'$ ••••••','Display','Text/On Brand',{name:'Value'});\n  const row=await AL(c,{name:'Meta',dir:'HORIZONTAL',gap:8,cross:'CENTER'});\n  const chip=await AL(row,{name:'Change',dir:'HORIZONTAL',pad:[3,8],radius:6}); chip.fills=[{type:'SOLID',color:{r:1,g:1,b:1},opacity:0.16}]; await T(chip,vis==='Shown'?'+1.53% today':'•••','Caption','Text/On Brand');\n  const lab=await T(row,'7-day trend','Caption','Text/On Brand'); lab.opacity=0.7;\n  const ch=figma.createFrame(); ch.name='7-day trend line'; ch.resize(W,Hh); ch.fills=[]; c.appendChild(ch);\n  const area=figma.createVector(); area.vectorPaths=[{windingRule:'NONZERO',data:'M'+pts.map(p=>p[0].toFixed(1)+' '+p[1].toFixed(1)).join(' L ')+` L ${W} ${Hh} L 0 ${Hh} Z`}]; ch.appendChild(area); area.x=0; area.y=Math.min(...pts.map(p=>p[1])); area.name='Area';\n  area.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{r:1,g:1,b:1,a:0.28}},{position:1,color:{r:1,g:1,b:1,a:0}}]}];\n  const ln=figma.createVector(); ln.vectorPaths=[{windingRule:'NONE',data:'M'+pts.map(p=>p[0].toFixed(1)+' '+p[1].toFixed(1)).join(' L ')}]; ch.appendChild(ln); ln.x=0; ln.y=Math.min(...pts.map(p=>p[1])); ln.name='Line'; await stroke(ln,'Text/On Brand',2); ln.strokeJoin='ROUND'; ln.strokeCap='ROUND';\n  const dot=figma.createEllipse(); dot.resize(8,8); await fill(dot,'Text/On Brand'); ch.appendChild(dot); dot.x=W-4; dot.y=pts[6][1]-4; dot.name='Sun';\n  if(vis==='Hidden'){ ch.opacity=0.35; }\n  pc.push(c);} \nawait makeSet(pc,'Portfolio Card');\n\n// Segmented\nconst sg=[];\nfor(const cur of ['Summary','Details']){ const c=await AL(null,{comp:true,name:'Current='+cur,dir:'HORIZONTAL',w:327,h:44,pad:4,gap:4,fill:'Surface/Subtle',radius:12});\n  for(const s of ['Summary','Details']){ const it=await AL(c,{name:s,dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',radius:9}); it.layoutGrow=1; it.layoutSizingVertical='FILL'; if(s===cur){ await fill(it,'Surface/Base'); await it.setEffectStyleIdAsync(E['Elevation 1'].id); await T(it,s,'Small Medium','Text/Primary').then(t=>t.fontName={family:'Inter',style:'Semi Bold'});} else { it.fills=[]; await T(it,s,'Small Medium','Text/Secondary'); } }\n  sg.push(c);} \nawait makeSet(sg,'Segmented Control','VERTICAL');\n\n// Range Tab\nconst rt=[];\nfor(const st of ['Selected','Default']){ const c=await AL(null,{comp:true,name:'State='+st,dir:'HORIZONTAL',w:46,h:32,main:'CENTER',cross:'CENTER',radius:8,fill:st==='Selected'?'Brand/Primary':null}); const t=await T(c,'1M','Caption',st==='Selected'?'Text/On Brand':'Text/Secondary',{name:'Label'}); if(st==='Selected') t.fontName={family:'Inter',style:'Semi Bold'}; prop(c,t,'Label','1M'); rt.push(c);} \nawait makeSet(rt,'Range Tab');\n\n// Text Tab\nconst tt=[];\nfor(const st of ['Selected','Default']){ const c=await AL(null,{comp:true,name:'State='+st,dir:'VERTICAL',gap:6,cross:'CENTER',pad:[4,0,0,0]}); c.fills=[]; const t=await T(c,'Revenue','Small Medium',st==='Selected'?'Brand/Primary':'Text/Tertiary',{name:'Label'}); if(st==='Selected') t.fontName={family:'Inter',style:'Semi Bold'}; prop(c,t,'Label','Revenue'); const u=figma.createRectangle(); u.name='Underline'; u.resize(24,2); u.cornerRadius=1; if(st==='Selected') await fill(u,'Brand/Primary'); else u.fills=[]; c.appendChild(u); tt.push(c);} \nawait make