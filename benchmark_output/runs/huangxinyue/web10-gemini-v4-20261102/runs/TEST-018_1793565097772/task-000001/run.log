height\":75},{\"id\":\"2:6\",\"name\":\"Icon_Mail\",\"type\":\"COMPONENT\",\"width\":24,\"height\":24},{\"id\":\"2:47\",\"name\":\"Icon_Map_Pin\",\"type\":\"FRAME\",\"width\":106,\"height\":75},{\"id\":\"2:7\",\"name\":\"Icon_Map_Pin\",\"type\":\"COMPONENT\",\"width\":24,\"height\":24},{\"id\":\"2:49\",\"name\":\"Icon_Minus\",\"type\":\"FRAME\",\"width\":92,\"height\":75},{\"id\":\"2:8\",\"name\":\"Icon_Minus\",\"type\":\"COMPONENT\",\"width\":24,\"height\":24},{\"id\":\"2:51\",\"name\":\"Icon_Phone\",\"type\":\"FRAME\",\"width\":94,\"height\":75},{\"id\":\"2:9\",\"name\":\"Icon_Phone\",\"type\":\"COMPONENT\",\"width\":24,\"height\":24},{\"id\":\"2:53\",\"name\":\"Icon_Play\",\"type\":\"FRAME\",\"width\":82,\"height\":75},{\"id\":\"2:10\",\"name\":\"Icon_Play\",\"type\":\"COMPONENT\",\"width\":24,\"height\":24},{\"id\":\"2:55\",\"name\":\"Icon_Plus\",\"type\":\"FRAME\",\"width\":82,\"height\":75},{\"id\":\"2:11\",\"name\":\"Icon_Plus\",\"type\":\"COMPONENT\",\"width\":24,\"height\":24},{\"id\":\"2:57\",\"name\":\"Icon_Trending_Up\",\"type\":\"FRAME\",\"width\":129,\"height\":75},{\"id\":\"2:12\",\"name\":\"Icon_Trending_Up\",\"type\":\"COMPONENT\",\"width\":24,\"height\":24}],\"components\":[{\"id\":\"1:24\",\"name\":\"Components\",\"type\":\"FRAME\",\"width\":1400,\"height\":330},{\"id\":\"1:28\",\"name\":\"Button\",\"type\":\"COMPONENT\",\"width\":232,\"height\":56}]}"}],"_meta":{"mcpRequestId":"db1baf2d-db61-4849-af34-0e79de10727c"}},"tool_result_meta":[{"id":"call_707c7303ad144ec791a5b6951a34c5e0","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
