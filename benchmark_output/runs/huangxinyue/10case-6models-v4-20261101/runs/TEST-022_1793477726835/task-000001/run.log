ndexOf('Jl. Sunset')===0);\n  addr.y = star.y + 16; addr.x=112;\n  addr.textAutoResize='NONE'; addr.resize(168,30);\n  addr.lineHeight={unit:'PIXELS',value:14};\n}\n\n// 3) Design system: Rating label off its swatch\nconst ds = page.findOne(n=>n.name==='Design system · colors & type');\nconst rating = ds.children.find(n=>n.type==='TEXT' && n.characters==='Rating');\nif(rating) rating.y = 370;\nreturn JSON.stringify({fbPaths: fbInfo, hotelName: hc && hc.children.find(n=>n.type==='TEXT'&&n.characters==='Swiss-Belhotel Rainforest Kuta').height});\n","description":"Restore Facebook brand mark, wrap hotel name, fix rating label","fileKey":"yLlTwvr6iAvdNrUJFo0x5H"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":3082,"input_tokens":55,"cache_read_input_tokens":129252,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":3082}},"context_management":null},"parent_tool_use_id":null,"session_id":"a4ab5345-e9b4-4d88-b61f-e1d5c063e801","uuid":"24168975-a3a1-48c9-8d26-96d324dde93d","timestamp":"2026-10-31T20:39:19.486Z","tool_use_meta":[{"id":"toolu_01XNMaGXUhSEqEx5SzjfonU9","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
