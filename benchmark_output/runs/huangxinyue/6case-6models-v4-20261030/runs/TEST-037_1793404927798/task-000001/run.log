           <text id=\"1:65\" name=\"LINKS\" x=\"25\" y=\"214\" width=\"582\" height=\"17\" />\n            <text id=\"1:66\" name=\"→ Submit → 05_Sign_In\" x=\"25\" y=\"241\" width=\"582\" height=\"21\" />\n          </frame>\n          <frame id=\"1:67\" name=\"08_Get_Started\" x=\"656\" y=\"1038\" width=\"632\" height=\"266\">\n            <text id=\"1:68\" name=\"08_Get_Started\" x=\"25\" y=\"25\" width=\"582\" height=\"27\" />\n            <text id=\"1:69\" name=\"Goal: Enter the store.\" x=\"25\" y=\"62\" width=\"582\" height=\"21\" />\n            <text id=\"1:70\" name=\"MUST INCLUDE\" x=\"25\" y=\"93\" width=\"582\" height=\"17\" />\n            <text id=\"1:71\" name=\"• Actions: Get Started • Copy: “You want Authentic, here you go!” · “Find it here, buy it now!” • Media: Get_Started_Photo\" x=\"25\" y=\"120\" width=\"582\" height=\"63\" />\n            <text id=\"1:72\" name=\"LINKS\" x=\"25\" y=\"193\" width=\"582\" height=\"17\" />\n            <text id=\"1:73\" name=\"→ Get Started → 09_Home\" x=\"25\" y=\"220\" width=\"582\" height=\"21\" />\n          </frame>\n          <frame id=\"1:74\" name=\"09_Home\" x=\"0\" y=\"1349\" width=\"632\" height=\"539\">\n            <text id=\"1:75\" name=\"09_Home\" x=\"25\" y=\"25\" width=\"582\" height=\"27\" />\n            <text id=\"1:76\" name=\"Goal: Discover deals, categories and trending products.\" x=\"25\" y=\"62\" width=\"582\" height=\"21\" />\n            <text id=\"1:77\" name=\"MUST INCLUDE\" x=\"25\" y=\"93\" width=\"582\" height=\"17\" />\n            <text id=\"1:78\" name=\"• Account: avatar · menu entry • Banner: “40–50% OFF” · “Now in all products” · “All colours” · Shop Now · 3 slides · current: slide 2 • Brand: Stylish logo • Categories: Beauty · Fashion · Kids · Mens · Womens · Gifts, each with its image • Deal of the Day: “Deal of the Day” · “22h 55m 20s remaining” · View all · 4 products (DATA) • Featured: “All Featured” · Sort · Filter • Main navigation: current tab Home • Promotions: Special Offers · Flat and Heels · Hot Summer Sale · New Arrivals · Sponsored (DATA) • Search: “Search any Product..” · voice input • Trending Products: “Trending Products” · “Last Date 28/02/22” · View all · 5 products (DATA)\" x=\"25\" y=\"120\" width=\"582\" height=\"294\" />\n            <text id=\"1:79\" name=\"LINKS\" x=\"25\" y=\"424\" width=\"582\" height=\"17\" />\n            <text id=\"1:80\" name=\"→ Trending Products View all → 10_Product_List → Sponsored → 11_Product_Detail → tabs\" x=\"25\" y=\"451\" width=\"582\" height=\"63\" />\n          </frame>\n          <frame id=\"1:81\" name=\"10_Product_List\" x=\"656\" y=\"1349\" width=\"632\" height=\"350\">\n            <text id=\"1:82\" name=\"10_Product_List\" x=\"25\" y=\"25\" width=\"582\" height=\"27\" />\n            <text id=\"1:83\" name=\"Goal: Browse every item in the store.\" x=\"25\" y=\"62\" width=\"582\" height=\"21\" />\n            <text id=\"1:84\" name=\"MUST INCLUDE\" x=\"25\" y=\"93\" width=\"582\" height=\"17\" />\n            <text id=\"1:85\" name=\"• Account: avatar · menu entry • Brand: Stylish logo • Main navigation: current tab Home • Products: 14 products, each with image, name, description, price and rating count (DATA) • Results: “52,082+ Items” · Sort · Filter • Search: “Search any Product..” · voice input\" x=\"25\" y=\"120\" width=\"582\" height=\"147\" />\n            <text id=\"1:86\" name=\"LINKS\" x=\"25\" y=\"277\" width=\"582\" height=\"17\" />\n            <text id=\"1:87\" name=\"→ tabs\" x=\"25\" y=\"304\" width=\"582\" height=\"21\" />\n          </frame>\n          <frame id=\"1:88\" name=\"11_Product_Detail\" x=\"0\" y=\"1912\" width=\"632\" height=\"455\">\n            <text id=\"1:89\" name=\"11_Product_Detail\" x=\"25\" y=\"25\" width=\"582\" height=\"27\" />\n            <text id=\"1:90\" name=\"Goal: Judge a product and add it to the bag.\" x=\"25\" y=\"62\" width=\"582\" height=\"21\" />\n            <text id=\"1:91\" name=\"MUST INCLUDE\" x=\"25\" y=\"93\" width=\"582\" height=\"17\" />\n            <text id=\"1:92\" name=\"• Actions: back · cart entry · Go to cart · Buy Now · View Similar · Add to Compare • Delivery: “Delivery within 1 hour” • Gallery: 5 photos (Nike_Sneakers_1–5) · current: photo 1 • Main navigation: current tab Home • Policies: Nearest Store · VIP · Return policy • Price: ₹1,500 · was ₹2,999 · 50% Off • Product: “Nike Sneakers” · “Vision Alta Men’s Shoes Size (All Colours)” · rating count 56,890 · “Product Details” with its text and “More” • Similar: “Similar To” · “282+ Items” · Sort · Filter · 4 products (DATA) • Size: 6 UK / 7 UK / 8 UK / 9 UK / 10 UK · current: 7 UK (“Size: 7 UK”)\" x=\"25\" y=\"120\" width=\"582\" height=\"210\" />\n            <text id=\"1:93\" name=\"LINKS\" x=\"25\" y=\"340\" width=\"582\" height=\"17\" />\n            <text id=\"1:94\" name=\"→ back → 09_Home → Go to cart → 12_Shopping_Bag → tabs\" x=\"25\" y=\"367\" width=\"582\" height=\"63\" />\n          </frame>\n          <frame id=\"1:95\" name=\"12_Shopping_Bag\" x=\"656\" y=\"1912\" width=\"632\" height=\"392\">\n            <text id=\"1:96\" name=\"12_Shopping_Bag\" x=\"25\" y=\"25\" width=\"582\" height=\"27\" />\n            <text id=\"1:97\" name=\"Goal: Review the bag before paying.\" x=\"25\" y=\"62\" width=\"582\" height=\"21\" />\n            <text id=\"1:98\" name=\"MUST INCLUDE\" x=\"25\" y=\"93\" width=\"582\" height=\"17\" />\n            <text id=\"1:99\" name=\"• Actions: back · wishlist entry · Apply Coupons “Select” · Proceed to Payment · View Details • Copy: “Shopping Bag” • Item: Women’s Casual Wear · photo · Size 42 (changeable) · Qty 1 (changeable) · “Delivery by 10 May” • Order Payment Details: Order Amounts ₹7,000.00 · Convenience: Know More · Apply Coupon · Delivery Fee ₹30.00 · Order Total ₹7,030.00 · EMI Available · Details • Total: ₹7,030.00\" x=\"25\" y=\"120\" width=\"582\" height=\"168\" />\n            <text id=\"1:100\" name=\"LINKS\" x=\"25\" y=\"298\" width=\"582\" height=\"17\" />\n            <text id=\"1:101\" name=\"→ back → 11_Product_Detail → Proceed to Payment → 13_Payment\" x=\"25\" y=\"325\" width=\"582\" height=\"42\" />\n          </frame>\n          <frame id=\"1:102\" name=\"13_Payment\" x=\"0\" y=\"2391\" width=\"632\" height=\"371\">\n            <text id=\"1:103\" name=\"13_Payment\" x=\"25\" y=\"25\" width=\"582\" height=\"27\" />\n            <text id=\"1:104\" name=\"Goal: Choose how to pay and confirm.\" x=\"25\" y=\"62\" width=\"582\" height=\"21\" />\n            <text id=\"1:105\" name=\"MUST INCLUDE\" x=\"25\" y=\"93\" width=\"582\" height=\"17\" />\n            <text id=\"1:106\" name=\"• Actions: back · Continue • Copy: “Checkout” · “Payment” • Main navigation: current tab Cart • Payment methods: VISA · PayPal · Maestro · Apple Pay, each “*********2109” · only one can be chosen · current: VISA • Summary: Order ₹7,000 · Shipping ₹30 · Total ₹7,030\" x=\"25\" y=\"120\" width=\"582\" height=\"126\" />\n            <text id=\"1:107\" name=\"LINKS\" x=\"25\" y=\"256\" width=\"582\" height=\"17\" />\n            <text id=\"1:108\" name=\"→ back → 12_Shopping_Bag → Continue → 14_Payment_Success_Overlay → tabs\" x=\"25\" y=\"283\" width=\"582\" height=\"63\" />\n          </frame>\n          <frame id=\"1:109\" name=\"14_Payment_Success_Overlay\" x=\"656\" y=\"2391\" width=\"632\" height=\"266\">\n            <text id=\"1:110\" name=\"14_Payment_Success_Overlay\" x=\"25\" y=\"25\" width=\"582\" height=\"27\" />\n            <text id=\"1:111\" name=\"Goal: Know the payment went through.\" x=\"25\" y=\"62\" width=\"582\" height=\"21\" />\n            <text id=\"1:112\" name=\"MUST INCLUDE\" x=\"25\" y=\"93\" width=\"582\" height=\"17\" />\n            <text id=\"1:113\" name=\"• Copy: “Payment done successfully.” • Presentation: dialog over 13_Payment; Payment stays behind it • Status: success mark\" x=\"25\" y=\"120\" width=\"582\" height=\"63\" />\n            <text id=\"1:114\" name=\"LINKS\" x=\"25\" y=\"193\" width=\"582\" height=\"17\" />\n            <text id=\"1:115\" name=\"→ tap dialog → 09_Home\" x=\"25\" y=\"220\" width=\"582\" height=\"21\" />\n          </frame>\n          <frame id=\"1:116\" name=\"15_Profile\" x=\"0\" y=\"2786\" width=\"632\" height=\"350\">\n            <text id=\"1:117\" name=\"15_Profile\" x=\"25\" y=\"25\" width=\"582\" height=\"27\" />\n            <text id=\"1:118\" name=\"Goal: Review and edit account details.\" x=\"25\" y=\"62\" width=\"582\" height=\"21\" />\n            <text id=\"1:119\" name=\"MUST INCLUDE\" x=\"25\" y=\"93\" width=\"582\" height=\"17\" />\n            <text id=\"1:120\" name=\"• Account: avatar · edit avatar • Actions: back · Change Password · Save • Bank Account Details: Bank Account Number · Account Holder’s Name · IFSC Code (DATA) • Business Address Details: Postcode · Address · City · State · Country (DATA) • Copy: “Profile” • Personal Details: Email Address aashifa@gmail.com · Password (masked)\" x=\"25\" y=\"120\" width=\"582\" height=\"147\" />\n            <text id=\"1:121\" name=\"LINKS\" x=\"25\" y=\"277\" width=\"582\" height=\"17\" />\n            <text id=\"1:122\" name=\"→ back → 09_Home\" x=\"25\" y=\"304\" width=\"582\" height=\"21\" />\n          </frame>\n        </frame>\n      </frame>\n      <frame id=\"1:123\" name=\"Navigation structure\" x=\"64\" y=\"3649\" width=\"1312\" height=\"241\">\n        <text id=\"1:124\" name=\"Navigation structure\" x=\"0\" y=\"0\" width=\"1312\" height=\"33\" />\n        <text id=\"1:125\" name=\"• Onboarding: 01 → 02 → 03 → 04 → 05_Sign_In; Skip on 02–04 goes straight to 05. • Account: 05_Sign_In ↔ 06_Sign_Up; 05 → 07_Forgot_Password → 05. Login / Create Account → 08_Get_Started → 09_Home. • Main navigation on 09, 10, 11, 13 — five tabs in this order: Home (Icon_Home) → 09 · Wishlist (Icon_Wishlist, entry only) · Cart (Icon_Cart) → 12_Shopping_Bag · Search (Icon_Search, entry only) · Setting (Icon_Settings) → 15_Profile. The current tab must match the frame. How it looks is yours. • Purchase: 09 → 11_Product_Detail → 12_Shopping_Bag → 13_Payment → 14 (dialog over 13) → 09. • Entry only (no screen required): menu, Sort, Filter, voice input, Shop Now, View all on Deal of the Day / New Arrivals, Visit now, Buy Now, View Similar, Add to Compare, Apply Coupons, Know More, EMI Details, Change Password, Save, social sign-in. • Do not add frames beyond the 15.\" x=\"0\" y=\"49\" width=\"1312\" height=\"192\" />\n      </frame>\n      <frame id=\"1:126\" name=\"Fixed data &amp; copy\" x=\"64\" y=\"3938\" width=\"1312\" height=\"1675\">\n        <text id=\"1:127\" name=\"Fixed data &amp; copy\" x=\"0\" y=\"0\" width=\"1312\" height=\"33\" />\n        <text id=\"1:128\" name=\"Use these values verbatim. Counts use Indian digit grouping (1,52,344). “was” = original price shown struck through or otherwise marked as former price — how is yours.\" x=\"0\" y=\"49\" width=\"1312\" height=\"23\" />\n        <frame id=\"1:129\" name=\"Data cards\" x=\"0\" y=\"88\" width=\"1312\" height=\"1587\">\n          <frame id=\"1:130\" name=\"User &amp; account\" x=\"0\" y=\"0\" width=\"632\" height=\"136\">\n            <text id=\"1:131\" name=\"User &amp; account\" x=\"21\" y=\"21\" width=\"590\" height=\"23\" />\n            <text id=\"1:132\" name=\"Aashifa · aashifa@gmail.com · password masked · avatar = Avatar_Illustrated Sign in / Sign up fields: “Username or Email”, “Password”, “Confirm Password” (placeholders, nothing entered)\" x=\"21\" y=\"52\" width=\"590\" height=\"63\" />\n          </frame>\n          <frame id=\"1:133\" name=\"Categories (Home)\" x=\"656\" y=\"0\" width=\"632\" height=\"115\">\n            <text id=\"1:134\" name=\"Categories (Home)\" x=\"21\" y=\"21\" width=\"590\" height=\"23\" />\n            <text id=\"1:135\" name=\"Beauty (Category_Beauty) · Fashion (Category_Fashion) · Kids (Category_Kids) · Mens (Category_Mens) · Womens (Category_Womens) · Gifts (Category_Gifts)\" x=\"21\" y=\"52\" width=\"590\" height=\"42\" />\n          </frame>\n          <frame id=\"1:136\" name=\"Deal of the Day\" x=\"0\" y=\"160\" width=\"632\" height=\"241\">\n            <text id=\"1:137\" name=\"Deal of the Day\" x=\"21\" y=\"21\" width=\"590\" height=\"23\" />\n            <text id=\"1:138\" name=\"Women Printed Kurta · ₹1,500 · was ₹2,499 · 40% Off · 56,890 ratings (Deal_Women_Printed_Kurta) HRX by Hrithik Roshan · ₹2,499 · was ₹4,999 · 50% Off · 3,44,567 ratings (Deal_HRX_Sneakers) Philips BHH880/10 · “Hair Straightening Brush With Keratin Infused Bristles (Black).” · ₹999 · was ₹1,999 · 50% Off · 6,46,776 ratings · no photo supplied TITAN Men Watch- 1806N · “This Titan watch in Black color is I wanted to buy for a long time” · ₹1,500 · was ₹3,500 · 57% Off · 15,007 ratings (Deal_Titan_Watch)\" x=\"21\" y=\"52\" width=\"590\" height=\"168\" />\n          </frame>\n          <frame id=\"1:139\" name=\"Trending Products\" x=\"656\" y=\"160\" width=\"632\" height=\"283\">\n            <text id=\"1:140\" name=\"Trending Products\" x=\"21\" y=\"21\" width=\"590\" height=\"23\" />\n            <text id=\"1:141\" name=\"IWC Schaffhausen 2021 Pilot’s Watch “SIHH 2019” 44mm · ₹650 · was ₹1,599 · 59% off (Trending_IWC_Watch) Labbin White Sneakers For Men and Female · ₹650 · was ₹1,250 · 48% off (Trending_Labbin_Sneakers) Mammon Women’s Handbag (Set of 3, Beige) · ₹750 · was ₹1,999 · 62% off · no photo supplied Do Bhai Women Wedges Sandal (Butterfly) · ₹750 · was ₹1,499 · 50% off (Trending_Wedges_Sandal) Lakme Enrich Matte Lipstick - Shade RM1 (4.7gm) · ₹950 · was ₹1,990 · 52% off (Trending_Lakme_Lipstick)\" x=\"21\" y=\"52\" width=\"590\" height=\"210\" />\n          </frame>\n          <frame id=\"1:142\" name=\"Promotions (Home)\" x=\"0\" y=\"467\" width=\"632\" height=\"220\">\n            <text id=\"1:143\" name=\"Promotions (Home)\" x=\"21\" y=\"21\" width=\"590\" height=\"23\" />\n            <text id=\"1:144\" name=\"Special Offers 😱 · “We make sure you get the offer you need at best prices” (Promo_Special_Offer) Flat and Heels · “Stand a chance to get rewarded” · Visit now (Promo_Flat_And_Heels) Hot Summer Sale banner (Promo_Hot_Summer_Sale) New Arrivals · “Summer’ 25 Collections” · View all Sponsored · “up to 50% Off” (Promo_Sponsored_Shoes) Banner slide: Promo_Banner_Sale\" x=\"21\" y=\"52\" width=\"590\" height=\"147\" />\n          </frame>\n          <frame id=\"1:145\" name=\"Product list (52,082+ Items)\" x=\"656\" y=\"467\" width=\"632\" height=\"472\">\n            <text id=\"1:146\" name=\"Product list (52,082+ Items)\" x=\"21\" y=\"21\" width=\"590\" height=\"23\" />\n            <text id=\"1:147\" name=\"Black Winter Jacket · Autumn And Winter Casual cotton-padded jacket · ₹499 · 6,890 Mens Starry · Mens Starry Sky Printed Shirt, 100% Cotton Fabric · ₹399 · 1,52,344 Black Dress · Solid Black Dress for Women, Sexy Chain Shorts Ladies · ₹2,000 · 5,23,456 Pink Embroidered Dress · EARTHEN Rose Pink Embroidered Tiered Maxi Dress · ₹1,900 · 45,678 Flare Dress · Antheaa Black &amp; Rust Orange Floral Print Tiered Midi Flared Dress · ₹1,990 · 3,35,566 Denim Dress · Blue cotton denim dress, Look 2 printed cotton dress · ₹999 · 27,344 Jordan Stay · The classic Air Jordan 12 to create a shoe that’s fresh · ₹4,999 · 10,23,456 Realme 7 · 6 GB RAM | 64 GB ROM | Expandable Upto 256 GB · ₹3,499 · 3,44,567 Sony PS4 · Sony PS4 Console, 1TB Slim with 3 Games · ₹1,999 · 8,35,566 Black Jacket · Warm and comfortable everyday jacket · ₹2,999 · 2,23,569 D7200 Digital Camera · D7200 Digital Camera (Nikon) · ₹26,999 · 67,456 · no photo supplied Men’s Formal Shoes · George Walker Derby Brown Formal Shoes · ₹999 · 13,45,678 MuscleBlaze Muesli · Nutritional powerhouse: MuscleBlaze High Protein Muesli · ₹3,900 · 1,35,566 Hot Chocolate · Hot chocolate with ashwagandha · ₹200 · 6,23,569 Photos: List_&lt;Name&gt; in 04 · Media, same order\" x=\"21\" y=\"52\" width=\"590\" height=\"399\" />\n          </frame>\n          <frame id=\"1:148\" name=\"Product detail\" x=\"0\" y=\"963\" width=\"632\" height=\"220\">\n            <text id=\"1:149\" name=\"Product detail\" x=\"21\" y=\"21\" width=\"590\" height=\"23\" />\n            <text id=\"1:150\" name=\"Nike Sneakers · “Vision Alta Men’s Shoes Size (All Colours)” · 56,890 ratings · ₹1,500 · was ₹2,999 · 50% Off Product Details: “Perhaps the most iconic sneaker of all-time, this original “Chicago” colorway is the cornerstone to any sneaker collection. Made famous in 1985 by Michael Jordan, the shoe has stood the test of time, becoming the most famous colorway of the Air Jordan 1. This 2015 release saw the…” + More Sizes 6 UK · 7 UK (selected) · 8 UK · 9 UK · 10 UK · “Delivery within 1 hour”\" x=\"21\" y=\"52\" width=\"590\" height=\"147\" />\n          </frame>\n          <frame id=\"1:151\" name=\"Similar To (282+ Items)\" x=\"656\" y=\"963\" width=\"632\" height=\"199\">\n            <text id=\"1:152\" name=\"Similar To (282+ Items)\" x=\"21\" y=\"21\" width=\"590\" height=\"23\" />\n            <text id=\"1:153\" name=\"Nike Sneakers · Nike Air Jordan Retro 1 Low Mystic Black · ₹1,900 · 46,890 (Similar_1) Nike Sneakers · Mid Peach Mocha Shoes For Man White Black Pink Sneakers · ₹1,900 · 2,56,890 (Similar_2) Nike Sneakers · Nike Air Jordan 1 Low Shoes For Man Basketball Shoes · ₹1,900 · 1,56,890 (Similar_3) Nike Sneakers · Jordan 1 Hyper Royal Heavy Quality · ₹1,500 · 96,890 (Similar_4)\" x=\"21\" y=\"52\" width=\"590\" height=\"126\" />\n          </frame>\n          <frame id=\"1:154\" name=\"Bag &amp; payment\" x=\"0\" y=\"1207\" width=\"632\" height=\"199\">\n            <text id=\"1:155\" name=\"Bag &amp; payment\" x=\"21\" y=\"21\" width=\"590\" height=\"23\" />\n            <text id=\"1:156\" name=\"Item: Women’s Casual Wear (Bag_Womens_Casual_Wear) · Size 42 · Qty 1 · Delivery by 10 May · ₹7,000.00 Order Amounts ₹7,000.00 + Delivery Fee ₹30.00 = Order Total ₹7,030.00 Payment summary: Order ₹7,000 · Shipping ₹30 · Total ₹7,030 Methods: VISA (Logo_Visa) · PayPal (Logo_PayPal) · Maestro (Logo_Maestro) · Apple Pay (Logo_Apple) — each “*********2109”; VISA selected\" x=\"21\" y=\"52\" width=\"590\" height=\"126\" />\n          </frame>\n          <frame id=\"1:157\" name=\"Profile\" x=\"656\" y=\"1207\" width=\"632\" height=\"178\">\n            <text id=\"1:158\" name=\"Profile\" x=\"21\" y=\"21\" width=\"590\" height=\"23\" />\n            <text id=\"1:159\" name=\"Email Address aashifa@gmail.com · Password masked Business Address: Postcode N1 2LL · Address 216 St Paul’s Rd · City London · State England · Country United Kingdom Bank: Account Number 204356XXXXXXX · Account Holder’s Name Abhiraj Sisodiya · IFSC Code SBIN00428\" x=\"21\" y=\"52\" width=\"590\" height=\"105\" />\n          </frame>\n          <frame id=\"1:160\" name=\"Onboarding &amp; sign-in copy\" x=\"0\" y=\"1430\" width=\"632\" height=\"157\">\n            <text id=\"1:161\" name=\"Onboarding &amp; sign-in copy\" x=\"21\" y=\"21\" width=\"590\" height=\"23\" />\n            <text id=\"1:162\" name=\"02 “Choose Products” · 03 “Make Payment” · 04 “Get Your Order” (bodies as in the frame list) Sign in “Welcome Back!” · Sign up “Create an account” · Forgot “Forgot password?” Get Started “You want Authentic, here you go!” · “Find it here, buy it now!”\" x=\"21\" y=\"52\" width=\"590\" height=\"84\" />\n          </frame>\n        </frame>\n      </frame>\n      <frame id=\"1:163\" name=\"What is fixed · what is yours\" x=\"64\" y=\"5661\" width=\"1312\" height=\"292\">\n        <text id=\"1:164\" name=\"What is fixed · what is yours\" x=\"0\" y=\"0\" width=\"1312\" height=\"33\" />\n        <frame id=\"1:165\" name=\"Fixed vs yours\" x=\"0\" y=\"49\" width=\"1312\" height=\"243\">\n          <frame id=\"1:166\" name=\"Fixed (given)\" x=\"0\" y=\"0\" width=\"644\" height=\"243\">\n            <text id=\"1:167\" name=\"Fixed (given)\" x=\"24\" y=\"24\" width=\"596\" height=\"24\" />\n            <text id=\"1:168\" name=\"• Frame list and exact names • Must-include content per frame (what, not how) • Navigation structure and links • All data and copy • Brand primary color + Montserrat • Media: logo, product photos, banners, payment logos, icons, illustrated avatar • Default Button, default Text Field, platform shell\" x=\"24\" y=\"58\" width=\"596\" height=\"161\" />\n          </frame>\n          <frame id=\"1:169\" name=\"Yours (designer decides)\" x=\"668\" y=\"0\" width=\"644\" height=\"220\">\n            <text id=\"1:170\" name=\"Yours (designer decides)\" x=\"24\" y=\"24\" width=\"596\" height=\"24\" />\n            <text id=\"1:171\" name=\"• Layout, grouping, order and emphasis on every screen • All other colors: neutrals, text, surfaces, semantic, sale and rating colors • Type scale, spacing, radii, elevation • All states: selected, pressed, disabled, focused, current slide / step • Headers, main navigation, product cards, dialogs and all business components • How prices, discounts and ratings are shown\" x=\"24\" y=\"58\" width=\"596\" height=\"138\" />\n          </frame>\n        </frame>\n      </frame>\n      <frame id=\"1:172\" name=\"How it is evaluated\" x=\"64\" y=\"6001\" width=\"1312\" height=\"296\">\n        <text id=\"1:173\" name=\"How it is evaluated\" x=\"0\" y=\"0\" width=\"1312\" height=\"33\" />\n        <text id=\"1:174\" name=\"Your file is compared with the brief on coverage, data and flow — not on visual similarity to any reference.\" x=\"0\" y=\"49\" width=\"1312\" height=\"23\" />\n        <text id=\"1:175\" name=\"1. Checklist coverage per frame 2. Data &amp; copy accuracy 3. Flow &amp; prototype completeness 4. Information hierarchy 5. Visual quality &amp; consistency of your own system 6. Component reuse 7. State design (current tab, size, slide, step and payment method; empty forms)\" x=\"0\" y=\"88\" width=\"1312\" height=\"168\" />\n        <text id=\"1:176\" name=\"Deliverable: the link to your own Figma file containing the 15 named frames, your components and the prototype.\" x=\"0\" y=\"272\" width=\"1312\" height=\"24\" />\n      </frame>\n    </frame>\n  </frame>\n</canvas>"},{"type":"text","text":"IMPORTANT: After you call this tool, you MUST call get_design_context if trying to implement the design, since this tool only returns metadata. If you do not call get_design_context, the agent will not be able to implement the design."}]}]},"parent_tool_use_id":null,"session_id":"14b42764-d761-4609-9d48-7eed784bda72","uuid":"acba4c02-9eea-4f07-8573-22c9ab57ab6f","timestamp":"2026-10-31T00:02:37.064Z","tool_use_result":{"content":[{"type":"text","text":"<canvas id=\"0:1\" name=\"00 · Start Here 设计任务\" x=\"0\" y=\"0\" width=\"0\" height=\"0\">\n  <frame id=\"1:5\" name=\"Start Here · Brief\" x=\"0\" y=\"0\" width=\"1440\" height=\"6682\">\n    <frame id=\"1:6\" name=\"Header\" x=\"0\" y=\"0\" width=\"1440\" height=\"321\">\n      <text id=\"1:7\" name=\"LEVEL L2 · DESIGN TASK · v2\" x=\"64\" y=\"56\" width=\"1312\" height=\"21\" />\n      <text id=\"1:8\" name=\"Stylish — fashion &amp; lifestyle shopping app\" x=\"64\" y=\"89\" width=\"1312\" height=\"60\" />\n      <text id=\"1:9\" name=\"Design the complete Stylish mobile shopping app: a first-time shopper goes through onboarding, signs in, browses featured deals and trending products, opens a product, reviews the shopping bag, pays and manages the profile. Canvas 375 × 812, light mode only. Home, Product list, Product detail and Profile may scroll vertically. Currency: Indian rupee (₹). Work in your own new Figma file — this file is read-only reference.\" x=\"64\" y=\"161\" width=\"1312\" height=\"104\" />\n    </frame>\n    <frame id=\"1:10\" name=\"Body\" x=\"0\" y=\"321\" width=\"1440\" height=\"6361\">\n      <frame id=\"1:11\" name=\"How to work\" x=\"64\" y=\"64\" width=\"1312\" height=\"265\">\n        <text id=\"1:12\" name=\"How to work\" x=\"0\" y=\"0\" width=\"1312\" height=\"33\" />\n        <text id=\"1:13\" name=\"1. Build exactly the 15 frames below, named exactly as listed (one state per frame), and wire them as a clickable prototype with the listed links. 2. Everything in “Must include” must appear on that frame. The lists are grouped by subject and sorted alphabetically — they are not in screen order and say nothing about layout, grouping, emphasis or styling. Those are your decisions. 3. The brand primary color and the typeface in 01 · Foundations are fixed. Define every other color yourself (neutrals, text, surfaces, success / error / disabled, sale and rating colors), plus type scale, spacing, radii and elevation, and apply them consistently. 4. 02 · Components gives only a default Button, a default Text Field and the platform shell (status bar, home indicator). Design all other states, the headers, the main navigation and every business component as reusable components in your file. 5. Use the logo, product photos, banners, payment logos and icons from 04 · Media. A product marked “no photo supplied” needs a consistent fallback of your choice. 6. Copy and data must match “Fixed data” exactly. This brief wins over anything you may know of the original kit.\" x=\"0\" y=\"49\" width=\"1312\" height=\"216\" />\n      </frame>\n      <frame id=\"1:14\" name=\"Frames · goals · must include · links\" x=\"64\" y=\"377\" width=\"1312\" height=\"3224\">\n        <text id=\"1:15\" name=\"Frames · goals · must include · links\" x=\"0\" y=\"0\" width=\"1312\" height=\"33\" />\n        <text id=\"1:16\" name=\"Frame names are fixed. Must-include lists are grouped by subject and sorted A–Z: they state what is on the screen, never where it goes or how it looks.\" x=\"0\" y=\"49\" width=\"1312\" height=\"23\" />\n        <frame id=\"1:17\" name=\"Frame cards\" x=\"0\" y=\"88\" width=\"1312\" height=\"3136\">\n          <frame id=\"1:18\" name=\"01_Splash\" x=\"0\" y=\"0\" width=\"632\" height=\"224\">\n            <text id=\"1:19\" name=\"01_Splash\" x=\"25\" y=\"25\" width=\"582\" height=\"27\" />\n            <text id=\"1:20\" name=\"Goal: Recognise the brand while the app loads.\" x=\"25\" y=\"62\" width=\"582\" height=\"21\" />\n            <text id=\"1:21\" name=\"MUST INCLUDE\" x=\"25\" y=\"93\" width=\"582\" height=\"17\" />\n            <text id=\"1:22\" name=\"• Brand: Stylish logo\" x=\"25\" y=\"120\" width=\"582\" height=\"21\" />\n            <text id=\"1:23\" name=\"LINKS\" x=\"25\" y=\"151\" width=\"582\" height=\"17\" />\n            <text id=\"1:24\" name=\"→ auto-advance → 02_Onboarding_Choose_Products\" x=\"25\" y=\"178\" width=\"582\" height=\"21\" />\n          </frame>\n          <frame id=\"1:25\" name=\"02_Onboarding_Choose_Products\" x=\"656\" y=\"0\" width=\"632\" height=\"329\">\n            <text id=\"1:26\" name=\"02_Onboarding_Choose_Products\" x=\"25\" y=\"25\" width=\"582\" height=\"27\" />\n            <text id=\"1:27\" name=\"Goal: Learn what the app offers (step 1).\" x=\"25\" y=\"62\" width=\"582\" height=\"21\" />\n            <text id=\"1:28\" name=\"MUST INCLUDE\" x=\"25\" y=\"93\" width=\"582\" height=\"17\" />\n            <text id=\"1:29\" name=\"• Actions: Next · Skip • Copy: “Choose Products” · “Browse thousands of products across fashion, beauty, electronics and more.” • Media: Onboarding_Choose_Products • Progress: step 1 of 3\" x=\"25\" y=\"120\" width=\"582\" height=\"105\" />\n            <text id=\"1:30\" name=\"LINKS\" x=\"25\" y=\"235\" width=\"582\" height=\"17\" />\n            <text id=\"1:31\" name=\"→ Next → 03_Onboarding_Make_Payment → Skip → 05_Sign_In\" x=\"25\" y=\"262\" width=\"582\" height=\"42\" />\n          </frame>\n          <frame id=\"1:32\" name=\"03_Onboarding_Make_Payment\" x=\"0\" y=\"353\" width=\"632\" height=\"287\">\n            <text id=\"1:33\" name=\"03_Onboarding_Make_Payment\" x=\"25\" y=\"25\" width=\"582\" height=\"27\" />\n            <text id=\"1:34\" name=\"Goal: Learn how paying works (step 2).\" x=\"25\" y=\"62\" width=\"582\" height=\"21\" />\n            <text id=\"1:35\" name=\"MUST INCLUDE\" x=\"25\" y=\"93\" width=\"582\" height=\"17\" />\n        