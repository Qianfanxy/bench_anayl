{"type":"assistant","message":{"id":"chatcmpl-20261028114507320829648268d9d6V3L9K7K1","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_5cdc50743da5433c8e8531c98e7d7766","name":"mcp__figma__use_figma","input":{"code":"// Ah, \"SyntaxError: expecting ';'\" - let's check where the missing semicolon or syntax issue is.\n// Oh, is it in the line:\n// `createHistoryItem(366, \"Buy\", \"AAPL\", \"₦200,000\", false);`\n// Wait! Let's check:\n// `title.characters = (type === \"Buy\" ? \"Buy \" : \"Sell \") + \"\\\\\"\" + stock + \"\\\\\" Stock\";`\n// In JavaScript, using double slashes inside a string literal enclosed in double quotes might require careful escaping, or wait:\n// `(type === \"Buy\" ? \"Buy \" : \"Sell \") + \"\\\"\" + stock + \"\\\" Stock\"` is simpler and doesn't require extra backslashes inside our template string because we are passing it as text directly.\n// Let's change it to:\n// `title.characters = (type === \"Buy\" ? \"Buy \" : \"Sell \") + \"'\" + stock + \"' Stock\";`\n// That is much cleaner, avoids escaping issues, and is visually equivalent!\n// Let's apply this fix and verify other lines.\n\nasync function buildSecondScreens() {\n  const workspacePage = figma.root.children.find(p => p.id === \"2003:2\");\n  if (!workspacePage) throw new Error(\"Workspace page not found\");\n  await figma.setCurrentPageAsync(workspacePage);\n\n  // Load fonts\n  await Promise.all([\n    figma.loadFontAsync({ family: \"Inter\", style: \"Regular\" }),\n    figma.loadFontAsync({ family: \"Inter\", style: \"Medium\" }),\n    figma.loadFontAsync({ family: \"Inter\", style: \"Semi Bold\" }),\n    figma.loadFontAsync({ family: \"Inter\", style: \"Bold\" }),\n    figma.loadFontAsync({ family: \"DM Sans\", style: \"Regular\" }),\n    figma.loadFontAsync({ family: \"DM Sans\", style: \"Medium\" }),\n    figma.loadFontAsync({ family: \"DM Sans\", style: \"Bold\" })\n  ]);\n\n  const primaryColor = { r: 49/255, g: 160/255, b: 98/255 }; // #31A062\n  const textDarkColor = { r: 26/255, g: 26/255, b: 26/255 }; // #1A1A1A\n  const textGreyColor = { r: 130/255, g: 130/255, b: 130/255 }; // #828282\n  const textLightColor = { r: 189/255, g: 189/255, b: 189/255 }; // #BDBDBD\n  const dividerColor = { r: 240/255, g: 240/255, b: 240/255 }; // #F0F0F0\n  const bgGreyColor = { r: 246/255, g: 246/255, b: 246/255 }; // #F6F6F6\n\n  const statusBarComp = figma.getNodeById(\"48:43\");\n  const homeIndicatorComp = figma.getNodeById(\"48:54\");\n\n  // Load Icons from Page 1:4\n  const iconHome = figma.getNodeById(\"5:91\");\n  const iconProduct = figma.getNodeById(\"5:95\");\n  const iconTransaction = figma.getNodeById(\"5:99\");\n  const iconAccount = figma.getNodeById(\"5:103\");\n  const iconMenu = figma.getNodeById(\"5:107\");\n  const iconNotification = figma.getNodeById(\"5:111\");\n  const iconBack = figma.getNodeById(\"5:115\");\n  const iconChevron = figma.getNodeById(\"5:119\");\n  const iconClose = figma.getNodeById(\"5:123\");\n\n  function addShell(frame) {\n    if (statusBarComp) {\n      const sb = statusBarComp.clone();\n      sb.x = 0;\n      sb.y = 0;\n      frame.appendChild(sb);\n    }\n    if (homeIndicatorComp) {\n      const hi = homeIndicatorComp.clone();\n      hi.x = 0;\n      hi.y = 932 - hi.height;\n      frame.appendChild(hi);\n    }\n  }\n\n  // Recolor helper for cloned vectors\n  function recolorNode(node, color) {\n    if (node.type === \"VECTOR\" || node.type === \"BOOLEAN_OPERATION\") {\n      node.fills = [{ type: \"SOLID\", color: color }];\n    }\n    if (\"children\" in node) {\n      for (const child of node.children) {\n        recolorNode(child, color);\n      }\n    }\n  }\n\n  // Bottom Tab Navigation Bar Helper\n  function addBottomNav(frame, activeTab) {\n    const navBar = figma.createFrame();\n    navBar.name = \"Bottom_Nav_Bar\";\n    navBar.resize(414, 84);\n    navBar.x = 0;\n    navBar.y = 848 - 14;\n    navBar.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n    navBar.effects = [{\n      type: \"DROP_SHADOW\",\n      color: { r: 0, g: 0, b: 0, a: 0.05 },\n      offset: { x: 0, y: -4 },\n      radius: 10,\n      visible: true,\n      blendMode: \"NORMAL\"\n    }];\n    frame.appendChild(navBar);\n\n    const tabs = [\n      { name: \"Home\", icon: iconHome, label: \"Home\" },\n      { name: \"Product\", icon: iconProduct, label: \"Product\" },\n      { name: \"Transaction\", icon: iconTransaction, label: \"Transaction\" },\n      { name: \"Account\", icon: iconAccount, label: \"Profile\" }\n    ];\n\n    tabs.forEach((tab, index) => {\n      const tabGroup = figma.createFrame();\n      tabGroup.name = \"Tab_\" + tab.name;\n      tabGroup.resize(90, 70);\n      tabGroup.x = 24 + index * 90;\n      tabGroup.y = 0;\n      tabGroup.fills = [];\n      navBar.appendChild(tabGroup);\n\n      const isActive = tab.name === activeTab;\n      const color = isActive ? primaryColor : textGreyColor;\n\n      if (tab.icon) {\n        const iconClone = tab.icon.clone();\n        iconClone.x = 33;\n        iconClone.y = 12;\n        recolorNode(iconClone, color);\n        tabGroup.appendChild(iconClone);\n      }\n\n      const lbl = figma.createText();\n      lbl.fontName = { family: \"Inter\", style: \"Medium\" };\n      lbl.fontSize = 11;\n      lbl.characters = tab.label;\n      lbl.fills = [{ type: \"SOLID\", color: color }];\n      lbl.textAlignHorizontal = \"CENTER\";\n      lbl.resize(90, 16);\n      lbl.x = 0;\n      lbl.y = 42;\n      tabGroup.appendChild(lbl);\n    });\n  }\n\n  // Helper to draw a coin\n  function drawCoin(parent, x, y, name, textSymbol, faceColor, textColor) {\n    const coinFrame = figma.createFrame();\n    coinFrame.name = name + \"_Coin\";\n    coinFrame.resize(48, 48);\n    coinFrame.x = x;\n    coinFrame.y = y;\n    coinFrame.cornerRadius = 24;\n    coinFrame.fills = [{ type: \"SOLID\", color: faceColor }];\n    parent.appendChild(coinFrame);\n\n    const coinInner = figma.createEllipse();\n    coinInner.resize(38, 38);\n    coinInner.x = 5;\n    coinInner.y = 5;\n    coinInner.fills = [];\n    coinInner.strokes = [{ type: \"SOLID\", color: textColor }];\n    coinInner.strokeWeight = 1.5;\n    coinFrame.appendChild(coinInner);\n\n    const coinTxt = figma.createText();\n    coinTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n    coinTxt.fontSize = 18;\n    coinTxt.characters = textSymbol;\n    coinTxt.fills = [{ type: \"SOLID\", color: textColor }];\n    coinTxt.textAlignHorizontal = \"CENTER\";\n    coinTxt.textAlignVertical = \"CENTER\";\n    coinTxt.resize(48, 48);\n    coinTxt.x = 0;\n    coinTxt.y = 0;\n    coinFrame.appendChild(coinTxt);\n  }\n\n\n  // ----------------------------------------------------\n  // 04_Home\n  // ----------------------------------------------------\n  const home = figma.createFrame();\n  home.name = \"04_Home\";\n  home.resize(414, 932);\n  home.x = 0;\n  home.y = 1100;\n  home.fills = [{ type: \"SOLID\", color: bgGreyColor }];\n  workspacePage.appendChild(home);\n  addShell(home);\n\n  // Home Header (Menu and Notification)\n  const homeHeader = figma.createFrame();\n  homeHeader.name = \"Header_Bar\";\n  homeHeader.resize(414, 60);\n  homeHeader.x = 0;\n  homeHeader.y = 54;\n  homeHeader.fills = [];\n  home.appendChild(homeHeader);\n\n  if (iconMenu) {\n    const menuClone = iconMenu.clone();\n    menuClone.x = 24;\n    menuClone.y = 18;\n    recolorNode(menuClone, textDarkColor);\n    homeHeader.appendChild(menuClone);\n  }\n\n  if (iconNotification) {\n    const notClone = iconNotification.clone();\n    notClone.x = 358;\n    notClone.y = 18;\n    recolorNode(notClone, textDarkColor);\n    homeHeader.appendChild(notClone);\n  }\n\n  // Greeting\n  const greetText = figma.createText();\n  greetText.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  greetText.fontSize = 32;\n  greetText.characters = \"Welcome, Jonas.\";\n  greetText.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  greetText.x = 24;\n  greetText.y = 120;\n  home.appendChild(greetText);\n\n  // Portfolio Card\n  const portCard = figma.createFrame();\n  portCard.name = \"Portfolio_Card\";\n  portCard.resize(366, 145);\n  portCard.x = 24;\n  portCard.y = 176;\n  portCard.cornerRadius = 20;\n  portCard.fills = [{\n    type: \"GRADIENT_LINEAR\",\n    gradientTransform: [[1, 0, 0], [0, 1, 0]],\n    gradientStops: [\n      { position: 0, color: { r: 49/255, g: 160/255, b: 98/255, a: 1 } },\n      { position: 1, color: { r: 34/255, g: 112/255, b: 69/255, a: 1 } }\n    ]\n  }];\n  home.appendChild(portCard);\n\n  const portLbl = figma.createText();\n  portLbl.fontName = { family: \"Inter\", style: \"Medium\" };\n  portLbl.fontSize = 14;\n  portLbl.characters = \"Your total asset portfolio\";\n  portLbl.fills = [{ type: \"SOLID\", color: { r: 220/255, g: 245/255, b: 230/255 } }];\n  portLbl.x = 24;\n  portLbl.y = 24;\n  portCard.appendChild(portLbl);\n\n  const portAmt = figma.createText();\n  portAmt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  portAmt.fontSize = 32;\n  portAmt.characters = \"₦203,935\";\n  portAmt.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  portAmt.x = 24;\n  portAmt.y = 48;\n  portCard.appendChild(portAmt);\n\n  const portChgGroup = figma.createFrame();\n  portChgGroup.name = \"Change_Indicator\";\n  portChgGroup.resize(80, 28);\n  portChgGroup.x = 24;\n  portChgGroup.y = 96;\n  portChgGroup.cornerRadius = 14;\n  portChgGroup.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1, a: 0.15 } }];\n  portCard.appendChild(portChgGroup);\n\n  const upvoteClone = figma.getNodeById(\"5:135\").clone();\n  upvoteClone.x = 8;\n  upvoteClone.y = 6;\n  recolorNode(upvoteClone, { r: 1, g: 1, b: 1 });\n  portChgGroup.appendChild(upvoteClone);\n\n  const portChgTxt = figma.createText();\n  portChgTxt.fontName = { family: \"Inter\", style: \"Bold\" };\n  portChgTxt.fontSize = 13;\n  portChgTxt.characters = \"+2%\";\n  portChgTxt.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  portChgTxt.x = 28;\n  portChgTxt.y = 6;\n  portChgGroup.appendChild(portChgTxt);\n\n  // \"Invest now\" button in the portfolio card\n  const investBtn = figma.createFrame();\n  investBtn.name = \"Button_Invest_Now\";\n  investBtn.resize(110, 42);\n  investBtn.x = 232;\n  investBtn.y = 78;\n  investBtn.cornerRadius = 12;\n  investBtn.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  portCard.appendChild(investBtn);\n\n  const investBtnTxt = figma.createText();\n  investBtnTxt.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n  investBtnTxt.fontSize = 14;\n  investBtnTxt.characters = \"Invest now\";\n  investBtnTxt.fills = [{ type: \"SOLID\", color: primaryColor }];\n  investBtnTxt.textAlignHorizontal = \"CENTER\";\n  investBtnTxt.textAlignVertical = \"CENTER\";\n  investBtnTxt.resize(110, 42);\n  investBtnTxt.x = 0;\n  investBtnTxt.y = 0;\n  investBtn.appendChild(investBtnTxt);\n\n  // PLANS SECTION\n  const plansHeader = figma.createFrame();\n  plansHeader.name = \"Plans_Header\";\n  plansHeader.resize(366, 30);\n  plansHeader.x = 24;\n  plansHeader.y = 345;\n  plansHeader.fills = [];\n  home.appendChild(plansHeader);\n\n  const plansTitle = figma.createText();\n  plansTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  plansTitle.fontSize = 20;\n  plansTitle.characters = \"Best Plans\";\n  plansTitle.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  plansTitle.x = 0;\n  plansTitle.y = 0;\n  plansHeader.appendChild(plansTitle);\n\n  const seeAllPlans = figma.createText();\n  seeAllPlans.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n  seeAllPlans.fontSize = 14;\n  seeAllPlans.characters = \"See All\";\n  seeAllPlans.fills = [{ type: \"SOLID\", color: primaryColor }];\n  seeAllPlans.x = 310;\n  seeAllPlans.y = 4;\n  plansHeader.appendChild(seeAllPlans);\n\n  // Horizontal Scrolling Plans\n  function createPlanCard(x, y, name, returnVal, bgStyle, coinSymbol, coinBg, coinColor) {\n    const card = figma.createFrame();\n    card.name = \"Plan_\" + name;\n    card.resize(140, 170);\n    card.x = x;\n    card.y = y;\n    card.cornerRadius = 18;\n    card.fills = [{ type: \"SOLID\", color: bgStyle }];\n    card.effects = [{\n      type: \"DROP_SHADOW\",\n      color: { r: 0, g: 0, b: 0, a: 0.04 },\n      offset: { x: 0, y: 4 },\n      radius: 8,\n      visible: true,\n      blendMode: \"NORMAL\"\n    }];\n    home.appendChild(card);\n\n    drawCoin(card, 16, 20, name, coinSymbol, coinBg, coinColor);\n\n    const planNameTxt = figma.createText();\n    planNameTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n    planNameTxt.fontSize = 16;\n    planNameTxt.characters = name;\n    planNameTxt.fills = [{ type: \"SOLID\", color: textDarkColor }];\n    planNameTxt.x = 16;\n    planNameTxt.y = 80;\n    card.appendChild(planNameTxt);\n\n    const retLbl = figma.createText();\n    retLbl.fontName = { family: \"Inter\", style: \"Medium\" };\n    retLbl.fontSize = 12;\n    retLbl.characters = \"Return\";\n    retLbl.fills = [{ type: \"SOLID\", color: textGreyColor }];\n    retLbl.x = 16;\n    retLbl.y = 110;\n    card.appendChild(retLbl);\n\n    const retValTxt = figma.createText();\n    retValTxt.fontName = { family: \"Inter\", style: \"Bold\" };\n    retValTxt.fontSize = 14;\n    retValTxt.characters = returnVal + \" return\";\n    retValTxt.fills = [{ type: \"SOLID\", color: primaryColor }];\n    retValTxt.x = 16;\n    retValTxt.y = 128;\n    card.appendChild(retValTxt);\n  }\n\n  createPlanCard(24, 390, \"Gold\", \"30%\", { r: 255/255, g: 249/255, b: 235/255 }, \"G\", { r: 254/255, g: 236/255, b: 198/255 }, { r: 217/255, g: 151/255, b: 17/255 });\n  createPlanCard(178, 390, \"Silver\", \"60%\", { r: 245/255, g: 247/255, b: 248/255 }, \"S\", { r: 228/255, g: 233/255, b: 236/255 }, { r: 120/255, g: 135/255, b: 145/255 });\n  createPlanCard(332, 390, \"Platinum\", \"90%\", { r: 240/255, g: 248/255, b: 243/255 }, \"P\", { r: 210/255, g: 238/255, b: 220/255 }, { r: 40/255, g: 150/255, b: 85/255 });\n\n  // ARTICLES SECTION\n  const guideTitle = figma.createText();\n  guideTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  guideTitle.fontSize = 20;\n  guideTitle.characters = \"Investment Guide\";\n  guideTitle.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  guideTitle.x = 24;\n  guideTitle.y = 585;\n  home.appendChild(guideTitle);\n\n  function createArticleRow(y, title, summary, hasPhoto, photoColor) {\n    const artRow = figma.createFrame();\n    artRow.name = \"Article_Row\";\n    artRow.resize(366, 74);\n    artRow.x = 24;\n    artRow.y = y;\n    artRow.fills = [];\n    home.appendChild(artRow);\n\n    const infoCol = figma.createFrame();\n    infoCol.name = \"Info_Column\";\n    infoCol.resize(270, 74);\n    infoCol.x = 0;\n    infoCol.y = 0;\n    infoCol.fills = [];\n    artRow.appendChild(infoCol);\n\n    const artTitle = figma.createText();\n    artTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n    artTitle.fontSize = 15;\n    artTitle.characters = title;\n    artTitle.fills = [{ type: \"SOLID\", color: textDarkColor }];\n    artTitle.x = 0;\n    artTitle.y = 0;\n    infoCol.appendChild(artTitle);\n\n    const artSum = figma.createText();\n    artSum.fontName = { family: \"Inter\", style: \"Regular\" };\n    artSum.fontSize = 12;\n    artSum.lineHeight = { value: 16, unit: \"PIXELS\" };\n    artSum.characters = summary;\n    artSum.fills = [{ type: \"SOLID\", color: textGreyColor }];\n    artSum.resize(270, 36);\n    artSum.x = 0;\n    artSum.y = 22;\n    infoCol.appendChild(artSum);\n\n    const thumb = figma.createFrame();\n    thumb.name = \"Thumbnail\";\n    thumb.resize(80, 64);\n    thumb.x = 286;\n    thumb.y = 0;\n    thumb.cornerRadius = 12;\n    thumb.fills = [{ type: \"SOLID\", color: photoColor }];\n    artRow.appendChild(thumb);\n\n    if (hasPhoto) {\n      const p1 = figma.createEllipse();\n      p1.resize(30, 30);\n      p1.x = 15;\n      p1.y = 15;\n      p1.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1, a: 0.25 } }];\n      thumb.appendChild(p1);\n    }\n\n    const div = figma.createLine();\n    div.resize(366, 0);\n    div.x = 24;\n    div.y = y + 80;\n    div.strokes = [{ type: \"SOLID\", color: dividerColor }];\n    div.strokeWeight = 1;\n    home.appendChild(div);\n  }\n\n  createArticleRow(625, \"Basic type of investments\", \"This is how you set your foot for the 2020 stock market recession. What's next…\", true, { r: 254/255, g: 236/255, b: 198/255 });\n  createArticleRow(715, \"How much can you start with?\", \"What do you like to see? It's a very different market from 2018. The way…\", true, { r: 210/255, g: 238/255, b: 220/255 });\n  createArticleRow(805, \"Welcome to New NASDAQ\", \"When we talk about Wall Street, what looks good might be different…\", false, { r: 240/255, g: 240/255, b: 240/255 });\n\n  addBottomNav(home, \"Home\");\n\n\n  // ----------------------------------------------------\n  // 05_My_Asset_Overlay\n  // ----------------------------------------------------\n  const assetOverlay = figma.createFrame();\n  assetOverlay.name = \"05_My_Asset_Overlay\";\n  assetOverlay.resize(414, 932);\n  assetOverlay.x = 500;\n  assetOverlay.y = 1100;\n  assetOverlay.fills = [{ type: \"SOLID\", color: bgGreyColor }];\n  workspacePage.appendChild(assetOverlay);\n  addShell(assetOverlay);\n\n  const backgroundGroup = figma.createFrame();\n  backgroundGroup.name = \"Home_Background_Snapshot\";\n  backgroundGroup.resize(414, 932);\n  backgroundGroup.x = 0;\n  backgroundGroup.y = 0;\n  backgroundGroup.fills = [];\n  assetOverlay.appendChild(backgroundGroup);\n\n  for (const child of home.children) {\n    if (child.name !== \"Status Bar\" && child.name !== \"Home Indicator\") {\n      backgroundGroup.appendChild(child.clone());\n    }\n  }\n\n  const dimLayer = figma.createRectangle();\n  dimLayer.name = \"Dim_Layer\";\n  dimLayer.resize(414, 932);\n  dimLayer.x = 0;\n  dimLayer.y = 0;\n  dimLayer.fills = [{ type: \"SOLID\", color: { r: 0, g: 0, b: 0 }, opacity: 0.4 }];\n  assetOverlay.appendChild(dimLayer);\n\n  const sheet = figma.createFrame();\n  sheet.name = \"Bottom_Sheet_Card\";\n  sheet.resize(414, 692);\n  sheet.x = 0;\n  sheet.y = 240;\n  sheet.cornerRadius = 32;\n  sheet.topLeftRadius = 32;\n  sheet.topRightRadius = 32;\n  sheet.bottomLeftRadius = 0;\n  sheet.bottomRightRadius = 0;\n  sheet.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  assetOverlay.appendChild(sheet);\n\n  const bar = figma.createFrame();\n  bar.name = \"Handlebar\";\n  bar.resize(40, 5);\n  bar.x = 187;\n  bar.y = 12;\n  bar.cornerRadius = 2.5;\n  bar.fills = [{ type: \"SOLID\", color: { r: 210/255, g: 210/255, b: 210/255 } }];\n  sheet.appendChild(bar);\n\n  const sheetTitle = figma.createText();\n  sheetTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  sheetTitle.fontSize = 24;\n  sheetTitle.characters = \"My Asset\";\n  sheetTitle.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  sheetTitle.x = 30;\n  sheetTitle.y = 36;\n  sheet.appendChild(sheetTitle);\n\n  if (iconClose) {\n    const closeBtn = iconClose.clone();\n    closeBtn.x = 346;\n    closeBtn.y = 30;\n    recolorNode(closeBtn, textDarkColor);\n    sheet.appendChild(closeBtn);\n  }\n\n  const assetPort = figma.createFrame();\n  assetPort.name = \"Portfolio_Small_Card\";\n  assetPort.resize(354, 96);\n  assetPort.x = 30;\n  assetPort.y = 86;\n  assetPort.cornerRadius = 16;\n  assetPort.fills = [{ type: \"SOLID\", color: bgGreyColor }];\n  sheet.appendChild(assetPort);\n\n  const apLbl = figma.createText();\n  apLbl.fontName = { family: \"Inter\", style: \"Medium\" };\n  apLbl.fontSize = 12;\n  apLbl.characters = \"Your total asset portfolio\";\n  apLbl.fills = [{ type: \"SOLID\", color: textGreyColor }];\n  apLbl.x = 20;\n  apLbl.y = 18;\n  assetPort.appendChild(apLbl);\n\n  const apAmtTxt = figma.createText();\n  apAmtTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  apAmtTxt.fontSize = 26;\n  apAmtTxt.characters = \"₦203,935\";\n  apAmtTxt.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  apAmtTxt.x = 20;\n  apAmtTxt.y = 38;\n  assetPort.appendChild(apAmtTxt);\n\n  const apChgTxt = figma.createText();\n  apChgTxt.fontName = { family: \"Inter\", style: \"Bold\" };\n  apChgTxt.fontSize = 14;\n  apChgTxt.characters = \"+2%\";\n  apChgTxt.fills = [{ type: \"SOLID\", color: primaryColor }];\n  apChgTxt.x = 290;\n  apChgTxt.y = 40;\n  assetPort.appendChild(apChgTxt);\n\n  const cpTitle = figma.createText();\n  cpTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  cpTitle.fontSize = 18;\n  cpTitle.characters = \"Current Plans\";\n  cpTitle.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  cpTitle.x = 30;\n  cpTitle.y = 202;\n  sheet.appendChild(cpTitle);\n\n  const seeAllP = figma.createText();\n  seeAllP.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n  seeAllP.fontSize = 13;\n  seeAllP.characters = \"See All Plans\";\n  seeAllP.fills = [{ type: \"SOLID\", color: primaryColor }];\n  seeAllP.x = 292;\n  seeAllP.y = 205;\n  sheet.appendChild(seeAllP);\n\n  const goldRow = figma.createFrame();\n  goldRow.name = \"Current_Plan_Gold\";\n  goldRow.resize(354, 76);\n  goldRow.x = 30;\n  goldRow.y = 234;\n  goldRow.cornerRadius = 16;\n  goldRow.fills = [{ type: \"SOLID\", color: { r: 255/255, g: 249/255, b: 235/255 } }];\n  sheet.appendChild(goldRow);\n\n  drawCoin(goldRow, 16, 14, \"Gold_Small\", \"G\", { r: 254/255, g: 236/255, b: 198/255 }, { r: 217/255, g: 151/255, b: 17/255 });\n\n  const goldRowName = figma.createText();\n  goldRowName.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  goldRowName.fontSize = 16;\n  goldRowName.characters = \"Gold\";\n  goldRowName.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  goldRowName.x = 76;\n  goldRowName.y = 16;\n  goldRow.appendChild(goldRowName);\n\n  const goldRowRet = figma.createText();\n  goldRowRet.fontName = { family: \"Inter\", style: \"Medium\" };\n  goldRowRet.fontSize = 13;\n  goldRowRet.characters = \"30% return\";\n  goldRowRet.fills = [{ type: \"SOLID\", color: primaryColor }];\n  goldRowRet.x = 76;\n  goldRowRet.y = 40;\n  goldRow.appendChild(goldRowRet);\n\n  const chevClone = iconChevron ? iconChevron.clone() : null;\n  if (chevClone) {\n    chevClone.x = 314;\n    chevClone.y = 30;\n    chevClone.rotation = -90;\n    chevClone.x = 314;\n    chevClone.y = 44;\n    recolorNode(chevClone, textGreyColor);\n    goldRow.appendChild(chevClone);\n  }\n\n  const histTitle = figma.createText();\n  histTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  histTitle.fontSize = 18;\n  histTitle.characters = \"History\";\n  histTitle.fills = [{ type: \"SOLID\", color: textDarkColor }];\n  histTitle.x = 30;\n  histTitle.y = 334;\n  sheet.appendChild(histTitle);\n\n  function createHistoryItem(y, type, stock, amtText, isInflow) {\n    const item = figma.createFrame();\n    item.name = \"History_Item_\" + type + \"_\" + stock;\n    item.resize(354, 56);\n    item.x = 30;\n    item.y = y;\n    item.fills = [];\n    sheet.appendChild(item);\n\n    const title = figma.createText();\n    title.fontName = { family: \"DM Sans\", style: \"Bold\" };\n    title.fontSize = 15;\n    title.characters = type + \" \" + \"'\" + stock + \"' Stock\";\n    title.fills = [{ type: \"SOLID\", color: textDarkColor }];\n    title.x = 0;\n    title.y = 6;\n    item.appendChild(title);\n\n    const date = figma.createText();\n    date.fontName = { family: \"Inter\", style: \"Regular\" };\n    date.fontSize = 12;\n    date.characters = \"Mon 22 Jun 2020\";\n    date.fills = [{ type: \"SOLID\", color: textGreyColor }];\n    date.x = 0;\n    date.y = 28;\n    item.appendChild(date);\n\n    const amt = figma.createText();\n    amt.fontName = { family: \"Inter\", style: \"Bold\" };\n    amt.fontSize = 15;\n    amt.characters = (isInflow ? \"+\" : \"-\") + amtText;\n    amt.fills = [{ type: \"SOLID\", color: isInflow ? primaryColor : textDarkC