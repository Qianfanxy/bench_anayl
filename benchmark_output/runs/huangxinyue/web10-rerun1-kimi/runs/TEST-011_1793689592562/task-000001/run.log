abs section =====\nconst tabsWrap = figma.createFrame();\ntabsWrap.name = 'Tabs';\ntabsWrap.fills = [];\ntabsWrap.layoutMode = 'VERTICAL';\ntabsWrap.primaryAxisSizingMode = 'AUTO';\ntabsWrap.counterAxisSizingMode = 'FIXED';\ntabsWrap.layoutAlign = 'STRETCH';\n\nconst tabsRow = figma.createFrame();\ntabsRow.fills = [];\ntabsRow.layoutMode = 'HORIZONTAL';\ntabsRow.primaryAxisSizingMode = 'FIXED';\ntabsRow.counterAxisSizingMode = 'AUTO';\ntabsRow.counterAxisAlignItems = 'CENTER';\ntabsRow.layoutAlign = 'STRETCH';\nconst tabs = [\n  { label: 'Product Details', active: false },\n  { label: 'Rating & Reviews', active: true },\n  { label: 'FAQs', active: false },\n];\nfor (const t of tabs) {\n  const tab = figma.createFrame();\n  tab.name = 'Tab / ' + t.label;\n  tab.fills = [];\n  tab.layoutMode = 'VERTICAL';\n  tab.primaryAxisSizingMode = 'AUTO';\n  tab.counterAxisSizingMode = 'FIXED';\n  tab.primaryAxisAlignItems = 'CENTER';\n  tab.counterAxisAlignItems = 'CENTER';\n  tab.itemSpacing = 8;\n  tab.layoutGrow = 1;\n  tab.paddingBottom = 12;\n  const lt = H.text(t.label, 20, t.active ? 'Medium' : 'Regular', '#000000', 'Plus Jakarta Sans', t.active ? 1 : 0.6);\n  tab.appendChild(lt);\n  if (t.active) {\n    const ind = figma.createRectangle();\n    ind.resize(200, 2);\n    ind.fills = H.solid('#000000');\n    ind.layoutAlign = 'STRETCH';\n    tab.appendChild(ind);\n  }\n  tabsRow.appendChild(tab);\n}\ntabsWrap.appendChild(tabsRow);\nconst tabsDiv = figma.createRectangle();\ntabsDiv.resize(1240, 1);\ntabsDiv.fills = H.rgba('#000000', 0.1);\ntabsDiv.layoutAlign = 'STRETCH';\ntabsWrap.appendChild(tabsDiv);\n\n// ===== Reviews section =====\nconst reviewSec = figma.createFrame();\nreviewSec.name = 'Reviews';\nreviewSec.fills = [];\nreviewSec.layoutMode = 'VERTICAL';\nreviewSec.primaryAxisSizingMode = 'AUTO';\nreviewSec.counterAxisSizingMode = 'FIXED';\nreviewSec.paddingLeft = 100; reviewSec.paddingRight = 100;\nreviewSec.paddingTop = 32; reviewSec.paddingBottom = 32;\nreviewSec.itemSpacing = 24;\nreviewSec.layoutAlign = 'STRETCH';\n\nreviewSec.appendChild(tabsWrap);\n\n// Reviews header\nconst rHead = figma.createFrame();\nrHead.name = 'Header';\nrHead.fills = [];\nrHead.layoutMode = 'HORIZONTAL';\nrHead.primaryAxisSizingMode = 'FIXED';\nrHead.counterAxisSizingMode = 'AUTO';\nrHead.primaryAxisAlignItems = 'SPACE_BETWEEN';\nrHead.counterAxisAlignItems = 'CENTER';\nrHead.layoutAlign = 'STRETCH';\n\nconst rLeft = figma.createFrame();\nrLeft.fills = [];\nrLeft.layoutMode = 'HORIZONTAL';\nrLeft.itemSpacing = 8;\nrLeft.counterAxisAlignItems = 'BASELINE';\nrLeft.counterAxisSizingMode = 'AUTO';\nrLeft.primaryAxisSizingMode = 'AUTO';\nrLeft.appendChild(H.text('All Reviews', 24, 'Bold', '#000000'));\nrLeft.appendChild(H.text('(451)', 16, 'Regular', '#000000', 'Plus Jakarta Sans', 0.6));\nrHead.appendChild(rLeft);\n\nconst rRight = figma.createFrame();\nrRight.fills = [];\nrRight.layoutMode = 'HORIZONTAL';\nrRight.itemSpacing = 10;\nrRight.counterAxisAlignItems = 'CENTER';\nrRight.counterAxisSizingMode = 'AUTO';\nrRight.primaryAxisSizingMode = 'AUTO';\n\n// Filter button (icon only)\nconst filterBtn = figma.createFrame();\nfilterBtn.name = 'Button / Filter';\nfilterBtn.resize(48, 48);\nfilterBtn.cornerRadius = 24;\nfilterBtn.fills = H.solid('#F0F0F0');\nfilterBtn.layoutMode = 'HORIZONTAL';\nfilterBtn.primaryAxisAlignItems = 'CENTER';\nfilterBtn.counterAxisAlignItems = 'CENTER';\nfilterBtn.primaryAxisSizingMode = 'FIXED';\nfilterBtn.counterAxisSizingMode = 'FIXED';\nconst fi = filterIcon.createInstance();\nfi.resize(24, 24);\nfilterBtn.appendChild(fi);\nrRight.appendChild(filterBtn);\n\n// Sort dropdown\nconst sortBtn = figma.createFrame();\nsortBtn.name = 'Sort';\nsortBtn.layoutMode = 'HORIZONTAL';\nsortBtn.paddingLeft = 20; sortBtn.paddingRight = 20;\nsortBtn.paddingTop = 12; sortBtn.paddingBottom = 12;\nsortBtn.itemSpacing = 8;\nsortBtn.counterAxisSizingMode = 'AUTO';\nsortBtn.primaryAxisSizingMode = 'AUTO';\nsortBtn.counterAxisAlignItems = 'CENTER';\nsortBtn.cornerRadius = 62;\nsortBtn.fills = H.solid('#F0F0F0');\nsortBtn.appendChild(H.text('Latest', 16, 'Medium', '#000000'));\nconst sortChev = chevronDown.createInstance();\nsortChev.resize(16, 16);\nsortBtn.appendChild(sortChev);\nrRight.appendChild(sortBtn);\n\n// Write a Review button\nconst writeBtn = buttonComp.createInstance();\nwriteBtn.name = 'Button / Write a Review';\nwriteBtn.counterAxisAlignItems = 'CENTER';\nwriteBtn.primaryAxisAlignItems = 'CENTER';\nconst wTxt = writeBtn.findOne(n => n.type === 'TEXT');\nwTxt.characters = 'Write a Review';\nwTxt.fills = H.solid('#FFFFFF');\nrRight.appendChild(writeBtn);\n\nrHead.appendChild(rRight);\nreviewSec.appendChild(rHead);\n\n// Reviews grid (2 columns)\nconst reviewsGrid = figma.createFrame();\nreviewsGrid.name = 'Reviews Grid';\nreviewsGrid.fills = [];\nreviewsGrid.layoutMode = 'HORIZONTAL';\nreviewsGrid.layoutWrap = 'WRAP';\nreviewsGrid.itemSpacing = 20;\nreviewsGrid.counterAxisSpacing = 20;\nreviewsGrid.primaryAxisSizingMode = 'FIXED';\nreviewsGrid.counterAxisSizingMode = 'AUTO';\nreviewsGrid.resize(1240, 100);\nreviewsGrid.layoutAlign = 'STRETCH';\n\nconst reviewData = [\n  { name: 'Samantha D.', rating: 4.5, text: \"I absolutely love this t-shirt! The design is unique and the fabric feels so comfortable. As a fellow designer, I appreciate the attention to detail. It's become my favorite go-to shirt.\", date: 'Posted on August 14, 2023' },\n  { name: 'Alex M.', rating: 4, text: \"The t-shirt exceeded my expectations! The colors are vibrant and the print quality is top-notch. Being a UI/UX designer myself, I'm quite picky about aesthetics, and this t-shirt definitely gets a thumbs up from me.\", date: 'Posted on August 15, 2023' },\n  { name: 'Ethan R.', rating: 3.5, text: \"This t-shirt is a must-have for anyone who appreciates good design. The minimalistic yet stylish pattern caught my eye, and the fit is perfect. I can see the designer's touch in every aspect of this shirt.\", date: 'Posted on August 16, 2023' },\n  { name: 'Olivia P.', rating: 4, text: \"As a UI/UX enthusiast, I value simplicity and functionality. This t-shirt not only represents those principles but also feels great to wear. It's evident that the designer poured their creativity into making this t-shirt stand out.\", date: 'Posted on August 17, 2023' },\n  { name: 'Liam K.', rating: 4, text: \"This t-shirt is a fusion of comfort and creativity. The fabric is soft, and the design speaks volumes about the designer's skill. It's like wearing a piece of art that reflects my passion for both design and fashion.\", date: 'Posted on August 18, 2023' },\n  { name: 'Ava H.', rating: 4.5, text: \"I'm not just wearing a t-shirt; I'm wearing a piece of design philosophy. The intricate details and thoughtful layout of the design make this shirt a conversation starter.\", date: 'Posted on August 19, 2023' },\n];\n\nfunction reviewCard(r) {\n  const card = figma.createFrame();\n  card.name = 'Review / ' + r.name;\n  card.layoutMode = 'VERTICAL';\n  card.paddingLeft = 32; card.paddingRight = 32; card.paddingTop = 28; card.paddingBottom = 28;\n  card.itemSpacing = 12;\n  card.cornerRadius = 20;\n  card.fills = H.solid('#FFFFFF');\n  card.strokes = H.rgba('#000000', 0.1);\n  card.strokeWeight = 1;\n  card.counterAxisSizingMode = 'FIXED';\n  card.primaryAxisSizingMode = 'AUTO';\n  card.resize(610, 100);\n\n  const top = figma.createFrame();\n  top.fills = [];\n  top.layoutMode = 'HORIZONTAL';\n  top.primaryAxisSizingMode = 'FIXED';\n  top.counterAxisSizingMode = 'AUTO';\n  top.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  top.counterAxisAlignItems = 'CENTER';\n  top.layoutAlign = 'STRETCH';\n  \n  const stars = figma.createFrame();\n  stars.fills = [];\n  stars.layoutMode = 'HORIZONTAL';\n  stars.itemSpacing = 5;\n  stars.counterAxisSizingMode = 'AUTO';\n  stars.primaryAxisSizingMode = 'AUTO';\n  const full = Math.floor(r.rating);\n  const hasHalf = (r.rating % 1) >= 0.25;\n  for (let i = 0; i < full; i++) {\n    const s = starIcon.createInstance();\n    s.fills = H.solid('#FFC633');\n    s.resize(22.6, 22.6);\n    stars.appendChild(s);\n  }\n  if (hasHalf) {\n    const s = starHalfIcon.createInstance();\n    s.fills = H.solid('#FFC633');\n    s.resize(11.3, 22.6);\n    stars.appendChild(s);\n  }\n  top.appendChild(stars);\n  const more = moreIcon.createInstance();\n  more.resize(24, 24);\n  top.appendChild(more);\n  card.appendChild(top);\n\n  const nameRow = figma.createFrame();\n  nameRow.fills = [];\n  nameRow.layoutMode = 'HORIZONTAL';\n  nameRow.itemSpacing = 8;\n  nameRow.counterAxisAlignItems = 'CENTER';\n  nameRow.counterAxisSizingMode = 'AUTO';\n  nameRow.primaryAxisSizingMode = 'AUTO';\n  nameRow.appendChild(H.text(r.name, 20, 'Bold', '#000000'));\n  const vi = verifiedIcon.createInstance();\n  vi.resize(24, 24);\n  nameRow.appendChild(vi);\n  card.appendChild(nameRow);\n\n  const quote = H.text('\"' + r.text + '\"', 16, 'Regular', '#000000', 'Plus Jakarta Sans', 0.6);\n  quote.layoutAlign = 'STRETCH';\n  quote.textAutoResize = 'HEIGHT';\n  quote.lineHeight = { value: 22, unit: 'PIXELS' };\n  card.appendChild(quote);\n\n  card.appendChild(H.text(r.date, 16, 'Medium', '#000000', 'Plus Jakarta Sans', 0.6));\n  return card;\n}\n\nfor (const r of reviewData) {\n  reviewsGrid.appendChild(reviewCard(r));\n}\nreviewSec.appendChild(reviewsGrid);\n\n// Load More button\nconst loadBtn = figma.createFrame();\nloadBtn.name = 'Button / Load More Reviews';\nloadBtn.layoutMode = 'HORIZONTAL';\nloadBtn.paddingLeft = 40; loadBtn.paddingRight = 40; loadBtn.paddingTop = 16; loadBtn.paddingBottom = 16;\nloadBtn.counterAxisSizingMode = 'AUTO';\nloadBtn.primaryAxisSizingMode = 'AUTO';\nloadBtn.counterAxisAlignItems = 'CENTER';\nloadBtn.primaryAxisAlignItems = 'CENTER';\nloadBtn.cornerRadius = 62;\nloadBtn.fills = H.solid('#FFFFFF');\nloadBtn.strokes = H.rgba('#000000', 0.1);\nloadBtn.strokeWeight = 1;\nloadBtn.appendChild(H.text('Load More Reviews', 16, 'Medium', '#000000'));\nloadBtn.layoutAlign = 'CENTER';\nreviewSec.appendChild(loadBtn);\n\nproduct.appendChild(reviewSec);\n\nreturn { reviewSecId: reviewSec.id };\n","description":"Build Tabs and Reviews section for 03_Product","fileKey":"5S6WFXEo4QEfJTtE7MFltz"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"c5b3498c-81e1-408a-9e23-797293d6b873","uuid":"93181137-068c-4e18-98c2-6fc2b38632ce","timestamp":"2026-11-03T07:37:57.413Z","tool_use_meta":[{"id":"mcp__figma__use_figma_56_c40f0df7","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
