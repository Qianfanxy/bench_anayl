neyebrow.fontSize = 13;\neyebrow.letterSpacing = { unit: 'PERCENT', value: 12 };\neyebrow.characters = 'BLOG';\neyebrow.fills = [{ type: 'SOLID', color: GRAY_500 }];\nhead.appendChild(eyebrow);\n\nconst hT = figma.createText();\nhT.fontName = { family: 'Plus Jakarta Sans', style: 'Bold' };\nhT.fontSize = 40;\nhT.lineHeight = { unit: 'PERCENT', value: 120 };\nhT.characters = 'Digital Marketing & SEO Services That Grow Traffic & Increase Revenue';\nhT.fills = [{ type: 'SOLID', color: INK }];\nhT.textAlignHorizontal = 'CENTER';\nhT.resize(880, hT.height);\nhT.textAutoResize = 'HEIGHT';\nhead.appendChild(hT);\n\nconst subT = figma.createText();\nsubT.fontName = { family: 'Plus Jakarta Sans', style: 'Regular' };\nsubT.fontSize = 16;\nsubT.lineHeight = { unit: 'PERCENT', value: 150 };\nsubT.characters = 'We are the top digital marketing agency for branding corp. We offer a full range of services to help clients improve their search engine rankings and drive more traffic to their websites.';\nsubT.fills = [{ type: 'SOLID', color: GRAY_600 }];\nsubT.textAlignHorizontal = 'CENTER';\nsubT.resize(720, subT.height);\nsubT.textAutoResize = 'HEIGHT';\nhead.appendChild(subT);\nblog.appendChild(head);\n\n// Cards row\nconst cards = figma.createFrame();\ncards.name = 'Cards';\ncards.fills = [];\ncards.layoutMode = 'HORIZONTAL';\ncards.primaryAxisSizingMode = 'AUTO';\ncards.counterAxisSizingMode = 'AUTO';\ncards.itemSpacing = 24;\n\nconst posts = [\n  {\n    title: 'How a Digital Marketing Agency Can Boost Your Business',\n    excerpt: 'We are the top digital marketing agency for branding corp. We offer a full range of services to help clients improve their search engine rankings.'\n  },\n  {\n    title: 'The Latest Trends and Strategies with a Digital Marketing Agency',\n    excerpt: 'Working with this digital marketing agency has been a true partnership. They have taken the time to understand our business and industry.'\n  },\n  {\n    title: 'Maximizing ROI with the Expertise of a Digital Marketing Agency',\n    excerpt: 'What sets this digital marketing agency apart is their commitment to transparency and collaboration. They keep us informed every step of the way.'\n  }\n];\n\nconst thumbColors = [\n  { r: 0.83, g: 0.93, b: 0.72 },\n  { r: 0.95, g: 0.88, b: 0.72 },\n  { r: 0.78, g: 0.88, b: 0.96 }\n];\n\nfor (let i = 0; i < posts.length; i++) {\n  const p = posts[i];\n  const card = figma.createFrame();\n  card.name = 'Article ' + (i + 1);\n  card.fills = [{ type: 'SOLID', color: WHITE }];\n  card.strokes = [{ type: 'SOLID', color: GRAY_200 }];\n  card.strokeWeight = 1;\n  card.cornerRadius = 24;\n  card.layoutMode = 'VERTICAL';\n  card.primaryAxisSizingMode = 'AUTO';\n  card.counterAxisSizingMode = 'AUTO';\n  card.itemSpacing = 0;\n  card.clipsContent = true;\n  card.effects = [{ type: 'DROP_SHADOW', color: { r: 0, g: 0, b: 0, a: 0.04 }, offset: { x: 0, y: 4 }, radius: 16, spread: 0, visible: true, blendMode: 'NORMAL' }];\n\n  // Thumbnail\n  const thumb = figma.createFrame();\n  thumb.name = 'Thumbnail';\n  thumb.resize(410, 240);\n  thumb.fills = [{ type: 'SOLID', color: thumbColors[i] }];\n  thumb.layoutMode = 'HORIZONTAL';\n  thumb.primaryAxisSizingMode = 'FIXED';\n  thumb.counterAxisSizingMode = 'FIXED';\n  thumb.primaryAxisAlignItems = 'CENTER';\n  thumb.counterAxisAlignItems = 'CENTER';\n  const phMark = figma.createFrame();\n  phMark.name = 'Mark';\n  phMark.fills = [];\n  phMark.layoutMode = 'HORIZONTAL';\n  phMark.primaryAxisSizingMode = 'AUTO';\n  phMark.counterAxisSizingMode = 'AUTO';\n  phMark.counterAxisAlignItems = 'MAX';\n  phMark.itemSpacing = 8;\n  const heights = [24, 40, 32];\n  for (const h of heights) {\n    const bar = figma.createRectangle();\n    bar.resize(28, h);\n    bar.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1, a: 0.6 } }];\n    bar.cornerRadius = 4;\n    phMark.appendChild(bar);\n  }\n  thumb.appendChild(phMark);\n  card.appendChild(thumb);\n\n  // Body\n  const body = figma.createFrame();\n  body.name = 'Body';\n  body.fills = [];\n  body.layoutMode = 'VERTICAL';\n  body.primaryAxisSizingMode = 'AUTO';\n  body.counterAxisSizingMode = 'AUTO';\n  body.paddingLeft = 24; body.paddingRight = 24; body.paddingTop = 24; body.paddingBottom = 24;\n  body.itemSpacing = 12;\n\n  const read = figma.createText();\n  read.fontName = { family: 'Plus Jakarta Sans', style: 'Medium' };\n  read.fontSize = 13;\n  read.characters = '5 min read';\n  read.fills = [{ type: 'SOLID', color: GRAY_500 }];\n  body.appendChild(read);\n\n  const tt = figma.createText();\n  tt.fontName = { family: 'Plus Jakarta Sans', style: 'Bold' };\n  tt.fontSize = 18;\n  tt.lineHeight = { unit: 'PERCENT', value: 130 };\n  tt.characters = p.title;\n  tt.fills = [{ type: 'SOLID', color: INK }];\n  tt.resize(362, tt.height);\n  tt.textAutoResize = 'HEIGHT';\n  body.appendChild(tt);\n\n  const ex = figma.createText();\n  ex.fontName = { family: 'Plus Jakarta Sans', style: 'Regular' };\n  ex.fontSize = 14;\n  ex.lineHeight = { unit: 'PERCENT', value: 155 };\n  ex.characters = p.excerpt;\n  ex.fills = [{ type: 'SOLID', color: GRAY_600 }];\n  ex.resize(362, ex.height);\n  ex.textAutoResize = 'HEIGHT';\n  body.appendChild(ex);\n\n  // Open link\n  const open = figma.createFrame();\n  open.name = 'Open';\n  open.fills = [];\n  open.layoutMode = 'HORIZONTAL';\n  open.primaryAxisSizingMode = 'AUTO';\n  open.counterAxisSizingMode = 'AUTO';\n  open.itemSpacing = 8;\n  open.counterAxisAlignItems = 'CENTER';\n  const oT = figma.createText();\n  oT.fontName = { family: 'Plus Jakarta Sans', style: 'SemiBold' };\n  oT.fontSize = 14;\n  oT.characters = 'Read article';\n  oT.fills = [{ type: 'SOLID', color: INK }];\n  open.appendChild(oT);\n  const ar = arrowRightSrc.createInstance();\n  ar.resize(16, 16);\n  ar.fills = [{ type: 'SOLID', color: INK }];\n  open.appendChild(ar);\n  body.appendChild(open);\n\n  card.appendChild(body);\n  cards.appendChild(card);\n}\nblog.appendChild(cards);\n\n// See more button\nconst seeMore = figma.createFrame();\nseeMore.name = 'See more';\nseeMore.fills = [{ type: 'SOLID', color: WHITE }];\nseeMore.strokes = [{ type: 'SOLID', color: INK }];\nseeMore.strokeWeight = 1.5;\nseeMore.cornerRadius = 100;\nseeMore.layoutMode = 'HORIZONTAL';\nseeMore.primaryAxisSizingMode = 'AUTO';\nseeMore.counterAxisSizingMode = 'AUTO';\nseeMore.primaryAxisAlignItems = 'CENTER';\nseeMore.counterAxisAlignItems = 'CENTER';\nseeMore.paddingLeft = 28; seeMore.paddingRight = 28; seeMore.paddingTop = 16; seeMore.paddingBottom = 16;\nseeMore.itemSpacing = 8;\nconst smT = figma.createText();\nsmT.fontName = { family: 'Plus Jakarta Sans', style: 'SemiBold' };\nsmT.fontSize = 16;\nsmT.characters = 'See more';\nsmT.fills = [{ type: 'SOLID', color: INK }];\nseeMore.appendChild(smT);\nblog.appendChild(seeMore);\n\nreturn 'blog done';","description":"Build Blog section","fileKey":"XF8voPTa6HXbD1fHTmF9r0"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"7550319e-df42-470d-836f-618f29282362","uuid":"9119f419-0e99-4eb6-8cc0-8ea0ca69983b","timestamp":"2026-11-02T02:05:23.168Z","tool_use_meta":[{"id":"mcp__figma__use_figma_27_fb1e92b4","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
