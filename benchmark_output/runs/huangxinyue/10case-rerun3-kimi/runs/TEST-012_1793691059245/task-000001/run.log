{"type":"user","message":{"role":"user","content":[{"tool_use_id":"mcp__figma__get_metadata_0_47303251","type":"tool_result","content":[{"type":"text","text":"<canvas id=\"1:2\" name=\"01 · Foundations 视觉规范\" x=\"0\" y=\"0\" width=\"0\" height=\"0\">\n  <frame id=\"1:5\" name=\"Foundations\" x=\"0\" y=\"0\" width=\"1400\" height=\"785\">\n    <text id=\"1:6\" name=\"Foundations · Meet\" x=\"56\" y=\"48\" width=\"299\" height=\"39\" />\n    <text id=\"1:7\" name=\"Fixed: the two brand colors and the typeface below — they carry Meet’s identity. Everything else is yours to define and apply consistently: neutrals and grays, text colors, backgrounds and surfaces (including any tint or gradient), overlays on photos, semantic colors (online / active, like, error, disabled), type scale, weights per role, spacing, radii, blur and elevation.\" x=\"56\" y=\"119\" width=\"1288\" height=\"57\" />\n    <text id=\"1:8\" name=\"Brand colors\" x=\"56\" y=\"208\" width=\"123\" height=\"24\" />\n    <frame id=\"1:9\" name=\"Brand colors\" x=\"56\" y=\"264\" width=\"464\" height=\"222\">\n      <frame id=\"1:10\" name=\"Brand primary · plum\" x=\"0\" y=\"0\" width=\"220\" height=\"222\">\n        <rounded-rectangle id=\"1:11\" name=\"Rectangle\" x=\"0\" y=\"0\" width=\"220\" height=\"120\" />\n        <text id=\"1:12\" name=\"Brand primary · plum\" x=\"0\" y=\"128\" width=\"141\" height=\"17\" />\n        <text id=\"1:13\" name=\"#4B164C\" x=\"0\" y=\"153\" width=\"57\" height=\"16\" />\n        <text id=\"1:14\" name=\"Meet’s main brand color (the “M” of the logo). Where and how much to use it is your decision.\" x=\"0\" y=\"177\" width=\"220\" height=\"45\" />\n      </frame>\n      <frame id=\"1:15\" name=\"Brand secondary · orchid pink\" x=\"244\" y=\"0\" width=\"220\" height=\"222\">\n        <rounded-rectangle id=\"1:16\" name=\"Rectangle\" x=\"0\" y=\"0\" width=\"220\" height=\"120\" />\n        <text id=\"1:17\" name=\"Brand secondary · orchid pink\" x=\"0\" y=\"128\" width=\"2