n t;};\nconst N=async id=>figma.getNodeByIdAsync(id);\nconst V=async(setId,name)=>(await N(setId)).children.find(c=>c.name===name);\nconst prop=(inst,pre,val)=>{const k=Object.keys(inst.componentProperties).find(k=>k.split('#')[0]===pre); inst.setProperties({[k]:val});};\nconst screen=(name,x,h=932,fill='surface/base')=>{const f=figma.createFrame(); f.name=name; f.resize(430,h); f.x=x; f.y=0; f.fills=[paint(fill)]; f.clipsContent=true; figma.currentPage.appendChild(f); return f;};\nconst shell=async(f,dark=false)=>{const sb=(await N('49:130')).createInstance(); f.appendChild(sb); sb.x=0; sb.y=0; const hi=(await N('49:141')).createInstance(); f.appendChild(hi); hi.x=0; hi.y=f.height-34; sb.fills=[]; hi.fills=[]; if(dark){[sb,hi].forEach(i=>i.findAll(n=>n.type!=='TEXT'&&'fills' in n&&n.fills.length&&n.type!=='FRAME').forEach(n=>n.fills=[paint('text/on-brand')])); sb.findAll(n=>n.type==='TEXT').forEach(t=>t.fills=[paint('text/on-brand')]);} return [sb,hi];};\nconst out={};\n\n// 01 Splash\n{const f=screen('01_Splash',0,932,'brand/red');\n const glow=figma.createEllipse(); glow.name='Glow'; glow.resize(520,520); glow.x=-45; glow.y=520; glow.fills=[{type:'GRADIENT_RADIAL',gradientTransform:[[1,0,0],[0,1,0]],gradientStops:[{position:0,color:{r:1,g:1,b:1,a:0.28}},{position:1,color:{r:1,g:1,b:1,a:0}}]}]; f.appendChild(glow);\n const wm=(await N('1:204')).createInstance(); f.appendChild(wm); wm.rescale(1.4); wm.x=(430-wm.width)/2; wm.y=300; wm.fills=[];\n const tag=await T('Burgers made your way','Body Medium','text/on-brand',{align:'CENTER',name:'Tagline'}); f.appendChild(tag); tag.opacity=0.85; tag.x=(430-tag.width)/2; tag.y=wm.y+wm.height+16;\n const src=await N('1:209'); const r=figma.createRectangle(); r.name='Splash_Burger_Stack'; r.resize(300,352); r.fills=[{type:'IMAGE',imageHash:src.fills[0].imageHash,scaleMode:'FIT'}]; f.appendChild(r); r.x=65; r.y=932-352-48;\n await shell(f,true); out.splash=f.id;}\n\n// 02 Home\n{const f=screen('02_Home',530);\n const wm=(await N('1:196')).createInstance(); f.appendChild(wm); wm.rescale(0.75); wm.x=24; wm.y=58; wm.fills=[];\n const tag=await T('Order your favourite food!','Body','text/secondary',{name:'Tagline'}); f.appendChild(tag); tag.x=24; tag.y=106;\n const av=(await N('1:214')).createInstance(); f.appendChild(av); av.rescale(56/120); av.x=350; av.y=62; av.name='Avatar';\n const sf=(await V('2007:88','State=Empty')).createInstance(); f.appendChild(sf); sf.x=24; sf.y=146; sf.name='Search';\n const fb=(await V('2007:26','Style=Brand')).createInstance(); f.appendChild(fb); fb.resize(60,60); fb.cornerRadius=20; fb.x=346; fb.y=146; fb.name='Filter'; await swapIcon(fb,'Filter','text/on-brand');\n const chips=figma.createFrame(); chips.name='Categories'; chips.layoutMode='HORIZONTAL'; chips.itemSpacing=12; chips.primaryAxisSizingMode='AUTO'; chips.counterAxisSizingMode='AUTO'; chips.fills=[]; chips.clipsContent=false; f.appendChild(chips); chips.x=24; chips.y=226;\n for(const c of ['All','Combos','Sliders','Classic']){const i=(await V('2007:33',c==='All'?'State=Selected':'State=Default')).createInstance(); prop(i,'Label',c); i.name='Chip / '+c; chips.appendChild(i);}\n const data=[['Cheeseburger','Wendy’s Burger','4.9','1:224',true],['Hamburger','Veggie Burger','4.8','1:229',false],['Hamburger','Chicken Burger','4.6','1:234',false],['Hamburger','Fried Chicken Burger','4.5','1:239',false]];\n const mc=await N('2008:304'); const favOn=await V('2007:55','Favourite=On');\n for(let k=0;k<4;k++){const [cat,nm,rt,img,fav]=data[k]; const i=mc.createInstance(); f.appendChild(i); i.x=24+(k%2)*199; i.y=296+Math.floor(k/2)*262; i.name='Menu Card / '+nm; prop(i,'Category',cat); prop(i,'Name',nm);\n  const src=await N(img); i.findOne(n=>n.name==='Image').fills=[{type:'IMAGE',imageHash:src.fills[0].imageHash,scaleMode:'FIT'}];\n  const ri=i.findOne(n=>n.type==='INSTANCE'&&n.name==='Rating'); prop(ri,'Value',rt);\n  if(fav){const ft=i.findOne(n=>n.name==='Favourite Toggle'); ft.swapComponent(favOn);} }\n const nav=(await V('2008:280','Current=Home')).createInstance(); f.appendChild(nav); nav.x=0; nav.y=832; nav.name='Bottom Nav';\n await shell(f); out.home=f.id;}\nreturn JSON.stringify(out);","description":"Build 01_Splash and 02_Home screens","fileKey":"SMG6SwyZNQKGZWFSWjv2YT"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":66944,"cache_read_input_tokens":7731,"cache_creation":{"ephemeral_5m_input_tokens":66944,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"68e3acd5-653d-48c8-9466-97ca92f6c51b","uuid":"316b3ae4-b012-4195-9224-9fe416624320","timestamp":"2026-10-28T09:57:00.794Z","tool_use_meta":[{"id":"toolu_bdrk_01UaLUuCJzZ6z53VjNAKow9T","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
