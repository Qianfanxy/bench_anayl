{"type":"assistant","message":{"id":"chatcmpl-202610311953002511241798268d9d6r0jZwE22","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_74c341246acd48dab6d407939e8bb683","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Semi Bold\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Bold\" });\n\n  const workspace = figma.root.children.find(p => p.name.includes(\"03\"));\n  await figma.setCurrentPageAsync(workspace);\n\n  // Constants & helpers\n  const BG_COLOR = { r: 0.07, g: 0.09, b: 0.11 }; // #12171C\n  const CARD_BG = { r: 0.12, g: 0.15, b: 0.18 }; // #1F262E\n  const GREEN_GAIN = { r: 0.15, g: 0.59, b: 0.27 }; // #279646\n  const TEXT_WHITE = { r: 0.95, g: 0.96, b: 0.98 }; // #F2F4F7\n  const TEXT_MUTED = { r: 0.55, g: 0.60, b: 0.68 }; // #8C99AD\n  const BORDER_COLOR = { r: 0.18, g: 0.22, b: 0.27 }; // #2E3845\n\n  function getInstance(id) {\n    const orig = figma.getNodeById(id);\n    if (!orig) return null;\n    return orig.createInstance();\n  }\n\n  function addShell(frame) {\n    const sb = getInstance(\"1:30\");\n    if (sb) {\n      sb.x = 0; sb.y = 0;\n      frame.appendChild(sb);\n    }\n    const hi = getInstance(\"1:40\");\n    if (hi) {\n      hi.x = 0; hi.y = 812 - 34;\n      frame.appendChild(hi);\n    }\n  }\n\n  function createTabBar(activeTab = \"Top Up\") {\n    const bar = figma.createFrame();\n    bar.name = \"Tab Bar\";\n    bar.resize(375, 64);\n    bar.fills = [{ type: 'SOLID', color: CARD_BG }];\n    bar.strokes = [{ type: 'SOLID', color: BORDER_COLOR }];\n    bar.strokeWeight = 1;\n    bar.layoutMode = \"HORIZONTAL\";\n    bar.primaryAxisSizingMode = \"FIXED\";\n    bar.counterAxisSizingMode = \"FIXED\";\n    bar.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    bar.counterAxisAlignItems = \"CENTER\";\n    bar.paddingLeft = 8;\n    bar.paddingRight = 8;\n\n    const tabs = [\n      { name: \"Aktivitas\", iconId: \"2:33\", label: \"Aktivitas\" },\n      { name: \"Trending\", iconId: \"2:36\", label: \"Trending\" },\n      { name: \"Top Up\", iconId: \"2:30\", label: \"Top Up\" },\n      { name: \"Pasar\", iconId: \"2:39\", label: \"Pasar\" },\n      { name: \"Profil\", iconId: \"2:42\", label: \"Profil\" }\n    ];\n\n    tabs.forEach(t => {\n      const tabItem = figma.createFrame();\n      tabItem.name = `Tab_${t.name}`;\n      tabItem.resize(68, 48);\n      tabItem.fills = [];\n      tabItem.layoutMode = \"VERTICAL\";\n      tabItem.primaryAxisAlignItems = \"CENTER\";\n      tabItem.counterAxisAlignItems = \"CENTER\";\n      tabItem.itemSpacing = 4;\n\n      const isActive = t.name === activeTab;\n      const activeColor = isActive ? GREEN_GAIN : TEXT_MUTED;\n\n      const iconInst = getInstance(t.iconId);\n      if (iconInst) {\n        tabItem.appendChild(iconInst);\n      }\n\n      const txt = figma.createText();\n      txt.fontName = { family: \"Roboto\", style: isActive ? \"Medium\" : \"Regular\" };\n      txt.characters = t.label;\n      txt.fontSize = 11;\n      txt.fills = [{ type: 'SOLID', color: activeColor }];\n      tabItem.appendChild(txt);\n\n      bar.appendChild(tabItem);\n    });\n\n    return bar;\n  }\n\n  // Create 04_Top_Up_Metode frame\n  const f4 = figma.createFrame();\n  f4.name = \"04_Top_Up_Metode\";\n  f4.resize(375, 812);\n  f4.x = 1350; f4.y = 0;\n  f4.fills = [{ type: 'SOLID', color: BG_COLOR }];\n  f4.clipsContent = true;\n\n  // Header 04: Header: “Top Up” · back (Icon_Back) · help (Icon_Help)\n  const h4 = figma.createFrame();\n  h4.name = \"Header\";\n  h4.resize(375, 56);\n  h4.x = 0; h4.y = 44;\n  h4.fills = [];\n  h4.layoutMode = \"HORIZONTAL\";\n  h4.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  h4.counterAxisAlignItems = \"CENTER\";\n  h4.paddingLeft = 16; h4.paddingRight = 16;\n\n  const leftH4 = figma.createFrame();\n  leftH4.fills = [];\n  leftH4.layoutMode = \"HORIZONTAL\";\n  leftH4.itemSpacing = 12;\n  leftH4.counterAxisAlignItems = \"CENTER\";\n\n  const backIcon = getInstance(\"2:52\");\n  if (backIcon) leftH4.appendChild(backIcon);\n\n  const h4Title = figma.createText();\n  h4Title.fontName = { family: \"Roboto\", style: \"Bold\" };\n  h4Title.characters = \"Top Up\";\n  h4Title.fontSize = 20;\n  h4Title.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n  leftH4.appendChild(h4Title);\n  h4.appendChild(leftH4);\n\n  const helpIcon = getInstance(\"2:65\");\n  if (helpIcon) h4.appendChild(helpIcon);\n\n  f4.appendChild(h4);\n\n  // Content Scroll Container\n  const scroll4 = figma.createFrame();\n  scroll4.name = \"Content Scroll\";\n  scroll4.resize(375, 812 - 44 - 56 - 64);\n  scroll4.x = 0; scroll4.y = 100;\n  scroll4.fills = [];\n  scroll4.layoutMode = \"VERTICAL\";\n  scroll4.itemSpacing = 20;\n  scroll4.paddingLeft = 16; scroll4.paddingRight = 16; scroll4.paddingBottom = 20;\n\n  // Balance Card: “Dana Saya” · Rp2.125.000\n  const balCard = figma.createFrame();\n  balCard.name = \"Balance Card\";\n  balCard.resize(343, 72);\n  balCard.fills = [{ type: 'SOLID', color: CARD_BG }];\n  balCard.cornerRadius = 12;\n  balCard.layoutMode = \"VERTICAL\";\n  balCard.paddingLeft = 16; balCard.paddingRight = 16; balCard.paddingTop = 12; balCard.paddingBottom = 12;\n  balCard.itemSpacing = 4;\n\n  const bLabel = figma.createText();\n  bLabel.fontName = { family: \"Roboto\", style: \"Regular\" };\n  bLabel.characters = \"Dana Saya\";\n  bLabel.fontSize = 12;\n  bLabel.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  balCard.appendChild(bLabel);\n\n  const bVal = figma.createText();\n  bVal.fontName = { family: \"Roboto\", style: \"Bold\" };\n  bVal.characters = \"Rp2.125.000\";\n  bVal.fontSize = 20;\n  bVal.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n  balCard.appendChild(bVal);\n\n  scroll4.appendChild(balCard);\n\n  // Methods Section: “Pilih Metode” · ATM (Icon_ATM) · Kartu Debit (Icon_Debit_Card) · Mobile Banking (Icon_Mobile_Banking) · Indomaret (Icon_Store) · Alfamart (Icon_Store), each opens its next step (Icon_Chevron_Right)\n  const mSec = figma.createFrame();\n  mSec.name = \"Methods Section\";\n  mSec.resize(343, 340);\n  mSec.fills = [];\n  mSec.layoutMode = \"VERTICAL\";\n  mSec.itemSpacing = 12;\n\n  const mTitle = figma.createText();\n  mTitle.fontName = { family: \"Roboto\", style: \"Bold\" };\n  mTitle.characters = \"Pilih Metode\";\n  mTitle.fontSize = 16;\n  mTitle.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n  mSec.appendChild(mTitle);\n\n  const methodsData = [\n    { name: \"ATM\", iconId: \"2:69\" },\n    { name: \"Kartu Debit\", iconId: \"2:75\" },\n    { name: \"Mobile Banking\", iconId: \"2:80\" },\n    { name: \"Indomaret\", iconId: \"2:87\" },\n    { name: \"Alfamart\", iconId: \"2:87\" }\n  ];\n\n  methodsData.forEach(m => {\n    const row = figma.createFrame();\n    row.name = `Method_${m.name}`;\n    row.resize(343, 56);\n    row.fills = [{ type: 'SOLID', color: CARD_BG }];\n    row.cornerRadius = 12;\n    row.layoutMode = \"HORIZONTAL\";\n    row.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    row.counterAxisAlignItems = \"CENTER\";\n    row.paddingLeft = 16; row.paddingRight = 16;\n\n    const left = figma.createFrame();\n    left.fills = [];\n    left.layoutMode = \"HORIZONTAL\";\n    left.itemSpacing = 12;\n    left.counterAxisAlignItems = \"CENTER\";\n\n    const mIcon = getInstance(m.iconId);\n    if (mIcon) left.appendChild(mIcon);\n\n    const mTxt = figma.createText();\n    mTxt.fontName = { family: \"Roboto\", style: \"Medium\" };\n    mTxt.characters = m.name;\n    mTxt.fontSize = 14;\n    mTxt.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n    left.appendChild(mTxt);\n    row.appendChild(left);\n\n    const chevIcon = getInstance(\"2:48\");\n    if (chevIcon) row.appendChild(chevIcon);\n\n    mSec.appendChild(row);\n  });\n\n  scroll4.appendChild(mSec);\n  f4.appendChild(scroll4);\n\n  // Tab Bar for 04\n  const tb4 = createTabBar(\"Top Up\");\n  tb4.x = 0; tb4.y = 812 - 64;\n  f4.appendChild(tb4);\n\n  addShell(f4);\n  workspace.appendChild(f4);\n\n  return \"Frame 04_Top_Up_Metode created successfully\";\n})()","description":"Build frame 04_Top_Up_Metode in 03 · Workspace","fileKey":"JFBzRSGrqYhoiYPN8CHLgF"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":47834,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":30856},"context_management":null},"parent_tool_use_id":null,"session_id":"29675d63-ebdc-41c5-b9bc-94637defa1d1","uuid":"a4592eee-527d-4b2d-a9b4-2b4e68599bb9","timestamp":"2026-10-31T19:53:29.861Z","tool_use_meta":[{"id":"call_74c341246acd48dab6d407939e8bb683","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
