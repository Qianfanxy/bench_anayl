||{}; const f=box(name,w,h,o);\n  f.layoutMode=o.dir||'VERTICAL'; f.itemSpacing=o.gap||0;\n  f.primaryAxisSizingMode=o.pw||'FIXED'; f.counterAxisSizingMode=o.cw||'FIXED';\n  f.paddingTop=o.pt||0; f.paddingBottom=o.pb||0; f.paddingLeft=o.pl||0; f.paddingRight=o.pr||0;\n  f.primaryAxisAlignItems=o.pa||'MIN'; f.counterAxisAlignItems=o.ca||'MIN';\n  return f;\n}\nconst page=figma.root.children.find(p=>p.id==='4:2');\nawait figma.setCurrentPageAsync(page);\nconst board=page.findOne(n=>n.name==='Component library · MAC');\nfunction section(name,dir){\n  let s=board.findOne(n=>n.name===name&&n.type==='FRAME');\n  if(!s){ s=figma.createFrame(); s.name=name; s.fills=[]; s.strokes=[]; s.layoutMode=dir||'HORIZONTAL'; s.itemSpacing=16; s.counterAxisAlignItems='CENTER'; s.primaryAxisSizingMode='AUTO'; s.counterAxisSizingMode='AUTO'; board.appendChild(s); }\n  s.children.slice().forEach(c=>c.remove()); return s;\n}\nconst grad=(a,b)=>({type:'GRADIENT_LINEAR',gradientTransform:[[1,0,0],[0,1,0]],gradientStops:[{position:0,color:rgba(a,1)},{position:1,color:rgba(b,1)}]});\n// ---------- STAT CARD (dark) ----------\nconst statSec=section('Stat card');\nconst mkStat=()=>{\n  const c=figma.createComponent(); c.name='Stat Card'; c.resize(300,238); c.cornerRadius=28; c.fills=[solid(COL.ink)];\n  c.layoutMode='VERTICAL'; c.paddingTop=24; c.paddingBottom=24; c.paddingLeft=24; c.paddingRight=24; c.itemSpacing=10; c.clipsContent=true;\n  const top=lbox('Top',252,30,{}); top.fills=[]; top.layoutMode='HORIZONTAL'; top.counterAxisAlignItems='CENTER'; top.primaryAxisSizingMode='FIXED'; top.counterAxisSizingMode='FIXED'; top.itemSpacing=8;\n  top.appendChild(T('230+',56,S.xb,COL.white,{lh:58,ls:-3,name:'Value'}));\n  const badge=lbox('Growth badge',86,30,{fill:'#1E2420',radius:100,dir:'HORIZONTAL',pl:10,pr:10,ca:'CENTER',pa:'CENTER'});\n  badge.appendChild(inst('2:12',14,COL.lime));\n  badge.appendChild(T('24.8%',12,S.semi,COL.lime,{lh:16,name:'Delta'}));\n  c.appendChild(badge);\n  c.appendChild(T('some big companies that we work with, and trust us very much',14,S.reg,'#B4BAC6',{w:252,lh:21,name:'Caption'}));\n  const track=box('Progress track',252,4,{fill:'#272C35',radius:100});\n  const fill=box('Progress fill',156,4,{fill:COL.lime,radius:100});\n  track.appendChild(fill);\n  c.appendChild(track);\n  return c;\n};\nstatSec.appendChild(mkStat());\n// ---------- TRAFFIC CARD ----------\nconst trSec=section('Traffic card');\nconst mkTraffic=()=>{\n  const c=figma.createComponent(); c.name='Traffic Card'; c.resize(320,250); c.cornerRadius=28; c.fills=[solid(COL.white)];\n  c.strokes=[solid(COL.line)]; c.strokeWeight=1; c.strokeAlign='INSIDE'; c.layoutMode='VERTICAL';\n  c.paddingTop=24; c.paddingBottom=24; c.paddingLeft=24; c.paddingRight=24; c.itemSpacing=6; c.clipsContent=true;\n  c.appendChild(T('Drive More Traffic and Sales',18,S.semi,COL.ink,{lh:24,w:272,name:'Title'}));\n  c.appendChild(T('Drive more traffic and product sales',13,S.reg,COL.muted,{lh:18,w:272,name:'Subtitle'}));\n  const chart=box('Bar chart',272,94,{}); chart.fills=[];\n  const bars=[[0,44],[1,62],[2,94]];\n  const heights=[44,62,94];\n  const widths=[28,28,28];\n  let x=0;\n  heights.forEach((h,i)=>{\n    const b=box('Bar '+(i+1),28,h,{fill:i===2?COL.lime:COL.surf2,radius:8});\n    b.x=[0,40,80][i]; b.y=94-h; chart.appendChild(b);\n  });\n  c.appendChild(chart);\n  return c;\n};\ntrSec.appendChild(mkTraffic());\n// ---------- CASE STUDY CARD ----------\nconst csSec=section('Case study card');\nconst mkCase=(state)=>{\n  const c=figma.createComponent(); c.name='state='+state; c.resize(384,404); c.fills=[]; c.strokes=[]; c.clipsContent=false;\n  c.layoutMode='VERTICAL'; c.itemSpacing=20;\n  const media=box('Image placeholder',384,300,{radius:24});\n  media.fills=[grad(i=>'#E4E8EE','#BAC3CE')];\n  media.layoutMode='HORIZONTAL'; media.primaryAxisAlignItems='CENTER'; media.counterAxisAlignItems='CENTER';\n  if(state==='Hover'){\n    const ov=box('Overlay',384,300,{fill:'rgba'});\n    ov.fills=[solid(COL.ink,0.28)];\n    const pill=lbox('See Details',172,56,{fill:COL.white,radius:100,dir:'HORIZONTAL',pl:26,pr:22,ca:'CENTER',pa:'CENTER',gap:10});\n    pill.appendChild(T('See Details',16,S.semi,COL.ink,{lh:20,name:'Label'}));\n    pill.appendChild(inst('2:3',18,COL.ink));\n    media.appendChild(ov); ov.x=0; ov.y=0;\n    media.appendChild(pill);\n    const ar=box('Placeholder tag',120,26,{fill:'#FFFFFF',radius:100});\n  }\n  c.appendChild(media);\n  const cap=lbox('Caption',384,84,{}); cap.fills=[];\n  if(state!=='Hover'){\n    cap.appendChild(T('Ai Corporation. 2023',14,S.med,COL.muted,{lh:20,name:'Meta'}));\n    cap.appendChild(T('Ai Wave - Ai Chatbot Mobile App',22,S.semi,COL.ink,{lh:28,w:340,name:'Title'}));\n  }\n  c.appendChild(cap);\n  return c;\n};\nconst csSet=figma.combineAsVariants([mkCase('Default'),mkCase('Hover')],csSec);\ncsSet.name='Case Study Card'; csSet.description='Case-study card. Hover state swaps the caption for a See Details action.';\n// ---------- ARTICLE CARD ----------\nconst arSec=section('Article card');\nconst mkArticle=()=>{\n  const c=figma.createComponent(); c.name='Article Card'; c.resize(384,472); c.fills=[]; c.strokes=[]; c.clipsContent=false;\n  c.layoutMode='VERTICAL'; c.itemSpacing=18;\n  const media=box('Image placeholder',384,220,{radius:24}); media.fills=[grad('#E4E8EE','#BAC3CE')];\n  c.appendChild(media);\n  const meta=lbox('Meta',384,32,{dir:'HORIZONTAL',ca:'CENTER'}); meta.fills=[]; meta.primaryAxisAlignItems='SPACE_BETWEEN';\n  const chip=lbox('Read time',92,32,{fill:COL.limeSoft,radius:100,dir:'HORIZONTAL',pl:12,pr:12,ca:'CENTER',pa:'CENTER'});\n  chip.appendChild(T('5 min read',12,S.semi,'#3F6B12',{lh:16,name:'Label'}));\n  meta.appendChild(chip);\n  meta.appendChild(inst('2:3',20,COL.ink));\n  c.appendChild(meta);\n  c.appendChild(T('How a Digital Marketing Agency Can Boost Your Business',22,S.semi,COL.ink,{w:384,lh:29,name:'Title'}));\n  c.appendChild(T('We are the top digital marketing agency for branding corp. We offer a full range of services to help clients improve their search engine rankings.',15,S.reg,COL.body,{w:360,lh:23,name:'Excerpt'}));\n  return c;\n};\narSec.appendChild(mkArticle());\n// ---------- FAQ ITEM ----------\nconst fqSec=section('FAQ item',('VERTICAL'));\nconst mkFaq=(state)=>{\n  const c=figma.createComponent(); c.name='state='+state; c.resize(720,state==='Expanded'?196:88); c.fills=[];\n  c.strokes=[]; c.clipsContent=false; c.layoutMode='VERTICAL'; c.itemSpacing=0;\n  const row=lbox('Question row',720,88,{dir:'HORIZONTAL',ca:'CENTER'});\n  row.fills=[]; row.strokes=[]; row.primaryAxisSizingMode='FIXED'; row.counterAxisSizingMode='FIXED';\n  row.primaryAxisAlignItems='SPACE_BETWEEN';\n  row.appendChild(T('Why is digital marketing important for my business?',18,S.semi,COL.ink,{lh:24,w:620,name:'Question'}));\n  const btn=box('Toggle',44,44,{fill:state==='Expanded'?COL.ink:COL.white,radius:22});\n  btn.strokes=[solid(COL.line)]; btn.strokeWeight=1; btn.strokeAlign='INSIDE';\n  btn.layoutMode='HORIZONTAL'; btn.primaryAxisAlignItems='CENTER'; btn.counterAxisAlignItems='CENTER';\n  btn.appendChild(inst(state==='Expanded'?'2:8':'2:11',18,state==='Expanded'?COL.white:COL.ink));\n  row.appendChild(btn);\n  c.appendChild(row);\n  if(state==='Expanded'){\n    const ans=T('Digital marketing allows businesses to reach and engage with a wider audience, generate leads, drive website traffic, and increase brand visibility. It provides measurable results, allows for targeted marketing efforts, and enables businesses to adapt and optimize their strategies based on data and insights.',15,S.reg,COL.body,{w:620,lh:24,name:'Answer'});\n    ans.x=0;\n    c.appendChild(ans);\n    c.itemSpacing=12;\n  }\n  return c;\n};\nconst fqSet=figma.combineAsVariants([mkFaq('Collapsed'),mkFaq('Expanded')],fqSec);\nfqSet.name='FAQ Item'; fqSet.description='Accordion question row; expanded state reveals the answer.';\nreturn JSON.stringify({stat:statSec.children[0].id,traffic