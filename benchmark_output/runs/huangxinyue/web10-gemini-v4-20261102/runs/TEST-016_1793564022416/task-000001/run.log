Title.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.55 } }];\n  convList.appendChild(pinnedTitle);\n\n  const pinData = [\n    { avatar: \"Avatar_Killan_James\", name: \"Killan James\", time: \"4:30 PM\", msg: \"Typing...\", count: \"2\" },\n    { avatar: \"Avatar_Design_Team\", name: \"Design Team\", time: \"9:36 AM\", msg: \"Hello! Everyone\", isCurrent: true },\n    { avatar: \"Avatar_Ahmed_Medi\", name: \"Ahmed Medi\", time: \"1:15 AM\", msg: \"Wow really Cool 🔥\" }\n  ];\n\n  for (const p of pinData) {\n    const row = figma.createFrame();\n    row.name = `PinRow_${p.name.replace(/\\s+/g, '')}`;\n    row.resize(280, 60);\n    row.cornerRadius = 10;\n    if (p.isCurrent) {\n      row.fills = [{ type: 'SOLID', color: { r: 0.94, g: 0.94, b: 1 } }];\n    } else {\n      row.fills = [];\n    }\n    row.paddingLeft = 8; row.paddingRight = 8;\n    row.layoutMode = \"HORIZONTAL\";\n    row.counterAxisAlignItems = \"CENTER\";\n    row.itemSpacing = 10;\n\n    row.appendChild(getAsset(p.avatar, 36));\n\n    const textCol = figma.createFrame();\n    textCol.layoutMode = \"VERTICAL\";\n    textCol.itemSpacing = 2;\n    textCol.fills = [];\n\n    const nameTime = figma.createFrame();\n    nameTime.resize(218, 16);\n    nameTime.layoutMode = \"HORIZONTAL\";\n    nameTime.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    nameTime.fills = [];\n\n    const nTxt = figma.createText();\n    nTxt.characters = p.name;\n    nTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n    nTxt.fontSize = 12;\n    nTxt.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n    nameTime.appendChild(nTxt);\n\n    const tTxt = figma.createText();\n    tTxt.characters = p.time;\n    tTxt.fontName = { family: \"DM Sans\", style: \"Regular\" };\n    tTxt.fontSize = 10;\n    tTxt.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.55 } }];\n    nameTime.appendChild(tTxt);\n    textCol.appendChild(nameTime);\n\n    const msgRow = figma.createFrame();\n    msgRow.resize(218