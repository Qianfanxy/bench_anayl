141','Jo'],['5:144','Henry'],['5:122','Pierre']];\nfor(let i=0;i<stories.length;i++){\n  const s=await story(stories[i][0],stories[i][1],false);\n  s.x=90+i*76;s.y=132;C.appendChild(s);\n}\n\n// chips\nconst chip1=figma.createFrame();chip1.name='Chip/MakeFriends';chip1.resize(168,40);chip1.x=20;chip1.y=244;chip1.cornerRadius=20;chip1.fills=[solid(PLUM,0.08)];C.appendChild(chip1);\nconst c1t=txt('Make Friends',14,'Semi Bold',PLUM);c1t.textAutoResize='HEIGHT';c1t.textAlignHorizontal='CENTER';c1t.resize(168,c1t.height);c1t.y=12;chip1.appendChild(c1t);\nconst chip2=figma.createFrame();chip2.name='Chip/SearchPartners';chip2.resize(168,40);chip2.x=204;chip2.y=244;chip2.cornerRadius=20;chip2.fills=[gradBrand()];chip2.effects=[shadow(6,12,0.25)];C.appendChild(chip2);\nconst c2t=txt('Search Partners',14,'Semi Bold',{r:1,g:1,b:1});c2t.textAutoResize='HEIGHT';c2t.textAlignHorizontal='CENTER';c2t.resize(168,c2t.height);c2t.y=12;chip2.appendChild(c2t);\n\n// feed posts (inline builder)\nasync function post(pid,phId,name,cap,y){\n  const f=figma.createFrame();f.name='Post/'+name;f.resize(353,452);f.x=20;f.y=y;\n  f.fills=[solid({r:1,g:1,b:1})];f.cornerRadius=20;f.effects=[shadow(4,16,0.07)];\n  const av=await photoBox(pid,40,40,20);av.name='Avatar';av.x=12;av.y=12;f.appendChild(av);\n  const n=txt(name,14,'Semi Bold',INK);n.x=62;n.y=14;f.appendChild(n);\n  const m=txt('2h ago · Follow',12,'Regular',TER);m.x=62;m.y=34;f.appendChild(m);\n  const more=await iconInst('5:48',22,INK);more.name='Icon/More';more.x=317;more.y=21;f.appendChild(more);\n  const ph=await photoBox(phId,353,300,0);ph.name='Photo';ph.y=62;f.appendChild(ph);\n  const like=await iconInst('5:45',24,INK);like.name='Icon/Like';like.x=14;like.y=378;f.appendChild(like);\n  const chat=await iconInst('5:42',24,INK);chat.name='Icon/Comment';chat.x=52;chat.y=378;f.appendChild(chat);\n  const c=txt(cap,13,'Regular',INK);c.textAutoResize='HEIGHT';c.resize(325,100);c.x=14;c.y=414;f.appendChild(c);\n  C.appendChild(f);return f