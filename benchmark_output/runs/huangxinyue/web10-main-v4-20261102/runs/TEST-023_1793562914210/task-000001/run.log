lls=fill(color||P.ink);v.strokes=[];});return inst;}\nasync function photo(parent,id,x,y,w,h){const src=await figma.getNodeByIdAsync(id);const inst=src.createInstance();parent.appendChild(inst);inst.name=src.name;inst.resize(w,h);inst.x=x;inst.y=y;inst.fills=[{type:'IMAGE',scaleMode:'FILL',imageHash:src.fills[0].imageHash}];return inst;}\nasync function btn(parent,x,y,w,label,kind,h){const src=await figma.getNodeByIdAsync('1:24');const b=src.createInstance();parent.appendChild(b);b.resize(w,h||56);b.x=x;b.y=y;if(kind==='outline'){b.fills=fill(P.white);b.strokes=[{type:'SOLID',color:rgb(P.ink),opacity:1}];b.strokeWeight=1;b.strokeAlign='INSIDE';b.findOne(n=>n.type==='TEXT').fills=fill(P.ink);}const t=b.findOne(n=>n.type==='TEXT');t.characters=label;t.fontSize=14;return b;}\n\n// ---------- Text field component ----------\nconst tf = comp(lib,'Field / Text',400,90,900,14000);\ntx(tf,'Label',0,0,{t:'Email Address',s:12,w:'Medium',c:P.ink});\nconst tin=box(tf,'Input',0,26,400,58,{stroke:P.line,r:10,fill:P.white});\ntx(tin,'Placeholder',18,17,{t:'michael@example.com',s:13,c:P.muted});\n\n// ---------- Cart summary card ----------\nconst cs = comp(lib,'Panel / Cart Total',480,320,900,14400);\nconst csb=box(cs,'Surface',0,0,480,320,{fill:P.cream,r:16});\ntx(csb,'Title',28,24,{t:'Order Summary',s:20,f:'Volkhov',w:'Bold',c:P.ink});\nbox(csb,'Checkbox',28,72,20,20,{stroke:'#C9C5BD',r:4,fill:P.white});\ntx(csb,'WrapLabel',60,70,{t:'For $10.00 please wrap the product',s:13,c:P.body});\nbox(csb,'Rule',28,116,424,1,{fill:'#DDD7CC'});\ntx(csb,'SubLabel',28,140,{t:'Subtotal',s:14,c:P.body});\nconst sv=tx(csb,'SubVal',0,138,{t:'$39.00',s:15,w:'SemiBold',c:P.ink}); sv.x=452-sv.width;\nawait btn(csb,28,186,424,'Checkout',null,58);\ntx(csb,'Note',28,262,{t:'Free shipping on orders over $75. Taxes calculated at checkout.',s:11,c:P.muted,width:420});\nreturn {tf:tf.id, cs:cs.id};\n","description":"Build text field and cart total panel components","fileKey":"zj84fVMgzEUIcsaY8ScK7u"},"call