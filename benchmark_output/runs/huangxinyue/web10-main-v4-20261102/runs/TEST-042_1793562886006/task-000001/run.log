gTop=opts.pt||0; f.paddingBottom=opts.pb||0;\n  if(opts.align) f.counterAxisAlignItems=opts.align;\n  if(opts.justify) f.primaryAxisAlignItems=opts.justify;\n  if(opts.wrap) f.layoutWrap='WRAP';\n  return f;\n}\nfunction inst(comp, w, h){ const i = comp.createInstance(); if(w&&h) i.resize(w,h); else if(w) i.resize(w, i.height*w/comp.width); return i; }\nfunction swapPhoto(card, photoName, w, h){\n  const old = card.findOne(n => n.name==='Photo' && n.parent && n.parent.name==='Image');\n  const imgWrap = card.findOne(n=>n.name==='Image');\n  const idx = imgWrap.children.indexOf(old);\n  old.remove();\n  const img = inst(M[photoName], w, h); img.name='Photo';\n  imgWrap.insertChild(idx, img);\n}\nfunction recipeCard(photoName, titleText, time, cat, fav){\n  const c = byName('Recipe Card').createInstance();\n  swapPhoto(c, photoName, 266, 180);\n  c.findOne(n=>n.name==='Title').characters = titleText;\n  const chips = c.findOne(n=>n.name==='Meta');\n  const timerChip = chips.children[0]; timerChip.findOne(n=>n.name==='Label').characters = time;\n  const forkChip = chips.children[1]; forkChip.findOne(n=>n.name==='Label').characters = cat;\n  if (fav) {\n    const imgWrap = c.findOne(n=>n.name==='Image');\n    const oldFav = imgWrap.children[1];\n    const fx = oldFav.x, fy = oldFav.y;\n    oldFav.remove();\n    const nf = byName('Favorite / Active').createInstance();\n    imgWrap.appendChild(nf); nf.x = fx; nf.y = fy;\n  }\n  return c;\n}\n\n// ---------- Categories ----------\n{\n  const sec = frame('Categories');\n  al(sec,'VERTICAL',{pl:80,pr:80,pt:64,pb:16,gap:40});\n  const head = frame('Head'); al(head,'HORIZONTAL',{align:'CENTER'});\n  const t = text('Categories','Bold',40); t.name='Title';\n  head.appendChild(t); t.layoutGrow=1;\n  const btn = byName('Button / md').createInstance();\n  btn.findOne(n=>n.type==='TEXT').characters='View All Categories';\n  head.appendChild(btn);\n  sec.appendChild(head); head.layoutAlign='STRETCH';\n  const row = frame('Tiles'); al(row,'HORIZONTAL',{gap:24,justify:'SPACE_BETWEEN'});\n  row.resize(1280, 200);\n  const cats = [['Breakfast','Category_Breakfast'],['Vegan','Category_Vegan'],['Meat','Category_Meat'],['Dessert','Category_Dessert'],['Lunch','Category_Lunch'],['Chocolate','Category_Chocolate']];\n  for (const [label, imgName] of cats) {\n    const tile = byName('Category Tile').createInstance();\n    const img = tile.findOne(n=>n.name==='Image');\n    const idx = tile.children.indexOf(img);\n    img.remove();\n    const ni = inst(M[imgName], 110, 110); ni.name='Image';\n    tile.insertChild(0, ni);\n    tile.findOne(n=>n.name==='Label').characters = label;\n    tile.name = 'Category / ' + label;\n    row.appendChild(tile);\n  }\n  sec.appendChild(row); row.layoutAlign='STRETCH';\n  sec.resize(1440, Math.round(sec.height));\n  home.appendChild(sec); sec.layoutAlign='STRETCH';\n}\n\n// ---------- Simple and tasty recipes ----------\n{\n  const simple = [['Photo_Wagyu_Cheeseburger','Big and Juicy Wagyu Beef Cheeseburger','Western',true],\n    ['Photo_Lime_Salmon','Fresh Lime Roasted Salmon with Ginger Sauce','Fish',false],\n    ['Photo_Strawberry_Oatmeal_Pancake','Strawberry Oatmeal Pancake with Honey Syrup','Breakfast',false],\n    ['Photo_Mayonnaise_Salad','Fresh and Healthy Mixed Mayonnaise Salad','Healthy',true],\n    ['Photo_Chicken_Meatballs','Chicken Meatballs with Cream Cheese','Meat',false],\n    ['Photo_Fruity_Pancake','Fruity Pancake with Orange & Blueberry','Sweet',true],\n    ['Photo_One_Pot_Chicken_Rice','The Best Easy One Pot Chicken and Rice','Snack',false],\n    ['Photo_Creamy_Chicken_Bacon_Pasta','The Creamiest Creamy Chicken and Bacon Pasta','Noodles',false]];\n  const sec = frame('Simple and Tasty');\n  al(sec,'VERTICAL',{pl:80,pr:80,pt:72,pb:8,gap:40});\n  const head = frame('Head'); al(head,'VERTICAL',{gap:16,align:'CENTER'});\n  const t = text('Simple and tasty recipes','Bold',40,{align:'CENTER'}); t.name='Title';\n  const c = text('Quick, everyday dishes with ingredients you can find at any supermarket.','Regular',16,{alpha:0.6,align:'CENTER',lh:160});\n  c.name='Copy'; c.textAutoResize='HEIGHT'; c.resize(700,c.height);\n  head.appendChild(t); head.appendChild(c);\n  sec.appendChild(head); head.layoutAlign='STRETCH';\n  const grid = frame('Grid'); al(grid,'HORIZONTAL',{gap:32,wrap:true});\n  grid.counterAxisSpacing = 32;\n  grid.resize(1280, 10);\n  for (const [p,tt,cat,fav] of simple) {\n    const card = recipeCard(p, tt, '30 Minutes', cat, fav);\n    card.name = 'Card / ' + tt;\n    grid.appendChild(card);\n  }\n  sec.appendChild(grid); grid.layoutAlign='STRETCH';\n  sec.resize(1440, Math.round(sec.height));\n  home.appendChild(sec); sec.layoutAlign='STRETCH';\n}\n\nhome.resize(1440, Math.round(home.height));\nreturn { homeH: home.height };","description":"Add Categories and Simple-and-tasty recipe grid to 01_Home"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"eb6a87e1-77d2-4750-aa78-08940da487c1","uuid":"20cfeeca-1d02-4ccc-b324-7b890c2bc4f2","timestamp":"2026-11-01T20:09:16.012Z","tool_use_meta":[{"id":"mcp__figma__use_figma_28_152e60cb","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
