belColor, labelX, labelSize, iconId) {\n  const c = makeComponent(parent, name, w, h, x, y);\n  rectIn(c, 0, 0, w, h, fill, radius);\n  let lx = labelX != null ? labelX : 14;\n  if (iconId) {\n    const ic = instInto(iconId, 10, (h-16)/2, c, 16);\n    for (const v of ic.findAll(n=>n.type==='VECTOR')) v.fills=[{type:'SOLID',color:labelColor}];\n  }\n  const t = text(c, label, labelSize||14, 'Bold', labelColor, lx, (h-(labelSize||14)-4)/2);\n  return c;\n}\n\n// 4. Tab / Order Type (rebuild properly with frames)\nconst tabC = makeComponent(lib, 'Tab / Order Type', 360, 64, 700, 148);\nconst tA = figma.createFrame();\ntA.name='Delivery (current)';\ntA.resize(180,64); tA.x=0; tA.y=0;\ntA.fills=[{type:'SOLID',color:YELLOW}]; tA.cornerRadius=10;\ntabC.appendChild(tA);\ninstInto('9:10', 20, 20, tA, 24);\ntext(tA, 'Delivery', 18, 'Bold', INK, 54, 20);\nconst tB = figma.createFrame();\ntB.name='Pickup';\ntB.resize(160,64); tB.x=200; tB.y=0;\ntB.fills=[{type:'SOLID',color:{r:0.955,g:0.955,b:0.96}}]; tB.cornerRadius=10;\ntabC.appendChild(tB);\ninstInto('9:13', 20, 20, tB, 24);\ntext(tB, 'Pickup', 18, 'Bold', GRAY, 54, 20);\n\n// 5. Badge / Discount\nconst badgeC = makeComponent(lib, 'Badge / Discount', 110, 84, 48, 300);\nrectIn(badgeC, 0, 0, 110, 84, YELLOW, 14);\nconst bp = text(badgeC, '15%', 30, 'Bold', WHITE, 0, 12);\nbp.x = (110-bp.width)/2;\nconst bo = text(badgeC, 'Off', 15, 'Bold', WHITE, 0, 52);\nbo.x = (110-bo.width)/2;\n// 6. Badge / Tag\nchipComp(lib, 'Badge / Tag', 220, 320, 91, 32, ORANGE, 8, '20% off', WHITE, 32, 14, '9:19');\n// 7. Badge / Fast\nchipComp(lib, 'Badge / Fast', 380, 320, 70, 32, YELLOW, 8, 'Fast', INK, 32, 14, '9:5');\n// 8. Status Open / Closed\nconst stO = chipComp(lib, 'Status / Open', 520, 322, 92, 28, {r:0.89803922,g:0.97254902,b:0.9372549}, 14, 'Open Now', {r:0.04705882,g:0.59215686,b:0.31764706}, 14, 14);\nchipComp(lib, 'Status / Closed', 660, 322, 133, 28, {r:1,g:0.95686275,b:0.87058824}, 14, 'Opens tomorrow', {r:0.70980392,g:0.44705882,b