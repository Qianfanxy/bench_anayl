6 } : { r: 0.5, g: 0.5, b: 0.55 } }];\n    tab.appendChild(txt);\n    tabs.appendChild(tab);\n  }\n  chartHeader.appendChild(tabs);\n  chartCard.appendChild(chartHeader);\n\n  // Line chart visual representation\n  const chartArea = figma.createFrame();\n  chartArea.name = \"ChartArea\";\n  chartArea.resize(832, 260);\n  chartArea.fills = [{ type: 'SOLID', color: { r: 0.99, g: 0.99, b: 1 } }];\n  chartArea.cornerRadius = 10;\n  \n  // Y-axis labels: 400, 300, 200, 100, 0\n  const yLabels = [\"400\", \"300\", \"200\", \"100\", \"0\"];\n  yLabels.forEach((val, idx) => {\n    const lbl = figma.createText();\n    lbl.characters = val;\n    lbl.fontName = { family: \"DM Sans\", style: \"Regular\" };\n    lbl.fontSize = 10;\n    lbl.fills = [{ type: 'SOLID', color: { r: 0.6, g: 0.6, b: 0.65 } }];\n    lbl.x = 12;\n    lbl.y = 16 + idx * 50;\n    chartArea.appendChild(lbl);\n  });\n\n  // X-axis months: May - Apr (12 months)\n  const months = [\"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\", \"Jan\", \"Feb\", \"Mar\", \"Apr\"];\n  months.forEach((m, idx) => {\n    const lbl = figma.createText();\n    lbl.characters = m;\n    lbl.fontName = { family: \"DM Sans\", style: \"Regular\" };\n    lbl.fontSize = 10;\n    lbl.fills = [{ type: 'SOLID', color: { r: 0.6, g: 0.6, b: 0.65 } }];\n    lbl.x = 60 + idx * 62;\n    lbl.y = 230;\n    chartArea.appendChild(lbl);\n  });\n\n  // Series 1 Vector line (Blue)\n  const line1 = figma.createVector();\n  line1.name = \"Series1_Blue\";\n  line1.vectorPaths = [{\n    windingRule: \"NONZERO\",\n    data: \"M 65 180 L 127 150 L 189 170 L 251 110 L 313 130 L 375 80 L 437 100 L 499 60 L 561 90 L 623 40 L 685 70 L 747 30\"\n  }];\n  line1.strokes = [{ type: 'SOLID', color: { r: 0.314, g: 0.318, b: 0.976 } }];\n  line1.strokeWeight = 3;\n  chartArea.appendChild(line1);\n\n  // Series 2 Vector line (Orange/Light Blue)\n  const line2 = figma.createVector();\n  line2.name = \"Series2_Orange\";\n  line2.vectorPaths = [{\n    windingRule: \"NONZERO\",\n    data: \"M 65 210 L 127 190 L 189 200 L 251 160 L 313 180 L 375 140 L 437 150 L 499 110 L 561 130 L 623 100 L 685 120 L 747 90\"\n  }];\n  line2.strokes = [{ type: 'SOLID', color: { r: 1, g: 0.6, b: 0.2 } }];\n  line2.strokeWeight = 3;\n  chartArea.appendChild(line2);\n\n  chartCard.appendChild(chartArea);\n  leftCol.appendChild(chartCard);\n\n  // Tasks Section (880 x 320)\n  const taskSection = figma.createFrame();\n  taskSection.name = \"TaskSection\";\n  taskSection.resize(880, 330);\n  taskSection.cornerRadius = 16;\n  taskSection.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  taskSection.paddingTop = 20; taskSection.paddingBottom = 20;\n  taskSection.paddingLeft = 24; taskSection.paddingRight = 24;\n  taskSection.layoutMode = \"VERTICAL\";\n  taskSection.itemSpacing = 16;\n\n  const taskTitle = figma.createText();\n  taskTitle.characters = \"Task\";\n  taskTitle.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  taskTitle.fontSize = 18;\n  taskTitle.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n  taskSection.appendChild(taskTitle);\n\n  // Task rows data\n  const taskRowsData = [\n    {\n      title: \"Search Inspiration for project\",\n      time: \"Start from 9.00 am\",\n      link: \"inspiration.example.com\",\n      comments: \"8 comments\",\n      progress: \"24% complete\",\n      progVal: 0.24\n    },\n    {\n      title: \"Search Inspiration for project\",\n      time: \"Start from 3.00 am\",\n      link: \"moodboard.example.org\",\n      comments: \"5 comments\",\n      progress: \"60% complete\",\n      progVal: 0.60\n    }\n  ];\n\n  for (const t of taskRowsData) {\n    const row = figma.createFrame();\n    row.name = \"TaskRow\";\n    row.resize(832, 110);\n    row.cornerRadius = 12;\n    row.fills = [{ type: 'SOLID', color: { r: 0.98, g: 0.98, b: 0.99 } }];\n    row.paddingTop = 16; row.paddingBottom = 16;\n    row.paddingLeft = 20; row.paddingRight = 20;\n    row.layoutMode = \"