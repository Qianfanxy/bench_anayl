{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_5ec9c97beed44a90bfe8cf9b","name":"mcp__figma__use_figma","input":{"code":"const get = id => figma.getNodeByIdAsync(id);\nconst home = await get('13:83');\nconst prop = await get('16:271');\nconst out={};\n\n// Similar card structure\nconst simRow = prop.findOne(n=>n.name==='Similar').findOne(n=>n.name==='Row');\nconst card = simRow.children[0];\nout.card={id:card.id,size:card.size,mode:card.layoutMode,prim:card.primaryAxisSizingMode,counter:card.counterAxisSizingMode,clips:card.clipsContent};\nout.cardChildren = card.children.map(c=>({name:c.name,type:c.type,size:c.size,align:c.layoutAlign,grow:c.layoutGrow,prim:(c.layoutMode?c.primaryAxisSizingMode:undefined)}));\n\n// Home card for comparison\nconst homeCard = await get('14:108');\nout.homeCard={size:homeCard.size,prim:homeCard.primaryAxisSizingMode};\nout.homeCardChildren = homeCard.children.map(c=>({name:c.name,size:c.size,align:c.layoutAlign,grow:c.layoutGrow}));\n\n// Quote text height test\nconst ts = home.findOne(n=>n.name==='Testimonial');\nconst q = ts.findOne(n=>n.type==='TEXT'&&n.name==='Quote');\nout.quoteBefore={size:q.size,auto:q.textAutoResize};\nq.textAutoResize='NONE';\nq.textAutoResize='HEIGHT';\nout.quoteAfter={size:q.size,auto:q.textAutoResize};\n\n// CTA button\nconst cta = home.findOne(n=>n.name==='CTA');\nconst btn = cta.findAll(n=>n.type==='INSTANCE').find(i=>i.findOne(t=>t.type==='TEXT'&&t.characters==='Get a free valuation'));\nout.ctaBtn={id:btn.id,size:btn.size,fills:JSON.stringify(btn.fills)};\n\n// agency copy\nconst ag = home.findOne(n=>n.name==='Agency Intro 1');\nconst cp = ag.findOne(n=>n.type==='TEXT'&&n.name==='Copy');\nout.agCopy={size:cp.size,auto:cp.textAutoResize};\nreturn JSON.stringify(out);","description":"Inspect similar card structure, text auto-height behavior and CTA button","fileKey":"rQsVjyS3FLCJmO37vlAUQN"}}],"id":"b1f5e6b0-b375-4523-bfc0-7e8a3c72e27c","model":"glm-5.3-flash","role":"assistant",