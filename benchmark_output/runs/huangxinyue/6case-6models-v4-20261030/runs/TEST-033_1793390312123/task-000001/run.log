le: \"Bold\" };\n    tVal.fontSize = 14; tVal.characters = p.val;\n    tVal.textAlignHorizontal = \"RIGHT\";\n    tVal.x = 210; tVal.y = 10; tVal.resize(120, 20);\n    tVal.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n    row.appendChild(tVal);\n\n    const tChg = figma.createText();\n    tChg.fontName = { family: \"Roboto\", style: \"Medium\" };\n    tChg.fontSize = 11; tChg.characters = p.chg;\n    tChg.textAlignHorizontal = \"RIGHT\";\n    tChg.x = 210; tChg.y = 32; tChg.resize(120, 16);\n    tChg.fills = [{ type: \"SOLID\", color: p.isGain ? GAIN : LOSS }];\n    row.appendChild(tChg);\n\n    f7.appendChild(row);\n    portY += 66;\n  });\n\n  // Attach Trade Nav\n  const nav7 = createTradeNavComponent(\"Home\");\n  nav7.x = 0; nav7.y = 760;\n  f7.appendChild(nav7);\n\n\n  // -------------------------------------------------------------\n  // FRAME 8: 08_Market\n  // -------------------------------------------------------------\n  const f8 = figma.createFrame();\n  f8.name = \"08_Market\";\n  f8.resize(390, 844);\n  f8.x = 860; f8.y = 900;\n  f8.fills = [{ type: \"SOLID\", color: BG_LIGHT }];\n  attachShell(f8);\n\n  // Header: Copy \"Market\", search \"Search coin\", filter icon\n  const header8 = figma.createFrame();\n  header8.resize(342, 44);\n  header8.x = 24; header8.y = 52;\n  header8.fills = [];\n\n  const titleMkt = figma.createText();\n  titleMkt.fontName = { family: \"Poppins\", style: \"Bold\" };\n  titleMkt.fontSize = 20; titleMkt.characters = \"Market\";\n  titleMkt.x = 0; titleMkt.y = 8;\n  titleMkt.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n  header8.appendChild(titleMkt);\n\n  const icFilt8 = getComponent(\"2:85\");\n  if (icFilt8) { icFilt8.x = 306; icFilt8.y = 10; header8.appendChild(icFilt8); }\n  f8.appendChild(header8);\n\n  // Search input: \"Search coin\"\n  const searchBar8 = figma.createFrame();\n  searchBar8.resize(342, 40);\n  searchBar8.x = 24; searchBar8.y = 104;\n  searchBar8.cornerRadius = 20;\n  searchBar8.fills = [{ type: \"SOLID\", color: SURFACE_WHITE }];\n\n  const icSrch8 = getComponent(\"2:95\");\n  if (icSrch8) { icSrch8.x = 12; icSrch8.y = 8; searchBar8.appendChild(icSrch8); }\n\n  const txtSrch8 = figma.createText();\n  txtSrch8.fontName = { family: \"Poppins\", style: \"Regular\" };\n  txtSrch8.fontSize = 13; txtSrch8.characters = \"Search coin\";\n  txtSrch8.x = 42; txtSrch8.y = 10;\n  txtSrch8.fills = [{ type: \"SOLID\", color: TEXT_MUTED }];\n  searchBar8.appendChild(txtSrch8);\n  f8.appendChild(searchBar8);\n\n  // Tabs: Favorites / Spot / Futures / Zones / Others (current: Favorites)\n  const tabsRow8 = figma.createFrame();\n  tabsRow8.resize(342, 32);\n  tabsRow8.x = 24; tabsRow8.y = 154;\n  tabsRow8.fills = [];\n  tabsRow8.layoutMode = \"HORIZONTAL\";\n  tabsRow8.itemSpacing = 16;\n\n  const tabs8List = [\"Favorites\", \"Spot\", \"Futures\", \"Zones\", \"Others\"];\n  tabs8List.forEach(tStr => {\n    const isFav = tStr === \"Favorites\";\n    const tabItem = figma.createText();\n    tabItem.fontName = { family: \"Poppins\", style: isFav ? \"Bold\" : \"Medium\" };\n    tabItem.fontSize = 14; tabItem.characters = tStr;\n    tabItem.fills = [{ type: \"SOLID\", color: isFav ? BRAND : TEXT_MUTED }];\n    tabsRow8.appendChild(tabItem);\n  });\n  f8.appendChild(tabsRow8);\n\n  // 9 Coins list: BTC, ETH, USDT, BNB, ADA, XRP, SOL, DOT, AVAX\n  const coins9Data = [\n    { ticker: \"BTC\", name: \"Bitcoin\", price: \"$29,198.24\", chg: \"+3.73%\", vol: \"2.8B\", isGain: true },\n    { ticker: \"ETH\", name: \"Ethereum\", price: \"$1,850.12\", chg: \"−1.07%\", vol: \"1.1B\", isGain: false },\n    { ticker: \"USDT\", name: \"TetherUS\", price: \"$1.00\", chg: \"+0.01%\", vol: \"41.2B\", isGain: true },\n    { ticker: \"BNB\", name: \"BNB\", price: \"$241.30\", chg: \"+0.62%\", vol: \"412.5M\", isGain: true },\n    { ticker: \"ADA\", name: \"Cardano\", price: \"$0.2874\", chg: \"−0.62%\", vol: \"186.0M\", isGain: false },\n    { ticker: \"XRP\", name: \"Ripple\", price: \"$0.49