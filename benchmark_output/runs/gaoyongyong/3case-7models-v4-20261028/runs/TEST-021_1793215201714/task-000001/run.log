{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_29894fdee61f46c3ac31b2d7","name":"mcp__figma__use_figma","input":{"code":"const page = await figma.getNodeByIdAsync('2002:2');\nawait figma.setCurrentPageAsync(page);\n// page was empty before this session; remove partial artifacts from failed run\npage.children.slice().forEach(n=>n.remove());\nfor (const f of [['DM Sans','Regular'],['DM Sans','Medium'],['DM Sans','Bold'],['Inter','Regular'],['Inter','Medium'],['Inter','Semi Bold'],['Inter','Bold']]) await figma.loadFontAsync({family:f[0],style:f[1]});\n\nconst C = {\n primary:{r:0x31/255,g:0xA0/255,b:0x62/255},\n tint:{r:0xE7/255,g:0xF5/255,b:0xEE/255},\n ink:{r:0x1B/255,g:0x23/255,b:0x20/255},\n ink2:{r:0x5F/255,g:0x6B/255,b:0x64/255},\n ink3:{r:0x99/255,g:0xA3/255,b:0x9D/255},\n border:{r:0xE2/255,g:0xE7/255,b:0xE4/255},\n fieldStroke:{r:0xC9/255,g:0xD2/255,b:0xCC/255},\n divider:{r:0xEE/255,g:0xF1/255,b:0xEF/255},\n bg:{r:0xF6/255,g:0xF8/255,b:0xF7/255},\n white:{r:1,g:1,b:1},\n danger:{r:0xE5/255,g:0x48/255,b:0x4D/255},\n dis:{r:0xA2/255,g:0xD4/255,b:0xB9/255}\n};\nfunction S(hex,op){const c={color:hex,type:'SOLID'}; if(op!==undefined)c.opacity=op; return [c];}\nfunction T(chars,fam,style,size,hex,op){const t=figma.createText(); t.fontName={family:fam,style}; t.characters=chars; t.fontSize=size; t.fills=S(hex,op); return t;}\nfunction FR(name,w,h){const f=figma.createFrame(); f.name=name; f.resize(w,h); f.fills=[]; f.clipsContent=false; return f;}\nfunction paint(node,hex,op){ if('fills' in node && Array.isArray(node.fills)) node.fills=node.fills.map(f=>f.type==='SOLID'?Object.assign({},f,{color:hex,opacity:(op===undefined?f.opacity:op)}):f); if('strokes' in node && Array.isArray(node.strokes)) node.strokes=node.strokes.map(s=>s.type==='SOLID'?Object.assign({},s,{color:hex,opacity:(op===undefined?s.opacity:op)}):s); if('children' in node) node.children.forEach(c=>paint(c,hex,op)); }\nfunction toComp(f){const c=figma.createComponentFromNode(f); return c;}\n\nconst ids = {};\nconst ICX = 2500;\nconst title = T('MY COMPONENTS — Paradise Invest UI Kit','DM Sans','Bold',24,C.ink);\ntitle.x=ICX; title.y=0; page.appendChild(title);\n\nconst sb = (await figma.getNodeByIdAsync('48:43')).clone();\nsb.name='Shell / Status Bar (Light)'; page.appendChild(sb); sb.x=ICX; sb.y=60;\nsb.fills=[]; paint(sb,C.white);\nconst hi = (await figma.getNodeByIdAsync('48:54')).clone();\nhi.name='Shell / Home Indicator (Light)'; page.appendChild(hi); hi.x=ICX; hi.y=130;\nhi.fills=[]; paint(hi,C.white);\nids.sbLight=sb.id; ids.hiLight=hi.id;\n\nconst b2 = FR('Btn / Secondary',354,60);\nb2.fills=S(C.white); b2.cornerRadius=20; b2.strokes=S(C.border); b2.strokeWeight=1.2;\nconst b2l=T('Label','Inter','Semi Bold',17,C.ink); b2l.resize(354,21); b2l.textAlignHorizontal='CENTER'; b2l.x=0; b2l.y=19; b2.appendChild(b2l);\npage.appendChild(b2); b2.x=ICX; b2.y=200;\nconst cB2=toComp(b2); cB2.name='Btn / Secondary'; ids.btnSecondary=cB2.id;\n\nconst b3 = FR('Btn / Disabled',354,60);\nb3.fills=S(C.dis); b3.cornerRadius=20;\nconst b3l=T('Label','Inter','Semi Bold',17,C.white); b3l.resize(354,21); b3l.textAlignHorizontal='CENTER'; b3l.x=0; b3l.y=19; b3.appendChild(b3l);\npage.appendChild(b3); b3.x=ICX; b3.y=280;\nconst cB3=toComp(b3); cB3.name='Btn / Disabled'; ids.btnDisabled=cB3.id;\n\nfunction makeInput(name,chars,strokeHex,wgt,trailing,y){\n  const f=FR(name,354,60);\n  f.fills=S(C.white); f.cornerRadius=20; f.strokes=S(strokeHex); f.strokeWeight=wgt; f.clipsContent=true;\n  const v=T(chars,'Inter','Regular',17,C.ink); v.x=24; v.y=20; f.appendChild(v);\n  if(trailing){const tr=T(trailing,'Inter','Semi Bold',15,C.primary); tr.x=354-24-tr.width; tr.y=21; f.appendChild(tr);}\n  page.appendChild(f); f.x=ICX; f.y=y;\n  return toComp(f);\n}\nconst iF=makeInput('Input / Filled','Value',C.fieldStroke,1,null,380); ids.inputFilled=iF.id;\nconst iE=makeInput('Input / Error','Value',C.danger,1.5,null,460); ids.inputError=iE.id;\nconst iP=makeInput('Input / Password','••••••••',C.fieldStroke,1,'Show',540); ids.inputPassword=iP.id;\n\nconst hd = FR('Header / Pushed',414,56);\nconst bk=(await figma.getNodeByIdAsync('6:275')).createInstance(); paint(bk,C.ink); bk.x=30; bk.y=21; hd.appendChild(bk);\nconst ht=T('Title','DM Sans','Bold',20,C.ink); ht.x=58; ht.y=16; hd.appendChild(ht);\npage.appendChild(hd); hd.x=ICX; hd.y=640;\nconst cHd=toComp(hd); cHd.name='Header / Pushed'; ids.headerPushed=cHd.id;\n\nconst iconIds={home:'6:269',prod:'6:270',trans:'6:271',acct:'6:272'};\nconst iconComps={};\nfor(const k in iconIds) iconComps[k]=await figma.getNodeByIdAsync(iconIds[k]);\nconst tabs=[\n {key:'home',label:'Home'},\n {key:'prod',label:'Product'},\n {key:'trans',label:'Transaction'},\n {key:'acct',label:'Account'}\n];\nfunction buildTab(active){\n  const f=FR('Tab Bar',414,84);\n  f.fills=S(C.white); f.clipsContent=true;\n  const div=figma.createRectangle(); div.resize(414,1); div.fills=S(C.divider); div.x=0; div.y=0; f.appendChild(div);\n  const centers=[51.75,155.25,258.75,362.25];\n  tabs.forEach((t,i)=>{\n    const col = i===active?C.primary:C.ink3;\n    const ic=iconComps[t.key].createInstance(); paint(ic,col);\n    ic.x=centers[i]-ic.width/2; ic.y=28-ic.height/2; f.appendChild(ic);\n    const lb=T(t.label,'Inter','Medium',11,col); lb.x=centers[i]-lb.width/2; lb.y=44; f.appendChild(lb);\n  });\n  return f;\n}\nconst tA=buildTab(0); page.appendChild(tA); tA.x=ICX; tA.y=740;\nconst cTA=toComp(tA); cTA.name='Active=Home'; ids.tabHome=cTA.id;\nconst tB=buildTab(3); page.appendChild(tB); tB.x=ICX+480; tB.y=740;\nconst cTB=toComp(tB); cTB.name='Active=Account'; ids.tabAccount=cTB.id;\nconst set=figma.combineAsVariants([cTA,cTB],page);\nset.name='Tab Bar'; set.x=ICX; set.y=860;\nids.tabSet=set.id;\nreturn JSON.stringify(ids);","description":"Rebuild workspace component set: tokens, light shell, buttons, inputs, pushed header, tab bar variants","fileKey":"JEkKBZ9RIeFTNfLVV0uQz5"}}],"id":"66325bd1-4f76-43e7-b112-5c3250c59739",