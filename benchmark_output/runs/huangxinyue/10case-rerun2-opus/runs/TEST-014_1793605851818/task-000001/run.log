oot.y=0; root.layoutMode='VERTICAL'; root.primaryAxisSizingMode='AUTO'; root.counterAxisSizingMode='AUTO'; root.itemSpacing=48; root.paddingTop=root.paddingBottom=root.paddingLeft=root.paddingRight=48; root.fills=[P('bg/canvas')]; root.cornerRadius=24;\nconst title=await T('Components · Budget','Heading/28 Bold','text/primary'); root.appendChild(title);\nasync function section(name){const s=AL('Section · '+name,'VERTICAL',{gap:16,ca:'MIN'}); s.appendChild(await T(name,'Overline/12 SemiBold','text/secondary')); root.appendChild(s); return s;}\nfunction setify(comps,name,sec){const set=figma.combineAsVariants(comps,sec); set.name=name; set.layoutMode='HORIZONTAL'; set.primaryAxisSizingMode='AUTO'; set.counterAxisSizingMode='AUTO'; set.itemSpacing=24; set.paddingTop=set.paddingBottom=set.paddingLeft=set.paddingRight=24; set.fills=[P('bg/surface')]; set.cornerRadius=16; set.strokes=[{type:'SOLID',color:{r:0.59,g:0.28,b:1}}]; set.dashPattern=[6,4]; return set;}\n\n// ---- Icon button\nlet sec=await section('Icon Button');\nconst ibs=[];\nfor (const st of ['Default','Pressed','Disabled']){\n  const f=AL('State='+st,'HORIZONTAL',{ps:'FIXED',cs:'FIXED',pa:'CENTER',ca:'CENTER',r:12,fill: st==='Pressed'?'state/pressed':'bg/surface'});\n  f.resize(40,40); f.strokes=[P('border/default')]; f.strokeWeight=1;\n  f.appendChild(icon('Icon_Back', st==='Disabled'?'state/disabled':'text/primary'));\n  ibs.push(comp(f));\n}\nconst ibSet=setify(ibs,'Icon Button',sec);\nconst ibDefault=ibs[0];\n// ---- Header\nsec=await section('Header');\nconst hs=[];\nfor (const act of ['Add','None']){\n  const f=AL('Action='+act,'HORIZONTAL',{ps:'FIXED',cs:'FIXED',pa:'SPACE_BETWEEN',ca:'CENTER',pad:[8,20,8,20]}); f.resize(375,56);\n  const b=ibDefault.createInstance(); b.name='Back'; f.appendChild(b);\n  const t=await T('Expenses','Title/17 SemiBold','text/primary'); t.name='Title'; t.textAlignHorizontal='CENTER'; f.appendChild(t);\n  if(act==='Add'){const a=ibDefault.createInstance(); a.name='Add'; const ic=a.findOne(n=>n.type==='INSTANCE'); ic.swapComponent(ICON['Icon_Plus']); for(const v of ic.findAll(n=>n.type==='VECTOR')) v.strokes=[P('text/primary')]; f.appendChild(a);}\n  else {const sp=figma.createFrame(); sp.name='Spacer'; sp.resize(40,40); sp.fills=[]; f.appendChild(sp);}\n  const c=comp(f); const k=c.addComponentProperty('Title','TEXT','Expenses'); t.componentPropertyReferences={characters:k}; hs.push(c);\n}\nsetify(hs,'Header',sec);\n// ---- Tab item\nsec=await section('Tab Bar');\nconst tis=[];\nfor (const st of ['Default','Current','Pressed']){\n  const f=AL('State='+st,'VERTICAL',{ps:'AUTO',cs:'FIXED',ca:'CENTER',gap:4}); f.resize(72,10);\n  const w=AL('Icon Wrap','HORIZONTAL',{ps:'FIXED',cs:'FIXED',pa:'CENTER',ca:'CENTER',r:14,fill: st==='Current'?'brand/100':(st==='Pressed'?'state/pressed':null)}); w.resize(52,28);\n  w.appendChild(icon('Icon_This_Month', st==='Current'?'brand/500':(st==='Pressed'?'text/primary':'text/tertiary')));\n  f.appendChild(w);\n  const l=await T('This Month','Caption/11 Medium', st==='Current'?'brand/500':(st==='Pressed'?'text/primary':'text/secondary')); l.name='Label';\n  if(st==='Current') l.fontName={family:'DM Sans',style:'Bold'};\n  f.appendChild(l);\n  const c=comp(f); const k=c.addComponentProperty('Label','TEXT','This Month'); l.componentPropertyReferences={characters:k}; tis.push(c);\n}\nsetify(tis,'Tab Item',sec);\n// Tab bar\nconst homeComp=await figma.getNodeByIdAsync('1:35');\nconst tb=AL('Tab Bar','VERTICAL',{ps:'AUTO',cs:'FIXED',ca:'CENTER',fill:'bg/surface',pad:[8,0,0,0]}); tb.resize(375,10);\ntb.topLeftRadius=tb.topRightRadius=24; tb.effectStyleId=ES['Elevation/2 Bar'].id;\nconst row=AL('Tabs','HORIZONTAL',{ps:'FIXED',cs:'AUTO',pa:'SPACE_BETWEEN',ca:'MIN',pad:[0,16,0,16]}); row.resize(375,10); tb.appendChild(row);\nconst tabs=[['Overview','Icon_Overview','Default'],['This Month','Icon_This_Month','Current'],['Offers','Icon_Offers','Default'],['Setting','Icon_Setting','Default']];\nfor(const [lab,ic,st] of tabs){const src=tis.find(c=>c.name==='State='+st); const i=src.createInstance(); i.name='Tab · '+lab; const pk=Object.keys(i.componentProperties).find(k=>k.startsWith('Label')); i.setProperties({[pk]:lab}); const ii=i.findOne(n=>n.type==='INSTANCE'); ii.swapComponent(ICON[ic]); for(const v of ii.findAll(n=>n.type==='VECTOR')) v.strokes=[P(st==='Current'?'brand/500':'text/tertiary')]; ii.fills=[]; row.appendChild(i);}\nconst hi=homeComp.createInstance(); tb.appendChild(hi);\nconst tbc=comp(tb); sec.appendChild(tbc);\n// ---- Segment\nsec=await section('Segmented Control');\nconst segs=[];\nfor (const st of ['Default','Current','Pressed','Disabled']){\n  const f=AL('State='+st,'HORIZONTAL',{ps:'FIXED',cs:'FIXED',pa:'CENTER',ca:'CENTER',r:10,fill: st==='Current'?'bg/surface':(st==='Pressed'?'state/pressed':null)}); f.resize(109,36);\n  if(st==='Current') f.effectStyleId=ES['Elevation/1 Card'].id;\n  const l=await T('Subscription','Label/13 Medium', st==='Current'?'brand/500':(st==='Disabled'?'state/disabled':(st==='Pressed'?'text/primary':'text/secondary'))); l.name='Label';\n  if(st==='Current') l.fontName={family:'DM Sans',style:'Bold'};\n  f.appendChild(l); const c=comp(f); const k=c.addComponentProperty('Label','TEXT','Subscription'); l.componentPropertyReferences={characters:k}; segs.push(c);\n}\nsetify(segs,'Segment',sec);\nconst sc=AL('Segmented Control','HORIZONTAL',{ps:'FIXED',cs:'AUTO',gap:0,pad:[4,4,4,4],r:12,fill:'track/default'}); sc.resize(335,10);\nfor (const [lab,st] of [['Bills','Default'],['Payments','Default'],['Subscription','Current']]){const i=segs.find(c=>c.name==='State='+st).createInstance(); i.name='Segment · '+lab; const pk=Object.keys(i.componentProperties).find(k=>k.startsWith('Label')); i.setProperties({[pk]:lab}); sc.appendChild(i); i.layoutGrow=1;}\nconst scc=comp(sc); sec.appendChild(scc);\n// ---- Period picker\nsec=await section('Period Picker');\nconst pps=[];\nfor (const st of ['Default','Pressed']){\n  const f=AL('State='+st,'HO