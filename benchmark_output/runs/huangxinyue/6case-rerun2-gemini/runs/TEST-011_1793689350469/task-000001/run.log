acters = \"Buy Now\"; bTxt.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  bTxt.x = (160 - bTxt.width) / 2; bTxt.y = 12; btnBuy.appendChild(bTxt);\n  actRow.appendChild(btnBuy);\n\n  const btnSim = figma.createFrame(); btnSim.name = \"View Similar\";\n  btnSim.resize(160, 36); btnSim.x = 0; btnSim.y = 50; btnSim.cornerRadius = 6;\n  btnSim.strokes = [{ type: 'SOLID', color: { r: 0.7, g: 0.7, b: 0.7 } }]; btnSim.fills = [];\n  const vsTxt = figma.createText(); vsTxt.fontName = { family: \"Montserrat\", style: \"Medium\" }; vsTxt.fontSize = 11; vsTxt.characters = \"View Similar\";\n  vsTxt.x = (160 - vsTxt.width) / 2; vsTxt.y = 10; btnSim.appendChild(vsTxt);\n  actRow.appendChild(btnSim);\n\n  const btnComp = figma.createFrame(); btnComp.name = \"Add to Compare\";\n  btnComp.resize(160, 36); btnComp.x = 175; btnComp.y = 50; btnComp.cornerRadius = 6;\n  btnComp.strokes = [{ type: 'SOLID', color: { r: 0.7, g: 0.7, b: 0.7 } }]; btnComp.fills = [];\n  const acTxt = figma.createText(); acTxt.fontName = { family: \"Montserrat\", style: \"Medium\" }; acTxt.fontSize = 11; acTxt.characters = \"Add to Compare\";\n  acTxt.x = (160 - acTxt.width) / 2; acTxt.y = 10; btnComp.appendChild(acTxt);\n  actRow.appendChild(btnComp);\n\n  f11.appendChild(actRow);\n\n  // Policies (Nearest Store, VIP, Return policy)\n  const polRow = figma.createFrame();\n  polRow.name = 'Policies';\n  polRow.resize(343, 60); polRow.x = 16; polRow.y = 765; polRow.cornerRadius = 8;\n  polRow.fills = [{ type: 'SOLID', color: { r: 0.96, g: 0.96, b: 0.96 } }];\n  const pol1 = figma.createText(); pol1.fontName = { family: \"Montserrat\", style: \"Medium\" }; pol1.fontSize = 10; pol1.characters = \"Nearest Store\"; pol1.x = 12; pol1.y = 22; polRow.appendChild(pol1);\n  const pol2 = figma.createText(); pol2.fontName = { family: \"Montserrat\", style: \"Medium\" }; pol2.fontSize = 10; pol2.characters = \"VIP\"; pol2.x = 130; pol2.y = 22; polRow.appendChild(pol2);\n  const pol3 = figma.createText(); pol