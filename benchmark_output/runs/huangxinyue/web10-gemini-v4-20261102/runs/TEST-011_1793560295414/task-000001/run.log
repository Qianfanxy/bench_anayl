{"type":"assistant","message":{"id":"chatcmpl-202611011913167936128128268d9d6mMifEu8E","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_6c26200a83044f44abd045121317b5ac","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Semi Bold\" });\n  await figma.loadFontAsync({ family: \"Poppins\", style: \"Bold\" });\n\n  const workspace = figma.root.children.find(p => p.name.includes(\"03\"));\n  await figma.setCurrentPageAsync(workspace);\n\n  // Helper to create instance from asset ID\n  function createAssetInstance(id) {\n    const node = figma.getNodeById(id);\n    if (!node) return figma.createFrame();\n    if (node.type === \"COMPONENT\") {\n      return node.createInstance();\n    }\n    // If it's a frame containing component, clone or create instance\n    return node.clone();\n  }\n\n  // Colors\n  const GOLD = { r: 0.7215686, g: 0.5568627, b: 0.1843137 }; // #B88E2F\n  const DARK = { r: 0.2, g: 0.2, b: 0.2 }; // #333333\n  const LIGHT_BG = { r: 0.976, g: 0.965, b: 0.945 }; // #F9F1E7\n  const WHITE = { r: 1, g: 1, b: 1 };\n  const GRAY_TEXT = { r: 0.533, g: 0.533, b: 0.533 }; // #898989\n  const GRAY_LIGHT = { r: 0.94, g: 0.94, b: 0.94 }; // #F4F5F7\n  const GRAY_BORDER = { r: 0.85, g: 0.85, b: 0.85 };\n  const RED_BADGE = { r: 0.89, g: 0.38, b: 0.38 };\n  const GREEN_BADGE = { r: 0.18, g: 0.7, b: 0.53 };\n\n  // Asset mapping\n  const mediaMap = {\n    \"Logo_Facebook\": \"13:44\", \"Logo_Furniro\": \"13:3\", \"Logo_LinkedIn\": \"13:35\", \"Logo_Twitter\": \"13:36\",\n    \"Photo_Hero\": \"13:9\", \"Photo_Page_Banner\": \"13:16\", \"Photo_Asgaard_Sofa\": \"13:4\", \"Photo_Cloud_Sofa_1\": \"13:7\",\n    \"Photo_Cloud_Sofa_2\": \"13:8\", \"Photo_Maya_Sofa\": \"13:13\", \"Photo_Outdoor_Sofa_Set\": \"13:14\",\n    \"Photo_Outdoor_Sofa_Set_Alt\": \"13:15\", \"Photo_Product_Grifo\": \"13:73\", \"Photo_Product_Leviosa\": \"13:17\",\n    \"Photo_Product_Lolito\": \"13:18\", \"Photo_Product_Muggo\": \"13:19\", \"Photo_Product_Pingky\": \"13:67\",\n    \"Photo_Product_Potty\": \"13:66\", \"Photo_Product_Respira\": \"13:20\", \"Photo_Product_Syltherine\": \"13:21\",\n    \"Photo_Stuart_Sofa\": \"13:64\", \"Photo_Inspiration_2\": \"13:10\", \"Photo_Inspiration_3\": \"13:11\",\n    \"Photo_Inspiration_Inner_Peace\": \"13:12\", \"Photo_Range_Bedroom\": \"13:22\", \"Photo_Range_Dining\": \"13:23\",\n    \"Photo_Range_Living\": \"13:24\", \"Photo_Setup_1\": \"13:69\", \"Photo_Setup_2\": \"13:72\", \"Photo_Setup_3\": \"13:58\",\n    \"Photo_Setup_4\": \"13:70\", \"Photo_Setup_5\": \"13:59\", \"Photo_Setup_6\": \"13:60\", \"Photo_Setup_7\": \"13:61\",\n    \"Photo_Setup_8\": \"13:62\", \"Photo_Setup_9\": \"13:63\", \"Photo_Blog_1\": \"13:5\", \"Photo_Blog_2\": \"13:68\",\n    \"Photo_Blog_3\": \"13:6\", \"Photo_Recent_1\": \"13:65\", \"Photo_Recent_2\": \"13:71\", \"Photo_Recent_3\": \"13:55\",\n    \"Photo_Recent_4\": \"13:56\", \"Photo_Recent_5\": \"13:57\", \"Icon_Account\": \"13:33\", \"Icon_Arrow_Right\": \"13:49\",\n    \"Icon_Calendar\": \"13:37\", \"Icon_Cart\": \"13:26\", \"Icon_Cart_Close\": \"13:39\", \"Icon_Chevron_Down\": \"13:30\",\n    \"Icon_Chevron_Right\": \"13:46\", \"Icon_Clock\": \"13:54\", \"Icon_Compare\": \"13:47\", \"Icon_Delete\": \"13:28\",\n    \"Icon_Filter\": \"13:50\", \"Icon_Grid\": \"13:48\", \"Icon_Guarantee\": \"13:42\", \"Icon_Heart\": \"13:53\",\n    \"Icon_Location\": \"13:29\", \"Icon_Phone\": \"13:32\", \"Icon_Remove\": \"13:43\", \"Icon_Search\": \"13:40\",\n    \"Icon_Share\": \"13:51\", \"Icon_Shipping\": \"13:25\", \"Icon_Star\": \"13:31\", \"Icon_Star_Half\": \"13:52\",\n    \"Icon_Support\": \"13:41\", \"Icon_Tag\": \"13:27\", \"Icon_Trophy\": \"13:38\", \"Icon_User\": \"13:45\", \"Icon_View_List\": \"13:34\"\n  };\n\n  // Helper function to build Header\n  function buildHeader(currentNav = \"Home\") {\n    const header = figma.createFrame();\n    header.name = \"Header\";\n    header.resize(1440, 100);\n    header.fills = [{ type: 'SOLID', color: WHITE }];\n\n    // Left: Logo + Name\n    const logoGroup = figma.createFrame();\n    logoGroup.name = \"Logo Group\";\n    logoGroup.layoutMode = \"HORIZONTAL\";\n    logoGroup.counterAxisAlignItems = \"CENTER\";\n    logoGroup.itemSpacing = 5;\n    logoGroup.fills = [];\n    \n    const logoInst = createAssetInstance(mediaMap[\"Logo_Furniro\"]);\n    logoGroup.appendChild(logoInst);\n\n    const titleText = figma.createText();\n    titleText.fontName = { family: \"Poppins\", style: \"Bold\" };\n    titleText.fontSize = 34;\n    titleText.characters = \"Furniro\";\n    titleText.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    logoGroup.appendChild(titleText);\n\n    logoGroup.x = 54;\n    logoGroup.y = 29;\n    header.appendChild(logoGroup);\n\n    // Center: Nav links\n    const navGroup = figma.createFrame();\n    navGroup.name = \"Navigation\";\n    navGroup.layoutMode = \"HORIZONTAL\";\n    navGroup.itemSpacing = 75;\n    navGroup.fills = [];\n\n    const navItems = [\"Home\", \"Shop\", \"About\", \"Contact\"];\n    navItems.forEach(item => {\n      const txt = figma.createText();\n      txt.name = item;\n      txt.fontSize = 16;\n      if (item === currentNav) {\n        txt.fontName = { family: \"Poppins\", style: \"Semi Bold\" };\n        txt.fills = [{ type: 'SOLID', color: GOLD }];\n      } else {\n        txt.fontName = { family: \"Poppins\", style: \"Medium\" };\n        txt.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n      }\n      txt.characters = item;\n      navGroup.appendChild(txt);\n    });\n\n    navGroup.x = 505;\n    navGroup.y = 38;\n    header.appendChild(navGroup);\n\n    // Right: Icons\n    const iconGroup = figma.createFrame();\n    iconGroup.name = \"Icons\";\n    iconGroup.layoutMode = \"HORIZONTAL\";\n    iconGroup.itemSpacing = 45;\n    iconGroup.fills = [];\n\n    const icons = [\"Icon_Account\", \"Icon_Search\", \"Icon_Heart\", \"Icon_Cart\"];\n    icons.forEach(ic => {\n      const inst = createAssetInstance(mediaMap[ic]);\n      iconGroup.appendChild(inst);\n    });\n\n    iconGroup.x = 1093;\n    iconGroup.y = 36;\n    header.appendChild(iconGroup);\n\n    return header;\n  }\n\n  // Helper function to build Footer\n  function buildFooter() {\n    const footer = figma.createFrame();\n    footer.name = \"Footer\";\n    footer.resize(1440, 505);\n    footer.fills = [{ type: 'SOLID', color: WHITE }];\n\n    // Top border line\n    const border = figma.createRectangle();\n    border.resize(1440, 1);\n    border.fills = [{ type: 'SOLID', color: GRAY_BORDER }];\n    border.x = 0;\n    border.y = 0;\n    footer.appendChild(border);\n\n    // Left column: Brand & Address\n    const leftCol = figma.createFrame();\n    leftCol.name = \"Brand Col\";\n    leftCol.layoutMode = \"VERTICAL\";\n    leftCol.itemSpacing = 50;\n    leftCol.fills = [];\n\n    const brandName = figma.createText();\n    brandName.fontName = { family: \"Poppins\", style: \"Bold\" };\n    brandName.fontSize = 24;\n    brandName.characters = \"Furniro.\";\n    brandName.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    leftCol.appendChild(brandName);\n\n    const addr = figma.createText();\n    addr.fontName = { family: \"Poppins\", style: \"Regular\" };\n    addr.fontSize = 16;\n    addr.characters = \"400 University Drive Suite 200\\nCoral Gables, FL 33134 USA\";\n    addr.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n    leftCol.appendChild(addr);\n\n    leftCol.x = 100;\n    leftCol.y = 48;\n    footer.appendChild(leftCol);\n\n    // Col 2: Links\n    const linksCol = figma.createFrame();\n    linksCol.name = \"Links Col\";\n    linksCol.layoutMode = \"VERTICAL\";\n    linksCol.itemSpacing = 46;\n    linksCol.fills = [];\n\n    const linksHead = figma.createText();\n    linksHead.fontName = { family: \"Poppins\", style: \"Medium\" };\n    linksHead.fontSize = 16;\n    linksHead.characters = \"Links\";\n    linksHead.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n    linksCol.appendChild(linksHead);\n\n    const linksList = figma.createFrame();\n    linksList.layoutMode = \"VERTICAL\";\n    linksList.itemSpacing = 46;\n    linksList.fills = [];\n\n    [\"Home\", \"Shop\", \"About\", \"Contact\", \"Blog\"].forEach(l => {\n      const t = figma.createText();\n      t.name = l;\n      t.fontName = { family: \"Poppins\", style: \"Medium\" };\n      t.fontSize = 16;\n      t.characters = l;\n      t.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n      linksList.appendChild(t);\n    });\n    linksCol.appendChild(linksList);\n\n    linksCol.x = 523;\n    linksCol.y = 48;\n    footer.appendChild(linksCol);\n\n    // Col 3: Help\n    const helpCol = figma.createFrame();\n    helpCol.name = \"Help Col\";\n    helpCol.layoutMode = \"VERTICAL\";\n    helpCol.itemSpacing = 46;\n    helpCol.fills = [];\n\n    const helpHead = figma.createText();\n    helpHead.fontName = { family: \"Poppins\", style: \"Medium\" };\n    helpHead.fontSize = 16;\n    helpHead.characters = \"Help\";\n    helpHead.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n    helpCol.appendChild(helpHead);\n\n    const helpList = figma.createFrame();\n    helpList.layoutMode = \"VERTICAL\";\n    helpList.itemSpacing = 46;\n    helpList.fills = [];\n\n    [\"Payment Options\", \"Returns\", \"Privacy Policies\"].forEach(l => {\n      const t = figma.createText();\n      t.name = l;\n      t.fontName = { family: \"Poppins\", style: \"Medium\" };\n      t.fontSize = 16;\n      t.characters = l;\n      t.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n      helpList.appendChild(t);\n    });\n    helpCol.appendChild(helpList);\n\n    helpCol.x = 710;\n    helpCol.y = 48;\n    footer.appendChild(helpCol);\n\n    // Col 4: Newsletter\n    const newsCol = figma.createFrame();\n    newsCol.name = \"Newsletter Col\";\n    newsCol.layoutMode = \"VERTICAL\";\n    newsCol.itemSpacing = 46;\n    newsCol.fills = [];\n\n    const newsHead = figma.createText();\n    newsHead.fontName = { family: \"Poppins\", style: \"Medium\" };\n    newsHead.fontSize = 16;\n    newsHead.characters = \"Newsletter\";\n    newsHead.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n    newsCol.appendChild(newsHead);\n\n    const formRow = figma.createFrame();\n    formRow.layoutMode = \"HORIZONTAL\";\n    formRow.itemSpacing = 11;\n    formRow.fills = [];\n\n    const inputWrap = figma.createFrame();\n    inputWrap.layoutMode = \"VERTICAL\";\n    inputWrap.itemSpacing = 3;\n    inputWrap.fills = [];\n    const inputTxt = figma.createText();\n    inputTxt.fontName = { family: \"Poppins\", style: \"Regular\" };\n    inputTxt.fontSize = 14;\n    inputTxt.characters = \"Enter Your Email Address\";\n    inputTxt.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n    inputWrap.appendChild(inputTxt);\n    const line1 = figma.createRectangle();\n    line1.resize(200, 1);\n    line1.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    inputWrap.appendChild(line1);\n    formRow.appendChild(inputWrap);\n\n    const btnWrap = figma.createFrame();\n    btnWrap.layoutMode = \"VERTICAL\";\n    btnWrap.itemSpacing = 3;\n    btnWrap.fills = [];\n    const btnTxt = figma.createText();\n    btnTxt.fontName = { family: \"Poppins\", style: \"Medium\" };\n    btnTxt.fontSize = 14;\n    btnTxt.characters = \"SUBSCRIBE\";\n    btnTxt.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    btnWrap.appendChild(btnTxt);\n    const line2 = figma.createRectangle();\n    line2.resize(75, 1);\n    line2.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    btnWrap.appendChild(line2);\n    formRow.appendChild(btnWrap);\n\n    newsCol.appendChild(formRow);\n\n    newsCol.x = 948;\n    newsCol.y = 48;\n    footer.appendChild(newsCol);\n\n    // Bottom copyright line\n    const copyLine = figma.createRectangle();\n    copyLine.resize(1240, 1);\n    copyLine.fills = [{ type: 'SOLID', color: GRAY_BORDER }];\n    copyLine.x = 100;\n    copyLine.y = 430;\n    footer.appendChild(copyLine);\n\n    const copyright = figma.createText();\n    copyright.fontName = { family: \"Poppins\", style: \"Regular\" };\n    copyright.fontSize = 16;\n    copyright.characters = \"2023 Furniro. All rights reserved\";\n    copyright.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    copyright.x = 100;\n    copyright.y = 450;\n    footer.appendChild(copyright);\n\n    return footer;\n  }\n\n  // Helper function to build Features strip\n  function buildFeaturesStrip() {\n    const strip = figma.createFrame();\n    strip.name = \"Features Strip\";\n    strip.resize(1440, 270);\n    strip.fills = [{ type: 'SOLID', color: LIGHT_BG }];\n    strip.layoutMode = \"HORIZONTAL\";\n    strip.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    strip.counterAxisAlignItems = \"CENTER\";\n    strip.paddingLeft = 53;\n    strip.paddingRight = 53;\n\n    const features = [\n      { icon: \"Icon_Trophy\", title: \"High Quality\", desc: \"crafted from top materials\" },\n      { icon: \"Icon_Guarantee\", title: \"Warranty Protection\", desc: \"Over 2 years\" },\n      { icon: \"Icon_Shipping\", title: \"Free Shipping\", desc: \"Order over Rs. 150,000\" },\n      { icon: \"Icon_Support\", title: \"24 / 7 Support\", desc: \"Dedicated support\" }\n    ];\n\n    features.forEach(f => {\n      const item = figma.createFrame();\n      item.name = f.title;\n      item.layoutMode = \"HORIZONTAL\";\n      item.itemSpacing = 10;\n      item.counterAxisAlignItems = \"CENTER\";\n      item.fills = [];\n\n      const iconInst = createAssetInstance(mediaMap[f.icon]);\n      item.appendChild(iconInst);\n\n      const textGroup = figma.createFrame();\n      textGroup.layoutMode = \"VERTICAL\";\n      textGroup.itemSpacing = 2;\n      textGroup.fills = [];\n\n      const t = figma.createText();\n      t.fontName = { family: \"Poppins\", style: \"Bold\" };\n      t.fontSize = 25;\n      t.characters = f.title;\n      t.fills = [{ type: 'SOLID', color: DARK }];\n      textGroup.appendChild(t);\n\n      const d = figma.createText();\n      d.fontName = { family: \"Poppins\", style: \"Medium\" };\n      d.fontSize = 20;\n      d.characters = f.desc;\n      d.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n      textGroup.appendChild(d);\n\n      item.appendChild(textGroup);\n      strip.appendChild(item);\n    });\n\n    return strip;\n  }\n\n  // Helper function to build Page Banner & Breadcrumb\n  function buildPageBanner(title, breadcrumbs) {\n    const banner = figma.createFrame();\n    banner.name = \"Page Title & Breadcrumb\";\n    banner.resize(1440, 316);\n    banner.fills = [];\n\n    const bgPhoto = createAssetInstance(mediaMap[\"Photo_Page_Banner\"]);\n    bgPhoto.resize(1440, 316);\n    bgPhoto.x = 0;\n    bgPhoto.y = 0;\n    banner.appendChild(bgPhoto);\n\n    const content = figma.createFrame();\n    content.name = \"Content\";\n    content.layoutMode = \"VERTICAL\";\n    content.primaryAxisAlignItems = \"CENTER\";\n    content.counterAxisAlignItems = \"CENTER\";\n    content.itemSpacing = 5;\n    content.fills = [];\n\n    const logoInst = createAssetInstance(mediaMap[\"Logo_Furniro\"]);\n    content.appendChild(logoInst);\n\n    const t = figma.createText();\n    t.fontName = { family: \"Poppins\", style: \"Medium\" };\n    t.fontSize = 48;\n    t.characters = title;\n    t.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n    content.appendChild(t);\n\n    // Breadcrumbs row\n    const bcRow = figma.createFrame();\n    bcRow.layoutMode = \"HORIZONTAL\";\n    bcRow.itemSpacing = 6;\n    bcRow.counterAxisAlignItems = \"CENTER\";\n    bcRow.fills = [];\n\n    breadcrumbs.forEach((bc, idx) => {\n      const bcTxt = figma.createText();\n      bcTxt.fontName = { family: \"Poppins\", style: idx === breadcrumbs.length - 1 ? \"Light\" : \"Bold\" };\n      bcTxt.fontSize = 16;\n      bcTxt.characters = bc;\n      bcTxt.fills = [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }];\n      bcRow.appendChild(bcTxt);\n\n      if (idx < breadcrumbs.length - 1) {\n        const arr = createAssetInstance(mediaMap[\"Icon_Chevron_Right\"]);\n        bcRow.appendChild(arr);\n      }\n    });\n    content.appendChild(bcRow);\n\n    content.x = (1440 - content.width) / 2;\n    content.y = (316 - content.height) / 2;\n    banner.appendChild(content);\n\n    return banner;\n  }\n\n  // Helper function to build Product Card\n  const productDataList = [\n    { name: \"Syltherine\", desc: \"Stylish cafe chair\", price: \"Rs. 2,500,000.00\", oldPrice: \"Rs. 3,500,000.00\", badge: \"-30%\", badgeType: \"sale\", photo: \"Photo_Product_Syltherine\" },\n    { name: \"Leviosa\", desc: \"Stylish cafe chair\", price: \"Rs. 2,500,000.00\", oldPrice: null, badge: null, photo: \"Photo_Product_Leviosa\" },\n    { name: \"Lolito\", desc: \"Luxury big sofa\", price: \"Rs. 7,000,000.00\", oldPrice: \"Rs. 14,000,000.00\", badge: \"-50%\", badgeType: \"sale\", photo: \"Photo_Product_Lolito\" },\n    { name: \"Respira\", desc: \"Outdoor bar table and stool\", price: \"Rs. 500,000.00\", oldPrice: null, badge: \"New\", badgeType: \"new\", photo: \"Photo_Product_Respira\" },\n    { name: \"Grifo\", desc: \"Night lamp\", price: \"Rs. 1,500,000.00\", oldPrice: null, badge: null, photo: \"Photo_Product_Grifo\" },\n    { name: \"Muggo\", desc: \"Small mug\", price: \"Rs. 150,000.00\", oldPrice: null, badge: \"New\", badgeType: \"new\", photo: \"Photo_Product_Muggo\" },\n    { name: \"Pingky\", desc: \"Cute bed set\", price: \"Rs. 7,000,000.00\", oldPrice: \"Rs. 14,000,000.00\", badge: \"-50%\", badgeType: \"sale\", photo: \"Photo_Product_Pingky\" },\n    { name: \"Potty\", desc: \"Minimalist flower pot\", price: \"Rs. 500,000.00\", oldPrice: null, badge: \"New\", badgeType: \"new\", photo: \"Photo_Product_Potty\" }\n  ];\n\n  function buildProductCard(data, isHover = false) {\n    const card = figma.createFrame();\n    card.name = `Product Card - ${data.name}${isHover ? \" (Hover)\" : \"\"}`;\n    card.resize(285, 446);\n    card.fills = [{ type: 'SOLID', color: GRAY_LIGHT }];\n    card.clipsContent = true;\n\n    // Photo\n    const photo = createAssetInstance(mediaMap[data.photo]);\n    photo.resize(285, 301);\n    photo.x = 0;\n    photo.y = 0;\n    card.appendChild(photo);\n\n    // Badge if given\n    if (data.badge) {\n      const badge = figma.createFrame();\n      badge.resize(48, 48);\n      badge.cornerRadius = 24;\n      badge.fills = [{ type: 'SOLID', color: data.badgeType === 'sale' ? RED_BADGE : GREEN_BADGE }];\n      const badgeTxt = figma.createText();\n      badgeTxt.fontName = { family: \"Poppins\", style: \"Medium\" };\n      badgeTxt.fontSize = 16;\n      badgeTxt.characters = data.badge;\n      badgeTxt.fills = [{ type: 'SOLID', color: WHITE }];\n      badge.appendChild(badgeTxt);\n      badgeTxt.x = (48 - badgeTxt.width) / 2;\n      badgeTxt.y = (48 - badgeTxt.height) / 2;\n      badge.x = 221;\n      badge.y = 24;\n      card.appendChild(badge);\n    }\n\n    // Info area\n    const info = figma.createFrame();\n    info.name = \"Info\";\n    info.resize(285, 145);\n    info.x = 0;\n    info.y = 301;\n    info.fills = [{ type: 'SOLID', color: GRAY_LIGHT }];\n    info.layoutMode = \"VERTICAL\";\n    info.paddingLeft = 16;\n    info.paddingRight = 16;\n    info.paddingTop = 16;\n    info.paddingBottom = 20;\n    info.itemSpacing = 8;\n\n    const title = figma.createText();\n    title.fontName = { family: \"Poppins\", style: \"Bold\" };\n    title.fontSize = 24;\n    title.characters = data.name;\n    title.fills = [{ type: 'SOLID', color: DARK }];\n    info.appendChild(title);\n\n    const desc = figma.createText();\n    desc.fontName = { family: \"Poppins\", style: \"Medium\" };\n    desc.fontSize = 16;\n    desc.characters = data.desc;\n    desc.fills = [{ type: 'SOLID', color: GRAY_TEXT }];\n    info.appendChild(desc);\n\n    const priceRow = figma.createFrame();\n    priceRow.layoutMode = \"HORIZONTAL\";\n    priceRow.itemSpacing = 12;\n    priceRow.counterAxisAlignItems = \"CENTER\";\n    priceRow.fills = [];\n\n    const price = figma.createText();\n    price.fontName = { family: \"Poppins\", style: \"Bold\" };\n    price.fontSize = 20;\n    price.characters = data.price;\n    price.fills = [{ type: 'SOLID', color: DARK }];\n    priceRow.appendChild(price);\n\n    if (data.oldPrice) {\n      const oldPrice = figma.createText();\n      oldPrice.fontName = { family: \"Poppins\", style: \"Regular\" };\n      oldPrice.fontSize = 16;\n      oldPrice.characters = data.oldPrice;\n      oldPrice.textDecoration = \"STRIKETHROUGH\";\n      oldPrice.fills = [{ type: 'SOLID', color: { r: 0.7, g: 0.7, b: 0.7 } }];\n      priceRow.appendChild(oldPrice);\n    }\n    info.appendChild(priceRow);\n    card.appendChild(info);\n\n    // Hover overlay if requested\n    if (isHover) {\n      const overlay = figma.createFrame();\n      overlay.name = \"Hover Overlay\";\n      overlay.resize(285, 446);\n      overlay.x = 0;\n      overlay.y = 0;\n      overlay.fills = [{ type: 'SOLID', color: { r: 0.2, g: 0.2, b: 0.2 }, opacity: 0.72 }];\n\n      const contentGroup = figma.createFrame();\n      contentGroup.layoutMode = \"VERTICAL\";\n      contentGroup.counterAxisAlignItems = \"CENTER\";\n      contentGroup.itemSpacing = 24;\n      contentGroup.fills = [];\n\n      // Add to cart button\n      const btn = figma.createFrame();\n      btn.name = \"Add to cart\";\n      btn.resize(202, 48);\n      btn.fills = [{ type: 'SOLID', color: WHITE }];\n      const btnTxt = figma.createText();\n      btnTxt.fontName = { family: \"Poppins\", style: \"Bold\" };\n      btnTxt.fontSize = 16;\n      btnTxt.characters = \"Add to cart\";\n      btnTxt.fills = [{ type: 'SOLID', color: GOLD }];\n      btn.appendChild(btnTxt);\n      btnTxt.x = (202 - btnTxt.width) / 2;\n      btnTxt.y = (48 - btnTxt.height) / 2;\n      contentGroup.appendChild(btn);\n\n      // Actions row (Share, Compare, Like)\n      const actRow = figma.createFrame();\n      actRow.layoutMode = \"HORIZONTAL\";\n      actRow.itemSpacing = 20;\n      actRow.counterAxisAlignItems = \"CENTER\";\n      actRow.fills = [];\n\n      const actions = [\n        { icon: \"Icon_Share\", label: \"Share\" },\n        { icon: \"Icon_Compare\", label: \"Compare\" },\n        { icon: \"Icon_Heart\", label: \"Like\" }\n      ];\n\n      actions.forEach(a => {\n        const item = figma.createFrame();\n        item.name = a.label;\n        item.layoutMode = \"HORIZONTAL\";\n        item.itemSpacing = 4;\n        item.counterAxisAlignItems = \"CENTER\";\n        item.fills = [];\n\n        const ic = createAssetInstance(mediaMap[a.icon]);\n        item.appendChild(ic);\n\n        const lbl = figma.createText();\n        lbl.fontName = { family: \"Poppins\", style: \"Bold\" };\n        lbl.fontSize = 16;\n        lbl.characters = a.label;\n        lbl.fills = [{ type: 'SOLID', color: WHITE }];\n        item.appendChild(lbl);\n\n        actRow.appendChild(item);\n      });\n      contentGroup.appendChild(actRow);\n\n      contentGroup.x = (285 - contentGroup.width) / 2;\n      contentGroup.y = (446 - contentGroup.height) / 2;\n      overlay.appendChild(contentGroup);\n      card.appendChild(overlay);\n    }\n\n    return card;\n  }\n\n  return \"Helper functions created successfully\";\n})();","description":"Define helper functions for header, footer, features strip, page banner, and product cards","fileKey":"lyAJXJy8GatyIPzWRh2m00"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":38236,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":35867},"context_management":null},"parent_tool_use_id":null,"session_id":"68369d55-e3dd-4325-b303-55296225c818","uuid":"5555c8c0-6619-4711-9c41-acdeef1b586b","timestamp":"2026-11-01T19:13:51.524Z","tool_use_meta":[{"id":"call_6c26200a83044f44abd045121317b5ac","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
