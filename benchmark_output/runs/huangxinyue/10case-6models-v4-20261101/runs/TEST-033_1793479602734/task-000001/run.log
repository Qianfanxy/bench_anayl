tt.layoutGrow=1;\nconst t24=figma.createText(); t24.fontName={family:'Roboto',style:'Regular'}; t24.fontSize=12; t24.characters='24 jam'; t24.fills=[solid(C.sec)]; th.appendChild(t24);\nconst cd=R.chevD.createInstance(); th.appendChild(cd); cd.rescale(14/24); { const v=cd.findOne(n=>n.type==='VECTOR'); if(v)v.fills=[solid(C.sec)]; }\nconst ls=figma.createText(); ls.fontName={family:'Roboto',style:'Medium'}; ls.fontSize=13; ls.characters='Lihat Semua'; ls.fills=[solid(C.brandB)]; th.appendChild(ls); \n{ const sp=figma.createFrame(); sp.fills=[]; sp.resize(4,4); th.appendChild(sp); }\nconst cr=R.chevR.createInstance(); th.appendChild(cr); cr.rescale(14/24); { const v=cr.findOne(n=>n.type==='VECTOR'); if(v)v.fills=[solid(C.sec)]; }\n\nconst tdata=[\n  ['ROTI','Nippon Indosari Tbk','8.600','+50 (+0,58%)',R.L_ROTI,false],\n  ['GOTO','GoTo Gojek Tokopedia','189','−9 (−4,55%)',R.L_GOTO,true],\n  ['ABNB','Airbnb Inc','5.300','+31 (+0,59%)',R.L_ABNB,false],\n  ['UNVR','Unilever Indonesia','3.867','−71 (−1,80%)',R.L_UNVR,true],\n  ['BBRI','Bank Rakyat Indonesia','4.630','+38 (+0,83%)',R.L_BBRI,false],\n  ['ADRO','Adaro Energy Indonesia','3.600','+21 (+0,59%)',R.L_ADRO,false]\n];\ntdata.forEach((d,i)=>{\n  const r=R.row.createInstance(); f.appendChild(r); r.x=16; r.y=404+i*50;\n  txt(r,'Ticker').characters=d[0]; txt(r,'Company').characters=d[1]; txt(r,'Price').characters=d[2]; txt(r,'Change').characters=d[3];\n  const l=r.findOne(n=>n.name==='Logo'); l.swapComponent(d[4]);\n  if(d[5]) txt(r,'Change').fills=[solid(C.loss)];\n});\n\nconst tb=R.tabbar.createInstance(); f.appendChild(tb); tb.x=0; tb.y=714;\ntb.findOne(n=>n.name==='Tab / Trending').setProperties({State:'Active'});\nconst hi=R.home.createInstance(); f.appendChild(hi); hi.x=0; hi.y=778;\n\nreturn 'OK 02_Trending id='+f.id;","description":"Build screen 02_Trending with indices, chips, recommendation cards and stock rows","fileKey":"K1JM8KrV8Si1stciFJqXfQ"}}],"id":"67d4eb26-2448-4c9d-9b63-9c54d57206aa","model":"glm-5.3