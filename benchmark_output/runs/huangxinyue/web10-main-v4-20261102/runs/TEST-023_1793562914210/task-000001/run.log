{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgNeu1obIPmM12lYvM5RI","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01P2Y4NCuIv44MGMygpfsOfY","name":"mcp__figma__use_figma","input":{"code":"\n// ---------- helpers ----------\nconst P = {ink:'#0A0A0A', body:'#5A5A60', muted:'#97979D', line:'#E7E4DE', cream:'#F7F4EF', sand:'#EDE6DA', sale:'#A93A32', gold:'#DCA84A', green:'#3C7A5D', white:'#FFFFFF'};\nfunction rgb(h){h=h.replace('#','');return {r:parseInt(h.substr(0,2),16)/255,g:parseInt(h.substr(2,2),16)/255,b:parseInt(h.substr(4,2),16)/255};}\nfunction fill(h,o){return [{type:'SOLID',color:rgb(h),opacity:o===undefined?1:o}];}\nfor (const s of ['Regular','Medium','SemiBold','Bold','Light']) await figma.loadFontAsync({family:'Poppins',style:s});\nawait figma.loadFontAsync({family:'Volkhov',style:'Bold'});\nawait figma.loadFontAsync({family:'Volkhov',style:'Regular'});\n\nconst ws = await figma.getNodeByIdAsync('8:2');\nawait figma.setCurrentPageAsync(ws);\nconst old = ws.children.find(n=>n.name==='TEMP'); if(old) old.remove();\nconst lib = figma.createFrame(); lib.name='Components · FASCO system'; lib.x=0; lib.y=12800; lib.resize(1600,3000);\nlib.fills=fill(P.white); lib.strokes=fill(P.line); lib.strokeWeight=1; lib.clipsContent=false;\n\nfunction box(parent,name,x,y,w,h,opt){opt=opt||{};const f=figma.createFrame();parent.appendChild(f);f.name=name;f.x=x;f.y=y;f.resize(w,h);f.fills=opt.fill===undefined?[]:fill(opt.fill,opt.opacity);f.strokes=opt.stroke?[{type:'SOLID',color:rgb(opt.stroke),opacity:1}]:[];if(opt.stroke)f.strokeWeight=opt.sw||1;f.cornerRadius=opt.r||0;\n if(opt.radiusCorners){f.cornerRadius=0;f.topLeftRadius=opt.radiusCorners[0];f.topRightRadius=opt.radiusCorners[1];f.bottomRightRadius=opt.radiusCorners[2];f.bottomLeftRadius=opt.radiusCorners[3];}\n if(opt.layout){f.layoutMode=opt.layout;f.itemSpacing=opt.gap||0;f.paddingLeft=opt.padX||0;f.paddingRight=opt.padX||0;f.paddingTop=opt.padY||0;f.paddingBottom=opt.padY||0;f.primaryAxisAlignItems=opt.align||'MIN';f.counterAxisAlignItems=opt.cross||'CENTER';}\n return f;}\nfunction tx(parent,name,x,y,spec){const t=figma.createText();parent.appendChild(t);t.name=name;t.fontName={family:spec.f||'Poppins',style:spec.w||'Regular'};t.characters=spec.t;t.fontSize=spec.s||16;if(spec.lh)t.lineHeight={value:spec.lh,unit:'PIXELS'};if(spec.ls)t.letterSpacing={value:spec.ls,unit:'PIXELS'};t.fills=fill(spec.c||P.ink);if(spec.align)t.textAlignHorizontal=spec.align;if(spec.width){t.textAutoResize='HEIGHT';t.resize(spec.width,t.height);}if(spec.upper)t.textCase='UPPER';t.x=x;t.y=y;return t;}\nfunction comp(parent,name,w,h){const c=figma.createComponent();parent.appendChild(c);c.name=name;c.resize(w,h);c.fills=[];return c;}\nfunction icon(parent,name,x,y,size,color){const src=figma.getNodeByIdAsync?null:null;return null;}\n\n// ---------- Button variants (built on the given Button) ----------\nconst baseBtn = await figma.getNodeByIdAsync('1:24');\nconst btnRow = box(lib,'Buttons',40,40,1100,260,{});\nconst prim = baseBtn.createInstance(); btnRow.appendChild(prim); prim.name='Button / Primary'; prim.x=0; prim.y=0;\nlet ptxt = prim.findOne(n=>n.type==='TEXT'); ptxt.characters='Shop Now'; ptxt.fontSize=15; ptxt.letterSpacing={value:0.3,unit:'PIXELS'};\n// outline variant\nconst outline = baseBtn.createInstance(); btnRow.appendChild(outline); outline.name='Button / Outline'; outline.x=280; outline.y=0;\noutline.fills=fill(P.white); outline.strokes=[{type:'SOLID',color:rgb(P.ink),opacity:1}]; outline.strokeWeight=1; outline.strokeAlign='INSIDE';\nlet otxt = outline.findOne(n=>n.type==='TEXT'); otxt.characters='View More'; otxt.fontSize=15;\n// light variant\nconst light = baseBtn.createInstance(); btnRow.appendChild(light); light.name='Button / Light'; light.x=560; light.y=0;\nlight.fills=fill(P.white); let ltxt=light.findOne(n=>n.type==='TEXT'); ltxt.characters='Subscribed';\n// secondary (cream)\nconst cream = baseBtn.createInstance(); btnRow.appendChild(cream); cream.name='Button / Soft'; cream.x=840; cream.y=0;\ncream.fills=fill(P.cream); let ctxt=cream.findOne(n=>n.type==='TEXT'); ctxt.characters='Apply';\n// text link\nconst link = tx(btnRow,'Link / Text',0,90,{t:'Forgot Password?',s:14,w:'Medium',c:P.ink});\nlink.textDecoration='UNDERLINE';\n\n// ---------- Checkbox ----------\nconst cb = comp(lib,'Checkbox',260,24); cb.x=40; cb.y=330;\nconst cbb = box(cb,'Box',0,2,20,20,{stroke:'#C9C5BD',r:4,fill:P.white});\ntx(cb,'Label',32,0,{t:'For $10.00 please wrap the product',s:14,c:P.body});\n\n// ---------- Quantity stepper ----------\nconst st = comp(lib,'Quantity Stepper',132,48); st.x=40; st.y=390;\nconst stf = box(st,'Stepper',0,0,132,48,{stroke:P.line,r:10,fill:P.white});\ntx(stf,'Minus',0,0,{t:'−',s:18,c:P.body}); stf.children[0].x=16; stf.children[0].y=11;\ntx(stf,'Value',0,0,{t:'01',s:15,w:'Medium',c:P.ink}); stf.children[1].x=57; stf.children[1].y=14;\ntx(stf,'Plus',0,0,{t:'+',s:18,c:P.body}); stf.children[2].x=103; stf.children[2].y=11;\n\n// ---------- Breadcrumb ----------\nconst bc = comp(lib,'Breadcrumb',420,24); bc.x=40; bc.y=470;\nconst b1=tx(bc,'Home',0,0,{t:'Home',s:13,c:P.muted}); const b2=tx(bc,'Sep',0,0,{t:'›',s:14,c:'#C9C5BD'});\nconst b3=tx(bc,'Current',0,0,{t:'Fashion',s:13,w:'Medium',c:P.ink});\nb2.x=b1.width+10; b3.x=b2.x+b2.width+10;\n\n// ---------- Testimonial card ----------\nconst tc = comp(lib,'Card / Testimonial',480,300); tc.x=40; tc.y=560;\nconst tcb = box(tc,'Surface',0,0,480,300,{fill:P.cream,r:20});\ntx(tcb,'Quote',40,40,{t:'“You won’t regret it. I would like to personally thank you for your outstanding product. Absolutely wonderful!”',s:17,lh:30,c:P.ink,width:400});\ntx(tcb,'Name',40,214,{t:'James K.',s:16,w:'SemiBold',c:P.ink});\ntx(tcb,'Role',40,240,{t:'Traveler',s:13,c:P.body});\nbox(tcb,'AvatarSlot',396,206,56,56,{fill:'#DCD8D0',r:28});\n\n// ---------- Section heading ----------\nconst sh = comp(lib,'Block / Section Heading',800,140); sh.x=580; sh.y=330;\ntx(sh,'Eyebrow',0,0,{t:'CURATED FOR YOU',s:11,w:'SemiBold',ls:2,c:P.sale});\ntx(sh,'Title',0,26,{t:'New Arrivals',s:44,f:'Volkhov',w:'Regular',c:P.ink,lh:56});\ntx(sh,'Copy',0,96,{t:'Fresh pieces just landed: easy dresses, cosy knits and everyday shirts for the new season.',s:15,c:P.body,width:560,lh:26});\n\nreturn {lib:lib.id, prim:prim.id, btnW:prim.width, btnH:prim.height, cb:cb.id, st:st.id, bc:bc.id, tc:tc.id, sh:sh.id, primChildren:prim.children.map(c=>({n:c.name,x:c.x,w:c.width}))};\n","description":"Create component library: button variants, checkbox, stepper, breadcrumb, testimonial card, section heading","fileKey":"zj84fVMgzEUIcsaY8ScK7u"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":40966,"input_tokens":1,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":40966}},"context_management":null},"parent_tool_use_id":null,"session_id":"45b716de-dcc2-45d2-a4d3-f5e780ce57d2","uuid":"28dcc164-a839-43e7-adc6-fdeef05b1fb2","timestamp":"2026-11-01T20:01:13.908Z","tool_use_meta":[{"id":"toolu_01P2Y4NCuIv44MGMygpfsOfY","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
