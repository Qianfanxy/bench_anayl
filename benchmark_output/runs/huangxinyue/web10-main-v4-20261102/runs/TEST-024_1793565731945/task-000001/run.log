Mode='AUTO';n.counterAxisSizingMode='AUTO';n.resize(o.w===undefined?100:o.w,o.h===undefined?100:o.h);if(o.w!==undefined&&!o.hugW){n.counterAxisSizingMode='FIXED';n.resize(o.w,n.height);}if(o.h!==undefined&&!o.hugH){n.primaryAxisSizingMode='FIXED';n.resize(n.width,o.h);}}\nelse{n.resize(o.w===undefined?100:o.w,o.h===undefined?100:o.h);}\nif(o.x!==undefined)n.x=o.x;if(o.y!==undefined)n.y=o.y;return n;}\nfunction text(parent,o){const t=figma.createText();t.fontName=o.font||F.reg;t.characters=o.text===undefined?'':o.text;t.fontSize=o.size||16;if(o.lh)t.lineHeight={unit:'PIXELS',value:o.lh};if(o.ls!==undefined)t.letterSpacing={unit:'PERCENT',value:o.ls};if(o.case)t.textCase='UPPER';t.fills=[paint(o.color||C.ink)];if(o.align)t.textAlignHorizontal=o.align;if(o.strike)t.textDecoration='STRIKETHROUGH';parent.appendChild(t);if(o.w){t.resize(o.w,t.height);t.textAutoResize='HEIGHT';}else t.textAutoResize='WIDTH_AND_HEIGHT';if(o.x!==undefined)t.x=o.x;if(o.y!==undefined)t.y=o.y;return t;}\nfunction iconDef(n){return ws.findOne(x=>x.type==='COMPONENT'&&x.name==='Icon/'+n);}\nfunction icon(n,size,color){const c=iconDef(n);const i=c.createInstance();if(size)i.rescale(size/i.width);const col=color||C.ink2;i.findAll(v=>v.type==='VECTOR').forEach(v=>{v.fills=[paint(col)];if(v.strokes&&v.strokes.length)v.strokes=[paint(col)];});return i;}\nfunction btn(parent,variant,label,opts){opts=opts||{};const comp=ws.findOne(x=>x.type==='COMPONENT'&&x.name==='Type='+variant);const i=comp.createInstance();parent.appendChild(i);const t=i.findOne(c=>c.type==='TEXT');t.characters=label;if(opts.size){t.fontSize=opts.size;i.paddingTop=opts.padY||12;i.paddingBottom=opts.padY||12;i.paddingLeft=opts.padX||24;i.paddingRight=opts.padX||24;}if(opts.grow){i.layoutGrow=1;i.primaryAxisSizingMode='FILL';}if(opts.icon){const ic=icon(opts.icon,opts.iconSize||20,opts.iconColor||C.white);i.appendChild(ic);}if(opts.compact){i.paddingTop=opts.padY||10;i.paddingBottom=opts.padY||10;i.paddingLeft=opts.padX||20;i.paddingRight=opts.padX||20;}return i;}\nfunction field(parent,variant,w,opts){opts=opts||{};const comp=ws.findOne(x=>x.type==='COMPONENT'&&x.name==='Field/'+variant);const i=comp.createInstance();parent.appendChild(i);const input=i.findOne(c=>c.name==='Input'||c.type==='FRAME');if(w){input.resize(w,input.height);if(opts.h)input.resize(w,opts.h);if(opts.grow){i.layoutGrow=1;input.primaryAxisSizingMode='FILL';}}return i;}\nfunction photo(parent,hash,w,h,o){o=o||{};const r=figma.createRectangle();r.name='Photo';r.resize(w,h);r.fills=[{type:'IMAGE',imageHash:hash,scaleMode:'FILL'}];r.cornerRadius=o.r===undefined?0:o.r;if(o.r)r.clipsContent=true;parent.appendChild(r);return r;}\nfunction ratingStars(parent,score,size,gap){const wrap=frame(parent,'Stars',{dir:'HORIZONTAL',gap:gap===undefined?4:gap});wrap.fills=[];const full=Math.floor(score);const half=score%1>=0.5;\nfor(let i=0;i<5;i++){const kind=i<full?'Star':(i===full&&half?'Star_Half':'Star');const s=icon(kind,size||16);wrap.appendChild(s);if(kind==='Star'&&i>=full&&!(i===full&&half)){/* dark empty star */}}return wrap;}\n\nreturn await (async()=>{\nconst out={};\n\n// ===== MEDIA HASHES =====\nconst H = {};\nconst mediaIds = { Hero:'4:36', Style_Casual:'4:44', Style_Formal:'4:45', Style_Party:'4:47', Style_Gym:'4:46',\n  TShirt_Tape:'4:48', Skinny_Fit_Jeans:'4:42', Checkered_Shirt:'4:33', Sleeve_Striped:'4:43',\n  Vertical_Striped:'4:51', Courage:'4:49', Bermuda:'4:37', Faded_Jeans:'4:34',\n  Gradient:'4:35', Polo_Tipping:'4:41', Black_Striped:'4:32', Polo_Contrast:'4:40',\n  OneLife1:'4:38', OneLife2:'4:39', OneLife3:'4:50' };\nfor(const k in mediaIds){const n=await figma.getNodeByIdAsync(mediaIds[k]);H[k]=n.fills[0].imageHash;}\nout.hashes=Object.keys(H).length;\n\n// ===== RATING =====\nfunction ratingRow(parent,score,label,size){\n  const row=frame(parent,'Rating',{dir:'HORIZONTAL',gap:6,align:'CENTER'});\n  const full=Math.floor(score), half=(score-full)>=0.5;\n  for(let i=0;i<5;i++){\n    if(i<full) row.appendChild(icon('Star',size||18,C.rating));\n    else if(i===full&&half) row.appendChild(icon('Star_Half',size||18,C.rating));\n    else {const e=icon('Star',size||18);row.appendChild(e);}\n  }\n  if(label!==false){\n    const t=text(row,{text:String(score)+'/5',font:F.reg,size:14,color:C.body});\n    t.name='Score';\n  }\n  return row;\n}\n\n// ===== PRODUCT CARD =====\nconst card=frame(lib,'Product Card',{w:298,dir:'VERTICAL',gap:12},true);\nconst imgWrap=frame(card,'Image',{w:298,h:298,fill:C.warm,radius:20,clip:true});\nphoto(imgWrap,H.TShirt_Tape,298,298);\ncard.appendChild(imgWrap);\nconst pName=text(card,{text:'T-shirt with Tape Details',font:F.semi,size:20,color:C.ink,lh:27,w:298});\npName.name='Name';\nconst pr=ratingRow(card,4.5,true,18);pr.name='Rating';\nconst priceRow=frame(card,'Price',{dir:'HORIZONTAL',gap:10,align:'CENTER'});\nconst pv=text(priceRow,{text:'$120',font:F.bold,size:24,color:C.ink});pv.name='Price';\nconst ov=text(priceRow,{text:'$160',font:F.bold,size:24,color:'#B5B5BA',strike:true});ov.name='Old';\nconst dg=frame(priceRow,'Discount',{dir:'HORIZONTAL',fill:C.discountBg,radius:62,padX:14,padY:6,justify:'CENTER',align:'CENTER'});\ntext(dg,{text:'-30%',font:F.med,size:12,color:C.discount});\ncard.x=40;card.y=900;\n\n// ===== SECTION HEADING =====\nconst sh=frame(lib,'Section Heading',{dir:'VERTICAL',gap:20,align:'CENTER'},true);\ntext(sh,{text:'NEW ARRIVALS',font:F.display,size:48,color:C.ink,lh:52,align:'CENTER'});\ntext(sh,{text:'View All',font:F.med,size:16,color:C.ink}).visible=false;\nsh.x=420;sh.y=900;\n\n// ===== REVIEW CARD =====\nconst rc=frame(lib,'Review Card',{w:400,dir:'VERTICAL',gap:12,fill:C.white,radius:20,stroke:C.line,pad:28},true);\nconst rcStars=ratingRow(rc,5,false,20);rcStars.name='Stars';\nconst nm=frame(rc,'Name Row',{dir:'HORIZONTAL',gap:8,align:'CENTER'});nm.fills=[];\nconst nmt=text(nm,{text:'Sarah M.',font:F.bold,size:20,color:C.ink});nmt.name='Name';\nnm.appendChild(icon('Verified',20,C.verified));\nconst qt=text(rc,{text:'“I’m blown away by the quality and style of the clothes I received from Shop.co.”',font:F.reg,size:16,color:C.body,lh:22,w:344});qt.name='Quote';\nrc.x=860;rc.y=900;\n\n// ===== STYLE TILE =====\nconst st=frame(lib,'Style Tile',{w:610,h:290,radius:20,clip:true,fill:C.warm},true);\nphoto(st,H.Style_Casual,610,290,{r:20});\ntext(st,{text:'Casual',font:F.display,size:36,color:C.ink,x:32,y:24});\nst.x=1340;st.y=900;\n\n// ===== CART LINE ITEM =====\nconst cl=frame(lib,'Cart Line Item',{w:660,dir:'HORIZONTAL',gap:16,pad:20,fill:C.white,radius:20,stroke:C.line},true);\nconst cimg=frame(cl,'Image',{w:124,h:124,radius:12,fill:C.warm,clip:true});photo(cimg,H.Gradient,124,124);\nconst cinfo=frame(cl,'Info',{dir:'VERTICAL',gap:6,grow:1});cinfo.fills=[];cl.appendChild(cinfo);\ntext(cinfo,{text:'Gradient Graphic T-shirt',font:F.semi,size:18,color:C.ink});\ntext(cinfo,{text:'Size: Large',font:F.reg,size:14,color:C.body});\ntext(cinfo,{text:'Color: White',font:F.reg,size:14,color:C.body});\nconst cpr=text(cinfo,{text:'$145',font:F.bold,size:20,color:C.ink});cpr.name='Price';\nconst cright=frame(cl,'Actions',{dir:'VERTICAL',gap:16,align:'MAX'});cright.fills=[];cl.appendChild(cright);\nconst trashRow=frame(cright,'Trash',{});trashRow.fills=[];trashRow.appendChild(icon('Trash',20,C.ink2));\nconst stepper=frame(cright,'Stepper',{dir:'HORIZONTAL',h:38,w:110,fill:C.surface,radius:62,align:'CENTER',justify:'SPACE_BETWEEN',padX:12});stepper.appendChild(icon('Minus',14,C.ink));text(stepper,{text:'1',font:F.med,size:15,color:C.ink});stepper.appendChild(icon('Plus',14,C.ink));\ncl.x=2100;cl.y=900;\nreturn out;\n})();\n","description":"Build product card, review card, style tile, cart line item components","fileKey":"fpL5izeAHRNlVGSdWNFooV"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":448,"input_tokens":55,"cache_read_input_tokens":70821,"cache_creation":{"ephemeral_