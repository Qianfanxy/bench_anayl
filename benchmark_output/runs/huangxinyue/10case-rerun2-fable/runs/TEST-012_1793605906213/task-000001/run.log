(n=>n.type==='INSTANCE'&&n.name==='Button / Ghost'),ids['02_Home']);\nrep.home6=link(s6.children.find(n=>n.type==='INSTANCE'&&n.name==='Button / Primary'),ids['02_Home']);\nconst verify={};\nfor(const [k,id] of Object.entries(ids)){\n  const f=await figma.getNodeByIdAsync(id);\n  verify[k]=f.findAll(n=>n.reactions&&n.reactions.length).map(n=>n.name+'→'+n.reactions[0].actions[0].destinationId);\n}\nreturn JSON.stringify({rep,verify});","description":"Set prototype reactions with actions array","fileKey":"srtKMfdMQueLXSGicHfAT9"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":53,"cache_creation_input_tokens":2873,"cache_read_input_tokens":95856,"cache_creation":{"ephemeral_5m_input_tokens":2873,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"global","speed":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"06e568f0-e8d8-4a4c-a52f-32c2c35f5d7f","uuid":"a71779bd-abea-405a-a39c-a23f4e6ed272","timestamp":"2026-11-02T08:06:46.513Z","tool_use_meta":[{"id":"toolu_01chlUU1epy3PceeRJZtgZcw","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
