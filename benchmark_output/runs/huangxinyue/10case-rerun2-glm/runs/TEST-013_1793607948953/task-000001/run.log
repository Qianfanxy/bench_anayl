\"20\" width=\"209\" height=\"20\" />\n          <text id=\"3:50\" name=\"Subscriptions · $52 · Left $0 House service · $138 · Left $10 Maintenance · $130 · Left $30\" x=\"20\" y=\"48\" width=\"380\" height=\"57\" />\n        </frame>\n        <frame id=\"3:51\" name=\"Subscriptions (02, in this order)\" x=\"0\" y=\"149\" width=\"420\" height=\"163\">\n          <text id=\"3:52\" name=\"Subscriptions (02, in this order)\" x=\"20\" y=\"20\" width=\"218\" height=\"20\" />\n          <text id=\"3:53\" name=\"Total: Your monthly payment for subscriptions · $58.97 Patreon membership · $19.99/mo (Logo_Patreon) Netflix · $12/mo (Logo_Netflix) Apple payment · $19.99/mo (Logo_Apple) Spotify · $6.99/mo (Logo_Spotify)\" x=\"20\" y=\"48\" width=\"380\" height=\"95\" />\n        </frame>\n        <frame id=\"3:54\" name=\"Credit score (03)\" x=\"444\" y=\"149\" width=\"420\" height=\"106\">\n          <text id=\"3:55\" name=\"Credit score (03)\" x=\"20\" y=\"20\" width=\"118\" height=\"20\" />\n          <text id=\"3:56\" name=\"660 · Good · +6pts Range 400 – 850 · Last update on 20 Jul 2020\" x=\"20\" y=\"48\" width=\"380\" height=\"38\" />\n        </frame>\n        <frame id=\"3:57\" name=\"Factors (03, in this order)\" x=\"888\" y=\"149\" width=\"420\" height=\"125\">\n          <text id=\"3:58\" name=\"Factors (03, in this order)\" x=\"20\" y=\"20\" width=\"175\" height=\"20\" />\n          <text id=\"3:59\" name=\"On-time payments · 95% · Good · 1 missed Credit Utilization · 95% · Not bad · -15% Age of credit · 8 years · Good\" x=\"20\" y=\"48\" width=\"380\" height=\"57\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"3:60\" name=\"What is fixed · what is yours\" x=\"64\" y=\"2003\" width=\"1312\" height=\"292\">\n      <text id=\"3:61\" name=\"What is fixed · what is yours\" x=\"0\" y=\"0\" width=\"328\" height=\"35\" />\n      <frame id=\"3:62\" name=\"Fixed vs yours\" x=\"0\" y=\"51\" width=\"1312\" height=\"241\">\n        <frame id=\"3:63\" name=\"Fixed (given)\" x=\"0\" y=\"0\" width=\"644\" height=\"221\">\n          <text id=\"3:64\" name=\"Fixed (given)\" x=\"24\" y=\"24\" width=\"103\" height=\"23\" />\n          <text id=\"3:65\" name=\"• Frame list and exact names • Must-include content per frame (what, not how) • Navigation structure and links • All data and copy • Brand color #6347EB and DM Sans • Media: service logos, icons • Platform shell\" x=\"24\" y=\"57\" width=\"596\" height=\"140\" />\n        </frame>\n        <frame id=\"3:66\" name=\"Yours (designer decides)\" x=\"668\" y=\"0\" width=\"644\" height=\"241\">\n          <text id=\"3:67\" name=\"Yours (designer decides)\" x=\"24\" y=\"24\" width=\"197\" height=\"23\" />\n          <text id=\"3:68\" name=\"• Layout, grouping, order and emphasis on every screen • All other colors: neutrals, text, backgrounds / surfaces, category and progress colors, rating colors (good / not bad), gauge, error / disabled • Type scale, spacing, radii, elevation • All states: current tab, current segment, pressed, disabled • Headers, tab bar, segmented tabs, period picker, budget summary, category cards, progress rows, subscription rows, credit gauge, factor rows • How progress and the score gauge are visualized\" x=\"24\" y=\"57\" width=\"596\" height=\"160\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"3:69\" name=\"How it is evaluated\" x=\"64\" y=\"2343\" width=\"1312\" height=\"281\">\n      <text id=\"3:70\" name=\"How it is evaluated\" x=\"0\" y=\"0\" width=\"222\" height=\"35\" />\n      <text id=\"3:71\" name=\"Your file is compared with this brief on coverage, data and flow — not on visual similarity to any original.\" x=\"0\" y=\"51\" width=\"1312\" height=\"22\" />\n      <text id=\"3:72\" name=\"1. Checklist coverage per frame 2. Data &amp; copy accuracy 3. Flow &amp; prototype completeness 4. Information hierarchy 5. Visual quality &amp; consistency of your own system 6. Component reuse 7. State design (current tab, current segment, progress and gauge)\" x=\"0\" y=\"89\" width=\"1312\" height=\"154\" />\n      <text id=\"3:73\" name=\"Deliverable: the link to your own Figma file containing the 3 named frames, your components and the prototype.\" x=\"0\" y=\"259\" width=\"1312\" height=\"22\" />\n    </frame>\n  </frame>\n</canvas>"},{"type":"text","text":"IMPORTANT: After you call this tool, you MUST call get_design_context if trying to implement the design, since this tool only returns metadata. If you do not call get_design_context, the agent will not be able to implement the design."}],"_meta":{"mcpRequestId":"42d128e4-e6d4-4ffa-96a1-4e859dc01fcf"}},"tool_result_meta":[{"id":"call_a2ce67c8b53b4ef3a515536a","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
