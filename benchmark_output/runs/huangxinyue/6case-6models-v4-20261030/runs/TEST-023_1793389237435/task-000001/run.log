}if(o.align)t.textAlignHorizontal=o.align;if(o.name)t.name=o.name;return t;}\nfunction F(p,x,y,w,h,hex,o={}){const f=figma.createFrame();f.resize(w,h);f.x=x;f.y=y;f.fills=hex?[S(hex,o.op??1)]:[];if(o.r)f.cornerRadius=o.r;if(o.stroke){f.strokes=[S(o.stroke)];f.strokeWeight=o.sw??1;}f.clipsContent=o.clip??false;p.appendChild(f);if(o.name)f.name=o.name;return f;}\nfunction V(p,d,hex,x,y,w=2){const v=figma.createVector();v.vectorPaths=[{windingRule:'NONE',data:d}];v.strokes=[S(hex)];v.strokeWeight=w;v.strokeCap='ROUND';v.strokeJoin='ROUND';v.fills=[];p.appendChild(v);v.x=x;v.y=y;return v;}\nfunction spark(p,pts,hex,x,y,w,h,wt=2){const d=pts.map((q,i)=>`${i?'L':'M'} ${q[0]} ${q[1]}`).join(' ');const v=V(p,d,hex,x,y,wt);v.resize(w,h);return v;}\nconst tint=(n,hex)=>{const all=n.findAll?f n.findAll(()=>true):[];...};\n```\ncareful: findAll exists on nodes with children. tint:\n```js\nfunction tint(n,hex){const list=n.findAll?n.findAll(x=>true):[];for(const c of list){if('fills'in c&&Array.isArray(c.fills)&&c.fills.length&&c.fills.some(f=>f.type==='SOLID'))c.fills=[S(hex)];}if('fills'in n&&Array.isArray(n.fills)&&n.fills.some(f=>f.type==='SOLID'))n.fills=[S(hex)];}\n```\nHmm for icons whose group children have strokes not fills? Icons are vectors with fills probably. If icon renders via strokes, tint misses. I'll also handle strokes: if strokes non-empty set strokes too. Let me include both:\n```js\nif('strokes'in c&&Array.isArray(c.strokes)&&c.strokes.length)c.strokes=[S(hex)];\n```\nRisk: tinting a white bg fill to gray on tab icons — icon components: Icon_Home has white component fill (44×44 bg?) wait Icon components: \"fills white\" at component level (like SW_Symbol). Actually the icon components have white fills?? SW_Symbol fills white — probably a white background rect. Hmm — but Icon_Trade is white icon: component fills white + icon group white. If component-level fill is white bg, then on tab bar a white square shows behind gray icon → invisible on white bar but sh