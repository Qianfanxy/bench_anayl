er to order food. Look for the finest discounts and you’ll be lost in a world of delectable food.', 20, 'Regular', GRAY, tx, 116);\nbody.resize(860, 60);\n// store badges\ninst('9:49', tx, 220, apCon, 162);\ninst('9:25', tx + 182, 220, apCon, 182);\n\n// ============ FOOTER ============\nconst footCon = await figma.getNodeByIdAsync('13:26');\nconst colW = 400, colGap = 64;\n// Column 1: Our top cities (5 cols of 5)\ntext(footCon, 'Our top cities', 20, 'Bold', WHITE, 0, 0);\nconst cities = [\n  ['San Francisco','Los Angeles','New York City','Chicago','Columbus'],\n  ['Miami','Washington DC','Orange County','Phoenix','New Mexico'],\n  ['San Diego','Seattle','Atlanta','Las Vegas','Albuquerque'],\n  ['East Bay','Portland','Charlotte','Sacramento','Long Beach'],\n  ['Nashville','Denver','Oklahoma City','New Orleans',''],\n];\nconst ccw = 150;\ncities.forEach((col, ci) => {\n  col.forEach((city, ri) => {\n    if (city) text(footCon, city, 15, 'Regular', FOOTER_TEXT, ci*ccw, 44 + ri*30);\n  });\n});\n// Column 2: Company\nconst c2x = 830;\ntext(footCon, 'Company', 20, 'Bold', WHITE, c2x, 0);\n['About us','Team','Careers','Blog'].forEach((l,i)=>text(footCon, l, 15, 'Regular', FOOTER_TEXT, c2x, 44+i*32));\n// Column 3: Contact\nconst c3x = 1060;\ntext(footCon, 'Contact', 20, 'Bold', WHITE, c3x, 0);\n['Help & Support','Partner with us','Ride with us'].forEach((l,i)=>text(footCon, l, 15, 'Regular', FOOTER_TEXT, c3x, 44+i*32));\n// Column 4: Legal\nconst c4x = 1290;\ntext(footCon, 'Legal', 20, 'Bold', WHITE, c4x, 0);\n['Terms & Conditions','Refund & Cancellation','Privacy Policy','Cookie Policy'].forEach((l,i)=>text(footCon, l, 15, 'Regular', FOOTER_TEXT, c4x, 44+i*32));\n\n// Divider\nrect(footCon, 0, 250, 1728, 1, {r:0.25,g:0.26,b:0.29}, 0);\n\n// Follow us + subscribe row\nconst fy = 290;\ntext(footCon, 'Follow Us', 20, 'Bold', WHITE, 0, fy);\ninst('9:23', 0, fy+40, footCon, 24);\ninst('9:22', 40, fy+40, footCon, 24);\ninst('9:24', 80, fy+40, footCon, 24);\n// recolor social icons to footer light gray\nfor (const n of footCon.children.slice(-3)) {\n  for (const v of n.findAll(c=>c.type==='VECTOR')) v.fills=[{type:'SOLID',color:FOOTER_TEXT}];\n}\n// Subscribe block right\nconst sx = 1100;\ntext(footCon, 'Receive exclusive offers in your mailbox', 18, 'Bold', WHITE, sx, fy);\n// email field\nconst field = rect(footCon, sx, fy+44, 360, 56, {r:0.16,g:0.17,b:0.19}, 10);\nconst envIc = inst('9:7', sx+18, fy+44+16, footCon, 24);\nfor (const v of envIc.findAll(c=>c.type==='VECTOR')) v.fills=[{type:'SOLID',color:FOOTER_DIM}];\ntext(footCon, 'Enter Your email', 16, 'Regular', FOOTER_DIM, sx+54, fy+44+18);\n// subscribe button\nconst sub = figma.createFrame();\nsub.name='Subscribe';\nsub.resize(150,56);\nsub.x = sx+376; sub.y = fy+44;\nsub.fills=[{type:'SOLID',color:ORANGE}];\nsub.cornerRadius=10;\nfootCon.appendChild(sub);\nconst subT = text(sub,'Subscribe',17,'Bold',WHITE,0,0);\nsubT.x=(150-subT.width)/2; subT.y=(56-subT.height)/2;\n\n// Bottom bar\nconst by = 430;\nrect(footCon, 0, by-24, 1728, 1, {r:0.25,g:0.26,b:0.29}, 0);\ninst('9:27', 0, by, footCon, 180);\ntext(footCon, 'All rights Reserved © FoodWagon, 2021', 15, 'Regular', FOOTER_DIM, 1728-280, by+14);\nreturn 'apppromo+footer ok';\n","description":"Build App Promo (mockup, copy, store badges) and Footer (cities, link columns, follow, subscribe, bottom bar)","fileKey":"vxs2YHWWLo4u0YPXrkb2yt"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"2939614a-de6b-46ec-9e1f-7271638640fe","uuid":"41716f13-d18f-46dd-8ee6-e3709cd7e6a6","timestamp":"2026-11-02T01:26:58.487Z","tool_use_meta":[{"id":"mcp__figma__use_figma_28_4429d1f3","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
