 \"FIXED\"; ph.counterAxisSizingMode = \"FIXED\";\nph.appendChild(text(\"PROJECT IMAGE — PLACEHOLDER\",{size:13,style:\"Medium\",color:C.gray,ls:2}));\npage.appendChild(ph); ph.x=0; ph.y=3000;\n\n// --- Footer component ---\nconst footer = figma.createComponent();\nfooter.name = \"Footer\";\nfooter.resize(1440,140);\nfooter.fills = solid(C.bg);\nconst fl = hline(1308); fl.x=96; fl.y=0; footer.appendChild(fl);\nconst fLeft = text(\"Deniz Arslan ⏤ 2020\",{size:15,style:\"Medium\",color:C.gray});\nfLeft.name=\"Copyright\"; fLeft.x=96; fLeft.y=80; footer.appendChild(fLeft);\nconst fRight = hug(figma.createFrame(),\"HORIZONTAL\"); fRight.itemSpacing=36; fRight.name=\"SocialLinks\";\nfor (const s of [\"Artstation\",\"LinkedIn\",\"Twitter\"]) fRight.appendChild(text(s,{size:15,style:\"Medium\",color:C.ink}));\nfooter.appendChild(fRight);\nfRight.x = 1440-96-fRight.width; fRight.y = 78;\npage.appendChild(footer); footer.x=0; footer.y=3560;\n\n// --- Header component set (variants) ---\nfunction navItem(label,current){\n  const f = hug(figma.createFrame(),\"VERTICAL\");\n  f.itemSpacing=8; f.counterAxisAlignItems=\"CENTER\"; f.name=\"Nav_\"+label;\n  f.appendChild(text(label,{size:15,style:current?\"Bold\":\"Medium\",color:current?C.ink:C.gray}));\n  const bar = figma.createRectangle(); bar.resize(24,3); bar.cornerRadius=2; bar.fills=solid(C.accent); bar.visible=current; bar.name=\"CurrentBar\";\n  f.appendChild(bar);\n  return f;\n}\nfunction buildHeader(current){\n  const h = figma.createComponent(); h.name=\"Current=\"+current;\n  h.resize(1440,96); h.fills=solid(C.bg); h.clipsContent=false;\n  const logo = text(\"da.\",{size:26,style:\"Bold\",color:C.ink}); logo.name=\"Logo\";\n  h.appendChild(logo); logo.x=96; logo.y=(96-logo.height)/2;\n  const nav = hug(figma.createFrame(),\"HORIZONTAL\"); nav.itemSpacing=44; nav.name=\"Nav\";\n  for (const s of [\"Work\",\"About\",\"Playground\",\"Contact\"]) nav.appendChild(navItem(s, s===current));\n  h.appendChild(nav);\n  nav.x = 1440-96-nav.width; nav.y=(96-nav.height)/2;\n  const ln = hline(1308); ln.x=96; ln.y=95; h.appendChild(ln);\n  return h;\n}\nconst hWork = buildHeader(\"Work\"); page.appendChild(hWork); hWork.x=0; hWork.y=3160;\nconst hAbout = buildHeader(\"About\"); page.appendChild(hAbout); hAbout.x=0; hAbout.y=3330;\nconst headerSet = figma.combineAsVariants([hWork,hAbout], page);\nheaderSet.name = \"Header\"; headerSet.x=0; headerSet.y=3160;\n\nreturn JSON.stringify({placeholder:ph.id, footer:footer.id, headerSet:headerSet.id, headerDefault:headerSet.defaultVariant.id});\n","description":"创建 Header 变体集、Footer、ImagePlaceholder 组件","fileKey":"BZUQod3Uu59x2XPlwre74l"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"553987d8-b007-418a-a3bc-0985cd9e3afc","uuid":"dda146f9-4b57-4a1b-8eaf-d7530694a21b","timestamp":"2026-11-02T02:42:18.694Z","tool_use_meta":[{"id":"mcp__figma__use_figma_10_e175a90e","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
