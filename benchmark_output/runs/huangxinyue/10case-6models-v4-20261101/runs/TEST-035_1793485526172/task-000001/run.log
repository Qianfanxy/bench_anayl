th)v.strokes=[solid('9A9AA3')]; if(v.fills.length)v.fills=[solid('9A9AA3')]; }catch(e){} }\nout.cardSelector=ms.id;\n\n// Card / Promo\nconst pr=figma.createComponent(); pr.name='Card / Promo'; pr.resize(343,96); pr.cornerRadius=16; pr.clipsContent=true; pr.fills=[solid('FFFFFF')];\npr.effects=[{type:'DROP_SHADOW',color:SHADOW_C,offset:{x:0,y:8},radius:20,spread:0,visible:true,blendMode:'NORMAL'}];\nconst bd=figma.createFrame(); bd.name='Badge'; pr.appendChild(bd); bd.resize(78,22); bd.x=20; bd.y=16; bd.cornerRadius=11; bd.fills=[solid('FFE9E0')];\nbd.layoutMode='HORIZONTAL'; bd.primaryAxisAlignItems='CENTER'; bd.counterAxisAlignItems='CENTER'; bd.primaryAxisSizingMode='FIXED'; bd.counterAxisSizingMode='FIXED';\nbd.appendChild(T('Badge Label','POPULAR','Semi Bold',10,'BF4A2B',{ls:6}));\nconst pt=T('Title','Get up to 15% cashback on clothing and apparel','Semi Bold',14,'1A1A1F',{lh:19}); pr.appendChild(pt);\npt.textAutoResize='NONE'; pt.resize(196,40); pt.x=20; pt.y=44;\nconst pim=(await N('5:8')).createInstance(); pr.appendChild(pim); pim.resize(104,96); pim.x=239; pim.y=0; pim.name='Image';\nout.promoCard=pr.id;\n\n// Card / Expenses Chart\nconst ch2=figma.createComponent(); ch2.name='Card / Expenses Chart'; ch2.resize(343,160); ch2.cornerRadius=16; ch2.fills=[solid('FFFFFF')];\nch2.effects=[{type:'DROP_SHADOW',color:SHADOW_C,offset:{x:0,y:8},radius:20,spread:0,visible:true,blendMode:'NORMAL'}];\nconst xs=[24,83,142,201,260,319], ys=[86,64,98,34,74,88], months=['MAR','APR','MAY','JUN','JUL','AUG'];\nconst vec=figma.createVector(); vec.name='Curve'; ch2.appendChild(vec); vec.x=0; vec.y=0;\nvec.vectorPaths=[{windingRule:'NONE',data:'M 24 86 C 33.83 82.33 63.33 58.33 83 64 C 102.67 66 122.33 103 142 98 C 161.67 93 181.33 38 201 34 C 220.67 30 240.33 65 260 74 C 279.67 83 319 88 319 88'}];\nvec.strokes=[solid('007AFF')]; vec.strokeWeight=2.5; vec.strokeCap='ROUND'; vec.strokeJoin='ROUND'; vec.fills=[];\nconst vl=T('Value','$80.40','Semi Bold',13,'007AFF'); ch2.appendChild(vl); vl.x=201-vl.width/2; vl.y=8;\nfor(let i=0;i<6;i++){\n  if(i===3){\n    const halo=figma.createEllipse(); halo.name='Halo'; ch2.appendChild(halo); halo.resize(22,22); halo.x=190; halo.y=23; halo.fills=[solid('007AFF',0.14)];\n    const dot=figma.createEllipse(); dot.name='Point JUN'; ch2.appendChild(dot); dot.resize(12,12); dot.x=195; dot.y=28; dot.fills=[solid('007AFF')]; dot.strokes=[solid('FFFFFF')]; dot.strokeWeight=2.5;\n  } else {\n    const dot=figma.createEllipse(); dot.name='Point '+months[i]; ch2.appendChild(dot); dot.resize(8,8); dot.x=xs[i]-4; dot.y=ys[i]-4; dot.fills=[solid('FFFFFF')]; dot.strokes=[solid('C9C9D2')]; dot.strokeWeight=1.5;\n  }\n  const lb=T('Month '+months[i],months[i],i===3?'Semi Bold':'Regular',11,i===3?'007AFF':'9A9AA3'); ch2.appendChild(lb); lb.x=xs[i]-lb.width/2; lb.y=136;\n}\nout.chartCard=ch2.id;\n\n// Card / Receipt\nconst rc=figma.createComponent(); rc.name='Card / Receipt'; rc.resize(343,368); rc.cornerRadius=20; rc.fills=[solid('FFFFFF')];\nrc.effects=[{type:'DROP_SHADOW',color:SHADOW_C,offset:{x:0,y:12},radius:28,spread:0,visible:true,blendMode:'NORMAL'}];\nconst rh=T('Header','CASH RECEIPT','Semi Bold',16,'1A1A1F',{ls:14,w:343,h:20,align:'CENTER'}); rc.appendChild(rh); rh.x=0; rh.y=32;\nconst rd2=T('Date','20.08.2020','Regular',13,'9A9AA3',{w:343,h:16,align:'CENTER'}); rc.appendChild(rd2); rd2.x=0; rd2.y=58;\nfunction div(y){const d=figma.createRectangle(); d.name='Divider'; rc.appendChild(d); d.resize(295,1); d.x=24; d.y=y; d.fills=[solid('E9E9EF')];}\ndiv(92);\nconst rows=[['Amount','$40.00',108],['Service Fee','$2.82',140],['Internet Charge','$7.18',172]];\nfor(const [l,v,y] of rows){\n  const rl=T('Row Label '+l,l,'Regular',14,'6C6C74'); rc.appendChild(rl); rl.x=24; rl.y=y;\n  const rv=T('Row Value '+l,v,'Semi Bold',14,'1A1A1F'); rc.appendChild(rv); rv.x=319-rv.width; rv.y=y;\n}\ndiv(204);\nconst tl=T('Total Label','Total','Semi Bold',16,'1A1A1F'); rc.appendChild(tl); tl.x=24; tl.y=222;\nconst tv2=T('Total Value'