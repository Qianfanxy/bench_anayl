.fills=[paint('surface/base')]; kn.strokes=[paint(lv==='Mild'?'semantic/mild':'brand/red')]; kn.strokeWeight=4; kn.strokeAlign='INSIDE'; await kn.setEffectStyleIdAsync(ESM['Elevation 1'].id); tr.appendChild(kn);\n const lb=await F('Scale',{dir:'HORIZONTAL',main:'SPACE_BETWEEN'}); f.appendChild(lb); lb.layoutSizingHorizontal='FILL';\n lb.appendChild(await T('Mild','Caption','semantic/mild',{name:'Mild'})); lb.appendChild(await T('Hot','Caption','semantic/hot',{name:'Hot'}));\n ss.push(figma.createComponentFromNode(f));}\nset(ss,'Spicy Slider');\n\n// Portion stepper\nconst ps=[];\nfor(const st of ['Enabled','Disabled']){\n const f=await F('Minus='+st,{dir:'VERTICAL',gap:10,cross:'MAX'});\n f.appendChild(await T('Portion','Label','text/primary',{name:'Title'}));\n const row=await F('Stepper',{dir:'HORIZONTAL',cross:'CENTER',gap:4}); f.appendChild(row);\n const m=await F('Minus',{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',w:44,h:44,r:14,fill:st==='Enabled'?'brand/red':'state/disabled'}); if(st==='Enabled') await m.setEffectStyleIdAsync(ESM['Elevation Red'].id); m.appendChild(await I('Minus',st==='Enabled'?'text/on-brand':'surface/base',20)); row.appendChild(m);\n const v=await T('2','Heading','text/primary',{name:'Value',align:'CENTER'}); v.textAutoResize='NONE'; v.resize(40,24); row.appendChild(v);\n const p=await F('Plus',{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',w:44,h:44,r:14,fill:'brand/red'}); await p.setEffectStyleIdAsync(ESM['Elevation Red'].id); p.appendChild(await I('Plus','text/on-brand',20)); row.appendChild(p);\n ps.push(figma.createComponentFromNode(f));}\nconst pss=set(ps,'Portion Stepper'); const pv=pss.addComponentProperty('Value','TEXT','2'); ps.forEach(c=>c.findOne(n=>n.name==='Value').componentPropertyReferences={characters:pv});\n\n// Add-on card\nconst ao=[];\nfor(const st of ['Default','Added']){\n const f=await F('State='+st,{w:86,h:116,r:18,fill:'surface/base',fx:'Elevation 1'}); f.clipsContent=true; if(st==='Added'){f.strokes=[paint('b