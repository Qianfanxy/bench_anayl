wl.\" x=\"0\" y=\"86\" width=\"273\" height=\"104\" />\n            <frame id=\"19:778\" name=\"Step Photo\" x=\"0\" y=\"204\" width=\"760\" height=\"380\">\n              <instance id=\"19:779\" name=\"Photo_Cooking_Step\" x=\"0\" y=\"0\" width=\"760\" height=\"380\" />\n            </frame>\n            <text id=\"19:780\" name=\"Day-old rice works best: it is drier, so the grains fry separately instead of turning mushy. Break up any clumps before you start.\" x=\"0\" y=\"598\" width=\"273\" height=\"104\" />\n          </frame>\n        </frame>\n        <frame id=\"19:781\" name=\"Step\" x=\"0\" y=\"822\" width=\"390\" height=\"223\">\n          <frame id=\"19:782\" name=\"Checkbox\" x=\"0\" y=\"8\" width=\"24\" height=\"24\" />\n          <frame id=\"19:783\" name=\"Content\" x=\"44\" y=\"8\" width=\"346\" height=\"190\">\n            <text id=\"19:784\" name=\"2.\" x=\"0\" y=\"0\" width=\"22\" height=\"29\" />\n            <text id=\"19:785\" name=\"Cook the eggs and asparagus\" x=\"0\" y=\"43\" width=\"346\" height=\"29\" />\n            <text id=\"19:786\" name=\"Heat the oil in a wok over high heat. Scramble the eggs until just set, push them to the side, then stir-fry the asparagus for 2 minutes until bright green and still crisp.\" x=\"0\" y=\"86\" width=\"346\" height=\"104\" />\n          </frame>\n        </frame>\n        <frame id=\"19:787\" name=\"Step\" x=\"0\" y=\"1069\" width=\"315\" height=\"249\">\n          <frame id=\"19:788\" name=\"Checkbox\" x=\"0\" y=\"8\" width=\"24\" height=\"24\" />\n          <frame id=\"19:789\" name=\"Content\" x=\"44\" y=\"8\" width=\"271\" height=\"216\">\n            <text id=\"19:790\" name=\"3.\" x=\"0\" y=\"0\" width=\"23\" height=\"29\" />\n            <text id=\"19:791\" name=\"Fry the rice and season\" x=\"0\" y=\"43\" width=\"271\" height=\"29\" />\n            <text id=\"19:792\" name=\"Add the rice and toss for 3–4 minutes until hot and lightly toasted. Pour over the sauce, fold in the eggs and spring on