Spacing=o.rowGap===undefined?(o.gap||0):o.rowGap;}n.primaryAxisSizingMode='AUTO';n.counterAxisSizingMode='AUTO';n.resize(o.w===undefined?100:o.w,o.h===undefined?100:o.h);if(o.w!==undefined&&!o.hugW){n.counterAxisSizingMode='FIXED';n.resize(o.w,n.height);}if(o.h!==undefined&&!o.hugH){n.primaryAxisSizingMode='FIXED';n.resize(n.width,o.h);}}\nelse{n.resize(o.w===undefined?100:o.w,o.h===undefined?100:o.h);}\nif(o.x!==undefined)n.x=o.x;if(o.y!==undefined)n.y=o.y;return n;}\nfunction text(parent,o){const t=figma.createText();t.fontName=o.font||F.reg;t.characters=o.text===undefined?'':o.text;t.fontSize=o.size||16;if(o.lh)t.lineHeight={unit:'PIXELS',value:o.lh};t.fills=[paint(o.color||C.ink)];if(o.align)t.textAlignHorizontal=o.align;if(o.strike)t.textDecoration='STRIKETHROUGH';parent.appendChild(t);if(o.w){t.resize(o.w,t.height);t.textAutoResize='HEIGHT';}else t.textAutoResize='WIDTH_AND_HEIGHT';return t;}\nconst iconMap={};ws.findAll(x=>x.type==='COMPONENT'&&x.name.indexOf('Icon/')===0).forEach(c=>iconMap[c.name.slice(5)]=c);\nfunction icon(n,size,color){const c=iconMap[n];if(!c)throw new Error('icon '+n);const i=c.createInstance();if(size)i.rescale(size/i.width);const col=color||C.ink2;i.findAll(v=>v.type==='VECTOR').forEach(v=>{v.fills=[paint(col)];if(v.strokes&&v.strokes.length)v.strokes=[paint(col)];});return i;}\nfunction photo(parent,hash,w,h,r){const p=figma.createRectangle();p.name='Photo';p.resize(w,h);p.fills=[{type:'IMAGE',imageHash:hash,scaleMode:'FILL'}];if(r)p.cornerRadius=r;parent.appendChild(p);return p;}\nconst H={}; for (const [k,id] of Object.entries({One1:'4:38',One2:'4:39',One3:'4:50',Gradient:'4:35',PoloTip:'4:41',BlackStripe:'4:32',PoloContrast:'4:40',Check:'4:33',Jeans:'4:42'})) { const n=await figma.getNodeByIdAsync(id); H[k]=n.fills[0].imageHash; }\nfunction set(name){ return ws.findOne(n=>n.type==='COMPONENT_SET'&&n.name===name); }\nfunction variant(setName,includes,excludes){const s=set(setName);if(!s)throw new Error('no set '+setName);const k=s.children.find(c=>includes.every(w=>c.name.indexOf(w)>-1)&&(excludes||[]).every(w=>c.name.indexOf(w)<0));if(!k)throw new Error('no variant '+setName);return k;}\nfunction plain(name){const c=ws.findOne(n=>n.type==='COMPONENT'&&n.name===name);if(!c)throw new Error('no component '+name);return c;}\nfunction make(c,parent){const i=c.createInstance();if(parent)parent.appendChild(i);return i;}\nfunction tFind(root,name){return root.findAll(n=>n.type==='TEXT'&&n.name===name)[0];}\nconst btnPrimary=variant('Button',['Primary'],['Hover']);\nconst btnSecondary=variant('Button',['Secondary']);\nconst ratingByScore={}; ws.findAll(n=>n.type==='COMPONENT'&&/Score=/.test(n.name)).forEach(c=>{ratingByScore[c.name.split('=')[1]]=c;});\nfunction labeledBtn(parent,label,opts){opts=opts||{};const i=make(opts.secondary?btnSecondary:btnPrimary,parent);tFind(i,'Label').characters=label;if(opts.padX){i.paddingLeft=opts.padX;i.paddingRight=opts.padX;}if(opts.grow){i.layoutGrow=1;i.layoutSizingHorizontal='FILL';}return i;}\nfunction productCard(parent,d){\n  const i=make(plain('Product Card'),parent); i.name='Product Card · '+d.name;\n  const img=i.findOne(n=>n.name==='Photo'); if(img) img.fills=[{type:'IMAGE',imageHash:d.hash,scaleMode:'FILL'}];\n  tFind(i,'Name').characters=d.name;\n  const r=i.findOne(n=>n.type==='INSTANCE'&&n.name==='Rating');\n  if(r&&ratingByScore[String(d.score)]) r.swapComponent(ratingByScore[String(d.score)]);\n  tFind(i,'Score').characters=d.score+'/5';\n  tFind(i,'Price').characters=d.price;\n  const old=tFind(i,'Old'); const disc=i.findOne(n=>n.name==='Discount');\n  if(d.old){old.visible=true;old.characters=d.old;disc.visible=true;disc.findAll(n=>n.type==='TEXT')[0].characters=d.discount;}\n  else{old.visible=false;disc.visible=false;}\n  return i;\n}\nfunction pageTop(parent,shopCurrent){\n  make(plain('Announcement Bar'),parent).name='Announcement Bar';\n  make(variant('Header',shopCurrent?['Shop current']:['Header'],shopCurrent?[]:['Shop current']),parent).name='Header';\n}\nfunction pageFooter(parent){\n  const nlWrap=frame(parent,'Newsletter Block',{w:1440,dir:'HORIZONTAL',justify:'CENTER',padY:56,fill:C.white});\n  make(plain('Newsletter'),nlWrap).name='Newsletter';\n  make(plain('Footer'),parent).name='Footer';\n}\nfunction starsRow(parent,score,size,gap){const r=frame(parent,'Stars',{dir:'HORIZONTAL',gap:gap||4,align:'CENTER'});r.fills=[];const full=Math.floor(score),half=(score-full)>=0.5;\nfor(let i=0;i<5;i++){if(i<full)r.appendChild(icon('Star',size||16,C.rating));else if(i===full&&half)r.appendChild(icon('Star_Half',size||16,C.rating));else r.appendChild(icon('Star',size||16,C.rating));}\nreturn r;}\n\nlet prc=ws.findOne(n=>n.type==='COMPONENT'&&n.name==='Product Review Card');\nif(!prc){\n  prc=frame(ws.findOne(n=>n.name==='Components · Core'),'Product Review Card',{w:590,dir:'VERTICAL',gap:12,fill:C.white,radius:20,stroke:C.line,pad:28},true);\n  const prcTop=frame(prc,'Top',{w:534,dir:'HORIZONTAL',justify:'SPACE_BETWEEN',align:'CENTER'});prcTop.fills=[];\n  starsRow(prcTop,4.5,18,4);\n  const prcMore=frame(prcTop,'More',{w:24,h:24});prcMore.fills=[];prcMore.appendChild(icon('More',24,C.body));\n  const prcName=frame(prc,'Name Row',{dir:'HORIZONTAL',gap:6,align:'CENTER'});prcName.fills=[];\n  text(prcName,{text:'Samantha D.',font:F.bold,size:18,color:C.ink}).name='Reviewer';\n  prcName.appendChild(icon('Verified',18,C.verified));\n  text(prc,{text:'“I absolutely love this t-shirt! The design is unique and the fabric feels so comfortable.”',font:F.reg,size:15,color:C.body,lh:22,w:534}).name='Quote';\n  text(prc,{text:'Posted on August 14, 2023',font:F.med,size:14,color:C.muted}).name='Date';\n}\n\nconst reviewData=[\n['Samantha D.',4.5,'I absolutely love this t-shirt! The design is unique and the fabric feels so comfortable. As a fellow designer, I appreciate the attention to detail. It’s become my favorite go-to shirt.','Posted on August 14, 2023'],\n['Alex M.',4,'The t-shirt exceeded my expectations! The colors are vibrant and the print quality is top-notch. Being a UI/UX designer myself, I’m quite picky about aesthetics, and this t-shirt definitely gets a thumbs up from me.','Posted on August 15, 2023'],\n['Ethan R.',3.5,'This t-shirt is a must-have for anyone who appreciates good design. The minimalistic yet stylish pattern caught my eye, and the fit is perfect. I can see the designer’s touch in every aspect of this shirt.','Posted on August 16, 2023'],\n['Olivia P.',4,'As a UI/UX enthusiast, I value simplicity and functionality. This t-shirt not only represents those principles but also feels great to wear. It’s evident that the designer poured their creativity into making this t-shirt stand out.','Posted on August 17, 2023'],\n['Liam K.',4,'This t-shirt is a fusion of comfort and creativity. The fabric is soft, and the design speaks volumes about the designer’s skill. It’s like wearing a piece of art that reflects my passion for both design and fashion.','Posted on August 18, 2023'],\n['Ava H.',4.5,'I’m not just wearing a t-shirt; I’m wearing a piece of design philosophy. The intricate details and thoughtful layout of the design make this shirt a conversation starter.','Posted on August 19, 2023']];\n\n// ===== 03_Product =====\nconst prod=frame(null,'03_Product',{x:3120,y:0,w:1440,dir:'VERTICAL',fill:C.white,clip:true});\npageTop(prod,true);\nconst crumbWrap=frame(prod,'Breadcrumb Row',{w:1440,dir:'HORIZONTAL',padX:100});crumbWrap.paddingTop=20;crumbWrap.fills=[];\nmake(variant('Breadcrumb',['T-shirts']),crumbWrap).name='Breadcrumb';\n\nconst pSec=frame(prod,'Product',{w:1440,dir:'HORIZONTAL',gap:32,padX:100});pSec.paddingTop=24;pSec.paddingBottom=48;\nconst gal=frame(pSec,'Gallery',{w:604,dir:'VERTICAL',gap:12});gal.fills=[];\nconst mainImg=frame(gal,'Main',{w:604,h:596,fill:C.warm,radius:20,clip:true,dir:'HORIZONTAL'});\nconst mp=photo(mainImg,H.One1,604,596);mp.layoutPositioning='ABSOLUTE';mp.x=0;mp.y=0;\nconst thumbs=frame(gal,'Thumbnails',{w:604,dir:'HORIZON