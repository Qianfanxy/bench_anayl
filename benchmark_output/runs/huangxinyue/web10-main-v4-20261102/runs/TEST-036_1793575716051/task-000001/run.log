nY,p[1]);}if(vnorm){v.x=px+minX;v.y=py+minY;}else{v.x=px;v.y=py;}return v;}\n\nconst scr=await figma.getNodeByIdAsync('10:2');\nscr.children.slice().forEach(c=>c.remove());\nconst railC=await figma.getNodeByIdAsync('18:13');\nconst rail=railC.createInstance();rail.x=0;rail.y=0;scr.appendChild(rail);\nconst tbC=await figma.getNodeByIdAsync('16:6');\nconst tbi=tbC.createInstance();tbi.x=88;tbi.y=0;scr.appendChild(tbi);\n// ===== LEFT COLUMN x=112 =====\n// stats\nconst stats=[['Task Completed','08','checklist','2BB673','E3F6ED','10+ more from last week'],['New Task','10','file','F79009','FEF0E0','10+ more from last week'],['Project Done','10','grid','1DA7FF','E7F5FF','08+ more from last week']];\nfor(let i=0;i<3;i++){\n  const s=stats[i];const c=card(scr,112+i*280,104,260,108);\n  const chip=frame(40,40,s[4],{r:12});chip.x=20;chip.y=20;c.appendChild(chip);\n  const ic=mkIcon(s[2],20,s[3]);ic.x=10;ic.y=10;chip.appendChild(ic);\n  const num=txt(s[1],22,'Bold','14142B');num.x=74;num.y=20;c.appendChild(num);\n  const lab=txt(s[0],12,'Regular','6E7191');lab.x=74;lab.y=50;c.appendChild(lab);\n  const more=txt(s[5],11,'Regular','8C8C9E');more.x=20;more.y=78;c.appendChild(more);\n}\n// chart card\nconst cc=card(scr,112,236,820,356);\nconst ct=txt('Task Done',18,'Bold','14142B');ct.x=24;ct.y=20;cc.appendChild(ct);\nconst tabs=frame(176,32,'F4F5F9',{r:10});tabs.x=620;tabs.y=16;cc.appendChild(tabs);\nconst pill=frame(58,24,'FFFFFF',{r:8});pill.x=118;pill.y=4;cc.appendChild(pill);\nconst tabT=[['Daily',29,false],['Weekly',88,false],['Monthly',147,true]];\nfor(const tt of tabT){const t=txt(tt[0],12,tt[2]?'Medium':'Regular',tt[2]?'5051F9':'8C8C9E',{center:true,w:58});t.x=tt[1]-29;t.y=tt[2]?9:8;t.textAutoResize='HEIGHT';t.resize(58,t.height);cc.appendChild(t);}\npx=56;py=76;\nconst pw=720,ph=200;\nfor(let g=0;g<5;g++){const gy=py+g*50;const ln=frame(pw,1,g===0?'E1E2E9':'ECEDF3');ln.x=px;ln.y=gy;cc.appendChild(ln);const yl=txt(String(400-g*100),11,'Regular','8C8C9E',{right:true});yl.