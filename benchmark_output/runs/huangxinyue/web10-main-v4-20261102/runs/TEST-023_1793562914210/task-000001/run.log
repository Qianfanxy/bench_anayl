trokes=[];});return inst;}\nasync function photo(parent,id,x,y,w,h){const src=await figma.getNodeByIdAsync(id);const inst=src.createInstance();parent.appendChild(inst);inst.name=src.name;inst.resize(w,h);inst.x=x;inst.y=y;inst.fills=[{type:'IMAGE',scaleMode:'FILL',imageHash:src.fills[0].imageHash}];return inst;}\nasync function btn(parent,x,y,w,label,kind,h){const src=await figma.getNodeByIdAsync('1:24');const b=src.createInstance();parent.appendChild(b);b.resize(w,h||56);b.x=x;b.y=y;if(kind==='outline'){b.fills=fill(P.white);b.strokes=[{type:'SOLID',color:rgb(P.ink),opacity:1}];b.strokeWeight=1;b.strokeAlign='INSIDE';b.findOne(n=>n.type==='TEXT').fills=fill(P.ink);}const t=b.findOne(n=>n.type==='TEXT');t.characters=label;t.fontSize=14;return b;}\n\n// ---------- Field / Compact (label + input + optional icon) ----------\nconst fc = comp(lib,'Field / Compact',400,82,900,15200);\ntx(fc,'Label',0,0,{t:'First Name',s:12,w:'Medium',c:P.ink});\nbox(fc,'Input',0,24,400,58,{stroke:P.line,r:10,fill:P.white});\ntx(fc,'Placeholder',18,41,{t:'Jordan',s:13,c:P.muted});\n\n// ---------- Order summary panel ----------\nconst os = comp(lib,'Panel / Checkout Summary',520,760,900,15500);\nconst osb=box(os,'Surface',0,0,520,760,{fill:P.cream,r:18});\ntx(osb,'Title',32,28,{t:'Order Summary',s:22,f:'Volkhov',w:'Bold',c:P.ink});\nconst it=box(osb,'Item',32,84,456,110,{});\nconst iw=box(it,'Img',0,0,86,104,{fill:P.white,r:8,clip:true});\nawait photo(iw,'6:47',0,0,86,104);\ntx(it,'Name',104,4,{t:'Denim Jacket',s:16,f:'Volkhov',w:'Regular',c:P.ink});\ntx(it,'Variant',104,32,{t:'Blue',s:12,c:P.body});\ntx(it,'Qty',104,54,{t:'Qty 1',s:12,c:P.body});\nconst ip=tx(it,'Price',0,4,{t:'$39.00',s:15,w:'SemiBold',c:P.ink}); ip.x=456-ip.width;\nbox(osb,'Rule',32,218,456,1,{fill:'#DDD7CC'});\n// discount\nconst dinput=box(osb,'Discount Input',32,240,340,54,{stroke:'#D8D2C6',r:10,fill:P.white});\ntx(dinput,'P',18,16,{t:'Discount code',s:13,c:P.muted});\nawait btn(osb,384,240,104,'Apply','outline',54);\nbox(osb,'Rule2',32,318,456,1,{fill:'#DDD7CC'});\nconst rows=[['Subtotal','$39.00',352,false],['Shipping','$40.00',392,false]];\nrows.forEach((r,i)=>{\n  tx(osb,'L'+i,32,r[2],{t:r[0],s:14,c:P.body});\n  const v=tx(osb,'V'+i,0,r[2],{t:r[1],s:14,w:'Medium',c:P.ink}); v.x=488-v.width;\n});\nbox(osb,'Rule3',32,430,456,1,{fill:'#DDD7CC'});\ntx(osb,'TotalL',32,454,{t:'Total',s:16,w:'SemiBold',c:P.ink});\nconst tv=tx(osb,'TotalV',0,448,{t:'$79.00',s:26,f:'Volkhov',w:'Bold',c:P.ink}); tv.x=488-tv.width;\nbox(osb,'Rule4',32,510,456,1,{fill:'#DDD7CC'});\nawait icon(osb,'6:29',32,540,18,P.green);\ntx(osb,'Secure',58,538,{t:'Guarantee safe & secure checkout',s:12,w:'Medium',c:P.ink});\ntx(osb,'SecureNote',32,568,{t:'Your payment details are encrypted end to end.',s:11,c:P.muted});\n\n// ---------- Payment block ----------\nconst pay = comp(lib,'Block / Payment',520,470,900,16400);\ntx(pay,'Title',0,0,{t:'Payment',s:22,f:'Volkhov',w:'Bold',c:P.ink});\nconst cc=box(pay,'Card Choice',0,36,520,64,{stroke:P.ink,r:12,fill:P.white,sw:1.5});\nbox(cc,'Radio',18,22,20,20,{stroke:P.ink,r:10,fill:P.white});\nbox(cc,'Dot',23,27,10,10,{fill:P.ink,r:5});\ntx(cc,'Label',52,20,{t:'Credit Card',s:14,w:'Medium',c:P.ink});\nconst lk=await icon(cc,'6:29',474,22,18,P.body);\ntx(pay,'CardNoLabel',0,124,{t:'Card Number',s:12,w:'Medium',c:P.ink});\nconst cn=box(pay,'Card Number',0,148,520,58,{stroke:P.line,r:10,fill:P.white});\ntx(cn,'P',48,19,{t:'1234 5678 9012 3456',s:13,c:P.muted});\nawait icon(cn,'6:29',18,20,18,P.muted);\ntx(pay,'ExpLabel',0,224,{t:'Expiration Date',s:12,w:'Medium',c:P.ink});\nbox(pay,'Exp',0,248,248,58,{stroke:P.line,r:10,fill:P.white});\ntx(pay.children[pay.children.length-1],'P',18,19,{t:'MM / YY',s:13,c:P.muted});\ntx(pay,'SecLabel',272,224,{t:'Security Code',s:12,w:'Medium',c:P.ink});\nbox(pay,'Sec',272,248,248,58,{stroke:P.line,r:10,fill:P.white});\ntx(pay.children[pay.children.length-1],'P',18,19,{t:'CVC',s:13,c:P.muted});\ntx(pay,'HolderLabel',0,324,{t:'Card Holder Name',s:12,w:'Medium',c:P.ink});\nbox(pay,'Holder',0,348,520,58,{stroke:P.line,r:10,fill:P.white});\ntx(pay.children[pay.children.length-1],'P',18,19,{t:'Jordan Lee',s:13,c:P.muted});\nbox(pay,'Checkbox',0,430,20,20,{stroke:'#C9C5BD',r:4,fill:P.white});\ntx(pay,'SaveInfo',32,428,{t:'Save This Info for future',s:13,c:P.body});\nreturn {fc:fc.id, os:os.id, pay:pay.id};\n","description":"Build compact field, checkout summary and payment block components","fileKey":"zj84fVMgzEUIcsaY8ScK7u"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":149522,"input_tokens":1,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":149522}},"context_management":null},"parent_tool_use_id":null,"session_id":"45b716de-dcc2-45d2-a4d3-f5e780ce57d2","uuid":"7422a74b-0a42-4ef7-a4cc-835480278be2","timestamp":"2026-11-01T20:21:31.261Z","tool_use_meta":[{"id":"toolu_01fF3bHuQiuLebbj5Th4mtZw","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
