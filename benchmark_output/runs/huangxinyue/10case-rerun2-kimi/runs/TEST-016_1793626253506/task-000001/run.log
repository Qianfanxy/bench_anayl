.name=\"content\"; content.resize(375,660); content.fills=[];\ncontent.layoutMode=\"VERTICAL\"; content.itemSpacing=16; content.paddingLeft=16; content.paddingRight=16;\ncontent.primaryAxisSizingMode=\"FIXED\"; content.counterAxisSizingMode=\"FIXED\";\nscreen.appendChild(content); content.x=0; content.y=44;\n\n// header\nconst hComp = await get(\"6:35\"); const header = hComp.createInstance();\nheader.layoutAlign=\"STRETCH\";\nconst title = header.children.find(n=>n.name===\"title\"); title.characters=\"Expenses\";\nconst plusBtn = header.children.find(n=>n.name===\"plus\"); const plusInst = plusBtn.children[0]; recolor(plusInst, C.ink);\ncontent.appendChild(header);\n\n// period + total row\nconst prow = figma.createFrame(); prow.name=\"period row\"; prow.fills=[]; prow.layoutAlign=\"STRETCH\";\nprow.layoutMode=\"HORIZONTAL\"; prow.counterAxisAlignItems=\"CENTER\";\nconst ppComp = await get(\"7:6\"); const pp = ppComp.createInstance(); pp.layoutGrow=1; prow.appendChild(pp);\nconst spentT = mkText(\"Spent $1,812\",13,\"Medium\",C.sec); prow.appendChild(spentT);\ncontent.appendChild(prow);\n\n// budget summary\nconst bsComp = await get(\"7:19\"); const bs = bsComp.createInstance(); bs.layoutAlign=\"STRETCH\";\ncontent.appendChild(bs);\n\n// category section label\nconst cl = mkText(\"Categories\",15,\"Bold\",C.ink); content.appendChild(cl);\n\n// helper to fill category card\nasync function makeCatCard(opts){\n  const ccComp = await get(\"7:40\"); const card = ccComp.createInstance();\n  card.layoutAlign=\"STRETCH\";\n  // set head\n  const head = card.children[0];\n  const chip = head.children[0];\n  chip.fills = S(opts.chipBg);\n  const chipIcon = chip.children[0];\n  chipIcon.remove();\n  const nic = await iconInst(opts.icon, opts.chipColor, 22); chip.appendChild(nic); nic.x=9; nic.y=9;\n  const mid = head.children[1];\n  mid.children[0].characters = opts.name;\n  mid.children[1].characters = opts.items.length + \" items\";\n  const total = head.children[2]; total.characters = opts.total;\n  // items\n  const irComp = await get(\"7:28\");\n  opts.items.forEach((it, idx) => {\n    const row = irComp.createInstance(); row.layoutAlign=\"STRETCH\";\n    const top = row.children[0];\n    top.children[0].characters = it.name;\n    const right = top.children[1];\n    right.children[0].characters = it.amount;\n    right.children[1].characters = it.left;\n    if (it.over){ right.children[1].fills = S(C.red); }\n    const bar = row.children[1];\n    const fill = bar.children.find(n=>n.name===\"fill\");\n    const frac = Math.min(1, it.spent / it.budget);\n    fill.resize(311*frac, 6);\n    fill.fills = S(it.color);\n    card.appendChild(row);\n    if (idx < opts.items.length-1){\n      const d = figma.createRectangle(); d.resize(311,1); d.fills=S(C.border);\n      card.appendChild(d);\n    }\n  });\n  return card;\n}\n\nconst cat1 = await makeCatCard({\n  name:\"Auto & transport\", total:\"$600\", icon:\"2:4\",\n  chipBg:C.coralSoft, chipColor:C.coral,\n  items:[\n    {name:\"Auto & transport\", amount:\"$350\", left:\"Left $186\", spent:164, budget:350, color:C.coral},\n    {name:\"Auto insurance\", amount:\"$250\", left:\"Left $120\", spent:130, budget:250, color:C.coral}\n  ]\n});\ncontent.appendChild(cat1);\n\nconst cat2 = await makeCatCard({\n  name:\"Bill & Utilities\", total:\"$320\", icon:\"2:3\",\n  chipBg:C.brandSoft, chipColor:C.brand,\n  items:[\n    {name:\"Subscriptions\", amount:\"$52\", left:\"Left $0\", over:true, spent:52, budget:50, color:C.brand},\n    {name:\"House service\", amount:\"$138\", left:\"Left $10\", spent:128, budget:138, color:C.brand},\n    {name:\"Maintenance\", amount:\"$130\", left:\"Left $30\", spent:100, budget:130, color:C.brand}\n  ]\n});\ncat2.name=\"Bill & Utilities card\";\ncontent.appendChild(cat2);\n\n// more categories\nconst mrComp = await get(\"7:47\"); const mr = mrComp.createInstance(); mr.layoutAlign=\"STRETCH\";\ncontent.appendChild(mr);\n\n// tab bar\nconst tbComp = await get(\"6: