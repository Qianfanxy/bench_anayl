dion.appendChild(faq3);\n  faqAccordion.appendChild(faq4);\n\n  faqSection.appendChild(faqTop);\n  faqSection.appendChild(faqAccordion);\n  pageFrame.appendChild(faqSection);\n\n  // 9. BLOG / ARTICLES SECTION\n  const blogSection = figma.createFrame();\n  blogSection.name = \"Blog_Section\";\n  blogSection.layoutMode = \"VERTICAL\";\n  blogSection.layoutAlign = \"STRETCH\";\n  blogSection.primaryAxisSizingMode = \"AUTO\";\n  blogSection.paddingLeft = 80;\n  blogSection.paddingRight = 80;\n  blogSection.paddingTop = 100;\n  blogSection.paddingBottom = 100;\n  blogSection.itemSpacing = 48;\n  blogSection.fills = [{ type: 'SOLID', color: GRAY_50 }];\n\n  // Header Top Row\n  const blogTop = figma.createFrame();\n  blogTop.name = \"Blog_Header_Row\";\n  blogTop.layoutMode = \"HORIZONTAL\";\n  blogTop.layoutAlign = \"STRETCH\";\n  blogTop.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  blogTop.counterAxisAlignItems = \"CENTER\";\n  blogTop.fills = [];\n\n  const blogLeft = figma.createFrame();\n  blogLeft.layoutMode = \"VERTICAL\";\n  blogLeft.resize(700, 100);\n  blogLeft.primaryAxisSizingMode = \"AUTO\";\n  blogLeft.itemSpacing = 16;\n  blogLeft.fills = [];\n\n  const blogTitle = figma.createText();\n  blogTitle.fontName = fontBold;\n  blogTitle.fontSize = 38;\n  blogTitle.lineHeight = { value: 48, unit: 'PIXELS' };\n  blogTitle.characters = \"Digital Marketing & SEO Services That Grow Traffic & Increase Revenue\";\n  blogTitle.fills = [{ type: 'SOLID', color: INK }];\n\n  const blogSub = figma.createText();\n  blogSub.fontName = fontRegular;\n  blogSub.fontSize = 16;\n  blogSub.lineHeight = { value: 24, unit: 'PIXELS' };\n  blogSub.characters = \"We are the top digital marketing agency for branding corp. We offer a full range of services to help clients improve their search engine rankings and drive more traffic to their websites.\";\n  blogSub.fills = [{ type: 'SOLID', color: GRAY_600 }];\n\n  blogLeft.appendChild(blogTitle);\n  blogLeft.appendChild(blogSub);\n\n  con