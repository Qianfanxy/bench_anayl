{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_bc08b37c4d0041b3830928bf","name":"mcp__figma__use_figma","input":{"code":"const page = await figma.getNodeByIdAsync('11:2');\nawait figma.setCurrentPageAsync(page);\nconst F={R:{family:'Source Sans Pro',style:'Regular'},SB:{family:'Source Sans Pro',style:'SemiBold'},B:{family:'Source Sans Pro',style:'Bold'},K:{family:'Source Sans Pro',style:'Black'}};\nfor(const f of Object.values(F)) await figma.loadFontAsync(f);\nconst C={orange:'F17228',yellow:'FFB30E',ink:'1A1A1F',ink60:'55555E',ink40:'8A8A94',line:'ECECF1',white:'FFFFFF',grayTxt:'9A9AA3',footerBg:'1A1A1F',footerTxt:'B9B9C2',footerDim:'8A8A94',footerCard:'242429',footerLine:'2E2E35',circle:'2A2A31'};\nconst S=(hex,o)=>({type:'SOLID',color:{r:parseInt(hex.slice(0,2),16)/255,g:parseInt(hex.slice(2,4),16)/255,b:parseInt(hex.slice(4,6),16)/255},opacity:o===undefined?1:o});\nconst T=(p,chars,size,font,hex,opts={})=>{const t=figma.createText();t.fontName=font;t.fontSize=size;t.characters=chars;t.fills=[S(hex)];if(opts.lh)t.lineHeight={unit:'PIXELS',value:opts.lh};if(opts.name)t.name=opts.name;p.appendChild(t);return t;};\nconst icon=async(id,size,hex)=>{const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();i.resize(size,size);i.fills=[];i.findAll(n=>n.type==='VECTOR').forEach(v=>v.fills=[S(hex)]);return i;};\nfunction alFrame(name,dir,props){const f=figma.createFrame();f.name=name;f.layoutMode=dir;f.primaryAxisAlignItems=props.prim||'MIN';f.counterAxisAlignItems=props.counter||'MIN';f.primaryAxisSizingMode=props.primSize||'AUTO';f.counterAxisSizingMode=props.counterSize||'AUTO';f.paddingLeft=props.pl||0;f.paddingRight=props.pr||0;f.paddingTop=props.pt||0;f.paddingBottom=props.pb||0;f.itemSpacing=props.gap||0;f.fills=props.bg?[S(props.bg)]:[];if(props.radius)f.cornerRadius=props.radius;return f;}\nconst ids={};\n// ---------- Header / Main ----------\n{const c=figma.createComponent();c.name='Header / Main';c.layoutMode='HORIZONTAL';c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';c.resizeWithoutConstraints(1920,96);c.paddingLeft=320;c.paddingRight=320;c.primaryAxisAlignItems='SPACE_BETWEEN';c.counterAxisAlignItems='CENTER';c.fills=[S(C.white)];c.strokes=[S(C.line)];c.strokeWeight=1;c.strokeTopWeight=0;c.strokeBottomWeight=1;c.strokeLeftWeight=0;c.strokeRightWeight=0;c.x=0;c.y=-1500;\n const logo=(await figma.getNodeByIdAsync('9:27')).createInstance();logo.name='Logo_FoodWagon';c.appendChild(logo);\n const loc=alFrame('DeliverTo','HORIZONTAL',{gap:10,counter:'CENTER'});c.appendChild(loc);\n loc.appendChild(await icon('9:9',22,C.orange));\n const locCol=alFrame('LocText','VERTICAL',{gap:2});loc.appendChild(locCol);\n T(locCol,'Deliver to:',12,F.R,C.ink40,{name:'Kicker'});\n T(locCol,'Current Location',14,F.SB,C.ink,{name:'Location'});\n T(loc,'Mohammadpur Bus Stand, Dhaka',14,F.R,C.ink60,{name:'Address'});\n const sf=(await figma.getNodeByIdAsync('13:48')).createInstance();sf.name='SearchField';c.appendChild(sf);\n const login=alFrame('Login','HORIZONTAL',{gap:12,counter:'CENTER'});c.appendChild(login);\n login.appendChild(await icon('9:21',22,C.ink));\n const btn=(await figma.getNodeByIdAsync('1:28')).createInstance();btn.name='LoginButton';login.appendChild(btn);btn.resize(132,60);btn.findOne(t=>t.type==='TEXT').characters='Login';\n ids.Header=c.id;}\n// ---------- Footer / Main ----------\n{const c=figma.createComponent();c.name='Footer / Main';c.layoutMode='VERTICAL';c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='AUTO';c.resizeWithoutConstraints(1920,100);c.paddingTop=64;c.paddingBottom=28;c.primaryAxisAlignItems='MIN';c.counterAxisAlignItems='CENTER';c.fills=[S(C.footerBg)];c.x=0;c.y=-1350;\n const inner=alFrame('Inner','VERTICAL',{gap:44});c.appendChild(inner);inner.layoutSizingHorizontal='FILL';inner.paddingLeft=320;inner.paddingRight=320;\n // Row A: cities\n const cities=alFrame('Cities','VERTICAL',{gap:18});inner.appendChild(cities);\n T(cities,'Our top cities',18,F.B,C.white,{name:'Title'});\n const grid=alFrame('CityGrid','HORIZONTAL',{gap:56});cities.appendChild(grid);\n const cityCols=[['San Francisco','Los Angeles','New York City','Chicago','Columbus','Miami'],['Washington DC','Orange County','Phoenix','New Mexico','San Diego','Seattle'],['Atlanta','Las Vegas','Albuquerque','East Bay','Portland','Charlotte'],['Sacramento','Long Beach','Nashville','Denver','Oklahoma City','New Orleans']];\n for(const col of cityCols){const g=alFrame('CityCol','VERTICAL',{gap:10});grid.appendChild(g);for(const city of col){T(g,city,14,F.R,C.footerTxt,{name:'City'});}}\n // Row B: link columns\n const cols=alFrame('LinkCols','HORIZONTAL',{gap:72});inner.appendChild(cols);\n const mkCol=(title,links)=>{const g=alFrame(title,'VERTICAL',{gap:14});cols.appendChild(g);T(g,title,18,F.B,C.white,{name:'Title'});const l=alFrame('Links','VERTICAL',{gap:10});g.appendChild(l);for(const t of links){T(l,t,14,F.R,C.footerTxt,{name:'Link'});}return g;};\n mkCol('Company',['About us','Team','Careers','Blog']);\n mkCol('Contact',['Help & Support','Partner with us','Ride with us']);\n mkCol('Legal',['Terms & Conditions','Refund & Cancellation','Privacy Policy','Cookie Policy']);\n const fu=alFrame('Follow Us','VERTICAL',{gap:14});cols.appendChild(fu);\n T(fu,'Follow Us',18,F.B,C.white,{name:'Title'});\n const soc=alFrame('Socials','HORIZONTAL',{gap:12});fu.appendChild(soc);\n const social=async(id,w,h)=>{const g=alFrame('SocialButton','HORIZONTAL',{prim:'CENTER',counter:'CENTER',bg:C.circle});g.primaryAxisSizingMode='FIXED';g.counterAxisSizingMode='FIXED';g.resize(40,40);g.cornerRadius=999;const i=(await figma.getNodeByIdAsync(id)).createInstance();i.resize(w,h);i.fills=[];i.findAll(n=>n.type==='VECTOR').forEach(v=>v.fills=[S(C.white)]);g.appendChild(i);soc.appendChild(g);};\n await social('9:22',11,20);await social('9:23',20,20);await social('9:24',20,17);\n // Newsletter\n const nl=alFrame('Newsletter','HORIZONTAL',{gap:20,prim:'SPACE_BETWEEN',counter:'CENTER',bg:C.footerCard,radius:14,pl:28,pr:28,pt:20,pb:20});inner.appendChild(nl);nl.layoutSizingHorizontal='FILL';\n T(nl,'Receive exclusive offers in your mailbox',16,F.SB,C.white,{name:'NewsletterCopy'});\n const nf=alFrame('NewsletterForm','HORIZONTAL',{gap:12,counter:'CENTER'});nl.appendChild(nf);\n nf.appendChild(await icon('9:7',22,C.orange));\n const tf=(await figma.getNodeByIdAsync('1:31')).createInstance();tf.name='EmailField';nf.appendChild(tf);tf.findOne(t=>t.type==='TEXT'&&t.name==='Label').characters='Email address';tf.findOne(t=>t.type==='TEXT'&&t.name==='Placeholder').characters='Enter Your email';\n const sub=(await figma.getNodeByIdAsync('1:28')).createInstance();sub.name='SubscribeButton';nf.appendChild(sub);sub.resize(160,60);sub.findOne(t=>t.type==='TEXT').characters='Subscribe';\n // Divider + copyright\n const div=figma.createRectangle();div.name='Divider';div.resize(1280,1);div.fills=[S(C.footerLine)];inner.appendChild(div);div.layoutSizingHorizontal='FILL';\n const cp=T(inner,'All rights Reserved © FoodWagon, 2021',13,F.R,C.footerDim,{name:'Copyright'});cp.textAlignHorizontal='CENTER';inner.counterAxisAlignItems='CENTER';\n ids.Footer=c.id;}\nreturn JSON.stringify({ids});","description":"创建页头与页脚主组件（含城市列表、链接栏、社交按钮、邮件订阅、版权）","fileKey":"dRsEGioair7msWalXvYbYc"}}],"id":"52c277b1-678a-4316-af7c-2392b55be764","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"0cf375fe-7995-4021-9e71-e24c776e8096","uuid":"fc541e57-2bda-4c32-859f-76347087900a","timestamp":"2026-11-02T00:36:20.709Z","tool_use_meta":[{"id":"call_bc08b37c4d0041b3830928bf","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
