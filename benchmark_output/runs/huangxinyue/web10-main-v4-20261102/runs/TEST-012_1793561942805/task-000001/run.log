/primary')];}b.name='Button / '+label;return b;}\nfunction page(name,x,cur){const f=F(name,'VERTICAL',{w:1440,fill:'surface/white',cross:'CENTER'});f.x=x;f.y=0;f.clipsContent=true;const h=C.hdr.createInstance();f.appendChild(h);const ni=h.findOne(n=>n.name==='Nav / '+cur);ni.swapComponent(C.navCur);const body=F('Content','VERTICAL',{w:1440,gap:120,p:[48,80,120,80],cross:'CENTER',parent:f});return {f,body};}\nfunction finish(f){const ft=C.ftr.createInstance();f.appendChild(ft);}\nasync function sectionHead(parent,title,copy,centered){const s=F('Section Head',centered?'VERTICAL':'HORIZONTAL',{gap:centered?16:80,cross:centered?'CENTER':'MAX',main:centered?'MIN':'SPACE_BETWEEN',parent,fillW:true});const t=await T(title,'H1','text/primary',{parent:s,align:centered?'CENTER':'LEFT',name:'Title'});if(!centered){t.resize(620,t.height);t.textAutoResize='HEIGHT';}if(copy)await T(copy,'Body L','text/secondary',{parent:s,w:centered?640:520,align:centered?'CENTER':'LEFT',name:'Copy'});return s;}\n// ---------- 01_Home\nconst {f,body}=page('01_Home',0,'Home');\n// Featured\nconst hero=F('Featured Recipe','HORIZONTAL',{w:1280,h:640,r:40,clip:true,parent:body});\nconst hl=F('Content','VERTICAL',{w:640,p:[56,56,56,56],gap:28,main:'SPACE_BETWEEN',fill:'brand/tint',parent:hero,fillH:true});\nconst htop=F('Top','VERTICAL',{gap:24,parent:hl,fillW:true});\nconst pill=F('Hot Recipes','HORIZONTAL',{gap:8,p:[8,18,8,10],r:999,cross:'CENTER',fill:'surface/white',parent:htop}); const hi=I('Icon_Hot_Recipes',28,28,pill); hi.blendMode='MULTIPLY'; await T('Hot Recipes','Label','text/primary',{parent:pill});\nawait T('Spicy delicious chicken wings','Display','text/primary',{parent:htop,fillW:true,name:'Title'});\nawait T('Crispy outside, juicy inside and coated in a sticky, spicy glaze — these wings are ready in 30 minutes and disappear even faster.','Body L','text/secondary',{parent:htop,fillW:true,name:'Copy'});\nconst mrow=F('Meta','HORIZONTAL',{gap:12,parent:htop});\nfor(const [ic,l] of [['Icon