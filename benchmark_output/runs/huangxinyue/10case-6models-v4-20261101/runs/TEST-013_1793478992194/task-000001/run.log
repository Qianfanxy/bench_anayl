{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_bdrk_vxe57hkgnfuikjvsjp2glemqy7ozsok275dvuiseqvwubdpyb7ba","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_017vLB8Ak9d6DSBauftPyCuR","name":"mcp__figma__use_figma","input":{"code":"const P=await figma.getNodeByIdAsync('5:2'); await figma.setCurrentPageAsync(P);\nconst V={};(await figma.variables.getLocalVariablesAsync()).forEach(v=>V[v.name]=v);\nconst TS={};(await figma.getLocalTextStylesAsync()).forEach(s=>TS[s.name]=s);\nfor(const s of ['Regular','Medium','SemiBold','Bold']) await figma.loadFontAsync({family:'Roboto',style:s});\nconst MP=await figma.getNodeByIdAsync('1:4'); await MP.loadAsync(); const M={}; MP.findAll(n=>n.type==='COMPONENT').forEach(c=>M[c.name]=c);\nconst paint=t=>figma.variables.setBoundVariableForPaint({type:'SOLID',color:{r:0,g:0,b:0}},'color',V[t]);\nconst fill=(n,t)=>{n.fills=t?[paint(t)]:[];};\nconst stroke=(n,t,w=1)=>{n.strokes=[paint(t)];n.strokeWeight=w;n.strokeAlign='INSIDE';};\nconst txt=async(c,st,t='text/primary',name)=>{const x=figma.createText();await x.setTextStyleIdAsync(TS[st].id);x.characters=c;fill(x,t);x.name=name||c;return x;};\nconst al=(n,dir='HORIZONTAL',gap=0,pad=[0,0,0,0],align='MIN',cross='CENTER')=>{n.layoutMode=dir;n.itemSpacing=gap;[n.paddingTop,n.paddingRight,n.paddingBottom,n.paddingLeft]=pad;n.primaryAxisAlignItems=align;n.counterAxisAlignItems=cross;n.primaryAxisSizingMode='AUTO';n.counterAxisSizingMode='AUTO';fill(n,null);return n;};\nconst fr=(name,...a)=>{const f=figma.createFrame();f.name=name;return al(f,...a);};\nconst comp=(name,...a)=>{const f=figma.createComponent();f.name=name;return al(f,...a);};\nconst recolor=(inst,t)=>inst.findAll(v=>['VECTOR','BOOLEAN_OPERATION','ELLIPSE','RECTANGLE','LINE','STAR','POLYGON'].includes(v.type)).forEach(v=>{if(v.strokes.length)v.strokes=[paint(t)];if(v.fills!==figma.mixed&&v.fills.length)v.fills=[paint(t)];});\nconst icon=(name,t='text/primary',size)=>{const i=M[name].createInstance();i.name=name;if(size&&size!==i.width)i.rescale(size/i.width);recolor(i,t);return i;};\nconst add=(p,...k)=>{k.forEach(c=>p.appendChild(c));return p;};\nconst W=v=>v; \n// ---- container\nconst DS=figma.createFrame();DS.name='Components · Stock Trading';DS.x=0;DS.y=2200;al(DS,'HORIZONTAL',64,[64,64,64,64],'MIN','MIN');DS.layoutWrap='WRAP';DS.counterAxisSpacing=64;DS.resize(3200,100);DS.primaryAxisSizingMode='FIXED';fill(DS,'bg/base');DS.cornerRadius=24;\nconst set=(comps,name)=>{const s=figma.combineAsVariants(comps,DS);s.name=name;al(s,'HORIZONTAL',24,[24,24,24,24],'MIN','MIN');s.layoutWrap='WRAP';s.counterAxisSpacing=24;s.primaryAxisSizingMode='AUTO';stroke(s,'border/subtle');s.dashPattern=[6,4];s.cornerRadius=16;fill(s,'bg/base');return s;};\n// ---- Header\nconst hdr=[];\nfor(const type of ['Main','Sub','Detail']){\n const c=comp('Type='+type,'HORIZONTAL',0,[0,16,0,16],'SPACE_BETWEEN','CENTER');c.resize(375,56);c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';fill(c,'bg/base');\n const left=icon(type==='Main'?'Icon_Menu':'Icon_Back');left.name=type==='Main'?'Menu':'Back';\n const title=await txt(type==='Main'?'Aktivitas':'Top Up','Heading/H2','text/primary','Title');title.textAlignHorizontal='CENTER';\n if(type==='Detail'){const r=fr('Actions','HORIZONTAL',20);const a=icon('Icon_Plus');a.name='Add';const s=icon('Icon_Share');s.name='Share';const f=icon('Icon_Star');f.name='Favorite';add(r,a,s,f);add(c,left,r);}\n else {const right=icon(type==='Main'?'Icon_Settings':'Icon_Help');right.name=type==='Main'?'Settings':'Help';add(c,left,title,right);}\n hdr.push(c);}\nconst HS=set(hdr,'Header');\n// ---- Tab item\nconst tabs=[];\nfor(const st of ['Active','Inactive']){\n const c=comp('State='+st,'VERTICAL',4,[8,0,8,0],'CENTER','CENTER');c.resize(75,60);c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';\n const ind=figma.createRectangle();ind.name='Indicator';ind.resize(24,3);ind.cornerRadius=2;fill(ind,st==='Active'?'brand/primary':null);\n const ic=icon('Icon_Tab_Aktivitas',st==='Active'?'gain/fg':'text/tertiary',22);ic.name='Icon';\n const l=await txt('Aktivitas',st==='Active'?'Micro/Medium':'Micro/Medium',st==='Active'?'gain/fg':'text/tertiary','Label');\n add(c,ind,ic,l);tabs.push(c);}\nconst TI=set(tabs,'Tab Item');\n// ---- Chip\nconst chips=[];\nfor(const st of ['Selected','Default']){const c=comp('State='+st,'HORIZONTAL',0,[8,16,8,16],'CENTER','CENTER');c.cornerRadius=999;\n if(st==='Selected'){fill(c,'brand/primary');}else{fill(c,'bg/surface');stroke(c,'border/subtle');}\n add(c,await txt('Asia','Label/Medium',st==='Selected'?'text/on-brand':'text/secondary','Label'));chips.push(c);}\nset(chips,'Chip');\n// ---- Segment tab\nconst segs=[];\nfor(const st of ['Selected','Default']){const c=comp('State='+st,'VERTICAL',8,[10,0,0,0],'MIN','CENTER');\n const l=await txt('Global','Body/Strong',st==='Selected'?'text/primary':'text/tertiary','Label');\n const u=figma.createRectangle();u.name='Underline';u.resize(40,3);u.cornerRadius=2;fill(u,st==='Selected'?'brand/primary':null);\n add(c,l,u);u.layoutSizingHorizontal='FILL';c.paddingLeft=4;c.paddingRight=4;segs.push(c);}\nset(segs,'Segment Tab');\n// ---- Range tab\nconst rng=[];\nfor(const st of ['Selected','Default']){const c=comp('State='+st,'HORIZONTAL',0,[6,0,6,0],'CENTER','CENTER');c.resize(38,28);c.primaryAxisSizingMode='FIXED';c.cornerRadius=6;fill(c,st==='Selected'?'selected/bg':null);\n add(c,await txt('1D','Label/Medium',st==='Selected'?'gain/fg':'text/tertiary','Label'));rng.push(c);}\nset(rng,'Range Tab');\n// ---- Change badge\nconst bd=[];\nfor(const d of ['Up','Down']){const c=comp('Direction='+d,'HORIZONTAL',2,[3,8,3,6],'MIN','CENTER');c.cornerRadius=999;fill(c,d==='Up'?'gain/bg':'loss/bg');\n const a=icon(d==='Up'?'Icon_Arrow_Up':'Icon_Arrow_Down',d==='Up'?'gain/fg':'loss/fg',12);a.name='Arrow';\n add(c,a,await txt(d==='Up'?'+50 (+0,58%)':'−9 (−4,55%)','Label/Medium',d==='Up'?'gain/fg':'loss/fg','Value'));bd.push(c);}\nset(bd,'Change Badge');\n// ---- Action button\nconst bt=[];\nconst btSpec=[['Primary','Default','brand/primary','text/on-brand',null],['Primary','Pressed','brand/pressed','text/on-brand',null],['Primary','Disabled','disabled/bg','disabled/fg',null],['Danger','Default','loss/fg','text/on-brand',null],['Danger','Pressed','loss/bg','loss/fg',null],['Secondary','Default',null,'gain/fg','brand/primary'],['Secondary','Pressed','brand/tint','gain/fg','brand/primary']];\nfor(const [v,s,bg,fg,st] of btSpec){const c=comp(`Variant=${v}, State=${s}`,'HORIZONTAL',0,[0,0,0,0],'CENTER','CENTER');c.resize(160,48);c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';c.cornerRadius=8;fill(c,bg);if(st)stroke(c,st,1.5);\n add(c,await txt(v==='Danger'?'Jual':v==='Secondary'?'Ganti':'Beli','Title/Section',fg,'Label'));bt.push(c);}\nset(bt,'Button / Action');\n// ---- Text field states\nconst tf=[];\nfor(const [s,bg,brd,tc,val] of [['Empty','bg/surface-2',null,'text/tertiary','Minimal Rp10.000'],['Focused','bg/surface-2','brand/primary','text/tertiary','Minimal Rp10.000'],['Filled','bg/surface-2',null,'text/primary','Rp750.000'],['Error','bg/surface-2','loss/fg','text/primary','Rp5.000'],['Disabled','disabled/bg',null,'disabled/fg','Minimal Rp10.000']]){\n const c=comp('State='+s,'HORIZONTAL',0,[0,16,0,16],'MIN','CENTER');c.resize(335,48);c.primaryAxisSizingMode='FIXED';c.counterAxisSizingMode='FIXED';c.cornerRadius=8;fill(c,bg);if(brd)stroke(c,brd,1.5);\n add(c,await txt(val,'Body/Regular',tc,'Value'));tf.push(c);}\nset(tf,'Text Field / States');\nreturn {HS:HS.id,TI:TI.id,DS:DS.id};","description":"Build base components: header, tab item, chip, segment, range, badge, buttons, text field states","fileKey":"YrTPLf9m7JWQ8bXXXJcUlA"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":32740,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":32740,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"235036c5-5c0b-434d-bf2d-9b106a96a136","uuid":"c2352c9a-fff6-4116-ac83-297a45cd766f","timestamp":"2026-10-31T20:40:10.441Z","tool_use_meta":[{"id":"toolu_bdrk_017vLB8Ak9d6DSBauftPyCuR","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
