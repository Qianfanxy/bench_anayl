ium', hi?C.brand:C.gray);\n  m.textAlignHorizontal='CENTER'; m.resize(34, m.height); m.x=pts[i][0]-17; m.y=130; chart.appendChild(m);\n}\nchart.x = 2600; chart.y = 360;\n\n// ---------- Promo Card ----------\nconst promo = figma.createComponent();\npromo.name = 'Expenio / Promo Card';\npromo.resize(343, 96); promo.cornerRadius=16; promo.fills=solid(C.white); promo.effects=shadow; promo.clipsContent=true;\nconst badge = figma.createRectangle(); badge.resize(64,18); badge.cornerRadius=6; badge.x=16; badge.y=16; badge.fills=solid(C.brand); promo.appendChild(badge);\nconst badgeT = txt('POPULAR', 10, 'Semi Bold', C.white); badgeT.textAlignHorizontal='CENTER'; badgeT.resize(64, badgeT.height); badgeT.x=16; badgeT.y=20; promo.appendChild(badgeT);\nconst pTitle = txt('Get up to 15% cashback on clothing and apparel', 14, 'Semi Bold', C.ink);\npTitle.textAutoResize='HEIGHT'; pTitle.resize(200, pTitle.height); pTitle.x=16; pTitle.y=42; promo.appendChild(pTitle);\nconst pImgWrap = figma.createFrame(); pImgWrap.resize(88,66); pImgWrap.cornerRadius=12; pImgWrap.x=239; pImgWrap.y=15; pImgWrap.clipsContent=true; pImgWrap.fills=solid(C.surface);\nconst pImg = await instOf('5:8', 88, 66); pImgWrap.appendChild(pImg);\npromo.appendChild(pImgWrap);\npromo.x = 2600; promo.y = 540;\n\n// ---------- Field / Focused (card number, filled) ----------\nconst ff = figma.createComponent();\nff.name='Expenio / Field Focused';\nff.resize(343,73); ff.fills=[];\nconst ffL = txt('Card number', 14, 'Semi Bold', C.ink); ffL.x=0; ffL.y=0; ff.appendChild(ffL);\nconst ffBox = figma.createFrame(); ffBox.resize(343,48); ffBox.x=0; ffBox.y=25; ffBox.cornerRadius=10;\nffBox.fills=solid(C.white); ffBox.strokes=solid(C.brand); ffBox.strokeWeight=2; ff.appendChild(ffBox);\nconst ffV = txt('5412 7534 0089 2216', 16, 'Medium', C.ink); ffV.x=16; ffV.y=39; ff.appendChild(ffV);\nconst caret = figma.createRectangle(); caret.resize(2,22); caret.x=172; caret.y=38; caret.fills=solid(C.brand); ff.appendChild(caret);\nconst mc = await instOf('6:11', 34, 23); mc.x=343-16-34; mc.y=37; ff.appendChild(mc);\nff.x = 2600; ff.y = 680;\n\n// ---------- Field / Compact (164 wide, optional help icon) ----------\nconst fc = figma.createComponent();\nfc.name='Expenio / Field Compact';\nfc.resize(164,73); fc.fills=[];\nconst fcL = txt('Expiry Date', 14, 'Semi Bold', C.ink); fc.appendChild(fcL);\nconst fcBox = figma.createFrame(); fcBox.resize(164,48); fcBox.x=0; fcBox.y=25; fcBox.cornerRadius=10; fcBox.fills=solid(C.surface); fc.appendChild(fcBox);\nconst fcP = txt('MM / YY', 16, 'Regular', C.gray); fcP.x=14; fcP.y=39; fc.appendChild(fcP);\nconst fcH = await instOf('6:5', 20, 20); fcH.x=164-14-20; fcH.y=39; fc.appendChild(fcH);\nfc.x = 2600; fc.y = 790;\n\n// ---------- Header / Nav ----------\nconst nav = figma.createComponent();\nnav.name='Expenio / Header Nav';\nnav.resize(375,44); nav.fills=[];\nconst nL = await instOf('6:3', 24, 24); nL.x=16; nL.y=10; nL.name='Left Icon'; nav.appendChild(nL);\nconst nT = txt('Wallet', 17, 'Semi Bold', C.ink); nT.textAlignHorizontal='CENTER'; nT.resize(375, nT.height); nT.x=0; nT.y=11; nT.name='Title'; nav.appendChild(nT);\nconst nR = await instOf('6:6', 24, 24); nR.x=335; nR.y=10; nR.name='Right Icon'; nav.appendChild(nR);\nnav.x = 2600; nav.y = 900;\n\nreturn {row:row.id, card:card.id, chart:chart.id, promo:promo.id, fieldFocused:ff.id, fieldCompact:fc.id, header:nav.id};","description":"Create reusable Expenio components in workspace","fileKey":"OHClunQ9Zd1sWb1qp1X84s"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"40af89c4-d68b-44d7-a56d-c7fe152ae445","uuid":"33217eb4-dc04-430d-b33d-25ebea444862","timestamp":"2026-11-01T00:21:00.863Z","tool_use_meta":[{"id":"mcp__figma__use_figma_14_ac7057b6","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
