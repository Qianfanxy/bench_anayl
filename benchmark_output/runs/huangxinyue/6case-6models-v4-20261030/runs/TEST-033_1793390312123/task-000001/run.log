endChild(bannersRow);\n\n  // Shortcuts grid (2 rows of 4): Deposit · Earn · Gift card · More · Orders · Referral · Save coins · Shop\n  const shortcutsData = [\n    { label: \"Deposit\", icon: \"2:103\" },\n    { label: \"Earn\", icon: \"2:113\" },\n    { label: \"Gift card\", icon: \"2:133\" },\n    { label: \"More\", icon: \"2:138\" },\n    { label: \"Orders\", icon: \"2:123\" },\n    { label: \"Referral\", icon: \"2:108\" },\n    { label: \"Save coins\", icon: \"2:118\" },\n    { label: \"Shop\", icon: \"2:128\" }\n  ];\n\n  const gridShortcuts = figma.createFrame();\n  gridShortcuts.resize(342, 120);\n  gridShortcuts.x = 24; gridShortcuts.y = 230;\n  gridShortcuts.fills = [];\n\n  shortcutsData.forEach((s, idx) => {\n    const col = idx % 4;\n    const row = Math.floor(idx / 4);\n    \n    const item = figma.createFrame();\n    item.resize(80, 56);\n    item.x = col * 86; item.y = row * 62;\n    item.fills = [];\n    item.layoutMode = \"VERTICAL\";\n    item.counterAxisAlignItems = \"CENTER\";\n    item.itemSpacing = 4;\n\n    const ic = getComponent(s.icon);\n    if (ic) item.appendChild(ic);\n\n    const lbl = figma.createText();\n    lbl.fontName = { family: \"Poppins\", style: \"Medium\" };\n    lbl.fontSize = 11; lbl.characters = s.label;\n    lbl.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n    item.appendChild(lbl);\n\n    gridShortcuts.appendChild(item);\n  });\n  f7.appendChild(gridShortcuts);\n\n  // Section: Exchange rates (Same as 03)\n  const secRateHeader7 = figma.createFrame();\n  secRateHeader7.resize(342, 24);\n  secRateHeader7.x = 24; secRateHeader7.y = 360;\n  secRateHeader7.fills = [];\n  \n  const titleRates7 = figma.createText();\n  titleRates7.fontName = { family: \"Poppins\", style: \"Bold\" };\n  titleRates7.fontSize = 16; titleRates7.characters = \"Exchange rates\";\n  titleRates7.x = 0; titleRates7.y = 0;\n  titleRates7.fills = [{ type: \"SOLID\", color: TEXT_MAIN }];\n  secRateHeader7.appendChild(titleRates7);\n\n  const seeAllR