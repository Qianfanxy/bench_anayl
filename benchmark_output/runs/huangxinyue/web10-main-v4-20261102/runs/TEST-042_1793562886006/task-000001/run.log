ldren[0].mainComponent = M[photo];\n  imgWrap.children[0].resize(266,180);\n  card.findOne(n=>n.name==='Title').characters = title;\n  const chips = card.findOne(n=>n.name==='Meta');\n  chips.children[0].findOne(n=>n.name==='Label').characters = '30 Minutes';\n  chips.children[1].findOne(n=>n.name==='Label').characters = cat;\n  if (fav) imgWrap.children[1].mainComponent = byName('Favorite / Active');\n  card.name = 'Card / ' + title;\n  return card;\n}\nfunction recommended(titleText){\n  const sec = frame('Recommended');\n  al(sec,'VERTICAL',{pl:80,pr:80,pt:48,pb:32,gap:40});\n  const t = text(titleText,'Bold',32); t.name='Title';\n  sec.appendChild(t);\n  const row = frame('Row'); al(row,'HORIZONTAL',{gap:32});\n  const data = [['Photo_Tropical_Fruit_Salad','Mixed Tropical Fruit Salad with Superfood Boosts','Healthy',true],\n    ['Photo_Wagyu_Cheeseburger_Alt','Big and Juicy Wagyu Beef Cheeseburger','Western',false],\n    ['Photo_Japanese_Fried_Rice','Healthy Japanese Fried Rice with Asparagus','Healthy',false],\n    ['Photo_Cauliflower_Taco','Cauliflower Walnut Vegetarian Taco Meat','Eastern',false]];\n  for (const [p,tt,cat,fav] of data) row.appendChild(recCard(p,tt,cat,fav));\n  sec.appendChild(row);\n  row.primaryAxisSizingMode='FIXED'; row.counterAxisSizingMode='FIXED';\n  row.resize(1280, row.children[0].height);\n  row.primaryAxisSizingMode='FIXED'; row.counterAxisSizingMode='AUTO';\n  sec.resize(1440, Math.round(sec.height));\n  return sec;\n}\n\nconst rec = recommended('You may like these recipes too');\nrecipe.appendChild(rec); rec.layoutAlign='STRETCH';\n\nconst nl = frame('Newsletter');\nal(nl,'HORIZONTAL',{pl:80,pr:80,pt:32,pb:80,justify:'CENTER'});\nnl.appendChild(byName('Newsletter Card').createInstance());\nnl.resize(1440, Math.round(nl.height));\nrecipe.appendChild(nl); nl.layoutAlign='STRETCH';\n\nconst footer = byName('Footer').createInstance();\nrecipe.appendChild(footer); footer.layoutAlign='STRETCH';\n\nrecipe.resize(1440, Math.round(recipe.height));\nreturn { h: recipe.height, secs: recipe.children.map(c=>c.name) };","description":"Add recommended recipes, newsletter, footer to 02_Recipe"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"eb6a87e1-77d2-4750-aa78-08940da487c1","uuid":"e733766a-c7f5-4794-8e52-751881069ba0","timestamp":"2026-11-01T20:19:24.695Z","tool_use_meta":[{"id":"mcp__figma__use_figma_63_9a28c087","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
