used (amber ring, entered value).');\n\n// ---------- Field / Filter ----------\nconst gFilter = group('Field / Filter');\nconst rFilter = row(gFilter, 32);\nasync function filterField(name, opts) {\n  const f = givenTF.clone(); f.name = name;\n  f.counterAxisSizingMode = 'FIXED'; f.resize(280, f.height);\n  f.findOne(n => n.name === 'Label').characters = opts.label;\n  const ph = f.findOne(n => n.name === 'Placeholder'); ph.characters = opts.ph;\n  if (opts.phColor) ph.fills = [{ type: 'SOLID', color: opts.phColor }];\n  const input = f.findOne(n => n.name === 'Input');\n  input.itemSpacing = 10; input.counterAxisAlignItems = 'CENTER';\n  input.appendChild(await icon('3:9', C.muted, 14));\n  if (opts.open) { input.strokes = [{ type: 'SOLID', color: C.amber }]; input.strokeWeight = 2; }\n  return f;\n}\nrFilter.appendChild(await filterField('Field / Filter', { label: 'Looking for', ph: 'Any' }));\nconst openWrap = F('open-state'); AL(openWrap, { dir: 'VERTICAL', gap: 8 });\nopenWrap.appendChild(await filterField('Field / Filter / Open', { label: 'Property Type', ph: 'House', phColor: C.ink, open: true }));\nconst pop = F('Options'); solid(pop, C.white); pop.cornerRadius = 12;\npop.strokes = [{ type: 'SOLID', color: C.border }]; pop.strokeWeight = 1;\npop.effects = [{ type: 'DROP_SHADOW', color: { r: 0.07, g: 0.07, b: 0.09, a: 0.12 }, offset: { x: 0, y: 12 }, radius: 32, spread: 0, visible: true, blendMode: 'NORMAL' }];\nAL(pop, { dir: 'VERTICAL', pad: [8, 8, 8, 8] });\npop.counterAxisSizingMode = 'FIXED'; pop.resize(280, pop.height);\nconst optSel = F('Selected'); solid(optSel, C.tint); optSel.cornerRadius = 8;\nAL(optSel, { dir: 'HORIZONTAL', pad: [10, 12, 10, 12], cross: 'CENTER' });\noptSel.appendChild(T('House', { size: 15, style: 'Medium', color: C.ink }));\noptSel.layoutSizingHorizontal = 'FILL';\npop.appendChild(optSel);\nfor (const o of ['Apartment', 'Townhouse', 'Condo']) {\n  const oo = F('Option'); AL(oo, { dir: 'HORIZONTAL', pad: [10, 12, 10, 12], cross: