stance(); if(w)i.resize(w,h||w); return i;};\nconst icon=async(id,col,s)=>{const i=await inst(id); if(s) i.rescale(s/i.width); if(col) i.findAll(n=>n.type==='VECTOR').forEach(v=>v.fills=solid(col)); return i;};\nconst sec=await N('17:2'); let y=Math.max(...sec.children.map(c=>c.y+c.height))+80;\nfunction place(n,x=80){sec.appendChild(n); n.x=x; n.y=y; y+=n.height+80;}\nconst ids={};\n// Header base\nconst navSet=await N('17:11'); const navNo=navSet.children.find(c=>c.name==='Current=No');\nasync function header(cur){\n const h=AL('HORIZONTAL',{fill:C.white,pad:[0,100,0,100],align:'CENTER',justify:'SPACE_BETWEEN',name:'Header'}); h.primaryAxisSizingMode='FIXED'; h.counterAxisSizingMode='FIXED'; h.resize(1440,96);\n h.effects=[{type:'DROP_SHADOW',color:{r:0,g:0,b:0,a:0.06},offset:{x:0,y:2},radius:12,spread:0,visible:true,blendMode:'NORMAL'}];\n const brand=AL('HORIZONTAL',{gap:6,align:'CENTER',name:'Brand'}); brand.appendChild(await inst('13:3',48,48)); brand.appendChild(T('Furniro',32,'Bold',C.ink,{name:'Wordmark'})); h.appendChild(brand);\n const nav=AL('HORIZONTAL',{gap:64,align:'CENTER',name:'Navigation'});\n for(const l of ['Home','Shop','About','Contact']){const n=navNo.createInstance(); n.name='Nav/'+l; const k=Object.keys(n.componentProperties).find(k=>k.startsWith('Label')); n.setProperties({[k]:l}); if(l===cur) n.setProperties({Current:'Yes'}); nav.appendChild(n);} h.appendChild(nav);\n const act=AL('HORIZONTAL',{gap:36,align:'CENTER',name:'Actions'});\n for(const [nm,id] of [['Account','13:33'],['Search','13:40'],['Wishlist','13:53'],['Cart','13:26']]){const i=await icon(id,C.ink); i.name='Action/'+nm; act.appendChild(i);} h.appendChild(act);\n const c=figma.createComponentFromNode(h); c.name='Current='+cur; return c;}\nconst hs=[]; for(const cur of ['Home','Shop','Contact','None']) hs.push(await header(cur));\nhs.forEach(c=>sec.appendChild(c)); const hset=figma.combineAsVariants(hs,sec); hset.name='Header'; hset.layoutMode='VERTICAL'; hset.itemSpacing=24; hset.paddingLeft=hset.paddingRight=hset.paddingTop=hset.paddingBottom=24; hset.primaryAxisSizingMode='AUTO';hset.counterAxisSizingMode='AUTO'; hset.fills=solid('#F0F0F0'); hset.strokes=solid('#9747FF'); hset.dashPattern=[6,4]; place(hset); ids.header=hset.id;\n\n// Footer\nconst ft=AL('VERTICAL',{fill:C.white,pad:[64,100,40,100],gap:40,name:'Footer'}); ft.counterAxisSizingMode='FIXED'; ft.resize(1440,10); ft.strokeTopWeight=1; ft.strokes=solid(C.line); ft.strokeBottomWeight=0; ft.strokeLeftWeight=0; ft.strokeRightWeight=0;\nconst cols=AL('HORIZONTAL',{gap:0,justify:'SPACE_BETWEEN',name:'Columns'}); ft.appendChild(cols); cols.layoutSizingHorizontal='FILL';\nconst c1=AL('VERTICAL',{gap:40,name:'Brand'}); c1.appendChild(T('Furniro.',24,'Bold',C.ink)); c1.appendChild(T('400 University Drive Suite 200, Coral Gables,\\nFL 33134 USA',16,'Regular',C.muted,{lh:24,name:'Address'})); cols.appendChild(c1);\nfunction linkCol(title,items){const c=AL('VERTICAL',{gap:40,name:title}); c.appendChild(T(title,16,'Medium',C.muted,{name:'Title'})); for(const it of items){const t=T(it,16,'Medium',C.ink,{name:'Link/'+it}); c.appendChild(t);} return c;}\ncols.appendChild(linkCol('Links',['Home','Shop','About','Contact','Blog'])); cols.appendChild(linkCol('Help',['Payment Options','Returns','Privacy Policies']));\nconst c4=AL('VERTICAL',{gap:40,name:'Newsletter'}); c4.appendChild(T('Newsletter',16,'Medium',C.muted,{name:'Title'}));\nconst row=AL('HORIZONTAL',{gap:12,align:'MAX'}); const em=AL('VERTICAL',{gap:4}); em.appendChild(T('Enter Your Email Address',14,'Regular',C.muted,{name:'Email placeholder'})); const ul=figma.createRectangle(); ul.resize(200,1); ul.fills=solid(C.ink); em.appendChild(ul); row.appendChild(em);\nconst sb=AL('VERTICAL',{gap:4,name:'Subscribe'}); sb.appendChild(T('SUBSCRIBE',14,'Medium',C.ink)); const ul2=figma.createRectangle(); ul2.resize(76,1); ul2.fills=solid(C.ink); sb.appendChild(ul2); row.appendChild(sb); c4.appendChild(row); cols.appendChild(c4);\nconst dv=figma.createRectangle(); dv.name='Divider'; dv.resize(1240,1); dv.fills=solid(C.line); ft.appendChild(dv); dv.layoutSizingHorizontal='FILL';\nft.appendChild(T('2023 Furniro. All rights reserved',16,'Regular',C.ink,{name:'Copyright'}));\nconst fc=figma.createComponentFromNode(ft); place(fc); ids.footer=fc.id;\n\n// Feature strip\nconst fsF=AL('HORIZONTAL',{fill:C.cream,pad:[96,100,96,100],justify:'SPACE_BETWEEN',align:'CENTER',name:'Feature Strip'}); fsF.primaryAxisSizingMode='FIXED'; fsF.resize(1440,10);\nfor(const [t,l,id] of [['High Quality','crafted from top materials','13:38'],['Warranty Protection','Over 2 years','13:42'],['Free Shipping','Order over Rs. 150,000','13:25'],['24 / 7 Support','Dedicated support','13:41']]){const it=AL('HORIZONTAL',{gap:12,align:'CENTER',name:'Feature/'+t}); it.appendChild(await icon(id,C.ink)); const tx=AL('VERTICAL',{gap:2}); tx.appendChild(T(t,24,'SemiBold',C.ink,{name:'Title'})); tx.appendChild(T(l,18,'Medium',C.muted,{name:'Line'})); it.appendChild(tx); fsF.appendChild(it);}\nconst fsc=figma.createComponentFromNode(fsF); place(fsc); ids.features=fsc.id;\nsec.resizeWithoutConstraints(3000,y+200);\nreturn JSON.stringify(ids);","description":"Create Header variants, Footer, Feature Strip components","fileKey":"SpBMJAM0UYyUkLizLNGfSY"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":42279,"cache_read_input_tokens":7702,"cache_creation":{"ephemeral_5m_input_tokens":42279,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"753f1172-7f5a-41f7-ae4e-eb68ec9f64d7","uuid":"455e3f67-64c3-46b5-99c0-7235f32807ee","timestamp":"2026-11-01T19:14:51.343Z","tool_use_meta":[{"id":"toolu_bdrk_01XaSx82cNoBwuRbCm84R8w1","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
