{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_a239d570c6504ac6abd65aad","name":"mcp__figma__use_figma","input":{"code":"for (const s of ['Regular','Medium','SemiBold','Bold']) await figma.loadFontAsync({family:'Roboto',style:s});\nconst page = await figma.getNodeByIdAsync('5:2');\nconst C = { bg:{r:0.047,g:0.055,b:0.051}, txt:{r:0.949,g:0.949,b:0.949}, sec:{r:0.663,g:0.698,b:0.675}, ter:{r:0.439,g:0.478,b:0.455}, gain:{r:0.243,g:0.812,b:0.494}, loss:{r:0.965,g:0.357,b:0.357}, brandB:{r:0.180,g:0.682,b:0.325} };\nconst solid=(c,o)=>({type:'SOLID',color:c,opacity:(o===undefined?1:o)});\nconst R={};\nfor (const [k,id] of Object.entries({status:'1:30',home:'1:40',tabbar:'8:11',hdr:'8:36',sect:'8:70',idx:'10:60',chip:'8:69',rec:'10:54',row:'10:43',chevD:'2:45',chevR:'2:48',arrD:'2:13',L_ROTI:'3:31',L_GOTO:'3:45',L_ABNB:'3:47',L_UNVR:'3:46',L_BBRI:'3:44',L_ADRO:'3:48'})) R[k]=await figma.getNodeByIdAsync(id);\nconst txt=(n,name)=>n.findOne(x=>x.name===name&&x.type==='TEXT');\nfunction chipInst(state,label){ const v=R.chip.children.find(c=>c.name==='State='+state); const i=v.createInstance(); txt(i,'Label').characters=label; return i; }\n\nconst f=figma.createFrame(); page.appendChild(f); f.name='02_Trending'; f.resize(375,812); f.x=475; f.y=0; f.fills=[solid(C.bg)]; f.clipsContent=true;\n\nconst sb=R.status.createInstance(); f.appendChild(sb); sb.x=0; sb.y=0;\nconst hd=R.hdr.createInstance(); f.appendChild(hd); hd.x=0; hd.y=52; txt(hd,'Title').characters='Trending';\n\nconst idxRow=figma.createFrame(); idxRow.name='Indices'; idxRow.fills=[]; idxRow.layoutMode='HORIZONTAL'; idxRow.itemSpacing=8;\nf.appendChild(idxRow); idxRow.x=16; idxRow.y=104;\nconst idata=[['IHSG','7.206,92',true],['NIKKEI','27.105,20',false],['SENSEX','59.959,85',true]];\nfor (const [nm,val,up] of idata){\n  const ic=R.idx.createInstance(); idxRow.appendChild(ic);\n  txt(ic,'Name').characters=nm; txt(ic,'Value').characters=val;\n  if(!up){ const a=ic.findOne(n=>n.name==='Arrow