00);}\n else {f.resize(opts.w||100,opts.h||100);}\n f.primaryAxisAlignItems=opts.align||'MIN';f.counterAxisAlignItems=opts.cross||'MIN';\n if(opts.radius)f.cornerRadius=opts.radius;return f;}\nfunction row(name,w,h,gap,pad,align,cross){const f=F(name,{dir:'HORIZONTAL',w,w:undefined,h,gap,pad,align,cross});return f;}\nfunction clone(id){return figma.getNodeByIdAsync(id).then(c=>c.createInstance());}\nconst page1 = figma.createFrame();\npage1.name='01_Home'; page1.resize(1440,100); page1.layoutMode='VERTICAL'; page1.itemSpacing=0;\npage1.paddingTop=0;page1.paddingRight=0;page1.paddingBottom=0;page1.paddingLeft=0;\npage1.primaryAxisSizingMode='AUTO';page1.counterAxisSizingMode='FIXED';page1.fills=[solid(C.bg)];\npage1.x=0;page1.y=0;\npage1.clipsContent=true;\n\n/* ---------- HEADER ---------- */\nconst header=F('Header',{dir:'HORIZONTAL',h:88,pad:[0,80,0,80],align:'SPACE_BETWEEN',cross:'CENTER'});\nheader.fills=[solid(C.bg)];header.strokes=[solid(C.border)];header.strokeWeight=1;header.strokeAlign='INSIDE';\nheader.strokeTopWeight=0;header.strokeLeftWeight=0;header.strokeRightWeight=0;\npage1.appendChild(header);header.layoutSizingHorizontal='FILL';\nconst logo=await clone('3:4'); logo.name='Logo_ABM'; logo.resize(132,75); header.appendChild(logo);\nconst nav=row('Nav',10,40,38,[0,0,0,0],'CENTER','CENTER'); nav.fills=[]; header.appendChild(nav);\nconst navItems=[['Home','7:56'],['Projects','7:50'],['Experience','7:50'],['Contact','7:50']];\nfor(const [label,src] of navItems){\n  const inst=await clone(src); inst.name='NavItem / '+label;\n  const t=inst.findOne(n=>n.type==='TEXT'); t.characters=label;\n  nav.appendChild(inst);\n}\nconst hdrBtn=await clone('7:41'); header.appendChild(hdrBtn);\nconst hb=await clone('7:45'); hb.name='Button / Outline';\nconst hbLabel=hb.findOne(n=>n.type==='TEXT'); hbLabel.characters='Download CV';\nheader.appendChild(hb);\n\n/* ---------- HERO ---------- */\nconst hero=F('Hero',{dir:'HORIZONTAL',pad:[104,80,120,80],gap:56,cross:'CENTER'})