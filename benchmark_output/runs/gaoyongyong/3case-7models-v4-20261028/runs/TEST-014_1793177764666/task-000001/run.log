o={}){p.appendChild(c); if(o.fillW) c.layoutSizingHorizontal='FILL'; if(o.grow) c.layoutGrow=1; return c;}\nfunction place(p,n,x,y){p.appendChild(n); n.x=x; n.y=y; return n;}\nasync function inst(id,variant){const n=await N(id); if(n.type==='COMPONENT_SET'){const v=n.children.find(c=>c.name===variant); if(!v) throw new Error('variant '+variant+' in '+n.name); return v.createInstance();} return n.createInstance();}\nfunction setP(i,map){const pr=i.componentProperties; const o={}; for(const [k,v] of Object.entries(map)){const key=Object.keys(pr).find(x=>x.split('#')[0]===k); if(!key) throw new Error('no prop '+k+' on '+i.name); o[key]=v;} i.setProperties(o); return i;}\nasync function screen(name,i){const f=figma.createFrame(); f.name=name; f.resize(375,812); f.x=i*455; f.y=0; f.fills=[P('surface/background')]; f.clipsContent=true;\n const sb=await inst('6:110'); sb.fills=[P('surface/background')]; place(f,sb,0,0); sb.name='Status Bar'; return f;}\nasync function finish(f,{nav,indicator=true}={}){ const sb=f.findChild(n=>n.name==='Status Bar'); f.appendChild(sb); let fixed=1;\n if(nav){const tb=await inst('2007:269','Current='+nav); tb.name='Tab Bar'; place(f,tb,0,812-tb.height); fixed=2;}\n else if(indicator){const hi=await inst('6:122'); hi.fills=[]; hi.name='Home Indicator'; place(f,hi,0,778); fixed=2;}\n f.numberOfFixedChildren=fixed;}\nfunction content(f,y,gap=16){const c=Fr('Content',{dir:'VERTICAL',w:375,pad:[0,20],gap}); place(f,c,0,y); return c;}\nasync function header(f,title,props){const h=await inst('2008:172'); setP(h,Object.assign({Title:title},props)); h.name='Header'; place(f,h,0,44); return h;}\nconst txs=[['Aug 19, 2023','2:27','PayPal','Transferred','-$123.00'],['Jul 20, 2023','2:28','DANA','Transferred','-$12.00'],['May 08, 2023','2:29','Google Play','Refund','+$234.00']];\nasync function txList(parent){const list=Fr('Transaction list',{dir:'VERTICAL',pad:[0,16],r:20,fill:'surface/default',fx:'Elevation/Card'}); add(parent,list,{fillW:true});\n for