.layoutAlign = 'STRETCH';\nimgWrap.primaryAxisSizingMode='FIXED'; imgWrap.counterAxisSizingMode='FIXED';\nimgWrap.resize(650, 280);\nconst img = M.Photo_Cooking_Step.createInstance();\nimg.resize(650, 280);\nimgWrap.appendChild(img);\ncontent.appendChild(imgWrap);\nconst extra = figma.createText();\nextra.name = 'Body 2';\nextra.fontName = {family:'Inter', style:'Regular'};\nextra.fontSize = 16;\nextra.characters = 'Extra text.';\nextra.fills = [solid(BLACK, 0.6)];\nextra.lineHeight = {unit:'PERCENT', value:160};\nextra.textAutoResize='HEIGHT';\nextra.layoutAlign='STRETCH';\ncontent.appendChild(extra);\nimgWrap.visible = false;\nextra.visible = false;\nstep.resize(700, Math.round(step.height));\n\nconst test = step.createInstance();\nconst names = test.findAll(n => true).map(n => n.name + ':' + n.visible);\ntest.remove();\nreturn { found: names, masterKids: content.children.map(c=>c.name+':'+c.visible) };","description":"Rebuild Direction Step master with photo/extra appended after existing children"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"eb6a87e1-77d2-4750-aa78-08940da487c1","uuid":"10c36856-2bb5-4733-bff7-e8811119edc7","timestamp":"2026-11-01T20:18:40.141Z","tool_use_meta":[{"id":"mcp__figma__use_figma_61_873eec7d","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
