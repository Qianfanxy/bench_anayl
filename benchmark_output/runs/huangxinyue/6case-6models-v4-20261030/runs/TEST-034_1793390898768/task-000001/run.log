ig) {\n    const goBackBtn = figma.createFrame();\n    goBackBtn.name = \"Go back\";\n    goBackBtn.resize(80, 32);\n    goBackBtn.x = 24;\n    goBackBtn.y = 56;\n    goBackBtn.cornerRadius = 16;\n    goBackBtn.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n    \n    const backIcon = iconBackOrig.createInstance();\n    backIcon.x = 8;\n    backIcon.y = 4;\n    goBackBtn.appendChild(backIcon);\n\n    const backText = figma.createText();\n    backText.characters = \"Go back\";\n    backText.fontName = { family: \"Nunito\", style: \"SemiBold\" };\n    backText.fontSize = 12;\n    backText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n    backText.x = 28;\n    backText.y = 8;\n    goBackBtn.appendChild(backText);\n\n    frameProduct.appendChild(goBackBtn);\n  }\n\n  // Product Photo: Salad_Quinoa centered top\n  const saladQuinoaOrig = await getOrig(\"2:20\");\n  if (saladQuinoaOrig) {\n    const photo = saladQuinoaOrig.createInstance();\n    photo.x = (375 - photo.width) / 2;\n    photo.y = 110;\n    frameProduct.appendChild(photo);\n  }\n\n  // White Card Sheet bottom\n  const sheet = figma.createFrame();\n  sheet.name = \"Product Details Sheet\";\n  sheet.resize(375, 510);\n  sheet.x = 0;\n  sheet.y = 302;\n  sheet.cornerRadius = 32; // Top left/right rounded\n  sheet.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n\n  // Title: Quinoa Fruit Salad\n  const titleText = figma.createText();\n  titleText.characters = \"Quinoa Fruit Salad\";\n  titleText.fontName = { family: \"Nunito\", style: \"Bold\" };\n  titleText.fontSize = 24;\n  titleText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n  titleText.x = 24;\n  titleText.y = 32;\n  sheet.appendChild(titleText);\n\n  // Quantity stepper row: - 1 + and Price ₦10,000\n  const qtyRow = figma.createFrame();\n  qtyRow.name = \"Quantity & Price Row\";\n  qtyRow.resize(327, 40);\n  qtyRow.x = 24;\n  qtyRow.y = 76;\n  qtyRow.fills = [];\n\n  const iconMinusOrig = await getOrig(\"2:106\");\n  const iconPlusOrig = await getOrig(\"2:112\");\n\n  if (iconMinusOrig) {\n    const minus = iconMinusOrig.createInstance();\n    minus.x = 0;\n    minus.y = 4;\n    qtyRow.appendChild(minus);\n  }\n\n  const qtyText = figma.createText();\n  qtyText.characters = \"1\";\n  qtyText.fontName = { family: \"Nunito\", style: \"Bold\" };\n  qtyText.fontSize = 18;\n  qtyText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n  qtyText.x = 44;\n  qtyText.y = 6;\n  qtyRow.appendChild(qtyText);\n\n  if (iconPlusOrig) {\n    const plus = iconPlusOrig.createInstance();\n    plus.x = 68;\n    plus.y = 4;\n    qtyRow.appendChild(plus);\n  }\n\n  // Price on the right\n  const nairaOrig = await getOrig(\"2:83\");\n  if (nairaOrig) {\n    const naira = nairaOrig.createInstance();\n    naira.x = 220;\n    naira.y = 8;\n    qtyRow.appendChild(naira);\n  }\n\n  const priceText = figma.createText();\n  priceText.characters = \"10,000\";\n  priceText.fontName = { family: \"Nunito\", style: \"Bold\" };\n  priceText.fontSize = 20;\n  priceText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n  priceText.x = 240;\n  priceText.y = 6;\n  qtyRow.appendChild(priceText);\n\n  sheet.appendChild(qtyRow);\n\n  // Divider line\n  const line = figma.createRectangle();\n  line.resize(327, 1);\n  line.x = 24;\n  line.y = 132;\n  line.fills = [{ type: 'SOLID', color: { r: 0.9, g: 0.9, b: 0.9 } }];\n  sheet.appendChild(line);\n\n  // Section: One Pack Contains:\n  const packTitle = figma.createText();\n  packTitle.characters = \"One Pack Contains:\";\n  packTitle.fontName = { family: \"Nunito\", style: \"Bold\" };\n  packTitle.fontSize = 16;\n  packTitle.fills = [{ type: 'SOLID', color: brandDarkColor }];\n  packTitle.x = 24;\n  packTitle.y = 148;\n  sheet.appendChild(packTitle);\n\n  // Line indicator under packTitle\n  const packLine = figma.createRectangle();\n  packLine.resize(130, 2);\n  packLine.x = 24;\n  packLine.y = 172;\n  packLine.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n  sheet.appendChild(packLine);\n\n  // Contents copy: Red Quinoa, Lime, Honey, Blueberries, Strawberries, Mango, Fresh mint.\n  const contentsText = figma.createText();\n  contentsText.characters = \"Red Quinoa, Lime, Honey, Blueberries, Strawberries, Mango, Fresh mint.\";\n  contentsText.fontName = { family: \"Nunito\", style: \"Regular\" };\n  contentsText.fontSize = 14;\n  contentsText.fills = [{ type: 'SOLID', color: { r: 0.2, g: 0.2, b: 0.2 } }];\n  contentsText.resize(327, 40);\n  contentsText.x = 24;\n  contentsText.y = 186;\n  sheet.appendChild(contentsText);\n\n  // Divider line 2\n  const line2 = figma.createRectangle();\n  line2.resize(327, 1);\n  line2.x = 24;\n  line2.y = 240;\n  line2.fills = [{ type: 'SOLID', color: { r: 0.9, g: 0.9, b: 0.9 } }];\n  sheet.appendChild(line2);\n\n  // Description copy: If you are looking for a new fruit salad to eat today, quinoa is the perfect brunch for you.\n  const descText = figma.createText();\n  descText.characters = \"If you are looking for a new fruit salad to eat today, quinoa is the perfect brunch for you.\";\n  descText.fontName = { family: \"Nunito\", style: \"Regular\" };\n  descText.fontSize = 14;\n  descText.fills = [{ type: 'SOLID', color: { r: 0.35, g: 0.35, b: 0.35 } }];\n  descText.resize(327, 44);\n  descText.x = 24;\n  descText.y = 256;\n  sheet.appendChild(descText);\n\n  // Bottom action bar: Favourite toggle + Add to basket button\n  const bottomBar = figma.createFrame();\n  bottomBar.name = \"Bottom Action Bar\";\n  bottomBar.resize(327, 56);\n  bottomBar.x = 24;\n  bottomBar.y = 330;\n  bottomBar.fills = [];\n\n  const favBtnOrig = await getOrig(\"2:100\");\n  if (favBtnOrig) {\n    const favBtn = favBtnOrig.createInstance();\n    favBtn.x = 0;\n    favBtn.y = 4;\n    bottomBar.appendChild(favBtn);\n  }\n\n  const buttonOrig = await getOrig(\"3:25\");\n  if (buttonOrig) {\n    const addBtn = buttonOrig.createInstance();\n    addBtn.resize(250, 56);\n    addBtn.x = 77;\n    addBtn.y = 0;\n    const btnText = addBtn.findOne(n => n.type === \"TEXT\");\n    if (btnText) {\n      btnText.characters = \"Add to basket\";\n    }\n    bottomBar.appendChild(addBtn);\n  }\n\n  sheet.appendChild(bottomBar);\n  frameProduct.appendChild(sheet);\n\n  return \"Frame 05_Product_Quinoa built successfully\";\n})()","description":"Build 05_Product_Quinoa frame on 03 · Workspace","fileKey":"jiYwYdVVeh1sSSwCPVx5uG"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":30815,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":28329},"context_management":null},"parent_tool_use_id":null,"session_id":"cda7a16c-453d-4dc3-870a-25e4b7be3132","uuid":"51329577-9ae9-4289-84e2-998e8f6617a8","timestamp":"2026-10-30T20:12:16.023Z","tool_use_meta":[{"id":"call_077d464d75d34b7983881d3a2eaa2cae","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
