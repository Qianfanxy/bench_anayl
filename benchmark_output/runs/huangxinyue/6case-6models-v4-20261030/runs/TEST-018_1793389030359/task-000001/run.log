;i.x=x;i.y=y;return i;}\nfunction comp(name,x,y,w,h,o={}){const c=figma.createComponent();c.name=name;c.resize(w,h);c.x=x;c.y=y;c.fills=o.fill?fl(o.fill):[];c.cornerRadius=o.r||0;c.clipsContent=true;ws.appendChild(c);return c;}\n\n// ---- new compact product card component ----\nconst compact=comp('Product Card / Compact',2560,1060,173,200,{fill:C.white});\nconst ct=fr(compact,'Image Tile',0,0,173,104,{fill:'#F7F8F7',r:16});\nconst cim=rect(compact,'Image',6,4,161,96,{});\ntxt(compact,'Name','Apple & Grape Juice',{size:15,style:'SemiBold',w:173,h:40,y:112});\ntxt(compact,'Unit','2L, Price',{size:12,color:C.gray,w:120,h:18,y:156});\ntxt(compact,'Price','$15.99',{size:16,style:'SemiBold',w:120,h:22,y:174});\nrect(compact,'Add',143,168,28,28,{fill:C.green,r:9});\nrect(compact,'Add-H',149,180,12,2,{fill:C.white,r:1});\nrect(compact,'Add-V',154,175,2,12,{fill:C.white,r:1});\n\nasync function prodCard(parent,id,x,y,name,unit,price,img,mode){\n  const i=await inst(id,parent,x,y);\n  const ir=i.findOne(n=>n.name==='Image');if(ir)ir.fills=[{type:'IMAGE',imageHash:img,scaleMode:mode||'FIT'}];\n  i.findOne(n=>n.name==='Name').characters=name;\n  i.findOne(n=>n.name==='Unit').characters=unit;\n  i.findOne(n=>n.name==='Price').characters=price;\n  return i;\n}\n\n// ---- fix onboarding text x ----\nconst O=await figma.getNodeByIdAsync('9:3');\n['Welcome','Welcome 2','Sub'].forEach(n=>{const t=O.findOne(m=>m.name===n);if(t)t.x=24;});\n\n// ================= 06 Product Detail =================\nconst D=await figma.getNodeByIdAsync('9:7');[...D.children].forEach(c=>c.remove());D.fills=fl(C.white);\nawait inst('6:43',D,0,0);\nawait inst('10:33',D,0,44);\nrect(D,'Product Image',0,140,414,210,{img:'fcd8fb327405d53c3fc305658bf933818e7e25b8',mode:'FIT'});\ntxt(D,'Name','Natural Red Apple',{size:24,style:'SemiBold',w:300,h:32,y:360});\ntxt(D,'Unit','1kg, Price',{size:14,color:C.gray,w:200,h:20,y:396});\nawait inst('10:45',D,24,430);\ntxt(D,'Price','$4.99',{size:24,style:'SemiBold',w:90,h