dChild(e);e.x=x;e.y=y;e.resize(d,d);e.fills=[solid(fill)];return e;}\nfunction rect(p,x,y,w,h,fill,r){const e=figma.createRectangle();p.appendChild(e);e.x=x;e.y=y;e.resize(w,h);e.cornerRadius=r||0;e.fills=[solid(fill)];return e;}\nconst sec=ws.children.find(n=>n.type==='SECTION'&&n.name.startsWith('Design System'));\nconst by=n=>sec.children.find(c=>c.name===n);\nconst TAB_AN=by('Tab Bar / Analytics').id;\n\n// fix 03 axis labels overlapping bars\nconst s3=ws.children.find(n=>n.name==='03_Home_My_Balance');\nfor(const n of [...s3.findAll(t=>t.type==='TEXT'&&(t.characters==='50K'||t.characters==='10K'))]) n.remove();\n\n// ================= 09_Analytics =================\nconst s9=frame(ws,'09_Analytics',3512,0,375,812,C.bg);\ninst(s9,'6:110',0,0);inst(s9,'6:122',0,778);\nconst h9=frame(s9,'header',0,44,375,56,C.bg);\nconst b9=frame(h9,'back',16,8,40,40,C.white,13);inst(b9,'2:8',10,10,20);\ntxt(h9,'Analytics',72,12,{size:17,weight:'SemiBold'});\ninst(h9,'2:65',271,8,40);\nconst m9=frame(h9,'more',319,12,32,32,C.white,16);recolor(inst(m9,'2:18',7,14,18),C.ink);\n// totals card\nconst tot=frame(s9,'totals',20,112,335,88,C.white,20);\ntxt(tot,'Total income',16,16,{size:10,color:C.muted});\ntxt(tot,'$29,231.03',16,34,{size:22,weight:'SemiBold'});\nrect(tot,180,16,1,56,C.line);\ntxt(tot,'Total expenses',196,16,{size:10,color:C.muted});\ntxt(tot,'$1,999.00',196,34,{size:18,weight:'SemiBold',color:C.ink2});\n// period + switch\nconst per=frame(s9,'period Monthly',20,216,116,34,C.white,12);\ntxt(per,'Monthly',14,8,{size:11,weight:'SemiBold'});\nrecolor(inst(per,'2:17',92,11,12),C.muted);\nconst sw=frame(s9,'income/expenses',152,216,203,34,C.chip,12);\n[['Income',true],['Expenses',false]].forEach(([t,a],i)=>{\n  const sg=frame(sw,t,i*100,0,100,34,a?C.white:null,a?10:0);\n  txt(sg,t,0,8,{size:11,weight:a?'SemiBold':'Medium',color:a?C.ink:C.muted,w:100,align:'CENTER'});\n});\n// donut card\nconst dn=frame(s9,'breakdown',20,264,335,296,C.white,20);\ntxt(dn,'Income breakdown',16,16,{size:14,weight:'SemiBold'});\ntxt(dn,'Monthly · 2023',16,36,{size:10,color:C.muted});\nconst cx0=167.5, cy0=158, R=72, TH=22;\nconst segs=[[0,52,C.deep],[52,91,C.primary],[91,100,'#E4E0FB']];\nlet acc=0;\nsegs.forEach(([s,e,col])=>{\n  const ring=figma.createEllipse();dn.appendChild(ring);\n  ring.x=cx0-R;ring.y=cy0-R;ring.resize(R*2,R*2);\n  ring.fills=[];ring.strokes=[{...solid(col)}];ring.strokeWeight=TH;\n  ring.arcData={startingAngle:(-90+s*3.6)*Math.PI/180, endingAngle:(-90+e*3.6)*Math.PI/180, innerRadius:0.69};\n});\ntxt(dn,'52%',0,136,{size:30,weight:'SemiBold',w:335,align:'CENTER'});\ntxt(dn,'Sales',0,176,{size:10,color:C.muted,w:335,align:'CENTER'});\n// legend rows\nconst rows=[['Sales','$15,190.00','52%',C.deep],['Investment','$11,451.03','39%',C.primary],['Other','$2,590.00','9%','#E4E0FB']];\nrows.forEach(([n,v,p,col],i)=>{\n  const y=246+i*34;\n  const dot=circle(dn,16,y+8,10,col);\n  txt(dn,n,34,y+2,{size:11,weight:'Medium'});\n  txt(dn,v,0,y+2,{size:11,weight:'SemiBold',w:239,align:'RIGHT'});\n  txt(dn,p,0,y+2,{size:10,color:C.muted,w:303,align:'RIGHT'});\n});\ntxt(dn,'Share of income',16,222,{size:9,weight:'SemiBold',color:C.muted,spacing:0.6});\ninst(s9,TAB_AN,0,724);\n\n// ================= 10_Markets =================\nconst s10=frame(ws,'10_Markets',3951,0,375,812,C.bg);\ninst(s10,'6:110',0,0);inst(s10,'6:122',0,778);\nconst h10=frame(s10,'header',0,44,375,56,C.bg);\nconst b10=frame(h10,'back',16,8,40,40,C.white,13);inst(b10,'2:8',10,10,20);\ntxt(h10,'Markets',72,12,{size:17,weight:'SemiBold'});\ninst(h10,'2:65',311,8,40);\n// coin selector\nconst coin=frame(s10,'coin',20,110,180,44,C.white,14);\nconst cf=frame(coin,'ico',6,6,32,32,C.bg,16);inst(cf,'2:34',4,4,24);\ntxt(coin,'Bitcoin',46,8,{size:13,weight:'SemiBold'});\ntxt(coin,'BTC',46,26,{size:9,color:C.muted});\nconst csel=frame(s10,'change coin',208,110,80,44,C.white,14);\nrecolor(inst(csel,'2:17',14,16,12),C.ink);txt(csel,'Change',32,14,{size:10,weight:'SemiBold'});\n// price\ntxt(s10,'Current price',20,172,{size:11,color:C.muted});\ntxt(s10,'$1,954.00',20,190,{size:30,weight:'SemiBold',lh:38});\nconst pc=frame(s10,'change',180,198,74,26,'#E4F5EE',13);\ntxt(pc,'+3.85%',0,5,{size:11,weight:'SemiBold',color:C.success,w:74,align:'CENTER'});\n// chart\nconst ch=frame(s10,'price chart',20,244,335,238,C.white,20);\nconst plotX=44,plotY=24,plotW=275,plotH=160;\nconst yV=[1000,2000,3000,4000,5000];\nyV.forEach(v=>{\n  const gy=plotY+plotH-((v-1000)/4000)*plotH;\n  rect(ch,plotX,gy,plotW,1,C.line);\n  txt(ch,(v/1000)+'K',4,gy-6,{size:8,color:C.muted});\n});\n// candlesticks\nconst candles=[\n  [1200,1600,1100,1500],[1500,1900,1400,1750],[1750,2100,1650,2050],[2050,1900,1800,1950],\n  [1950,2500,1900,2400],[2400,2900,2300,2800],[2800,2600,2500,2650],[2650,3200,2600,3150],\n  [3150,3700,3050,3600],[3600,3400,3300,3450],[3450,4200,3400,4100],[4100,3900,3800,3950],\n  [3950,4600,3850,4500],[4500,4300,4200,4350],[4350,4800,4300,4750],\n];\ncandles.forEach(([o,h,l,c],i)=>{\n  const x=plotX+6+i*18;\n  const y=h=>plotY+plotH-((h-1000)/4000)*plotH;\n  const up=c>=o;\n  const col=up?C.success:C.error;\n  const wick=figma.createRectangle();ch.appendChild(wick);wick.x=x+4;wick.y=y(h);wick.resize(2,Math.max(2,y(l)-y(h)));wick.fills=[solid(col)];\n  const body=figma.createRectangle();ch.appendChild(body);body.x=x;body.y=y(Math.max(o,c));body.resize(10,Math.max(3,Math.abs(y(o)-y(c))));body.cornerRadius=2;body.fills=[solid(col)];\n});\n[['08:00',0],['12:00',0.35],['18:00',0.7],['24:00',1]].forEach(([t,f])=>{\n  txt(ch,t,plotX+f*plotW-14,plotY+plotH+8,{size:8,color:C.muted,w:34,align:'CENTER'});\n});\ntxt(ch,'24h',288,8,{size:9,color:C.muted,w:32,align:'RIGHT'});\n// ranges\nconst ranges=['1H','2H','8H','1D','1W','1M','1Y'];\nranges.forEach((r,i)=>{\n  const a=r==='1D';\n  const y=496, x=20+i*48;\n  const rf=frame(s10,'range '+r,x,y,42,30,a?C.ink:C.white,11);\n  txt(rf,r,0,7,{size:10,weight:a?'SemiBold':'Medium',color:a?C.white:C.ink2,w:42,align:'CENTER'});\n});\n// actions\nconst sell=frame(s10,'Sell',20,540,162,48,C.white,16);\nsell.strokes=[{...solid(C.deep)}];sell.strokeWeight=1.5;sell.strokeAlign='INSIDE';\ntxt(sell,'Sell',0,14,{size:13,weight:'SemiBold',color:C.deep,w:162,align:'CENTER'});\nconst buy=frame(s10,'Buy',193,540,162,48,C.deep,16);\ntxt(buy,'Buy',0,14,{size:13,weight:'SemiBold',color:C.white,w:162,align:'CENTER'});\n// history\ntxt(s10,'History',20,612,{size:14,weight:'SemiBold'});\ntxt(s10,'See all',0,614,{size:11,weight:'SemiBold',color:C.deep,w:335,align:'RIGHT'});\nconst hist=[['2:33','Solana','SOL','$12,094.08'],['2:34','Bitcoin','BTC','$17,238.11'],['2:35','Ethereum','ETH','$8,200.00']];\nhist.forEach(([ic,n,t,v],i)=>{\n  const y=638+i*44;\n  const r=frame(s10,'history '+n,20,y,335,44,null);\n  const il=frame(r,'ico',0,4,36,36,C.white,18);inst(il,ic,6,6,24);\n  txt(r,n,46,5,{size:12,weight:'SemiBold'});\n  txt(r,t,46,23,{size:9.5,color:C.muted});\n  txt(r,v,215,13,{size:12,weight:'SemiBold',w:120,align:'RIGHT'});\n});\n\n// ================= 11_Send =================\nconst s11=frame(ws,'11_Send',4390,0,375,812,C.white);\ninst(s11,'6:110',0,0);inst(s11,'6:122',0,778);\nconst h11=frame(s11,'header',0,44,375,56,C.white);\nconst b11=frame(h11,'back',16,8,40,40,C.bg,13);inst(b11,'2:8',10,10,20);\ntxt(h11,'Send',72,12,{size:17,weight:'SemiBold'});\ninst(h11,'2:65',311,8,40);\n// recipient\nconst rc=frame(s11,'recipient',20,116,335,76,C.bg,18);\nconst ra=frame(rc,'avatar',14,14,48,48,'#E9E7F3',24);\ninst(ra,'2:65',0,0,48);\ntxt(rc,'Bessie Cooper',76,18,{size:13,weight:'SemiBold'});\ntxt(rc,'**** **** **** 8820',76,38,{size:10,color:C.muted});\nconst chg2=frame(rc,'change recipient',245,14,76,26,C.white,13);\ntxt(chg2,'Change',0,4,{size:10,weight:'SemiBold',color:C.deep,w:76,align:'CENTER'});\ntxt(s11,'Sending to',20,104,{size:10,color:C.muted});\n// amount\ntxt(s11,'AMOUNT',20,222,{size:10,weight:'SemiBold',color:C.muted,spacing:0.8});\ntxt(s11,'$500.00',20,246,{size:40,weight:'SemiBold',lh:50});\ntxt(s11,'Available $190,008.03',20,300,{size:10,color:C.muted});\n// keypad 0..: 4 rows x 3\nconst kp=frame(s11,'keypad',0,352,375,300,null);\nconst keys=['1','2','3','4','5','6','7','8','9','.','0','⌫'];\nkeys.forEach((k,i)=>{\n  const row=Math.floor(i/3), col=i%3;\n  const key=frame(kp,'key '+k,col*125,row*66,125,66,null);\n  if(i===11){const del=inst(key,'2:12',50,20,26);recolor(del,C.ink);}\n  else txt(key,k,0,10,{size:24,weight:'Medium',w:125,align:'CENTER'});\n});\nconst sendBtn=frame(s11,'Send button',20,672,335,56,C.primary,18);\ntxt(sendBtn,'Send',0,16,{size:16,weight:'SemiBold',color:C.ink,w:335,align:'CENTER'});\ninst(s11,'6:122',0,778);\nreturn {s9:s9.id,s10:s10.id,s11:s11.id};","description":"Build 09_Analytics, 10_Markets, 11_Send and remove overlapping axis labels on 03","fileKey":"JdUlxW8keR6mprUHy9Kv6J"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":9382,"input_tokens":55,"cache_read_input_tokens":63912,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":9382}},"context_management":null},"parent_tool_use_id":null,"session_id":"61aa1638-029c-43a0-97ea-2af852f8e61e","uuid":"5df7bc4f-178c-4887-b4bd-4720ada08b64","timestamp":"2026-10-28T18:33:31.494Z","tool_use_meta":[{"id":"toolu_01XDERbtgXlY0s1GOjtRHbSe","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
