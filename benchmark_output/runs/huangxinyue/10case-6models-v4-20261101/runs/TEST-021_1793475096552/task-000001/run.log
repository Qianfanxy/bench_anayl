); put(sheet, amountPill, 93, 300);\nconst dai = await inst('6:24','DAI'); dai.rescale(20/20); put(amountPill, dai, 16, 10);\nput(amountPill, txt('3,021.00 DAI', 14, 'B', 'Ink/900', 140, {lh:18}), 44, 11).name='Amount';\n\nconst footer = frame('Sheet Footer', 375, 96, 'Surface/White');\nput(sheet, footer, 0, 374);\nfooter.strokes = paint('Border/Subtle'); footer.strokeWeight=1; footer.strokeAlign='INSIDE';\nconst btnSrc = await figma.getNodeByIdAsync('7:45');\nconst viewBtn = btnSrc.createInstance(); viewBtn.name='View Pocket';\ntry { viewBtn.resize(327, 52); } catch(e) {}\nput(footer, viewBtn, 24, 22);\nconst vl = viewBtn.findOne(n=>n.type==='TEXT'); if (vl) vl.characters = 'View Pocket';\n\nreturn JSON.stringify({ id: root.id });","description":"Build 05_Invest_Success: dimmed Discovery with a centred success sheet, confetti, celebration emoji, confirmation copy, amount pill and View Pocket button","fileKey":"DahEt2glvB09pBFT66GiDO"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":9107,"input_tokens":55,"cache_read_input_tokens":116533,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":9107}},"context_management":null},"parent_tool_use_id":null,"session_id":"7fa41065-9ea8-4467-818a-aa7f032bdf86","uuid":"63fae8a6-09b1-4720-837c-4998f854172e","timestamp":"2026-10-31T19:49:48.577Z","tool_use_meta":[{"id":"toolu_01zfl4E9L3Yn99aN2aC1qaod","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
