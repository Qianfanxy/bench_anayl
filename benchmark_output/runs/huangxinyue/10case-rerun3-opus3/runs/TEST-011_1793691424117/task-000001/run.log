rRadius=20; c.effects=shadow(0.06,6,20);\n  c.appendChild(await photo('5:4',64,64,14));\n  const tb=F('Text',null); AL(tb,'VERTICAL',{gap:8}); c.appendChild(tb); tb.layoutSizingHorizontal='FILL';\n  tb.appendChild(T('Belly fat burner',16,'Black',C.dark,{name:'Title'}));\n  const r=F('Row',null); AL(r,'HORIZONTAL',{gap:10,align:'CENTER'}); tb.appendChild(r); r.appendChild(await meta()); r.appendChild(tagInst('Beginner'));\n  const go=F('Go',C.surface,{r:16,w:32,h:32}); const ch=await icon('Chevron',C.dark,18); go.appendChild(ch); ch.x=7; ch.y=7; c.appendChild(go); vs.push(c);}\n const set=figma.combineAsVariants(vs,lib); set.name='Program Card'; AL(set,'HORIZONTAL',{gap:24,pad:[16,16,16,16],align:'MIN'}); set.fills=solid(C.bg);\n bindSet(set,'Title','Title','Belly fat burner'); bindSet(set,'Minutes','Minutes','10 min'); bindSwap(set,'5:4'); out.program=set.id;}\n\n// Challenge Card set\n{const vs=[]; const tone={Lime:[C.lime,C.dark,C.dark,C.lime],Dark:[C.dark,C.white,C.lime,C.dark],Soft:[C.purpleTint,C.dark,C.purple,C.white]};\n for(const k of Object.keys(tone)){const [bg,tc,ic,icb]=tone[k]; const c=comp('Tone='+k); AL(c,'VERTICAL',{gap:12,pad:[14,14,14,14],justify:'SPACE_BETWEEN',w:109,h:116,pa:'FIXED',ca:'FIXED'}); c.fills=solid(bg); c.cornerRadius=20;\n  const b=F('Badge',icb,{r:16,w:32,h:32,op:k==='Lime'?1:1}); const i=await icon('Fire',ic,18); b.appendChild(i); i.x=7; i.y=7; if(k==='Lime'){b.fills=solid(C.dark);} c.appendChild(b);\n  const t=T('Plank Challenge',15,'Black',tc,{name:'Title',w:81,lh:19}); c.appendChild(t); t.layoutSizingHorizontal='FILL'; vs.push(c);}\n const set=figma.combineAsVariants(vs,lib); set.name='Challenge Card'; AL(set,'HORIZONTAL',{gap:16,pad:[16,16,16,16]}); bindSet(set,'Title','Title','Plank Challenge'); out.challenge=set.id;}\n\n// Promo Banner\n{const c=comp('Promo Banner'); c.resize(350,168); c.cornerRadius=24; c.clipsContent=true; c.fills=solid(C.dark);\n const p=await photo('5:17',350,168); c.appendChild(p);\n const ov=figma.createRectangle(); ov.name='Scrim'; ov.resize(350,168); ov.fills=grad(H,[[0,0.95],[0.75,0.1]]); c.appendChild(ov);\n const t=T('Best Quarantine Workout',22,'Black',C.white,{w:180,lh:27,name:'Title'}); c.appendChild(t); t.x=20; t.y=24;\n const sm=F('See more',null); AL(sm,'HORIZONTAL',{gap:2,align:'CENTER',pad:[6,8,6,12]}); sm.fills=solid(C.lime); sm.cornerRadius=100; sm.appendChild(T('See more',13,'Black',C.dark,{name:'Label'})); sm.appendChild(await icon('Chevron',C.dark,18)); c.appendChild(sm); sm.x=20; sm.y=168-20-sm.height;\n lib.appendChild(c); out.banner=c.id;}\n\n// Round Row set\n{const vs=[];\n for(const s of ['Default','Playing']){const on=s==='Playing'; const c=comp('State='+s); AL(c,'HORIZONTAL',{gap:14,pad:[12,14,12,12],align:'CENTER',w:350,pa:'FIXED',ca:'AUTO'}); c.fills=solid(on?C.dark:C.white); c.cornerRadius=20; if(!on) c.strokes=solid(C.border); else c.effects=shadow(0.18,8,20);\n  c.appendChild(await photo('5:6',56,56,14));\n  const tb=F('Text',null); AL(tb,'VERTICAL',{gap:4}); c.appendChild(tb); tb.layoutSizingHorizontal='FILL';\n  if(on) tb.appendChild(T('NOW PLAYING',10,'Black',C.lime,{name:'Status'}));\n  tb.appendChild(T('Jumping Jacks',16,'Black',on?C.white:C.dark,{name:'Name'}));\n  const tm=F('Time row',null); AL(tm,'HORIZONTAL',{gap:4,align:'CENTER'}); tm.appendChild(await icon('Timer',on?C.lime:C.muted,14)); tm.appendChild(T('00:30',13,on?'Bold':'Regular',on?C.lime:C.muted,{name:'Time'})); tb.appendChild(tm);\n  const pb=circleBtn(40,on?C.lime:C.surface); const pi=await icon('Play',C.dark,20); pb.appendChild(pi); pi.x=11; pi.y=10; c.appendChild(pb); vs.push(c);}\n const set=figma.combineAsVariants(vs,lib); set.name='Round Row'; AL(set,'VERTICAL',{gap:16,pad:[16,16,16,16]}); set.fills=solid(C.bg);\n bindSet(set,'Name','Name','Jumping Jacks'); bindSet(set,'Time','Time','00:30'); bindSwap(set,'5:6'); out.round=set.id;}\n\n// Stat Chip\n{const c=comp('Stat Chip'); AL(c,'HORIZONTAL',{gap:12,pad:[12,12,12,12],align:'CENTER',w:169,pa:'FIXED',ca:'AUT