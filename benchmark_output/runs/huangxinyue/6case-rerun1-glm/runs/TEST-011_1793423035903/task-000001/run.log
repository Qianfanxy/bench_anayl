gma.getNodeById(compId).createInstance();\n  const s = targetW / inst.width;\n  inst.rescale(s);\n  if (hex) recolor(inst, hex);\n  inst.x = x; inst.y = y;\n  parent.appendChild(inst);\n  return inst;\n}\nfunction placeMedia(compId, parent, x, y, w, h) {\n  const inst = figma.getNodeById(compId).createInstance();\n  inst.resize(w, h);\n  inst.x = x; inst.y = y;\n  parent.appendChild(inst);\n  return inst;\n}\nconst shadow = { type:\"DROP_SHADOW\", color:{r:0.15,g:0.13,b:0.30,a:0.10}, offset:{x:0,y:10}, radius:30, spread:0, visible:true, blendMode:\"NORMAL\" };\n\n// ---------- Design system section ----------\nconst sec = frame(\"FH · Design System\", 40, 40, 2330, 620, \"F7F6FA\", 24);\nmkText(sec, 32, 28, \"Fruit Hub — Design System (brand #FFA451 · Nunito)\", 18, \"Bold\", C.INK);\nmkText(sec, 32, 58, \"Masters below. Screens 01–05 in row 1 (y 700), screens 06–10 in row 2 (y 1650).\", 12, \"Regular\", C.MUTED);\n\n// ---------- Base components cloned from 02 · Components ----------\nconst btn = figma.getNodeById(\"3:25\").clone(); sec.appendChild(btn); btn.x = 32; btn.y = 120; btn.name = \"FH / Button · Primary\";\nconst btnSec = figma.getNodeById(\"3:25\").clone(); sec.appendChild(btnSec); btnSec.x = 392; btnSec.y = 120; btnSec.name = \"FH / Button · Secondary\";\nbtnSec.fills = [solid(C.WHITE)]; btnSec.strokes = [solid(C.PRIMARY)]; btnSec.strokeWeight = 1.5;\nrecolor(btnSec.children[0], C.PRIMARY);\nconst tf = figma.getNodeById(\"3:28\").clone(); sec.appendChild(tf); tf.x = 752; tf.y = 120; tf.name = \"FH / Text Field\";\n\n// Filled field (label + value)\nconst ff = frame(\"FH / Field · Filled\", 1112, 120, 327, 60, C.SOFT, 10);\nsec.appendChild(ff);\nmkText(ff, 16, 9, \"Label\", 11, \"Regular\", C.MUTED);\nmkText(ff, 16, 26, \"Value\", 14, \"SemiBold\", C.INK);\n\n// Status bars / home indicators\nconst sb = figma.getNodeById(\"3:32\").clone(); sec.appendChild(sb); sb.x = 1472; sb.y = 120; sb.name = \"FH / Status Bar\";\nconst sbL = figma.getNodeById(\"3:32\").clone(); sec.appendChild(sbL); sbL.x = 1472; sbL.y = 200; sbL.name = \"FH / Status Bar · Light\";\nsbL.fills = []; recolor(sbL, \"FFFFFF\");\nconst hi = figma.getNodeById(\"3:42\").clone(); sec.appendChild(hi); hi.x = 1872; hi.y = 120; hi.name = \"FH / Home Indicator\";\nconst hiL = figma.getNodeById(\"3:42\").clone(); sec.appendChild(hiL); hiL.x = 1872; hi.y = 200; hiL.name = \"FH / Home Indicator · Light\";\nhiL.fills = []; recolor(hiL, \"FFFFFF\");\nhiL.y = 200;\n\n// ---------- Small shared components ----------\n// Favourite button\nconst fav = frame(\"FH / Fav Button\", 32, 260, 24, 24, C.WHITE, 12);\nfav.effects = [shadow];\nplaceIcon(\"2:78\", fav, 6, 6.5, 12, C.MUTED);\n// Add button\nconst add = frame(\"FH / Add Button\", 72, 260, 22, 22, C.PRIMARY, 11);\nplaceIcon(\"2:89\", add, 5, 5, 12, C.WHITE);\n// Header back button\nconst hb = frame(\"FH / Header · Back\", 112, 260, 40, 40, C.WHITE, 20);\nhb.effects = [shadow];\nplaceIcon(\"2:117\", hb, 17, 13, 7, C.INK);\n// Close button\nconst cb = frame(\"FH / Header · Close\", 168, 260, 32, 32, \"F1EFF4\", 16);\nplaceIcon(\"2:123\", cb, 8, 8, 16, C.INK);\n// Category chip\nconst chip = figma.createFrame();\nchip.name = \"FH / Chip · Category\";\nchip.layoutMode = \"HORIZONTAL\"; chip.primaryAxisSizingMode = \"AUTO\"; chip.counterAxisSizingMode = \"AUTO\";\nchip.paddingLeft = 16; chip.paddingRight = 16; chip.paddingTop = 8; chip.paddingBottom = 8;\nchip.cornerRadius = 8; chip.fills = [solid(C.SOFT)];\nconst chipT = figma.createText(); chipT.fontName = {family:\"Nunito\", style:\"SemiBold\"}; chipT.characters = \"Category\"; chipT.fontSize = 13; chipT.fills = [solid(C.MUTED)];\nchip.appendChild(chipT);\nsec.appendChild(chip); chip.x = 232; chip.y = 260;\n// Ingredient chip\nconst ichip = figma.createFrame();\nichip.name = \"FH / Chip · Ingredient\";\nichip.layoutMode = \"HORIZONTAL\"; ichip.primaryAxisSizingMode = \"AUTO\"; ichip.counterAxisSizingMode = \"AUTO\";\nichip.paddingLeft = 12; ichip.paddingRight = 12; ichip.paddingTop = 7; ichip.paddingBottom = 7;\nichip.cornerRadius = 8; ichip.fills = [solid(C.TINT)];\nconst ichipT = figma.createText(); ichipT.fontName = {family:\"Nunito\", style:\"SemiBold\"}; ichipT.characters = \"Ingredient\"; ichipT.fontSize = 12; ichipT.fills = [solid(C.INK)];\nichip.appendChild(ichipT);\nsec.appendChild(ichip); ichip.x = 360; ichip.y = 260;\n// Stepper\nconst st = frame(\"FH / Stepper\", 32, 340, 168, 44, null);\nconst stMinus = frame(\"minus\", 0, 2, 40, 40, C.TINT, 12); st.appendChild(stMinus);\nplaceIcon(\"2:106\", stMinus, 10, 10, 20, C.PRIMARY);\nmkText(st, 60, 13, \"1 pack\", 14, \"SemiBold\", C.INK, {w:48, align:\"CENTER\"});\nconst stPlus = frame(\"plus\", 128, 2, 40, 40, C.PRIMARY, 12); st.appendChild(stPlus);\nplaceIcon(\"2:112\", stPlus, 10, 10, 20, C.WHITE);\n\nconst ids = { sec: sec.id, btn: btn.id, btnSec: btnSec.id, tf: tf.id, ff: ff.id, sb: sb.id, sbL: sbL.id, hi: hi.id, hiL: hiL.id,\n  fav: fav.id, add: add.id, hb: hb.id, cb: cb.id, chip: chip.id, ichip: ichip.id, st: st.id };\nreturn JSON.stringify(ids);\n","description":"Set up workspace design system: clone base components and create shared components","fileKey":"l8MdQcWVFQcJw2Ix8PJk7h"}}],"id":"20911543-90ba-480f-b3e4-f64fb470f858","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"2dda6b51-cf28-47fc-8f32-0dff4e440494","uuid":"a43a9075-7596-44ec-8273-bfce6d7af2d2","timestamp":"2026-10-31T05:13:28.075Z","tool_use_meta":[{"id":"call_33c23e9d62b442afb7e89ef2","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
