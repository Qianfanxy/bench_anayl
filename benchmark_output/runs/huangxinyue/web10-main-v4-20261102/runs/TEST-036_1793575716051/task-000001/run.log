ion recolor(node,h){const s=solid(h);const walk=n=>{if('fills' in n&&Array.isArray(n.fills)&&n.fills.length&&n.fills[0].type==='SOLID'&&n.fills[0].visible!==false)n.fills=[s];if('strokes' in n&&Array.isArray(n.strokes)&&n.strokes.length&&n.strokes[0].type==='SOLID'&&n.strokes[0].visible!==false)n.strokes=[s];if('children' in n)n.children.forEach(walk);};walk(node);}\nfunction mkIcon(key,size,color){const i=comps[key].createInstance();if(size&&size!==24)i.resize(size,size);if(color)recolor(i,color);return i;}\nfunction avat(key,size){const i=comps['av_'+key].createInstance();i.resize(size,size);i.cornerRadius=size/2;return i;}\nfunction card(parent,x,y,w,h){const f=frame(w,h,'FFFFFF',{r:16,stroke:'E8E9F0'});f.x=x;f.y=y;f.effects=[{type:'DROP_SHADOW',color:{r:0.08,g:0.08,b:0.17,a:0.04},offset:{x:0,y:8},radius:24,spread:0,visible:true,blendMode:'NORMAL'}];parent.appendChild(f);return f;}\nfunction setBubble(inst,chars){const t=inst.findOne(n=>n.type==='TEXT');t.characters=chars;return inst;}\nconst scr=await figma.getNodeByIdAsync('10:7');\nscr.children.slice().forEach(c=>c.remove());\nconst rail=(await figma.getNodeByIdAsync('18:153')).createInstance();rail.x=0;rail.y=0;scr.appendChild(rail);\nconst tbi=(await figma.getNodeByIdAsync('16:6')).createInstance();tbi.x=88;tbi.y=0;scr.appendChild(tbi);\n// list panel\nconst lp=card(scr,112,104,372,896);\nconst lt=txt('Messages',18,'Bold','14142B');lt.x=24;lt.y=20;lp.appendChild(lt);\nconst lm=mkIcon('more-v',20,'6E7191');lm.x=372-44;lm.y=22;lp.appendChild(lm);\nconst sf=frame(324,44,'F4F5F9',{r:22});sf.x=24;sf.y=60;lp.appendChild(sf);\nconst si=mkIcon('search',18,'6E7191');si.x=16;si.y=13;sf.appendChild(si);\nconst sp=txt('Search messages...',13,'Regular','8C8C9E');sp.x=44;sp.y=13;sf.appendChild(sp);\nfunction sectionLabel(y,label){const t=txt(label,11,'SemiBold','8C8C9E');t.x=24;t.y=y;lp.appendChild(t);}\nfunction chatRow(y,avKey,name,preview,time,badge){\n  const a=avat(avKey,44);a.x=24;a.y=y+6;lp.appendChild(a);\n  const