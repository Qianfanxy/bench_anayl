\n const r=figma.createRectangle(); parent.appendChild(r);\n r.resize(w,h); r.x=x; r.y=y; r.cornerRadius=radius;\n if(fill) r.fills=[solid(fill)]; else r.fills=[];\n return r;\n}\nasync function icon(id,parent,x,y,size){\n const src=await figma.getNodeByIdAsync(id);\n const i=src.createInstance(); parent.appendChild(i);\n const s=size/src.width; i.rescale(s); i.x=x; i.y=y; return i;\n}\nasync function logoCircle(id,parent,cx,cy,d){\n const src=await figma.getNodeByIdAsync(id);\n const i=src.createInstance(); parent.appendChild(i);\n const s=d/src.width; i.rescale(s); i.x=cx; i.y=cy; i.cornerRadius=d/2; i.clipsContent=true;\n return i;\n}\n\nconst f = figma.createFrame();\nf.name='01_Aktivitas'; f.x=400; f.y=0;\nf.resize(375,812);\nf.fills=[solid(C.bg)];\nf.clipsContent=true;\nwsPage.appendChild(f);\n\nconst sb = await instOf(srcSB,f); sb.x=0; sb.y=0;\nconst hi = await instOf(srcHI,f); hi.x=0; hi.y=778;\n\ntxt(f,'Aktivitas',FONT_B,20,C.text,16,58);\nawait icon('2:4',f,299,56,24);\nawait icon('2:7',f,339,56,24);\n\nrr(f,343,150,16,96,C.surface,12);\ntxt(f,'Dana Utama',FONT_R,12,C.textSec,32,112);\ntxt(f,'Rp2.125.000',FONT_B,24,C.text,32,130);\nrr(f,150,22,32,166,{r:0.106,g:0.24,b:0.145},11);\ntxt(f,'UP Rp206.920 (10,79%)',FONT_M,11,C.up,40,171);\nrr(f,165,44,16,210,C.brand,10);\nconst wdr=rr(f,165,44,194,210,C.surfaceHi,10);\nwdr.strokes=[solid(C.stroke)]; wdr.strokeWeight=1;\nawait icon('2:20',f,62,222,20);\ntxt(f,'Deposit',FONT_M,14,{r:1,g:1,b:1},88,224);\nawait icon('2:27',f,240,222,20);\ntxt(f,'Tarik',FONT_M,14,C.text,266,224);\nreturn 'frame ok id='+f.id;","description":"Setup workspace: clone given components, create 01_Aktivitas frame with header and balance card"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"941e9e8f-9f13-404f-85a0-b0b25ea4fd23","uuid":"bc4dc6ce-769a-4c4a-a234-d0846efa92c0","timestamp":"2026-10-31T22:16:55.507Z","tool_use_meta":[{"id":"mcp__figma__use_figma_14_989eb52e","display_name":"Use Figma","server_display_name":"