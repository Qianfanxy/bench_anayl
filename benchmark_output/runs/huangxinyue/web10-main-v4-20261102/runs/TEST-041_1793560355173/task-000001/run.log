ription":"Set current nav state via screen-level gold underline rectangles (avoids appending into instances)"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"4169e7d1-fa58-4180-9c80-2a57d8444911","uuid":"ec3576ed-6df8-4f18-b504-2a7c82fa8ac7","timestamp":"2026-11-01T19:30:58.264Z","tool_use_meta":[{"id":"mcp__figma__use_figma_31_b861858d","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
