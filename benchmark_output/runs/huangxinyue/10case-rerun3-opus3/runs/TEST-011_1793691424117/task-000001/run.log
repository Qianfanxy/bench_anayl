ame(); f.name=name; f.fills=fill?solid(fill,o.op??1):[]; if(o.r!=null) f.cornerRadius=o.r; if(o.w) f.resize(o.w,o.h||o.w); return f;}\nfunction recolor(n,color){ if('children' in n) n.children.forEach(c=>{ if(c.fills&&c.fills.length&&c.fills[0].visible!==false) c.fills=solid(color); if(c.strokes&&c.strokes.length) c.strokes=solid(color); recolor(c,color);}); }\nasync function icon(name,color,size=24){const comp=await figma.getNodeByIdAsync(ICON[name]); const i=comp.createInstance(); i.name='Icon_'+name; if(size!==24) i.rescale(size/24); recolor(i,color); return i;}\nfunction comp(name){const c=figma.createComponent(); c.name=name; c.fills=[]; return c;}\nconst lib=await figma.getNodeByIdAsync('28:2');\n// fixes\n{const set=await figma.getNodeByIdAsync('29:144'); const v=set.children.find(c=>c.name==='Tone=Lime'); recolor(v.findOne(n=>n.name==='Icon_Fire'),C.lime);\n const pc=await figma.getNodeByIdAsync('29:63'); const s=pc.findOne(n=>n.name==='Scrim'); const dk=hex(C.dark); s.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[[0.2,0],[0.55,0.55],[1,0.95]].map(([p,a])=>({position:p,color:{...dk,a}}))}];}\nconst tiles=F('Analytics Tiles',C.bg); AL(tiles,'HORIZONTAL',{gap:16,pad:[16,16,16,16],w:760,pa:'FIXED'}); tiles.layoutWrap='WRAP'; tiles.counterAxisSpacing=16; lib.appendChild(tiles);\nasync function tile(name,bg,ic,icColor,badge,label,labelColor,w=169,h=172){const c=comp('Tile / '+name); AL(c,'VERTICAL',{gap:10,pad:[16,16,16,16],w,h,pa:'FIXED',ca:'FIXED'}); c.fills=solid(bg); c.cornerRadius=24; c.clipsContent=true;\n const hd=F('Header',null); AL(hd,'HORIZONTAL',{gap:8,align:'CENTER'}); const b=F('Badge',badge,{r:16,w:32,h:32}); const i=await icon(ic,icColor,18); b.appendChild(i); i.x=7; i.y=7; hd.appendChild(b); hd.appendChild(T(label,13,'Bold',labelColor,{name:'Label'})); c.appendChild(hd); tiles.appendChild(c); return c;}\nfunction val(str,unitStart,color,size=28){const t=T(str,size,'Black',color,{name:'Value'}); t.setRangeFontSize(unitStart,str.length,13); t.setRangeFontName(unitStart,str.length,{family:'Lato',style:'Bold'}); return t;}\nconst out={};\n// Active calories\n{const c=await tile('Active Calories',C.lime,'Fire',C.lime,C.dark,'Active calories',C.dark,169,156); c.appendChild(val('645 Cal',3,C.dark,32)); const s=T('Burned today',12,'Regular',C.dark,{op:0.7,name:'Caption'}); c.appendChild(s); out.cal=c.id;}\n// Training time ring\n{const c=await tile('Training Time',C.dark,'Timer',C.dark,C.lime,'Training time',C.white,169,156);\n const ring=F('Ring Chart',null,{w:72,h:72}); const tr=figma.createEllipse(); tr.resize(72,72); tr.arcData={startingAngle:0,endingAngle:2*Math.PI,innerRadius:0.78}; tr.fills=solid(C.white,0.14); tr.name='Track'; ring.appendChild(tr);\n const pr=figma.createEllipse(); pr.resize(72,72); pr.arcData={startingAngle:-Math.PI/2,endingAngle:-Math.PI/2+0.8*2*Math.PI,innerRadius:0.78}; pr.fills=solid(C.lime); pr.name='Progress 80%'; ring.appendChild(pr);\n const t=T('80%',16,'Black',C.white,{name:'Value'}); t.textAlignHorizontal='CENTER'; t.resize(72,t.height); t.y=(72-t.height)/2; ring.appendChild(t); c.appendChild(ring); c.counterAxisAlignItems='MIN'; out.time=c.id;}\n// Cycling with map\n{const c=comp('Tile / Cycling'); c.resize(350,176); c.cornerRadius=24; c.clipsContent=true; const m=(await figma.getNodeByIdAsync('5:3')).createInstance(); m.name='Map_Cycling_Route'; m.resize(350,176); c.appendChild(m);\n const chip=F('Header',C.white); AL(chip,'HORIZONTAL',{gap:8,align:'CENTER',pad:[6,14,6,6]}); chip.cornerRadius=100; chip.effects=[{type:'DROP_SHADOW',color:{r:0.1,g:0.13,b:0.15,a:0.12},offset:{x:0,y:4},radius:12,spread:0,visible:true,blendMode:'NORMAL'}];\n const b=F('Badge',C.lime,{r:14,w:28,h:28}); const i=await icon('Cycling',C.dark,18); b.appendChild(i); i.x=5; i.y=5; chip.appendChild(b); chip.appendChild(T('Cycling',13,'Black',C.dark,{name:'Label'})); c.appendChild(chip); chip.x=14; chip.y=14; tiles.appendChild(c); out.cyc=c.id;}\n// Heart rate\n{const c=a