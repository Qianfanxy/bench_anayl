mapping name→component for use WITHIN this call only. Later calls must re-fetch by name: `figma.currentPage.findOne(n=>n.type==='COMPONENT'&&n.name==='Btn/Black')`. I'll write helper `KC(name)` in later calls.\n\nNow write Call A for real.\n\nAlso caution: `figma.getNodeByIdAsync('6:37')` returns component; createInstance; resize(15,15).\n\nIcons strokes vs fills: paintDeep handles both.\n\nChevron_Right for breadcrumb: 12px sub color.\n\nWrite it.\n\nfunction mkSectionLabel: skip.\n\nLet me write the final Call A code block now, mentally checking syntax.\n\n```js\nconst page = await figma.getNodeByIdAsync('8:2');\nawait figma.setCurrentPageAsync(page);\nconst F={VR:{family:'Volkhov',style:'Regular'},VB:{family:'Volkhov',style:'Bold'},PR:{family:'Poppins',style:'Regular'},PM:{family:'Poppins',style:'Medium'},PS:{family:'Poppins',style:'Semi Bold'}};\nfor(const k in F){await figma.loadFontAsync(F[k]);}\nconst C={ink:{r:0,g:0,b:0},txt:{r:.1,g:.1,b:.12},sub:{r:.44,g:.44,b:.48},mut:{r:.64,g:.63,b:.65},line:{r:.905,g:.89,b:.87},soft:{r:.968,g:.957,b:.945},band:{r:.937,g:.918,b:.894},white:{r:1,g:1,b:1},red:{r:.784,g:.239,b:.17},amber:{r:.965,g:.651,b:.035},denim:{r:.32,g:.44,b:.6},lilac:{r:.79,g:.72,b:.87},dotdim:{r:.85,g:.84,b:.82},black2:{r:.13,g:.13,b:.15}};\nconst S=c=>({type:'SOLID',color:c});\nfunction T(s,f,z,c,o={}){const t=figma.createText();t.fontName=f;t.fontSize=z;t.characters=s;t.fills=[S(c)];if(o.ls)t.letterSpacing={unit:'PIXELS',value:o.ls};if(o.align)t.textAlignHorizontal=o.align;if(o.lh)t.lineHeight={unit:'PIXELS',value:o.lh};if(o.strike)t.textDecoration='STRIKETHROUGH';if(o.w){t.textAutoResize='HEIGHT';t.resize(o.w,100);}return t;}\nfunction FR(n){const f=figma.createFrame();f.name=n;f.fills=[];return f;}\nfunction AL(f,o={}){f.layoutMode=o.dir||'HORIZONTAL';f.itemSpacing=o.gap||0;const p=o.p||[0,0,0,0];f.paddingLeft=p[0];f.paddingTop=p[1];f.paddingRight=p[2];f.paddingBottom=p[3];f.primaryAxisAlignItems=o.main||'CENTER';f.counterAxisAlignItems=o.cross||'CENTER';f.primaryAxisSizingMode=o.pw||'AUTO';f.counterAxisSizingMode=o.cw||'AUTO';if(o.w!==undefined)f.resize(o.w,o.h!==undefined?o.h:f.height);return f;}\nfunction ST(n,o={}){if(o.f!==undefined)n.fills=o.f===null?[]:[S(o.f)];if(o.s!==undefined){n.strokes=o.s===null?[]:[S(o.s)];n.strokeWeight=o.sw||1;n.strokeAlign='INSIDE';}if(o.r!==undefined&&'cornerRadius'in n)n.cornerRadius=o.r;return n;}\nfunction SH(n,op=.07,y=6,bl=20){n.effects=[{type:'DROP_SHADOW',color:{r:0,g:0,b:0,a:op},offset:{x:0,y},radius:bl,spread:0,visible:true,blendMode:'NORMAL'}];return n;}\nasync function PIC(id,w,h,r=0){const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();i.resize(w,h);if(r)i.cornerRadius=r;return i;}\nfunction paintDeep(n,c){try{if('fills'in n&&Array.isArray(n.fills)&&n.fills.some(x=>x.type==='SOLID'))n.fills=n.fills.map(x=>x.type==='SOLID'?S(c):x);}catch(e){}try{if('strokes'in n&&Array.isArray(n.strokes)&&n.strokes.length)n.strokes=n.strokes.map(x=>x.type==='SOLID'?S(c):x);}catch(e){}if(n.children)n.children.forEach(x=>paintDeep(x,c));}\nasync function ICO(id,w,c){const n=await figma.getNodeByIdAsync(id);const i=n.createInstance();const h=i.height*w/i.width;i.resize(w,h);if(c)paintDeep(i,c);return i;}\nfunction TXT0(inst,name,s){const n=inst.findOne(x=>x.name===name&&x.type==='TEXT');if(n)n.characters=s;return n;}\nlet cy=0;\nfunction MK(name){const c=figma.createComponent();c.name=name;reg.push(c);return c;}\nconst reg=[];\nfunction park(){for(const c of reg){c.x=-4200;c.y=cy;cy+=Math.round(c.height)+48;}reg.length=0;}\n```\n\nHmm MK references reg declared after — order: declare reg before MK usage; JS function hoisting: function MK hoisted, but reg const must be initialized before MK called — I'll declare reg/cy before.\n\nBtn/Black:\n```js\n{\nconst b=MK('Btn/Black');AL(b,{p:[28,16,28,16]});ST(b,{f:C.ink,r:10});\nconst t=T('Button',F.PR,16,C.white,{lh:24});t.name='Label';b.appendChild(t);\n}\n```\nBtn/Ghost similar.\n\nTabPill / active:\n```js\n{const p=MK('UI