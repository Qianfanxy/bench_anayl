(BG);p.clipsContent=true;p.layoutMode='VERTICAL';p.itemSpacing=0;\np.primaryAxisSizingMode='FIXED';p.counterAxisSizingMode='FIXED';\np.appendChild(await inst('2008:8'));\n\n// header\nconst hd=AF('header','HORIZONTAL',12,[2,20,2,20]);hd.counterAxisAlignItems='CENTER';hd.primaryAxisAlignItems='SPACE_BETWEEN';\nconst back=AF('back','VERTICAL',0,[8,8,8,8]);back.fills=S('FFFFFF');back.cornerRadius=20;\nback.effects=[{type:'DROP_SHADOW',color:{r:0.235,g:0.184,b:0.184,a:0.08},offset:{x:0,y:2},radius:8,spread:0,visible:true,blendMode:'NORMAL'}];\nback.appendChild(await icon('2008:91',20,INK));hd.appendChild(back);\nconst wm=await inst('2008:21');wm.name='wordmark';wm.rescale(0.45);hd.appendChild(wm);\nconst fav=AF('fav','VERTICAL',0,[8,8,8,8]);fav.fills=S('FFFFFF');fav.cornerRadius=20;\nfav.appendChild(await icon('2008:67',20,RED));hd.appendChild(fav);\np.appendChild(hd);hd.layoutAlign='STRETCH';\n\nconst body=AF('body','VERTICAL',12,[8,20,20,20]);p.appendChild(body);\nbody.layoutAlign='STRETCH';body.counterAxisSizingMode='FIXED';body.resize(430,body.height);\n\n// image\nconst imgWrap=AF('imageWrap','VERTICAL',0,[24,0,24,0]);imgWrap.counterAxisAlignItems='CENTER';imgWrap.primaryAxisAlignItems='CENTER';\nimgWrap.fills=S('FFFFFF');imgWrap.cornerRadius=24;\nimgWrap.appendChild(await img('2008:28',176,'F3D9B8',0));\nbody.appendChild(imgWrap);imgWrap.layoutAlign='STRETCH';\n\n// title + price\nconst tp=AF('titlePrice','HORIZONTAL',12,[0,0,0,0]);tp.counterAxisAlignItems='CENTER';tp.primaryAxisAlignItems='SPACE_BETWEEN';\ntp.appendChild(T('Wendy’s Burger',22,'Bold',INK));\ntp.appendChild(T('$8.24',22,'Bold',RED));\nbody.appendChild(tp);tp.layoutAlign='STRETCH';\n\n// meta row\nconst meta=AF('meta','HORIZONTAL',8,[0,0,0,0]);meta.counterAxisAlignItems='CENTER';\nconst cp=AF('catpill','VERTICAL',0,[4,10,4,10]);cp.fills=S('F2EDEA');cp.cornerRadius=10;cp.appendChild(T('Hamburger',11,'Medium',SUB));meta.appendChild(cp);\nconst rt=await inst('2009:133');rt.name='rating';meta.appendChild(rt);\nconst tm=AF('time','HORIZONTAL',4,[0,0,0,0]);tm.counterAxisAlignItems='CENTER';\ntm.appendChild(await icon('2008:100',13,SUB));tm.appendChild(T('26 mins',12,'Medium',INK));meta.appendChild(tm);\nbody.appendChild(meta);meta.layoutAlign='STRETCH';\n\n// description\nconst desc=T('Wendy’s Cheeseburger with crispy bacon and double cheddar. Made with 100% beef patty, fresh lettuce, tomato and our signature special sauce.',13,'Regular',SUB);\ndesc.textAutoResize='HEIGHT';desc.lineHeight={value:20,unit:'PIXELS'};desc.name='desc';\nbody.appendChild(desc);desc.layoutAlign='STRETCH';\n\n// tags\nconst tags=AF('tags','HORIZONTAL',8,[0,0,0,0]);\nfor(const t of ['380 kcal','Gluten Free','Beef Patty']){\n  const g=AF('tag','VERTICAL',0,[5,10,5,10]);g.fills=S('FFF1F0');g.cornerRadius=10;g.appendChild(T(t,11,'Medium',RED));tags.appendChild(g);\n}\nbody.appendChild(tags);tags.layoutAlign='STRETCH';\n\n// quantity + order bar (bottom fixed)\nconst bar=AF('bottomBar','HORIZONTAL',12,[12,20,12,20]);bar.counterAxisAlignItems='CENTER';bar.primaryAxisAlignItems='SPACE_BETWEEN';\nbar.fills=S('FFFFFF');bar.cornerRadius=24;\nbar.effects=[{type:'DROP_SHADOW',color:{r:0.235,g:0.184,b:0.184,a:0.1},offset:{x:0,y:-2},radius:14,spread:0,visible:true,blendMode:'NORMAL'}];\nconst qty=AF('qty','HORIZONTAL',12,[0,0,0,0]);qty.counterAxisAlignItems='CENTER';\nconst minus=AF('minus','VERTICAL',0,[7,7,7,7]);minus.fills=S('F2EDEA');minus.cornerRadius=14;minus.appendChild(await icon('2008:148',18,INK));qty.appendChild(minus);\nqty.appendChild(T('1',16,'SemiBold',INK));\nconst plus=AF('plus','VERTICAL',0,[7,7,7,7]);plus.fills=S(RED);plus.cornerRadius=14;plus.appendChild(await icon('2008:145',18,'FFFFFF'));qty.appendChild(plus);\nbar.appendChild(qty);\nconst btn=await inst('2008:2');btn.name='Order Now';btn.children[0].characters='Order Now · $8.24';bar.appendChild(btn);\np.appendChild(bar);\nbar.layoutPositioning='ABSOLUTE';bar.resize(430,bar.height);bar.x=0;bar.y=932-bar.height-26;\nconst hi=await i