 x=\"20\" y=\"48\" width=\"380\" height=\"76\" />\n        </frame>\n        <frame id=\"5:58\" name=\"Recent transactions (newest first)\" x=\"0\" y=\"168\" width=\"420\" height=\"182\">\n          <text id=\"5:59\" name=\"Recent transactions (newest first)\" x=\"20\" y=\"20\" width=\"235\" height=\"20\" />\n          <text id=\"5:60\" name=\"Paytm Auto Pay · 22 Jan · Weekly transaction · −₹3,500 (Merchant_Paytm) Risa Midyett · 05 Jan · Gift for Christmas · +₹6,950 (Avatar_Risa_Midyett) Amazon Pantry · 01 Jan · Subscription payment · −₹1,200 (Merchant_Amazon)\" x=\"20\" y=\"48\" width=\"380\" height=\"114\" />\n        </frame>\n        <frame id=\"5:61\" name=\"Reward\" x=\"444\" y=\"168\" width=\"420\" height=\"87\">\n          <text id=\"5:62\" name=\"Reward\" x=\"20\" y=\"20\" width=\"52\" height=\"20\" />\n          <text id=\"5:63\" name=\"Invite friends and get ₹1,000 reward\" x=\"20\" y=\"48\" width=\"380\" height=\"19\" />\n        </frame>\n        <frame id=\"5:64\" name=\"Phone sign-up\" x=\"888\" y=\"168\" width=\"420\" height=\"87\">\n          <text id=\"5:65\" name=\"Phone sign-up\" x=\"20\" y=\"20\" width=\"101\" height=\"20\" />\n          <text id=\"5:66\" name=\"Country code +91 · field empty, placeholder 9812345678\" x=\"20\" y=\"48\" width=\"380\" height=\"19\" />\n        </frame>\n        <frame id=\"5:67\" name=\"Menu (source order)\" x=\"0\" y=\"374\" width=\"420\" height=\"106\">\n          <text id=\"5:68\" name=\"Menu (source order)\" x=\"20\" y=\"20\" width=\"141\" height=\"20\" />\n          <text id=\"5:69\" name=\"New Payment · Bank Accounts · All Transactions · Rewards &amp; Offers · Settings · Logout\" x=\"20\" y=\"48\" width=\"380\" height=\"38\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"5:70\" name=\"What is fixed · what is yours\" x=\"64\" y=\"2167\" width=\"1312\" height=\"292\">\n      <text id=\"5:71\" name=\"What is fixed · what is yours\" x=\"0\" y=\"0\" width=\"328\" height=\"35\" />\n      <frame id=\"5:72\" name=\"Fixed vs yours\" x=\"0\" y=\"51\" width=\"1312\" height=\"241\">\n        <frame id=\"5:73\" name=\"Fixed (given)\" x=\"0\" y=\"0\" width=\"644\" height=\"221\">\n          <text id=\"5:74\" name=\"Fixed (given)\" x=\"24\" y=\"24\" width=\"103\" height=\"23\" />\n          <text id=\"5:75\" name=\"• Frame list and exact names • Must-include content per frame (what, not how) • Navigation structure and links • All data and copy • Brand color #1E32FA and Inter • Media: illustration, avatars, bank and merchant marks, icons • Default Button, default Text Field, platform shell incl. numeric keypad\" x=\"24\" y=\"57\" width=\"596\" height=\"140\" />\n        </frame>\n        <frame id=\"5:76\" name=\"Yours (designer decides)\" x=\"668\" y=\"0\" width=\"644\" height=\"241\">\n          <text id=\"5:77\" name=\"Yours (designer decides)\" x=\"24\" y=\"24\" width=\"197\" height=\"23\" />\n          <text id=\"5:78\" name=\"• Layout, grouping, order and emphasis on every screen • All other colors: neutrals, text, backgrounds / surfaces, Send / Receive, positive / negative amounts, reward banner, error / disabled • Type scale, spacing, radii, elevation • All states: focused field, primary account, pressed, disabled • Headers, sheet, balance block, account tiles, actions, banner, transaction rows, scan button, side menu • How the illustration and photos are cropped and treated\" x=\"24\" y=\"57\" width=\"596\" height=\"160\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"5:79\" name=\"How it is evaluated\" x=\"64\" y=\"2507\" width=\"1312\" height=\"281\">\n      <text id=\"5:80\" name=\"How it is evaluated\" x=\"0\" y=\"0\" width=\"222\" height=\"35\" />\n      <text id=\"5:81\" name=\"Your file is compared with this brief on coverage, data and flow — not on visual similarity to any original.\" x=\"0\" y=\"51\" width=\"1312\" height=\"22\" />\n      <text id=\"5:82\" name=\"1. Checklist coverage per frame 2. Data &amp; copy accuracy 3. 