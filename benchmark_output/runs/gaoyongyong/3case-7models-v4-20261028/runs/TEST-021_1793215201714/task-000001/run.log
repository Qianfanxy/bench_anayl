'Semi Bold'],['Inter','Bold']]) await figma.loadFontAsync({family:f[0],style:f[1]});\n     const C = { primary:{r:0x31/255,g:0xA0/255,b:0x62/255}, tint:{r:0xE7/255,g:0xF5/255,b:0xEE/255}, ink:{r:0x1B/255,g:0x23/255,b:0x20/255}, ink2:{r:0x5F/255,g:0x6B/255,b:0x64/255}, ink3:{r:0x99/255,g:0xA3/255,b:0x9D/255}, border:{r:0xE2/255,g:0xE7/255,b:0xE4/255}, divider:{r:0xEE/255,g:0xF1/255,b:0xEF/255}, bg:{r:0xF6/255,g:0xF8/255,b:0xF7/255}, white:{r:1,g:1,b:1}, danger:{r:0xE5/255,g:0x48/255,b:0x4D/255}, dis:{r:0xA2/255,g:0xD4/255,b:0xB9/255} };\n     function S(hex,op){const c={color:hex,type:'SOLID'}; if(op!==undefined)c.opacity=op; return [c];}\n     function T(chars,fam,style,size,hex,op){const t=figma.createText(); t.fontName={family:fam,style}; t.characters=chars; t.fontSize=size; t.fills=S(hex,op); return t;}\n     function recolor(root,hex){ if(!root) return; const nodes=[root].concat('children' in root ? root.findAll(()=>true) : []); for (const n of nodes){ try{ if('fills' in n && Array.isArray(n.fills) && n.fills.length && n.fills.every(f=>f&&f.type==='SOLID')) n.fills=n.fills.map(f=>({type:'SOLID',color:hex,opacity:f.opacity===undefined?1:f.opacity})); if('strokes' in n && Array.isArray(n.strokes) && n.strokes.length && n.strokes.every(s=>s&&s.type==='SOLID')) n.strokes=n.strokes.map(s=>({type:'SOLID',color:hex,opacity:s.opacity===undefined?1:s.opacity})); }catch(e){} } }\n     async function gid(id){return await figma.getNodeByIdAsync(id);}\n     function shadow(node,a,y,r){node.effects=[{type:'DROP_SHADOW',color:{r:0.07,g:0.16,b:0.11,a:a},offset:{x:0,y:y},radius:r,spread:0,visible:true,blendMode:'NORMAL'}];}\n     function setInstText(inst,chars){const t=inst.findOne(n=>n.type==='TEXT'); t.characters=chars; return t;}\n     function ML(t,w){t.textAutoResize='HEIGHT'; t.resize(w,t.height); return t;}\n     ```\n\n4. Errors and fixes:\n   - **Figma MCP rate limit** (\"You've reached the Figma MCP tool call limit for your Full seat on the Enterprise plan\"): hit once this segment (first Call 3 attempt). Fix: retry the identical call — succeeded. Expect this to keep happening; always retry.\n   - **set_fills validation error** (\"Required value missing at [0].color\") in paint() when recoloring Menu/Notification reference icon instances — some node inside those reference components has a fill lacking color. Fix: replaced paint() with defensive recolor() that only rewrites fills/strokes when ALL entries are SOLID, builds fresh paint objects, try/catch per node. Also removed the partial '04_Home' frame before re-running (later learned rollback makes this moot).\n   - **set_rotation error** (\"This property cannot be overridden in an instance: relative-transform\") when rotating the upvote arrow nested inside a txRow instance for Buy rows. Fix: hide the nested arrow (visible=false — allowed) and add a fresh top-level 6:280 instance rotated 180, positioned via absoluteBoundingBox deltas: `na.x=inst.x+(rb.x-ri.x)+rb.width; na.y=inst.y+(rb.y-ri.y)+rb.height;`.\n   - **TypeError: cannot read property 'findOne' of null** in 07_Profile: profileEntry instances have no FRAME named 'Icon Box' (icon isn't wrapped). Fix: size-based lookup `inst.findAll(n=>n.type==='INSTANCE').find(n=>Math.round(n.width)===24)||icons[0]`.\n   - **Key insight: failed use_figma calls roll back all changes** — after the 07 crash, previously \"completed\" 05/06 frames were gone (re-query returned null), so 05/06 had to be rebuilt in a separate successful call. No partial-node cleanup is needed, but failed work must be fully re-run.\n   - **reactInterractions does not exist** (\"no such property 'reactInterractions' on FRAME node\"). Probe confirmed: frame/instance prototypes expose `[\"reactions\",\"setReactionsAsync\"]`; `'reactInterractions' in f` = false; `'reactInteractions' in f` = false; `'reactions' in f` = true; apiVersion \"1.0.0\". Fix (pending): use legacy `reactions` property or `await node.setReactionsAsync(...)`; verify exact trigger/action shape (e