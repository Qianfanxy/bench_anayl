dChild(ci); ci.x=20+i*64; ci.y=332;\n  const cl=T(catNames[i],11,\"Medium\",\"#1D1E20\"); f.appendChild(cl); cl.x=20+i*64+Math.round((55-cl.width)/2); cl.y=394;\n}\nconst dh=sectC.createInstance(); f.appendChild(dh); dh.x=20; dh.y=428; const dts=dh.findAll(x=>x.type===\"TEXT\"); if(dts[0])dts[0].characters=\"Deal of the Day\"; if(dts[1])dts[1].characters=\"View all\";\nconst tm=T(\"22h 55m 20s remaining\",11,\"Regular\",\"#8F959E\"); f.appendChild(tm); tm.x=20; tm.y=456;\nconst dr=FR(\"Deal Row\",335,205,null,true); f.appendChild(dr); dr.x=20; dr.y=478;\nconst deals=[\n [\"Women Printed Kurta\",\"₹1,500\",\"₹2,499\",\"40% Off\",\"56,890\",2],\n [\"HRX by Hrithik Roshan\",\"₹2,499\",\"₹4,999\",\"50% Off\",\"3,44,567\",2],\n [\"Philips BHH880/10\\nHair Straightening Brush With Keratin Infused Bristles (Black).\",\"₹999\",\"₹1,999\",\"50% Off\",\"6,46,776\",3],\n [\"TITAN Men Watch- 1806N\\nThis Titan watch in Black color is I wanted to buy for a long time\",\"₹1,500\",\"₹3,500\",\"57% Off\",\"15,007\",3]];\nfor(let i=0;i<4;i++){const d=deals[i];const c=miniC.createInstance();c.x=i*96;c.y=0;c.resize(90,10);dr.appendChild(c);\n  const ts=c.findAll(x=>x.type===\"TEXT\");\n  if(ts[0]){ts[0].characters=d[0];ts[0].fontSize=10;ts[0].maxLines=d[5];}\n  if(ts[1])ts[1].characters=d[1]; if(ts[2])ts[2].characters=d[2]; if(ts[3])ts[3].characters=d[3]; if(ts[4])ts[4].characters=d[4];\n  if(dealPh[i]){const inner=c.findOne(n=>n.type===\"INSTANCE\");if(inner)inner.swapComponent(dealPh[i]);}else{grayOut(c);const ic=srchC.createInstance();ic.resize(32,32);tint(ic,\"#C0C4CC\");dr.appendChild(ic);ic.x=i*96+29;ic.y=29;}}\nconst ah=sectC.createInstance(); f.appendChild(ah); ah.x=20; ah.y=700; const ats=ah.findAll(x=>x.type===\"TEXT\"); if(ats[0])ats[0].characters=\"All Featured\"; if(ats[1])ats[1].characters=\"\";\nconst ch1=chipC.createInstance(); f.appendChild(ch1); ch1.x=20; ch1.y=730; const c1t=ch1.findAll(x=>x.type===\"TEXT\"); if(c1t[0])c1t[0].characters=\"Sort\";\nconst ch2=chipC.cr