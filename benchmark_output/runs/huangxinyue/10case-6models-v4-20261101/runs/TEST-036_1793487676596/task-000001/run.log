ance(); illu.resize(200,292); f1.appendChild(illu); illu.x=95; illu.y=96;\nmkText(f1,\"Pay\",{style:\"Bold\",size:40,x:24,y:432,lh:48});\nmkText(f1,\"Manage\",{style:\"Bold\",size:40,x:24,y:480,lh:48});\nmkText(f1,\"Grow…\",{style:\"Bold\",size:40,x:24,y:528,lh:48,color:C.BRAND});\nmkText(f1,\"An easy app to manage all your payment and finance-related needs\",{size:15,color:C.GRAY600,x:24,y:596,w:310,lh:22});\nconst btn1=get(\"1:23\").createInstance(); f1.appendChild(btn1); btn1.x=16; btn1.y=664; btn1.resize(358,52);\nconst foot=figma.createText(); foot.fontName={family:\"Inter\",style:\"Medium\"}; foot.characters=\"Already have an account?  Sign in\"; foot.fontSize=14; foot.fills=[sp(C.GRAY600)];\nf1.appendChild(foot); const si=foot.characters.indexOf(\"Sign in\");\nfoot.setRangeFontName(si, foot.characters.length, {family:\"Inter\",style:\"Semi Bold\"});\nfoot.setRangeFills(si, foot.characters.length, [sp(C.BRAND)]);\nfoot.x=Math.round((390-foot.width)/2); foot.y=740;\nconst hi1=get(\"1:44\").createInstance(); f1.appendChild(hi1); hi1.x=0; hi1.y=810;\n\n// ================= 03_Home =================\nconst f3 = figma.createFrame(); f3.name=\"03_Home\"; f3.resize(390,844); ws.appendChild(f3); f3.x=940; f3.y=0;\nf3.fills=[sp(C.BG)]; f3.clipsContent=true;\nconst sb3=get(\"1:33\").createInstance(); f3.appendChild(sb3); sb3.x=0; sb3.y=0;\n\n// header\nconst av=get(\"4:2\").createInstance(); av.resize(44,44); f3.appendChild(av); av.x=16; av.y=56;\nconst search=figma.createFrame(); search.name=\"Search\"; search.resize(252,44); search.cornerRadius=22; search.fills=[sp(C.SURFACE)]; search.strokes=[sp(C.BORDER)]; search.strokeWeight=1; f3.appendChild(search); search.x=70; search.y=56;\n{ const ic=get(\"4:21\").createInstance(); ic.resize(18,18); recolor(ic,sp(C.GRAY400)); search.appendChild(ic); ic.x=16; ic.y=13; }\nmkText(search,\"Pay by name or phone\",{size:14,color:C.GRAY400,x:42,y:13});\nconst hist=figma.createFrame(); hist.name=\"History button\"; hist.resize(44,44); hist.cornerRadius=22; hist.fills=[sp(C.SURFACE)]; hist.strokes=[sp(C.BORDER)]; hist.strokeWeight=1; f3.appendChild(hist); hist.x=330; hist.y=56;\n{ const ic=get(\"4:14\").createInstance(); ic.resize(20,20); recolor(ic,sp(C.INK)); hist.appendChild(ic); ic.x=12; ic.y=12; }\n\n// balance card\nconst bal=get(\"8:47\").createInstance(); f3.appendChild(bal); bal.x=16; bal.y=116;\n\n// action tiles\nconst tile1=get(\"8:14\").createInstance(); f3.appendChild(tile1); tile1.x=16; tile1.y=282;\nconst tile2=get(\"8:14\").createInstance(); f3.appendChild(tile2); tile2.x=138; tile2.y=282;\n{ tile2.fills=[sp(C.GREEN)];\n  const ic=tile2.findOne(n=>n.type===\"INSTANCE\"&&n.name.startsWith(\"Icon\")); ic.swapComponent(get(\"4:18\")); ic.resize(22,22); ic.x=46; ic.y=12; recolor(ic,sp(\"#FFFFFF\"));\n  const lb=tile2.findOne(n=>n.type===\"TEXT\"); lb.characters=\"Receive\"; lb.x=Math.round((114-lb.width)/2); }\nconst tile3=get(\"8:14\").createInstance(); f3.appendChild(tile3); tile3.x=260; tile3.y=282;\n{ tile3.fills=[sp(C.INK)];\n  const ic=tile3.findOne(n=>n.type===\"INSTANCE\"&&n.name.startsWith(\"Icon\")); ic.swapComponent(get(\"4:20\")); ic.resize(22,22); ic.x=46; ic.y=12; recolor(ic,sp(\"#FFFFFF\"));\n  const lb=tile3.findOne(n=>n.type===\"TEXT\"); lb.characters=\"Scan any QR\"; lb.x=Math.round((114-lb.width)/2); }\n\n// reward banner\nconst ban=get(\"8:30\").createInstance(); f3.appendChild(ban); ban.x=16; ban.y=362;\n\n// accounts section\nmkText(f3,\"OTHER ACCOUNTS\",{style:\"Semi Bold\",size:11,color:C.GRAY600,x:16,y:438,ls:7});\nconst accData=[[get(\"8:18\"),\"Axis Bank\",\"₹3,500\",\"4:10\",16,460],[get(\"8:18\"),\"HDFC Bank\",\"₹63,520\",\"4:7\",199,460],[get(\"8:18\"),\"Deutsche Bank\",\"₹36,258\",\"4:6\",16,530],[get(\"8:18\"),\"Union Bank\",\"₹67,820\",\"4:9\",199,530]];\nfor(const [compId,name,bal2,markId,x,y] of [[0,0,0,0,0,0]]){}\nconst accDefs=[[\"HDFC Bank\",\"₹63,520\",\"4:7\",199,460],[\"Deutsche Bank\",\"₹36,258\",\"4:6\",16,530],[\"Union Bank\",\"₹67,820\",\"