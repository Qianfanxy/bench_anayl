 n.fills=[solid(color,a??1)]; if(Array.isArray(n.strokes)&&n.strokes.length) n.strokes=[solid(color,a??1)]; }catch(e){} } return false; }); }\n  return inst;\n}\nfunction makeScreen(name,x){\n  const f = figma.createFrame();\n  f.name = name;\n  f.resize(430,932);\n  f.clipsContent = true;\n  f.x = x; f.y = 0;\n  return f;\n}\n\n// ================= 01_Splash =================\nconst s1 = makeScreen(\"01_Splash\", 0);\ns1.fills = [solid(C.teal)];\nconst sbL1 = findComp(\"Status Bar / Light\").createInstance();\ns1.appendChild(sbL1); sbL1.x=0; sbL1.y=0;\nconst logo1 = findComp(\"Logo_Travelin\").createInstance();\ns1.appendChild(logo1);\nconst ls1 = 200/logo1.width; logo1.rescale(ls1);\nlogo1.x = Math.round((430-logo1.width)/2); logo1.y = 396;\ntxt(\"Your Passport to Seamless Adventures!\",14,\"Medium\",C.white,s1,0,478,{w:430,align:\"CENTER\",a:0.9});\n// small plane accent\niconInst(\"Icon_Plane\", s1, 204, 340, 22, C.white, 0.85);\nconst hiL1 = findComp(\"Home Indicator / Light\").createInstance();\ns1.appendChild(hiL1); hiL1.x=0; hiL1.y=898;\n\n// ================= 02_Get_Started =================\nconst s2 = makeScreen(\"02_Get_Started\", 470);\ns2.fills = [solid(C.white)];\n// hero photo top\nconst heroWrap = figma.createFrame(); heroWrap.name=\"Hero\"; heroWrap.resize(430, 560); heroWrap.clipsContent=true;\ns2.appendChild(heroWrap); heroWrap.x=0; heroWrap.y=0;\nconst hero = findComp(\"Photo_Aerial_Island\").createInstance();\nheroWrap.appendChild(hero);\nlet hs2 = 430/hero.width; hero.rescale(hs2);\nif (hero.height < 560){ hero.rescale(560/hero.height); }\nhero.x = Math.round((430-hero.width)/2); hero.y = Math.round((560-hero.height)/2);\n// gradient overlay bottom\nconst gov = figma.createRectangle(); gov.resize(430,560);\ngov.fills = [{type:\"GRADIENT_LINEAR\",gradientTransform:[[1,0,0],[0,1,0]],gradientStops:[\n  {position:0.25,color:{r:0.04,g:0.1,b:0.11,a:0}},\n  {position:1,color:{r:0.04,g:0.1,b:0.11,a:0.6}}]}];\nheroWrap.appendChild(gov);\n// language pill\nconst lang2 = findComp(\"Language Selector\").createInstance();\ns2.appendChild(lang2); lang2.x = 298; lang2.y = 64;\n// status bar light over photo\nconst sbL2 = findComp(\"Status Bar / Light\").createInstance();\ns2.appendChild(sbL2); sbL2.x=0; sbL2.y=0;\n// logo small on photo\nconst logo2 = findComp(\"Logo_Travelin\").createInstance();\ns2.appendChild(logo2);\nconst ls2 = 120/logo2.width; logo2.rescale(ls2);\nlogo2.x = 24; logo2.y = 470;\n// headline block\nconst hl = txt(\"Ready to explore beyond boundaries?\",28,\"Bold\",C.ink,s2,24,592,{w:382,lh:38});\ntxt(\"Book flights, hotels and journeys in one place.\",14,\"Regular\",C.g600,s2,24,672,{w:382});\n// primary button (Button component instance, retext)\nconst btn2 = findComp(\"Button\").createInstance();\ns2.appendChild(btn2);\nbtn2.resize(382,56);\nbtn2.x = 24; btn2.y = 760;\nconst btn2t = btn2.findOne(n=>n.type===\"TEXT\");\nbtn2t.characters = \"Your Journey Starts Here\";\nbtn2t.x = 200 - btn2t.width; btn2t.y = Math.round((56-btn2t.height)/2);\niconInst(\"Icon_Plane\", s2, 96, 777, 22, C.white);\nconst hiL2 = findComp(\"Home Indicator\").createInstance();\ns2.appendChild(hiL2); hiL2.x=0; hiL2.y=898;\n\nreturn \"screens 1-2 done\";","description":"Build 01_Splash and 02_Get_Started screens"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"ced7a2ea-8107-43eb-9d46-6da41e6d86f8","uuid":"3bc8fea6-ffa5-4221-9ca2-7f96f6ad4765","timestamp":"2026-10-31T21:09:21.907Z","tool_use_meta":[{"id":"mcp__figma__use_figma_18_a3085240","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
