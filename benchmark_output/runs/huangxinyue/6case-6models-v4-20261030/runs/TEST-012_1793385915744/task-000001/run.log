ator';return {sb,hi};}\nasync function card(name,unit,price,img){const c=myc('Product Card').createInstance(); setP(c,{Name:name,Unit:unit,Price:price,Image:img}); c.name='Product Card · '+name; const im=c.findOne(n=>n.name==='Product Image'); im.resize(130,90); return c;}\nconst ids={};\n// 05 Home\n{const H=1522; const f=screen('05_Home',4,H);\n const car=(await comp('4:10')).createInstance(); car.rescale(0.9); put(f,car,(414-car.width)/2,54);\n const loc=myc('Location Label').createInstance(); put(f,loc,0,94); loc.x=(414-loc.width)/2;\n const sb2=myc('Search Bar').createInstance(); put(f,sb2,25,136);\n const bn=myc('Promo Banner').createInstance(); put(f,bn,25,206);\n let y=351;\n const section=async(title,items)=>{const h=myc('Section Header').createInstance(); setP(h,{Title:title}); h.name='Section · '+title; put(f,h,25,y); y+=50; let x=25; const out=[]; for(const it of items){const c=await card(...it); put(f,c,x,y); x+=188; out.push(c);} y+=248+30; return out;};\n const ex=await section('Exclusive Offer',[['Organic Bananas','7pcs, Price','$4.99','4:49'],['Red Apple','1kg, Price','$4.99','4:55']]);\n await section('Best Selling',[['Bell Pepper Red','1kg, Price','$4.99','4:28'],['Ginger','250gm, Price','$2.99','4:43']]);\n const gh=myc('Section Header').createInstance(); setP(gh,{Title:'Groceries'}); gh.name='Section · Groceries'; put(f,gh,25,y); y+=50;\n const c1=variant('Category Chip','Color=Orange').createInstance(); setP(c1,{Name:'Pulses',Image:'4:82'}); c1.resize(177,90); c1.name='Category · Pulses'; put(f,c1,25,y);\n const c2=variant('Category Chip','Color=Green').createInstance(); setP(c2,{Name:'Rice',Image:'4:85'}); c2.resize(177,90); c2.name='Category · Rice'; put(f,c2,212,y);\n for (const c of [c1,c2]){c.paddingLeft=14; c.paddingRight=14; c.itemSpacing=12; const im=c.findOne(n=>n.name==='Category Image'); im.resize(60,60);}\n y+=90+20;\n let x=25; for(const it of [['Beef Bone','1kg, Price','$4.99','4:25'],['Broiler Chicken','1kg, Price','$4.99','4:31']]){const c=await card(...it); put(f,c,x,y); x+=188;}\n const {sb,hi}=await shell(f);\n const tb=variant('Tab Bar','Current=Shop').createInstance(); tb.name='Tab Bar'; put(f,tb,0,H-92); tb.constraints={horizontal:'MIN',vertical:'MAX'};\n put(f,hi,0,H-34); hi.constraints={horizontal:'MIN',vertical:'MAX'}; hi.fills=[];\n put(f,sb,0,0);\n f.numberOfFixedChildren=0;\n ids.s5=f.id; ids.apple=ex[1].id; ids.y=y;}\n// 06 Product Detail\n{const f=screen('06_Product_Detail',5);\n const hero=figma.createFrame(); hero.name='Product Gallery'; hero.resize(414,330); fill(hero,'surface/subtle'); hero.bottomLeftRadius=hero.bottomRightRadius=25; put(f,hero,0,0);\n const im=(await comp('4:55')).createInstance(); im.resize(300,182); im.name='Product_Red_Apple'; put(hero,im,57,92);\n const dots=figma.createFrame(); dots.name='Pager'; dots.layoutMode='HORIZONTAL'; dots.itemSpacing=4; dots.fills=[]; dots.layoutSizingHorizontal='HUG'; dots.layoutSizingVertical='HUG'; for(let i=0;i<3;i++){const d=figma.createRectangle(); d.resize(i===0?16:4,4); d.cornerRadius=2; fill(d,i===0?'brand/primary':'border/strong'); dots.appendChild(d);} put(hero,dots,(414-24)/2,300);\n const hd=variant('Header','Type=Back + Share (on media)').createInstance(); hd.name='Header'; put(f,hd,0,44);\n const t=await T('Natural Red Apple','Title'); put(f,t,25,352);\n const fav=variant('Favourite Toggle','State=Off').createInstance(); fav.name='Favourite'; put(f,fav,357,352);\n const u=await T('1kg, Price','Body/Medium','text/secondary'); put(f,u,25,386);\n const st=variant('Quantity Stepper','Style=Detail').createInstance(); st.name='Quantity'; put(f,st,25,428);\n const pr=await T('$4.99','Title'); put(f,pr,389-pr.width,434); pr.name='Price';\n const d1=variant('Detail Row','Kind=Description · Open').createInstance(); setP(d1,{Title:'Product Detail'}); d1.name='Product Detail (open)'; put(f,d1,25,492);\n const d2=variant('Detail Row','Kind=Badge · Closed').createInstance(); setP(d2,{Title:'Nutritions'}); d2.name='Nutritions'; put(f,d2,25,492+d1.height);\n const d3=variant('Detail Row','Kind=Rating · Closed').createInstance(); setP(d3,{Title:'Review'}); d3.name='Review'; put(f,d3,25,492+d1.height+d2.height);\n const b=(await comp('6:29')).createInstance(); b.setProperties({'Label#6:0':'Add To Basket'}); b.name='Add To Basket'; put(f,b,25,776);\n const {sb,hi}=await shell(f); sb.fills=[]; put(f,hi,0,862); put(f,sb,0,0);\n ids.s6=f.id; ids.dEnd=492+d1.height+d2.height+d3.height;}\nreturn ids;","description":"Build 05_Home and 06_Product_Detail","fileKey":"UlgozbXKKfkCkJL2xcXBBr"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":3426,"cache_read_input_tokens":91628,"cache_creation":{"ephemeral_5m_input_tokens":3426,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"cd50dcd8-43a9-4829-85c3-1ee90c619584","uuid":"875f67ba-48e2-44de-86a3-afb037320590","timestamp":"2026-10-30T18:56:46.155Z","tool_use_meta":[{"id":"toolu_bdrk_017xXSPjghM1RRRcMEvshdSb","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
