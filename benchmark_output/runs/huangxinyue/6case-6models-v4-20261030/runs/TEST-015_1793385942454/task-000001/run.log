'?f.primaryAxisSizingMode='FIXED':f.counterAxisSizingMode='FIXED'}return f;}\nconst add=(p,...k)=>{k.forEach(x=>p.appendChild(x));return p};\nconst N=id=>figma.getNodeByIdAsync(id);\nconst ICON={Filter:'2:85',Calculator:'4:87',Swap:'4:97'};\nconst recolor=(n,c)=>n.findAll(v=>v.type==='VECTOR'||v.type==='BOOLEAN_OPERATION').forEach(v=>v.fills=S(c));\nconst lib=await N('11:2');const setBy=n=>lib.children.find(c=>(c.type==='COMPONENT_SET'||c.type==='COMPONENT')&&c.name===n);const V=(n,p)=>{const s=setBy(n);return (s.type==='COMPONENT'?s:s.children.find(c=>c.name===p)).createInstance();};\nconst at=(p,n,x,y)=>{p.appendChild(n);n.x=x;n.y=y;return n};\nconst setT=(i,name,val)=>{const t=i.findOne(n=>n.type==='TEXT'&&n.name===name);t.characters=val;return t};\nasync function iconBtn(ic){const b=V('Icon Button','Theme=Dark, Unread=false');const i=b.findOne(n=>n.name==='Icon');i.swapComponent(await N(ICON[ic]));recolor(i,C.dText);i.fills=[];b.name='Action · '+ic;return b;}\nasync function screen(name,x,y){const s=figma.createFrame();s.name=name;s.resize(390,844);s.x=x;s.y=y;s.clipsContent=true;s.fills=S(C.dBg);ws.appendChild(s);\n const sb=(await N('6:32')).createInstance();sb.fills=[];sb.findAll(n=>['TEXT','RECTANGLE','ELLIPSE'].includes(n.type)).forEach(n=>n.fills=S('#FFFFFF'));sb.findOne(n=>n.name==='Battery').strokes=S('#FFFFFF');at(s,sb,0,0);return s;}\nasync function homeInd(s){const h=(await N('6:42')).createInstance();h.fills=[];h.findAll(n=>n.type==='RECTANGLE').forEach(r=>r.fills=S('#FFFFFF'));at(s,h,0,810);}\nconst X0=2200,GAP=490,Y=944;\n\n// sparkline shape variants\nconst prs=setBy('Portfolio Row');\nconst up=prs.children.find(c=>c.name==='Trend=Up');const down=prs.children.find(c=>c.name==='Trend=Down');\nup.name='Trend=Up, Shape=A';down.name='Trend=Down, Shape=A';\nconst SH={B:[18,20,12,14,8,12,6],C:[14,18,12,16,10,12,8]};\nfor(const k of ['B','C']){const c=up.clone();prs.appendChild(c);c.name='Trend=Up, Shape='+k;c.findOne(n=>n.name==='Sparkline 7d').vectorPaths=[{windingRule:'NONE',data:SH[k].map((y,i)=>`${i?'L':'M'} ${i*10} ${y}`).join(' ')}];}\n\n// 07 fix\nconst s7=await N('26:549');\nconst list=s7.findOne(n=>n.name==='Portfolio list');\nfor(const [t,sh] of [['XRP','B'],['BNB','C']]){const r=s7.findOne(n=>n.name==='Portfolio · '+t);r.swapComponent(prs.children.find(c=>c.name==='Trend=Up, Shape='+sh));}\nfor(const r of list.children){r.paddingTop=r.paddingBottom=6;}\nsetBy('Shortcut').findOne(n=>n.name==='Tile').resize(40,40);\nconst scs=s7.findOne(n=>n.name==='Shortcuts');scs.counterAxisSpacing=6;\nscs.y=list.y+list.height+8;\nconst bn=s7.findOne(n=>n.name==='Banners');bn.y=scs.y+scs.height+8;\nconst rh=s7.findOne(n=>n.name==='Section · Exchange rates');rh.y=bn.y+bn.height+8;\nconst rr=s7.findOne(n=>n.name==='Rates');for(const t of rr.children){t.paddingTop=t.paddingBottom=8;t.itemSpacing=3;}\nrr.y=rh.y+rh.height+6;\nconst end7=rr.y+rr.height;\n\n// order book row sizing\nfor(const v of setBy('Order Book Row').children){v.resize(144,28);const w=v.findOne(n=>n.name==='Depth track');w.resize(144,28);v.findOne(n=>n.name==='price').y=6;const a=v.findOne(n=>n.name==='amount');a.x=70;a.y=6;}\n\n// 09\nconst m=await screen('09_Exchange_Stock',X0+3*GAP,Y);\nat(m,T('Exchange',{f:'Poppins',s:'SemiBold',size:22,name:'Page title'}),24,58);\nat(m,await iconBtn('Filter'),278,54);at(m,await iconBtn('Calculator'),326,54);\nconst side=V('Side Toggle','Current=Buy');side.resize(342,side.height);at(m,side,24,104);\nconst logoSwap=async(sel,id)=>{const l=sel.findOne(n=>n.name==='Logo');l.swapComponent(await N(id));};\nfunction card(label,focused){const c=F({name:label+' card',w:342,px:16,py:14,gap:8,r:16,fill:C.dSurface,stroke:focused?C.primary:C.dBorder});if(focused)c.strokeWeight=1.5;c.appendChild(T(label,{s:'Medium',size:12,c:C.dText2,name:'label'}));return c;}\nconst fc=card('From',true);const fr=F({name:'Row',dir:'HORIZONTAL',w:310,align:'SPACE_BETWEEN',cross:'CENTER'});\nconst fa=V('Asset Selector');fa.name='From stock · AAPL (ch