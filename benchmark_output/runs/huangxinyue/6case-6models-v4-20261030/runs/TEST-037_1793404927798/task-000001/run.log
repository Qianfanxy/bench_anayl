teInstance(); holder.appendChild(im);\n  const k = Math.max(w/im.width, h/im.height); im.resize(im.width*k, im.height*k);\n  im.x=(w-im.width)/2; im.y=(h-im.height)/2;\n  return holder;\n}\nfunction recolor(n,color){ if(\"fills\" in n && n.type!==\"INSTANCE\"){ try{n.fills=[{type:\"SOLID\",color}];}catch(e){} } if(\"children\" in n) for(const c of n.children) recolor(c,color); }\nconst W = await figma.getNodeByIdAsync(\"5:2\");\nconst f = W.children.find(c=>c.name===\"12_Shopping_Bag\");\n// header\nconst back = await inst(\"4:60\",24,24); f.appendChild(back); back.x=16; back.y=56; back.name=\"BackBtn\";\nconst h = T(\"Shopping Bag\",17,\"SemiBold\",C.ink); f.appendChild(h); h.x=(375-h.width)/2; h.y=60;\nconst wish = await inst(\"4:36\",24,24); f.appendChild(wish); wish.x=335; wish.y=56; wish.name=\"WishlistEntry\";\n// item card\nconst card=R(343,120,C.white,10); card.effects=[{type:\"DROP_SHADOW\",color:{r:0,g:0,b:0,a:0.06},offset:{x:0,y:2},radius:6,spread:0,visible:true,blendMode:\"NORMAL\"}]; f.appendChild(card); card.x=16; card.y=108;\nawait coverImg(f,\"3:212\",24,116,86,104,8);\nconst nm=T(\"Women's Casual Wear\",13,\"SemiBold\",C.ink); f.appendChild(nm); nm.x=122; nm.y=118;\nconst sz=T(\"Size 42\",11,\"Regular\",C.gray); f.appendChild(sz); sz.x=122; sz.y=140;\nconst chd=await inst(\"4:116\",10,6); f.appendChild(chd); chd.x=122+sz.width+6; chd.y=145;\nconst q=T(\"Qty 1\",11,\"Regular\",C.gray); f.appendChild(q); q.x=196; q.y=140;\nconst chd2=await inst(\"4:116\",10,6); f.appendChild(chd2); chd2.x=196+q.width+6; chd2.y=145;\nconst del=T(\"Delivery by 10 May\",11,\"Medium\",C.gray); f.appendChild(del); del.x=122; del.y=162;\nconst pr=T(\"₹7,000.00\",14,\"Bold\",C.ink); f.appendChild(pr); pr.x=122; pr.y=186;\n// apply coupons\n{\n  const row=R(343,48,C.surface,8); f.appendChild(row); row.x=16; row.y=244; row.name=\"ApplyCoupons\";\n  const ci=await inst(\"4:121\",24,16); f.appendChild(ci); ci.x=32; ci.y=260;\n  const t=T(\"Apply Coupons\",13,\"Medium\",C.ink); f.appendChild(t); t.x=64; t.y=259;\n  const s=T(\"Select\",12,\"SemiBold\",C.primary); f.appendChild(s); s.x=343-s.width; s.y=259;\n}\n// order payment details\n{\n  const h2=T(\"Order Payment Details\",14,\"SemiBold\",C.ink); f.appendChild(h2); h2.x=16; h2.y=316;\n  const r1l=T(\"Order Amounts\",12,\"Regular\",C.gray); f.appendChild(r1l); r1l.x=16; r1l.y=344;\n  const r1r=T(\"₹7,000.00\",12,\"SemiBold\",C.ink); f.appendChild(r1r); r1r.x=359-r1r.width; r1r.y=344;\n  const r2l=T(\"Convenience\",12,\"Regular\",C.gray); f.appendChild(r2l); r2l.x=16; r2l.y=368;\n  const km=T(\"Know More\",10,\"Medium\",C.primary); f.appendChild(km); km.x=16+r2l.width+8; km.y=369;\n  const r2r=T(\"Apply Coupon\",11,\"SemiBold\",C.primary); f.appendChild(r2r); r2r.x=359-r2r.width; r2r.y=368;\n  const r3l=T(\"Delivery Fee\",12,\"Regular\",C.gray); f.appendChild(r3l); r3l.x=16; r3l.y=392;\n  const r3r=T(\"₹30.00\",12,\"SemiBold\",C.ink); f.appendChild(r3r); r3r.x=359-r3r.width; r3r.y=392;\n  const line=R(343,1,C.border,0); f.appendChild(line); line.x=16; line.y=416;\n  const r4l=T(\"Order Total\",13,\"SemiBold\",C.ink); f.appendChild(r4l); r4l.x=16; r4l.y=428;\n  const r4r=T(\"₹7,030.00\",13,\"Bold\",C.ink); f.appendChild(r4r); r4r.x=359-r4r.width; r4r.y=428;\n  const emi=T(\"EMI Available\",11,\"Medium\",C.gray); f.appendChild(emi); emi.x=16; emi.y=452;\n  const det=T(\"Details\",10,\"SemiBold\",C.primary); f.appendChild(det); det.x=16+emi.width+8; det.y=453;\n}\n// total bar + CTA\n{\n  const bar=R(375,84,C.surface,0); f.appendChild(bar); bar.x=0; bar.y=694;\n  const tot=T(\"₹7,030.00\",16,\"Bold\",C.ink); f.appendChild(tot); tot.x=16; tot.y=712;\n  const vd=T(\"View Details\",10,\"Medium\",C.primary); f.appendChild(vd); vd.x=16; vd.y=736;\n  const btn=await inst(\"2:24\"); f.appendChild(btn); btn.resize(200,48); btn.x=159; btn.y=710; btn.name=\"ProceedToPayment\";\n  const lbl=btn.findOne(n=>n.type===\"TEXT\"); lbl.characters=\"Proceed to Payment\"; lbl.fontSize=13;\n}\nconst sb=await inst(\"2:34\",375,44); f.appendChild(sb); sb.x=0; sb.y=0;\nconst hi=await inst(\"2:45\",375,34); f.appendChild(hi); hi.x=0; hi.y=778;\nreturn \"12 done\";","description":"Build 12_Shopping_Bag"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"14b42764-d761-4609-9d48-7eed784bda72","uuid":"032025cd-814b-4eda-b3f8-b3fb31c121bb","timestamp":"2026-10-31T00:29:04.314Z","tool_use_meta":[{"id":"mcp__figma__use_figma_42_1c5fa550","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
