 figma.createFrame();\ncontent.name = 'Content';\ncontent.fills = [];\ncontent.layoutMode = 'HORIZONTAL';\ncontent.primaryAxisSizingMode = 'FIXED';\ncontent.counterAxisSizingMode = 'AUTO';\ncontent.paddingLeft = 100; content.paddingRight = 100;\ncontent.paddingTop = 24; content.paddingBottom = 24;\ncontent.itemSpacing = 20;\ncontent.layoutAlign = 'STRETCH';\n\n// ===== Filter Sidebar =====\nconst sidebar = figma.createFrame();\nsidebar.name = 'Filters';\nsidebar.layoutMode = 'VERTICAL';\nsidebar.primaryAxisSizingMode = 'AUTO';\nsidebar.counterAxisSizingMode = 'FIXED';\nsidebar.resize(295, 10);\nsidebar.paddingLeft = 24; sidebar.paddingRight = 24; sidebar.paddingTop = 24; sidebar.paddingBottom = 24;\nsidebar.itemSpacing = 24;\nsidebar.cornerRadius = 20;\nsidebar.fills = H.solid('#FFFFFF');\nsidebar.strokes = H.rgba('#000000', 0.1);\nsidebar.strokeWeight = 1;\n\n// Filter header\nconst fHeader = figma.createFrame();\nfHeader.name = 'Header';\nfHeader.fills = [];\nfHeader.layoutMode = 'HORIZONTAL';\nfHeader.primaryAxisSizingMode = 'FIXED';\nfHeader.counterAxisSizingMode = 'AUTO';\nfHeader.primaryAxisAlignItems = 'SPACE_BETWEEN';\nfHeader.counterAxisAlignItems = 'CENTER';\nfHeader.layoutAlign = 'STRETCH';\nconst fTitle = H.text('Filters', 20, 'Bold', '#000000');\nfHeader.appendChild(fTitle);\nconst fIcon = filterIcon.createInstance();\nfIcon.resize(24, 24);\nfIcon.opacity = 0.4;\nfHeader.appendChild(fIcon);\nsidebar.appendChild(fHeader);\n\n// Helper: divider line inside sidebar\nfunction sideDivider() {\n  const d = figma.createRectangle();\n  d.resize(247, 1);\n  d.fills = H.rgba('#000000', 0.1);\n  d.layoutAlign = 'STRETCH';\n  return d;\n}\nsidebar.appendChild(sideDivider());\n\n// Category list (T-shirts, Shorts, Shirts, Hoodie, Jeans)\nconst catList = figma.createFrame();\ncatList.name = 'Categories';\ncatList.fills = [];\ncatList.layoutMode = 'VERTICAL';\ncatList.itemSpacing = 16;\ncatList.counterAxisSizingMode = 'FIXED';\ncatList.primaryAxisSizingMode = 'AUTO';\ncatList.layoutAlign = 'STRETCH';\nfor (const c of ['T-shirts', 'Shorts', 'Shirts', 'Hoodie', 'Jeans']) {\n  const item = figma.createFrame();\n  item.name = c;\n  item.fills = [];\n  item.layoutMode = 'HORIZONTAL';\n  item.primaryAxisSizingMode = 'FIXED';\n  item.counterAxisSizingMode = 'AUTO';\n  item.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  item.counterAxisAlignItems = 'CENTER';\n  item.layoutAlign = 'STRETCH';\n  const t = H.text(c, 16, 'Regular', '#000000', 'Plus Jakarta Sans', 0.6);\n  item.appendChild(t);\n  const chev = chevronRight.createInstance();\n  chev.resize(16, 16);\n  chev.opacity = 0.6;\n  item.appendChild(chev);\n  catList.appendChild(item);\n}\nsidebar.appendChild(catList);\nsidebar.appendChild(sideDivider());\n\n// Price section\nconst priceSec = figma.createFrame();\npriceSec.name = 'Price';\npriceSec.fills = [];\npriceSec.layoutMode = 'VERTICAL';\npriceSec.itemSpacing = 20;\npriceSec.counterAxisSizingMode = 'FIXED';\npriceSec.primaryAxisSizingMode = 'AUTO';\npriceSec.layoutAlign = 'STRETCH';\nconst priceHead = figma.createFrame();\npriceHead.fills = [];\npriceHead.layoutMode = 'HORIZONTAL';\npriceHead.primaryAxisSizingMode = 'FIXED';\npriceHead.counterAxisSizingMode = 'AUTO';\npriceHead.primaryAxisAlignItems = 'SPACE_BETWEEN';\npriceHead.counterAxisAlignItems = 'CENTER';\npriceHead.layoutAlign = 'STRETCH';\npriceHead.appendChild(H.text('Price', 20, 'Bold', '#000000'));\nconst priceChev = (await figma.getNodeByIdAsync('4:9')).createInstance();\npriceChev.resize(16, 16);\npriceHead.appendChild(priceChev);\npriceSec.appendChild(priceHead);\n\n// Slider\nconst slider = figma.createFrame();\nslider.name = 'Slider';\nslider.fills = [];\nslider.resize(247, 32);\nslider.layoutAlign = 'STRETCH';\nslider.clipsContent = false;\nconst track = figma.createRectangle();\ntrack.resize(247, 6);\ntrack.x = 0; track.y = 8;\ntrack.cornerRadius = 3;\ntrack.fills = H.solid('#F0F0F0');\nslider.appendChild(track);\nconst fill = figma.createRectangle();\nfill.resize(120, 6);\nfill.x = 50; fill.y = 8;\nfill.cornerRadius = 3;\nfill.fills = H.solid('#000000');\nslider.appendChild(fill);\nconst thumb1 = figma.createEllipse();\nthumb1.resize(20, 20);\nthumb1.x = 42; thumb1.y = 1;\nthumb1.fills = H.solid('#000000');\nslider.appendChild(thumb1);\nconst thumb2 = figma.createEllipse();\nthumb2.resize(20, 20);\nthumb2.x = 162; thumb2.y = 1;\nthumb2.fills = H.solid('#000000');\nslider.appendChild(thumb2);\nconst rangeTxt = H.text('$50', 14, 'Medium', '#000000');\nrangeTxt.x = 50; rangeTxt.y = 22;\nslider.appendChild(rangeTxt);\nconst rangeTxt2 = H.text('$200', 14, 'Medium', '#000000');\nrangeTxt2.x = 152; rangeTxt2.y = 22;\nslider.appendChild(rangeTxt2);\npriceSec.appendChild(slider);\nsidebar.appendChild(priceSec);\nsidebar.appendChild(sideDivider());\n\n// Colors section\nconst colorSec = figma.createFrame();\ncolorSec.name = 'Colors';\ncolorSec.fills = [];\ncolorSec.layoutMode = 'VERTICAL';\ncolorSec.itemSpacing = 16;\ncolorSec.counterAxisSizingMode = 'FIXED';\ncolorSec.primaryAxisSizingMode = 'AUTO';\ncolorSec.layoutAlign = 'STRETCH';\nconst colorHead = figma.createFrame();\ncolorHead.fills = [];\ncolorHead.layoutMode = 'HORIZONTAL';\ncolorHead.primaryAxisSizingMode = 'FIXED';\ncolorHead.counterAxisSizingMode = 'AUTO';\ncolorHead.primaryAxisAlignItems = 'SPACE_BETWEEN';\ncolorHead.counterAxisAlignItems = 'CENTER';\ncolorHead.layoutAlign = 'STRETCH';\ncolorHead.appendChild(H.text('Colors', 20, 'Bold', '#000000'));\nconst colorChev = (await figma.getNodeByIdAsync('4:9')).createInstance();\ncolorChev.resize(16, 16);\ncolorHead.appendChild(colorChev);\ncolorSec.appendChild(colorHead);\n\nconst swatchGrid = figma.createFrame();\nswatchGrid.name = 'Swatches';\nswatchGrid.fills = [];\nswatchGrid.layoutMode = 'HORIZONTAL';\nswatchGrid.layoutWrap = 'WRAP';\nswatchGrid.itemSpacing = 16;\nswatchGrid.counterAxisSpacing = 16;\nswatchGrid.counterAxisSizingMode = 'FIXED';\nswatchGrid.primaryAxisSizingMode = 'AUTO';\nswatchGrid.layoutAlign = 'STRETCH';\nconst swatchColors = ['#00C12B', '#F50606', '#F5DD06', '#F57906', '#06CAF5', '#063AF5', '#7D06F5', '#F506A4', '#FFFFFF', '#000000'];\nswatchColors.forEach((c, idx) => {\n  const s = swatchComp.createInstance();\n  s.fills = H.solid(c);\n  s.strokes = H.rgba('#000000', 0.2);\n  s.strokeWeight = 1;\n  if (idx === 5) {\n    // Selected: blue with check\n    s.layoutMode = 'HORIZONTAL';\n    s.primaryAxisAlignItems = 'CENTER';\n    s.counterAxisAlignItems = 'CENTER';\n    s.primaryAxisSizingMode = 'FIXED';\n    s.counterAxisSizingMode = 'FIXED';\n    const chk = checkIcon.createInstance();\n    chk.resize(16, 16);\n    chk.fills = H.solid('#FFFFFF');\n    s.appendChild(chk);\n  }\n  swatchGrid.appendChild(s);\n});\ncolorSec.appendChild(swatchGrid);\nsidebar.appendChild(colorSec);\nsidebar.appendChild(sideDivider());\n\n// Size section\nconst sizeSec = figma.createFrame();\nsizeSec.name = 'Size';\nsizeSec.fills = [];\nsizeSec.layoutMode = 'VERTICAL';\nsizeSec.itemSpacing = 16;\nsizeSec.counterAxisSizingMode = 'FIXED';\nsizeSec.primaryAxisSizingMode = 'AUTO';\nsizeSec.layoutAlign = 'STRETCH';\nconst sizeHead = figma.createFrame();\nsizeHead.fills = [];\nsizeHead.layoutMode = 'HORIZONTAL';\nsizeHead.primaryAxisSizingMode = 'FIXED';\nsizeHead.counterAxisSizingMode = 'AUTO';\nsizeHead.primaryAxisAlignItems = 'SPACE_BETWEEN';\nsizeHead.counterAxisAlignItems = 'CENTER';\nsizeHead.layoutAlign = 'STRETCH';\nsizeHead.appendChild(H.text('Size', 20, 'Bold', '#000000'));\nconst sizeChev = (await figma.getNodeByIdAsync('4:9')).createInstance();\nsizeChev.resize(16, 16);\nsizeHead.appendChild(sizeChev);\nsizeSec.appendChild(sizeHead);\n\nconst chipGrid = figma.createFrame();\nchipGrid.name = 'Chips';\nchipGrid.fills = [];\nchipGrid.layoutMode = 'HORIZONTAL';\nchipGrid.layoutWrap = 'WRAP';\nchipGrid.itemSpacing = 8;\nchipGrid.counterAxisSpacing = 8;\nchipGrid.counterAxisSizingMode = 'FIXED';\nchipGrid.primaryAxisSizingMode = 'AUTO';\nchipGrid.layoutAlign = 'STRETCH';\nconst sizes = ['XX-Small','X-Small','Small','Medium','Large','X-Large','XX-Large','3X-Large','4X-Large'];\nfor (const sz of sizes) {\n  const chip = chipComp.createInstance();\n  const txt = chip.findOne(n => n.type === 'TEXT');\n  txt.characters = sz;\n  if (sz === 'Large') {\n    chip.fills = H.solid('#000000');\n    txt.fills = H.solid('#FFFFFF');\n    txt.opacity = 1;\n  }\n  chipGrid.appendChild(chip);\n}\nsizeSec.appendChild(chipGrid);\nsidebar.appendChild(sizeSec);\nsidebar.appendChild(sideDivider());\n\n// Dress Style section\nconst dsSec = figma.createFrame();\ndsSec.name = 'Dress Style';\ndsSec.fills = [];\ndsSec.layoutMode = 'VERTICAL';\ndsSec.itemSpacing = 16;\ndsSec.counterAxisSizingMode = 'FIXED';\ndsSec.primaryAxisSizingMode = 'AUTO';\ndsSec.layoutAlign = 'STRETCH';\nconst dsHead = figma.createFrame();\ndsHead.fills = [];\ndsHead.layoutMode = 'HORIZONTAL';\ndsHead.primaryAxisSizingMode = 'FIXED';\ndsHead.counterAxisSizingMode = 'AUTO';\ndsHead.primaryAxisAlignItems = 'SPACE_BETWEEN';\ndsHead.counterAxisAlignItems = 'CENTER';\ndsHead.layoutAlign = 'STRETCH';\ndsHead.appendChild(H.text('Dress Style', 20, 'Bold', '#000000'));\nconst dsChev = (await figma.getNodeByIdAsync('4:9')).createInstance();\ndsChev.resize(16, 16);\ndsHead.appendChild(dsChev);\ndsSec.appendChild(dsHead);\n\nfor (const c of ['Casual', 'Formal', 'Party', 'Gym']) {\n  const item = figma.createFrame();\n  item.name = c;\n  item.fills = [];\n  item.layoutMode = 'HORIZONTAL';\n  item.primaryAxisSizingMode = 'FIXED';\n  item.counterAxisSizingMode = 'AUTO';\n  item.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  item.counterAxisAlignItems = 'CENTER';\n  item.layoutAlign = 'STRETCH';\n  const t = H.text(c, 16, 'Regular', '#000000', 'Plus Jakarta Sans', 0.6);\n  item.appendChild(t);\n  const chev = chevronRight.createInstance();\n  chev.resize(16, 16);\n  chev.opacity = 0.6;\n  item.appendChild(chev);\n  dsSec.appendChild(item);\n}\nsidebar.appendChild(dsSec);\n\n// Apply Filter button\nconst applyBtn = buttonComp.createInstance();\napplyBtn.name = 'Button / Apply Filter';\napplyBtn.layoutAlign = 'STRETCH';\napplyBtn.counterAxisAlignItems = 'CENTER';\napplyBtn.primaryAxisAlignItems = 'CENTER';\nconst abTxt = applyBtn.findOne(n => n.type === 'TEXT');\nabTxt.characters = 'Apply Filter';\nabTxt.fills = H.solid('#FFFFFF');\nsidebar.appendChild(applyBtn);\n\ncontent.appendChild(sidebar);\n\nreturn { sidebarId: sidebar.id, contentId: content.id };\n","description":"Build Filter Sidebar for 02_Category","fileKey":"5S6WFXEo4QEfJTtE7MFltz"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"c5b3498c-81e1-408a-9e23-797293d6b873","uuid":"ef1cded1-a4b1-4883-81cd-70c28d21c66e","timestamp":"2026-11-03T07:27:13.249Z","tool_use_meta":[{"id":"mcp__figma__use_figma_41_5f7ce750","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
