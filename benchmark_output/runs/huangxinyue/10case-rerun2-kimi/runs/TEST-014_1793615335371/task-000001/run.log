 tb4=f4.findOne(n=>n.name==='Tab Bar (Invest)');\nnav(tb4.findOne(n=>n.name==='Icon_Main'), f1);\nnav(tb4.findOne(n=>n.name==='Label_Main'), f1);\n// 05 → Buy → 06; back → 04\nnav(f5.findOne(n=>n.name==='Buy'), f6);\nnav(f5.findOne(n=>n.name==='Icon_Back'), f4);\n// 06 → Buy → 07 (overlay); back → 05\nconst buy6=f6.findOne(n=>n.name==='Buy');\nbuy6.reactions=[{trigger:{type:'ON_CLICK'}, actions:[{type:'NODE', destinationId: f7.id, navigation:'OVERLAY', transition:{type:'DISSOLVE', easing:{type:'EASE_OUT'}, duration:0.2}, overlayRelativePosition:null, resetVideoPosition:false, resetScrollPosition:true, resetInteractiveComponents:false}]}];\nnav(f6.findOne(n=>n.name==='Icon_Back'), f5);\n// 07 → Cancel → close overlay back to 06\nconst cancel7=f7.findOne(n=>n.name==='Confirm Dialog').findOne(n=>n.name==='Cancel');\ncancel7.reactions=[{trigger:{type:'ON_CLICK'}, actions:[{type:'NODE', destinationId: f6.id, navigation:'NAVIGATE', transition:{type:'DISSOLVE', easing:{type:'EASE_OUT'}, duration:0.2}, overlayRelativePosition:null, resetVideoPosition:false, resetScrollPosition:true, resetInteractiveComponents:false}]}];\nreturn 'wired';\n","description":"Wire prototype links between all 7 frames per the brief","fileKey":"atiEUxu12QVUXf9mpT2DgG"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"6a558fc7-699a-4150-ad66-1b2df7225d3f","uuid":"5da65ab3-cb14-4a5e-b491-f7a3bfe6bb72","timestamp":"2026-11-02T11:00:08.875Z","tool_use_meta":[{"id":"mcp__figma__use_figma_0_75aa7294","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
