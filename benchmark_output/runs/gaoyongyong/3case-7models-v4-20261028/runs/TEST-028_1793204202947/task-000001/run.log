{"type":"assistant","message":{"type":"message","model":"kimi-k3","usage":{"input_tokens":47276,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":0,"claude_cache_creation_5_m_tokens":0,"claude_cache_creation_1_h_tokens":0},"role":"assistant","id":"08196ae222980a7a1ae569a84216dbd2","content":[{"type":"tool_use","id":"mcp__figma__use_figma_11_339982a4","name":"mcp__figma__use_figma","input":{"code":"\nconst ds = await figma.getNodeByIdAsync('2004:7');\nconst RED={r:0.937,g:0.165,b:0.224};\nconst BROWN={r:0.235,g:0.184,b:0.184};\nconst SUB={r:0.545,g:0.498,b:0.498};\nconst FAINT={r:0.741,g:0.702,b:0.702};\nconst LINE={r:0.925,g:0.906,b:0.898};\nconst WHITE={r:1,g:1,b:1};\nconst BG={r:0.969,g:0.961,b:0.953};\nconst RED_TINT={r:0.992,g:0.918,b:0.925};\nconst AMBER={r:1,g:0.616,b:0.122};\nconst CARD_SHADOW=[{type:'DROP_SHADOW',color:{r:0.24,g:0.18,b:0.18,a:0.08},offset:{x:0,y:4},radius:16,spread:0,visible:true,blendMode:'NORMAL'}];\nfor (const s of ['Regular','Medium','SemiBold','Bold']) await figma.loadFontAsync({family:'Roboto',style:s});\nfunction paintDeep(n,c){ if(['VECTOR','ELLIPSE','RECTANGLE','BOOLEAN_OPERATION','POLYGON','STAR','LINE'].includes(n.type)){ try{ if(n.fills&&n.fills.length) n.fills=[{type:'SOLID',color:c}]; if(n.strokes&&n.strokes.length) n.strokes=[{type:'SOLID',color:c}]; }catch(e){} } if('children'in n) n.children.forEach(ch=>paintDeep(ch,c)); }\nasync function iconInst(srcId,size,color){ const comp=await figma.getNodeByIdAsync(srcId); const inst=comp.createInstance(); inst.resize(size,size); paintDeep(inst,color); return inst; }\nasync function cloneImg(srcId,w){ const src=await figma.getNodeByIdAsync(srcId); const h=Math.round(w*src.height/src.width); const r=src.clone(); r.resize(w,h); return r; }\nasync function T(parent,chars,{x=0,y=0,w,size=14,style='Regular',color=BROWN,align,lh}={}){\n  const t=figma.createText(); t.fontName={family:'Roboto',style}; t.characters=chars; t.fontSize=size;\n  t.fills=[{type:'SOLID',color}]; if(align) t.textAlignHorizontal=align; if(lh) t.lineHeight={unit:'PIXELS',value:lh};\n  if(w){t.textAutoResize='HEIGHT'; t.resize(w,10);} else t.textAutoResize='WIDTH_AND_HEIGHT';\n  t.x=x; t.y=y; parent.appendChild(t); return t;\n}\nasync function label(txt,y){ const t=await T(ds,txt,{x:24,y,size:13,style:'SemiBold',color:SUB}); t.letterSpacing={unit:'PIXELS',value:1.2}; return t; }\nfunction comp(name,w,h){ const c=figma.createComponent(); c.name=name; c.resize(w,h); c.fills=[]; c.x=24; c.y=8; ds.appendChild(c); return c; }\nconst ICONS={back:'1:355',search:'1:347',settings:'1:367',heart:'1:343',home:'1:331',user:'1:335',chat:'1:339',menu:'1:404',plus:'1:387',minus:'1:393',check:'1:398',filter:'1:351',chev:'1:359',star:'1:363',edit:'1:375',signout:'1:379',send:'1:383'};\nconst chipSet=await figma.getNodeByIdAsync('2006:43');\nconst rbComp=await figma.getNodeByIdAsync('2006:45');\n\n// ---------- Food Card variants ----------\nawait label('MENU FOOD CARD · State', 1670);\nasync function foodCard(name, fav, imgId, cat, nm, rating){\n  const c=comp(name,179,232);\n  const bg=figma.createRectangle(); bg.resize(179,232); bg.cornerRadius=20; bg.fills=[{type:'SOLID',color:WHITE}]; bg.effects=CARD_SHADOW; bg.name='Bg'; c.appendChild(bg);\n  const img=await cloneImg(imgId,120); img.x=(179-120)/2; img.y=10; c.appendChild(img);\n  await T(c,cat,{x:16,y:126,size:11,style:'Medium',color:SUB,ls:0.5});\n  await T(c,nm,{x:16,y:144,w:147,size:15,style:'SemiBold',color:BROWN});\n  const badge=rbComp.createInstance(); badge.x=16; badge.y=186; c.appendChild(badge);\n  const val=badge.findOne(n=>n.type==='TEXT'); if(val) val.characters=rating;\n  const favBtn=figma.createEllipse(); favBtn.resize(32,32); favBtn.x=179-16-32; favBtn.y=184; favBtn.name='Favourite';\n  favBtn.fills=[{type:'SOLID',color:fav?RED:WHITE}];\n  if(!fav){ favBtn.strokes=[{type:'SOLID',color:LINE}]; favBtn.strokeWeight=1; }\n  c.appendChild(favBtn);\n  const hi=await iconInst(ICONS.heart,15,fav?WHITE:FAINT); hi.x=179-16-32+8.5; hi.y=184+8.5; c.appendChild(hi);\n  return c;\n}\nconst fcD=await foodCard('State=Default',false,'1:229','Hamburger','Veggie Burger','4.8');\nconst fcF=await foodCard('State=Favourited',true,'1:224','Cheeseburger','Wendy’s Burger','4.9');\nconst fcSet=figma.combineAsVariants([fcD,fcF], ds);\nfcSet.name='DS / Food Card'; fcSet.x=24; fcSet.y=1706; fcSet.itemSpacing=16;\n\n// ---------- Spicy Slider variants ----------\nawait label('SPICY SLIDER · State (Mild / Hot)', 1980);\nasync function slider(name, thumbX){\n  const c=comp(name,191,54);\n  const mild=await T(c,'Mild',{x:0,y:8,size:12,style:'Medium',color:thumbX<50?RED:SUB});\n  const hot=await T(c,'Hot',{x:191-28,y:8,size:12,style:'Medium',color:thumbX>50?RED:SUB});\n  const track=figma.createRectangle(); track.resize(191,6); track.y=32; track.cornerRadius=3; track.fills=[{type:'SOLID',color:{r:0.941,g:0.918,b:0.906}}]; track.name='Track'; c.appendChild(track);\n  const fillW=16+ (thumbX/100)*159;\n  const fill=figma.createRectangle(); fill.resize(fillW,6); fill.y=32; fill.cornerRadius=3; fill.fills=[{type:'SOLID',color:RED}]; fill.name='Fill'; c.appendChild(fill);\n  const th=figma.createEllipse(); th.resize(16,16); th.x=thumbX/100*175; th.y=32-5; th.fills=[{type:'SOLID',color:WHITE}]; th.strokes=[{type:'SOLID',color:RED}]; th.strokeWeight=2; th.name='Thumb';\n  th.effects=[{type:'DROP_SHADOW',color:{r:0.24,g:0.18,b:0.18,a:0.15},offset:{x:0,y:2},radius:4,spread:0,visible:true,blendMode:'NORMAL'}];\n  c.appendChild(th);\n  return c;\n}\nconst slMild=await slider('State=Mild',0);\nconst slHot=await slider('State=Hot',100);\nconst slSet=figma.combineAsVariants([slMild,slHot], ds);\nslSet.name='DS / Spicy Slider'; slSet.x=24; slSet.y=2016; slSet.itemSpacing=16;\n\n// ---------- Bottom Nav ----------\nawait label('BOTTOM NAVIGATION', 2110);\nconst nav=comp('DS / Bottom Nav',430,88);\nconst navBg=figma.createRectangle(); navBg.resize(430,88); navBg.fills=[{type:'SOLID',color:WHITE}];\nnavBg.effects=[{type:'DROP_SHADOW',color:{r:0.24,g:0.18,b:0.18,a:0.1},offset:{x:0,y:-4},radius:20,spread:0,visible:true,blendMode:'NORMAL'}];\nnavBg.name='Bar'; nav.appendChild(navBg);\nasync function navItem(iconId, name, x, active){\n  const ic=await iconInst(iconId,24,active?RED:FAINT); ic.x=x-12; ic.y=16; ic.name='Nav / '+name; nav.appendChild(ic);\n  if(active){ const dot=figma.createEllipse(); dot.resize(4,4); dot.x=x-2; dot.y=46; dot.fills=[{type:'SOLID',color:RED}]; nav.appendChild(dot); }\n}\nconst hiBtn=figma.createEllipse(); hiBtn.resize(134,5); hiBtn.x=(430-134)/2; hiBtn.y=88-13; hiBtn.cornerRadius=3; hiBtn.fills=[{type:'SOLID',color:{r:0.14,g:0.11,b:0.11}}]; hiBtn.name='Home Indicator'; nav.appendChild(hiBtn);\nnav.appendChild(hiBtn);\nawait navItem(ICONS.home,'Home',48,true);\nawait navItem(ICONS.user,'Profile',143,false);\n// add FAB\nconst fab=figma.createEllipse(); fab.resize(56,56); fab.x=430/2-28; fab.y=-16; fab.fills=[{type:'SOLID',color:RED}];\nfab.effects=[{type:'DROP_SHADOW',color:{r:0.937,g:0.165,b:0.224,a:0.4},offset:{x:0,y:6},radius:16,spread:0,visible:true,blendMode:'NORMAL'}];\nfab.name='Add (FAB)'; nav.appendChild(fab);\nconst fabIc=await iconInst(ICONS.plus,26,WHITE); fabIc.x=430/2-13; fabIc.y=-16+15; nav.appendChild(fabIc);\nawait navItem(ICONS.chat,'Support',287,false);\nawait navItem(ICONS.heart,'Favourites',382,false);\nnav.x=24; nav.y=2146;\n\nreturn JSON.stringify({foodCardSet:fcSet.id, sliderSet:slSet.id, nav:nav.id});\n","description":"Build FoodCard variants, SpicySlider variants, BottomNav component","fileKey":"xCaQ6D2H3AhzjPBYLooEMF"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"646e8bf7-f7ad-4c70-b0b4-d0ae7901c022","uuid":"c68cc362-aac4-4b73-99e0-0e388e73d8dc","timestamp":"2026-10-28T16:28:59.410Z","tool_use_meta":[{"id":"mcp__figma__use_figma_11_339982a4","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
