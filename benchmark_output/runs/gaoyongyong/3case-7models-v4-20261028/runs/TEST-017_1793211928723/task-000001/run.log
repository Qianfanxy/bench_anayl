dth=\"360\" height=\"19\" />\n        </frame>\n        <frame id=\"4:84\" name=\"11_Send\" x=\"432\" y=\"1414\" width=\"408\" height=\"327\">\n          <text id=\"4:85\" name=\"11_Send\" x=\"24\" y=\"24\" width=\"360\" height=\"26\" />\n          <text id=\"4:86\" name=\"Goal: Send money to a contact.\" x=\"24\" y=\"60\" width=\"360\" height=\"19\" />\n          <text id=\"4:87\" name=\"MUST INCLUDE\" x=\"24\" y=\"89\" width=\"84\" height=\"16\" />\n          <text id=\"4:88\" name=\"• Actions: back · avatar · Send • Amount: $500.00 • Copy: “Send” • Number pad: 1–9, “.”, 0, backspace • Recipient: Bessie Cooper · avatar · card **** **** **** 8820 · option to change recipient\" x=\"24\" y=\"115\" width=\"360\" height=\"114\" />\n          <text id=\"4:89\" name=\"LINKS\" x=\"24\" y=\"239\" width=\"32\" height=\"16\" />\n          <text id=\"4:90\" name=\"→ back → 03 → Send → 03_Home_My_Balance\" x=\"24\" y=\"265\" width=\"360\" height=\"38\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"4:91\" name=\"Frame\" x=\"64\" y=\"2472\" width=\"1272\" height=\"188\">\n      <text id=\"4:92\" name=\"Navigation structure\" x=\"0\" y=\"0\" width=\"222\" height=\"32\" />\n      <text id=\"4:93\" name=\"• Onboarding: 01_Sign_Up → 02_OTP → 03_Home_My_Balance. • Home has three views of one screen, switched in place: My Balance (03), Upcoming Bills (04), Transactions (05). All three share the same account area (avatar, greeting, messages, notifications). • Main navigation on 03, 04, 05, 07, 08, 09 — four tabs in this order: Home (Icon_Home) → 03 · Analytics (Icon_Analytics) → 09 · Cards (Icon_Cards) → 07 · Profile (Icon_Profile) → 08. The current tab must match the frame. How it looks is yours. • Pushed screens with back: 02, 06, 07, 08, 09, 10, 11. 06, 10 and 11 have no main navigation. • There is no Receive, notifications or payment-success screen — do not add frames beyond the 11.\" x=\"0\" y=\"48\" width=\"1272\" height=\"140\" />\n    </frame>\n    <frame id=\"4:94\" name=\"Frame\" x=\"64\" y=\"2716\" width=\"1272\" height=\"1389\">\n      <text id=\"4:95\" name=\"Fixed data &amp; copy\" x=\"0\" y=\"0\" width=\"190\" height=\"32\" />\n      <text id=\"4:96\" name=\"Use these values verbatim. Amounts: “+” = money in, “-” = money out.\" x=\"0\" y=\"48\" width=\"1272\" height=\"20\" />\n      <frame id=\"4:97\" name=\"Frame\" x=\"0\" y=\"84\" width=\"1272\" height=\"1305\">\n        <frame id=\"4:98\" name=\"User &amp; balance\" x=\"0\" y=\"0\" width=\"624\" height=\"150\">\n          <text id=\"4:99\" name=\"User &amp; balance\" x=\"25\" y=\"21\" width=\"109\" height=\"22\" />\n          <text id=\"4:100\" name=\"Esaaa Warden · greeting “Hi, Esaaa!” · avatar = Avatar_Neutral Phone: +62 (Indonesia) 858 2409 3560 Today: Aug 20, 2023 · currency USD “Your Balance” $190,008.03 · +8% · currency selector USD (Flag_USA)\" x=\"25\" y=\"53\" width=\"576\" height=\"76\" />\n        </frame>\n        <frame id=\"4:101\" name=\"Transfer list\" x=\"648\" y=\"0\" width=\"624\" height=\"93\">\n          <text id=\"4:102\" name=\"Transfer list\" x=\"25\" y=\"21\" width=\"87\" height=\"22\" />\n          <text id=\"4:103\" name=\"Add contact, then: Bessie Cooper, Devon Lane, Eleanor Pena, Jenny Wilson, Cody Fisher\" x=\"25\" y=\"53\" width=\"576\" height=\"19\" />\n        </frame>\n        <frame id=\"4:104\" name=\"Financial health\" x=\"0\" y=\"174\" width=\"624\" height=\"112\">\n          <text id=\"4:105\" name=\"Financial health\" x=\"25\" y=\"21\" width=\"115\" height=\"22\" />\n          <text id=\"4:106\" name=\"“Latest 7 days” · spend per day · axis 10K–50K Mon 24K · Tue 35K · Wed 45K · Thu 22K · Fri 34K · Sat 18K · Sun 30K\" x=\"25\" y=\"53\" width=\"576\" height=\"38\" />\n        </frame>\n        <frame id=\"4:107\" name=\"Upcoming bills (soonest first)\" x=\"648\" y=\"174\" width=\"624\" height=\"150\">\n          <text id=\"4:108\" name=\"Upcoming bills (soonest first)\" x=\"25\" y=\"21\" width=\"215\" height=\"22\" />\n          <text id=\"4:109\" name=\"Line Messenger (Logo_Line) · $21.00 · due Sep 05, 2023 · 1 month · Subscriptions · Pay now Adobe XD (Logo_Adobe_XD) · $126.02 · due Sep 19, 2023 · 1 month · Subscriptions · Pay now Netflix (Logo_Netflix) · $932.53 · due Jul 08, 2024 · 1 year · Subscriptions · Pay now Bill actions: Add · Edit · Delete\" x=\"25\" y=\"53\" width=\"576\" height=\"76\" />\n        </frame>\n        <frame id=\"4:110\" name=\"Transactions (newest first)\" x=\"0\" y=\"348\" width=\"624\" height=\"207\">\n          <text id=\"4:111\" name=\"Transactions (newest first)\" x=\"25\" y=\"21\" width=\"197\" height=\"22\" />\n          <text id=\"4:112\" name=\"Aug 19, 2023 · PayPal (Logo_PayPal) · Transferred · -$123.00 Jul 20, 2023 · DANA (Logo_DANA) · Transferred · -$12.00 May 08, 2023 · Google Play (Logo_Google_Play) · Refund · +$234.00 Feb 28, 2023 · Shopee (Logo_Shopee) · Refund · +$15.00 Jan 25, 2023 · Apple (Logo_Apple) · Payment · -$92.00 Jan 16, 2023 · Spotify (Logo_Spotify) · Payment · -$20.00 Show latest 3 where a screen asks for “latest 3”.\" x=\"25\" y=\"53\" width=\"576\" height=\"133\" />\n        </frame>\n        <frame id=\"4:113\" name=\"Cards\" x=\"648\" y=\"348\" width=\"624\" height=\"131\">\n          <text id=\"4:114\" name=\"Cards\" x=\"25\" y=\"21\" width=\"44\" height=\"22\" />\n          <text id=\"4:115\" name=\"Card_Art_Green · Esaaa Warden · **** **** **** 3447 · Exp 09/24 · primary Card_Art_Pink · Esaaa Warden · **** **** **** 8821 · Exp 03/26 Card_Art_Purple · Esaaa Warden · **** **** **** 5104 · Exp 11/25\" x=\"25\" y=\"53\" width=\"576\" height=\"57\" />\n        </frame>\n        <frame id=\"4:116\" name=\"Assets\" x=\"0\" y=\"579\" width=\"624\" height=\"131\">\n          <text id=\"4:117\" name=\"Assets\" x=\"25\" y=\"21\" width=\"50\" height=\"22\" />\n          <text id=\"4:118\" name=\"Solana · SOL · $12,094.08 (Crypto_Solana) Bitcoin · BTC · $17,238.11 (Crypto_Bitcoin) Ethereum · ETH · $8,200.00 (Crypto_Ethereum)\" x=\"25\" y=\"53\" width=\"576\" height=\"57\" />\n        </frame>\n        <frame id=\"4:119\" name=\"Analytics\" x=\"648\" y=\"579\" width=\"624\" height=\"188\">\n          <text id=\"4:120\" name=\"Analytics\" x=\"25\" y=\"21\" width=\"68\" height=\"22\" />\n          <text id=\"4:121\" name=\"Total income $29,231.03 · Total expenses $1,999.00 Switch: Income (selected) / Expenses · Period: Monthly Sales $15,190.00 · 52% Investment $11,451.03 · 39% Other $2,590.00 · 9% Headline share: 52% (Sales)\" x=\"25\" y=\"53\" width=\"576\" height=\"114\" />\n        </frame>\n        <frame id=\"4:122\" name=\"Markets\" x=\"0\" y=\"791\" width=\"624\" height=\"150\">\n          <text id=\"4:123\" name=\"Markets\" x=\"25\" y=\"21\" width=\"60\" height=\"22\" />\n          <text id=\"4:124\" name=\"Bitcoin · “Current price” $1,954.00 (+3.85%) Ranges 1H 2H 8H 1D 1W 1M 1Y · selected 1D Candlestick · y $1,000–$5,000 · x 08:00 10:00 12:00 15:00 18:00 21:00 24:00 “History” + See all: Solana, Bitcoin, Ethereum · actions Sell / Buy\" x=\"25\" y=\"53\" width=\"576\" height=\"76\" />\n        </frame>\n        <frame id=\"4:125\" name=\"Send\" x=\"648\" y=\"791\" width=\"624\" height=\"112\">\n          <text id=\"4:126\" name=\"Send\" x=\"25\" y=\"21\" width=\"38\" height=\"22\" />\n          <text id=\"4:127\" name=\"Recipient Bessie Cooper · **** **** **** 8820 · amount $500.00 Keypad 1–9, “.”, 0, backspace · button “Send”\" x=\"25\" y=\"53\" width=\"576\" height=\"38\" />\n        </frame>\n        <frame id=\"4:128\" name=\"Discussion forum\" x=\"0\" y=\"965\" width=\"624\" height=\"340\">\n          <text id=\"4:129\" name=\"Discussion forum\" x=\"25\" y=\"21\" width=\"127\" height=\"22\" />\n          <text id=\"4:130\" name=\"Search placeholder “Search...” · Filter Topics: Personal Finance (selected) / Investments / Cryptocurrencies Devon Lane (verified) · Personal finance · Jan 18, 2023 · 11:00 AM · liked “FindBuddy is a comprehensive personal finance app that allows you to track and manage your spending, create budgets, and set financial goals. It also provides a visual representation of your financial health.” 12 Comments · 160 Likes · 0 Dislikes Eleanor Pena (verified) · Personal finance · Jan 18, 2023 · 11:00 AM “Personal Capital is not only a budgeting tool but also an investment tracker. It provides a holistic view of your financial situation by combining budgeting and investment tracking features.” 12 Comments · 160 Likes · 0 Dislikes\" x=\"25\" y=\"53\" width=\"576\" height=\"266\" />\n        </frame>\n        <frame id=\"4:131\" name=\"Sign up &amp; OTP\" x=\"648\" y=\"965\" width=\"624\" height=\"150\">\n          <text id=\"4:132\" name=\"Sign up &amp; OTP\" x=\"25\" y=\"21\" width=\"103\" height=\"22\" />\n          <text id=\"4:133\" name=\"Sign up: “Sign up with phone number” · helper “A code will be sent to your number” · Continue Legal: “By signing up, you agree to the Terms of Service and Privacy Policy, including Cookie Use.” (Terms of Service, Privacy Policy as links) OTP: “Enter code” · 4 digits · “Resend code” · Continue\" x=\"25\" y=\"53\" width=\"576\" height=\"76\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"4:134\" name=\"Frame\" x=\"64\" y=\"4161\" width=\"1272\" height=\"253\">\n      <text id=\"4:135\" name=\"What is fixed · what is yours\" x=\"0\" y=\"0\" width=\"301\" height=\"32\" />\n      <frame id=\"4:136\" name=\"Frame\" x=\"0\" y=\"48\" width=\"1272\" height=\"205\">\n        <frame id=\"4:137\" name=\"Frame\" x=\"0\" y=\"0\" width=\"624\" height=\"205\">\n          <text id=\"4:138\" name=\"Fixed (given)\" x=\"24\" y=\"20\" width=\"95\" height=\"22\" />\n          <text id=\"4:139\" name=\"• Frame list and exact names • Must-include content per frame (what, not how) • Navigation structure and links • All data and copy • Brand primary color + Plus Jakarta Sans • Media: logos, card artwork, flags, icons, neutral avatar • Default Button, default Text Field, platform shell\" x=\"24\" y=\"52\" width=\"576\" height=\"133\" />\n        </frame>\n        <frame id=\"4:140\" name=\"Frame\" x=\"648\" y=\"0\" width=\"624\" height=\"186\">\n          <text id=\"4:141\" name=\"Yours (designer decides)\" x=\"24\" y=\"20\" width=\"182\" height=\"22\" />\n          <text id=\"4:142\" name=\"• Layout, grouping, order and emphasis on every screen • All other colors: neutrals, text, surfaces, semantic and chart colors • Type scale, spacing, radii, elevation • All states: selected, pressed, disabled, error, liked, destructive • Headers, main navigation and all business components • Chart styling (bars, breakdown, candlesticks)\" x=\"24\" y=\"52\" width=\"576\" height=\"114\" />\n        </frame>\n      </frame>\n    </frame>\n    <frame id=\"4:143\" name=\"Frame\" x=\"64\" y=\"4470\" width=\"1272\" height=\"260\">\n      <text id=\"4:144\" name=\"How it is evaluated\" x=\"0\" y=\"0\" width=\"203\" height=\"32\" />\n      <text id=\"4:145\" name=\"Your file is compared with the brief on coverage, data and flow — not on visual similarity to any reference.\" x=\"0\" y=\"48\" width=\"1272\" height=\"20\" />\n      <text id=\"4:146\" name=\"1. Checklist coverage per frame 2. Data &amp; copy accuracy 3. Flow &amp; prototype completeness 4. Information hierarchy 5. Visual quality &amp; consistency of your own system 6. Component reuse 7. State design (selected tabs and switches, liked post, empty code inputs, signed amounts)\" x=\"0\" y=\"84\" width=\"1272\" height=\"140\" />\n      <text id=\"4:147\" name=\"Deliverable: the link to your own Figma file containing the 11 named frames, your components and the prototype.\" x=\"0\" y=\"240\" width=\"1272\" height=\"20\" />\n    </frame>\n  </frame>\n</canvas>"},{"type":"text","text":"IMPORTANT: After you call this tool, you MUST call get_design_context if trying to implement the design, since this tool only returns metadata. If you do not call get_design_context, the agent will not be able to implement the design."}],"