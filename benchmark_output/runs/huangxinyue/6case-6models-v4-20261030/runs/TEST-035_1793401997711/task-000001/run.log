olor,x,y,sw=1.5){const v=figma.createVector();v.vectorPaths=[{windingRule:'NONE',data}];v.strokes=[{type:'SOLID',color}];v.strokeWeight=sw;v.fills=[];v.strokeCap='ROUND';v.strokeJoin='ROUND';v.x=x;v.y=y;parent.appendChild(v);return v;}\nasync function scr(name,x,y,bg=C.wh){const f=figma.createFrame();f.name=name;f.x=x;f.y=y;f.resize(375,812);f.fills=[{type:'SOLID',color:bg}];f.clipsContent=true;page.appendChild(f);await I('4:180',f,0,0);await I('4:191',f,0,778);return f;}\nasync function setInstText(inst,name,str){const t=inst.findOne(n=>n.type==='TEXT'&&n.name===name)||inst.findOne(n=>n.type==='TEXT');if(t){await ld('S');await ld('R');const fn=t.fontName;await figma.loadFontAsync(fn);t.characters=str;}return inst;}\nasync function btn(parent,label,x,y,variant='primary',w=327){const b=await I('4:168',parent,x,y);if(w!==327){const s=w/327;b.resize(327,52);}await setInstText(b,'Continue',label);b.name='Button · '+label;if(variant==='outline'){b.fills=[{type:'SOLID',color:C.wh}];b.strokes=[{type:'SOLID',color:C.ln}];b.strokeWeight=1;const t=b.findOne(n=>n.type==='TEXT');if(t)t.fills=[{type:'SOLID',color:C.ink}];}return b;}\n\n// ============ 01_Splash ============\nconst s1=await scr('01_Splash',0,0,C.pri);\n{R(s1,87,306,200,132,C.wh,24,{name:'BrandCard'});\nawait I('3:92',s1,165,330,44,44);\nawait I('3:95',s1,124,394,127,25);}\nawait T(s1,'Invest smarter, ride the wave',13,'R',{r:1,g:1,b:1},0,466,{w:375,align:'CENTER',name:'Tagline'});\ns1.children[s1.children.length-1].opacity=.85;\n\n// ============ 02_Onboarding ============\nconst s2=await scr('02_Onboarding',420,0);\nawait T(s2,'Skip',14,'S',C.pri,315,58,{name:'Skip'});\n{const ph=await I('3:125',s2,0,0,190,384);ph.x=92;ph.y=96;\nconst card=R(s2,122,240,130,74,C.wh,14);card.strokes=[{type:'SOLID',color:C.ln}];card.strokeWeight=1;card.effects=[{type:'DROP_SHADOW',color:{r:.09,g:.1,b:.12,a:.1},offset:{x:0,y:6},radius:16,spread:0,visible:true,blendMode:'NORMAL'}];\nawait T(s2,'Portfolio value',9,'R',C.sub,132,250,{w