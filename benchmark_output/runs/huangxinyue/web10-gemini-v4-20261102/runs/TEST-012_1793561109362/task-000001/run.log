tn.appendChild(txt);\n\n    pageRow.appendChild(btn);\n  });\n\n  // Next Chevron Button\n  const nextBtn = figma.createFrame();\n  nextBtn.resize(48, 48);\n  nextBtn.cornerRadius = 16;\n  nextBtn.fills = [{ type: \"SOLID\", color: { r: 0.95, g: 0.95, b: 0.95 } }];\n  nextBtn.layoutMode = \"HORIZONTAL\";\n  nextBtn.primaryAxisAlignItems = \"CENTER\";\n  nextBtn.counterAxisAlignItems = \"CENTER\";\n\n  const cIcon = getInst(\"Icon_Chevron_Right\");\n  cIcon.resize(20, 20);\n  nextBtn.appendChild(cIcon);\n  pageRow.appendChild(nextBtn);\n\n  leftCol.appendChild(pageRow);\n\n  blogColumns.appendChild(leftCol);\n\n  // RIGHT COLUMN - Sidebar (Tasty Recipes & Promo Card)\n  const rightCol = figma.createFrame();\n  rightCol.name = \"Blog Sidebar Right Column\";\n  rightCol.resize(460, 1600);\n  rightCol.fills = [];\n  rightCol.layoutMode = \"VERTICAL\";\n  rightCol.itemSpacing = 60;\n\n  // Tasty Recipes section\n  const tastyBox = figma.createFrame();\n  tastyBox.name = \"Tasty Recipes\";\n  tastyBox.fills = [];\n  tastyBox.layoutMode = \"VERTICAL\";\n  tastyBox.itemSpacing = 24;\n\n  const tTitle = figma.createText();\n  tTitle.characters = \"Tasty Recipes\";\n  tTitle.fontSize = 28;\n  tTitle.fontName = { family: \"Inter\", style: \"Bold\" };\n  tastyBox.appendChild(tTitle);\n\n  const tastyItems = [\n    { title: \"Chicken Meatballs with Cream Cheese\", photo: \"Photo_Chicken_Meatballs\" },\n    { title: \"Traditional Bolognaise Ragu\", photo: \"Photo_Creamy_Chicken_Bacon_Pasta\" },\n    { title: \"Pork and Chive Chinese Dumplings\", photo: \"Photo_Dumplings\" }\n  ];\n\n  tastyItems.forEach(item => {\n    const itemFrame = figma.createFrame();\n    itemFrame.name = item.title;\n    itemFrame.resize(460, 120);\n    itemFrame.fills = [];\n    itemFrame.layoutMode = \"HORIZONTAL\";\n    itemFrame.itemSpacing = 16;\n    itemFrame.counterAxisAlignItems = \"CENTER\";\n\n    const pImg = getInst(item.photo);\n    pImg.resize(120, 100);\n    pImg.cornerRadius = 16;\n    itemFrame.appendChild(pImg);\n\n    const txtCol = figma.createFrame();\n    txtCol.fills = [];\n    txtCol.layoutMode = \"VERTICAL\";\n    txtCol.itemSpacing = 8;\n\n    const tNode = figma.createText();\n    tNode.characters = item.title;\n    tNode.fontSize = 16;\n    tNode.fontName = { family: \"Inter\", style: \"Bold\" };\n    tNode.resize(324, 44);\n\n    const authNode = figma.createText();\n    authNode.characters = \"By Andreas Paula\";\n    authNode.fontSize = 13;\n    authNode.fontName = { family: \"Inter\", style: \"Medium\" };\n    authNode.fills = [{ type: \"SOLID\", color: { r: 0.5, g: 0.5, b: 0.5 } }];\n\n    txtCol.appendChild(tNode);\n    txtCol.appendChild(authNode);\n\n    itemFrame.appendChild(txtCol);\n    tastyBox.appendChild(itemFrame);\n  });\n\n  rightCol.appendChild(tastyBox);\n\n  // Sidebar Promo Card\n  const sidebarPromo = figma.createFrame();\n  sidebarPromo.name = \"Sidebar Promo Card\";\n  sidebarPromo.resize(460, 480);\n  sidebarPromo.cornerRadius = 30;\n  sidebarPromo.fills = [{ type: \"SOLID\", color: { r: 0.92, g: 0.95, b: 0.9 } }];\n  sidebarPromo.clipsContent = true;\n  sidebarPromo.layoutMode = \"VERTICAL\";\n  sidebarPromo.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  sidebarPromo.counterAxisAlignItems = \"CENTER\";\n  sidebarPromo.paddingLeft = 32;\n  sidebarPromo.paddingRight = 32;\n  sidebarPromo.paddingTop = 40;\n  sidebarPromo.paddingBottom = 32;\n\n  const spTitle = figma.createText();\n  spTitle.characters = \"Don’t forget to eat healthy food\";\n  spTitle.fontSize = 28;\n  spTitle.fontName = { family: \"Inter\", style: \"Bold\" };\n  spTitle.textAlignHorizontal = \"CENTER\";\n  spTitle.resize(396, 68);\n  sidebarPromo.appendChild(spTitle);\n\n  const spImg = getInst(\"Photo_Ad_Salad\");\n  spImg.resize(300, 240);\n  sidebarPromo.appendChild(spImg);\n\n  const spLink = figma.createText();\n  spLink.characters = \"www.foodieland.com\";\n  spLink.fontSize = 14;\n  spLink.fontName = { family: \"Inter\", style: \"Medium\" };\