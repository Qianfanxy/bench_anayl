imaryAxisAlignItems = 'CENTER';\nhero.itemSpacing = 0;\nhero.fills = H.solid('#F2F0F1');\nhero.paddingLeft = 100; hero.paddingRight = 100;\nhero.paddingTop = 80; hero.paddingBottom = 80;\nhero.layoutAlign = 'STRETCH';\n\n// Left: content\nconst heroLeft = figma.createFrame();\nheroLeft.name = 'Content';\nheroLeft.fills = [];\nheroLeft.layoutMode = 'VERTICAL';\nheroLeft.itemSpacing = 32;\nheroLeft.counterAxisSizingMode = 'AUTO';\nheroLeft.primaryAxisSizingMode = 'AUTO';\nheroLeft.layoutAlign = 'STRETCH';\nheroLeft.layoutGrow = 1;\n\nconst heroTitle = H.text('FIND CLOTHES THAT MATCHES YOUR STYLE', 64, 'Regular', '#000000', 'Archivo Black');\nheroTitle.name = 'Title';\nheroTitle.resize(577, 0);\nheroTitle.textAutoResize = 'HEIGHT';\nheroTitle.lineHeight = { value: 64, unit: 'PIXELS' };\nheroLeft.appendChild(heroTitle);\n\nconst heroCopy = H.text('Browse through our diverse range of meticulously crafted garments, designed to bring out your individuality and cater to your sense of style.', 16, 'Regular', '#000000', 'Plus Jakarta Sans', 0.6);\nheroCopy.name = 'Subtitle';\nheroCopy.resize(545, 0);\nheroCopy.textAutoResize = 'HEIGHT';\nheroCopy.lineHeight = { value: 22, unit: 'PIXELS' };\nheroLeft.appendChild(heroCopy);\n\nconst shopBtn = buttonComp.createInstance();\nshopBtn.name = 'Shop Now';\nshopBtn.resize(210, 52);\nshopBtn.counterAxisAlignItems = 'CENTER';\nshopBtn.primaryAxisAlignItems = 'CENTER';\nconst shopBtnTxt = shopBtn.findOne(n => n.type === 'TEXT');\nshopBtnTxt.characters = 'Shop Now';\nshopBtnTxt.fontSize = 16;\nshopBtnTxt.fontName = { family: 'Plus Jakarta Sans', style: 'Medium' };\nshopBtnTxt.fills = H.solid('#FFFFFF');\nheroLeft.appendChild(shopBtn);\n\n// Stats\nconst stats = figma.createFrame();\nstats.name = 'Stats';\nstats.fills = [];\nstats.layoutMode = 'HORIZONTAL';\nstats.itemSpacing = 32;\nstats.counterAxisSizingMode = 'AUTO';\nstats.primaryAxisSizingMode = 'AUTO';\nstats.counterAxisAlignItems = 'CENTER';\nfunction stat(num, label) {\n  const s = figma.createFrame();\n  s.fills = [];\n  s.layoutMode = 'VERTICAL';\n  s.itemSpacing = 0;\n  s.counterAxisSizingMode = 'AUTO';\n  s.primaryAxisSizingMode = 'AUTO';\n  const n = H.text(num, 40, 'Bold', '#000000');\n  s.appendChild(n);\n  const l = H.text(label, 16, 'Regular', '#000000', 'Plus Jakarta Sans', 0.6);\n  s.appendChild(l);\n  return s;\n}\nfunction statDivider() {\n  const d = figma.createRectangle();\n  d.resize(1, 74);\n  d.fills = H.rgba('#000000', 0.1);\n  return d;\n}\nstats.appendChild(stat('200+', 'International Brands'));\nstats.appendChild(statDivider());\nstats.appendChild(stat('2,000+', 'High-Quality Products'));\nstats.appendChild(statDivider());\nstats.appendChild(stat('30,000+', 'Happy Customers'));\nheroLeft.appendChild(stats);\n\nhero.appendChild(heroLeft);\n\n// Right: image with sparkles\nconst heroRight = figma.createFrame();\nheroRight.name = 'Image';\nheroRight.fills = [];\nheroRight.resize(630, 620);\nheroRight.clipsContent = false;\nconst heroImg = figma.createRectangle();\nheroImg.name = 'Photo';\nheroImg.resize(630, 620);\nheroImg.fills = [{ type: 'IMAGE', imageHash: HASH.hero, scaleMode: 'FILL' }];\nheroImg.x = 0; heroImg.y = 0;\nheroRight.appendChild(heroImg);\n// Sparkles\nconst sparkle1 = sparkleIcon.createInstance();\nsparkle1.resize(104, 104);\nsparkle1.x = 500; sparkle1.y = 40;\nsparkle1.fills = H.solid('#000000');\nheroRight.appendChild(sparkle1);\nconst sparkle2 = sparkleIcon.createInstance();\nsparkle2.resize(56, 56);\nsparkle2.x = 30; sparkle2.y = 260;\nsparkle2.fills = H.solid('#000000');\nheroRight.appendChild(sparkle2);\nhero.appendChild(heroRight);\n\nhome.appendChild(hero);\n\nreturn { heroId: hero.id, homeHeight: home.height };\n","description":"Build Hero section of 01_Home","fileKey":"5S6WFXEo4QEfJTtE7MFltz"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"c5b3498c-81e1-408a-9e23-797293d6b873","uuid":"e5893650-e391-46c6-846e-0584ed1f75d3","timestamp":"2026-11-03T07:18:01.121Z","tool_use_meta"