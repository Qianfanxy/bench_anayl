;e.y=y;e.resize(d,d);e.fills=[solid(fill)];return e;}\nconst sec=ws.children.find(n=>n.type==='SECTION'&&n.name.startsWith('Design System'));\nconst by=n=>sec.children.find(c=>c.name===n);\nconst TAB_CARDS=by('Tab Bar / Cards').id, TAB_PROFILE=by('Tab Bar / Profile').id;\n\n// ================= 07_Cards =================\nconst s7=frame(ws,'07_Cards',2634,0,375,812,C.bg);\ninst(s7,'6:110',0,0);inst(s7,'6:122',0,778);\nconst h7=frame(s7,'header',0,44,375,56,C.bg);\nconst b7=frame(h7,'back',16,8,40,40,C.white,13);inst(b7,'2:8',10,10,20);\ntxt(h7,'Cards',72,12,{size:17,weight:'SemiBold'});\ninst(h7,'2:65',271,8,40);\nconst m7=frame(h7,'more',319,12,32,32,C.white,16);recolor(inst(m7,'2:18',7,14,18),C.ink);\n// primary card\nconst cw=335,chh=214;\nconst card=frame(s7,'card primary',20,112,cw,chh,null,24);\ncard.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[1,0,0],[0,1,0]],gradientStops:[{position:0,color:{...rgb('#0F3D33'),a:1}},{position:1,color:{...rgb('#1E6B57'),a:1}}]}];\nconst art=inst(card,'2:36',0,0,cw);art.x=0;art.y=0;art.resize(cw,cw*183/287);\ntxt(card,'Primary',20,20,{size:10,weight:'SemiBold',color:C.white});\nconst chip=frame(card,'chip',20,52,38,28,'#D8C08A',6);chip.fills=[solid('#D8C08A')];\ntxt(card,'**** **** **** 3447',20,150,{size:15,weight:'SemiBold',color:C.white,spacing:1.2,lh:20});\ntxt(card,'Esaaa Warden',20,180,{size:11,color:C.white});\ntxt(card,'Exp 09/24',0,180,{size:11,color:C.white,w:299,align:'RIGHT'});\n// add card\nconst add=frame(s7,'Add Card',20,340,335,44,C.white,14);\nadd.strokes=[{...solid(C.primary)}];add.strokeWeight=1.5;add.strokeAlign='INSIDE';\nrecolor(inst(add,'2:10',124,12,20),C.deep);\ntxt(add,'Add Card',0,13,{size:12,weight:'SemiBold',color:C.deep,w:335,align:'CENTER'});\ntxt(add,'',300,0,{size:1});\n// assets\ntxt(s7,'Assets',20,400,{size:15,weight:'SemiBold'});\ntxt(s7,'Total $37,532.19',0,402,{size:10,color:C.muted,w:335,align:'RIGHT'});\nconst assets=[['2:33','Solana','SOL','$12,094.08'],['2:34','Bitcoin','BTC','$17