{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgLwG6yYbNau42IolN5hU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GXPxX2TyrhdpB7E73F8yI1","name":"mcp__figma__use_figma","input":{"code":"\nfor (const s of ['Regular','Medium','Semi Bold','Bold']) await figma.loadFontAsync({family:'Roboto',style:s});\nconst C={bg:'#0E0F13',surface:'#17181E',surface2:'#1F2028',surface3:'#282A33',border:'#2C2E38',text:'#F2F2F2',text2:'#9EA0AD',text3:'#6E7080',brand:'#279646',gain:'#2FBF71',loss:'#F0554B'};\nconst rgb=h=>{h=h.replace('#','');return{r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255};};\nconst paint=h=>[{type:'SOLID',color:rgb(h)}];\nfunction text(parent,name,chars,color,size,weight,lh){const t=figma.createText();t.name=name;t.fontName={family:'Roboto',style:weight||'Regular'};t.characters=chars;t.fontSize=size;t.lineHeight={unit:'PIXELS',value:lh||Math.round(size*1.35)};t.fills=paint(color);parent.appendChild(t);return t;}\nfunction box(name,w,h,fill,radius){const f=figma.createFrame();f.name=name;f.resize(w,h);f.fills=fill?paint(fill):[];f.clipsContent=true;if(radius!==undefined)f.cornerRadius=radius;return f;}\nasync function inst(id,parent,w,h){const n=await figma.getNodeByIdAsync(id);if(n.type!=='COMPONENT')throw new Error('not component '+id+' '+n.type);const i=n.createInstance();if(w){i.resize(w,h||w);}parent.appendChild(i);return i;}\nconst page=await figma.getNodeByIdAsync('5:2');await figma.setCurrentPageAsync(page);\nfor(const ch of Array.from(page.children)){ if(ch.name==='02_Trending') ch.remove(); }\nconst setT=(i,name,v)=>{const n=i.findOne(x=>x.name===name);if(n)n.characters=v;return n;};\nasync function swapLogo(row,compId){const logoInst=row.findOne(n=>n.name==='Logo'&&n.type==='INSTANCE');const mc=await figma.getNodeByIdAsync(compId);if(logoInst)logoInst.swapComponent(mc);}\nfunction screen(name,x){const f=figma.createFrame();f.name=name;f.resize(375,812);f.x=x;f.y=0;f.fills=paint(C.bg);f.clipsContent=true;page.appendChild(f);return f;}\nfunction body(f){const b=box('Body',375,652,null);b.x=0;b.y=100;b.layoutMode='VERTICAL';b.primaryAxisSizingMode='AUTO';b.counterAxisSizingMode='FIXED';b.paddingLeft=16;b.paddingRight=16;b.paddingTop=14;b.itemSpacing=18;f.appendChild(b);return b;}\nasync function secHead(parent,title,right){const r=box('Section header',343,24,null);r.layoutMode='HORIZONTAL';r.counterAxisSizingMode='AUTO';r.primaryAxisSizingMode='FIXED';r.primaryAxisAlignItems='SPACE_BETWEEN';r.counterAxisAlignItems='CENTER';parent.appendChild(r);text(r,'Title',title,C.text,15,'Medium',20);if(right){const rr=box('Right',0,20,null);rr.layoutMode='HORIZONTAL';rr.primaryAxisSizingMode='AUTO';rr.counterAxisSizingMode='AUTO';rr.counterAxisAlignItems='CENTER';rr.itemSpacing=2;r.appendChild(rr);text(rr,'Label',right,C.text2,12,'Regular',16);const ci=await inst('2:48',rr,16,16);for(const v of ci.findAll(n=>n.type==='VECTOR')){v.fills=paint(C.text2);}}return r;}\n\nconst s2=screen('02_Trending',420);\nawait inst('1:30',s2);\nconst h2=await inst('7:12',s2);h2.x=0;h2.y=44;setT(h2,'Title','Trending');\nconst b2=body(s2);\nconst mt=box('Market tabs',343,34,null);mt.layoutMode='HORIZONTAL';mt.primaryAxisSizingMode='FIXED';mt.counterAxisSizingMode='FIXED';mt.itemSpacing=8;b2.appendChild(mt);\nfor(const d of [['Global',true],['Crypto',false],['Reksadana',false],['CFD',false]]){const c=await inst(d[1]?'8:16':'8:14',mt);c.resize(c.width,34);setT(c,'Label',d[0]);}\nconst ix=box('Indices',343,80,null);ix.layoutMode='HORIZONTAL';ix.primaryAxisSizingMode='FIXED';ix.counterAxisSizingMode='FIXED';ix.itemSpacing=8;b2.appendChild(ix);\nfor(const d of [['IHSG','7.206,92',true],['NIKKEI','27.105,20',false],['SENSEX','59.959,85',true]]){const c=await inst(d[2]?'15:87':'15:93',ix,109,80);c.layoutGrow=1;c.resize(109,80);setT(c,'Name',d[0]);setT(c,'Value',d[1]);}\nconst rg=box('Regions',343,32,null);rg.layoutMode='HORIZONTAL';rg.primaryAxisSizingMode='FIXED';rg.counterAxisSizingMode='FIXED';rg.itemSpacing=8;b2.appendChild(rg);\nfor(const d of [['Asia',true],['Eropa',false],['Amerika',false],['Mata Uang',false]]){const c=await inst(d[1]?'8:18':'8:14',rg);c.resize(c.width,32);setT(c,'Label',d[0]);}\nconst th=await secHead(b2,'Trending','Lihat Semua');\nconst period=box('Period',68,24,C.surface2,12);period.layoutMode='HORIZONTAL';period.primaryAxisSizingMode='AUTO';period.counterAxisSizingMode='FIXED';period.paddingLeft=8;period.paddingRight=6;period.counterAxisAlignItems='CENTER';period.itemSpacing=3;th.insertChild(1,period);\ntext(period,'Label','24 jam',C.text2,11,'Regular',14);\nconst cd=await inst('2:45',period,14,14);for(const v of cd.findAll(n=>n.type==='VECTOR')){v.fills=paint(C.text2);}\nconst list2=box('Trending list',343,360,null);list2.layoutMode='VERTICAL';list2.primaryAxisSizingMode='AUTO';list2.counterAxisSizingMode='FIXED';list2.itemSpacing=4;b2.appendChild(list2);\nconst tdata=[['ROTI','Nippon Indosari Tbk','8.600','+50 (+0,58%)',true,'3:31'],['GOTO','GoTo Gojek Tokopedia','189','−9 (−4,55%)',false,'3:45'],['ABNB','Airbnb Inc','5.300','+31 (+0,59%)',true,'3:47'],['UNVR','Unilever Indonesia','3.867','−71 (−1,80%)',false,'3:46'],['BBRI','Bank Rakyat Indonesia','4.630','+38 (+0,83%)',true,'3:44'],['ADRO','Adaro Energy Indonesia','3.600','+21 (+0,59%)',true,'3:48']];\nfor(const d of tdata){const r=await inst(d[4]?'15:53':'15:62',list2,343,60);setT(r,'Ticker',d[0]);setT(r,'Company',d[1]);setT(r,'Price',d[2]);setT(r,'Change',d[3]);await swapLogo(r,d[5]);}\nawait secHead(b2,'Rekomendasi','Lihat Semua');\nconst recRow=box('Recommendations',343,100,null);recRow.layoutMode='HORIZONTAL';recRow.primaryAxisSizingMode='FIXED';recRow.counterAxisSizingMode='FIXED';recRow.itemSpacing=10;b2.appendChild(recRow);\nconst rec=[['NFLX','Netflix, Inc','2.122.340','−0,20%',false],['META','Meta Platforms','987.890','+1,29%',true],['AMZN','Amazon.com, Inc','1.001.333','−6,20%',false]];\nfor(const d of rec){const c=await inst(d[4]?'15:100':'15:106',recRow,107,100);c.resize(107,100);c.layoutGrow=1;const bdg=c.findOne(n=>n.name==='Initial');if(bdg)bdg.characters=d[0][0];setT(c,'Ticker',d[0]);setT(c,'Price',d[1]);setT(c,'Change',d[3]);}\nconst tb2=await inst('7:67',s2);tb2.x=0;tb2.y=752;\nconst hi2=await inst('1:40',s2);hi2.x=0;hi2.y=778;\nreturn '02 '+s2.id;\n","description":"Rebuild 02_Trending with correct component IDs","fileKey":"4vKKpRHOlbMS1w0BzHKmKz"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":67324,"input_tokens":1,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":67324}},"context_management":null},"parent_tool_use_id":null,"session_id":"6dc355e0-32b3-4413-a395-2651983398f3","uuid":"19ccca56-fca4-4a3a-8f3d-58b2e22e0b3b","timestamp":"2026-10-31T21:35:15.317Z","tool_use_meta":[{"id":"toolu_01GXPxX2TyrhdpB7E73F8yI1","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
