(sb4);\n\n  // Sheet Container\n  const sheet = figma.createFrame();\n  sheet.name = \"Bottom_Sheet\";\n  sheet.resize(375, 580);\n  sheet.x = 0; sheet.y = 812 - 580;\n  sheet.cornerRadius = 32;\n  sheet.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  sheet.effects = [{\n    type: 'DROP_SHADOW',\n    color: { r: 0, g: 0, b: 0, a: 0.1 },\n    offset: { x: 0, y: -8 },\n    radius: 24,\n    visible: true,\n    blendMode: 'NORMAL'\n  }];\n  frame4.appendChild(sheet);\n\n  // Drag handle\n  const handle = figma.createRectangle();\n  handle.name = \"Handle\";\n  handle.resize(36, 5);\n  handle.x = (375 - 36) / 2; handle.y = 12;\n  handle.cornerRadius = 2.5;\n  handle.fills = [{ type: 'SOLID', color: { r: 0.85, g: 0.85, b: 0.88 } }];\n  sheet.appendChild(handle);\n\n  // Back button (top left of sheet)\n  const backIcon = figma.getNodeById(\"2:123\").createInstance();\n  backIcon.x = 20; backIcon.y = 20;\n  sheet.appendChild(backIcon);\n\n  // Title \"Invest to Strategy\"\n  const title = figma.createText();\n  title.characters = \"Invest to Strategy\";\n  title.fontName = { family: \"Nunito\", style: \"ExtraBold\" };\n  title.fontSize = 20; title.x = 60; title.y = 20;\n  title.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n  sheet.appendChild(title);\n\n  // Amount Entry Section (Coin logo, Value entered, max button, swap)\n  // Value being entered: 3,021 DAI (balance 3,045.86 DAI)\n  const amountBox = figma.createFrame();\n  amountBox.name = \"Amount_Input_Box\";\n  amountBox.resize(335, 110);\n  amountBox.x = 20; amountBox.y = 64;\n  amountBox.fills = [{ type: 'SOLID', color: { r: 0.96, g: 0.97, b: 0.98 } }];\n  amountBox.cornerRadius = 20;\n  sheet.appendChild(amountBox);\n\n  const daiLogo = figma.getNodeById(\"2:38\").createInstance();\n  daiLogo.x = 16; daiLogo.y = 16;\n  daiLogo.resize(32, 32);\n  amountBox.appendChild(daiLogo);\n\n  const coinName = figma.createText();\n  coinName.characters = \"DAI\";\n  coinName.fontName = { family: \"Nunito\", style: \"ExtraBold\" };\n  coinName.fontSize = 18; coinName.x = 56; coinName.y = 20;\n  coinName.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n  amountBox.appendChild(coinName);\n\n  const inputVal = figma.createText();\n  inputVal.characters = \"3,021\";\n  inputVal.fontName = { family: \"Nunito\", style: \"ExtraBold\" };\n  inputVal.fontSize = 28; inputVal.x = 140; inputVal.y = 16;\n  inputVal.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n  inputVal.textAlignHorizontal = \"RIGHT\"; inputVal.resize(115, 36);\n  amountBox.appendChild(inputVal);\n\n  const maxBtn = figma.createFrame();\n  maxBtn.name = \"Max_Badge\";\n  maxBtn.resize(50, 26);\n  maxBtn.x = 269; maxBtn.y = 20;\n  maxBtn.cornerRadius = 13;\n  maxBtn.fills = [{ type: 'SOLID', color: { r: 0.88, g: 0.9, b: 0.94 } }];\n  amountBox.appendChild(maxBtn);\n\n  const maxTxt = figma.createText();\n  maxTxt.characters = \"Max\";\n  maxTxt.fontName = { family: \"Nunito\", style: \"Bold\" };\n  maxTxt.fontSize = 12; maxTxt.x = 13; maxTxt.y = 4;\n  maxTxt.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n  maxBtn.appendChild(maxTxt);\n\n  const balanceTxt = figma.createText();\n  balanceTxt.characters = \"Balance: 3,045.86 DAI\";\n  balanceTxt.fontName = { family: \"Nunito\", style: \"Medium\" };\n  balanceTxt.fontSize = 13; balanceTxt.x = 16; balanceTxt.y = 70;\n  balanceTxt.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.56 } }];\n  amountBox.appendChild(balanceTxt);\n\n  const swapIcon = figma.getNodeById(\"2:112\").createInstance();\n  swapIcon.x = 295; swapIcon.y = 66;\n  amountBox.appendChild(swapIcon);\n\n  // No gas free investments label \"⛽️ No gas, free investments\"\n  const infoTxt = figma.createText();\n  infoTxt.characters = \"⛽️ No gas, free investments\";\n  infoTxt.fontName = { family: \"Nunito\", style: \"Bold\" };\n  infoTxt.fontSize = 13; infoTxt.x = 20; infoTxt.y = 186;\n  infoTxt.fills = [{ type: 'SOLID', color: { r: 0.18, g: 0.72, b: 0.45 } }];\n  sheet.