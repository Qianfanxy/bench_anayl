{"type":"assistant","message":{"id":"chatcmpl-202610311949049999962278268d9d6rElG9Tqg","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_25b8dd109ad34e0cb902572d38a706d2","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Semi Bold\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Bold\" });\n\n  const workspace = figma.root.children.find(p => p.name.includes(\"03\"));\n  await figma.setCurrentPageAsync(workspace);\n\n  // Helper colors\n  const BG_COLOR = { r: 0.07, g: 0.09, b: 0.11 }; // #12171C\n  const CARD_BG = { r: 0.12, g: 0.15, b: 0.18 }; // #1F262E\n  const GREEN_GAIN = { r: 0.15, g: 0.59, b: 0.27 }; // #279646\n  const RED_LOSS = { r: 0.90, g: 0.28, b: 0.28 }; // #E54747\n  const TEXT_WHITE = { r: 0.95, g: 0.96, b: 0.98 }; // #F2F4F7\n  const TEXT_MUTED = { r: 0.55, g: 0.60, b: 0.68 }; // #8C99AD\n  const BORDER_COLOR = { r: 0.18, g: 0.22, b: 0.27 }; // #2E3845\n\n  // Helper function to create component instance\n  function getInstance(id) {\n    const orig = figma.getNodeById(id);\n    if (!orig) return null;\n    return orig.createInstance();\n  }\n\n  // Helper for Status Bar & Home Indicator\n  function addShell(frame) {\n    const sb = getInstance(\"1:30\");\n    if (sb) {\n      sb.x = 0; sb.y = 0;\n      frame.appendChild(sb);\n    }\n    const hi = getInstance(\"1:40\");\n    if (hi) {\n      hi.x = 0; hi.y = 812 - 34;\n      frame.appendChild(hi);\n    }\n  }\n\n  // Helper for Bottom Tab Bar\n  function createTabBar(activeTab = \"Aktivitas\") {\n    const bar = figma.createFrame();\n    bar.name = \"Tab Bar\";\n    bar.resize(375, 64);\n    bar.fills = [{ type: 'SOLID', color: CARD_BG }];\n    bar.strokes = [{ type: 'SOLID', color: BORDER_COLOR }];\n    bar.strokeWeight = 1;\n    bar.layoutMode = \"HORIZONTAL\";\n    bar.primaryAxisSizingMode = \"FIXED\";\n    bar.counterAxisSizingMode = \"FIXED\";\n    bar.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    bar.counterAxisAlignItems = \"CENTER\";\n    bar.paddingLeft = 8;\n    bar.paddingRight = 8;\n\n    const tabs = [\n      { name: \"Aktivitas\", iconId: \"2:33\", label: \"Aktivitas\" },\n      { name: \"Trending\", iconId: \"2:36\", label: \"Trending\" },\n      { name: \"Top Up\", iconId: \"2:30\", label: \"Top Up\" },\n      { name: \"Pasar\", iconId: \"2:39\", label: \"Pasar\" },\n      { name: \"Profil\", iconId: \"2:42\", label: \"Profil\" }\n    ];\n\n    tabs.forEach(t => {\n      const tabItem = figma.createFrame();\n      tabItem.name = `Tab_${t.name}`;\n      tabItem.resize(68, 48);\n      tabItem.fills = [];\n      tabItem.layoutMode = \"VERTICAL\";\n      tabItem.primaryAxisAlignItems = \"CENTER\";\n      tabItem.counterAxisAlignItems = \"CENTER\";\n      tabItem.itemSpacing = 4;\n\n      const isActive = t.name === activeTab;\n      const activeColor = isActive ? GREEN_GAIN : TEXT_MUTED;\n\n      const iconInst = getInstance(t.iconId);\n      if (iconInst) {\n        tabItem.appendChild(iconInst);\n      }\n\n      const txt = figma.createText();\n      txt.fontName = { family: \"Roboto\", style: isActive ? \"Medium\" : \"Regular\" };\n      txt.characters = t.label;\n      txt.fontSize = 11;\n      txt.fills = [{ type: 'SOLID', color: activeColor }];\n      tabItem.appendChild(txt);\n\n      bar.appendChild(tabItem);\n    });\n\n    return bar;\n  }\n\n  // Create Frame 01_Aktivitas\n  const f1 = figma.createFrame();\n  f1.name = \"01_Aktivitas\";\n  f1.resize(375, 812);\n  f1.fills = [{ type: 'SOLID', color: BG_COLOR }];\n  f1.clipsContent = true;\n\n  // Header 01\n  const h1 = figma.createFrame();\n  h1.name = \"Header\";\n  h1.resize(375, 56);\n  h1.x = 0; h1.y = 44;\n  h1.fills = [];\n  h1.layoutMode = \"HORIZONTAL\";\n  h1.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  h1.counterAxisAlignItems = \"CENTER\";\n  h1.paddingLeft = 16; h1.paddingRight = 16;\n\n  const h1Title = figma.createText();\n  h1Title.fontName = { family: \"Roboto\", style: \"Bold\" };\n  h1Title.characters = \"Aktivitas\";\n  h1Title.fontSize = 24;\n  h1Title.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n  h1.appendChild(h1Title);\n\n  const h1Right = figma.createFrame();\n  h1Right.name = \"Header Actions\";\n  h1Right.fills = [];\n  h1Right.layoutMode = \"HORIZONTAL\";\n  h1Right.itemSpacing = 16;\n  const menuIcon = getInstance(\"2:4\");\n  const settingsIcon = getInstance(\"2:7\");\n  if (menuIcon) h1Right.appendChild(menuIcon);\n  if (settingsIcon) h1Right.appendChild(settingsIcon);\n  h1.appendChild(h1Right);\n\n  f1.appendChild(h1);\n\n  // Scroll Container for 01\n  const scroll1 = figma.createFrame();\n  scroll1.name = \"Content Scroll\";\n  scroll1.resize(375, 812 - 44 - 56 - 64);\n  scroll1.x = 0; scroll1.y = 100;\n  scroll1.fills = [];\n  scroll1.layoutMode = \"VERTICAL\";\n  scroll1.itemSpacing = 20;\n  scroll1.paddingLeft = 16; scroll1.paddingRight = 16; scroll1.paddingBottom = 20;\n\n  // Balance Card\n  const balCard = figma.createFrame();\n  balCard.name = \"Balance Card\";\n  balCard.resize(343, 136);\n  balCard.fills = [{ type: 'SOLID', color: CARD_BG }];\n  balCard.cornerRadius = 16;\n  balCard.layoutMode = \"VERTICAL\";\n  balCard.paddingLeft = 16; balCard.paddingRight = 16; balCard.paddingTop = 16; balCard.paddingBottom = 16;\n  balCard.itemSpacing = 12;\n\n  const balLabel = figma.createText();\n  balLabel.fontName = { family: \"Roboto\", style: \"Regular\" };\n  balLabel.characters = \"Dana Utama\";\n  balLabel.fontSize = 13;\n  balLabel.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  balCard.appendChild(balLabel);\n\n  const balRow = figma.createFrame();\n  balRow.name = \"Balance Value Row\";\n  balRow.fills = [];\n  balRow.layoutMode = \"HORIZONTAL\";\n  balRow.counterAxisAlignItems = \"BASELINE\";\n  balRow.ite