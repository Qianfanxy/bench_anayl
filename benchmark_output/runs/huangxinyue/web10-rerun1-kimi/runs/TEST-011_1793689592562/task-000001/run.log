',\n  styleGym: '01e1019ae778d42bda0cd0df5a56294884691c85',\n};\n\n// ===== Browse by Dress Style =====\nconst styleSection = figma.createFrame();\nstyleSection.name = 'Browse by Dress Style';\nstyleSection.layoutMode = 'VERTICAL';\nstyleSection.primaryAxisSizingMode = 'AUTO';\nstyleSection.counterAxisSizingMode = 'FIXED';\nstyleSection.paddingLeft = 64; styleSection.paddingRight = 64;\nstyleSection.paddingTop = 80; styleSection.paddingBottom = 76;\nstyleSection.itemSpacing = 64;\nstyleSection.cornerRadius = 40;\nstyleSection.fills = H.solid('#F0F0F0');\nstyleSection.layoutAlign = 'STRETCH';\nstyleSection.counterAxisAlignItems = 'CENTER';\n// Wrap with margin container\nconst styleWrap = figma.createFrame();\nstyleWrap.name = 'Browse by Dress Style Wrap';\nstyleWrap.fills = [];\nstyleWrap.layoutMode = 'VERTICAL';\nstyleWrap.paddingLeft = 100; styleWrap.paddingRight = 100;\nstyleWrap.paddingTop = 32; styleWrap.paddingBottom = 32;\nstyleWrap.counterAxisSizingMode = 'FIXED';\nstyleWrap.primaryAxisSizingMode = 'AUTO';\nstyleWrap.layoutAlign = 'STRETCH';\nstyleWrap.fills = H.solid('#FFFFFF');\n\nconst styleTitle = H.text('BROWSE BY DRESS STYLE', 48, 'Regular', '#000000', 'Archivo Black');\nstyleTitle.name = 'Section Title';\nstyleSection.appendChild(styleTitle);\n\nfunction styleTile(name, hash, w) {\n  const tile = figma.createFrame();\n  tile.name = 'Style / ' + name;\n  tile.resize(w, 289);\n  tile.cornerRadius = 20;\n  tile.fills = [{ type:'IMAGE', imageHash: hash, scaleMode:'FILL' }];\n  tile.clipsContent = true;\n  const lbl = H.text(name, 36, 'Bold', '#000000');\n  lbl.x = 24; lbl.y = 25;\n  tile.appendChild(lbl);\n  return tile;\n}\n\nconst row1 = figma.createFrame();\nrow1.name = 'Row 1';\nrow1.fills = [];\nrow1.layoutMode = 'HORIZONTAL';\nrow1.itemSpacing = 20;\nrow1.counterAxisSizingMode = 'AUTO';\nrow1.primaryAxisSizingMode = 'AUTO';\nrow1.layoutAlign = 'STRETCH';\nrow1.appendChild(styleTile('Casual', HASH.styleCasual, 408));\nrow1.appendChild(styleTile('Formal', HASH.styleFormal, 684));\nstyleSection.appendChild(row1);\n\nconst row2 = figma.createFrame();\nrow2.name = 'Row 2';\nrow2.fills = [];\nrow2.layoutMode = 'HORIZONTAL';\nrow2.itemSpacing = 20;\nrow2.counterAxisSizingMode = 'AUTO';\nrow2.primaryAxisSizingMode = 'AUTO';\nrow2.layoutAlign = 'STRETCH';\nrow2.appendChild(styleTile('Party', HASH.styleParty, 684));\nrow2.appendChild(styleTile('Gym', HASH.styleGym, 408));\nstyleSection.appendChild(row2);\n\nstyleWrap.appendChild(styleSection);\nhome.appendChild(styleWrap);\n\n// ===== Our Happy Customers =====\nconst reviewSec = figma.createFrame();\nreviewSec.name = 'Our Happy Customers';\nreviewSec.layoutMode = 'VERTICAL';\nreviewSec.primaryAxisSizingMode = 'AUTO';\nreviewSec.counterAxisSizingMode = 'FIXED';\nreviewSec.paddingLeft = 100; reviewSec.paddingRight = 100;\nreviewSec.paddingTop = 80; reviewSec.paddingBottom = 80;\nreviewSec.itemSpacing = 40;\nreviewSec.fills = H.solid('#FFFFFF');\nreviewSec.layoutAlign = 'STRETCH';\n\nconst reviewTop = figma.createFrame();\nreviewTop.name = 'Header';\nreviewTop.fills = [];\nreviewTop.layoutMode = 'HORIZONTAL';\nreviewTop.primaryAxisSizingMode = 'FIXED';\nreviewTop.counterAxisSizingMode = 'AUTO';\nreviewTop.primaryAxisAlignItems = 'SPACE_BETWEEN';\nreviewTop.counterAxisAlignItems = 'CENTER';\nreviewTop.layoutAlign = 'STRETCH';\nconst reviewTitle = H.text('OUR HAPPY CUSTOMERS', 48, 'Regular', '#000000', 'Archivo Black');\nreviewTop.appendChild(reviewTitle);\n\nconst arrows = figma.createFrame();\narrows.name = 'Arrows';\narrows.fills = [];\narrows.layoutMode = 'HORIZONTAL';\narrows.itemSpacing = 16;\narrows.counterAxisSizingMode = 'AUTO';\narrows.primaryAxisSizingMode = 'AUTO';\nconst aL = arrowLeft.createInstance();\naL.resize(24, 24);\narrows.appendChild(aL);\nconst aR = arrowRight.createInstance();\naR.resize(24, 24);\narrows.appendChild(aR);\nreviewTop.appendChild(arrows);\nreviewSec.appendChild(reviewTop);\n\n// Review cards\nconst reviewComp = await figma.getNodeByIdAsync('13:26');\nconst reviewRow = figma.createFrame();\nreviewRow.name = 'Reviews';\nreviewRow.fills = [];\nreviewRow.layoutMode = 'HORIZONTAL';\nreviewRow.itemSpacing = 20;\nreviewRow.counterAxisSizingMode = 'AUTO';\nreviewRow.primaryAxisSizingMode = 'AUTO';\nreviewRow.layoutAlign = 'STRETCH';\nreviewRow.primaryAxisAlignItems = 'SPACE_BETWEEN';\n\nfunction reviewCard(name, quote) {\n  const r = reviewComp.createInstance();\n  r.name = 'Review / ' + name;\n  const nameT = r.findOne(n => n.name === 'Name' && n.type === 'FRAME').findOne(n => n.type === 'TEXT');\n  nameT.characters = name;\n  const quoteT = r.findOne(n => n.name === 'Quote');\n  quoteT.characters = '\"' + quote + '\"';\n  // Hide \"More\" for home cards? Brief requires more icon on product page; home review cards don't require. Keep it for consistency.\n  return r;\n}\nreviewRow.appendChild(reviewCard('Sarah M.', \"I'm blown away by the quality and style of the clothes I received from Shop.co. From casual wear to elegant dresses, every piece I've bought has exceeded my expectations.\"));\nreviewRow.appendChild(reviewCard('Alex K.', \"Finding clothes that align with my personal style used to be a challenge until I discovered Shop.co. The range of options they offer is truly remarkable, catering to a variety of tastes and occasions.\"));\nreviewRow.appendChild(reviewCard('James L.', \"As someone who's always on the lookout for unique fashion pieces, I'm thrilled to have stumbled upon Shop.co. The selection of clothes is not only diverse but also on-point with the latest trends.\"));\nreviewSec.appendChild(reviewRow);\n\nhome.appendChild(reviewSec);\n\nreturn { styleWrapId: styleWrap.id, reviewSecId: reviewSec.id };\n","description":"Build Browse by Dress Style and Happy Customers sections","fileKey":"5S6WFXEo4QEfJTtE7MFltz"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"c5b3498c-81e1-408a-9e23-797293d6b873","uuid":"02488871-810e-4908-9615-840b2a7fcdcc","timestamp":"2026-11-03T07:21:53.497Z","tool_use_meta":[{"id":"mcp__figma__use_figma_30_9ec9415b","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
