onst f = figma.createFrame(); f.name = name; f.fills = []; f.clipsContent = false; return f; }\nfunction AL(f, o = {}) {\n  f.layoutMode = o.dir || 'VERTICAL';\n  f.itemSpacing = o.gap || 0;\n  const p = o.pad || [0, 0, 0, 0];\n  f.paddingTop = p[0]; f.paddingRight = p[1]; f.paddingBottom = p[2]; f.paddingLeft = p[3];\n  f.primaryAxisAlignItems = o.align || 'MIN';\n  f.counterAxisAlignItems = o.cross || 'MIN';\n  f.primaryAxisSizingMode = 'AUTO'; f.counterAxisSizingMode = 'AUTO';\n  return f;\n}\nfunction solid(n, c) { n.fills = [{ type: 'SOLID', color: c }]; }\nasync function inst(id) { const c = await figma.getNodeByIdAsync(id); return c.createInstance(); }\nasync function icon(id, color, size) {\n  const i = await inst(id);\n  i.rescale(size / Math.max(i.width, i.height));\n  i.findAll(n => n.type === 'VECTOR' || n.type === 'UNION' || n.type === 'BOOLEAN_OPERATION').forEach(v => { v.fills = [{ type: 'SOLID', color }]; });\n  return i;\n}\n\n// ---- Library shell ----\nlet lib = F('· Component Library');\nlib.x = -1760; lib.y = 0;\npage.appendChild(lib);\nAL(lib, { dir: 'VERTICAL', gap: 56, pad: [64, 64, 64, 64] });\nsolid(lib, { r: 0.962, g: 0.953, b: 0.937 });\nlib.counterAxisSizingMode = 'FIXED'; lib.resize(1560, 100);\nlib.appendChild(T('Component Library · Northgate Homes', { size: 32, style: 'Bold' }));\nlib.appendChild(T('Reusable components and states powering 01_Home and 02_Property. Brand #FFAC12 · DM Sans.', { size: 16, style: MED, color: C.body }));\n\nfunction group(name) {\n  const g = F(name); AL(g, { dir: 'VERTICAL', gap: 20 });\n  g.appendChild(T(name, { size: 22, style: 'Bold' }));\n  lib.appendChild(g); g.layoutSizingHorizontal = 'FILL';\n  return g;\n}\nfunction row(g, gap = 24) { const r = F('row'); AL(r, { dir: 'HORIZONTAL', gap, cross: 'CENTER' }); g.appendChild(r); return r; }\nfunction caption(g, s) { g.appendChild(T(s, { size: 13, style: MED, color: C.muted })); }\n\n// ---- Buttons ----\nconst givenBtn = await figma.getNodeByIdAsync('1:22');\nconst gBtn = group('Button');\nconst rBtn = row(gBtn);\n\nconst bDefault = givenBtn.createInstance();\nrBtn.appendChild(bDefault);\n\nconst bHover = givenBtn.clone(); bHover.name = 'Button / Primary / Hover'; solid(bHover, C.amberD); rBtn.appendChild(bHover);\n\nconst bIcon = givenBtn.clone(); bIcon.name = 'Button / Primary / Icon';\nbIcon.primaryAxisSizingMode = 'AUTO'; bIcon.counterAxisSizingMode = 'FIXED';\nbIcon.paddingLeft = 28; bIcon.paddingRight = 28; bIcon.itemSpacing = 12;\nbIcon.primaryAxisAlignItems = 'CENTER'; bIcon.counterAxisAlignItems = 'CENTER';\nbIcon.findOne(n => n.type === 'TEXT').characters = 'Button';\nbIcon.appendChild(await icon('3:3', { r: 0.06, g: 0.06, b: 0.08 }, 16));\nrBtn.appendChild(bIcon);\n\nconst bDark = givenBtn.clone(); bDark.name = 'Button / Dark'; solid(bDark, C.ink);\nbDark.findOne(n => n.type === 'TEXT').fills = [{ type: 'SOLID', color: C.white }]; rBtn.appendChild(bDark);\n\nconst bDarkHover = givenBtn.clone(); bDarkHover.name = 'Button / Dark / Hover'; solid(bDarkHover, { r: 0.17, g: 0.17, b: 0.2 });\nbDarkHover.findOne(n => n.type === 'TEXT').fills = [{ type: 'SOLID', color: C.white }]; rBtn.appendChild(bDarkHover);\ncaption(gBtn, 'Default (given) · Hover · Icon · Dark · Dark hover');\n\n// Circle buttons (carousel prev/next)\nconst gCirc = group('Button / Circle');\nconst rCirc = row(gCirc);\nfunction circleBtn(name, hover) {\n  const c = figma.createComponent(); c.name = name; c.resize(48, 48);\n  c.layoutMode = 'HORIZONTAL'; c.primaryAxisAlignItems = 'CENTER'; c.counterAxisAlignItems = 'CENTER';\n  c.primaryAxisSizingMode = 'FIXED'; c.counterAxisSizingMode = 'FIXED';\n  c.cornerRadius = 999;\n  if (hover) { solid(c, C.amber); c.strokes = []; }\n  else { solid(c, C.white); c.strokes = [{ type: 'SOLID', color: C.border }]; c.strokeWeight = 1; }\n  return c;\n}\nconst circ = circleBtn('Button / Circle', false);\ncirc.appendChild(await icon('3:11', C.ink, 20));\nconst circHover = circleBtn('Button / Circle / Hover', true);\ncircHover.appendChild(await icon('3:11', { r: 0.06, g: 0.06, b: 0.08 }, 20));\nrCirc.appendChild(circ); rCirc.appendChild(circHover);\ncaption(gCirc, 'Icon inside is swappable (chevron-left for previous).');\n\n// ---- Nav items ----\nconst gNav = group('Nav / Item');\nconst rNav = row(gNav, 40);\nconst navDef = figma.createComponent(); navDef.name = 'Nav / Item';\nAL(navDef, { dir: 'HORIZONTAL', pad: [8, 2, 8, 2] });\nnavDef.appendChild(T('Buy', { size: 16, style: MED, color: C.ink }));\nconst navHover = figma.createComponent(); navHover.name = 'Nav / Item / Hover';\nAL(navHover, { dir: 'HORIZONTAL', pad: [8, 2, 8, 2] });\nnavHover.appendChild(T('Buy', { size: 16, style: MED, color: C.amberD }));\nrNav.appendChild(navDef); rNav.appendChild(navHover);\ncaption(gNav, 'Default · Hover (no item is current on either frame).');\n\n// ---- Link with arrow ----\nconst gLink = group('Link / Arrow');\nconst rLink = row(gLink, 40);\nasync function arrowLink(name, txtColor) {\n  const l = figma.createComponent(); l.name = name;\n  AL(l, { dir: 'HORIZONTAL', gap: 10, cross: 'CENTER' });\n  l.appendChild(T('Learn more', { size: 16, style: 'Bold', color: txtColor }));\n  l.appendChild(await icon('3:3', C.amber, 16));\n  return l;\n}\nrLink.appendChild(await arrowLink('Link / Arrow', C.ink));\nrLink.appendChild(await arrowLink('Link / Arrow / Hover', C.amberD));\nconst darkChip = F('on-dark'); solid(darkChip, C.dark); darkChip.cornerRadius = 12;\nAL(darkChip, { dir: 'HORIZONTAL', pad: [16, 20, 16, 20], align: 'CENTER', cross: 'CENTER' });\ndarkChip.appendChild(await arrowLink('Link / Arrow / OnDark', C.amber));\nrLink.appendChild(darkChip);\ncaption(gLink, 'Default · Hover · On dark.');\n\n// ---- Logo ----\nconst gLogo = group('Logo');\nconst rLogo = row(gLogo, 40);\nasync function logo(name, color) {\n  const l = figma.createComponent(); l.name = name;\n  AL(l, { dir: 'HORIZONTAL', gap: 12, cross: 'CENTER' });\n  const m = await inst('3:16'); m.rescale(30 / m.height); l.appendChild(m);\n  l.appendChild(T('NORTHGATE', { size: 18, style: 'Bold', color, ls: 12 }));\n  return l;\n}\nrLogo.appendChild(await logo('Logo / Dark', C.ink));\nconst chip2 = F('on-dark'); solid(chip2, C.dark); chip2.cornerRadius = 12;\nAL(chip2, { dir: 'HORIZONTAL', pad: [16, 20, 16, 20], align: 'CENTER', cross: 'CENTER' });\nchip2.appendChild(await logo('Logo / Light', C.white));\nrLogo.appendChild(chip2);\ncaption(gLogo, 'Logo_Mark + NORTHGATE wordmark in DM Sans Bold.');\n\n// ---- Social chips ----\nconst gSoc = group('Social / Chip');\nconst rSoc = row(gSoc);\nconst chipDarkBg = F('on-dark'); solid(chipDarkBg, C.dark); chipDarkBg.cornerRadius = 12;\nAL(chipDarkBg, { dir: 'HORIZONTAL', pad: [16, 20, 16, 20], gap: 12, align: 'CENTER', cross: 'CENTER' });\nconst socComp = figma.createComponent(); socComp.name = 'Social / Chip';\nsocComp.resize(40, 40); socComp.layoutMode = 'HORIZONTAL';\nsocComp.primaryAxisAlignItems = 'CENTER'; socComp.counterAxisAlignItems = 'CENTER';\nsocComp.primaryAxisSizingMode = 'FIXED'; socComp.counterAxisSizingMode = 'FIXED';\nsocComp.cornerRadius = 999; solid(socComp, C.white);\nsocComp.appendChild(await inst('3:14'));\nrSoc.appendChild(socComp);\nconst sInst = async id => { const i = socComp.createInstance(); i.findOne(n => n.type === 'INSTANCE').swapComponent(await figma.getNodeByIdAsync(id)); return i; };\nchipDarkBg.appendChild(socComp.createInstance());\nchipDarkBg.appendChild(await sInst('3:15'));\nchipDarkBg.appendChild(await sInst('3:17'));\nrSoc.appendChild(chipDarkBg);\ncaption(gSoc, 'Facebook (default) — swap the nested mark for Instagram / Twitter. Marks kept unaltered.');\n\n// dump input strokes of given Text Field for next call\nconst inputNode = await figma.getNodeByIdAsync('1:27');\nconst inputInfo = { strokes: inputNode.strokes, strokeWeight: inputNode.strokeWeight, effects: inputNode.effects, labelSize: (await figma.getNodeByIdAsync('1:26')).fontSize, phSize: (await figma.getNodeByIdAsync('1:28')).fontSize };\n\nreturn JSON.stringify({ dmStyles, libId: lib.id, inputInfo });\n","description":"Create component library shell with buttons, nav, links, logo, social chips"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"8420bd2b-08e1-4650-9759-ee0744cf2f7f","uuid":"545be9a5-f2ba-4638-97e8-9d3723dd871e","timestamp":"2026-11-01T23:47:39.746Z","tool_use_meta":[{"id":"mcp__figma__use_figma_9_2d1fe709","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
