;}\n}\nconst INK={r:24/255,g:23/255,b:23/255};\nfunction recolorTree(node){\n  const all=[node,...node.findAll(()=>true)];\n  for(const d of all){\n    if(\"fills\" in d && Array.isArray(d.fills) && d.fills.length){\n      d.fills=d.fills.map(p=>p.type===\"SOLID\"?{...p,color:INK}:p);\n    }\n    if(\"strokes\" in d && Array.isArray(d.strokes) && d.strokes.length){\n      d.strokes=d.strokes.map(p=>p.type===\"SOLID\"?{...p,color:INK}:p);\n    }\n  }\n}\nconst out={loaded,failed};\nasync function resolveMaster(id){\n  const n=await figma.getNodeByIdAsync(id);\n  if(!n)return null;\n  return n.type===\"INSTANCE\"?n.mainComponent:n;\n}\nconst specs=[\n {key:\"photo\",id:\"2:5\",x:0,y:1900,name:\"Photo_Profile\"},\n {key:\"down\",id:\"2:2\",x:280,y:1900,name:\"Icon_Arrow_Down\"},\n {key:\"right\",id:\"2:3\",x:340,y:1900,name:\"Icon_Arrow_Right\"},\n {key:\"upright\",id:\"2:4\",x:400,y:1900,name:\"Icon_Arrow_Up_Right\"}\n];\nfor(const s of specs){\n  const m=await resolveMaster(s.id);\n  if(!m){out[s.key]={error:\"missing \"+s.id};continue;}\n  const c=m.clone();\n  ws.appendChild(c);\n  c.name=s.name;\n  c.x=s.x;c.y=s.y;\n  if(s.key!==\"photo\") recolorTree(c);\n  out[s.key]={id:c.id,type:c.type,w:c.width,h:c.height};\n}\n// section title\nconst title=figma.createText();\ntitle.fontName={family:\"DM Sans\",style:\"Bold\"};\ntitle.characters=\"Components · Deniz Arslan portfolio\";\ntitle.fontSize=20; title.fills=[{type:\"SOLID\",color:INK}];\ntitle.x=0;title.y=0;\nout.titleId=title.id;\nJSON.stringify(out)\n```\n\nWait — figma.createText() requires a loaded font BEFORE setting characters; default font is Inter Regular which needs loading? createText defaults to Inter Regular; setting characters requires the current fontName loaded. I loaded DM Sans but not Inter. Set fontName first (after loading DM Sans), then characters — allowed since DM Sans loaded. But createText itself doesn't require font load until you set characters or change props? Changing fontName requires that font loaded (done). Then characters uses that font. OK. But to be safe I'll also load Inter Regular? Not needed if I always set fontName before characters.\n\nHmm, one gotcha: t.fontName = {family:\"DM Sans\", style:\"Bold\"} — must have loaded that exact style. Done.\n\nPhoto position: photo at (0,1900) — wait I planned photo x0? Earlier I said Photo (0,1900) then icons at 280.. yes.\n\nAlso workspace page id \"4:2\" — it's a PageNode. setCurrentPageAsync(ws) fine.\n\nAfter Call A, Call B (Nav/Text links). Let me draft Call B fully:\n\n```js\nconst ws=await figma.getNodeByIdAsync(\"4:2\");\nawait figma.setCurrentPageAsync(ws);\nfor(const s of [\"Regular\",\"Medium\",\"Bold\"]) await figma.loadFontAsync({family:\"DM Sans\",style:s});\nconst C={\n ink:{r:24/255,g:23/255,b:23/255},\n accent:{r:36/255,g:41/255,b:175/255},\n secondary:{r:111/255,g:107/255,b:102/255}\n};\nfunction solid(c,o=1){return {type:\"SOLID\",color:c,opacity:o};}\nfunction mkText(chars,size,style,color,opts={}){\n  const t=figma.createText();\n  t.fontName={family:\"DM Sans\",style};\n  t.characters=chars;\n  t.fontSize=size;\n  t.lineHeight={value:opts.lh||Math.round(size*1.4),unit:\"PIXELS\"};\n  if(opts.ls!==undefined)t.letterSpacing={value:opts.ls,unit:\"PERCENT\"};\n  if(opts.deco)t.textDecoration=opts.deco;\n  t.fills=[solid(color)];\n  return t;\n}\n// --- Nav Link variants\nconst navVars={};\nfor(const cur of [\"No\",\"Yes\"]){\n  for(const hov of [\"Default\",\"Hover\"]){\n    const comp=figma.createComponent();\n    comp.name=`Current=${cur}, State=${hov}`;\n    comp.layoutMode=\"HORIZONTAL\";\n    comp.primaryAxisSizingMode=\"AUTO\";\n    comp.counterAxisSizingMode=\"AUTO\";\n    comp.paddingTop=6;comp.paddingBottom=6;\n    comp.fills=[];\n    const hover=hov===\"Hover\";\n    const t=mkText(\"Work\",16,\"Medium\",(cur===\"Yes\"||hover)?C.accent:C.secondary,{lh:24,deco:hover?\"UNDERLINE\":null});\n    comp.appendChild(t);\n    navVars[`${cur}_${hov}`]=comp;\n  }\n}\n// position\nnavVars.No_Default.x=0;navVars.No_Default.y=80;\nnavVars.No_Hover.x=160;... y=80\nnavVars.Yes_Default.x=320;navVars.Yes_Hover.x=480;\nconst navSet=figma.combineAsVariants(Object.values(navVars),ws);\nnavSet.name=\"Nav Link\";\nnavSet.x=0;navSet.y=80;\n// hover wiring\nnavVars.No_Default.reactions=[{trigger:{type:\"MouseEnter\"},action:{type:\"CHANGE_TO\",destinationId:navVars.No_Hover.id}}];\nnavVars.No_Hover.reactions=[{trigger:{type:\"MouseLeave\"},action:{type:\"CHANGE_TO\",destinationId:navVars.No_Default.id}}];\nnavVars.Yes_Default.reactions=[{trigger:{type:\"MouseEnter\"},action:{type:\"CHANGE_TO\",destinationId:navVars.Yes_Hover.id}}];\nnavVars.Yes_Hover.reactions=[{trigger:{type:\"MouseLeave\"},action:{type:\"CHANGE_TO\",destinationId:navVars.Yes_Default.id}}];\n```\n\nPositions before combine: I set x/y then combine; combine preserves relative positions (I think it uses current positions). After combine set x,y again.\n\nText Link variants:\n\n```js\nconst iconMasters={};\niconMasters.ArrowRight=await figma.getNodeByIdAsync(\"<rightCloneId>\"); // from call A output\niconMasters.ArrowUpRight=await figma.getNodeByIdAsync(\"<uprightCloneId>\");\nconst tlVars={};\nfor(const ic of [\"None\",\"ArrowRight\",\"ArrowUpRight\"]){\n  for(const st of [\"Default\",\"Hover\"]){\n    const comp=figma.createComponent();\n    comp.name=`Icon=${ic}, State=${st}`;\n    comp.layoutMode=\"HORIZONTAL\";\n    comp.primaryAxisSizingMode=\"AUTO\";comp.counterAxisSizingMode=\"AUTO\";\n    comp.counterAxisAlignItems=\"CENTER\";\n    comp.itemSpacing=8;\n    comp.paddingLeft=2;comp.paddingRight=2;comp.paddingTop=2;comp.paddingBottom=2;\n    comp.fills=[];\n    const hover=st===\"Hover\";\n    const t=mkText(\"Link label\",16,\"Medium\",C.accent,{lh:24,deco:hover?\"UNDERLINE\":null});\n    comp.appendChild(t);\n    if(ic!==\"None\"){\n      const inst=iconMasters[ic].createInstance();\n      inst.rescale(16/24);\n      // recolor vector to accent\n      for(const d of [inst,...inst.findAll(()=>true)]){\n        if(\"fills\" in d && Array.isArray(d.fills) && d.fills.length){\n          d.fills=d.fills.map(p=>p.type===\"SOLID\"?{...p,color:C.accent}:p);\n        }\n      }\n      comp.appendChild(inst);\n    }\n    tlVars[`${ic}_${st}`]=comp;\n  }\n}\npositions x 0..1000 step 200, y 200; combine → \"Text Link\"; wire hover per icon pair.\n```\n\nrescale on instance: rescale(scale) — available on most nodes? BaseNodeMixin? rescale is on LayoutMixin? I believe node.rescale(scale) exists (like scale). Hmm — actually the Plugin API has `rescale()` on... I recall `node.rescale(scale)` was added (RescaleMixin?) Hmm. There's definitely `figma.flatten`, `resize`, `resizeWithoutConstraints`. Rescale: yes, `rescale(scale: number)` exists on nodes implementing LayoutMixin (added a while ago). If it fails, fallback: inst.resize(16,16) — child vector constraints might not scale; fallback: set inst.resize then also resize inner vector. I'll try/catch rescale → fallback resize + child resize.\n\nActually simpler: keep icons at 24 default inside links but with 16px text that's big. Rescale attempt with fallback:\n\n```js\ntry{inst.rescale(16/24);}catch(e){inst.resize(16,16);const v=inst.findOne(n=>n.type===\"VECTOR\");if(v){try{v.resize(12,12);}catch(_){}}}\n```\nVector inside 24 frame at x6 y5 w12 h14 (arrow down). Rescale handles all. Fine.\n\nOutput IDs of sets.\n\nCall C (Header/Footer): need nav variant IDs (from set children) — I'll re-find via set children names: navSet.children find name startsWith. Or store IDs from Call B output. I'll capture from output JSON.\n\nHeader code:\n\n```js\nconst navYesDefault = await figma.getNodeByIdAsync(\"<id>\");\nconst navNoDefault = ...\nconst header=figma.createComponent();\nheader.name=\"Header\";\nheader.layoutMode=\"VERTICAL\";\nheader.primaryAxisSizingMode=\"AUTO\";\nheader.counterAxisSizingMode=\"FIXED\";\nheader.resizeWithoutConstraints(1440,89); // width fixed; with counter FIXED, resize sets width\nheader.fills=[];\nheader.itemSpacing=0;\nconst row=figma.createFrame();\nrow.name=\"Bar\";\nrow.layoutMode=\"HORIZONTAL\";\nrow.primaryAxisSizingMode=\"FIXED\";\nrow.counterAxisSizingMode=\"FIXED\";\nrow.resize(1440,88);\nrow.primaryAxisAlignItems=\"SPACE_BETWEEN\";\nrow.counterAxisAlignItems=\"CENTER\";\nrow.paddingLeft=80;row.paddingRight=80;\nrow.fills=[];\nrow.layoutAlign=\"STRETCH\";\nheader.appendChild(row);\nconst logo=mkText(\"da.\",28,\"Bold\",C.ink,{lh:36});\nrow.appendChild(logo);\nconst nav=figma.createFrame();\nnav.name=\"Nav\";\nnav.layoutMode=\"HORIZONTAL\";\nnav.primaryAxisSizingMode=\"AUTO\";nav.counterAxisSizingMode=\"AUTO\";\nnav.itemSpacing=40;nav.fills=[];\nrow.appendChild(nav);\nconst items=[[\"Work\",\"No\"],[\"About\",\"No\"],[\"Playground\",\"No\"],[\"Contact\",\"No\"]];\nfor(const [label] of items){\n  const inst=navNoDefault.createInstance();\n  inst.setProperties({Current: cur});\n  override text characters=label\n  nav.appendChild(inst);\n}\nconst line=figma.createRectangle();\nline.resize(1440,1);line.fills=[solid(C.divider)];line.layoutAlign=\"STRETCH\";\nheader.appendChild(line);\nheader.x=0;header.y=320;\n```\n\nInstance text override: const t=inst.findOne(n=>n.type===\"TEXT\"); t.characters=label; (font loaded ✓).\n\nWait — setProperties on instance of a variant: {\"Current\":\"Yes\"} — allowed.\n\nAlso instance creation from variant master: navYesDefault.createInstance() — creates instance with that variant.\n\nFooter:\n\n```js\nconst footer=figma.createComponent();\nfooter.name=\"Footer\";\nfooter.layoutMode=\"VERTICAL\";\nfooter.primaryAxisSizingMode=\"AUTO\";\nfooter.counterAxisSizingMode=\"FIXED\";\nfooter.resizeWithoutConstraints(1440,100);? height hug → primaryAxis AUTO with vertical: primary axis vertical = height AUTO; counter = width FIXED 1440. resizeWithoutConstraints(1440, 10) then AUTO adjusts.\nActually with layoutMode VERTICAL: primaryAxisSizingMode AUTO → height hugs; counterAxisSizingMode FIXED → width fixed: set via resize(1440, anything).\nchildren: line rect stretch h1 fill divider; row HORIZONTAL stretch padding 28 80 SPACE_BETWEEN counterAlign CENTER fills none: left text; right nav gap 40 with 3 TextLink instances (Icon=None) text overrides \"Artstation\",\"LinkedIn\",\"Twitter\", fontSize 14 override (t.fontSize=14; lineHeight 20).\n```\n\nfontSize override on instance text child allowed ✓.\n\nCall D: ImagePlaceholder + SkillList + ProjectBlock set.\n\nSkillList builder function makeSkillList(titleText, rows) — but as COMPONENT with default texts; instances override. Build one component \"Skill List\" with default title \"Main Software\" and 6 default rows = software rows. Instance 2 overrides all texts to skills rows.\n\nRows: RowWrap frame VERTICAL padding 14 0, child text 16 Regular ink lh 26 stretch; Div rect stretch h1 fill divider.\n\nChildren: TitleWrap(padding bottom 20, child title 12 Medium ls 8% muted) → then Row1, Div, Row2, Div, ..., Row6.\n\nSet title style: fontSize 12, ls 8%, color muted, characters \"Main Software\" — uppercase? keep as-is.\n\nHmm actually let me add slight letter spacing 4% and keep case as data. OK.\n\nProject Block builder(compName, hasLink):\n```js\nfunction buildProjectBlock(name, withLink){\n const comp=figma.createComponent();\n comp.name=name;\n comp.layoutMode=\"HORIZONTAL\";\n comp.itemSpacing=64;\n comp.primaryAxisSizingMode=\"AUTO\";\n comp.counterAxisSizingMode=\"AUTO\";\n comp.counterAxisAlignItems=\"MIN\";\n comp.fills=[];\n const col=figma.createFrame();\n col.name=\"Content\";\n col.layoutMode=\"VERTICAL\";\n col.primaryAxisSizingMode=\"AUTO\";\n col.counterAxisSizingMode=\"FIXED\";\n col.resizeWithoutConstraints? width: col.resize(556, 100) then AUTO height: with counter FIXED width 556: resize(556, whatever) then primary AUTO → height hugs.\n col.itemSpacing=28; col.fills=[];\n comp.appendChild(col);\n // name row\n const row=figma.createFrame(); row.name=\"Title\";\n row.layoutMode=\"HORIZONTAL\"; row.primaryAxisSizingMode=\"AUTO\"; row.counterAxisSizingMode=\"AUTO\";\n row.counterAxisAlignItems=\"BASELINE\"; row.itemSpacing=12; row.fills=[];\n col.appendChild(row);\n row.appendChild(mkText(\"01\",64,\"Bold\",{r:221/255,g:217/255,b:212/255},{lh:64}));\n row.appendChild(mkText(\"/\",26,\"Medium\",C.muted,{lh:34}));\n row.appendChild(mkText(\"Goblin Bust\",26,\"Medium\",C.ink,{lh:34}));\n // desc\n const desc=mkText(\"Goblin concept digital sculpture with human-like skin. Learned a lot of quick tips and look development.\",16,\"Regular\",C.secondary,{lh:26});\n desc.textAutoResize=\"HEIGHT\"; desc.layoutAlign=\"STRETCH\";\n col.appendChild(desc);\n // tools\n const tools=mkText(\"Sculpted in ZBrush, retopologized and UV-mapped in Maya, textured in Mari, rendered with Arnold.\",14,\"Regular\",C.muted,{lh:22});\n tools.textAutoResize=\"HEIGHT\"; tools.layoutAlign=\"STRETCH\"; tools.name=\"Tools\";\n col.appendChild(tools);\n // CTA\n if(withLink){\n   const link=tlVars.ArrowUpRight_Default.createInstance(); // need id\n   col.appendChild(link);\n } else {\n   const badge=figma.createFrame();\n   badge.layoutMode=\"HORIZONTAL\"; badge.primaryAxisSizingMode=\"AUTO\"; badge.counterAxisSizingMode=\"AUTO\";\n   badge.paddingLeft=16;badge.paddingRight=16;badge.paddingTop=8;badge.paddingBottom=8;\n   badge.cornerRadius=999; badge.fills=[solid(C.subtle)];\n   badge.appendChild(mkText(\"Project WIP\",12,\"Medium\",C.secondary,{lh:16,ls:4}));\n   col.appendChild(badge);\n }\n // image\n const ph=placeholderComp.createInstance();\n comp.appendChild(ph);\n return comp;\n}\n```\nWait mkText colors need C entries; ghost color #DDD9D4 = {221,217,212}.\n\nHmm \"counterAxisAlignItems MIN\" — image top aligned with number; visually maybe CENTER nicer (image 440 tall, text col ~64+28+78+28+44+28+24=~294) → center creates balanced block. I'll use \"CENTER\"? With varying text heights across projects, center alignment shifts name position per block — misaligned rhythm. Top (MIN) keeps name row aligned across block