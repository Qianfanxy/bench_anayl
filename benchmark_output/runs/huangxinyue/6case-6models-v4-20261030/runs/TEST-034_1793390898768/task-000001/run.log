{"type":"assistant","message":{"id":"chatcmpl-202610302011429627985518268d9d6Pgk5SQ34","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_bcbfd5ad7aa04464acca2b80389a03e7","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  const workspacePage = figma.root.children.find(p => p.name.includes(\"03 · Workspace\"));\n  await figma.setCurrentPageAsync(workspacePage);\n\n  await figma.loadFontAsync({ family: \"Nunito\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Nunito\", style: \"SemiBold\" });\n  await figma.loadFontAsync({ family: \"Nunito\", style: \"Bold\" });\n  await figma.loadFontAsync({ family: \"Nunito\", style: \"ExtraBold\" });\n\n  const getOrig = async (id) => await figma.getNodeByIdAsync(id);\n\n  const brandPrimaryColor = { r: 1.0, g: 0.643, b: 0.318 };\n  const brandDarkColor = { r: 0.165, g: 0.118, b: 0.078 };\n\n  const createFrame = (name, x, y) => {\n    const f = figma.createFrame();\n    f.name = name;\n    f.resize(375, 812);\n    f.x = x;\n    f.y = y;\n    f.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n    return f;\n  };\n\n  const addShell = async (frame) => {\n    const statusBarOrig = await getOrig(\"3:32\");\n    const homeIndicatorOrig = await getOrig(\"3:42\");\n    \n    if (statusBarOrig) {\n      const sb = statusBarOrig.createInstance();\n      sb.x = 0;\n      sb.y = 0;\n      frame.appendChild(sb);\n    }\n    if (homeIndicatorOrig) {\n      const hi = homeIndicatorOrig.createInstance();\n      hi.x = 0;\n      hi.y = 812 - 34;\n      frame.appendChild(hi);\n    }\n  };\n\n  // Helper to create product card\n  // For Recommended (horizontal/vertical) or Hottest\n  // Let's create Hottest Card (Vertical Card: Photo top, title, price row with Naira + heart + add button)\n  const createProductCard = async ({ name, price, photoId, isFav = false, bgHex = \"#FFFFFF\" }) => {\n    const card = figma.createFrame();\n    card.name = `Card_${name}`;\n    card.resize(152, 183);\n    card.cornerRadius = 16;\n    card.fills = [{ type: 'SOLID', color: { r: 0.98, g: 0.98, b: 0.98 } }]; // light grey/cream background\n    \n    // Heart fav toggle icon top right\n    const favIconOrig = await getOrig(\"2:78\");\n    if (favIconOrig) {\n      const fav = favIconOrig.createInstance();\n      fav.x = 116;\n      fav.y = 12;\n      card.appendChild(fav);\n    }\n\n    // Photo center top\n    const photoOrig = await getOrig(photoId);\n    if (photoOrig) {\n      const photo = photoOrig.createInstance();\n      // scale or fit photo\n      photo.x = (152 - photo.width) / 2;\n      photo.y = 20;\n      card.appendChild(photo);\n    }\n\n    // Name text\n    const nameText = figma.createText();\n    nameText.characters = name;\n    nameText.fontName = { family: \"Nunito\", style: \"SemiBold\" };\n    nameText.fontSize = 14;\n    nameText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n    nameText.x = 12;\n    nameText.y = 115;\n    card.appendChild(nameText);\n\n    // Price row (Naira icon + text + Add button)\n    const nairaOrig = await getOrig(\"2:83\");\n    if (nairaOrig) {\n      const naira = nairaOrig.createInstance();\n      naira.x = 12;\n      naira.y = 145;\n      card.appendChild(naira);\n    }\n\n    const priceText = figma.createText();\n    priceText.characters = price;\n    priceText.fontName = { family: \"Nunito\", style: \"Bold\" };\n    priceText.fontSize = 14;\n    priceText.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    priceText.x = 28;\n    priceText.y = 145;\n    card.appendChild(priceText);\n\n    // Add icon / button bottom right\n    const addOrig = await getOrig(\"2:89\");\n    if (addOrig) {\n      const addBtn = addOrig.createInstance();\n      addBtn.x = 116;\n      addBtn.y = 142;\n      card.appendChild(addBtn);\n    }\n\n    return card;\n  };\n\n  // --- Frame 04_Home ---\n  const frameHome = createFrame(\"04_Home\", 1275, 0);\n  await addShell(frameHome);\n\n  // Top bar: Menu entry + My Basket entry\n  const menuOrig = await getOrig(\"2:59\");\n  if (menuOrig) {\n    const menu = menuOrig.createInstance();\n    menu.x = 24;\n    menu.y = 56;\n    frameHome.appendChild(menu);\n  }\n\n  // My basket entry top right\n  const basketOrig = await getOrig(\"2:94\");\n  if (basketOrig) {\n    const basketContainer = figma.createFrame();\n    basketContainer.name = \"My basket entry\";\n    basketContainer.resize(48, 48);\n    basketContainer.x = 303;\n    basketContainer.y = 50;\n    basketContainer.fills = [];\n    \n    const basketIcon = basketOrig.createInstance();\n    basketIcon.x = 10;\n    basketIcon.y = 10;\n    basketContainer.appendChild(basketIcon);\n\n    const bText = figma.createText();\n    bText.characters = \"My basket\";\n    bText.fontName = { family: \"Nunito\", style: \"Regular\" };\n    bText.fontSize = 10;\n    bText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n    bText.x = -6;\n    bText.y = 36;\n    basketContainer.appendChild(bText);\n\n    frameHome.appendChild(basketContainer);\n  }\n\n  // Greeting text\n  const greetingText = figma.createText();\n  greetingText.characters = \"Hello Tony, What fruit salad combo do you want today?\";\n  greetingText.fontName = { family: \"Nunito\", style: \"Bold\" };\n  greetingText.fontSize = 18;\n  greetingText.fills = [{ type: 'SOLID', color: brandDarkColor }];\n  greetingText.resize(250, 52);\n  greetingText.x = 24;\n  greetingText.y = 110;\n  frameHome.appendChild(greetingText);\n\n  // Search & filter row\n  const searchBar = figma.createFrame();\n  searchBar.name = \"Search Bar\";\n  searchBar.resize(270, 48);\n  searchBar.x = 24;\n  searchBar.y = 180;\n  searchBar.cornerRadius = 12;\n  searchBar.fills = [{ type: 'SOLID', color: { r: 0.96, g: 0.96, b: 0.96 } }];\n  \n  const searchIconOrig = await getOrig(\"2:65\");\n  if (searchIconOrig) {\n    const sIcon = searchIconOrig.createInstance();\n    sIcon.x = 16;\n    sIcon.y = 14;\n    searchBar.appendChild(sIcon);\n  }\n\n  const searchPlaceholder = figma.createText();\n  searchPlaceholder.characters = \"Search for fruit salad combos\";\n  searchPlaceholder.fontName = { family: \"Nunito\", style: \"Regular\" };\n  searchPlaceholder.fontSize = 14;\n  searchPlaceholder.fills = [{ type: 'SOLID', color: { r: 0.74, g: 0.74, b: 0.74 } }];\n  searchPlaceholder.x = 44;\n  searchPlaceholder.y = 14;\n  searchBar.appendChild(searchPlaceholder);\n\n  frameHome.appendChild(searchBar);\n\n  // Filter entry\n  const filterOrig = await getOrig(\"2:73\");\n  if (filterOrig) {\n    const filterBtn = filterOrig.createInstance();\n    filterBtn.x = 305;\n    filterBtn.y = 180;\n    frameHome.appendChild(filterBtn);\n  }\n\n  // Recommended Combo Section\n  const recTitle = figma.createText();\n  recTitle.characters = \"Recommended Combo\";\n  recTitle.fontName = { family: \"Nunito\", style: \"Bold\" };\n  recTitle.fontSize = 20;\n  recTitle.fills = [{ type: 'SOLID', color: brandDarkColor }];\n  recTitle.x = 24;\n  recTitle.y = 248;\n  frameHome.appendChild(recTitle);\n\n  // Recommended Cards: Honey lime combo (2,000) · Berry mango combo (8,000)\n  const cardHoney = await createProductCard({\n    name: \"Honey lime combo\",\n    price: \"2,000\",\n    photoId: \"2:14\"\n  });\n  cardHoney.x = 24;\n  cardHoney.y = 285;\n  frameHome.appendChild(cardHoney);\n\n  const cardBerry = await createProductCard({\n    name: \"Berry mango combo\",\n    price: \"8,000\",\n    photoId: \"2:17\"\n  });\n  cardBerry.x = 192;\n  cardBerry.y = 285;\n  frameHome.appendChild(cardBerry);\n\n  // Categories Tabs: Hottest / Popular / New combo / Top · current: Hottest\n  const catContainer = figma.createFrame();\n  catContainer.name = \"Categories\";\n  catContainer.resize(327, 36);\n  catContainer.x = 24;\n  catContainer.y = 488;\n  catContainer.fills = [];\n\n  const categories = [\n    { name: \"Hottest\", active: true },\n    { name: \"Popular\", active: false },\n    { name: \"New combo\", active: false },\n    { name: \"Top\", active: false }\n  ];\n\n  let currentX = 0;\n  for (const cat of categories) {\n    const catText = figma.createText();\n    catText.characters = cat.name;\n    catText.fontName = { family: \"Nunito\", style: cat.active ? \"Bold\" : \"SemiBold\" };\n    catText.fontSize = cat.active ? 20 : 16;\n    catText.fills = [{ type: 'SOLID', color: cat.active ? brandDarkColor : { r: 0.6, g: 0.6, b: 0.6 } }];\n    catText.x = currentX;\n    catText.y = 0;\n    catContainer.appendChild(catText);\n\n    if (cat.active) {\n      const line = figma.createRectangle();\n      line.name = \"Active Indicator\";\n      line.resize(24, 3);\n      line.cornerRadius = 2;\n      line.x = currentX;\n      line.y = 28;\n      line.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n      catContainer.appendChild(line);\n    }\n\n    currentX += cat.name.length * 9 + 16;\n  }\n  frameHome.appendChild(catContainer);\n\n  // Hottest section cards: Quinoa fruit salad, Tropical fruit salad, Melon fruit salad\n  const hottestScroll = figma.createFrame();\n  hottestScroll.name = \"Hottest Cards Row\";\n  hottestScroll.resize(351, 190);\n  hottestScroll.x = 24;\n  hottestScroll.y = 535;\n  hottestScroll.fills = [];\n\n  const cardQuinoa = await createProductCard({\n    name: \"Quinoa fruit salad\",\n    price: \"10,000\",\n    photoId: \"2:20\"\n  });\n  cardQuinoa.x = 0;\n  cardQuinoa.y = 0;\n  hottestScroll.appendChild(cardQuinoa);\n\n  const cardTropical = await createProductCard({\n    name: \"Tropical fruit salad\",\n    price: \"10,000\",\n    photoId: \"2:23\"\n  });\n  cardTropical.x = 164;\n  cardTropical.y = 0;\n  hottestScroll.appendChild(cardTropical);\n\n  const cardMelon = await createProductCard({\n    name: \"Melon fruit salad\",\n    price: \"10,000\",\n    photoId: \"2:26\"\n  });\n  cardMelon.x = 328;\n  cardMelon.y = 0;\n  hottestScroll.appendChild(cardMelon);\n\n  frameHome.appendChild(hottestScroll);\n\n  return \"Frame 04_Home built successfully\";\n})()","description":"Build 04_Home frame on 03 · Workspace","fileKey":"jiYwYdVVeh1sSSwCPVx5uG"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":27428,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":22997},"context_management":null},"parent_tool_use_id":null,"session_id":"cda7a16c-453d-4dc3-870a-25e4b7be3132","uuid":"02c79159-0591-4723-9a64-f8697497aec1","timestamp":"2026-10-30T20:12:00.001Z","tool_use_meta":[{"id":"call_bcbfd5ad7aa04464acca2b80389a03e7","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
