op.primaryAxisSizingMode = 'FIXED';\n  midTop.counterAxisSizingMode = 'AUTO';\n  midTop.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  midTop.layoutAlign = 'STRETCH';\n  const midTopLeft = figma.createFrame();\n  midTopLeft.fills = [];\n  midTopLeft.layoutMode = 'VERTICAL';\n  midTopLeft.itemSpacing = 4;\n  midTopLeft.counterAxisSizingMode = 'AUTO';\n  midTopLeft.primaryAxisSizingMode = 'AUTO';\n  midTopLeft.appendChild(H.text(name, 20, 'Bold', '#000000'));\n  midTopLeft.appendChild(H.text('Size: ' + size, 14, 'Regular', '#000000', 'Plus Jakarta Sans', 0.6));\n  midTopLeft.appendChild(H.text('Color: ' + color, 14, 'Regular', '#000000', 'Plus Jakarta Sans', 0.6));\n  midTop.appendChild(midTopLeft);\n  const trash = trashIcon.createInstance();\n  trash.resize(24, 24);\n  trash.fills = H.solid('#FF3333');\n  midTop.appendChild(trash);\n  mid.appendChild(midTop);\n  \n  const midBot = figma.createFrame();\n  midBot.fills = [];\n  midBot.layoutMode = 'HORIZONTAL';\n  midBot.primaryAxisSizingMode = 'FIXED';\n  midBot.counterAxisSizingMode = 'AUTO';\n  midBot.primaryAxisAlignItems = 'SPACE_BETWEEN';\n  midBot.counterAxisAlignItems = 'CENTER';\n  midBot.layoutAlign = 'STRETCH';\n  midBot.appendChild(H.text('$' + price, 24, 'Bold', '#000000'));\n  \n  const stepper = figma.createFrame();\n  stepper.layoutMode = 'HORIZONTAL';\n  stepper.paddingLeft = 16; stepper.paddingRight = 16;\n  stepper.paddingTop = 12; stepper.paddingBottom = 12;\n  stepper.counterAxisAlignItems = 'CENTER';\n  stepper.itemSpacing = 20;\n  stepper.counterAxisSizingMode = 'AUTO';\n  stepper.primaryAxisSizingMode = 'AUTO';\n  stepper.cornerRadius = 62;\n  stepper.fills = H.solid('#F0F0F0');\n  const mi = minusIcon.createInstance();\n  mi.resize(20, 20);\n  stepper.appendChild(mi);\n  stepper.appendChild(H.text('1', 14, 'Medium', '#000000'));\n  const pi = plusIcon.createInstance();\n  pi.resize(20, 20);\n  stepper.appendChild(pi);\n  midBot.appendChild(stepper);\n  mid.appendChild(midBot);\n  \n  row.appendCh