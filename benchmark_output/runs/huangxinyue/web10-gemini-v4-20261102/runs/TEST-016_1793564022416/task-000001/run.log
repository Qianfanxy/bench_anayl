\n      const fCard = figma.createFrame();\n      fCard.name = `Folder_${f.name.replace(/\\s+/g, '')}`;\n      fCard.resize(293, 70);\n      fCard.cornerRadius = 12;\n      fCard.fills = [{ type: 'SOLID', color: { r: 0.97, g: 0.975, b: 0.99 } }];\n      fCard.paddingLeft = 14; fCard.paddingRight = 14;\n      fCard.layoutMode = \"HORIZONTAL\";\n      fCard.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n      fCard.counterAxisAlignItems = \"CENTER\";\n\n      const fLeft = figma.createFrame();\n      fLeft.layoutMode = \"HORIZONTAL\";\n      fLeft.counterAxisAlignItems = \"CENTER\";\n      fLeft.itemSpacing = 12;\n      fLeft.fills = [];\n      fLeft.appendChild(getAsset(\"Icon_Folder\", 24));\n\n      const fTextCol = figma.createFrame();\n      fTextCol.layoutMode = \"VERTICAL\";\n      fTextCol.itemSpacing = 2;\n      fTextCol.fills = [];\n\n      const fName = figma.createText();\n      fName.characters = f.name;\n      fName.fontName = { family: \"DM Sans\", style: \"Bold\" };\n      fName.fontSize = 13;\n      fName.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n      fTextCol.appendChild(fName);\n\n      const fCount = figma.createText();\n      fCount.characters = f.count;\n      fCount.fontName = { family: \"DM Sans\", style: \"Regular\" };\n      fCount.fontSize = 11;\n      fCount.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.55 } }];\n      fTextCol.appendChild(fCount);\n\n      fLeft.appendChild(fTextCol);\n      fCard.appendChild(fLeft);\n\n      // Member chips\n      const fAvs = figma.createFrame();\n      fAvs.layoutMode = \"HORIZONTAL\";\n      fAvs.itemSpacing = -6;\n      fAvs.fills = [];\n      for (const av of f.avs) {\n        fAvs.appendChild(getAsset(av, 24));\n      }\n      fCard.appendChild(fAvs);\n\n      fRow.appendChild(fCard);\n    }\n    folderGrid.appendChild(fRow);\n  }\n  allFilesCard.appendChild(folderGrid);\n  leftSec.appendChild(allFilesCard);\n\n  // 2. Recent Files Card (table Name · Size · Last Modif