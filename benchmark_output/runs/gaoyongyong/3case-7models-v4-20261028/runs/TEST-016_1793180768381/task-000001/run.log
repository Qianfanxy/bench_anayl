{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_bdrk_ofhgotsdiwztml3hcsz4t27zlso2o2swcp2fe7a7qdjlllpnwwtq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_018JJxGrHqi5zYtvmrGeAogF","name":"mcp__figma__use_figma","input":{"fileKey":"SMG6SwyZNQKGZWFSWjv2YT","code":"await figma.setCurrentPageAsync(await figma.getNodeByIdAsync('2003:2'));\nfor (const s of ['Regular','Medium','SemiBold','Bold']) await figma.loadFontAsync({family:'Roboto',style:s});\nconst VM={}; (await figma.variables.getLocalVariablesAsync('COLOR')).forEach(v=>VM[v.name]=v);\nconst TSM={}; (await figma.getLocalTextStylesAsync()).forEach(s=>TSM[s.name.replace('Foodgo/','')]=s);\nconst ESM={}; (await figma.getLocalEffectStylesAsync()).forEach(s=>ESM[s.name.replace('Foodgo/','')]=s);\nconst paint=(n,o=1)=>figma.variables.setBoundVariableForPaint({type:'SOLID',color:{r:0,g:0,b:0},opacity:o},'color',VM[n]);\nconst ICON={Home:'1:331',User:'1:335',Chat:'1:339',Heart:'1:343',Search:'1:347',Filter:'1:351',Back:'1:355',Chevron:'1:359',Star:'1:363',Settings:'1:367',Lock:'1:371',Edit:'1:375',SignOut:'1:379',Send:'1:383',Plus:'1:387',Minus:'1:393',Check:'1:398',Menu:'1:404'};\nconst recolor=(i,c)=>{i.findAll(n=>n.type==='VECTOR'||n.type==='ELLIPSE'||n.type==='RECTANGLE').forEach(n=>{if(n.isMask)return; if(n.fills!==figma.mixed&&n.fills.length) n.fills=[paint(c)]; if(n.strokes.length) n.strokes=[paint(c)];});};\nconst I=async(name,c,size=24)=>{const comp=await figma.getNodeByIdAsync(ICON[name]); const i=comp.createInstance(); recolor(i,c); if(size!==24) i.rescale(size/24); i.name='Icon / '+name; return i;};\nconst F=async(name,o={})=>{const f=figma.createFrame(); f.name=name; f.fills=o.fill?[paint(o.fill,o.fo??1)]:[]; f.clipsContent=false;\n if(o.dir){f.layoutMode=o.dir; f.itemSpacing=o.gap??0; const p=o.pad??0; const q=Array.isArray(p)?(p.length===2?[p[0],p[1],p[0],p[1]]:p):[p,p,p,p]; [f.paddingTop,f.paddingRight,f.paddingBottom,f.paddingLeft]=q; f.primaryAxisAlignItems=o.main??'MIN'; f.counterAxisAlignItems=o.cross??'MIN'; f.primaryAxisSizingMode='AUTO'; f.counterAxisSizingMode='AUTO';}\n if(o.w) {f.resize(o.w,o.h??(f.height||10)); if(o.dir){ if(o.dir==='HORIZONTAL'){f.primaryAxisSizingMode='FIXED'; if(o.h) f.counterAxisSizingMode='FIXED';} else {f.counterAxisSizingMode='FIXED'; if(o.h) f.primaryAxisSizingMode='FIXED';}}}\n if(o.r!=null) f.cornerRadius=o.r; if(o.stroke){f.strokes=[paint(o.stroke)]; f.strokeWeight=o.sw??1; f.strokeAlign='INSIDE';} if(o.fx) await f.setEffectStyleIdAsync(ESM[o.fx].id); return f;};\nconst T=async(chars,style,color='text/primary',o={})=>{const t=figma.createText(); await t.setTextStyleIdAsync(TSM[style].id); t.characters=chars; t.fills=[paint(color)]; if(o.w){t.resize(o.w,t.height); t.textAutoResize='HEIGHT';} if(o.align) t.textAlignHorizontal=o.align; t.name=o.name||chars.slice(0,24); return t;};\nconst IMG=async(srcId,w,h,name)=>{const s=await figma.getNodeByIdAsync(srcId); const r=figma.createRectangle(); r.resize(w,h); r.fills=[{type:'IMAGE',imageHash:s.fills[0].imageHash,scaleMode:'FIT'}]; r.name=name||'Image'; return r;};\nconst board=figma.currentPage.findOne(n=>n.name==='Foodgo · Component Library');\nconst ids={};\nconst set=(comps,name)=>{const s=figma.combineAsVariants(comps,board); s.name=name; s.layoutMode='HORIZONTAL'; s.itemSpacing=24; s.paddingTop=s.paddingBottom=s.paddingLeft=s.paddingRight=24; s.primaryAxisSizingMode='AUTO'; s.counterAxisSizingMode='AUTO'; s.counterAxisAlignItems='CENTER'; s.cornerRadius=16; s.fills=[paint('surface/base')]; s.strokes=[paint('border/default')]; s.dashPattern=[6,4]; ids[name]=s.id; return s;};\nconst textProp=(s,comps,prop,def,layer)=>{const p=s.addComponentProperty(prop,'TEXT',def); comps.forEach(c=>{const t=c.findOne(n=>n.type==='TEXT'&&n.name===layer); t.componentPropertyReferences={...(t.componentPropertyReferences||{}),characters:p};});};\nconst btnC=await figma.getNodeByIdAsync('1:473'); const tfC=await figma.getNodeByIdAsync('1:495');\n// fix Added badge\nconst aoSet=await figma.getNodeByIdAsync('2008:388'); const added=aoSet.children.find(c=>c.name==='State=Added'); const bd=added.findOne(n=>n.name==='Badge'); bd.strokes=[paint('brand/red')]; bd.strokeWeight=1.5; bd.strokeAlign='INSIDE';\n\n// Payment method card\nconst pm=[];\nfor(const st of ['Selected','Default']){\n const sel=st==='Selected';\n const f=await F('State='+st,{dir:'HORIZONTAL',cross:'CENTER',gap:16,pad:[16,20,16,16],w:382,h:84,r:20,fill:sel?'brand/brown':'surface/base',stroke:sel?null:'border/default'}); if(sel) await f.setEffectStyleIdAsync(ESM['Elevation 2'].id);\n const tile=await F('Logo',{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',w:64,h:48,r:12,fill:'surface/base',stroke:sel?null:'border/default'}); tile.appendChild(await IMG('1:318',52,32,'Card Logo')); f.appendChild(tile);\n const col=await F('Text',{dir:'VERTICAL',gap:2}); f.appendChild(col); col.layoutGrow=1;\n col.appendChild(await T('Credit card','Body Medium',sel?'text/on-brand':'text/primary',{name:'Type'}));\n col.appendChild(await T('5105 **** **** 0505','Small',sel?'text/muted':'text/secondary',{name:'Number'}));\n const rd=await F('Radio',{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',w:24,h:24,r:12,fill:sel?'brand/red':null,stroke:sel?'surface/base':'state/disabled',sw:2}); if(sel){rd.appendChild(await I('Check','text/on-brand',16));} f.appendChild(rd);\n pm.push(figma.createComponentFromNode(f));}\nconst pms=set(pm,'Payment Method'); textProp(pms,pm,'Type','Credit card','Type'); textProp(pms,pm,'Number','5105 **** **** 0505','Number');\n\n// Toggle\nconst tg=[];\nfor(const st of ['On','Off']){\n const f=await F('State='+st,{w:52,h:32,r:16,fill:st==='On'?'brand/red':'state/disabled'});\n const k=figma.createEllipse(); k.name='Knob'; k.resize(26,26); k.y=3; k.x=st==='On'?23:3; k.fills=[paint('surface/base')]; await k.setEffectStyleIdAsync(ESM['Elevation 1'].id); f.appendChild(k);\n tg.push(figma.createComponentFromNode(f));}\nset(tg,'Toggle');\n\n// Summary row\nconst sr=[];\nfor(const st of ['Default','Total']){\n const f=await F('Type='+st,{dir:'HORIZONTAL',main:'SPACE_BETWEEN',cross:'CENTER',w:334});\n f.appendChild(await T('Order','  '.length&&st==='Total'?'Heading':'Body',st==='Total'?'text/primary':'text/secondary',{name:'Label'}));\n f.appendChild(await T('$16.48',st==='Total'?'Heading':'Body Medium','text/primary',{name:'Value'}));\n sr.push(figma.createComponentFromNode(f));}\nconst srs=set(sr,'Summary Row'); textProp(srs,sr,'Label','Order','Label'); textProp(srs,sr,'Value','$16.48','Value');\n\n// Chat bubble\nconst cb=[];\nfor(const st of ['Agent','Customer']){\n const ag=st==='Agent';\n const f=await F('Sender='+st,{dir:'VERTICAL',pad:[12,16],fill:ag?'surface/subtle':'brand/red',r:20}); if(ag) f.bottomLeftRadius=6; else f.bottomRightRadius=6;\n f.appendChild(await T('Hi, how can I help you?','Body',ag?'text/primary':'text/on-brand',{name:'Message'}));\n cb.push(figma.createComponentFromNode(f));}\nconst cbs=set(cb,'Chat Bubble'); textProp(cbs,cb,'Message','Hi, how can I help you?','Message');\n\n// Chat input\n{const f=await F('Chat Input',{dir:'HORIZONTAL',cross:'CENTER',gap:12,pad:[12,24,42,24],w:430,fill:'surface/base',stroke:'border/default'}); f.strokeTopWeight=1; f.strokeBottomWeight=0; f.strokeLeftWeight=0; f.strokeRightWeight=0;\n const fld=await F('Field',{dir:'HORIZONTAL',cross:'CENTER',pad:[0,20],h:56,w:300,r:20,fill:'surface/subtle'}); f.appendChild(fld); fld.layoutGrow=1;\n fld.appendChild(await T('Type here...','Body','text/muted',{name:'Placeholder'}));\n const s=await F('Send',{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',w:56,h:56,r:20,fill:'brand/red'}); await s.setEffectStyleIdAsync(ESM['Elevation Red'].id); s.appendChild(await I('Send','text/on-brand')); f.appendChild(s);\n const c=figma.createComponentFromNode(f); board.appendChild(c); ids['Chat Input']=c.id;}\n\n// Profile field (wraps provided Text Field)\nconst pf=[];\nfor(const st of ['Default','Locked']){\n const f=figma.createFrame(); f.name='Type='+st; f.resize(382,78); f.fills=[]; f.clipsContent=false;\n const tf=tfC.createInstance(); tf.name='Text Field'; f.appendChild(tf); tf.resize(382,78);\n const fld=tf.findOne(n=>n.name==='Field'); fld.fills=[paint('surface/subtle')];\n const lab=tf.findOne(n=>n.name==='Label'); lab.fills=[paint('text/secondary')];\n const val=tf.findOne(n=>n.name==='Value'); val.fills=[paint(st==='Locked'?'text/secondary':'text/primary')]; await val.setTextStyleIdAsync(TSM['Body Medium'].id);\n lab.characters=st==='Locked'?'Password':'Name'; val.characters=st==='Locked'?'••••••••••':'Sophia Patel';\n if(st==='Locked'){const l=await I('Lock','text/muted',20); f.appendChild(l); l.x=382-20-18; l.y=22+18;}\n pf.push(figma.createComponentFromNode(f));}\nconst pfs=set(pf,'Profile Field');\n\n// List entry\n{const f=await F('List Entry',{dir:'HORIZONTAL',cross:'CENTER',gap:14,pad:[12,16],w:382,h:64,r:18,fill:'surface/base',stroke:'border/default'});\n const tile=await F('Icon Tile',{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',w:40,h:40,r:12,fill:'red/tint'}); tile.appendChild(await I('Edit','brand/red',20)); f.appendChild(tile);\n const t=await T('Order history','Body Medium','text/primary',{name:'Label'}); f.appendChild(t); t.layoutGrow=1;\n f.appendChild(await I('Chevron','text/muted',20));\n const c=figma.createComponentFromNode(f); board.appendChild(c); const p=c.addComponentProperty('Label','TEXT','Order history'); t.componentPropertyReferences={characters:p}; ids['List Entry']=c.id;}\n\n// Button states (extends provided Button)\nconst bs=[];\nfor(const [ty,st] of [['Primary','Pressed'],['Primary','Disabled'],['Secondary','Default'],['Destructive','Default'],['Destructive','Pressed']]){\n const fill= ty==='Primary'?(st==='Pressed'?'red/pressed':'state/disabled'): (ty==='Destructive'&&st==='Pressed'?'red/tint':'surface/base');\n const stroke= ty==='Primary'?null:(ty==='Secondary'?'brand/brown':'brand/red');\n const tc= ty==='Primary'?(st==='Disabled'?'surface/base':'text/on-brand'):(ty==='Secondary'?'brand/brown':'brand/red');\n const f=await F('Type='+ty+', State='+st,{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',gap:10,w:200,h:64,r:20,fill,stroke,sw:1.5});\n if(ty==='Destructive') f.appendChild(await I('SignOut',tc,22));\n f.appendChild(await T(ty==='Destructive'?'Log out':'Order Now','Heading',tc,{name:'Label'}));\n bs.push(figma.createComponentFromNode(f));}\nconst bss=set(bs,'Button / States'); textProp(bss,bs,'Label','Order Now','Label');\n\n// Success dialog\n{const f=await F('Success Dialog',{dir:'VERTICAL',cross:'CENTER',gap:16,pad:[40,28,28,28],w:350,r:32,fill:'surface/base',fx:'Elevation 2'});\n const halo=await F('Success Mark',{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',w:112,h:112,r:56,fill:'semantic/success-tint'});\n const dot=await F('Mark',{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',w:80,h:80,r:40,fill:'semantic/success'}); dot.appendChild(await I('Check','text/on-brand',44)); halo.appendChild(dot); f.appendChild(halo);\n f.appendChild(await T('Success!','Display','text/primary',{name:'Title',align:'CENTER'}));\n f.appendChild(await T('Your payment was successful. A receipt for this purchase has been sent to your email.','Body','text/secondary',{name:'Message',align:'CENTER',w:294}));\n const sp=figma.createFrame(); sp.resize(294,8); sp.fills=[]; sp.name='Spacer'; f.appendChild(sp);\n const b=btnC.createInstance(); b.name='Go Back'; f.appendChild(b); b.layoutSizingHorizontal='FILL'; b.setProperties({'Label#1:0':'Go Back'});\n const c=figma.createComponentFromNode(f); board.appendChild(c); ids['Success Dialog']=c.id;}\nreturn JSON.stringify(ids);","description":"Build components batch 3"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":55153,"cache_read_input_tokens":7731,"cache_creation":{"ephemeral_5m_input_tokens":55153,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"68e3acd5-653d-48c8-9466-97ca92f6c51b","uuid":"f133ef21-561e-4221-9e94-44dd954a4be4","timestamp":"2026-10-28T09:54:24.528Z","tool_use_meta":[{"id":"toolu_bdrk_018JJxGrHqi5zYtvmrGeAogF","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
