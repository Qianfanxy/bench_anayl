turn n;};\nfunction screen(name,i,h=896){const f=figma.createFrame();f.name=name;f.resize(414,h);f.x=i*494;f.y=0;fill(f,'surface/base');f.clipsContent=true;page.appendChild(f);return f;}\nasync function shell(f,light){const sb=(await comp('6:43')).createInstance();put(f,sb,0,0);const hi=(await comp('6:54')).createInstance();put(f,hi,0,f.height-34);hi.constraints={horizontal:'MIN',vertical:'MAX'};\n if(light){sb.fills=[];hi.fills=[];for(const n of [...sb.findAll(()=>true),...hi.findAll(()=>true)]) if(n.type!=='FRAME'&&'fills' in n&&n.fills.length) n.fills=[paint('text/on-primary')];}\n sb.name='Status Bar'; hi.name='Home Indicator'; return {sb,hi};}\nconst crop=(inst)=>{inst.fills=inst.fills.map(p=>p.type==='IMAGE'?{...p,scaleMode:'FILL'}:p);};\nconst ids={};\n// 01 Splash\n{const f=screen('01_Splash',0); fill(f,'brand/primary');\n const logo=(await comp('4:16')).createInstance(); logo.rescale(1.4); put(f,logo,(414-logo.width)/2,(896-logo.height)/2-10);\n const tag=await T('online groceries','Caption/Medium','text/on-primary'); tag.opacity=0.85; tag.letterSpacing={value:4,unit:'PIXELS'}; tag.textCase='UPPER'; put(f,tag,0,0); tag.x=(414-tag.width)/2; tag.y=logo.y+logo.height+14;\n await shell(f,true); ids.s1=f.id;}\n// 02 Onboarding\n{const f=screen('02_Onboarding',1); fill(f,'text/primary');\n const ph=(await comp('4:97')).createInstance(); ph.resize(414,896); crop(ph); put(f,ph,0,0); ph.name='Photo_Welcome_Delivery';\n const g=figma.createRectangle(); g.name='Scrim gradient'; g.resize(414,520); put(f,g,0,376);\n g.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{r:0.09,g:0.09,b:0.15,a:0}},{position:0.45,color:{r:0.09,g:0.09,b:0.15,a:0.7}},{position:1,color:{r:0.09,g:0.09,b:0.15,a:0.92}}]}];\n const car=(await comp('4:10')).createInstance(); recolor(car,'text/on-primary',true); car.rescale(1.4); put(f,car,(414-car.width)/2,470);\n const t=await T('Welcome to our store','Display','text/on-primary'); t.fontSize=44; t.lineHeight={value:52,unit:'PIXELS'}; t.textAlignHorizontal='CENTER'; t.textAutoResize='HEIGHT'; t.resize(300,t.height); put(f,t,57,535);\n const s=await T('Get your groceries in as fast as one hour','Body/Regular','text/on-primary'); s.opacity=0.8; s.textAlignHorizontal='CENTER'; s.textAutoResize='HEIGHT'; s.resize(340,s.height); put(f,s,37,654);\n const b=(await comp('6:29')).createInstance(); b.setProperties({'Label#6:0':'Get Started'}); b.name='Get Started'; put(f,b,25,730);\n await shell(f,true); ids.s2=f.id;}\n// 03 Sign In\n{const f=screen('03_Sign_In',2);\n const ph=(await comp('4:94')).createInstance(); ph.resize(414,374); crop(ph); put(f,ph,0,0); ph.name='Photo_Sign_In_Groceries';\n const g=figma.createRectangle(); g.name='Fade'; g.resize(414,140); put(f,g,0,236); g.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{r:1,g:1,b:1,a:0}},{position:1,color:{r:1,g:1,b:1,a:1}}]}];\n const t=await T('Get your groceries with nectar','Display'); t.textAutoResize='HEIGHT'; t.resize(260,t.height); put(f,t,25,390);\n const pf=variant('Phone Field','State=Empty').createInstance(); pf.name='Phone Number'; put(f,pf,25,490);\n const o=await T('Or connect with social media','Caption/Medium','text/secondary'); o.textAlignHorizontal='CENTER'; o.textAutoResize='NONE'; o.resize(364,21); put(f,o,25,608);\n const gg=variant('Action Button','Type=Google').createInstance(); gg.setProperties({[Object.keys(gg.componentProperties).find(k=>k.startsWith('Label'))]:'Continue with Google'}); gg.name='Continue with Google'; put(f,gg,25,656);\n const fb=variant('Action Button','Type=Facebook').createInstance(); fb.setProperties({[Object.keys(fb.componentProperties).find(k=>k.startsWith('Label'))]:'Continue with Facebook'}); fb.name='Continue with Facebook'; put(f,fb,25,743);\n const {sb}=await shell(f,false); sb.fills=[]; ids.s3=f.id;}\n// 04 Verification\n{const f=screen('04_Verification',3);\n const bg=figma.createRectangle(); bg.name='Soft wash'; bg.resize(414,300); put(f,bg,0,0); bg.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{r:0.92,g:0.97,b:0.94,a:1}},{position:1,color:{r:1,g:1,b:1,a:1}}]}];\n const h=variant('Header','Type=Back').createInstance(); h.name='Header'; put(f,h,0,44);\n const t=await T('Enter your 4-digit code','Display'); put(f,t,25,130);\n const ci=variant('Code Input','State=Empty').createInstance(); ci.name='Code'; put(f,ci,25,200);\n const r=await T('Resend Code','Body/Medium','brand/primary'); r.name='Resend Code'; put(f,r,25,770);\n const nx=variant('Next FAB','State=Default').createInstance(); nx.name='Next'; put(f,nx,322,748);\n const {sb}=await shell(f,false); sb.fills=[]; ids.s4=f.id;}\nreturn ids;","description":"Build screens 01-04","fileKey":"UlgozbXKKfkCkJL2xcXBBr"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":4019,"cache_read_input_tokens":80242,"cache_creation":{"ephemeral_5m_input_tokens":4019,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"cd50dcd8-43a9-4829-85c3-1ee90c619584","uuid":"6acd5aba-1db5-4756-b5af-7acc73da873e","timestamp":"2026-10-30T18:55:36.601Z","tool_use_meta":[{"id":"toolu_bdrk_01Drn1PfJzDiDqFfv1MqcMFA","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
