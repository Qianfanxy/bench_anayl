s = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n  pmTitle.x = 24;\n  pmTitle.y = 368;\n  frame.appendChild(pmTitle);\n  \n  // 2. Credit Card Box (Mastercard) -> selected\n  const ccBox = figma.createFrame();\n  ccBox.name = \"Credit_Card_Box\";\n  ccBox.resize(382, 80);\n  ccBox.x = 24;\n  ccBox.y = 400;\n  ccBox.cornerRadius = 16;\n  ccBox.backgrounds = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  ccBox.strokes = [{ type: \"SOLID\", color: { r: 0.9372549, g: 0.1647059, b: 0.2235294 } }]; // Red border for selected\n  ccBox.strokeWeight = 2;\n  \n  // Mastercard logo clone\n  if (mastercardMaster) {\n    const mc = mastercardMaster.clone();\n    mc.resize(48, 30);\n    mc.x = 16;\n    mc.y = 25;\n    ccBox.appendChild(mc);\n  }\n  \n  // Credit card info text\n  const ccText = figma.createText();\n  ccText.characters = \"Credit card\";\n  ccText.fontSize = 15;\n  ccText.fontName = { family: \"Roboto\", style: \"Bold\" };\n  ccText.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n  ccText.x = 80;\n  ccText.y = 20;\n  ccBox.appendChild(ccText);\n  \n  const ccSub = figma.createText();\n  ccSub.characters = \"Mastercard, 5105 **** **** 0505\";\n  ccSub.fontSize = 13;\n  ccSub.fontName = { family: \"Roboto\", style: \"Regular\" };\n  ccSub.fills = [{ type: \"SOLID\", color: { r: 0.5, g: 0.5, b: 0.5 } }];\n  ccSub.x = 80;\n  ccSub.y = 42;\n  ccBox.appendChild(ccSub);\n  \n  // Custom Radio selector / Checkmark\n  const radioCC = figma.createFrame();\n  radioCC.resize(24, 24);\n  radioCC.cornerRadius = 12;\n  radioCC.x = ccBox.width - 16 - 24;\n  radioCC.y = 28;\n  radioCC.backgrounds = [{ type: \"SOLID\", color: { r: 0.9372549, g: 0.1647059, b: 0.2235294 } }];\n  if (checkMaster) {\n    const chk = checkMaster.clone();\n    chk.resize(14, 14);\n    chk.x = 5;\n    chk.y = 5;\n    chk.fills = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n    radioCC.appendChild(chk);\n  }\n  ccBox.appendChild(radioCC);\n  frame.appendChild(ccBox);\n  \n  // 3. Debit Card Box (Visa) -> unselected\n  const dcBox = figma.createFrame();\n  dcBox.name = \"Debit_Card_Box\";\n  dcBox.resize(382, 80);\n  dcBox.x = 24;\n  dcBox.y = 496;\n  dcBox.cornerRadius = 16;\n  dcBox.backgrounds = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  dcBox.strokes = [{ type: \"SOLID\", color: { r: 0.94, g: 0.94, b: 0.94 } }];\n  dcBox.strokeWeight = 1;\n  \n  // Visa logo clone\n  if (visaMaster) {\n    const visa = visaMaster.clone();\n    visa.resize(40, 40);\n    visa.x = 20;\n    visa.y = 20;\n    dcBox.appendChild(visa);\n  }\n  \n  // Debit card info text\n  const dcText = figma.createText();\n  dcText.characters = \"Debit card\";\n  dcText.fontSize = 15;\n  dcText.fontName = { family: \"Roboto\", style: \"Bold\" };\n  dcText.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n  dcText.x = 80;\n  dcText.y = 20;\n  dcBox.appendChild(dcText);\n  \n  const dcSub = figma.createText();\n  dcSub.characters = \"Visa, 3566 **** **** 0505\";\n  dcSub.fontSize = 13;\n  dcSub.fontName = { family: \"Roboto\", style: \"Regular\" };\n  dcSub.fills = [{ type: \"SOLID\", color: { r: 0.5, g: 0.5, b: 0.5 } }];\n  dcSub.x = 80;\n  dcSub.y = 42;\n  dcBox.appendChild(dcSub);\n  \n  // Custom unselected Radio selector\n  const radioDC = figma.createFrame();\n  radioDC.resize(24, 24);\n  radioDC.cornerRadius = 12;\n  radioDC.x = dcBox.width - 16 - 24;\n  radioDC.y = 28;\n  radioDC.backgrounds = [{ type: \"SOLID\", color: { r: 0.95, g: 0.95, b: 0.95 } }];\n  radioDC.strokes = [{ type: \"SOLID\", color: { r: 0.8, g: 0.8, b: 0.8 } }];\n  radioDC.strokeWeight = 1;\n  dcBox.appendChild(radioDC);\n  frame.appendChild(dcBox);\n  \n  // 4. Save Card switch row\n  const saveCardRow = figma.createFrame();\n  saveCardRow.name = \"Save_Card_Row\";\n  saveCardRow.resize(382, 40);\n  saveCardRow.x = 24;\n  saveCardRow.y = 596;\n  saveCardRow.backgrounds = []; // transparent\n  \n  const saveCardText = figma.createText();\n  saveCardText.characters = \"Save card details for future payments\";\n  saveCardText.fontSize = 14;\n  saveCardText.fontName = { family: \"Roboto\", style: \"Medium\" };\n  saveCardText.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n  saveCardText.x = 0;\n  saveCardText.y = 10;\n  saveCardRow.appendChild(saveCardText);\n  \n  // Create beautiful switch toggled ON\n  const toggleSwitch = figma.createFrame();\n  toggleSwitch.resize(48, 24);\n  toggleSwitch.cornerRadius = 12;\n  toggleSwitch.backgrounds = [{ type: \"SOLID\", color: { r: 0.9372549, g: 0.1647059, b: 0.2235294 } }]; // Red (ON)\n  toggleSwitch.x = saveCardRow.width - 48;\n  toggleSwitch.y = 8;\n  \n  // Switch knob\n  const knob = figma.createFrame();\n  knob.resize(18, 18);\n  knob.cornerRadius = 9;\n  knob.backgrounds = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  knob.x = 26; // shifted right because ON\n  knob.y = 3;\n  toggleSwitch.appendChild(knob);\n  saveCardRow.appendChild(toggleSwitch);\n  frame.appendChild(saveCardRow);\n  \n  // 5. Sticky Footer\n  const footer = figma.createFrame();\n  footer.name = \"Footer\";\n  footer.resize(430, 110);\n  footer.x = 0;\n  footer.y = 788;\n  footer.backgrounds = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  footer.strokes = [{ type: \"SOLID\", color: { r: 0.92, g: 0.92, b: 0.92 } }];\n  footer.strokeWeight = 1;\n  \n  const priceTitle = figma.createText();\n  priceTitle.characters = \"Total Price\";\n  priceTitle.fontSize = 14;\n  priceTitle.fontName = { family: \"Roboto\", style: \"Medium\" };\n  priceTitle.fills = [{ type: \"SOLID\", color: { r: 0.5, g: 0.5, b: 0.5 } }];\n  priceTitle.x = 24;\n  priceTitle.y = 20;\n  footer.appendChild(priceTitle);\n  \n  const priceVal = figma.createText();\n  priceVal.characters = \"$18.28\";\n  priceVal.fontSize = 28;\n  priceVal.fontName = { family: \"Roboto\", style: \"Bold\" };\n  priceVal.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n  priceVal.x = 24;\n  priceVal.y = 40;\n  footer.appendChild(priceVal);\n  \n  if (payBtnMaster) {\n    const payBtn = payBtnMaster.createInstance();\n    payBtn.resize(200, 56);\n    payBtn.x = frame.width - 24 - 200;\n    payBtn.y = 24;\n    const lbl = payBtn.children.find(c => c.name === \"Label\");\n    if (lbl) {\n      lbl.characters = \"Pay Now\";\n    }\n    footer.appendChild(payBtn);\n  }\n  frame.appendChild(footer);\n  \n  return \"Payment methods, save card details, and sticky footer successfully completed on 08_Payment.\";\n})()\n","description":"Create credit/debit selector cards, beautiful active Save card toggle switch, and Pay Now bottom sticky footer on 08_Payment.","fileKey":"pNVsMbFlqHuHgCQFsjUPkH"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":64159,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"494b4549-32cd-4fcc-b024-fd0ae7aff445","uuid":"f8aeeacd-8976-418b-aea9-0c3916fd3a90","timestamp":"2026-10-28T19:54:26.190Z","tool_use_meta":[{"id":"call_c37280185b3d4cb089bbcfe4f0ee98a0","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
