SH = {\n  hero: '029285421b37d7658db131c10657e5f475894ac6',\n  styleCasual: '9523fbed9a4f658fb44a30f0cfdb78443bff4127',\n  styleFormal: '677f1b574bee5433f0fb091eadf93727cdabbf26',\n  styleGym: '01e1019ae778d42bda0cd0df5a56294884691c85',\n  styleParty: 'a1293a390c6545a12616745330eca3e8e4c18e3c',\n  blackStriped: 'd804bc954de8bd0dda1e535417a46db07c831cd5',\n  checkered: '3e5af3bd4090b719f9e42d6984ebbd10f41fc9c3',\n  courage: 'c5bf7371fccba672c21a584729b73ef7ad09fa55',\n  faded: 'eea24156e78b7ae662554a9bc2f811c2549cded1',\n  gradient: '173cdca0085fb8acf64975f34aeb87fb68b80d51',\n  bermuda: '26bcb83ffdfcea554d93b0e0a65bc3fa67c6b980',\n  poloContrast: '77529935ddddb506767247bd3118efb9d2e1dfe1',\n  poloTipping: '32e6a3ad8ed6f34076876927adea8218d092eb5f',\n  skinny: '6ed8d22ee0609f1267c87d0005f076860044fe94',\n  sleeveStriped: 'ef45eeebb5fae60d034aff1014d22e0e6da465db',\n  tape: '944815ad931630758703b2d2208da91ea7073c4d',\n  verticalStriped: '0cd824094e131d46c078ec766c523b4693d10bba',\n  oneLife1: '5c81c3b40da5eabe5379d737e5fdddc7de79f937',\n  oneLife2: '53e83d8289c7043b402778c58caa8f5ed38770b4',\n  oneLife3: '9238edbf650daab55f66659286eb2c1fec2b8746',\n};\nglobalThis.__HASH = HASH;\n\n// ============ 01_Home frame ============\nconst home = figma.createFrame();\nhome.name = '01_Home';\nhome.resize(1440, 10);\nhome.layoutMode = 'VERTICAL';\nhome.primaryAxisSizingMode = 'AUTO';\nhome.counterAxisSizingMode = 'FIXED';\nhome.itemSpacing = 0;\nhome.fills = H.solid('#FFFFFF');\nhome.x = 0; home.y = 0;\npage.appendChild(home);\n\n// Announcement bar instance\nconst homeAb = ab.createInstance();\nhomeAb.layoutAlign = 'STRETCH';\nhome.appendChild(homeAb);\n\n// Header instance\nconst homeHeader = header.createInstance();\nhomeHeader.layoutAlign = 'STRETCH';\nhome.appendChild(homeHeader);\n\nreturn { homeId: home.id };\n","description":"Create 01_Home frame shell with announcement + header","fileKey":"5S6WFXEo4QEfJTtE7MFltz"}}],"context_management":null},"parent_tool_use_id":null,"s