ld(i);}\nfp.appendChild(divider(247));\nawait head('Dress Style','4:9');\nconst ds=AL('Dress style options','VERTICAL',20); ds.counterAxisAlignItems='MIN'; fp.appendChild(ds);\nfor(const o of ['Casual','Formal','Party','Gym']){const i=foC.createInstance(); i.name='Dress · '+o; setP(i,{Label:o}); ds.appendChild(i);}\nconst apply=await btn('Default','Apply Filter',247,48); fp.appendChild(apply);\n// results\nconst res=AL('Results','VERTICAL',16); res.counterAxisSizingMode='FIXED'; res.resize(925,10); res.primaryAxisSizingMode='AUTO'; res.counterAxisAlignItems='MIN'; main.appendChild(res);\nconst rh=AL('Results header','HORIZONTAL',0); rh.primaryAxisAlignItems='SPACE_BETWEEN'; rh.counterAxisAlignItems='MAX'; res.appendChild(rh); rh.layoutSizingHorizontal='FILL';\nrh.appendChild(await T('Casual','Display/S'));\nconst meta=AL('Meta','HORIZONTAL',12); rh.appendChild(meta); meta.appendChild(await T('Showing 1-9 of 100 Products','Body/L','#666666'));\nconst sort=AL('Sort','HORIZONTAL',4); sort.name='Sort by'; meta.appendChild(sort); sort.appendChild(await T('Sort by:','Body/L','#666666')); sort.appendChild(await T('Most Popular','Heading/S')); sort.appendChild(await icon('4:9','#000000'));\nconst gridsp=figma.createFrame(); gridsp.resize(1,8); gridsp.fills=[]; gridsp.name='spacer'; res.appendChild(gridsp);\nconst grid=AL('Product grid','HORIZONTAL',20); grid.layoutWrap='WRAP'; grid.counterAxisSpacing=36; grid.primaryAxisSizingMode='FIXED'; grid.resize(925,10); grid.counterAxisSizingMode='AUTO'; grid.counterAxisAlignItems='MIN'; res.appendChild(grid);\nfor(const it of [['Gradient Graphic T-shirt','3.5','$145'],['Polo with Tipping Details','4.5','$180'],['Black Striped T-shirt','5.0','$120','$150','-30%'],['Skinny Fit Jeans','3.5','$240','$260','-20%'],['Checkered Shirt','4.5','$180'],['Sleeve Striped T-shirt','4.5','$130','$160','-30%'],['Vertical Striped Shirt','5.0','$212','$232','-20%'],['Courage Graphic T-shirt','4.0','$145'],['Loose Fit Bermuda Shorts','3.0','$80']]) gr