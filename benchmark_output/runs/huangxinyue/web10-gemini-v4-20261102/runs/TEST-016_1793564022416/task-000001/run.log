0.318, b: 0.976 } }];\n  uploadBtn.layoutMode = \"HORIZONTAL\";\n  uploadBtn.counterAxisAlignItems = \"CENTER\";\n  uploadBtn.itemSpacing = 8;\n  uploadBtn.appendChild(getAsset(\"Icon_Upload\", 16));\n  const upTxt = figma.createText();\n  upTxt.characters = \"Upload\";\n  upTxt.fontName = { family: \"DM Sans\", style: \"Bold\" };\n  upTxt.fontSize = 13;\n  upTxt.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  uploadBtn.appendChild(upTxt);\n  hActions.appendChild(uploadBtn);\n\n  header.appendChild(hActions);\n  content.appendChild(header);\n\n  // Main split row: Left Main Files (w: 960), Right Available Storage (w: 332)\n  const mainSplit = figma.createFrame();\n  mainSplit.name = \"MainSplit\";\n  mainSplit.resize(1312, 820);\n  mainSplit.layoutMode = \"HORIZONTAL\";\n  mainSplit.itemSpacing = 20;\n  mainSplit.fills = [];\n\n  // Left Section (w: 960)\n  const leftSec = figma.createFrame();\n  leftSec.name = \"LeftSection\";\n  leftSec.resize(960, 820);\n  leftSec.layoutMode = \"VERTICAL\";\n  leftSec.itemSpacing = 20;\n  leftSec.fills = [];\n\n  // 1. All Files Card (6 folders: Documents · 24 files | Music · 102 files | Work Project · 84 files | Personal Media · 2450 files | Reddingo Backup · 22 files | Root · 105 files)\n  const allFilesCard = figma.createFrame();\n  allFilesCard.name = \"AllFilesCard\";\n  allFilesCard.resize(960, 240);\n  allFilesCard.cornerRadius = 16;\n  allFilesCard.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n  allFilesCard.paddingTop = 20; allFilesCard.paddingBottom = 20;\n  allFilesCard.paddingLeft = 24; allFilesCard.paddingRight = 24;\n  allFilesCard.layoutMode = \"VERTICAL\";\n  allFilesCard.itemSpacing = 16;\n\n  const afHeader = figma.createFrame();\n  afHeader.resize(912, 28);\n  afHeader.layoutMode = \"HORIZONTAL\";\n  afHeader.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  afHeader.counterAxisAlignItems = \"CENTER\";\n  afHeader.fills = [];\n\n  const afTitle = figma.createText();\n  afTitle.characters =