s = [{ type: 'SOLID', color: c }]; }\nconst compById = async id => await figma.getNodeByIdAsync(id);\nconst compByName = async name => await figma.getNodeByIdAsync(lib.findOne(n => n.type === 'COMPONENT' && n.name === name).id);\n\nconst prop = await figma.getNodeByIdAsync('20:318');\n\n// ---------- Similar listings ----------\nconst similar = F('Similar listings'); solid(similar, C.paper);\nAL(similar, { dir: 'VERTICAL', gap: 40, pad: [80, 80, 80, 80] });\nprop.appendChild(similar); similar.layoutSizingHorizontal = 'FILL';\n\nconst sHead = F('Heading'); AL(sHead, { dir: 'HORIZONTAL', align: 'SPACE_BETWEEN', cross: 'CENTER' });\nsimilar.appendChild(sHead); sHead.layoutSizingHorizontal = 'FILL';\nsHead.appendChild(T('Similar listings', { size: 32, style: 'Bold', ls: -1 }));\nconst arrows = F('Arrows'); AL(arrows, { dir: 'HORIZONTAL', gap: 8 });\nsHead.appendChild(arrows);\nconst circComp = await compByName('Button / Circle');\nconst leftBtn = circComp.createInstance();\n// swap chevron-right to chevron-left inside the instance\nconst chevronIn = leftBtn.findOne(n => n.type === 'INSTANCE');\nchevronIn.swapComponent(await compById('3:10'));\narrows.appendChild(leftBtn);\nconst rightBtn = circComp.createInstance();\narrows.appendChild(rightBtn);\n\n// Similar cards\nconst cardComp = await compByName('Listing / Card');\nconst simData = [\n  ['Malto House', '4 bd', '2 ba', '1,650 sq ft', '3:22'],\n  ['Birchwood Villa', '4 bd', '2 ba', '1,720 sq ft', '3:23'],\n  ['Cedar Lane House', '4 bd', '2 ba', '1,580 sq ft', '3:24'],\n  ['Harbor View Loft', '4 bd', '2 ba', '1,610 sq ft', '3:25'],\n];\nconst simRow = F('Cards'); AL(simRow, { dir: 'HORIZONTAL', gap: 24 });\nsimilar.appendChild(simRow); simRow.layoutSizingHorizontal = 'FILL';\nconst simCards = [];\nfor (const [name, bd, ba, area, photoId] of simData) {\n  const card = cardComp.createInstance(); card.name = 'Similar · ' + name;\n  const pw = card.findOne(n => n.name === 'Photo');\n  pw.children[0].swapComponent(await compById(photoId));\n  card.findOne(n => n.type === 'TEXT' && n.fontSize === 20).characters = name;\n  const texts = card.findAll(n => n.type === 'TEXT' && n.fontSize === 14);\n  texts[0].characters = bd; texts[1].characters = ba; texts[2].characters = area;\n  simRow.appendChild(card); card.layoutSizingHorizontal = 'FILL';\n  simCards.push(card);\n}\n\n// ---------- Footer ----------\nprop.appendChild((await compByName('Footer')).createInstance());\n\nreturn JSON.stringify({ propH: Math.round(prop.height), simCardIds: simCards.map(c => c.id) });\n","description":"Build 02_Property step 3: similar listings, footer"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"8420bd2b-08e1-4650-9759-ee0744cf2f7f","uuid":"948023ae-3b4e-499c-a9a7-cd8125d64cd2","timestamp":"2026-11-02T00:09:24.463Z","tool_use_meta":[{"id":"mcp__figma__use_figma_58_6d9d992d","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
