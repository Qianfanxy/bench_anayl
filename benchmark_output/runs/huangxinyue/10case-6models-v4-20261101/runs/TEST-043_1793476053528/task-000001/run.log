{"type":"assistant","message":{"id":"chatcmpl-202610311951503717167038268d9d6eAUML3t5","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_607ba1fb1e104d4f9905986ae3e5a453","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Semi Bold\" });\n  await figma.loadFontAsync({ family: \"Roboto\", style: \"Bold\" });\n\n  const workspace = figma.root.children.find(p => p.name.includes(\"03\"));\n  await figma.setCurrentPageAsync(workspace);\n\n  // Constants & helpers\n  const BG_COLOR = { r: 0.07, g: 0.09, b: 0.11 }; // #12171C\n  const CARD_BG = { r: 0.12, g: 0.15, b: 0.18 }; // #1F262E\n  const GREEN_GAIN = { r: 0.15, g: 0.59, b: 0.27 }; // #279646\n  const RED_LOSS = { r: 0.90, g: 0.28, b: 0.28 }; // #E54747\n  const TEXT_WHITE = { r: 0.95, g: 0.96, b: 0.98 }; // #F2F4F7\n  const TEXT_MUTED = { r: 0.55, g: 0.60, b: 0.68 }; // #8C99AD\n  const BORDER_COLOR = { r: 0.18, g: 0.22, b: 0.27 }; // #2E3845\n\n  function getInstance(id) {\n    const orig = figma.getNodeById(id);\n    if (!orig) return null;\n    return orig.createInstance();\n  }\n\n  function addShell(frame) {\n    const sb = getInstance(\"1:30\");\n    if (sb) {\n      sb.x = 0; sb.y = 0;\n      frame.appendChild(sb);\n    }\n    const hi = getInstance(\"1:40\");\n    if (hi) {\n      hi.x = 0; hi.y = 812 - 34;\n      frame.appendChild(hi);\n    }\n  }\n\n  function createTabBar(activeTab = \"Trending\") {\n    const bar = figma.createFrame();\n    bar.name = \"Tab Bar\";\n    bar.resize(375, 64);\n    bar.fills = [{ type: 'SOLID', color: CARD_BG }];\n    bar.strokes = [{ type: 'SOLID', color: BORDER_COLOR }];\n    bar.strokeWeight = 1;\n    bar.layoutMode = \"HORIZONTAL\";\n    bar.primaryAxisSizingMode = \"FIXED\";\n    bar.counterAxisSizingMode = \"FIXED\";\n    bar.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    bar.counterAxisAlignItems = \"CENTER\";\n    bar.paddingLeft = 8;\n    bar.paddingRight = 8;\n\n    const tabs = [\n      { name: \"Aktivitas\", iconId: \"2:33\", label: \"Aktivitas\" },\n      { name: \"Trending\", iconId: \"2:36\", label: \"Trending\" },\n      { name: \"Top Up\", iconId: \"2:30\", label: \"Top Up\" },\n      { name: \"Pasar\", iconId: \"2:39\", label: \"Pasar\" },\n      { name: \"Profil\", iconId: \"2:42\", label: \"Profil\" }\n    ];\n\n    tabs.forEach(t => {\n      const tabItem = figma.createFrame();\n      tabItem.name = `Tab_${t.name}`;\n      tabItem.resize(68, 48);\n      tabItem.fills = [];\n      tabItem.layoutMode = \"VERTICAL\";\n      tabItem.primaryAxisAlignItems = \"CENTER\";\n      tabItem.counterAxisAlignItems = \"CENTER\";\n      tabItem.itemSpacing = 4;\n\n      const isActive = t.name === activeTab;\n      const activeColor = isActive ? GREEN_GAIN : TEXT_MUTED;\n\n      const iconInst = getInstance(t.iconId);\n      if (iconInst) {\n        tabItem.appendChild(iconInst);\n      }\n\n      const txt = figma.createText();\n      txt.fontName = { family: \"Roboto\", style: isActive ? \"Medium\" : \"Regular\" };\n      txt.characters = t.label;\n      txt.fontSize = 11;\n      txt.fills = [{ type: 'SOLID', color: activeColor }];\n      tabItem.appendChild(txt);\n\n      bar.appendChild(tabItem);\n    });\n\n    return bar;\n  }\n\n  // Create 02_Trending frame\n  const f2 = figma.createFrame();\n  f2.name = \"02_Trending\";\n  f2.resize(375, 812);\n  f2.x = 450; f2.y = 0; // offset visually on canvas\n  f2.fills = [{ type: 'SOLID', color: BG_COLOR }];\n  f2.clipsContent = true;\n\n  // Header 02\n  const h2 = figma.createFrame();\n  h2.name = \"Header\";\n  h2.resize(375, 56);\n  h2.x = 0; h2.y = 44;\n  h2.fills = [];\n  h2.layoutMode = \"HORIZONTAL\";\n  h2.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  h2.counterAxisAlignItems = \"CENTER\";\n  h2.paddingLe