rEach((v,i)=>{v.fills=S(i===0?BROWN:BROWN);});\n txt(f,title,{w:'Bold',s:24,c:BROWN,name:'Screen Title',x:24,y=0});\n}\nfunction headerT(f,title){ const h=header(f,title); }\n// fix: header without title\nfunction topBar(f){const back=I('2009:15');f.appendChild(back);back.x=24;back.y=52;back.resize(44,44);back.name='Back';\n const s=I('2009:15');f.appendChild(s);s.x=362;s.y=52;s.resize(44,44);s.name='Search';return s;}\nfunction bottomBar(f,y,h,label,btnLabel){\n const bar=figma.createFrame();f.appendChild(bar);bar.name='Bottom Bar';bar.x=0;bar.y=y;bar.resize(430,h);bar.fills=S('#FFFFFF');\n bar.effects=[{type:'DROP_SHADOW',color:{r:0.2,g:0.1,b:0.1,a:0.08},offset:{x:0,y:-4},radius:20,spread:0,visible:true,blendMode:'NORMAL'}];\n txt(bar,label,{s:12,c:MUTED,name:'Total Label',x:24,y:18});\n txt(bar,'$'+btnLabel.replace('$',''),{w:'Bold',s:24,c:BROWN,name:'Price',x:24,y:34});\n const ob=figma.createFrame();bar.appendChild(ob);ob.name='Primary Action';ob.x=196;ob.y=19;ob.resize(210,56);ob.cornerRadius=16;ob.fills=S(RED);\n const ot=txt(ob,'Order Now',{w:'SemiBold',s:16,c:'#FFFFFF',width:210,align:'CENTER',name:'Label',x:0,y:18});\n return bar;}\n\n// ================= 07_Customize =================\nconst cz=screen('07_Customize',0,1100,1400);\ntopBar(cz);\ntxt(cz,'Customize Your Burger',{w:'Bold',s:26,c:BROWN,name:'Title',x:24,y:116});\ntxt(cz,'to Your Tastes. Ultimate Experience',{w:'Regular',s:14,c:MUTED,name:'Subtitle',x:24,y:150});\nconst hero=figma.createFrame();cz.appendChild(hero);hero.name='Hero';hero.x=24;hero.y=182;hero.resize(382,236);hero.cornerRadius=32;hero.fills=S(SURF);hero.clipsContent=true;\nconst esrc=md.findOne(n=>n.name==='Burger_Exploded_Custom');\nimg(hero,'Burger_Exploded_Custom',(382-176*1.1)/2,(236-240*0.8)/2,176*1.1,240*0.8);\n// portion\ntxt(cz,'Portion',{w:'SemiBold',s:14,c:BROWN,name:'Portion Label',x:24,y:440});\nconst stp=I('2009:20');cz.appendChild(stp);stp.x=110;stp.y=432;stp.resize(132,48);\nstp.findOne(n=>n.name==='Value'&&n.type==='TEXT').characters='2';\ntxt(cz,'Each portion $8.24',{s:12,c:MUTED,name:'Unit Price',x:258,y:448});\n// spice\ntxt(cz,'Spicy level',{w:'SemiBold',s:14,c:BROWN,name:'Spicy Label',x:24,y:500});\nconst spc=I('2009:36');cz.appendChild(spc);spc.x=24;spc.y=526;spc.resize(382,56);\n// toppings\nconst th=I('2012:190');cz.appendChild(th);th.x=24;th.y=606;th.resize(382,32);\nth.findOne(n=>n.name==='Title').characters='Toppings';th.findOne(n=>n.name==='Action').characters='Selected 2';\nconst toppings=[['Tomato','T/Tomato',true],['Onions','T/Onions',false],['Pickles','T/Pickles',false],['Bacon','T/Bacon',false],['Cheese','T/Cheese',true],['Mushroom','T/Mushroom',false],['Avocado','T/Avocado',false]];\ntoppings.forEach(([label,mn,added],i)=>{\n const tile=I(added?'2012:161':'2012:153');cz.appendChild(tile);tile.x=24+(i%4)*100;tile.y=650+Math.floor(i/4)*130;tile.resize(100,118);\n tile.findOne(n=>n.name==='Label'&&n.type==='TEXT').characters=label;\n const ti=tile.findOne(n=>n.name==='img');\n const src=md.findOne(n=>n.name===mn);\n if(ti&&src) ti.fills=src.fills;\n tile.name='Topping/'+label;\n});\n// sides\nconst sh2=I('2012:190');cz.appendChild(sh2);sh2.x=24;sh2.y=912;sh2.resize(382,32);\nsh2.findOne(n=>n.name==='Title').characters='Side options';sh2.findOne(n=>n.name==='Action').characters='Selected 1';\nconst sides=[['Fries','S/Fries',true],['Coleslaw','S/Coleslaw',false],['Salad','S/Salad',false],['Onion Rings','S/Onion_Rings',false],['Mozzarella Sticks','S/Mozzarella_Sticks',false]];\nsides.forEach(([label,mn,added],i)=>{\n const tile=I(added?'2012:161':'2012:153');cz.appendChild(tile);tile.x=24+(i%3)*112;tile.y=956+Math.floor(i/3)*130;tile.resize(100,118);\n tile.findOne(n=>n.name==='Label'&&n.type==='TEXT').characters=label;\n const ti=tile.findOne(n=>n.name==='img');const src=md.findOne(n=>n.name===mn);\n if(ti&&src) ti.fills=src.fills;\n tile.name='Side/'+label;\n});\n// total bar\nbottomBar(cz,1306,94,'Total','16.48');\n\n// ================= 08_Payment =================\nconst pay=screen('08_Payment',500,1100,932);\ntopBar(pay);\ntxt(pay,'Payment',{w:'Bold',s:26,c=BROWN,name:'Title',x:24,y:118});\nconst card=figma.createFrame();pay.appendChild(card);card.name='Order Summary';card.x=24;card.y=170;card.resize(382,238);card.cornerRadius=24;card.fills=S(SURF);\ntxt(card,'Order summary',{w:'SemiBold',s:16,c:BROWN,name:'Summary Title',x:20,y:18});\nconst rows=[['Order','$16.48'],['Taxes','$0.30'],['Delivery fees','$1.50']];\nrows.forEach(([l,v],i)=>{\n txt(card,l,{s:13,c:MUTED,name:'Row '+l,x:20,y:56+i*26});\n const val=txt(card,v,{w:'Medium',s:13,c:BROWN,name:'Val '+l,x:270,y:56+i*26,width:92,align:'RIGHT'});\n});\nconst div=figma.createRectangle();card.appendChild(div);div.x=20;div.y=142;div.resize(342,1);div.fills=[{type:'SOLID',color:C('#E6D9D5')}];\ntxt(card,'Total',{w:'SemiBold',s:15,c:BROWN,name:'Total',x:20,y:156});\ntxt(card,'$18.28',{w:'Bold',s:20,c:RED,name:'Total Val',x:240,y:152,width:122,align:'RIGHT'});\nconst eta=figma.createFrame();card.appendChild(eta);eta.name='ETA';eta.x=20;eta.y=196;eta.resize(342,26);eta.cornerRadius=13;eta.fills=S('#FFF1F1');\ntxt(eta,'Estimated delivery 15–30 mins',{w:'Medium',s:12,c:RED,name:'ETA Text',x:12,y:5});\ntxt(pay,'Payment methods',{w:'SemiBold',s:16,c:BROWN,name:'Methods Title',x:24,y:428});\nconst r1=I('2010:57');pay.appendChild(r1);r1.x=24;r1.y=464;r1.resize(382,80);r1.name='Card/Mastercard';\nconst r2=I('2010:66');pay.appendChild(r2);r2.x=24;r2.y=556;r2.resize(382,80);r2.name='Card/Visa';\n// save card row\nconst save=figma.createFrame();pay.appendChild(save);save.name='Save Card';save.x=24;save.y=652;save.resize(382,60);save.cornerRadius=16;save.fills=S('#FFFFFF');save.strokeWeight=1;save.strokes=S(BORDER);\nconst sl=txt(save,'Save card details for future payments',{s:13,c:BROWN,name:'Save Label',x:16,y:21,width:250});\nconst toggle=figma.createFrame();save.appendChild(toggle);toggle.name='Toggle';toggle.x=330;toggle.y=15;toggle.resize(40,24);toggle.cornerRadius=12;toggle.fills=S(GREEN);\nconst knob=figma.createEllipse();toggle.appendChild(knob);knob.x=19;knob.y=2;knob.resize(20,20);knob.fills=S('#FFFFFF');\n// pay bar\nconst bar=figma.createFrame();pay.appendChild(bar);bar.name='Bottom Bar';bar.x=0;bar.y=838;bar.resize(430,94);bar.fills=S('#FFFFFF');\nbar.effects=[{type:'DROP_SHADOW',color:{r:0.2,g:0.1,b:0.1,a:0.08},offset:{x:0,y:-4},radius:20,spread:0,visible:true,blendMode:'NORMAL'}];\ntxt(bar,'Total price',{s:12,c:MUTED,name:'Total Label',x:24,y:18});\ntxt(bar,'$18.28',{w:'Bold',s:24,c:BROWN,name:'Price',x:24,y:34});\nconst pb=figma.createFrame();bar.appendChild(pb);pb.name='Pay Now';pb.x=196;pb.y=19;pb.resize(210,56);pb.cornerRadius=16;pb.fills=S(RED);\ntxt(pb,'Pay Now',{w:'SemiBold',s:16,c:'#FFFFFF',width:210,align:'CENTER',name:'Label',x:0,y:18});\n\nreturn JSON.stringify({ok:true, pay:pay.id, cz:cz.id});\n","description":"Build customize and payment screens","fileKey":"X4FFaqwjpE7db5KGMtMR8O"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":9,"cache_creation_input_tokens":7067,"cache_read_input_tokens":126718,"cache_creation":{"ephemeral_5m_input_tokens":7067,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"global","speed":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"5c4b085e-0924-4a6a-9e18-2faff92322bc","uuid":"c90221be-025e-4256-b960-a4d3c4e66788","timestamp":"2026-10-28T19:17:11.665Z","tool_use_meta":[{"id":"toolu_01MMwWBIDgQ36GR6sJ7WhzR4","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
