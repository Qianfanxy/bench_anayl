.children) recolor(ch,color);\n}\nasync function iconInst(id,color,size){\n  const c = await figma.getNodeByIdAsync(id); const i = c.createInstance();\n  i.resize(size,size); recolor(i,color); return i;\n}\nconst SHADOW = [{type:\"DROP_SHADOW\", color:{r:0.09,g:0.09,b:0.24,a:0.06}, offset:{x:0,y:4}, radius:16, spread:0, visible:true, blendMode:\"NORMAL\"}];\n\n// ---- UI Kit container ----\nconst kit = figma.createFrame(); kit.name=\"🧩 Budget · UI Kit\"; kit.x=0; kit.y=0;\nkit.layoutMode=\"VERTICAL\"; kit.paddingLeft=32; kit.paddingRight=32; kit.paddingTop=32; kit.paddingBottom=32;\nkit.itemSpacing=28; kit.primaryAxisSizingMode=\"AUTO\"; kit.counterAxisSizingMode=\"AUTO\";\nkit.fills=S({r:0.99,g:0.99,b:1}); kit.cornerRadius=24;\nconst kitTitle = mkText(\"Budget · reusable components\",13,\"Bold\",C.ter); kit.appendChild(kitTitle);\n\n// ---- Comp / Tab Bar ----\nconst tabbar = figma.createFrame(); tabbar.name=\"Comp / Tab Bar\"; tabbar.resize(375,64); tabbar.fills=S(C.white);\nconst tbLine = figma.createRectangle(); tbLine.resize(375,1); tbLine.fills=S(C.border); tabbar.appendChild(tbLine); tbLine.y=0;\nconst tbRow = figma.createFrame(); tbRow.name=\"tabs\"; tbRow.resize(375,63); tbRow.y=1; tbRow.fills=[];\ntbRow.layoutMode=\"HORIZONTAL\"; tbRow.primaryAxisSizingMode=\"FIXED\"; tbRow.counterAxisSizingMode=\"FIXED\"; tbRow.itemSpacing=0;\ntabbar.appendChild(tbRow);\nconst tabs = [ [\"Overview\",ICON.overview,false], [\"This Month\",ICON.month,true], [\"Offers\",ICON.offers,false], [\"Setting\",ICON.setting,false] ];\nfor (const [label,ic,cur] of tabs){\n  const tab = figma.createFrame(); tab.name=label; tab.fills=[]; tab.layoutGrow=1;\n  tab.layoutMode=\"VERTICAL\"; tab.primaryAxisAlignItems=\"CENTER\"; tab.counterAxisAlignItems=\"CENTER\"; tab.itemSpacing=3;\n  const col = cur ? C.brand : {r:0.62,g:0.64,b:0.69};\n  const icn = await iconInst(ic,col,24);\n  const lb = mkText(label,10, cur?\"Bold\":\"Medium\", col);\n  tab.appendChild(icn); tab.appendChild(lb);\n  tbR