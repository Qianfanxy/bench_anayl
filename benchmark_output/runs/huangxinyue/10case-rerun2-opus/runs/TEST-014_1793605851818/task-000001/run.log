itle default\nfor (const c of root.findAll(n=>n.type==='COMPONENT' && n.parent?.name==='List Entry')){ const t=c.findOne(n=>n.name==='Subtitle'); t.characters='See all categories'; const k=Object.keys(c.componentPropertyDefinitions).find(k=>k.startsWith('Subtitle')); c.editComponentProperty(k,{defaultValue:'See all categories'}); }\nasync function section(name){const s=AL('Section · '+name,'VERTICAL',{gap:16,ca:'MIN'}); s.appendChild(await T(name,'Overline/12 SemiBold','text/secondary')); root.appendChild(s); return s;}\nfunction setify(comps,name,sec,dir='HORIZONTAL'){const set=figma.combineAsVariants(comps,sec); set.name=name; set.layoutMode=dir; set.primaryAxisSizingMode='AUTO'; set.counterAxisSizingMode='AUTO'; set.itemSpacing=24; set.paddingTop=set.paddingBottom=set.paddingLeft=set.paddingRight=24; set.fills=[P('bg/surface')]; set.cornerRadius=16; set.strokes=[{type:'SOLID',color:{r:0.59,g:0.28,b:1}}]; set.dashPattern=[6,4]; return set;}\nfunction textProp(c,t,name){const k=c.addComponentProperty(name,'TEXT',t.characters); t.componentPropertyReferences={characters:k};}\nfunction pill(){}\nasync function ratingPill(label,kind){const f=AL('Rating','HORIZONTAL',{pad:[3,10,3,10],r:999,fill:kind+'-bg'}); const t=await T(label,'Caption/11 Medium',kind); t.fontName={family:'DM Sans',style:'Bold'}; t.name='Rating'; f.appendChild(t); return [f,t];}\n\n// ---- Subscription summary\nlet sec=await section('Subscription Summary');\nconst ss=AL('Subscription Summary','VERTICAL',{w:335,ps:'AUTO',cs:'FIXED',gap:6,ca:'MIN',pad:[20,20,20,20],r:24});\nss.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0.8,0.6,0],[-0.6,0.8,0.3]],gradientStops:[{position:0,color:{r:0.42,g:0.32,b:0.96,a:1}},{position:1,color:{r:0.31,g:0.2,b:0.82,a:1}}]}];\nss.effectStyleId=ES['Elevation/3 Brand'].id;\nconst a1=await T('Your monthly payment for subscriptions','Label/13 Medium','text/on-brand'); a1.opacity=0.85; ss.appendChild(a1);\nconst a2=await T('$58.97','Display/40 Bold','text/on-brand'); a2.name='Total'; ss.appendChild(a2);\nconst chips=AL('Logos','HORIZONTAL',{gap:-8,pad:[6,0,0,0]}); ss.appendChild(chips);\nconst LOGO={}; for (const id of ['2:13','2:14','2:15','2:16']){const c=await figma.getNodeByIdAsync(id); LOGO[c.name]=c;}\nfor (const n of ['Logo_Patreon','Logo_Netflix','Logo_Apple','Logo_Spotify']){const w=AL('Logo chip','HORIZONTAL',{w:32,h:32,ps:'FIXED',cs:'FIXED',pa:'CENTER',ca:'CENTER',r:16,fill:'bg/surface'}); w.clipsContent=true; w.strokes=[P('brand/500')]; w.strokeWeight=2; const l=LOGO[n].createInstance(); l.rescale(28/48); w.appendChild(l); chips.appendChild(w);}\nconst ssc=figma.createComponentFromNode(ss); sec.appendChild(ssc); textProp(ssc,a2,'Total');\n\n// ---- Subscription row\nsec=await section('Subscription Row');\nconst srs=[];\nfor (const st of ['Default','Pressed']){\n  const f=AL('State='+st,'HORIZONTAL',{w:335,ps:'FIXED',cs:'AUTO',gap:14,pad:[14,12,14,14],r:20,fill:st==='Pressed'?'state/pressed':'bg/surface'}); if(st==='Default') f.effectStyleId=ES['Elevation/1 Card'].id;\n  const lw=AL('Logo','HORIZONTAL',{w:48,h:48,ps:'FIXED',cs:'FIXED',pa:'CENTER',ca:'CENTER',r:14,fill:'bg/surface'}); lw.clipsContent=true; lw.strokes=[P('border/default')];\n  const li=LOGO['Logo_Patreon'].createInstance(); li.name='Service Logo'; lw.appendChild(li); f.appendChild(lw);\n  const tx=AL('Text','VERTICAL',{gap:2,ca:'MIN'}); f.appendChild(tx); tx.layoutGrow=1;\n  const nm=await T('Patreon membership','Body/15 Medium','text/primary'); nm.name='Service'; tx.appendChild(nm);\n  const pr=await T('$19.99/mo','Title/17 SemiBold','text/primary'); pr.name='Price'; f.appendChild(pr);\n  f.appendChild(icon('Icon_Chevron_Right','text/tertiary'));\n  const c=figma.createComponentFromNode(f); textProp(c,nm,'Service'); textProp(c,pr,'Price');\n  const k=c.addComponentProperty('Logo','INSTANCE_SWAP',LOGO['Logo_Patreon'].id); li.componentPropertyReferences={mainComponent:k};\n  srs.push(c);\n}\nsetify(srs,'Subscription Row',sec,'VERTICAL');\n\n// ---- Credit gauge\nsec=await section('Credit Score Gauge');\nconst g=figma.createFrame(); g.name='Credit Score Gauge'; g.resize(295,200); g.fills=[]; g.clipsContent=true;\nconst D=250, gx=(295-D)/2, gy=14, inner=0.86;\nconst track=figma.createEllipse(); track.name='Track'; track.resize(D,D); track.x=gx; track.y=gy; track.arcData={startingAngle:Math.PI,endingAngle:2*Math.PI,innerRadius:inner}; track.fills=[P('track/default')]; g.appendChild(track);\nconst pct=(660-400)/450; const end=Math.PI*(1+pct);\nconst val=figma.createEllipse(); val.name='Value'; val.resize(D,D); val.x=gx; val.y=gy; val.arcData={startingAngle:Math.PI,endingAngle:end,innerRadius:inner};\nval.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[1,0,0],[0,1,0]],gradientStops:[{position:0,color:{r:0.75,g:0.70,b:0.98,a:1}},{position:0.6,color:{r:0.39,g:0.28,b:0.92,a:1}}]}]; g.appendChild(val);\nconst rr=D/2*(1+inner)/2; const cx=gx+D/2, cy=gy+D/2;\nconst knob=figma.createEllipse(); knob.name='Knob'; knob.resize(20,20); knob.x=cx+rr*Math.cos(end)-10; knob.y=cy+rr*Math.sin(end)-10; knob.fills=[P('bg/surface')]; knob.strokes=[P('brand/500')]; knob.strokeWeight=4; knob.effectStyleId=ES['Elevation/1 Card'].id; g.appendChild(knob);\nconst sc=await T('660','Display/40 Bold','text/primary'); sc.name='Score'; sc.fontSize=52; sc.lineHeight={unit:'PIXELS',value:60}; sc.textAlignHorizontal='CENTER'; g.appendChild(sc); sc.x=cx-sc.width/2; sc.y=62;\nconst meta=AL('Meta','HORIZONTAL',{gap:8}); g.appendChild(meta);\nconst [rp]=await ratingPill('Good','status/good'); meta.appendChild(rp);\nconst up=await T('+6pts','Label/13 Medium','status/good'); up.fontName={family:'DM Sans',style:'Bold'}; up.name='Delta'; meta.appendChild(up);\nmeta.x=cx-meta.width/2; meta.y=126;\nconst lo=await T('400','Label/13 Medium','text/tertiary'); lo.name='Min'; g.appendChild(lo); lo.x=gx+(D*(1-inner)/4)-lo.width/2; lo.y=cy+8;\nconst hi=await T('850','Label/13 Medium','text/tertiary'); hi.name='Max'; g.appendChild(hi); hi.x=gx+D-(D*(1-inner)/4)-hi.width/2; hi.y=cy+8;\nconst upd=await T('Last update on 20 Jul 2020','Label/13 Regular','text/secondary'); upd.name='Updated'; upd.textAlignHorizontal='CENTER'; g.appendChild(upd); upd.x=cx-upd.width/2; upd.y=176;\nconst gc=figma.createComponentFromNode(g); sec.appendChild(gc);\n\n// ---- Factor row\nsec=await section('Factor Row');\nconst frs=[];\nfor (const [kind,lab] of [['Good','status/good'],['Not bad','status/warning']]){\n  const f=AL('Rating='+kind,'HORIZONTAL',{w:335,ps:'FIXED',cs:'AUTO',gap:12,pad:[16,12,16,16],r:20,fill:'bg/surface'}); f.effectStyleId=ES['Elevation/1 Card'].id;\n  const dot=figma.createFrame(); dot.name='Indicator'; dot.resize(4,40); dot.cornerRadius=2; dot.fills=[P(lab)]; f.appendChild(dot);\n  const tx=AL('Text','VERTICAL',{gap:2,ca:'MIN'}); f.appendChild(tx); tx.layoutGrow=1;\n  const nm=await T('On-time payments','Body/15 Medium','text/primary'); nm.name='Factor'; tx.appendChild(nm);\n  const dt=await T('1 missed','Label/13 Regular','text/secondary'); dt.name='Detail'; tx.appendChild(dt);\n  const rt=AL('Value','VERTICAL',{gap:4,ca:'MAX'}); f.appendChild(rt);\n  const vv=await T('95%','Title/17 SemiBold','text/primary'); vv.name='Value'; rt.appendChild(vv);\n  const [rp2,rt2]=await ratingPill(kind,lab); rt.appendChild(rp2);\n  f.appendChild(icon('Icon_Chevron_Right','text/tertiary'));\n  const c=figma.createComponentFromNode(f); textProp(c,nm,'Factor'); textProp(c,dt,'Detail'); textProp(c,vv,'Value'); frs.push(c);\n}\nsetify(frs,'Factor Row',sec,'VERTICAL');\n\n// ---- Credit teaser\nsec=await section('Credit Score Entry');\nconst cts=[];\nfor (const st of ['Default','Pressed']){\n  const f=AL('State='+st,'HORIZONTAL',{w:335,ps:'FIXED',cs:'AUTO',gap:12,pad:[14,12,14,16],r:20,fill:st==='Pressed'?'state/pressed':'bg/surface'}); if(st==='Default') f.effectStyleId=ES['Elevation/1 Card'].id;\n  const ring=figma.createFrame(); ring.name='Mini gauge'; ring.resize(44,44); ring.fills=[]; f.appendChild(ring);\n  const e1=figma.createEllipse(); e1.resize(44,44); e1.arcData={startingAngle:0,endingAngle:2*Math.PI,innerRadius:0.8}; e1.fills=[P('brand/100')]; ring.appendChild(e1);\n  const e2=figma.createEllipse(); e2.resize(44,44); e2.arcData={startingAngle:-Math.PI/2,endingAngle:-Math.PI/2+2*Math.PI*pct,innerRadius:0.8}; e2.fills=[P('brand/500')]; ring.appendChild(e2);\n  const tx=AL('Text','VERTICAL',{gap:2,ca:'MIN'}); f.appendChild(tx); tx.layoutGrow=1;\n  tx.appendChild(await T('Credit Score','Body/15 Medium','text/primary'));\n  tx.appendChild(await T('Last update on 20 Jul 2020','Label/13 Regular','text/secondary'));\n  const rt=AL('Score','VERTICAL',{gap:2,ca:'MAX'}); f.appendChild(rt);\n  rt.appendChild(await T('660','Title/17 SemiBold','text/primary'));\n  const [rp3]=await ratingPill('Good','status/good'); rt.appendChild(rp3);\n  f.appendChild(icon('Icon_Chevron_Right','text/tertiary'));\n  cts.push(figma.createComponentFromNode(f));\n}\nsetify(cts,'Credit Score Entry',sec);\nreturn 'ok';","description":"Build subscription, credit gauge, factor row, credit entry components","fileKey":"htzJEgTQZM6qy0UMgMs235"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":1976,"cache_read_input_tokens":40847,"cache_creation":{"ephemeral_5m_input_tokens":1976,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"26d7c23f-3381-47cf-9fcd-bed7f7968ebf","uuid":"3ba9e6a3-7b45-4337-9496-4b1fd8323576","timestamp":"2026-11-02T07:56:32.252Z","tool_use_meta":[{"id":"toolu_bdrk_01Dqz38AdzhyUXIGFcxooYSm","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
