oogle_White recolored dark) + label; Facebook instance: swap nested icon to Icon_Facebook_White, recolor #1877F2, resize (13×24 master → keep 13.3×24 or scale 18×24?) Master 13×24; place at x24? Original: icon left at 24. Text centered — with icon left, text center overall. Structure: 364×67 relative: icon at x28 y21.5 (24 tall), label centered width 364 align CENTER. So label centered independent of icon — matches original.\n\nOK, Call 1 also creates Comp/Social Button. 15 items.\n\nWrite the code — I'll aim ~14k chars. Let me carefully draft.\n\n```js\nawait Promise.all([\"Regular\",\"Medium\",\"SemiBold\",\"Bold\"].map(s=>figma.loadFontAsync({family:\"Poppins\",style:s})));\nconst WS=figma.getNodeById(\"7:2\");\nconst F=(hex,o=1)=>{const n=parseInt(hex.slice(1),16);return{type:\"SOLID\",color:{r:((n>>16)&255)/255,g:((n>>8)&255)/255,b:(n&255)/255},opacity:o};};\nconst C={brand:\"#53B175\",dark:\"#181725\",gray:\"#7C7C7C\",light:\"#B1B1B1\",border:\"#E2E2E2\",surface:\"#F2F3F2\",white:\"#FFFFFF\",orange:\"#F3603F\",fb:\"#1877F2\"};\nconst MASTER={};for(const c of figma.root.findAllWithCriteria({types:[\"COMPONENT\"]}))MASTER[c.name]=c;\nconst SHADOW=(y,r,a)=>[{type:\"DROP_SHADOW\",color:{r:0,g:0,b:0,a},offset:{x:0,y},radius:r,visible:true,blendMode:\"NORMAL\"}];\nfunction txt(ch,sz,st,col,x,y,w,align){const t=figma.createText();t.fontName={family:\"Poppins\",style:st};t.characters=ch;t.fontSize=sz;t.fills=[F(col)];if(w){t.textAutoResize=\"HEIGHT\";t.resize(w,10);}if(align)t.textAlignHorizontal=align;if(x!==undefined){t.x=x;t.y=y;}return t;}\nfunction svgI(d,size,color,filled){const s=filled?`<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"${d}\" fill=\"${color}\"/></svg>`:`<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"${d}\" stroke=\"${color}\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>`;const n=figma.createNodeWithSvg(s);n.rescale(size/24);n.name=\"Icon\";return n;}\nfunction recolor(n,hex){const c=[F(hex)];const walk=l=>{if([\"VECTOR\",\"ELLIPSE\",\"RECTANGLE\",\"BOOLEAN_OPERATION\",\"LINE\",\"STAR\"].includes(l.type)){try{if(l.fills&&l.fills.length&&l.fills[0].visible!==false)l.fills=c;}catch(e){}try{if(l.strokes&&l.strokes.length&&l.strokes[0].visible!==false)l.strokes=c;}catch(e){}}if(l.type===\"TEXT\")l.fills=c;if(\"children\"in l)for(const ch of l.children)walk(ch);};walk(n);}\nfunction mediaInst(name,parent,x,y){const m=MASTER[name].createInstance();parent.appendChild(m);if(x!==undefined){m.x=x;m.y=y;}return m;}\nfunction fitIn(m,maxW,maxH){const s=Math.min(maxW/m.width,maxH/m.height);m.resize(m.width*s,m.height*s);}\nfunction mediaFit(name,parent,maxW,maxH,cx){const m=mediaInst(name,parent,0,0);fitIn(m,maxW,maxH);m.x=cx!==undefined?cx:(parent.width-m.width)/2;m.y=(parent.height-m.height)/2;return m;}\nfunction swapFit(inst,name,maxW,maxH){inst.swapComponent(MASTER[name]);const mw=MASTER[name].width,mh=MASTER[name].height;const s=Math.min(maxW/mw,maxH/mh);inst.resize(mw*s,mh*s);if(inst.parent){inst.x=(inst.parent.width-inst.width)/2;inst.y=(inst.parent.height-inst.height)/2;}return inst;}\n\nconst out={};let cy=0;const CX=2250;\nconst head=txt(\"Components\",16,\"SemiBold\",C.dark,CX,0);WS.appendChild(head);cy=48;\nfunction place(node,h){WS.appendChild(node);node.x=CX;node.y=cy;cy+=h+56;}\n\n// 1 Add Button\nconst ab=figma.createComponent();ab.name=\"Add Button\";ab.resize(36,36);ab.cornerRadius=12;ab.fills=[F(C.brand)];ab.layoutMode=\"HORIZONTAL\";ab.primaryAxisAlignItems=\"CENTER\";ab.counterAxisAlignItems=\"CENTER\";ab.primaryAxisSizingMode=\"FIXED\";ab.counterAxisSizingMode=\"FIXED\";const ap=svgI(\"M12 5v14M5 12h14\",16,C.white);ab.appendChild(ap);place(ab,36);out.addButton=ab.id;\n\n// 2 Stepper\nconst st=figma.createComponent();st.name=\"Quantity Stepper\";st.layoutMode=\"HORIZONTAL\";st.itemSpacing=12;st.counterAxisAlignItems=\"CENTER\";st.primaryAxisSizingMode=\"AUTO\";st.counterAxisSizingMode=\"AUTO\";st.fills=[];\nconst mC=figma.createFrame();mC.resize(36,36);mC.cornerRadius=18;mC.fills=[F(C.white)];mC.strokes=[F(C.light)];mC.strokeWeight=1;const mi=svgI(\"M5 12h14\",14,C.gray);mC.appendChild(mi);mi.x=11;mi.y=11;\nconst qt=txt(\"1\",16,\"SemiBold\",C.dark);qt.textAutoResize=\"WIDTH\";\nconst pC=figma.createFrame();pC.resize(36,36);pC.cornerRadius=18;pC.fills=[F(C.brand)];const pi=svgI(\"M12 5v14M5 12h14\",14,C.white);pC.appendChild(pi);pi.x=11;pi.y=11;\nst.appendChild(mC);st.appendChild(qt);st.appendChild(pC);place(st,36);out.stepper=st.id;\n```\n\nWait — txt() with w undefined keeps autoResize default (WIDTH? createText default autoResize WIDTH). For centered qty in stepper fine.\n\nProduct Card:\n\n```js\nconst pc=figma.createComponent();pc.name=\"Product Card\";pc.layoutMode=\"VERTICAL\";pc.itemSpacing=4;pc.paddingLeft=12;pc.paddingRight=12;pc.paddingTop=12;pc.paddingBottom=12;pc.primaryAxisSizingMode=\"AUTO\";pc.counterAxisSizingMode=\"FIXED\";pc.resize(171,200);pc.cornerRadius=18;pc.fills=[F(C.white)];pc.strokes=[F(C.border)];pc.strokeWeight=1;pc.effects=SHADOW(4,16,0.06);\nconst im=figma.createFrame();im.name=\"Image\";im.resize(147,86);im.fills=[];im.clipsContent=false;\nconst ph=mediaInst(\"Product_Red_Apple\",im,0,0);ph.name=\"Photo\";fitIn(ph,130,80);ph.x=(147-ph.width)/2;ph.y=(86-ph.height)/2;\nconst nm=txt(\"Name\",16,\"Medium\",C.dark,0,0,147);nm.name=\"Name\";\nconst un=txt(\"Unit\",14,\"Regular\",C.gray,0,0,147);un.name=\"Unit\";\nconst pr=figma.createFrame();pr.name=\"Price Row\";pr.layoutMode=\"HORIZONTAL\";pr.primaryAxisAlignItems=\"SPACE_BETWEEN\";pr.counterAxisAlignItems=\"CENTER\";pr.primaryAxisSizingMode=\"FIXED\";pr.counterAxisSizingMode=\"AUTO\";pr.resize(147,36);pr.fills=[];\nconst pv=txt(\"$0.00\",16,\"SemiBold\",C.dark);pv.name=\"Price\";pv.textAutoResize=\"WIDTH\";\nconst abi=ab.createInstance();pr.appendChild(pv);pr.appendChild(abi);\npc.appendChild(im);pc.appendChild(nm)