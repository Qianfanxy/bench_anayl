 01_Work\nconst w=screen('01_Work',0);\nconst h1=hv('Work').createInstance();h1.name='Header';w.appendChild(h1);\nconst i1=wi.createInstance();i1.name='Intro';w.appendChild(i1);\nconst pr=frame('Projects','VERTICAL');pr.resize(1200,10);pr.counterAxisSizingMode='FIXED';pr.layoutSizingVertical='HUG';pr.itemSpacing=160;pr.paddingBottom=160;w.appendChild(pr);\nconst sh=frame('Section heading','HORIZONTAL');sh.primaryAxisAlignItems='SPACE_BETWEEN';sh.counterAxisAlignItems='CENTER';sh.paddingTop=24;sh.strokes=[paint('ink')];sh.strokeTopWeight=2;sh.strokeBottomWeight=sh.strokeLeftWeight=sh.strokeRightWeight=0;sh.strokeAlign='INSIDE';pr.appendChild(sh);sh.layoutSizingHorizontal='FILL';\nsh.appendChild(await txt('Selected projects','Label','ink'));sh.appendChild(await txt('03','Label','accent'));\npr.itemSpacing=96;\nconst list=frame('Project list','VERTICAL');list.itemSpacing=160;pr.appendChild(list);list.layoutSizingHorizontal='FILL';\nconst data=[{lay:'Image Left',Number:'01',Name:'Goblin Bust',Description:'Goblin concept digital sculpture with human-like skin. Learned a lot of quick tips and look development.','Tools line':'Sculpted in ZBrush, retopologized and UV-mapped in Maya, textured in Mari, rendered with Arnold.',tools:true,link:'More shots from this project ↗'},\n{lay:'Image Right',Number:'02',Name:'Skin Shader Study',Description:'Subsurface weight, specular roughness and diffuse maps generated with procedural and manual techniques.',tools:false,link:'See case study →'},\n{lay:'Image Left',Number:'03',Name:'Creature Concept',Description:'Experimental creature modeling for a school project.',tools:false,status:true}];\nconst ids=[];\nfor(const d of data){const p=pbv(d.lay).createInstance();p.name='Project/'+d.Number+' '+d.Name;list.appendChild(p);\nconst m={Number:d.Number,Name:d.Name,Description:d.Description,'Show tools':!!d.tools,'Show link':!!d.link,'Show status':!!d.status};if(d.tools)m['Tools line']=d['Tools line'];setP(p,m);\nif(d.link){setP(p.findOne(n=>n.name==='Link'),{Label:d.link});}\nconst im=p.findOne(n=>n.name==='Image');setP(im,{Caption:'Project image · '+d.Name});ids.push(p.id);}\nconst f1=footer.createInstance();f1.name='Footer';w.appendChild(f1);\n// 02_About\nconst a=screen('02_About',1540);\nconst h2=hv('About').createInstance();h2.name='Header';a.appendChild(h2);\nconst i2=ai.createInstance();i2.name='Intro';a.appendChild(i2);\nconst sk=frame('Skills','VERTICAL');sk.resize(1200,10);sk.counterAxisSizingMode='FIXED';sk.layoutSizingVertical='HUG';sk.itemSpacing=56;sk.paddingBottom=160;a.appendChild(sk);\nconst skh=frame('Section heading','HORIZONTAL');skh.itemSpacing=126;skh.counterAxisAlignItems='MAX';sk.appendChild(skh);skh.layoutSizingHorizontal='FILL';\nconst skt=await txt('Skills','Label','accent');skh.appendChild(skt);\nconst cols=frame('Lists','HORIZONTAL');cols.itemSpacing=24;sk.appendChild(cols);cols.layoutSizingHorizontal='FILL';\nconst soft=['Pixologic ZBrush','Autodesk Maya','The Foundry Mari','Arnold Renderer','Blender','Forger','Adobe CC','Figma','Ableton'];\nconst skills=['Organic and Polygonal Modeling','UV Layout','Texturing','Retopology','Illustration','Sound Design'];\nfor(const[t,items] of [['Main Software',soft],['Main Skills',skills]]){const s=sl.createInstance();s.name='SkillList/'+t;cols.appendChild(s);s.layoutSizingHorizontal='FILL';setP(s,{Title:t,Count:String(items.length).padStart(2,'0'),Items:items.join('\\n')});}\nconst ctw=frame('Contact','VERTICAL');ctw.resize(1200,10);ctw.counterAxisSizingMode='FIXED';ctw.layoutSizingVertical='HUG';ctw.paddingBottom=128;a.appendChild(ctw);\nconst c2=cb.createInstance();c2.name='ContactBlock';ctw.appendChild(c2);c2.layoutSizingHorizontal='FILL';\nconst f2=footer.createInstance();f2.name='Footer';a.appendChild(f2);\nreturn JSON.stringify({work:w.id,about:a.id,ids,wh:w.height,ah:a.height});","description":"Build 01_Work and 02_About screens from component instances","fileKey":"SxmsjomtdkiWGWyoVDnAOU"}}],"container":null,"stop_reason":null,"sto