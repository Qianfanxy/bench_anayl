ze(27,1); dash.fills=solid(C.sub); row.appendChild(dash); row.appendChild(T('Bed Room',16,'Medium',C.sub)); row.name='01 — Bed Room'; lab.appendChild(row);\nlab.appendChild(T('Inner Peace',28,'SemiBold',C.text,{name:'Slide Title'})); ins.appendChild(lab); lab.x=590; lab.y=626-24-lab.height;\nconst open=AL('HORIZONTAL',{fill:C.brand,align:'CENTER',justify:'CENTER',name:'Open slide'}); open.primaryAxisSizingMode='FIXED'; open.counterAxisSizingMode='FIXED'; open.resize(48,48); open.appendChild(await icon('13:49',C.white)); ins.appendChild(open); open.x=lab.x+lab.width; open.y=lab.y+lab.height-48;\nconst s2=await inst('13:10',372,486); s2.name='Slide 2'; ins.appendChild(s2); s2.x=994; s2.y=44;\nconst s3=await inst('13:11',372,486); s3.name='Slide 3'; ins.appendChild(s3); s3.x=1390; s3.y=44;\nconst nx=AL('HORIZONTAL',{fill:C.white,align:'CENTER',justify:'CENTER',name:'Next slide'}); nx.primaryAxisSizingMode='FIXED'; nx.counterAxisSizingMode='FIXED'; nx.resize(48,48); nx.cornerRadius=24; nx.effects=[{type:'DROP_SHADOW',color:{r:0,g:0,b:0,a:0.16},offset:{x:0,y:4},radius:14,spread:0,visible:true,blendMode:'NORMAL'}]; nx.appendChild(await icon('13:46',C.brand,24)); ins.appendChild(nx); nx.x=1342; nx.y=263;\nconst dots=AL('HORIZONTAL',{gap:20,align:'CENTER',name:'Slide Indicator'}); for(let i=0;i<4;i++){const d=await variant('17:42',i===0?'State=Current':'State=Default'); d.name='Dot '+(i+1); dots.appendChild(d);} ins.appendChild(dots); dots.x=994; dots.y=572;\n// Share setup\nconst sh=figma.createFrame(); sh.name='Share Your Setup'; sh.resize(1440,860); sh.fills=[]; sh.clipsContent=true; S.appendChild(sh);\nconst shT=AL('VERTICAL',{gap:4,align:'CENTER',name:'Setup Heading'}); shT.appendChild(T('Share your setup with',20,'SemiBold',C.sub)); shT.appendChild(T('#FurniroFurniture',40,'Bold',C.text)); sh.appendChild(shT); shT.x=(1440-shT.width)/2; shT.y=56;\nconst R=[['13:69',-40,90,274,382],['13:72',250,170,451,312],['13:58',-40,488,381,323],['13:70',357,498,344,242],['13:59',71