sAlignItems=o.cross??'MIN'; f.primaryAxisSizingMode='AUTO'; f.counterAxisSizingMode='AUTO';}\n if(o.w) {f.resize(o.w,o.h??(f.height||10)); if(o.dir){ if(o.dir==='HORIZONTAL'){f.primaryAxisSizingMode='FIXED'; if(o.h) f.counterAxisSizingMode='FIXED';} else {f.counterAxisSizingMode='FIXED'; if(o.h) f.primaryAxisSizingMode='FIXED';}}}\n if(o.r!=null) f.cornerRadius=o.r; if(o.stroke){f.strokes=[paint(o.stroke)]; f.strokeWeight=o.sw??1; f.strokeAlign='INSIDE';} if(o.fx) await f.setEffectStyleIdAsync(ESM[o.fx].id); return f;};\nconst T=async(chars,style,color='text/primary',o={})=>{const t=figma.createText(); await t.setTextStyleIdAsync(TSM[style].id); t.characters=chars; t.fills=[paint(color)]; if(o.w){t.resize(o.w,t.height); t.textAutoResize='HEIGHT';} if(o.align) t.textAlignHorizontal=o.align; t.name=o.name||chars.slice(0,24); return t;};\nconst C=async(frame)=>{const c=figma.createComponentFromNode(frame); return c;};\nconst ADD=(p,...k)=>{k.forEach(x=>p.appendChild(x)); return p;};\n\n// Board\nlet board=figma.currentPage.findOne(n=>n.name==='Foodgo · Component Library');\nif(!board){board=await F('Foodgo · Component Library',{fill:'surface/subtle',dir:'HORIZONTAL',gap:48,pad:64,w:2600}); board.layoutWrap='WRAP'; board.counterAxisSpacing=64; board.x=0; board.y=1400; board.cornerRadius=32;}\nconst ids={};\nconst set=(comps,name)=>{const s=figma.combineAsVariants(comps,board); s.name=name; s.layoutMode='HORIZONTAL'; s.itemSpacing=24; s.paddingTop=s.paddingBottom=s.paddingLeft=s.paddingRight=24; s.primaryAxisSizingMode='AUTO'; s.counterAxisSizingMode='AUTO'; s.counterAxisAlignItems='CENTER'; s.cornerRadius=16; s.fills=[paint('surface/base')]; s.strokes=[paint('border/default')]; s.dashPattern=[6,4]; ids[name]=s.id; return s;};\n\n// Icon Button\nconst ib=[];\nfor(const [st,bg,ic,stroke] of [['Ghost',null,'text/primary','border/default'],['Soft','surface/subtle','text/primary',null],['Brand','brand/red','text/on-brand',null]]){\n const f=await F('Style='+st,{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',w:48,h:48,r:16,fill:bg,stroke}); if(st==='Brand') await f.setEffectStyleIdAsync(ESM['Elevation Red'].id);\n const icon=await I(st==='Brand'?'Filter':'Back',ic); f.appendChild(icon); const c=await C(f); ib.push(c);}\nconst ibs=set(ib,'Icon Button');\n// instance swap property\nconst defKey=ib[0].children[0].mainComponent.id;\nconst pid=ibs.addComponentProperty('Icon','INSTANCE_SWAP',defKey);\nib.forEach(c=>{c.children[0].componentPropertyReferences={mainComponent:pid};});\n\n// Category chip\nconst ch=[];\nfor(const st of ['Selected','Default']){\n const f=await F('State='+st,{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',pad:[14,24],r:16,fill:st==='Selected'?'brand/red':'surface/subtle'}); if(st==='Selected') await f.setEffectStyleIdAsync(ESM['Elevation Red'].id);\n const t=await T('All','Label',st==='Selected'?'text/on-brand':'text/secondary',{name:'Label'}); f.appendChild(t); ch.push(await C(f));}\nconst chs=set(ch,'Category Chip'); const lp=chs.addComponentProperty('Label','TEXT','All'); ch.forEach(c=>c.children[0].componentPropertyReferences={characters:lp});\n\n// Favourite toggle\nconst fv=[];\nfor(const st of ['On','Off']){\n const f=await F('Favourite='+st,{dir:'HORIZONTAL',main:'CENTER',cross:'CENTER',w:36,h:36,r:18,fill:st==='On'?'brand/red':'surface/subtle'});\n f.appendChild(await I('Heart',st==='On'?'text/on-brand':'text/muted',20)); fv.push(await C(f));}\nset(fv,'Favourite Toggle');\n\n// Rating\n{const f=await F('Rating',{dir:'HORIZONTAL',cross:'CENTER',gap:4}); f.appendChild(await I('Star','rating/star',16)); const t=await T('4.9','Small Medium','text/primary',{name:'Value'}); f.appendChild(t); const c=await C(f); board.appendChild(c); const p=c.addComponentProperty('Value','TEXT','4.9'); t.componentPropertyReferences={characters:p}; ids['Rating']=c.id;}\n\n// Search field\nconst sf=[];\nfor(const st of ['Empty','Focused']){\n const f=await F('State='+st,{dir:'HORIZONTAL',cross:'CENTER',gap:12,pad:[0,20],w:302,h:60,r:20,fill:'surface/base',stroke:st==='Focused'?'brand/red':'border/default',sw:st==='Focused'?1.5:1});\n await f.setEffectStyleIdAsync(ESM['Elevation 1'].id);\n f.appendChild(await I('Search',st==='Focused'?'brand/red':'text/primary'));\n const t=await T(st==='Focused'?'Burg':'Search','Body',st==='Focused'?'text/primary':'text/muted',{name:'Value'}); f.appendChild(t);\n if(st==='Focused'){const cur=figma.createRectangle(); cur.name='Caret'; cur.resize(1.5,22); cur.fills=[paint('brand/red')]; f.appendChild(cur); f.itemSpacing=12; }\n sf.push(await C(f));}\nset(sf,'Search Field');\n\n// Nav item\nconst ni=[];\nfor(const st of ['Active','Inactive']){\n const f=await F('State='+st,{dir:'VERTICAL',main:'CENTER',cross:'CENTER',gap:4,w:72,h:56});\n f.appendChild(await I('Home',st==='Active'?'brand/red':'text/muted'));\n const t=await T('Home','Caption',st==='Active'?'brand/red':'text/muted',{name:'Label'}); f.appendChild(t);\n if(st==='Active'){const d=figma.createEllipse(); d.name='Indicator'; d.resize(4,4); d.fills=[paint('brand/red')]; f.appendChild(d);} \n ni.push(await C(f));}\nconst nis=set(ni,'Nav Item'); const nl=nis.addComponentProperty('Label','TEXT','Home'); ni.forEach(c=>c.children[1].componentPropertyReferences={characters:nl});\nreturn JSON.stringify(ids);","description":"Build components batch 1 (icon button, chip, favourite, rating, search, nav item)","fileKey":"SMG6SwyZNQKGZWFSWjv2YT"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":18317,"cache_read_input_tokens":24188,"cache_creation":{"ephemeral_5m_input_tokens":18317,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"68e3acd5-653d-48c8-9466-97ca92f6c51b","uuid":"f4318d0c-0d7a-4023-800a-98c650bd9886","timestamp":"2026-10-28T09:51:09.180Z","tool_use_meta":[{"id":"toolu_bdrk_01LXstgebEKRfPKka6BoPCpC","display_name":"Use Figma","se