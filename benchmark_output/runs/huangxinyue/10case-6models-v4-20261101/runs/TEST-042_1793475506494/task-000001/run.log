e === 'COMPONENT');\n  const masterHomeIndicator = compPage.findOne(n => n.name === 'Home Indicator' && n.type === 'COMPONENT');\n  const masterTextField = compPage.findOne(n => n.name === 'Text Field' && n.type === 'COMPONENT');\n\n  function recolorNode(node, colorObj) {\n    if ('fills' in node && node.fills) {\n      node.fills = [{ type: 'SOLID', color: colorObj }];\n    }\n    if ('children' in node) {\n      for (const child of node.children) {\n        recolorNode(child, colorObj);\n      }\n    }\n  }\n\n  function createStatusBar(isWhite = false) {\n    let inst = masterStatusBar.createInstance();\n    if (isWhite) {\n      recolorNode(inst, { r: 1, g: 1, b: 1 });\n    }\n    return inst;\n  }\n\n  function createHomeIndicator(isWhite = false) {\n    let inst = masterHomeIndicator.createInstance();\n    if (isWhite) {\n      recolorNode(inst, { r: 1, g: 1, b: 1 });\n    }\n    return inst;\n  }\n\n  const COLOR_TEAL = { r: 0, g: 0.47843137, b: 0.5490196 };\n  const COLOR_WHITE = { r: 1, g: 1, b: 1 };\n  const COLOR_DARK = { r: 0.10196, g: 0.10196, b: 0.12156 }; // #1A1A1F\n  const COLOR_GRAY_TEXT = { r: 0.54117, g: 0.5647, b: 0.59215 };\n  const COLOR_LIGHT_BG = { r: 0.96078, g: 0.9686, b: 0.97647 }; // #F5F7F9\n  const COLOR_BORDER = { r: 0.898, g: 0.91, b: 0.925 };\n  const COLOR_GOLD = { r: 0.96, g: 0.65, b: 0.13 }; // Star rating\n\n  // =========================================================================\n  // FRAME 1: 01_Splash\n  // =========================================================================\n  const frameSplash = figma.createFrame();\n  frameSplash.name = '01_Splash';\n  frameSplash.resize(430, 932);\n  frameSplash.x = 0; frameSplash.y = 0;\n  frameSplash.fills = [{ type: 'SOLID', color: COLOR_TEAL }];\n  frameSplash.clipsContent = true;\n\n  const sb1 = createStatusBar(true);\n  sb1.x = 0; sb1.y = 0;\n  frameSplash.appendChild(sb1);\n\n  const hi1 = createHomeIndicator(true);\n  hi1.x = 0; hi1.y = 932 - 34;\n  frameSplash.append