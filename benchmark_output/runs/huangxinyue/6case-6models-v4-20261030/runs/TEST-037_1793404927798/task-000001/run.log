GH\";\n    if (opts.align) t.textAlignHorizontal = opts.align;\n    if (opts.lh) t.lineHeight = {value: opts.lh, unit:\"PIXELS\"};\n  }\n  return t;\n}\nfunction R(w,h,color,radius) {\n  const r = figma.createRectangle();\n  r.resize(w,h);\n  if (color) r.fills = [{type:\"SOLID\", color}]; else r.fills = [];\n  if (radius) r.cornerRadius = radius;\n  return r;\n}\nfunction instOf(id, w, h) {\n  const c = figma.getNodeByIdAsync(id);\n  return c.then(n => {\n    const i = n.createInstance();\n    if (w && h) i.resize(w,h);\n    return i;\n  });\n}\n// stash helpers globally for later calls in same session? Not persisted across calls, so we re-declare each call.\n// Save tokens + ids as plugin data on page for later calls is not allowed (setPluginData unsupported).\n// Return confirmation\nreturn \"setup ok · page: \" + ws.name + \" · fonts loaded\";","description":"Load Montserrat fonts and set workspace page current"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"14b42764-d761-4609-9d48-7eed784bda72","uuid":"8d636f4f-05ca-4faf-b589-50289fa9bb4f","timestamp":"2026-10-31T00:08:20.739Z","tool_use_meta":[{"id":"mcp__figma__use_figma_14_5fda34a5","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
