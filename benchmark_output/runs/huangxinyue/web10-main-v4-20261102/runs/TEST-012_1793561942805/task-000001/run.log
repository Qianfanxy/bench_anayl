={}){const t=figma.createText();t.fontName={family:'Inter',style:'Regular'};t.characters=chars;await t.setTextStyleIdAsync(S[style].id);t.fills=[paint(color)];if(o.name)t.name=o.name;if(o.align)t.textAlignHorizontal=o.align;if(o.parent){o.parent.appendChild(t);if(o.fillW){t.layoutSizingHorizontal='FILL';t.textAutoResize='HEIGHT';}}if(o.w){t.resize(o.w,t.height);t.textAutoResize='HEIGHT';}return t;}\nconst N=async id=>await figma.getNodeByIdAsync(id);\nconst C={hdr:await N('11:9'),ftr:await N('11:31'),navCur:await N('11:6'),promo:await N('12:76'),nl:await N('12:110'),side:await N('13:78'),art:await N('13:96'),search:await N('13:107'),pgSet:await N('13:120'),pn:await N('13:121')};\nconst pgDef=C.pgSet.children.find(c=>c.name==='State=Default'), pgCur=C.pgSet.children.find(c=>c.name==='State=Current');\nfunction swap(inst,name,photo){const p=inst.findOne(n=>n.name===name&&n.type==='INSTANCE');const w=p.width,h=p.height;p.swapComponent(M[photo]);return p;}\nfunction page(name,x,cur){const f=F(name,'VERTICAL',{w:1440,fill:'surface/white',cross:'CENTER'});f.x=x;f.y=0;f.clipsContent=true;const h=C.hdr.createInstance();f.appendChild(h);h.findOne(n=>n.name==='Nav / '+cur).swapComponent(C.navCur);const body=F('Content','VERTICAL',{w:1440,gap:120,p:[80,80,120,80],cross:'CENTER',parent:f});return {f,body};}\nconst {f,body}=page('03_Blog',3080,'Blog'); let target;\ntry{\nconst intro=F('Page Intro','VERTICAL',{gap:24,cross:'CENTER',parent:body,fillW:true});\nawait T('Blog & Article','Display','text/primary',{parent:intro,align:'CENTER'});\nawait T('Recipes, kitchen tips and stories from the Foodieland team.','Body L','text/secondary',{parent:intro,align:'CENTER'});\nconst sb=C.search.createInstance(); intro.appendChild(sb); sb.name='Search Bar';\nintro.itemSpacing=24; const sp=intro.children[1]; \nconst cols=F('Blog Body','HORIZONTAL',{gap:40,parent:body,fillW:true});\nconst left=F('Articles','VERTICAL',{w:840,gap:48,parent:cols});\nconst arts=[['Crochet Projects for Noodle Lover