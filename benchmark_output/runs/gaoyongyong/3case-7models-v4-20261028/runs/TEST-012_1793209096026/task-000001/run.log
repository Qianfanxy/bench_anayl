p;f.counterAxisAlignItems='MIN';return f;}\nfunction row(name,sp){const f=figma.createFrame();f.name=name;f.fills=[];f.layoutMode='HORIZONTAL';f.itemSpacing=sp;f.counterAxisAlignItems='CENTER';return f;}\n\nconst s=figma.createFrame();s.name='06_Notification';s.resize(414,932);s.fills=S(C.surf);s.clipsContent=true;s.x=3500;s.y=0;\nconst sb=(await figma.getNodeByIdAsync('48:43')).createInstance();s.appendChild(sb);sb.x=0;sb.y=0;\n\nconst hd=row('header',12);hd.resize(414,64);\nhd.paddingLeft=24;hd.paddingRight=24;\ns.appendChild(hd);hd.x=0;hd.y=44;\nconst back=await icon('6:275',24,C.t1);back.name='btn_back';hd.appendChild(back);\nconst ttl=txt('Notification',20,'Bold','DM Sans',C.t1,26);ttl.name='page_title';hd.appendChild(ttl);\n\nconst body=col('content',12);body.resize(414,700);\nbody.paddingTop=16;body.paddingBottom=28;body.paddingLeft=30;body.paddingRight=30;\ns.appendChild(body);body.x=0;body.y=108;\n\nconst src=await figma.getNodeByIdAsync('2009:93');\nconst items=[['Where do you see yourself in the next ages?','30 secs ago'],\n ['Check out today’s best investor. You’ll learn from him.','3 min ago'],\n ['Apple stocks just increased. Check it out now.','15 min ago']];\nfor(const [msg,time] of items){\n  const n=src.createInstance();n.name='NotificationRow/'+msg.slice(0,10);body.appendChild(n);n.layoutAlign='STRETCH';\n  n.findOne(t=>t.name==='message').characters=msg;\n  n.findOne(t=>t.name==='time').characters=time;\n}\n\nconst hi=(await figma.getNodeByIdAsync('48:54')).createInstance();s.appendChild(hi);hi.x=0;hi.y=898;\nreturn JSON.stringify({removed:staleIds,notif:s.id,bodyH:Math.round(body.height)});\n","description":"Rebuild 06_Notification cleanly with 3 notification rows","fileKey":"j3A0ecMMlYQqRT10ygTiTe","skillNames":"resource:figma-use"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":27609,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id