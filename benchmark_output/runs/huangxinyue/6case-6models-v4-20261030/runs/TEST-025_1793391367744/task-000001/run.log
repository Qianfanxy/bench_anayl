me=\"Fixed vs yours\" x=\"0\" y=\"49\" width=\"1312\" height=\"243\">\n          <frame id=\"1:166\" name=\"Fixed (given)\" x=\"0\" y=\"0\" width=\"644\" height=\"243\">\n            <text id=\"1:167\" name=\"Fixed (given)\" x=\"24\" y=\"24\" width=\"596\" height=\"24\" />\n            <text id=\"1:168\" name=\"• Frame list and exact names • Must-include content per frame (what, not how) • Navigation structure and links • All data and copy • Brand primary color + Montserrat • Media: logo, product photos, banners, payment logos, icons, illustrated avatar • Default Button, default Text Field, platform shell\" x=\"24\" y=\"58\" width=\"596\" height=\"161\" />\n          </frame>\n          <frame id=\"1:169\" name=\"Yours (designer decides)\" x=\"668\" y=\"0\" width=\"644\" height=\"220\">\n            <text id=\"1:170\" name=\"Yours (designer decides)\" x=\"24\" y=\"24\" width=\"596\" height=\"24\" />\n            <text id=\"1:171\" name=\"• Layout, grouping, order and emphasis on every screen • All other colors: neutrals, text, surfaces, semantic, sale and rating colors • Type scale, spacing, radii, elevation • All states: selected, pressed, disabled, focused, current slide / step • Headers, main navigation, product cards, dialogs and all business components • How prices, discounts and ratings are shown\" x=\"24\" y=\"58\" width=\"596\" height=\"138\" />\n          </frame>\n        </frame>\n      </frame>\n      <frame id=\"1:172\" name=\"How it is evaluated\" x=\"64\" y=\"6001\" width=\"1312\" height=\"296\">\n        <text id=\"1:173\" name=\"How it is evaluated\" x=\"0\" y=\"0\" width=\"1312\" height=\"33\" />\n        <text id=\"1:174\" name=\"Your file is compared with the brief on coverage, data and flow — not on visual similarity to any reference.\" x=\"0\" y=\"49\" width=\"1312\" height=\"23\" />\n        <text id=\"1:175\" name=\"1. Checklist coverage per frame 2. Data &amp; copy accuracy 3. Flow &amp; prototype completeness 4. Information hierarchy 5. Visual quality &amp; consistency of your own system 6. Component reuse 7. State design (current tab, size, slide, step and payment method; empty forms)\" x=\"0\" y=\"88\" width=\"1312\" height=\"168\" />\n        <text id=\"1:176\" name=\"Deliverable: the link to your own Figma file containing the 15 named frames, your components and the prototype.\" x=\"0\" y=\"272\" width=\"1312\" height=\"24\" />\n      </frame>\n    </frame>\n  </frame>\n</canvas>"},{"type":"text","text":"IMPORTANT: After you call this tool, you MUST call get_design_context if trying to implement the design, since this tool only returns metadata. If you do not call get_design_context, the agent will not be able to implement the design."}],"_meta":{"mcpRequestId":"e926a8ed-8347-4621-ba39-852892fcc92f"}},"tool_result_meta":[{"id":"call_2525cc30076740c4bf787c91","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
