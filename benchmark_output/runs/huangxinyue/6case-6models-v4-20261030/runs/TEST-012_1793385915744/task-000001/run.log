{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_bdrk_rbcoejd7terclebhmzk2rxzxvfxcnkmhclmztpxwdqxzzrmrkbba","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Msq6eRHAVquG5h1g3DYThT","name":"mcp__figma__use_figma","input":{"code":"const P='Poppins';\nfor (const s of ['Regular','Medium','SemiBold','Bold']) await figma.loadFontAsync({family:P,style:s});\nconst page=await figma.getNodeByIdAsync('7:2'); await figma.setCurrentPageAsync(page);\nconst V={}; for (const v of await figma.variables.getLocalVariablesAsync()) V[v.name]=v;\nconst TS={}; for (const s of await figma.getLocalTextStylesAsync()) TS[s.name.replace('Nectar/','')]=s;\nconst ES={}; for (const s of await figma.getLocalEffectStylesAsync()) ES[s.name]=s;\nconst paint=(k,o)=>figma.variables.setBoundVariableForPaint({type:'SOLID',color:{r:0,g:0,b:0},opacity:o??1},'color',V[k]);\nconst fill=(n,k,o)=>{n.fills=[paint(k,o)];return n;};\nconst stroke=(n,k,w=1,o)=>{n.strokes=[paint(k,o)];n.strokeWeight=w;n.strokeAlign='INSIDE';return n;};\nasync function T(chars,style='Body/Medium',color='text/primary'){const t=figma.createText();await t.setTextStyleIdAsync(TS[style].id);t.characters=chars;fill(t,color);return t;}\nconst isWhite=c=>c.r>0.95&&c.g>0.95&&c.b>0.95;\nfunction recolor(node,key){const all=[node,...(node.findAll?node.findAll(()=>true):[])];for(const n of all){if(n.isMask)continue;if('fills' in n&&Array.isArray(n.fills)&&n.fills.length&&n.type!=='INSTANCE'&&n.type!=='COMPONENT')n.fills=n.fills.map(f=>f.type==='SOLID'&&!isWhite(f.color)?paint(key):f);if('strokes' in n&&Array.isArray(n.strokes)&&n.strokes.length&&n.type!=='INSTANCE'&&n.type!=='COMPONENT')n.strokes=n.strokes.map(f=>f.type==='SOLID'&&!isWhite(f.color)?paint(key):f);}}\nconst sec=await figma.getNodeByIdAsync('10:2');\nconst comp=async id=>await figma.getNodeByIdAsync(id);\nconst myc=name=>sec.findOne(n=>(n.type==='COMPONENT'||n.type==='COMPONENT_SET')&&n.name===name);\nconst icon=async name=>myc('Icon/'+name).createInstance();\nconst label=async(txt,x,y)=>{const t=await T(txt,'Caption/Medium','text/secondary'); sec.appendChild(t); t.x=x; t.y=y; return t;};\nfunction AL(name,dir,o={}){const f=o.comp?figma.createComponent():figma.createFrame();f.name=name;f.layoutMode=dir;f.fills=[];if(o.w||o.h)f.resize(o.w||100,o.h||100);f.layoutSizingHorizontal=o.w?'FIXED':'HUG';f.layoutSizingVertical=o.h?'FIXED':'HUG';f.itemSpacing=o.gap??0;const p=o.pad??0;const [pt,pr,pb,pl]=Array.isArray(p)?(p.length===2?[p[0],p[1],p[0],p[1]]:p):[p,p,p,p];f.paddingTop=pt;f.paddingRight=pr;f.paddingBottom=pb;f.paddingLeft=pl;f.counterAxisAlignItems=o.align||'CENTER';f.primaryAxisAlignItems=o.justify||'CENTER';if(o.fill)fill(f,o.fill);if(o.r!=null)f.cornerRadius=o.r;return f;}\nconst media=async(id,w,h)=>{const i=(await comp(id)).createInstance(); i.resize(w,h); return i;};\nconst addSet=myc('Add Button');\n\n// ---- Product Card\nawait label('Product Card · image (Fit) · name · unit · price · add to cart',40,600);\nconst pc=AL('Product Card','VERTICAL',{comp:true,w:173,h:248,r:18,pad:[20,15,16,15],gap:0,align:'MIN',justify:'MIN',fill:'surface/base'}); stroke(pc,'border/default');\nconst imgBox=AL('Image','HORIZONTAL',{w:143,h:90}); const pimg=await media('4:49',130,90); pimg.name='Product Image'; imgBox.appendChild(pimg); pc.appendChild(imgBox);\nconst sp1=figma.createFrame(); sp1.name='Spacer'; sp1.fills=[]; sp1.resize(10,24); pc.appendChild(sp1);\nconst nm=await T('Organic Bananas','Body/Strong'); nm.name='Name'; pc.appendChild(nm); nm.layoutSizingHorizontal='FILL'; nm.textTruncation='ENDING'; nm.maxLines=1;\nconst un=await T('7pcs, Price','Caption','text/secondary'); un.name='Unit'; pc.appendChild(un);\nconst grow=figma.createFrame(); grow.name='Spacer'; grow.fills=[]; grow.resize(10,10); pc.appendChild(grow); grow.layoutGrow=1;\nconst row=AL('Price Row','HORIZONTAL',{justify:'SPACE_BETWEEN'}); pc.appendChild(row); row.layoutSizingHorizontal='FILL';\nconst pr=await T('$4.99','Subhead'); pr.name='Price'; row.appendChild(pr);\nconst ab=addSet.defaultVariant.createInstance(); ab.name='Add To Cart'; row.appendChild(ab);\nconst pN=pc.addComponentProperty('Name','TEXT','Organic Bananas'); nm.componentPropertyReferences={characters:pN};\nconst pU=pc.addComponentProperty('Unit','TEXT','7pcs, Price'); un.componentPropertyReferences={characters:pU};\nconst pP=pc.addComponentProperty('Price','TEXT','$4.99'); pr.componentPropertyReferences={characters:pP};\nconst pI=pc.addComponentProperty('Image','INSTANCE_SWAP',(await comp('4:49')).id); pimg.componentPropertyReferences={mainComponent:pI};\nsec.appendChild(pc); pc.x=40; pc.y=630;\n\n// ---- Category Chip (home groceries)\nawait label('Category Chip · Home groceries · Color variants',260,600);\nconst chips=[];\nfor (const [cname,ck] of [['Orange','category/orange'],['Green','category/green']]) {\n const c=AL('Color='+cname,'HORIZONTAL',{comp:true,w:248,h:105,r:18,pad:[0,20],gap:16,justify:'MIN'}); fill(c,ck,0.15);\n const im=await media('4:82',72,72); im.name='Category Image'; c.appendChild(im);\n const t=await T('Pulses','Heading','text/primary'); t.name='Name'; c.appendChild(t); chips.push(c);\n}\nconst chipSet=figma.combineAsVariants(chips,sec); chipSet.name='Category Chip'; chipSet.layoutMode='HORIZONTAL'; chipSet.itemSpacing=16; chipSet.paddingTop=chipSet.paddingLeft=chipSet.paddingRight=chipSet.paddingBottom=16; chipSet.layoutSizingHorizontal='HUG'; chipSet.layoutSizingVertical='HUG'; chipSet.x=260; chipSet.y=630; fill(chipSet,'surface/base'); chipSet.cornerRadius=16;\n{const a=chipSet.addComponentProperty('Name','TEXT','Pulses'); const b=chipSet.addComponentProperty('Image','INSTANCE_SWAP','4:82'); for(const c of chipSet.children){c.findOne(n=>n.name==='Name').componentPropertyReferences={characters:a}; c.findOne(n=>n.name==='Category Image').componentPropertyReferences={mainComponent:b};}}\n\n// ---- Category Card (explore)\nawait label('Category Card · Explore · 6 colour variants',860,600);\nconst cards=[];\nfor (const [cname,ck] of [['Green','category/green'],['Orange','category/orange'],['Red','category/red'],['Purple','category/purple'],['Yellow','category/yellow'],['Blue','category/blue']]) {\n const c=AL('Color='+cname,'VERTICAL',{comp:true,w:175,h:190,r:18,pad:[24,16,20,16],gap:22,justify:'MIN'}); fill(c,ck,0.12); stroke(c,ck,1,0.7);\n const im=await media('4:76',112,76); im.name='Category Image'; c.appendChild(im);\n const t=await T('Fresh Fruits & Vegetable','Body/Strong','text/primary'); t.name='Name'; t.textAlignHorizontal='CENTER'; c.appendChild(t); t.layoutSizingHorizontal='FILL'; t.textAutoResize='HEIGHT'; cards.push(c);\n}\nconst cset=figma.combineAsVariants(cards,sec); cset.name='Category Card'; cset.layoutMode='HORIZONTAL'; cset.itemSpacing=16; cset.paddingTop=cset.paddingLeft=cset.paddingRight=cset.paddingBottom=16; cset.layoutSizingHorizontal='HUG'; cset.layoutSizingVertical='HUG'; cset.x=860; cset.y=630; fill(cset,'surface/base'); cset.cornerRadius=16;\n{const a=cset.addComponentProperty('Name','TEXT','Fresh Fruits & Vegetable'); const b=cset.addComponentProperty('Image','INSTANCE_SWAP','4:76'); for(const c of cset.children){c.findOne(n=>n.name==='Name').componentPropertyReferences={characters:a}; c.findOne(n=>n.name==='Category Image').componentPropertyReferences={mainComponent:b};}}\n\n// ---- Section Header\nawait label('Section Header · title + See all',40,920);\nconst sh=AL('Section Header','HORIZONTAL',{comp:true,w:364,justify:'SPACE_BETWEEN'}); const st=await T('Exclusive Offer','Display'); st.name='Title'; sh.appendChild(st); const sa=await T('See all','Body/Medium','brand/primary'); sa.name='See all'; sh.appendChild(sa);\n{const a=sh.addComponentProperty('Title','TEXT','Exclusive Offer'); st.componentPropertyReferences={characters:a};}\nsec.appendChild(sh); sh.x=40; sh.y=950;\n\n// ---- Search Bar\nawait label('Search Bar · empty (placeholder)',440,920);\nconst sb=AL('Search Bar','HORIZONTAL',{comp:true,w:364,h:52,r:15,pad:[0,16],gap:10,justify:'MIN',fill:'surface/subtle'}); const si=(await comp('4:160')).createInstance(); si.resize(18,18); sb.appendChild(si); const sbt=await T('Search Store','Caption/Medium','text/secondary'); sbt.name='Placeholder'; sb.appendChild(sbt);\n{const a=sb.addComponentProperty('Placeholder','TEXT','Search Store'); sbt.componentPropertyReferences={characters:a};}\nsec.appendChild(sb); sb.x=440; sb.y=950;\n\n// ---- Promo Banner\nawait label('Promo Banner · Fresh Vegetables',840,920);\nconst pb=figma.createComponent(); pb.name='Promo Banner'; pb.resize(364,115); pb.cornerRadius=12; pb.clipsContent=true;\npb.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[1,0,0],[0,1,0]],gradientStops:[{position:0,color:{r:0.98,g:0.97,b:0.94,a:1}},{position:1,color:{r:0.93,g:0.97,b:0.94,a:1}}]}];\nconst bimg=await media('4:91',150,115); pb.appendChild(bimg); bimg.x=-6; bimg.y=0;\nconst bt1=await T('Fresh Vegetables','Heading'); pb.appendChild(bt1); bt1.x=168; bt1.y=30;\nconst bt2=await T('Get Up To 40% OFF','Body/Medium','brand/primary'); pb.appendChild(bt2); bt2.x=168; bt2.y=60;\nconst dots=AL('Pager','HORIZONTAL',{gap:4}); for(let i=0;i<3;i++){const d=figma.createRectangle(); d.resize(i===0?16:4,4); d.cornerRadius=2; fill(d,i===0?'brand/primary':'border/strong'); dots.appendChild(d);} pb.appendChild(dots); dots.x=(364-dots.width)/2; dots.y=100;\nsec.appendChild(pb); pb.x=840; pb.y=950;\n\n// ---- Location label\nawait label('Location Label',1240,920);\nconst ll=AL('Location Label','HORIZONTAL',{comp:true,gap:8}); const li=await icon('Location'); recolor(li,'text/primary'); ll.appendChild(li); const lt=await T('Dhaka, Banasree','Subhead','text/primary'); lt.name='Location'; ll.appendChild(lt);\nsec.appendChild(ll); ll.x=1240; ll.y=950;\nreturn 'ok';","description":"Build product card, category chip/card, section header, search, banner, location components","fileKey":"UlgozbXKKfkCkJL2xcXBBr"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{