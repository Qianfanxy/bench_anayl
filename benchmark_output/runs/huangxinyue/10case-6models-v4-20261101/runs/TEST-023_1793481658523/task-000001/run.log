{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgLvxsYmawxeRJEbmvIGD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PsmAfWnCAPB2argIPnou37","name":"mcp__figma__use_figma","input":{"code":"\nfor (const s of ['Regular','Medium','Semi Bold','Bold']) await figma.loadFontAsync({family:'Roboto',style:s});\nconst C={bg:'#0E0F13',surface:'#17181E',surface2:'#1F2028',surface3:'#282A33',border:'#2C2E38',text:'#F2F2F2',text2:'#9EA0AD',text3:'#6E7080',brand:'#279646',gain:'#2FBF71',loss:'#F0554B'};\nconst rgb=h=>{h=h.replace('#','');return{r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255};};\nconst paint=h=>[{type:'SOLID',color:rgb(h)}];\nfunction text(parent,name,chars,color,size,weight,lh){const t=figma.createText();t.name=name;t.fontName={family:'Roboto',style:weight||'Regular'};t.characters=chars;t.fontSize=size;t.lineHeight={unit:'PIXELS',value:lh||Math.round(size*1.35)};t.fills=paint(color);parent.appendChild(t);return t;}\nfunction box(name,w,h,fill,radius){const f=figma.createFrame();f.name=name;f.resize(w,h);f.fills=fill?paint(fill):[];f.clipsContent=true;if(radius!==undefined)f.cornerRadius=radius;return f;}\nasync function inst(id,parent,w,h){const n=await figma.getNodeByIdAsync(id);const i=n.createInstance();if(w){i.resize(w,h||w);}parent.appendChild(i);return i;}\nconst root=await figma.getNodeByIdAsync('7:11');\n\n// ---- Ticker card (Trending Hari ini) ----\nconst tcV=[];\nfor(const up of [true,false]){\n  const c=figma.createComponent();c.name='State='+(up?'Gain':'Loss');c.resize(104,110);\n  c.fills=paint(C.surface);c.strokes=paint(C.border);c.strokeWeight=1;c.strokeAlign='INSIDE';c.cornerRadius=14;\n  c.layoutMode='NONE';c.clipsContent=true;\n  const logo=await inst('3:5',c,34,34);logo.name='Logo';logo.x=12;logo.y=12;\n  const tk=text(c,'Ticker','BRRI',C.text,13,'Semi Bold',17);tk.x=12;tk.y=54;\n  const pr=text(c,'Price','8.600',C.text,12,'Regular',16);pr.x=12;pr.y=72;\n  const ch=text(c,'Change','+50 (+0,58%)',up?C.gain:C.loss,10,'Medium',13);ch.x=12;ch.y=90;\n  try{c.addComponentProperty('Logo','INSTANCE_SWAP','3:5');}catch(e){return 'e:'+e.message;}\n  root.appendChild(c);tcV.push(c);\n}\nconst tcSet=figma.combineAsVariants(tcV,root);tcSet.name='Ticker Card';tcSet.x=32;tcSet.y=1340;\n\n// ---- Index card ----\nconst ixV=[];\nfor(const up of [true,false]){\n  const c=figma.createComponent();c.name='State='+(up?'Rising':'Falling');c.resize(109,80);\n  c.fills=paint(C.surface2);c.cornerRadius=12;c.layoutMode='NONE';\n  const nm=text(c,'Name','IHSG',C.text2,11,'Medium',14);nm.x=12;nm.y=10;\n  const v=text(c,'Value','7.206,92',C.text,13,'Semi Bold',18);v.x=12;v.y=27;\n  const ic=await inst(up?'2:10':'2:13',c,11,11);ic.x=12;ic.y=48;\n  const ch=text(c,'Change',up?'+0,42%':'−0,18%',up?C.gain:C.loss,10,'Medium',12);ch.x=26;ch.y=46;\n  root.appendChild(c);ixV.push(c);\n}\nconst ixSet=figma.combineAsVariants(ixV,root);ixSet.name='Index Card';ixSet.x=300;ixSet.y=1340;\n\n// ---- Recommendation card ----\nconst recV=[];\nfor(const up of [true,false]){\n  const c=figma.createComponent();c.name='State='+(up?'Gain':'Loss');c.resize(107,100);\n  c.fills=paint(C.surface);c.strokes=paint(C.border);c.strokeWeight=1;c.strokeAlign='INSIDE';c.cornerRadius=14;\n  c.layoutMode='NONE';\n  const bd=box('Badge',32,32,up?'#153026':'#33181A',10);c.appendChild(bd);bd.x=12;bd.y=12;\n  bd.layoutMode='HORIZONTAL';bd.primaryAxisAlignItems='CENTER';bd.counterAxisAlignItems='CENTER';\n  text(bd,'Initial','N',up?C.gain:C.loss,13,'Bold',16);\n  const tk=text(c,'Ticker','NFLX',C.text,13,'Semi Bold',17);tk.x=12;tk.y=50;\n  const pr=text(c,'Price','2.122.340',C.text,11,'Regular',15);pr.x=12;pr.y=66;\n  const ch=text(c,'Change','−0,20%',up?C.gain:C.loss,10,'Medium',13);ch.x=12;ch.y=82;\n  root.appendChild(c);recV.push(c);\n}\nconst recSet=figma.combineAsVariants(recV,root);recSet.name='Recommendation Card';recSet.x=460;recSet.y=1340;\nreturn 'ok '+tcSet.id+' '+ixSet.id+' '+recSet.id+' | '+tcV.map(c=>c.id).join(',')+' | '+ixV.map(c=>c.id).join(',')+' | '+recV.map(c=>c.id).join(',');\n","description":"Create ticker card, index card and recommendation card component sets","fileKey":"4vKKpRHOlbMS1w0BzHKmKz"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":57290,"input_tokens":1,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":57290}},"context_management":null},"parent_tool_use_id":null,"session_id":"6dc355e0-32b3-4413-a395-2651983398f3","uuid":"64e315bb-0ab2-488a-b914-0ee801f6110a","timestamp":"2026-10-31T21:31:27.863Z","tool_use_meta":[{"id":"toolu_01PsmAfWnCAPB2argIPnou37","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
