{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_b9a5e2c6b6ee43b6b8b7b4b7","name":"mcp__figma__use_figma","input":{"code":"const page = await figma.getNodeByIdAsync('7:2');\nawait figma.setCurrentPageAsync(page);\nawait figma.loadFontAsync({family:'Lato', style:'Regular'});\nawait figma.loadFontAsync({family:'Lato', style:'Bold'});\nawait figma.loadFontAsync({family:'Lato', style:'Black'});\nconst S = hex => { const n = parseInt(hex.slice(1),16); return {type:'SOLID', color:{r:((n>>16)&255)/255, g:((n>>8)&255)/255, b:(n&255)/255}}; };\nconst SWhiteA = a => ({type:'SOLID', color:{r:1,g:1,b:1}, opacity:a});\nconst IDs = {photos:{\"Photo_Onboarding\":\"9:21\",\"Photo_Hand_Training\":\"9:25\",\"Photo_Knee_Push_Up\":\"9:27\",\"Photo_Push_Up\":\"9:32\",\"Photo_Sit_Up\":\"9:34\"},icons:{\"Icon_Search\":\"9:71\"}};\nconst C = {tag_Beginner:\"10:2\",tag_Intermediate:\"10:4\",tag_Expert:\"10:6\",statChip:\"10:8\",dayOff:\"10:16\",dayOn:\"10:19\",btnBack:\"10:22\",btnPlay:\"10:25\",section:\"10:28\",pageTitle:\"10:30\",navBar:\"10:32\",metric:\"10:34\",workoutCard:\"10:43\",planRow:\"10:58\",programTile:\"10:67\",challenge:\"10:77\",programRow:\"10:81\",roundRow:\"10:91\",tabOn_Home:\"10:98\",tabOff_Home:\"10:103\",tabOn_Explore:\"10:107\",tabOff_Explore:\"10:116\",tabOn_Analytics:\"10:124\",tabOff_Analytics:\"10:131\",tabOn_Profile:\"10:137\",tabOff_Profile:\"10:143\",tabBar:\"10:148\"};\nconst DEF = {button:\"9:2\", textField:\"9:4\", statusBar:\"9:8\", homeInd:\"9:19\"};\nconst out = {frames:{}};\nconst LIME='#BBF246', DARK='#192126', SEC='#667069', TER='#98A19B', BG='#F6F7F4', WHITE='#FFFFFF';\nasync function node(id){ return await figma.getNodeByIdAsync(id); }\nfunction T(chars, size, style, hex, opts = {}) {\n  const t = figma.createText();\n  t.fontName = {family:'Lato', style};\n  t.fontSize = size;\n  t.characters = chars;\n  t.fills = [S(hex)];\n  if (opts.w) { t.textAutoResize = 'HEIGHT'; t.resize(opts.w, t.height); }\n  if (opts.align) t.textAlignHorizontal = opts.align;\n  if (opts.lh) t.lineHeight = {unit:'PIXELS', value: opts.lh};\n  t.name = opts.name || chars;\n  return t;\n}\nasync function icon(name, size, hex, weight) {\n  const c = await node(IDs.icons[name]);\n  const i = c.createInstance(); i.resize(size, size);\n  if (hex) { for (const n of i.findAll(()=>true)) { if ('strokes' in n && n.strokes.length) { n.strokes=[S(hex)]; if (weight) n.strokeWeight=weight; } else if ('fills' in n && n.fills.length && n.fills.some(f=>f.visible)) n.fills=[S(hex)]; } }\n  return i;\n}\nfunction frame(name, x, bg) { const f = figma.createFrame(); f.name=name; f.resize(390,844); f.x=x; f.y=0; f.fills=[S(bg)]; f.clipsContent=true; page.appendChild(f); out.frames[name]=f.id; return f; }\nasync function inst(compId, parent, x, y, name) { const c = await node(compId); const i = c.createInstance(); i.x=x; i.y=y; if (name) i.name=name; parent.appendChild(i); return i; }\nfunction recolorSkip(node, paint, skip) {\n  for (const n of [node, ...node.findAll(()=>true)]) {\n    if (skip && skip.includes(n.name)) continue;\n    if ('strokes' in n && Array.isArray(n.strokes) && n.strokes.length) n.strokes=[paint];\n    else if ('fills' in n && Array.isArray(n.fills) && n.fills.length && n.fills.some(f=>f.visible)) n.fills=[paint];\n  }\n}\n\n// ============ 01_Onboarding ============\n{\n  const f = frame('01_Onboarding', 0, DARK);\n  const p = await node(IDs.photos.Photo_Onboarding); const pi = p.createInstance(); pi.resize(390,844); pi.x=0; pi.y=0; pi.name='Photo'; f.appendChild(pi);\n  const grad = figma.createRectangle(); grad.resize(390,844); grad.x=0; grad.y=0; grad.name='Gradient';\n  const gc = {r:0.055,g:0.078,b:0.07};\n  grad.fills=[{type:'GRADIENT_LINEAR', gradientTransform:[[0,1,0],[-1,0,1]], gradientStops:[\n    {position:0, color:{...gc, a:0.30}}, {position:0.4, color:{...gc, a:0.25}}, {position:0.68, color:{...gc, a:0.78}}, {position:1, color:{...gc, a:0.97}}]}];\n  f.appendChild(grad);\n  const sb = await inst(DEF.statusBar, f, 0, 0, 'Status Bar');\n  recolorSkip(sb, SWhiteA(1), ['Notch']);\n  const title = T('Wherever you are, health is number one', 30, 'Black', WHITE, {name:'Title', w:330, align:'CENTER', lh:38});\n  title.x=30; title.y=570; f.appendChild(title);\n  const sub = T('There is no instant way to a healthy life', 15, 'Regular', WHITE, {name:'Subtitle', w:330, align:'CENTER'});\n  sub.opacity=0.75; sub.x=30; sub.y=668; f.appendChild(sub);\n  const btn = await inst(DEF.button, f, 20, 730, 'Get Started');\n  btn.fills=[S(LIME)];\n  const bt = btn.findOne(n=>n.type==='TEXT'); if (bt) bt.fills=[S(DARK)];\n  const hi = await inst(DEF.homeInd, f, 0, 810, 'Home Indicator');\n  recolorSkip(hi, SWhiteA(1), []);\n}\n// ============ 02_Home ============\n{\n  const f = frame('02_Home', 470, BG);\n  await inst(DEF.statusBar, f, 0, 0, 'Status Bar');\n  const g = T('Good Morning 🔥', 13, 'Regular', SEC, {name:'Greeting'}); g.x=20; g.y=58; f.appendChild(g);\n  const nm = T('Pramuditya Uzumaki', 22, 'Bold', DARK, {name:'Name'}); nm.x=20; nm.y=76; f.appendChild(nm);\n  const tf = await inst(DEF.textField, f, 20, 89, 'Search');\n  const lbl = tf.findOne(n=>n.type==='TEXT'); if (lbl) lbl.visible=false;\n  const si = await icon('Icon_Search', 20, TER, 1.5); si.x=336; si.y=128; si.name='SearchIcon'; f.appendChild(si);\n  const sh1 = await inst(C.section, f, 20, 178, 'Popular Workouts Header');\n  sh1.findOne(n=>n.type==='TEXT').characters='Popular Workouts';\n  const wc1 = await inst(C.workoutCard, f, 20, 210, 'Card - Lower Body Training');\n  const wc2 = await inst(C.workoutCard, f, 20, 342, 'Card - Hand Training');\n  const ph2 = wc2.findOne(n=>n.name==='Photo'); const hm = await node(IDs.photos.Photo_Hand_Training); await ph2.swapComponent(hm);\n  wc2.findOne(n=>n.name==='Title').characters='Hand Training';\n  wc2.findOne(n=>n.name==='Kcal').characters='600 Kcal';\n  wc2.findOne(n=>n.name==='Min').characters='40 Min';\n  const sh2 = await inst(C.section, f, 20, 478, 'Today Plan Header');\n  sh2.findOne(n=>n.type==='TEXT').characters='Today Plan';\n  const rows = [\n    ['Row - Push Up', IDs.photos.Photo_Push_Up, 'Push Up', '100 push ups a day', 45, C.tag_Intermediate],\n    ['Row - Sit Up', IDs.photos.Photo_Sit_Up, 'Sit Up', '20 sit ups a day', 75, C.tag_Beginner],\n    ['Row - Knee Push Up', IDs.photos.Photo_Knee_Push_Up, 'Knee Push Up', '20 knee push ups a day', 45, C.tag_Beginner],\n  ];\n  let y = 510;\n  for (const [nm2, phId, title, goal, pct, tagId] of rows) {\n    const r = await inst(C.planRow, f, 20, y, nm2);\n    const ph = r.findOne(n=>n.name==='Photo'); const pm = await node(phId); await ph.swapComponent(pm);\n    r.findOne(n=>n.name==='Title').characters=title;\n    r.findOne(n=>n.name==='Goal').characters=goal;\n    r.findOne(n=>n.name==='Fill').resize(Math.round(110*pct/100), 6);\n    r.findOne(n=>n.name==='Pct').characters=pct + '%';\n    const tg = r.findOne(n=>n.name==='Level'); const tm = await node(tagId); await tg.swapComponent(tm);\n    y += 82;\n  }\n  const tb = await inst(C.tabBar, f, 0, 756, 'Tab Bar');\n  const homeItem = tb.findOne(n=>n.name==='Home'); const on = await node(C.tabOn_Home); await homeItem.swapComponent(on);\n  await inst(DEF.homeInd, f, 0, 810, 'Home Indicator');\n}\nreturn JSON.stringify(out);","description":"Build frames 01_Onboarding and 02_Home with content, component instances and state overrides","fileKey":"tIT4HK1NS7E5MTNQAw4d7q"}}],"id":"e4986e15-abbe-41ff-b3d4-ff7e343ce5ec","model":"glm-5.3-flash","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"0f6b2263-6330-4721-ac9b-b0791a58bf93","uuid":"b2440daf-bba6-4218-9644-e00216263550","timestamp":"2026-11-02T07:29:22.634Z","tool_use_meta":[{"id":"call_b9a5e2c6b6ee43b6b8b7b4b7","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
