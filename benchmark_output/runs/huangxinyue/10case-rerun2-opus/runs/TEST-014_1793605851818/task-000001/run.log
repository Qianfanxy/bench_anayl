(name){const s=AL('Section · '+name,'VERTICAL',{gap:16,ca:'MIN'}); s.appendChild(await T(name,'Overline/12 SemiBold','text/secondary')); root.appendChild(s); return s;}\nfunction setify(comps,name,sec,dir='HORIZONTAL'){const set=figma.combineAsVariants(comps,sec); set.name=name; set.layoutMode=dir; set.primaryAxisSizingMode='AUTO'; set.counterAxisSizingMode='AUTO'; set.itemSpacing=24; set.paddingTop=set.paddingBottom=set.paddingLeft=set.paddingRight=24; set.fills=[P('bg/surface')]; set.cornerRadius=16; set.strokes=[{type:'SOLID',color:{r:0.59,g:0.28,b:1}}]; set.dashPattern=[6,4]; return set;}\nfunction textProp(c,t,name){const k=c.addComponentProperty(name,'TEXT',t.characters); t.componentPropertyReferences={characters:k};}\nfunction bar(w,h,pct,fillName){const b=figma.createFrame(); b.name='Progress'; b.resize(w,h); b.fills=[P('track/default')]; b.cornerRadius=h/2; b.clipsContent=true; const r=figma.createRectangle(); r.name='Fill'; r.resize(Math.max(h,w*pct),h); r.cornerRadius=h/2; r.fills=[P(fillName)]; b.appendChild(r); return b;}\n\n// ---- Progress Row\nlet sec=await section('Progress Row');\nconst prs=[];\nfor (const [st,col] of [['On track','category/auto'],['Near limit','status/warning'],['Spent','status/over']]){\n  const f=AL('Status='+st,'VERTICAL',{w:303,ps:'AUTO',cs:'FIXED',gap:8,ca:'MIN',pad:[12,0,12,0]});\n  const top=AL('Top','HORIZONTAL',{w:303,cs:'AUTO',ps:'FIXED',pa:'SPACE_BETWEEN'}); f.appendChild(top);\n  const nm=await T('Auto & transport','Body/15 Medium','text/primary'); nm.name='Item'; top.appendChild(nm);\n  const am=await T('$350','Body/15 Medium','text/primary'); am.name='Amount'; top.appendChild(am);\n  f.appendChild(bar(303,6,st==='Spent'?1:(st==='Near limit'?0.93:0.47),col));\n  const bot=AL('Bottom','HORIZONTAL',{w:303,cs:'AUTO',ps:'FIXED',pa:'SPACE_BETWEEN'}); f.appendChild(bot);\n  const lf=await T('Left $186','Label/13 Regular', st==='On track'?'text/secondary':(st==='Near limit'?'status/warning':'status/over')); lf.name='Left'; bot.appendChild(lf);\n  const pc=await T(st==='Spent'?'100% used':(st==='Near limit'?'93% used':'47% used'),'Label/13 Regular','text/tertiary'); pc.name='Used'; bot.appendChild(pc);\n  const c=figma.createComponentFromNode(f); textProp(c,nm,'Item'); textProp(c,am,'Amount'); textProp(c,lf,'Left'); textProp(c,pc,'Used'); prs.push(c);\n}\nsetify(prs,'Progress Row',sec);\n\n// ---- Budget Summary\nsec=await section('Budget Summary');\nconst bs=AL('Budget Summary','VERTICAL',{w:335,ps:'AUTO',cs:'FIXED',gap:16,ca:'MIN',pad:[20,20,20,20],r:24});\nbs.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0.8,0.6,0],[-0.6,0.8,0.3]],gradientStops:[{position:0,color:{r:0.42,g:0.32,b:0.96,a:1}},{position:1,color:{r:0.31,g:0.2,b:0.82,a:1}}]}];\nbs.effectStyleId=ES['Elevation/3 Brand'].id;\nconst r1=AL('Figures','HORIZONTAL',{w:295,ps:'FIXED',cs:'AUTO',pa:'SPACE_BETWEEN',ca:'MAX'}); bs.appendChild(r1);\nconst c1=AL('Left to spend','VERTICAL',{gap:2,ca:'MIN'}); r1.appendChild(c1);\nconst l1=await T('Left to spend','Label/13 Medium','text/on-brand'); l1.opacity=0.8; c1.appendChild(l1);\nconst v1=await T('$738','Heading/28 Bold','text/on-brand'); v1.name='Left value'; c1.appendChild(v1);\nconst c2=AL('Monthly budget','VERTICAL',{gap:2,ca:'MAX'}); r1.appendChild(c2);\nconst l2=await T('Monthly budget','Label/13 Medium','text/on-brand'); l2.opacity=0.8; c2.appendChild(l2);\nconst v2=await T('$2,550','Title/17 SemiBold','text/on-brand'); v2.name='Budget value'; c2.appendChild(v2);\nconst pb=figma.createFrame(); pb.name='Progress'; pb.resize(295,10); pb.cornerRadius=5; pb.fills=[P('text/on-brand',0.25)]; pb.clipsContent=true;\nconst pf=figma.createRectangle(); pf.name='Fill'; pf.resize(Math.round(295*1812/2550),10); pf.cornerRadius=5; pf.fills=[P('text/on-brand')]; pb.appendChild(pf); bs.appendChild(pb);\nconst r3=AL('Caption','HORIZONTAL',{w:295,ps:'FIXED',cs:'AUTO',pa:'SPACE_BETWEEN'}); bs.appendChild(r3);\nconst s1=await T('$1,812 spent · 71%','Label/13 Medium','text/on-brand'); s1.opacity=0.85; r3.appendChild(s1);\nconst s2=await T('29% left','Label/13 Medium','text/on-brand'); s2.opacity=0.85; r3.appendChild(s2);\nconst bsc=figma.createComponentFromNode(bs); sec.appendChild(bsc);\n\n// ---- Category Card\nsec=await section('Category Card');\nconst pOn=prs[0],pNear=prs[1],pSp=prs[2];\nfunction setRow(inst,vals,pct,col){const props=inst.componentProperties; const m={}; for(const k in props){const b=k.split('#')[0]; if(vals[b]!==undefined) m[k]=vals[b];} inst.setProperties(m); const fill=inst.findOne(n=>n.name==='Fill'); fill.resize(Math.max(6,303*pct),6); if(col) fill.fills=[P(col)];}\nconst cats=[\n {name:'Auto & transport',total:'$600',ic:'Icon_Car',col:'category/auto',bg:'category/auto-bg',sub:'2 items',rows:[\n   ['On track',{Item:'Auto & transport',Amount:'$350',Left:'Left $186',Used:'47% used'},164/350],\n   ['On track',{Item:'Auto insurance',Amount:'$250',Left:'Left $120',Used:'52% used'},130/250]]},\n {name:'Bill & Utilities',total:'$320',ic:'Icon_Bill',col:'category/bill',bg:'category/bill-bg',sub:'3 items',rows:[\n   ['Spent',{Item:'Subscriptions',Amount:'$52',Left:'Left $0',Used:'100% used'},1],\n   ['Near limit',{Item:'House service',Amount:'$138',Left:'Left $10',Used:'93% used'},128/138],\n   ['On track',{Item:'Maintenance',Amount:'$130',Left:'Left $30',Used:'77% used'},100/130]]}\n];\nconst ccs=[];\nfor (const cat of cats){\n  const f=AL('Category='+cat.name,'VERTICAL',{w:335,ps:'AUTO',cs:'FIXED',gap:4,ca:'MIN',pad:[16,16,8,16],r:20,fill:'bg/surface'}); f.effectStyleId=ES['Elevation/1 Card'].id;\n  const hd=AL('Card Header','HORIZONTAL',{w:303,ps:'FIXED',cs:'AUTO',gap:12,pad:[0,0,8,0]}); f.appendChild(hd);\n  const tile=AL('Icon Tile','HORIZONTAL',{w:44,h:44,ps:'FIXED',cs:'FIXED',pa:'CENTER',ca:'CENTER',r:12,fill:cat.bg}); tile.appendChild(icon(cat.ic,cat.col)); hd.appendChild(tile);\n  const tx=AL('Name','VERTICAL',{gap:2,ca:'MIN'}); hd.appendChild(tx); tx.layoutGrow=1;\n  tx.appendChild(await T(cat.name,'Title/17 SemiBold','text/primary')); tx.appendChild(await T(cat.sub,'Label/13 Regular','text/secondary'));\n  const tot=await T(cat.total,'Title/17 SemiBold','text/primary'); tot.name='Total'; hd.appendChild(tot);\n  hd.appendChild(icon('Icon_Chevron_Right','text/tertiary'));\n  const div=figma.createRectangle(); div.name='Divider'; div.resize(303,1); div.fills=[P('border/default')]; f.appendChild(div);\n  for (const [st,vals,pct] of cat.rows){const src={'On track':pOn,'Near limit':pNear,'Spent':pSp}[st]; const i=src.createInstance(); f.appendChild(i); setRow(i,vals,pct, st==='On track'?cat.col:null);}\n  ccs.push(figma.createComponentFromNode(f));\n}\nsetify(ccs,'Category Card',sec,'HORIZONTAL');\n\n// ---- More row\nsec=await section('List Entry');\nconst mrs=[];\nfor (const st of ['Default','Pressed']){\n  const f=AL('State='+st,'HORIZONTAL',{w:335,ps:'FIXED',cs:'AUTO',gap:12,pad:[14,16,14,16],r:20,fill:st==='Pressed'?'state/pressed':'bg/surface'}); f.strokes=[P('border/default')];\n  const tile=AL('Icon Tile','HORIZONTAL',{w:44,h:44,ps:'FIXED',cs:'FIXED',pa:'CENTER',ca:'CENTER',r:12,fill:'brand/50'}); tile.appendChild(icon('Icon_More','brand/500')); f.appendChild(tile);\n  const tx=AL('Text','VERTICAL',{gap:2,ca:'MIN'}); f.appendChild(tx); tx.layoutGrow=1;\n  const a=await T('More categories','Body/15 Medium','text/primary'); a.name='Title'; tx.appendChild(a);\n  const b=await T('Food, Shopping, Health and 4 more','Label/13 Regular','text/secondary'); b.name='Subtitle'; tx.appendChild(b);\n  f.appendChild(icon('Icon_Chevron_Right','text/tertiary'));\n  const c=figma.createComponentFromNode(f); textProp(c,a,'Title'); textProp(c,b,'Subtitle'); mrs.push(c);\n}\nsetify(mrs,'List Entry',sec);\nreturn 'ok';","description":"Build progress row, budget summary, category cards, list entry components","fileKey":"htzJEgTQZM6qy0UMgMs235"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":22740,"cache_read_input_tokens"