CE | Photo_Setup_8\",\"    INSTANCE | Photo_Setup_9\",\"---FOOTER---\",\"INSTANCE | F/Footer\",\"  FRAME | FooterMain\",\"    FRAME | BrandCol\",\"    FRAME | Links\",\"    FRAME | Help\",\"    FRAME | Newsletter\",\"  RECTANGLE | Divider\",\"  FRAME | FooterBottom\",\"    TEXT | 2023 Furniro. All rights reserved\"],\"shopGrid\":[\"  FRAME | Grid\",\"    FRAME | Card/Syltherine\",\"    FRAME | Card/Leviosa\",\"    FRAME | Card/Lolito\",\"    FRAME | Card/Respira\",\"    FRAME | Card/Grifo\",\"    FRAME | Card/Muggo\",\"    FRAME | Card/Pingky\",\"    FRAME | Card/Potty\",\"    FRAME | Card/Syltherine\",\"    FRAME | Card/Leviosa\",\"    FRAME | Card/Lolito\",\"    FRAME | Card/Respira\",\"    FRAME | Card/Grifo\",\"    FRAME | Card/Muggo\",\"    FRAME | Card/Pingky\",\"    FRAME | Card/Potty\"]}"}],"_meta":{"mcpRequestId":"2e8b69c6-cc27-4299-9a43-f3d93f6becc9"}},"tool_result_meta":[{"id":"mcp__figma__use_figma_46_fd1847cf","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
