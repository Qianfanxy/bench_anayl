t add=(p,n,x,y)=>{p.appendChild(n);n.x=x;n.y=y;return n;};\nconst SB=await figma.getNodeByIdAsync('1:33'),HI=await figma.getNodeByIdAsync('1:44'),BTN=await figma.getNodeByIdAsync('1:28');\nconst SOC=await figma.getNodeByIdAsync('11:119');\nconst F=figma.createFrame();F.name='01_Welcome';F.resize(393,852);F.x=0;F.y=0;F.clipsContent=true;\nF.fills=[paint('Surface/Background'),{type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{r:0.984,g:0.933,b:0.973,a:1}},{position:0.55,color:{r:1,g:1,b:1,a:0}}]}];\nadd(F,SB.createInstance(),0,0);\nconst hero=figma.createFrame();hero.name='Hero · People Around You';hero.resize(393,400);hero.fills=[];hero.clipsContent=false;add(F,hero,0,54);\nconst cx=196,cy=196;\nfor (const [d,o] of [[360,0.25],[250,0.4]]){const e=figma.createEllipse();e.name='Orbit';e.resize(d,d);e.fills=[];e.strokes=[paint('Brand/Orchid',o)];e.strokeWeight=1.5;e.dashPattern=[6,6];add(hero,e,cx-d/2,cy-d/2);}\nconst ring=(name,d,x,y,ringCol)=>{const g=figma.createFrame();g.name=name;g.resize(d,d);g.cornerRadius=d/2;g.fills=[paint('Surface/Background')];g.effectStyleId=ES['Elevation/Card'].id;const p=pic(name,d-8,d-8,(d-8)/2);add(g,p,4,4);add(hero,g,x,y);return g;};\nring('Portrait_Henry',84,14,58);ring('Portrait_Lucie',70,296,40);ring('Portrait_Marry',88,288,262);ring('Portrait_Pierre',66,34,292);\nconst s=ring('Portrait_Sarah_Payne',156,cx-78,cy-78);s.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0.8,0.6,-0.2],[-0.6,0.8,0.4]],gradientStops:[{position:0,color:{r:0.294,g:0.086,b:0.298,a:1}},{position:1,color:{r:0.867,g:0.533,b:0.812,a:1}}]}];\ns.children[0].x=6;s.children[0].y=6;s.children[0].resize(144,144);s.children[0].cornerRadius=72;\nconst hb=AL('Heart Badge','HORIZONTAL',{primaryAxisAlignItems:'CENTER',counterAxisAlignItems:'CENTER'});hb.resize(48,48);hb.primaryAxisSizingMode='FIXED';hb.counterAxisSizingMode='FIXED';hb.cornerRadius=24;hb.fills=[paint('Surface/Background')];hb.effectStyleId=ES['Elevation/Card'].id;hb.appendChild(icon('Icon_Heart','Semantic/Like',24,true));add(hero,hb,cx+38,cy+40);\n// small sparkle dots\nfor (const [x,y,d,c] of [[150,30,10,'Brand/Orchid'],[250,360,8,'Brand/Plum'],[350,200,12,'Brand/Orchid'],[20,210,8,'Brand/Plum']]){const e=figma.createEllipse();e.name='Accent Dot';e.resize(d,d);e.fills=[paint(c)];add(hero,e,x,y);}\nconst h=await T('Let’s meet new people around you','Display/Bold 32');h.textAlignHorizontal='CENTER';h.resize(329,10);h.textAutoResize='HEIGHT';add(F,h,32,468);\nconst r1=h.getRangeFontName?0:0;\n// highlight 'new people' in plum\nconst idx=h.characters.indexOf('new people');h.setRangeFills(0,h.characters.length,[paint('Text/Primary')]);h.setRangeFills(idx,idx+10,[paint('Brand/Plum')]);\nconst acts=AL('Sign-in Options','VERTICAL',{itemSpacing:12});\nconst b1=BTN.createInstance();b1.name='Button/Use mobile number';acts.appendChild(b1);\nconst g=SOC.children.find(c=>c.name==='Provider=Google, State=Default').createInstance();g.name='Social Button/Google';acts.appendChild(g);\nconst fb=SOC.children.find(c=>c.name==='Provider=Facebook, State=Default').createInstance();fb.name='Social Button/Facebook';acts.appendChild(fb);\nadd(F,acts,24,574);\nconst su=AL('Sign Up Row','HORIZONTAL',{counterAxisAlignItems:'CENTER',itemSpacing:6});su.appendChild(await T('Don’t have an account?','Body/Regular 15','Text/Secondary'));\nconst sl=AL('Sign Up','HORIZONTAL',{paddingTop:6,paddingBottom:6,paddingLeft:4,paddingRight:4});sl.appendChild(await T('Sign Up','Label/Semi Bold 16','Brand/Plum'));su.appendChild(sl);\nadd(F,su,0,768);su.x=(393-su.width)/2;\nadd(F,HI.createInstance(),0,818);\nreturn F.id+' '+sl.id+' acts end '+(acts.y+acts.height);","description":"Build 01_Welcome screen","fileKey":"jNSdbcJkhQYP0D5JB5bGQn"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":581,"cache_read_input_tokens":78048,"cache_creation":{"ephemeral_5m_input_tokens":581,"ephemeral_1h_i