figma.getNodeByIdAsync(compId); const ic = comp.createInstance(); parent.appendChild(ic); if(size!==24){ const k=size/24; ic.rescale?ic.rescale(k):ic.resize(size,size); } ic.x=x; ic.y=y; if(color) paint(ic,color); return ic; }\nasync function cmpInst(parent, compId, x, y){ const c = await figma.getNodeByIdAsync(compId); const i = c.createInstance(); parent.appendChild(i); i.x=x; i.y=y; return i; }\nasync function scr(name,x,y){ const f=figma.createFrame(); f.name=name; f.resize(375,812); f.x=x; f.y=y; f.fills=S(C.bg); ws.appendChild(f); await cmpInst(f,A.statusBar,0,0); await cmpInst(f,A.homeInd,0,778); return f; }\nasync function backBtn(parent,x,y){ const b=figma.createFrame(); b.name='Btn / Back'; parent.appendChild(b); b.resize(44,44); b.x=x; b.y=y; b.fills=S(C.white); b.cornerRadius=22; b.strokes=S(C.line); b.strokeWeight=1; b.strokeAlign='INSIDE'; await icon(b,A.iconBack,12,12,20,C.ink); return b; }\n\n// ================= 10_Markets =================\nconst f10 = await scr('10_Markets', 0, 900);\nawait backBtn(f10, 24, 56);\nconst t10 = await T(f10,'Markets',17,700,C.ink,0,0); t10.textAutoResize='NONE'; t10.resize(160,24); t10.textAlignHorizontal='CENTER'; t10.x=80; t10.y=66;\nconst av10 = (await figma.getNodeByIdAsync(A.avatar)).createInstance(); f10.appendChild(av10); av10.resize(44,44); av10.x=307; av10.y=56;\n// Coin selector row\nconst coin = figma.createFrame(); coin.name='Coin Selector'; f10.appendChild(coin);\ncoin.resize(180,44); coin.x=24; coin.y=116; coin.fills=S(C.white); coin.cornerRadius=22; coin.strokes=S(C.line); coin.strokeWeight=1; coin.strokeAlign='INSIDE';\nconst btcI = await cmpInst(coin, A.btc, 12, 10); btcI.resize(24,24);\nconst cnT = await T(coin,'Bitcoin',14,700,C.ink,44,0); cnT.y=(44-cnT.height)/2;\nawait icon(coin, A.iconChevron, 150, 12, 20, C.gray);\n// Price card\nconst pc = figma.createFrame(); pc.name='Price Card'; f10.appendChild(pc);\npc.resize(327,340); pc.x=24; pc.y=176; pc.fills=S(C.white); pc.cornerRadius=24;\nawait T(pc,'Current price',11,400,C.gray,20,18);\nawait T(pc,'$1,954.00',26,700,C.ink,20,42);\nconst chg = await T(pc,'(+3.85%)',13,600,C.green,0,0); chg.x=20+ (26*0) + 138; chg.y=52;\n// range tabs\nconst ranges = ['1H','2H','8H','1D','1W','1M','1Y'];\nfor(let i=0;i<7;i++){\n  const seg=figma.createFrame(); seg.name='Range / '+ranges[i]; pc.appendChild(seg);\n  seg.resize(41,26); seg.x=20+i*41.2; seg.y=86; seg.cornerRadius=13;\n  const sel = ranges[i]==='1D';\n  seg.fills = sel?S(C.deep):S(C.soft);\n  const lb = await T(seg, ranges[i], 10.5, sel?700:500, sel?C.white:C.gray, 0, 0);\n  lb.x=(41-lb.width)/2; lb.y=(26-lb.height)/2;\n}\n// chart area: y scale labels left + candles\nconst chartX = 44, chartY = 128, chartW = 263, chartH = 150;\n// y gridlines 1000..5000\nfor(let i=0;i<5;i++){\n  const val = 5000 - i*1000;\n  const gy = chartY + i*(chartH/4);\n  const grid = figma.createRectangle(); pc.appendChild(grid); grid.resize(chartW,1); grid.x=chartX; grid.y=gy; grid.fills=S(C.soft);\n  const lb = await T(pc,'$'+(val/1000)+',000',8,400,C.gray,0,0); lb.textAutoResize='NONE'; lb.resize(22,10); lb.textAlignHorizontal='RIGHT'; lb.x=16; lb.y=gy-5;\n}\n// candlesticks (12 candles)\nconst candles = [\n  {o:0.62,c:0.55,w:0.50,up:true}, {o:0.55,c:0.62,w:0.45,up:false}, {o:0.62,c:0.48,w:0.42,up:true},\n  {o:0.48,c:0.58,w:0.40,up:false}, {o:0.58,c:0.42,w:0.36,up:true}, {o:0.42,c:0.52,w:0.34,up:false},\n  {o:0.52,c:0.38,w:0.30,up:true}, {o:0.38,c:0.46,w:0.28,up:false}, {o:0.46,c:0.34,w:0.26,up:true},\n  {o:0.34,c:0.42,w:0.24,up:false}, {o:0.42,c:0.30,w:0.22,up:true}, {o:0.30,c:0.36,w:0.20,up:false}\n];\nfor(let i=0;i<12;i++){\n  const cd = candles[i];\n  const x = chartX + 6 + i*21.5;\n  const topY = chartY + cd.w*chartH;\n  const botY = chartY + Math.max(cd.o,cd.c)*chartH;\n  const oY = chartY + cd.o*chartH, cY = chartY + cd.c*chartH;\n  const wick = figma.createRectangle(); pc.appendChild(wick); wick.resize(1.5, Math.max(2,botY-topY)); wick.x=x+3.5; wick.y=topY; wick.fills=S(cd.up?C.green:C.red);\n  const body = figma.createRectangle(); pc.appendChild(body); body.resize(8, Math.max(3,Math.abs(cY-oY))); body.x=x; body.y=Math.min(oY,cY); body.cornerRadius=2; body.fills=S(cd.up?C.green:C.red);\n}\n// x time labels\nconst times = ['08:00','10:00','12:00','15:00','18:00','21:00','24:00'];\nfor(let i=0;i<7;i++){\n  const lb = await T(pc, times[i], 8, 400, C.gray, 0, chartY+chartH+8);\n  lb.x = chartX + i*(chartW/6) - lb.width/2;\n}\n// History\nawait T(f10,'History',15,700,C.ink,24,544);\nconst sa10 = await T(f10,'See all',12,600,C.deep,0,0); sa10.x=351-sa10.width; sa10.y=547;\nconst hist = [\n  {logo:A.sol, name:'Solana', t:'SOL', v:'$12,094.08'},\n  {logo:A.btc, name:'Bitcoin', t:'BTC', v:'$17,238.11'},\n  {logo:A.eth, name:'Ethereum', t:'ETH', v:'$8,200.00'}\n];\nfor(let i=0;i<3;i++){\n  const row = figma.createFrame(); row.name='History / '+hist[i].name; f10.appendChild(row);\n  row.resize(327,44); row.x=24; row.y=576+i*52; row.fills=[];\n  const lg = (await figma.getNodeByIdAsync(hist[i].logo)).createInstance(); row.appendChild(lg); lg.resize(36,36); lg.x=0; lg.y=4;\n  await T(row,hist[i].name,13,600,C.ink,48,6);\n  await T(row,hist[i].t,10,400,C.gray,48,24);\n  const vl = await T(row,hist[i].v,12,700,C.ink,0,0); vl.textAutoResize='NONE'; vl.resize(120,16); vl.textAlignHorizontal='RIGHT'; vl.x=207; vl.y=14;\n}\n// Sell / Buy buttons\nconst sell = figma.createFrame(); sell.name='Btn / Sell'; f10.appendChild(sell);\nsell.resize(156,52); sell.x=24; sell.y=720; sell.fills=S(C.white); sell.cornerRadius=26; sell.strokes=S(C.red); sell.strokeWeight=1.5; sell.strokeAlign='INSIDE';\nconst sT = await T(sell,'Sell',14,600,C.red,0,0); sT.x=(156-sT.width)/2; sT.y=(52-sT.height)/2;\nconst buy = figma.createFrame(); buy.name='Btn / Buy'; f10.appendChild(buy);\nbuy.resize(156,52); buy.x=195; buy.y=720; buy.fills=S(C.deep); buy.cornerRadius=26;\nconst bT = await T(buy,'Buy',14,600,C.white,0,0); bT.x=(156-bT.width)/2; bT.y=(52-bT.height)/2;\nreturn JSON.stringify({f10:f10.id});","description":"Build 10_Markets with candlestick chart","fileKey":"LoWw4yZnsmEbrzRZ2AMTxG"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"4ae3e056-c163-4c22-ba71-93fbd4764287","uuid":"ff5e4230-5aad-4976-bc64-7f56a6f453ce","timestamp":"2026-10-28T09:32:30.542Z","tool_use_meta":[{"id":"mcp__figma__use_figma_31_4b1e7810","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
