x,cy,r,180,0,90)}];\ntrack.strokes=[S(C.track)]; track.strokeWeight=12; track.strokeCap='ROUND'; track.fills=[]; arcBox.appendChild(track);\n// value 660 -> 57.78% of 450\nconst p=(660-400)/450; const endDeg=180-180*p;\nconst val=figma.createVector(); val.name='Value';\nval.vectorPaths=[{windingRule:'NONE',data:arcPath(cx,cy,r,180,endDeg,60)}];\nval.strokes=[S(C.brand)]; val.strokeWeight=12; val.strokeCap='ROUND'; val.fills=[]; arcBox.appendChild(val);\n// end cap dot\nconst a2=endDeg*Math.PI/180;\nconst dot=figma.createEllipse(); dot.name='Knob'; dot.resize(20,20); dot.fills=[S(C.white)];\ndot.strokes=[S(C.brand)]; dot.strokeWeight=5; dot.x=cx+r*Math.cos(a2)-10; dot.y=cy-r*Math.sin(a2)-10; arcBox.appendChild(dot);\n// center score\nconst sc=txt('660',40,'Bold',C.ink); sc.name='Score'; sc.textAlignHorizontal='CENTER'; sc.x=0; sc.y=44; sc.resize(343,52); sc.textAutoResize='NONE'; arcBox.appendChild(sc);\nconst rate=txt('Good',13,'SemiBold',C.good); rate.name='Rating'; rate.textAlignHorizontal='CENTER'; rate.x=0; rate.y=96; rate.resize(343,20); rate.textAutoResize='NONE'; arcBox.appendChild(rate);\nconst minT=txt('400',11,'Medium',C.ter); minT.x=22; minT.y=118; arcBox.appendChild(minT);\nconst maxT=txt('850',11,'Medium',C.ter); maxT.x=296; maxT.y=118; arcBox.appendChild(maxT);\ng.appendChild(arcBox);\nconst foot=fr('Foot',343,24,null); foot.layoutMode='HORIZONTAL'; foot.primaryAxisSizingMode='FIXED'; foot.counterAxisSizingMode='FIXED'; foot.counterAxisAlignItems='CENTER'; foot.paddingLeft=24; foot.paddingRight=24; foot.paddingTop=6;\nconst delta=txt('+6pts in the last month',12,'SemiBold',C.good); delta.name='Delta'; delta.layoutGrow=1;\nconst upd=txt('Last update on 20 Jul 2020',11,'Medium',C.ter); upd.name='Updated'; upd.textAlignHorizontal='RIGHT';\nfoot.appendChild(delta); foot.appendChild(upd);\ng.appendChild(foot);\nsec.appendChild(g); g.x=900; g.y=900;\nreturn JSON.stringify({gauge:g.id, W:[track.width,val.width] });","description":"Build credit score gauge com