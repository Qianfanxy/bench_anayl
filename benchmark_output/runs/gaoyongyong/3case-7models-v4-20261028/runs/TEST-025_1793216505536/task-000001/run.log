tton\";\n  backBtn.resize(48, 48);\n  backBtn.cornerRadius = 16;\n  backBtn.backgrounds = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  backBtn.strokes = [{ type: \"SOLID\", color: { r: 0.9, g: 0.9, b: 0.9 } }];\n  backBtn.strokeWeight = 1;\n  backBtn.x = 24;\n  backBtn.y = 64;\n  if (backMaster) {\n    const backIcon = backMaster.createInstance();\n    backIcon.x = 12;\n    backIcon.y = 12;\n    backIcon.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n    backBtn.appendChild(backIcon);\n  }\n  frame.appendChild(backBtn);\n  \n  // Search\n  const searchBtn = figma.createFrame();\n  searchBtn.name = \"Search_Button\";\n  searchBtn.resize(48, 48);\n  searchBtn.cornerRadius = 16;\n  searchBtn.backgrounds = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  searchBtn.strokes = [{ type: \"SOLID\", color: { r: 0.9, g: 0.9, b: 0.9 } }];\n  searchBtn.strokeWeight = 1;\n  searchBtn.x = frame.width - 24 - 48;\n  searchBtn.y = 64;\n  if (searchMaster) {\n    const searchIcon = searchMaster.createInstance();\n    searchIcon.x = 12;\n    searchIcon.y = 12;\n    searchIcon.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n    searchBtn.appendChild(searchIcon);\n  }\n  frame.appendChild(searchBtn);\n  \n  // Title\n  const titleTxt = figma.createText();\n  titleTxt.characters = \"Payment\";\n  titleTxt.fontSize = 22;\n  titleTxt.fontName = { family: \"Roboto\", style: \"Bold\" };\n  titleTxt.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n  titleTxt.x = (frame.width - titleTxt.width) / 2;\n  titleTxt.y = 74;\n  frame.appendChild(titleTxt);\n  \n  // 2. Order Summary Container\n  const summaryTitle = figma.createText();\n  summaryTitle.characters = \"Order summary\";\n  summaryTitle.fontSize = 18;\n  summaryTitle.fontName = { family: \"Roboto\", style: \"Bold\" };\n  summaryTitle.fills = [{ type: \"SOLID\", color: { r: 0.235, g: 0.184, b: 0.184 } }];\n  summaryTitle.x = 24;\n  summaryTitle.y = 140;\n  frame.appendChild(summaryTitle);\n  \n  const summaryBox = figma.createFrame();\n  summaryBox.name = \"Order_Summary_Box\";\n  summaryBox.resize(382, 172);\n  summaryBox.x = 24;\n  summaryBox.y = 172;\n  summaryBox.cornerRadius = 16;\n  summaryBox.backgrounds = [{ type: \"SOLID\", color: { r: 1, g: 1, b: 1 } }];\n  summaryBox.strokes = [{ type: \"SOLID\", color: { r: 0.94, g: 0.94, b: 0.94 } }];\n  summaryBox.strokeWeight = 1;\n  \n  const items = [\n    { label: \"Order\", value: \"$16.48\" },\n    { label: \"Taxes\", value: \"$0.30\" },\n    { label: \"Delivery fees\", value: \"$1.50\" },\n    { label: \"Total\", value: \"$18.28\", isBold: true }\n  ];\n  \n  let iy = 16;\n  for (const item of items) {\n    const lbl = figma.createText();\n    lbl.characters = item.label;\n    lbl.fontSize = 14;\n    lbl.fontName = { family: \"Roboto\", style: item.isBold ? \"Bold\" : \"Regular\" };\n    lbl.fills = [{ type: \"SOLID\", color: item.isBold ? { r: 0.235, g: 0.184, b: 0.184 } : { r: 0.5, g: 0.5, b: 0.5 } }];\n    lbl.x = 16;\n    lbl.y = iy;\n    summaryBox.appendChild(lbl);\n    \n    const val = figma.createText();\n    val.characters = item.value;\n    val.fontSize = 14;\n    val.fontName = { family: \"Roboto\", style: \"Bold\" };\n    val.fills = [{ type: \"SOLID\", color: item.isBold ? { r: 0.9372549, g: 0.1647059, b: 0.2235294 } : { r: 0.235, g: 0.184, b: 0.184 } }];\n    val.x = summaryBox.width - 16 - val.width;\n    val.y = iy;\n    summaryBox.appendChild(val);\n    \n    iy += 26;\n  }\n  \n  // Divider before estimated time\n  const div = figma.createLine();\n  div.resize(350, 0);\n  div.x = 16;\n  div.y = 120;\n  div.strokes = [{ type: \"SOLID\", color: { r: 0.94, g: 0.94, b: 0.94 } }];\n  summaryBox.appendChild(div);\n  \n  // Estimated delivery time\n  const estTxt = figma.createText();\n  estTxt.characters = \"Estimated delivery time:\";\n  estTxt.fontSize = 13;\n  estTxt.fontName = { family: \"Roboto\", style: \"Regular\" };\n  estTxt.fills = [{ 