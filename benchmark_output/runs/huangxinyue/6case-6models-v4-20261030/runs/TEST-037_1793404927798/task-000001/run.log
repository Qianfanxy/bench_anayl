p\"), scr[\"05_Sign_In\"]);\n// auth\nawait link(findNode(scr[\"05_Sign_In\"],\"LoginBtn\"), scr[\"08_Get_Started\"]);\nawait link(findNode(scr[\"05_Sign_In\"],\"ForgotPassword\"), scr[\"07_Forgot_Password\"]);\nawait link(findNode(scr[\"05_Sign_In\"],\"SignUpLink\"), scr[\"06_Sign_Up\"]);\nawait link(findNode(scr[\"06_Sign_Up\"],\"CreateAccountBtn\"), scr[\"08_Get_Started\"]);\nawait link(findNode(scr[\"06_Sign_Up\"],\"LoginLink\"), scr[\"05_Sign_In\"]);\nawait link(findNode(scr[\"07_Forgot_Password\"],\"SubmitBtn\"), scr[\"05_Sign_In\"]);\nawait link(findNode(scr[\"08_Get_Started\"],\"GetStartedBtn\"), scr[\"09_Home\"]);\n// home links\nawait link(findNode(scr[\"09_Home\"],\"TrendingViewAll\"), scr[\"10_Product_List\"]);\nawait link(findNode(scr[\"09_Home\"],\"SponsoredCard\"), scr[\"11_Product_Detail\"]);\n// detail links\nawait link(findNode(scr[\"11_Product_Detail\"],\"BackBtn\"), scr[\"09_Home\"]);\nawait link(findNode(scr[\"11_Product_Detail\"],\"GoToCart\"), scr[\"12_Shopping_Bag\"]);\nawait link(findNode(scr[\"11_Product_Detail\"],\"CartEntry\"), scr[\"12_Shopping_Bag\"]);\n// bag\nawait link(findNode(scr[\"12_Shopping_Bag\"],\"BackBtn\"), scr[\"11_Product_Detail\"]);\nawait link(findNode(scr[\"12_Shopping_Bag\"],\"ProceedToPayment\"), scr[\"13_Payment\"]);\n// payment\nawait link(findNode(scr[\"13_Payment\"],\"BackBtn\"), scr[\"12_Shopping_Bag\"]);\nawait link(findNode(scr[\"13_Payment\"],\"ContinueBtn\"), scr[\"14_Payment_Success_Overlay\"], \"OVERLAY\");\n// overlay: tap dialog -> home\nconst dlg = findNode(scr[\"14_Payment_Success_Overlay\"],\"SuccessDialog\");\nawait link(dlg, scr[\"09_Home\"]);\n// profile\nawait link(findNode(scr[\"15_Profile\"],\"BackBtn\"), scr[\"09_Home\"]);\n// tab bars: wire Cart->12, Setting->15, Home->09\nfor (const fname of [\"09_Home\",\"10_Product_List\",\"11_Product_Detail\",\"13_Payment\",\"14_Payment_Success_Overlay\"]){\n  const f=scr[fname];\n  const nav=f.children.find(c=>c.name===\"MainNav\");\n  if(!nav) continue;\n  const cart=nav.findOne(n=>n.name===\"Icon_Cart\");\n  const sett=nav.findOne(n=>n.name===\"Icon_Setting\");\n  const home=nav.findOne(n=>n.name===\"Icon_Home\");\n  if(cart) await link(cart, scr[\"12_Shopping_Bag\"]);\n  if(sett) await link(sett, scr[\"15_Profile\"]);\n  if(home && fname!==\"09_Home\") await link(home, scr[\"09_Home\"]);\n}\nreturn \"prototype wired\";","description":"Wire all prototype interactions"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"14b42764-d761-4609-9d48-7eed784bda72","uuid":"360ac260-99e4-44ce-92fd-6eef8251845c","timestamp":"2026-10-31T00:33:00.098Z","tool_use_meta":[{"id":"mcp__figma__use_figma_48_a9ab630d","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
