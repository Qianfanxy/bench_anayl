{"type":"assistant","message":{"id":"chatcmpl-20261101200647531562978268d9d6pxOWUMJB","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_c501b65a75ed473db563553183ca6432","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  // Load fonts\n  await figma.loadFontAsync({ family: \"DM Sans\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"DM Sans\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"DM Sans\", style: \"Semi Bold\" });\n  await figma.loadFontAsync({ family: \"DM Sans\", style: \"Bold\" });\n\n  const workspacePage = figma.root.children.find(p => p.name.includes(\"03 · Workspace\")) || figma.currentPage;\n  await figma.setCurrentPageAsync(workspacePage);\n\n  // Clear existing items in workspace page if re-running\n  for (const child of workspacePage.children) {\n    child.remove();\n  }\n\n  // Colors\n  const AMBER = { r: 1, g: 0.6745, b: 0.0706 }; // #FFAC12\n  const DARK_BG = { r: 0.102, g: 0.102, b: 0.122 }; // #1A1A1F\n  const WHITE = { r: 1, g: 1, b: 1 };\n  const GRAY_50 = { r: 0.976, g: 0.976, b: 0.98 };\n  const GRAY_100 = { r: 0.945, g: 0.945, b: 0.953 };\n  const GRAY_200 = { r: 0.88, g: 0.88, b: 0.895 };\n  const GRAY_400 = { r: 0.6, g: 0.6, b: 0.63 };\n  const GRAY_600 = { r: 0.38, g: 0.38, b: 0.42 };\n  const GRAY_900 = { r: 0.1, g: 0.1, b: 0.12 };\n\n  // Helper functions\n  function createInstance(id) {\n    const node = figma.getNodeById(id);\n    if (node && node.type === \"COMPONENT\") {\n      return node.createInstance();\n    }\n    const frame = figma.createFrame();\n    frame.name = \"Placeholder\";\n    return frame;\n  }\n\n  function makeText(text, fontSize, weight = \"Regular\", color = GRAY_900) {\n    const t = figma.createText();\n    t.fontName = { family: \"DM Sans\", style: weight };\n    t.fontSize = fontSize;\n    t.characters = text;\n    t.fills = [{ type: \"SOLID\", color: color }];\n    return t;\n  }\n\n  function makeButton(label, variant = \"primary\", iconRight = true) {\n    const btn = figma.createFrame();\n    btn.name = \"Button\";\n    btn.layoutMode = \"HORIZONTAL\";\n    btn.primaryAxisAlignItems = \"CENTER\";\n    btn.counterAxisAlignItems = \"CENTER\";\n    btn.paddingLeft = 24;\n    btn.paddingRight = 24;\n    btn.paddingTop = 14;\n    btn.paddingBottom = 14;\n    btn.itemSpacing = 10;\n    btn.cornerRadius = 8;\n\n    let textColor = GRAY_900;\n    if (variant === \"primary\") {\n      btn.fills = [{ type: \"SOLID\", color: AMBER }];\n      textColor = GRAY_900;\n    } else if (variant === \"dark\") {\n      btn.fills = [{ type: \"SOLID\", color: DARK_BG }];\n      textColor = WHITE;\n    } else if (variant === \"outline\") {\n      btn.fills = [];\n      btn.strokes = [{ type: \"SOLID\", color: GRAY_200 }];\n      btn.strokeWeight = 1;\n      textColor = GRAY_900;\n    } else if (variant === \"ghost\") {\n      btn.fills = [];\n      textColor = GRAY_900;\n      btn.paddingLeft = 0;\n      btn.paddingRight = 0;\n    }\n\n    const txt = makeText(label, 15, \"Semi Bold\", textColor);\n    btn.appendChild(txt);\n\n    if (iconRight) {\n      const icon = createInstance(\"3:3\"); // Icon_Arrow_Right\n      icon.resize(20, 20);\n      btn.appendChild(icon);\n    }\n    return btn;\n  }\n\n  function makeHeader() {\n    const header = figma.createFrame();\n    header.name = \"Header\";\n    header.resize(1440, 90);\n    header.layoutMode = \"HORIZONTAL\";\n    header.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    header.counterAxisAlignItems = \"CENTER\";\n    header.paddingLeft = 80;\n    header.paddingRight = 80;\n    header.fills = [{ type: \"SOLID\", color: WHITE }];\n    header.strokes = [{ type: \"SOLID\", color: GRAY_100 }];\n    header.strokeWeight = 1;\n    header.strokeAlign = \"INSIDE\";\n\n    // Logo\n    const logoGroup = figma.createFrame();\n    logoGroup.name = \"Logo_Header\";\n    logoGroup.layoutMode = \"HORIZONTAL\";\n    logoGroup.counterAxisAlignItems = \"CENTER\";\n    logoGroup.itemSpacing = 12;\n    logoGroup.fills = [];\n\n    const logoMark = createInstance(\"3:16\");\n    logoGroup.appendChild(logoMark);\n\n    const wordmark = makeText(\"NORTHGATE\", 20, \"Bold\", GRAY_900);\n    wordmark.letterSpacing = { value: 1.5, unit: \"PIXELS\" };\n    logoGroup.appendChild(wordmark);\n\n    header.appendChild(logoGroup);\n\n    // Nav\n    const nav = figma.createFrame();\n    nav.name = \"Nav\";\n    nav.layoutMode = \"HORIZONTAL\";\n    nav.itemSpacing = 40;\n    nav.counterAxisAlignItems = \"CENTER\";\n    nav.fills = [];\n\n    const items = [\"Buy\", \"Sell\", \"Rent\", \"About\"];\n    items.forEach(item => {\n      const t = makeText(item, 16, \"Medium\", GRAY_600);\n      nav.appendChild(t);\n    });\n\n    header.appendChild(nav);\n\n    // CTA\n    const cta = makeButton(\"Work with us\", \"primary\", true);\n    header.appendChild(cta);\n\n    return { header, logoGroup };\n  }\n\n  function makeFooter() {\n    const footer = figma.createFrame();\n    footer.name = \"Footer\";\n    footer.resize(1440, 480);\n    footer.layoutMode = \"VERTICAL\";\n    footer.paddingLeft = 80;\n    footer.paddingRight = 80;\n    footer.paddingTop = 64;\n    footer.paddingBottom = 48;\n    footer.itemSpacing = 48;\n    footer.fills = [{ type: \"SOLID\", color: DARK_BG }];\n\n    // Top Row (CTA + Logo + Socials)\n    const topRow = figma.createFrame();\n    topRow.name = \"Footer_Top\";\n    topRow.resize(1280, 50);\n    topRow.layoutMode = \"HORIZONTAL\";\n    topRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    topRow.counterAxisAlignItems = \"CENTER\";\n    topRow.fills = [];\n\n    const titleBox = figma.createFrame();\n    titleBox.name = \"TitleBox\";\n    titleBox.layoutMode = \"VERTICAL\";\n    titleBox.itemSpacing = 8;\n    titleBox.fills = [];\n    \n    const fTitle = makeText(\"Make your dreams a reality\", 32, \"Bold\", WHITE);\n    titleBox.appendChild(fTitle);\n\n    topRow.appendChild(titleBox);\n\n    const fCta = makeButton(\"Work with us\", \"primary\", true);\n    topRow.appendChild(fCta);\n\n    footer.appendChild(topRow);\n\n    // Divider\n    const div = figma.createFrame();\n    div.name = \"Divider\";\n    div.resize(1280, 1);\n    div.fills = [{ type: \"SOLID\", color: { r: 0.25, g: 0.25, b: 0.28 } }];\n    footer.appendChild(div);\n\n    // Bottom Content (Brand info + 3 Link Columns)\n    const btmRow = figma.createFrame();\n    btmRow.name = \"Footer_Bottom\";\n    btmRow.resize(1280, 200);\n    btmRow.layoutMode = \"HORIZONTAL\";\n    btmRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    btmRow.fills = [];\n\n    // Left brand col\n    const brandCol = figma.createFrame();\n    brandCol.name = \"Brand_Col\";\n    brandCol.layoutMode = \"VERTICAL\";\n    brandCol.itemSpacing = 24;\n    brandCol.fills = [];\n\n    const logoGroup = figma.createFrame();\n    logoGroup.layoutMode = \"HORIZONTAL\";\n    logoGroup.counterAxisAlignItems = \"CENTER\";\n    logoGroup.itemSpacing = 12;\n    logoGroup.fills = [];\n\n    const logoMark = createInstance(\"3:16\");\n    logoGroup.appendChild(logoMark);\n\n    const wordmark = makeText(\"NORTHGATE\", 20, \"Bold\", WHITE);\n    wordmark.letterSpacing = { value: 1.5, unit: \"PIXELS\" };\n    logoGroup.appendChild(wordmark);\n    brandCol.appendChild(logoGroup);\n\n    // Socials\n    const socials = figma.createFrame();\n    socials.layoutMode = \"HORIZONTAL\";\n    socials.itemSpacing = 16;\n    socials.fills = [];\n\n    const fb = createInstance(\"3:14\");\n    const tw = createInstance(\"3:17\");\n    const ig = createInstance(\"3:15\");\n    socials.appendChild(fb);\n    socials.appendChild(tw);\n    socials.appendChild(ig);\n    brandCol.appendChild(socials);\n\n    btmRow.appendChild(brandCol);\n\n    // Columns Data\n    const colsData = [\n      { title: \"Company\", links: [\"About us\", \"Our agents\", \"Careers\", \"Contact\"] },\n      { title: \"Services\", links: [\"Buy a home\", \"Sell a home\", \"Rent a home\", \"Property management\"] },\n      { title: \"Resources\", links: [\"Market reports\", \"Buyer guide\", \"Seller guide\", \"FAQ\"] }\n    ];\n\n    const colsFrame = figma.createFrame();\n    colsFrame.name = \"Columns\";\n    colsFrame.layoutMode = \"HORIZONTAL\";\n    colsFrame.itemSpacing = 80;\n    colsFrame.fills = [];\n\n    colsData.forEach(cd => {\n      const col = figma.createFrame();\n      col.layoutMode = \"VERTICAL\";\n      col.itemSpacing = 16;\n      col.fills = [];\n\n      const head = makeText(cd.title, 16, \"Bold\", WHITE);\n      col.appendChild(head);\n\n      cd.links.forEach(l => {\n        const linkTxt = makeText(l, 14, \"Regular\", GRAY_400);\n        col.appendChild(linkTxt);\n      });\n      colsFrame.appendChild(col);\n    });\n\n    btmRow.appendChild(colsFrame);\n    footer.appendChild(btmRow);\n\n    return footer;\n  }\n\n  // --- BUILD 01_HOME ---\n  const homeFrame = figma.createFrame();\n  homeFrame.name = \"01_Home\";\n  homeFrame.resize(1440, 3600);\n  homeFrame.fills = [{ type: \"SOLID\", color: WHITE }];\n  homeFrame.layoutMode = \"VERTICAL\";\n\n  const headerObj01 = makeHeader();\n  homeFrame.appendChild(headerObj01.header);\n\n  // 1. Hero Section\n  const hero = figma.createFrame();\n  hero.name = \"Hero_Section\";\n  hero.resize(1440, 560);\n  hero.layoutMode = \"HORIZONTAL\";\n  hero.paddingLeft = 80;\n  hero.paddingRight = 80;\n  hero.paddingTop = 64;\n  hero.paddingBottom = 64;\n  hero.itemSpacing = 64;\n  hero.counterAxisAlignItems = \"CENTER\";\n  hero.fills = [{ type: \"SOLID\", color: GRAY_50 }];\n\n  const heroTextContainer = figma.createFrame();\n  heroTextContainer.name = \"Hero_Content\";\n  heroTextContainer.resize(616, 420);\n  heroTextContainer.layoutMode = \"VERTICAL\";\n  heroTextContainer.itemSpacing = 24;\n  heroTextContainer.fills = [];\n\n  const heroBadge = figma.createFrame();\n  heroBadge.layoutMode = \"HORIZONTAL\";\n  heroBadge.paddingLeft = 12;\n  heroBadge.paddingRight = 12;\n  heroBadge.paddingTop = 6;\n  heroBadge.paddingBottom = 6;\n  heroBadge.cornerRadius = 20;\n  heroBadge.fills = [{ type: \"SOLID\", color: { r: 1, g: 0.94, b: 0.8 } }];\n  const badgeTxt = makeText(\"PREMIER REAL ESTATE AGENCY\", 12, \"Bold\", { r: 0.7, g: 0.4, b: 0 });\n  heroBadge.appendChild(badgeTxt);\n  heroTextContainer.appendChild(heroBadge);\n\n  const heroTitle = makeText(\"Beautiful homes made for you\", 52, \"Bold\", GRAY_900);\n  heroTextContainer.appendChild(heroTitle);\n\n  const heroCopy = makeText(\"Hand-picked homes, honest advice and a team that knows every street in the neighbourhoods we serve.\", 18, \"Regular\", GRAY_600);\n  heroTextContainer.appendChild(heroCopy);\n\n  const heroCta = makeButton(\"See all listings\", \"primary\", true);\n  heroCta.name = \"Btn_See_All_Listings\";\n  heroTextContainer.appendChild(heroCta);\n\n  hero.appendChild(heroTextContainer);\n\n  const heroPhotoContainer = figma.createFrame();\n  heroPhotoContainer.name = \"Hero_Photo_Wrapper\";\n  heroPhotoContainer.resize(600, 420);\n  heroPhotoContainer.cornerRadius = 16;\n  heroPhotoContainer.clipsContent = true;\n  heroPhotoContainer.fills = [];\n\n  const heroPhoto = createInstance(\"3:21\"); // Photo_Hero_House\n  heroPhoto.resize(600, 420);\n  heroPhotoContainer.appendChild(heroPhoto);\n  hero.appendChild(heroPhotoContainer);\n\n  homeFrame.appendChild(hero);\n\n  // 2. Listings Section\n  const listingsSection = figma.createFrame();\n  listingsSection.name = \"Listings_Section\";\n  listingsSection.resize(1440, 950);\n  listingsSection.layoutMode = \"VERTICAL\";\n  listingsSection.paddingLeft = 80;\n  listingsSection.paddingRight = 80;\n  listingsSection.paddingTop = 80;\n  listingsSection.paddingBottom = 80;\n  listingsSection.itemSpacing = 40;\n  listingsSection.fills = [{ type: \"SOLID\", color: WHITE }];\n\n  const listingsTitle = makeText(\"Find your next place to live\", 36, \"Bold\", GRAY_900);\n  listingsSection.appendChild(listingsTitle);\n\n  // Filter Bar\n  const filterBar = figma.createFrame();\n  filterBar.name = \"Search_Filters\";\n  filterBar.resize(1280, 72);\n  filterBar.layoutMode = \"HORIZONTAL\";\n  filterBar.paddingLeft = 24;\n  filterBar.paddingRight = 24;\n  filterBar.paddingTop = 16;\n  filterBar.paddingBottom = 16;\n  filterBar.itemSpacing = 20;\n  filterBar.counterAxisAlignItems = \"CENTER\";\n  filterBar.cornerRadius = 12;\n  filterBar.fills = [{ type: \"SOLID\", color: WHITE }];\n  filterBar.strokes = [{ type: \"SOLID\", color: GRAY_200 }];\n  filterBar.strokeWeight = 1;\n\n  const filters = [\"Looking for\", \"Location\", \"Property Type\", \"Price\"];\n  filters.forEach((f, idx) => {\n    const fBox = figma.createFrame();\n    fBox.resize(250, 44);\n    fBox.layoutMode = \"HORIZONTAL\";\n    fBox.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    fBox.counterAxisAlignItems = \"CENTER\";\n    fBox.paddingLeft = 16;\n    fBox.paddingRight = 16;\n    fBox.paddingTop = 12;\n    fBox.paddingBottom = 12;\n    fBox.cornerRadius = 8;\n    fBox.fills = [{ type: \"SOLID\", color: GRAY_50 }];\n    fBox.strokes = [{ type: \"SOLID\", color: GRAY_200 }];\n    fBox.strokeWeight = 1;\n\n    const fTxt = makeText(f, 14, \"Medium\", GRAY_600);\n    fBox.appendChild(fTxt);\n\n    const chev = createInstance(\"3:9\"); // Icon_Chevron_Down\n    fBox.appendChild(chev);\n    filterBar.appendChild(fBox);\n  });\n\n  const searchBtn = makeButton(\"Search\", \"dark\", false);\n  searchBtn.paddingLeft = 32;\n  searchBtn.paddingRight = 32;\n  filterBar.appendChild(searchBtn);\n\n  listingsSection.appendChild(filterBar);\n\n  // 6 Listing Cards Grid (2 rows x 3 cols)\n  const cardsGrid = figma.createFrame();\n  cardsGrid.name = \"Listings_Grid\";\n  cardsGrid.resize(1280, 760);\n  cardsGrid.layoutMode = \"VERTICAL\";\n  cardsGrid.itemSpacing = 32;\n  cardsGrid.fills = [];\n\n  const listingsData = [\n    { name: \"Malto House\", bd: \"4 bd\", ba: \"2 ba\", sqft: \"1,650 sq ft\", photoId: \"3:22\" },\n    { name: \"Birchwood Villa\", bd: \"4 bd\", ba: \"2 ba\", sqft: \"1,720 sq ft\", photoId: \"3:23\" },\n    { name: \"Cedar Lane House\", bd: \"4 bd\", ba: \"2 ba\", sqft: \"1,580 sq ft\", photoId: \"3:24\" },\n    { name: \"Harbor View Loft\", bd: \"4 bd\", ba: \"2 ba\", sqft: \"1,610 sq ft\", photoId: \"3:25\" },\n    { name: \"Maple Court House\", bd: \"4 bd\", ba: \"2 ba\", sqft: \"1,690 sq ft\", photoId: \"3:26\" },\n    { name: \"Willow Creek Home\", bd: \"4 bd\", ba: \"2 ba\", sqft: \"1,640 sq ft\", photoId: \"3:34\" }\n  ];\n\n  const listingCardNodes = [];\n\n  function makeListingCard(data, width = 400, height = 360) {\n    const card = figma.createFrame();\n    card.name = `ListingCard_${data.name.replace(/\\s+/g, '_')}`;\n    card.resize(width, height);\n    card.layoutMode = \"VERTICAL\";\n    card.cornerRadius = 12;\n    card.clipsContent = true;\n    card.fills = [{ type: \"SOLID\", color: WHITE }];\n    card.strokes = [{ type: \"SOLID\", color: GRAY_200 }];\n    card.strokeWeight = 1;\n\n    // Photo Container\n    const pContainer = figma.createFrame();\n    pContainer.name = \"Photo_Container\";\n    pContainer.resize(width, height - 130);\n    pContainer.clipsContent = true;\n    pContainer.fills = [];\n    const photo = createInstance(data.photoId);\n    photo.resize(width, height - 130);\n    pContainer.appendChild(photo);\n    card.appendChild(pContainer);\n\n    // Body\n    const body = figma.createFrame();\n    body.name = \"Card_Body\";\n    body.resize(width, 130);\n    body.layoutMode = \"VERTICAL\";\n    body.paddingLeft = 20;\n    body.paddingRight = 20;\n    body.paddingTop = 16;\n    body.paddingBottom = 20;\n    body.itemSpacing = 12;\n    body.fills = [];\n\n    const nameTxt = makeText(data.name, 18, \"Bold\", GRAY_900);\n    body.appendChild(nameTxt);\n\n    // Features row (Bed, Bath, SqFt)\n    const featRow = figma.createFrame();\n    featRow.layoutMode = \"HORIZONTAL\";\n    featRow.itemSpacing = 16;\n    featRow.counterAxisAlignItems = \"CENTER\";\n    featRow.fills = [];\n\n    // Bed\n    const bedBox = figma.createFrame();\n    bedBox.layoutMode = \"HORIZONTAL\";\n    bedBox.itemSpacing = 6;\n    bedBox.counterAxisAlignItems = \"CENTER\";\n    bedBox.fills = [];\n    const iconBed = createInstance(\"3:6\");\n    bedBox.appendChild(iconBed);\n    bedBox.appendChild(makeText(data.bd, 14, \"Regular\", GRAY_600));\n    featRow.appendChild(bedBox);\n\n    // Bath\n    const bathBox = figma.createFrame();\n    bathBox.layoutMode = \"HORIZONTAL\";\n    bathBox.itemSpacing = 6;\n    bathBox.counterAxisAlignItems = \"CENTER\";\n    bathBox.fills = [];\n    const iconBath = createInstance(\"3:5\");\n    bathBox.appendChild(iconBath);\n    bathBox.appendChild(makeText(data.ba, 14, \"Regular\", GRAY_600));\n    featRow.appendChild(bathBox);\n\n    // Sqft\n    const areaBox = figma.createFrame();\n    areaBox.layoutMode = \"HORIZONTAL\";\n    areaBox.itemSpacing = 6;\n    areaBox.counterAxisAlignItems = \"CENTER\";\n    areaBox.fills = [];\n    const iconArea = createInstance(\"3:4\");\n    areaBox.appendChild(iconArea);\n    areaBox.appendChild(makeText(data.sqft, 14, \"Regular\", GRAY_600));\n    featRow.appendChild(areaBox);\n\n    body.appendChild(featRow);\n    card.appendChild(body);\n\n    return card;\n  }\n\n  for (let r = 0; r < 2; r++) {\n    const row = figma.createFrame();\n    row.resize(1280, 360);\n    row.layoutMode = \"HORIZONTAL\";\n    row.itemSpacing = 40;\n    row.fills = [];\n\n    for (let c = 0; c < 3; c++) {\n      const idx = r * 3 + c;\n      const card = makeListingCard(listingsData[idx], 400, 360);\n      listingCardNodes.push(card);\n      row.appendChild(card);\n    }\n    cardsGrid.appendChild(row);\n  }\n\n  listingsSection.appendChild(cardsGrid);\n  homeFrame.appendChild(listingsSection);\n\n  // 3. Agency Intro 1\n  const intro1 = figma.createFrame();\n  intro1.name = \"Agency_Intro_1\";\n  intro1.resize(1440, 480);\n  intro1.layoutMode = \"HORIZONTAL\";\n  intro1.paddingLeft = 80;\n  intro1.paddingRight = 80;\n  intro1.paddingTop = 64;\n  intro1.paddingBottom = 64;\n  intro1.itemSpacing = 64;\n  intro1.counterAxisAlignItems = \"CENTER\";\n  intro1.fills = [{ type: \"SOLID\", color: GRAY_50 }];\n\n  const intro1PhotoWrap = figma.createFrame();\n  intro1PhotoWrap.resize(560, 350);\n  intro1PhotoWrap.cornerRadius = 16;\n  intro1PhotoWrap.clipsContent = true;\n  intro1PhotoWrap.fills = [];\n  const intro1Photo = createInstance(\"3:20\"); // Photo_Agents_Meeting\n  intro1Photo.resize(560, 350);\n  intro1PhotoWrap.appendChild(intro1Photo);\n  intro1.appendChild(intro1PhotoWrap);\n\n  const intro1Content = figma.createFrame();\n  intro1Content.resize(656, 350);\n  intro1Content.layoutMode = \"VERTICAL\";\n  intro1Content.itemSpacing = 20;\n  intro1Content.fills = [];\n\n  intro1Content.appendChild(makeText(\"You’re in good hands\", 36, \"Bold\", GRAY_900));\n  intro1Content.appendChild(makeText(\"Our agents have helped more than 2,000 families buy, sell and rent. We listen first, explain every step and stay with you until the keys are in your hand.\", 16, \"Regular\", GRAY_600));\n  const learnMore1 = makeButton(\"Learn more\", \"dark\", true);\n  intro1Content.appendChild(learnMore1);\n\n  intro1.appendChild(intro1Content);\n  homeFrame.appendChild(intro1);\n\n  // 4. Agency Intro 2\n  const intro2 = figma.createFrame();\n  intro2.name = \"Agency_Intro_2\";\n  intro2.resize(1440, 480);\n  intro2.layoutMode = \"HORIZONTAL\";\n  intro2.paddingLeft = 80;\n  intro2.paddingRight = 80;\n  intro2.paddingTop = 64;\n  intro2.paddingBottom = 64;\n  intro2.itemSpacing = 64;\n  intro2.counterAxisAlignItems = \"CENTER\";\n  intro2.fills = [{ type: \"SOLID\", color: WHITE }];\n\n  const intro2Content = figma.createFrame();\n  intro2Content.resize(656, 350);\n  intro2Content.layoutMode = \"VERTICAL\";\n  intro2Content.itemSpacing = 20;\n  intro2Content.fills = [];\n\n  intro2Content.appendChild(makeText(\"Local experts on every street\", 36, \"Bold\", GRAY_900));\n  intro2Content.appendChild(makeText(\"We live where we work. From school catchments to the quietest blocks, we can tell you what the listing photos don’t.\", 16, \"Regular\", GRAY_600));\n  const learnMore2 = makeButton(\"Learn more\", \"dark\", true);\n  intro2Content.appendChild(learnMore2);\n\n  intro2.appendChild(intro2Content);\n\n  const intro2PhotoWrap = figma.createFrame();\n  intro2PhotoWrap.resize(560, 350);\n  intro2PhotoWrap.cornerRadius = 16;\n  intro2PhotoWrap.clipsContent = true;\n  intro2PhotoWrap.fills = [];\n  const intro2Photo = createInstance(\"3:20\"); // Photo_Agents_Meeting\n  intro2Photo.resize(560, 350);\n  intro2PhotoWrap.appendChild(intro2Photo);\n  intro2.appendChild(intro2PhotoWrap);\n\n  homeFrame.appendChild(intro2);\n\n  // 5. Testimonial Section\n  const testimonial = figma.createFrame();\n  testimonial.name = \"Testimonial_Section\";\n  testimonial.resize(1440, 440);\n  testimonial.layoutMode = \"VERTICAL\";\n  testimonial.paddingLeft = 80;\n  testimonial.paddingRight = 80;\n  testimonial.paddingTop = 64;\n  testimonial.paddingBottom = 64;\n  testimonial.itemSpacing = 40;\n  testimonial.counterAxisAlignItems = \"CENTER\";\n  testimonial.fills = [{ type: \"SOLID\", color: GRAY_50 }];\n\n  const quoteTxt = makeText(\"“Kayley and the team found us a home we love in under a month. They knew every street, never pushed us, and we always felt in good hands.”\", 24, \"Medium\", GRAY_900);\n  quoteTxt.textAlignHorizontal = \"CENTER\";\n  testimonial.appendChild(quoteTxt);\n\n  // Clients Row\n  const clientsRow = figma.createFrame();\n  clientsRow.layoutMode = \"HORIZONTAL\";\n  clientsRow.itemSpacing = 48;\n  clientsRow.counterAxisAlignItems = \"CENTER\";\n  clientsRow.fills = [];\n\n  const clientsData = [\n    { name: \"Leo Madrigal\", isCurrent: true },\n    { name: \"Owen Brooks\", isCurrent: false },\n    { name: \"Mia Chen\", isCurrent: false }\n  ];\n\n  clientsData.forEach(c => {\n    const cCard = figma.createFrame();\n    cCard.layoutMode = \"HORIZONTAL\";\n    cCard.itemSpacing = 12;\n    cCard.counterAxisAlignItems = \"CENTER\";\n    cCard.paddingLeft = 16;\n    cCard.paddingRight = 20;\n    cCard.paddingTop = 10;\n    cCard.paddingBottom = 10;\n    cCard.cornerRadius = 30;\n    if (c.isCurrent) {\n      cCard.fills = [{ type: \"SOLID\", color: WHITE }];\n      cCard.strokes = [{ type: \"SOLID\", color: AMBER }];\n      cCard.strokeWeight = 2;\n    } else {\n      cCard.fills = [];\n    }\n\n    const avatar = createInstance(\"3:18\"); // Avatar_Client\n    avatar.resize(40, 40);\n    cCard.appendChild(avatar);\n\n    const cMeta = figma.createFrame();\n    cMeta.layoutMode = \"VERTICAL\";\n    cMeta.itemSpacing = 2;\n    cMeta.fills = [];\n\n    cMeta.appendChild(makeText(c.name, 15, \"Bold\", GRAY_900));\n    cMeta.appendChild(makeText(\"Client\", 13, \"Regular\", GRAY_600));\n    cCard.appendChild(cMeta);\n\n    clientsRow.appendChild(cCard);\n  });\n\n  testimonial.appendChild(clientsRow);\n  homeFrame.appendChild(testimonial);\n\n  // 6. Call to Action Band\n  const ctaBand = figma.createFrame();\n  ctaBand.name = \"CTA_Band\";\n  ctaBand.resize(1440, 280);\n  ctaBand.layoutMode = \"HORIZONTAL\";\n  ctaBand.paddingLeft = 80;\n  ctaBand.paddingRight = 80;\n  ctaBand.paddingTop = 56;\n  ctaBand.paddingBottom = 56;\n  ctaBand.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  ctaBand.counterAxisAlignItems = \"CENTER\";\n  ctaBand.fills = [{ type: \"SOLID\", color: AMBER }];\n\n  const ctaTextContent = figma.createFrame();\n  ctaTextContent.layoutMode = \"VERTICAL\";\n  ctaTextContent.itemSpacing = 12;\n  ctaTextContent.fills = [];\n\n  ctaTextContent.appendChild(makeText(\"Ready to sell your home?\", 36, \"Bold\", GRAY_900));\n  ctaTextContent.appendChild(makeText(\"Get a free valuation and a clear plan to sell at the right price, on your timeline.\", 18, \"Medium\", GRAY_900));\n\n  ctaBand.appendChild(ctaTextContent);\n\n  const ctaBtn = makeButton(\"Learn more\", \"dark\", true);\n  ctaBand.appendChild(ctaBtn);\n\n  homeFrame.appendChild(ctaBand);\n\n  // 7. Footer\n  const footer01 = makeFooter();\n  homeFrame.appendChild(footer01);\n\n\n  // --- BUILD 02_PROPERTY ---\n  const propFrame = figma.createFrame();\n  propFrame.name = \"02_Property\";\n  propFrame.resize(1440, 3100);\n  propFrame.fills = [{ type: \"SOLID\", color: WHITE }];\n  propFrame.layoutMode = \"VERTICAL\";\n  propFrame.x = 1600; // Position next to Home frame\n\n  const headerObj02 = makeHeader();\n  propFrame.appendChild(headerObj02.header);\n\n  // 1. Title Bar\n  const titleBar = figma.createFrame();\n  titleBar.name = \"Title_Bar\";\n  titleBar.resize(1440, 120);\n  titleBar.layoutMode = \"HORIZONTAL\";\n  titleBar.paddingLeft = 80;\n  titleBar.paddingRight = 80;\n  titleBar.paddingTop = 32;\n  titleBar.paddingBottom = 32;\n  titleBar.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  titleBar.counterAxisAlignItems = \"CENTER\";\n  titleBar.fills = [{ type: \"SOLID\", color: WHITE }];\n  titleBar.strokes = [{ type: \"SOLID\", color: GRAY_100 }];\n  titleBar.strokeWeight = 1;\n\n  const titleLeft = figma.createFrame();\n  titleLeft.layoutMode = \"VERTICAL\";\n  titleLeft.itemSpacing = 6;\n  titleLeft.fills = [];\n\n  titleLeft.appendChild(makeText(\"Modern House\", 32, \"Bold\", GRAY_900));\n  titleLeft.appendChild(makeText(\"3002 Foster Ave, Brooklyn, NY 11210, USA\", 15, \"Regular\", GRAY_600));\n  titleBar.appendChild(titleLeft);\n\n  const titleRight = figma.createFrame();\n  titleRight.layoutMode = \"VERTICAL\";\n  titleRight.itemSpacing = 4;\n  titleRight.counterAxisAlignItems = \"MAX\";\n  titleRight.fills = [];\n\n  titleRight.appendChild(makeText(\"$450,000\", 32, \"Bold\", GRAY_900));\n  titleRight.appendChild(makeText(\"$280/sq ft\", 15, \"Medium\", GRAY_600));\n  titleBar.appendChild(titleRight);\n\n  propFrame.appendChild(titleBar);\n\n  // 2. Gallery Section\n  const gallerySection = figma.createFrame();\n  gallerySection.name = \"Gallery_Section\";\n  gallerySection.resize(1440, 600);\n  gallerySection.layoutMode = \"VERTICAL\";\n  gallerySection.paddingLeft = 80;\n  gallerySection.paddingRight = 80;\n  gallerySection.paddingTop = 32;\n  gallerySection.paddingBottom = 32;\n  gallerySection.itemSpacing = 16;\n  gallerySection.fills = [{ type: \"SOLID\", color: WHITE }];\n\n  // Main Photo\n  const mainPhotoWrap = figma.createFrame();\n  mainPhotoWrap.name = \"Gallery_Main\";\n  mainPhotoWrap.resize(1280, 420);\n  mainPhotoWrap.cornerRadius = 16;\n  mainPhotoWrap.clipsContent = true;\n  mainPhotoWrap.fills = [];\n\n  const mainPhoto = createInstance(\"3:33\"); // Photo_Modern_House_Main\n  mainPhoto.resize(1280, 420);\n  mainPhotoWrap.appendChild(mainPhoto);\n  gallerySection.appendChild(mainPhotoWrap);\n\n  // Thumbnails Row (Photo_Modern_House_1 to 7, selected: none)\n  const thumbsRow = figma.createFrame();\n  thumbsRow.name = \"Gallery_Thumbnails\";\n  thumbsRow.resize(1280, 100);\n  thumbsRow.layoutMode = \"HORIZONTAL\";\n  thumbsRow.itemSpacing = 14;\n  thumbsRow.fills = [];\n\n  const thumbIds = [\n    \"3:27\", \"3:35\", \"3:28\", \"3:29\", \"3:30\", \"3:31\", \"3:32\"\n  ];\n\n  thumbIds.forEach((tId, idx) => {\n    const tWrap = figma.createFrame();\n    tWrap.name = `Thumb_${idx + 1}`;\n    tWrap.resize(170, 100);\n    tWrap.cornerRadius = 8;\n    tWrap.clipsContent = true;\n    tWrap.fills = [];\n    tWrap.strokes = [{ type: \"SOLID\", color: GRAY_200 }];\n    tWrap.strokeWeight = 1;\n\n    const tInst = createInstance(tId);\n    tInst.resize(170, 100);\n    tWrap.appendChild(tInst);\n    thumbsRow.appendChild(tWrap);\n  });\n\n  gallerySection.appendChild(thumbsRow);\n  propFrame.appendChild(gallerySection);\n\n  // 3. Content Section (Main Details Left + Agent Sidebar Right)\n  const contentSection = figma.createFrame();\n  contentSection.name = \"Main_Content_Section\";\n  contentSection.resize(1440, 1200);\n  contentSection.layoutMode = \"HORIZONTAL\";\n  contentSection.paddingLeft = 80;\n  contentSection.paddingRight = 80;\n  contentSection.paddingTop = 40;\n  contentSection.paddingBottom = 64;\n  contentSection.itemSpacing = 64;\n  contentSection.fills = [{ type: \"SOLID\", color: WHITE }];\n\n  // Left Column (800px wide)\n  const leftCol = figma.createFrame();\n  leftCol.name = \"Left_Column\";\n  leftCol.resize(800, 1100);\n  leftCol.layoutMode = \"VERTICAL\";\n  leftCol.itemSpacing = 48;\n  leftCol.fills = [];\n\n  // Description\n  const descBox = figma.createFrame();\n  descBox.name = \"Description_Block\";\n  descBox.resize(800, 240);\n  descBox.layoutMode = \"VERTICAL\";\n  descBox.itemSpacing = 16;\n  descBox.fills = [];\n\n  descBox.appendChild(makeText(\"Description\", 24, \"Bold\", GRAY_900));\n\n  const p1 = \"A bright, single-storey family home on a quiet tree-lined street, a short walk from Foster Avenue’s cafés and the subway.\";\n  const p2 = \"The open-plan kitchen with a large island flows into the living and dining area, with floor-to-ceiling windows onto a private garden. Four bedrooms include a main suite with its own bathroom.\";\n  const p3 = \"Built in 2007 and updated in 2022, the house has a double garage, central air conditioning, new flooring throughout and plenty of built-in storage.\";\n\n  descBox.appendChild(makeText(p1, 16, \"Regular\", GRAY_600));\n  descBox.appendChild(makeText(p2, 16, \"Regular\", GRAY_600));\n  descBox.appendChild(makeText(p3, 16, \"Regular\", GRAY_600));\n\n  leftCol.appendChild(descBox);\n\n  // Details Strip\n  const detailsBox = figma.createFrame();\n  detailsBox.name = \"Details_Block\";\n  detailsBox.resize(800, 100);\n  detailsBox.layoutMode = \"VERTICAL\";\n  detailsBox.itemSpacing = 20;\n  detailsBox.fills = [];\n\n  detailsBox.appendChild(makeText(\"Details\", 24, \"Bold\", GRAY_900));\n\n  const detailsGrid = figma.createFrame();\n  detailsGrid.resize(800, 50);\n  detailsGrid.layoutMode = \"HORIZONTAL\";\n  detailsGrid.itemSpacing = 16;\n  detailsGrid.fills = [];\n\n  const detailsList = [\n    { label: \"4 Bedrooms\", iconId: \"3:6\" },\n    { label: \"2 Bathrooms\", iconId: \"3:5\" },\n    { label: \"2 Garage\", iconId: \"3:13\" },\n    { label: \"1 Floor\", iconId: \"3:12\" },\n    { label: \"Built 2007\", iconId: \"3:7\" }\n  ];\n\n  detailsList.forEach(d => {\n    const dItem = figma.createFrame();\n    dItem.resize(146, 50);\n    dItem.layoutMode = \"HORIZONTAL\";\n    dItem.itemSpacing = 10;\n    dItem.counterAxisAlignItems = \"CENTER\";\n    dItem.paddingLeft = 14;\n    dItem.paddingRight = 14;\n    dItem.paddingTop = 14;\n    dItem.paddingBottom = 14;\n    dItem.cornerRadius = 8;\n    dItem.fills = [{ type: \"SOLID\", color: GRAY_50 }];\n\n    const icon = createInstance(d.iconId);\n    dItem.appendChild(icon);\n    dItem.appendChild(makeText(d.label, 14, \"Medium\", GRAY_900));\n\n    detailsGrid.appendChild(dItem);\n  });\n\n  detailsBox.appendChild(detailsGrid);\n  leftCol.appendChild(detailsBox);\n\n  // Features List (15 items)\n  const featuresBox = figma.createFrame();\n  featuresBox.name = \"Features_Block\";\n  featuresBox.resize(800, 240);\n  featuresBox.layoutMode = \"VERTICAL\";\n  featuresBox.itemSpacing = 20;\n  featuresBox.fills = [];\n\n  featuresBox.appendChild(makeText(\"Features\", 24, \"Bold\", GRAY_900));\n\n  const featuresList = [\n    \"Air conditioning\", \"Central heating\", \"Hardwood floors\",\n    \"Open-plan kitchen\", \"Kitchen island\", \"Dishwasher\",\n    \"Laundry room\", \"Walk-in closet\", \"En-suite bathroom\",\n    \"Private garden\", \"Patio\", \"Double garage\",\n    \"Security system\", \"Solar panels\", \"Storage room\"\n  ];\n\n  const featuresGrid = figma.createFrame();\n  featuresGrid.resize(800, 180);\n  featuresGrid.layoutMode = \"VERTICAL\";\n  featuresGrid.itemSpacing = 16;\n  featuresGrid.fills = [];\n\n  for (let i = 0; i < featuresList.length; i += 3) {\n    const row = figma.createFrame();\n    row.resize(800, 24);\n    row.layoutMode = \"HORIZONTAL\";\n    row.itemSpacing = 16;\n    row.fills = [];\n\n 