{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_62c75aa6df6347838af8e52d","name":"mcp__figma__use_figma","input":{"code":"const P=figma.root.children.find(p=>p.id===\"2003:2\");\nawait figma.setCurrentPageAsync(P);\nawait Promise.all([\"Regular\",\"Medium\",\"SemiBold\",\"Bold\"].map(s=>figma.loadFontAsync({family:\"Roboto\",style:s})));\nconst log={moved:{},tagline:false,mozz:false,chat:[]};\nfor(const fid of [\"2012:313\",\"2012:379\",\"2012:511\"]){\n  const f=await figma.getNodeByIdAsync(fid);\n  let n=0;\n  for(const c of [...f.children]){ if(c.y>=530&&c.y<800){c.y+=26;n++;} }\n  log.moved[fid]=n;\n}\nconst cz=await figma.getNodeByIdAsync(\"2013:493\");\nconst tag=cz.findOne(n=>n.type===\"TEXT\"&&n.characters.includes(\"Customize Your Burger\"));\nif(tag){tag.y+=32;log.tagline=true;}\nconst mozz=cz.findOne(n=>n.type===\"TEXT\"&&n.characters===\"Mozzarella Sticks\");\nif(mozz){mozz.fontSize=11;log.mozz=true;}\ntry{\nconst chat=await figma.getNodeByIdAsync(\"2015:743\");\nconst wrap=chat.findOne(n=>n.name===\"Messages\");\nfor(const b of wrap.children){\n  const t=b.findOne(n=>n.type===\"TEXT\");\n  if(!t)continue;\n  const info={name:b.name,w:Math.round(b.width),tw:Math.round(t.width)};\n  if(t.width<150&&t.characters.length>25){\n    let host=b;\n    try{t.textAutoResize=\"HEIGHT\";t.resize(210,10);}catch(e){}\n    if(t.width<150){\n      host=figma.createComponentFromNode(b);\n      const dt=host.findOne(n=>n.type===\"TEXT\");\n      dt.textAutoResize=\"HEIGHT\";\n      dt.resize(210,10);\n      info.detached=true;\n    }\n    info.newW=Math.round(host.width);info.newTW=Math.round(host.findOne(n=>n.type===\"TEXT\").width);\n  }\n  log.chat.push(info);\n}\n}catch(e){log.chat.push({err:String(e)})}\nreturn JSON.stringify(log);","description":"Fix overlaps and chat bubble widths using createComponentFromNode fallback","fileKey":"HLFV6DkE9fZgeCIwE7fLvf"}}],"id":"8a0ea0d4-0d75-4400-948e-477629522cf2","model":"glm-5.3-flash","role":"assistant