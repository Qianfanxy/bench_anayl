; s.itemSpacing=16; s.counterAxisAlignItems='CENTER'; s.primaryAxisSizingMode='AUTO'; s.counterAxisSizingMode='AUTO'; board.appendChild(s); }\n  return s;\n}\nfunction label(txt){ const t=T(txt,12,S.semi,COL.muted,{name:'LABEL · '+txt,upper:true,ls:8}); return t; }\nfunction comp(name,node){ node.name=name; return node; }\nconst mkButton=(styleType,state)=>{\n  const dark = styleType==='Primary'||styleType==='Secondary';\n  let bg,fg,stroke=null;\n  if(styleType==='Primary'){ bg= state==='Hover'?'#AEF45F':COL.lime; fg=COL.ink; }\n  if(styleType==='Secondary'){ bg= state==='Hover'?'#1A1E26':COL.ink; fg=COL.white; }\n  if(styleType==='Inverse'){ bg= state==='Hover'?'#EDEFE8':COL.white; fg=COL.ink; }\n  if(styleType==='Ghost'){ bg= state==='Hover'?COL.ink:COL.white; fg= state==='Hover'?COL.white:COL.ink; stroke=COL.line; }\n  const b=figma.createFrame(); b.name='style='+styleType+', state='+state;\n  b.layoutMode='HORIZONTAL'; b.primaryAxisAlignItems='CENTER'; b.counterAxisAlignItems='CENTER';\n  b.paddingLeft=28; b.paddingRight=28; b.paddingTop=0; b.paddingBottom=0; b.itemSpacing=10;\n  b.primaryAxisSizingMode='AUTO'; b.counterAxisSizingMode='FIXED'; b.resize(232,56); b.height=56;\n  b.fills=[solid(bg)]; b.cornerRadius=100;\n  if(stroke){ b.strokes=[solid(stroke)]; b.strokeWeight=1; b.strokeAlign='INSIDE'; }\n  const t=T('Button',16,S.semi,fg,{lh:20,name:'Label'}); b.appendChild(t);\n  b.clipsContent=false;\n  return b;\n};\n// BUTTONS\nconst btnSec=section('Buttons');\nlet btnSet=board.findOne(n=>n.type==='COMPONENT_SET'&&n.name==='Button');\nif(!btnSet){\n  btnSet=figma.createComponent(); // temp\n  btnSet.remove();\n  const comps=[];\n  for(const st of ['Primary','Secondary','Inverse','Ghost']) for(const state of ['Default','Hover']) comps.push(mkButton(st,state));\n  btnSet=figma.combineAsVariants(comps,btnSec);\n  btnSet.name='Button';\n  btnSec.appendChild(btnSet);\n}\n// NAV ITEM\nlet navComp=board.findOne(n=>n.name==='Nav Item'&&n.type==='COMPONENT');\nif(!nav