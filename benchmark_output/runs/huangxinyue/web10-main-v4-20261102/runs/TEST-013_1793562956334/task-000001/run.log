INSIDE'}f.clipsContent=!!o.clip;if(o.sh)f.effects=[{type:'DROP_SHADOW',color:{r:0,g:0,b:0,a:o.sh},offset:{x:0,y:16},radius:48,spread:0,visible:true,blendMode:'NORMAL'}];if(p)p.appendChild(f);if(o.w||o.h){f.resize(o.w||f.width,o.h||f.height);if(o.dir){const hz=o.dir==='h';if(o.w)f[hz?'primaryAxisSizingMode':'counterAxisSizingMode']='FIXED';if(o.h)f[hz?'counterAxisSizingMode':'primaryAxisSizingMode']='FIXED';}}if(o.x!==undefined)f.x=o.x;if(o.y!==undefined)f.y=o.y;return f}\nasync function inst(id,p){const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();if(p)p.appendChild(i);return i}\nasync function btn(p,label,w=207,h=56){const b=await inst('1:24',p);b.resize(w,h);b.name=label;b.findOne(n=>n.type==='TEXT').characters=label;return b}\nfunction setp(i,o){const pr=i.componentProperties;const m={};for(const [k,v] of Object.entries(o)){const key=Object.keys(pr).find(x=>x===k||x.split('#')[0]===k);if(key)m[key]=v;}i.setProperties(m);return i}\nasync function variant(setId,props,p){const s=await figma.getNodeByIdAsync(setId);const want=Object.entries(props).map(([k,v])=>k+'='+v);const v=s.children.find(c=>want.every(w=>c.name.split(', ').includes(w)));const i=v.createInstance();if(p)p.appendChild(i);return i}\nconst K={rating:'12:71',checkbox:'12:81',size:'12:88',swatch:'12:95',tab:'12:102',page:'12:109',view:'12:132',stepper:'12:138',countdown:'12:142',breadcrumb:'12:148',btnOutline:'12:151',tfFocused:'12:157',social:'12:161',tag:'12:164',heading:'12:168',arrows:'12:176',headerHome:'11:33',headerStore:'11:159',footer:'11:187',arrival:'13:101',shopCard:'13:123',testimonial:'13:160',features:'13:187',instagram:'13:200',newsletter:'13:213',collection:'14:147',deals:'14:189',hero:'14:199'};\nconst board=await figma.getNodeByIdAsync('11:2');\n// Brand strip component\nconst bsrow=F(board,{n:'Sections C',dir:'v',g:48});\nconst bs=F(bsrow,{n:'Brand Strip',dir:'h',w:1920,h:180,p:[0,240],ja:'SPACE_BETWEEN',ai:'CENTER',bg:C.white});\nconst bsf=[['Minimog','Volkhov','Bo