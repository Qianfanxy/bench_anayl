ild(m1);\nconst lg=await media('Logo',40);lg.name='Logo';ch.appendChild(lg);\nconst tc=AL('Assistant','VERTICAL',{gap:2});ch.appendChild(tc);tc.layoutGrow=1;\ntc.appendChild(await T('Chat Bot AI 4.5','Title/17','text/primary'));\nconst pr=AL('Premium','HORIZONTAL',{gap:4,align:'CENTER'});pr.appendChild(await icon('Premium','semantic/warning',14));pr.appendChild(await T('Premium account','Caption/12','semantic/warning'));tc.appendChild(pr);\nconst ex=await iconBtn('Export','Tonal');ex.name='Export';ch.appendChild(ex);\nconst bl=figma.createRectangle();\nlib.appendChild(ch);out.chatHeader=ch.id;\nch.strokes=[P('border/default')];ch.strokeTopWeight=0;ch.strokeLeftWeight=0;ch.strokeRightWeight=0;ch.strokeBottomWeight=1;bl.remove();\n\n// Page header\nconst ph=CMP('Header/Page','HORIZONTAL',{gap:8,pad:[8,16,8,16],align:'CENTER',fill:'surface/bg'});ph.primaryAxisSizingMode='FIXED';ph.resize(428,60);\nconst b1=await iconBtn('Back');b1.name='Back';ph.appendChild(b1);\nconst pt=await T('Profile & Settings','Heading/20','text/primary',{align:'CENTER'});ph.appendChild(pt);pt.layoutGrow=1;\nconst mo=await iconBtn('More');mo.name='More';ph.appendChild(mo);\nconst ptp=ph.addComponentProperty('Title','TEXT','Profile & Settings');pt.componentPropertyReferences={characters:ptp};\nlib.appendChild(ph);out.pageHeader=ph.id;out.phProp=ptp;\n\n// Composer\nconst cp=CMP('Chat Composer','HORIZONTAL',{gap:10,pad:[12,16,12,16],align:'CENTER',fill:'surface/bg'});cp.primaryAxisSizingMode='FIXED';cp.resize(428,76);\ncp.strokes=[P('border/default')];cp.strokeTopWeight=1;cp.strokeBottomWeight=0;cp.strokeLeftWeight=0;cp.strokeRightWeight=0;\nconst inp=AL('Input','HORIZONTAL',{pad:[0,20,0,20],r:999,fill:'surface/subtle',align:'CENTER'});inp.counterAxisSizingMode='FIXED';inp.resize(300,52);stroke(inp,'border/default');cp.appendChild(inp);inp.layoutGrow=1;\ninp.appendChild(await T('Ask me anything...','Body/16','text/tertiary'));\nconst snd=await iconBtn('Send','Filled');snd.name='Send';snd.resize(52