olor: rgb(onDark?'#16292C':'#F2F4F5')}];\n  box.strokes=[{type:'SOLID', color: rgb(WHITE), opacity: onDark?0.28:0}];\n  box.strokeWeight=1;\n  txt(box,'English',{x:16,y:11,size:14,style:'Medium',color:onDark?WHITE:INK});\n  await icon(box,'3:12', 88, 14, onDark?WHITE:INK);\n  return box;\n}\n\n// ---------------- 01_Splash ----------------\nconst s1 = screen('01_Splash', 0, 1700, TEAL);\nconst glow = figma.createEllipse(); s1.appendChild(glow);\nglow.resize(620,620); glow.x=-95; glow.y=470;\nglow.fills=[{type:'GRADIENT_RADIAL', gradientStops:[{position:0,color:{...rgb('#0C93A8'),a:1}},{position:1,color:{...rgb(TEAL),a:0}}], gradientTransform:[[1,0,0],[0,1,0]]}];\nglow.opacity=0.6;\nconst ring = figma.createEllipse(); s1.appendChild(ring);\nring.resize(1500,1500); ring.x=-535; ring.y=-300;\nring.fills=[]; ring.strokes=[{type:'SOLID', color: rgb(WHITE), opacity:0.07}]; ring.strokeWeight=1.5;\nconst ring2 = figma.createEllipse(); s1.appendChild(ring2);\nring2.resize(1100,1100); ring2.x=-335; ring2.y=-100;\nring2.fills=[]; ring2.strokes=[{type:'SOLID', color: rgb(WHITE), opacity:0.05}]; ring2.strokeWeight=1.5;\nawait logo(s1, 88, 330, 254);\nconst tl = txt(s1,'Your Passport to Seamless Adventures!',{x:57,y:452,w:316,size:16,style:'Medium',color:WHITE,align:'CENTER',lh:24,ls:0.2});\nconst rule = figma.createRectangle(); s1.appendChild(rule);\nrule.resize(28,2); rule.x=201; rule.y=tl.y+tl.height+26; rule.fills=[{type:'SOLID',color:rgb(WHITE),opacity:0.5}];\nawait statusBar(s1,true); await homeInd(s1,true);\n\n// ---------------- 02_Get_Started ----------------\nconst s2 = screen('02_Get_Started', 510, 1700, WHITE);\nphoto(s2,'7b6d1c2045c7a1fa43b42d66b3a8a325f3e3852e',0,0,430,932);\nconst shade = figma.createRectangle(); s2.appendChild(shade);\nshade.resize(430,932); shade.x=0; shade.y=0;\nshade.fills=[{type:'GRADIENT_LINEAR', gradientStops:[\n  {position:0,color:{...rgb('#06272C'),a:0.55}},\n  {position:0.42,color:{...rgb('#06272C'),a:0.10}},\n  {position:0.66,color:{...r