horRow',w:500,h:44,x:470,y:290});\nconst pav=avC.createInstance();pm.appendChild(pav);pav.x=0;pav.y=4;\nT(pm,{name:'an',w:200,sz:15,st:'sb',x:60,y:8},'Dianne Russell');\nT(pm,{name:'ad',w:180,sz:13,c:P.muted,x:230,y:9},'12 November 2021');\nT(post,{name:'PostIntro',w:820,sz:17,c:P.body,lh:1.75,al:'CENTER',x:310,y:352},'We asked a working head chef about first jobs, long services and what it really takes to make it in a professional kitchen.');\nIMG(post,{name:'Photo_Blog_Chef',w:880,h:480,hash:'6dec8dddf4ffcb0c0abffb94735b2140af713fcb',r:28,x:280,y:452});\n\nconst body=F(post,{name:'ArticleBody',w:760,h:100,x:340,y:980});\nlet cy=0;\nfunction para(txt){const t=T(body,{name:'p'+cy,w:760,sz:17,c:'#2E2E38',lh:1.85,x:0,y:cy},txt);cy+=t.height+30;return t;}\nfunction qa(q,a){const qt=T(body,{name:'q',w:760,sz:23,st:'sb',lh:1.4,x:0,y:cy},q);cy+=qt.height+14;para(a);cy+=10;}\nqa('How did you start out in the food industry?','I started washing dishes in a small family restaurant when I was sixteen. Watching the line cooks every night made me want to be on the other side of the pass, and after two years the chef finally let me prep vegetables.');\nqa('What do you like most about your job?','The rhythm of service. Hours of preparation come down to a few intense minutes, and when a full dining room goes quiet because everyone is eating, it feels like the whole team has done something together.');\nqa('Do you cook at home on your days off?','Yes, but simply. I cook the food I grew up with: rice, eggs and whatever vegetables look good at the market. Home cooking is where I remember why I love food.');\nIMG(body,{name:'Photo_Cooking_Step',w:760,h:420,hash:'9665b6bf671bacada67b16214fdf0feb3557835f',r:24,x:0,y:cy});\ncy+=452;\nqa('What would your advice be to young people looking to get their foot in the door?','Start anywhere and be the person who shows up early. Ask questions, taste everything and write down what you learn.');\n// pull quote\nconst pq=F(body,{name:'PullQuote',w:7