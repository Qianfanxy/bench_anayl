'?f.primaryAxisSizingMode='FIXED':f.counterAxisSizingMode='FIXED'}return f;}\nconst add=(p,...k)=>{k.forEach(x=>p.appendChild(x));return p};\nconst N=id=>figma.getNodeByIdAsync(id);\nconst ICON={Notification:'2:60',Scan:'2:80',Filter:'2:85',Search:'2:95',Chevron_Right:'4:12',Deposit:'2:103',Referral:'2:108',Earn:'2:113',Save_Coins:'2:118',Orders:'2:123',Shop:'2:128',Gift_Card:'2:133',More_Horizontal:'2:138'};\nconst COIN={BTC:'4:132',ETH:'4:135',XRP:'4:138',BNB:'4:141',SOL:'4:144'};\nconst recolor=(n,c)=>n.findAll(v=>v.type==='VECTOR'||v.type==='BOOLEAN_OPERATION').forEach(v=>v.fills=S(c));\nasync function icon(name,color,size=24){const i=(await N(ICON[name])).createInstance();i.name='Icon';i.fills=[];recolor(i,color);if(size!==24)i.rescale(size/24);return i;}\nconst lib=await N('11:2');lib.y=1400;const setBy=n=>lib.children.find(c=>(c.type==='COMPONENT_SET'||c.type==='COMPONENT')&&c.name===n);const V=(n,p)=>{const s=setBy(n);return (s.type==='COMPONENT'?s:s.children.find(c=>c.name===p)).createInstance();};\nconst at=(p,n,x,y)=>{p.appendChild(n);n.x=x;n.y=y;return n};\nconst setT=(i,name,val)=>{const t=i.findOne(n=>n.type==='TEXT'&&n.name===name);t.characters=val;return t};\nasync function iconBtn(ic,unread=false){const b=V('Icon Button',`Theme=Dark, Unread=${unread}`);const i=b.findOne(n=>n.name==='Icon');if(ic!=='Notification')i.swapComponent(await N(ICON[ic]));recolor(i,C.dText);i.fills=[];b.name='Action · '+ic;return b;}\nasync function screen(name,x,y){const s=figma.createFrame();s.name=name;s.resize(390,844);s.x=x;s.y=y;s.clipsContent=true;s.fills=S(C.dBg);ws.appendChild(s);\n const sb=(await N('6:32')).createInstance();sb.fills=[];sb.findAll(n=>['TEXT','RECTANGLE','ELLIPSE'].includes(n.type)).forEach(n=>n.fills=S('#FFFFFF'));sb.findOne(n=>n.name==='Battery').strokes=S('#FFFFFF');at(s,sb,0,0);return s;}\nasync function homeInd(s){const h=(await N('6:42')).createInstance();h.fills=[];h.findAll(n=>n.type==='RECTANGLE').forEach(r=>r.fills=S('#FFFFFF'));at(s,h,0,8