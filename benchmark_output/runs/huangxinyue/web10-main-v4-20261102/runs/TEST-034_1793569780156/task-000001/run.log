{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_42710d61b05d40dca06fe48c","name":"mcp__figma__use_figma","input":{"code":"for (const f of [['Archivo Black','Regular'],['Plus Jakarta Sans','Regular'],['Plus Jakarta Sans','Medium'],['Plus Jakarta Sans','SemiBold'],['Plus Jakarta Sans','Bold'],['Inter','Regular']]) {\n  await figma.loadFontAsync({family: f[0], style: f[1]});\n}\nconst ws = await figma.getNodeByIdAsync('6:2');\nconst hex = h => ({ r: parseInt(h.slice(1,3),16)/255, g: parseInt(h.slice(3,5),16)/255, b: parseInt(h.slice(5,7),16)/255 });\nconst S = (h, o) => ({ type: 'SOLID', color: hex(h), opacity: o === undefined ? 1 : o });\nconst ids = {};\nfor (const n of ws.children) {\n  if (['Hero','Brand Strip','Filter Panel','Pagination','Announcement Bar','Header','Newsletter','Footer','Product Card','Style Tile','Review Card','Product Review Card','Cart Line Item'].includes(n.name)) ids[n.name] = n.id;\n}\nlet cx = 4300, cy = -5400, rowH = 0;\nfunction place(node) {\n  ws.appendChild(node);\n  node.x = cx; node.y = cy;\n  cx += node.width + 120;\n  if (node.height > rowH) rowH = node.height;\n  if (cx > 6800) { cx = 100; cy += rowH + 120; rowH = 0; }\n}\nfunction txt(str, style, size, h, opts) {\n  const t = figma.createText();\n  t.fontName = { family: 'Plus Jakarta Sans', style: style };\n  t.characters = str;\n  t.fontSize = size;\n  t.fills = [S(h)];\n  opts = opts || {};\n  if (opts.lh) t.lineHeight = { value: opts.lh, unit: 'PIXELS' };\n  return t;\n}\nfunction atxt(str, size, h, opts) {\n  const t = figma.createText();\n  t.fontName = { family: 'Archivo Black', style: 'Regular' };\n  t.characters = str;\n  t.fontSize = size;\n  t.fills = [S(h)];\n  return t;\n}\nasync function iconInst(compId, size, tintHex) {\n  const comp = await figma.getNodeByIdAsync(compId);\n  const inst = comp.createInstance();\n  inst.resize(size, size);\n  inst.fills = [];\n  if (tintHex) {\n    const walk = n => {\n      if ('fills' in n && Array.isArray(n.fills) && n.fills.length && n.type !== 'INSTANCE') { try { n.fills = [S(tintHex)]; } catch (e) {} }\n      if ('children' in n) n.children.forEach(walk);\n    };\n    inst.children.forEach(walk);\n  }\n  return inst;\n}\nfunction hframe(name, gap, align) {\n  const f = figma.createFrame();\n  f.name = name;\n  f.layoutMode = 'HORIZONTAL';\n  f.fills = [];\n  f.primaryAxisSizingMode = 'AUTO';\n  f.counterAxisSizingMode = 'AUTO';\n  f.itemSpacing = gap;\n  if (align) f.counterAxisAlignItems = align;\n  return f;\n}\nfunction vframe(name, gap) {\n  const f = figma.createFrame();\n  f.name = name;\n  f.layoutMode = 'VERTICAL';\n  f.fills = [];\n  f.primaryAxisSizingMode = 'AUTO';\n  f.counterAxisSizingMode = 'AUTO';\n  f.itemSpacing = gap;\n  return f;\n}\nconst divider = (w, hcol) => {\n  const r = figma.createRectangle();\n  r.resize(w, 1);\n  r.fills = [S(hcol || '#E0E0E0')];\n  return r;\n};\n\n// ============ Gallery ============\n{\n  const comp = figma.createComponent();\n  comp.name = 'Gallery';\n  comp.layoutMode = 'HORIZONTAL';\n  comp.primaryAxisSizingMode = 'FIXED';\n  comp.counterAxisSizingMode = 'AUTO';\n  comp.resize(612, 530);\n  comp.itemSpacing = 16;\n  comp.fills = [];\n  const thumbs = vframe('thumbs', 12);\n  for (let i = 0; i < 3; i++) {\n    const t = figma.createFrame();\n    t.name = 'thumb' + (i + 1);\n    t.layoutMode = 'HORIZONTAL';\n    t.primaryAxisSizingMode = 'FIXED'; t.counterAxisSizingMode = 'FIXED';\n    t.resize(152, 152);\n    t.primaryAxisAlignItems = 'CENTER'; t.counterAxisAlignItems = 'CENTER';\n    t.cornerRadius = 20;\n    t.fills = [S('#F0F0F0')];\n    if (i === 0) { t.strokes = [S('#000000')]; t.strokeWeight = 1; }\n    const ph = (await figma.getNodeByIdAsync(i === 0 ? '4:38' : i === 1 ? '4:39' : '4:50')).createInstance();\n    ph.resize(132, 132);\n    ph.cornerRadius = 16;\n    t.appendChild(ph);\n    thumbs.appendChild(t);\n  }\n  comp.appendChild(thumbs);\n  const main = figma.createFrame();\n  main.name = 'main';\n  main.layoutMode = 'HORIZONTAL';\n  main.primaryAxisSizingMode = 'FIXED'; main.counterAxisSizingMode = 'FIXED';\n  main.resize(444, 530);\n  main.primaryAxisAlignItems = 'CENTER'; main.counterAxisAlignItems = 'CENTER';\n  main.cornerRadius = 20;\n  main.fills = [S('#F0F0F0')];\n  const mph = (await figma.getNodeByIdAsync('4:38')).createInstance();\n  mph.name = 'photo';\n  mph.resize(394, 490);\n  main.appendChild(mph);\n  comp.appendChild(main);\n  place(comp);\n  ids['Gallery'] = comp.id;\n}\n\n// ============ Color Picker ============\n{\n  const comp = figma.createComponent();\n  comp.name = 'Color Picker';\n  comp.layoutMode = 'VERTICAL';\n  comp.primaryAxisSizingMode = 'AUTO';\n  comp.counterAxisSizingMode = 'AUTO';\n  comp.itemSpacing = 16;\n  comp.fills = [];\n  comp.appendChild(txt('Select Colors', 'Bold', 16, '#000000'));\n  const row = hframe('row', 12, 'CENTER');\n  const cols = [['olive', '#4F4631', true], ['teal', '#314F4A', false], ['navy', '#31344F', false]];\n  for (const [nm, c, sel] of cols) {\n    const sw = figma.createFrame();\n    sw.name = 'swatch-' + nm;\n    sw.layoutMode = 'HORIZONTAL';\n    sw.primaryAxisSizingMode = 'FIXED'; sw.counterAxisSizingMode = 'FIXED';\n    sw.resize(32, 32);\n    sw.cornerRadius = 16;\n    sw.fills = [S(c)];\n    if (sel) {\n      const ck = await iconInst('4:8', 18, '#FFFFFF');\n      sw.appendChild(ck);\n      ck.layoutPositioning = 'ABSOLUTE';\n      ck.x = 7; ck.y = 7;\n    }\n    row.appendChild(sw);\n  }\n  comp.appendChild(row);\n  place(comp);\n  ids['ColorPicker'] = comp.id;\n}\n\n// ============ Size Picker ============\n{\n  const comp = figma.createComponent();\n  comp.name = 'Size Picker';\n  comp.layoutMode = 'VERTICAL';\n  comp.primaryAxisSizingMode = 'AUTO';\n  comp.counterAxisSizingMode = 'AUTO';\n  comp.itemSpacing = 16;\n  comp.fills = [];\n  comp.appendChild(txt('Choose Size', 'Bold', 16, '#000000'));\n  const row = hframe('row', 12, 'MIN');\n  row.layoutWrap = 'WRAP';\n  row.counterAxisSpacing 