id){ if(!comps[id]) comps[id]=await figma.getNodeByIdAsync(id); return comps[id]; }\nasync function inst(id,w,h){ const c=await comp(id); const i=c.createInstance(); if(w&&h) i.resize(w,h); return i; }\nasync function icon(id,size,colorHex){ const c=await comp(id); const i=c.createInstance(); const s=size/Math.max(c.width,c.height); i.rescale(s); if(colorHex){ const rec=n=>{ if('fills' in n && Array.isArray(n.fills) && n.fills.some(f=>f.type==='SOLID')) n.fills=[sol(colorHex)]; if('children' in n) n.children.forEach(rec); }; rec(i);} return i; }\nfunction stretchFill(parent,n){ parent.appendChild(n); n.layoutAlign='STRETCH'; n.primaryAxisSizingMode='FIXED'; n.counterAxisSizingMode='AUTO'; }\n\nconst prod=figma.createFrame(); prod.name='03_Product'; prod.resize(1440,100); prod.fills=[sol(C.white)];\nprod.layoutMode='VERTICAL'; prod.itemSpacing=0; prod.primaryAxisSizingMode='AUTO'; prod.counterAxisSizingMode='FIXED'; prod.clipsContent=true;\nconst hI=(await comp('18:2')).createInstance(); hI.layoutAlign='STRETCH'; prod.appendChild(hI);\n\nconst cb=fr('BreadcrumbBar'); cb.fills=[sol(C.cream)]; al(cb,{mode:'HORIZONTAL',gap:14,cross:'CENTER',pad:[38,100,38,100]});\ncb.appendChild(txt('Home',16,F.reg,C.muted,{name:'Crumb home'}));\ncb.appendChild(await icon('13:46',20,C.ink));\ncb.appendChild(txt('Shop',16,F.reg,C.muted,{name:'Crumb shop'}));\ncb.appendChild(await icon('13:46',20,C.ink));\nconst sepv=figma.createRectangle(); sepv.resize(2,30); sepv.fills=[sol(C.muted)]; cb.appendChild(sepv);\ncb.appendChild(txt('Asgaard sofa',16,F.reg,C.ink,{name:'Crumb current'}));\nstretchFill(prod,cb);\n\nconst main=fr('Product main'); al(main,{mode:'HORIZONTAL',gap:80,pad:[36,100,60,100]}); main.fills=[sol(C.white)];\nconst gal=fr('Gallery'); al(gal,{mode:'HORIZONTAL',gap:32});\nconst thumbs=fr('Thumbs'); al(thumbs,{mode:'VERTICAL',gap:32});\nfor (const tp of ['13:4','13:14','13:64','13:13']){ const t=await inst(tp,80,80); t.cornerRadius=10; thumbs.appendChild(t); }\ngal.appendChild(thumbs);\nconst mainPhoto=await inst('13:4',423,500); mainPhoto.cornerRadius=10; gal.appendChild(mainPhoto);\nmain.appendChild(gal);\n\nconst info=fr('Info'); al(info,{mode:'VERTICAL',gap:14});\ninfo.appendChild(txt('Asgaard sofa',42,F.reg,C.ink,{name:'Product title'}));\ninfo.appendChild(txt('Rs. 250,000.00',24,F.med,C.muted,{name:'Price'}));\nconst rateRow=fr('Rating row'); al(rateRow,{mode:'HORIZONTAL',gap:18,cross:'CENTER'});\nconst stars=fr('Stars'); al(stars,{mode:'HORIZONTAL',gap:6,cross:'CENTER'});\nfor(let i=0;i<4;i++) stars.appendChild(await icon('13:31',20));\nstars.appendChild(await icon('13:52',20));\nrateRow.appendChild(stars);\nconst sepr=figma.createRectangle(); sepr.resize(1,30); sepr.fills=[sol(C.muted)]; rateRow.appendChild(sepr);\nrateRow.appendChild(txt('4.7',14,F.med,C.ink,{name:'Rating value'}));\nrateRow.appendChild(txt('204 Customer Reviews',13,F.reg,C.muted,{name:'Reviews'}));\ninfo.appendChild(rateRow);\ninfo.appendChild(txt('Setting the bar as one of the most comfortable sofas in its class, the Asgaard is a compact, sturdy three-seater with a solid-wood frame and deep, soft cushions.',13,F.reg,C.ink,{w:460,lh:150,name:'Short description'}));\nconst sp1=fr('sp'); sp1.resize(4,4); info.appendChild(sp1);\ninfo.appendChild(txt('Size',14,F.reg,C.muted,{name:'Size label'}));\nconst sizes=fr('Sizes'); al(sizes,{mode:'HORIZONTAL',gap:16});\nconst mkSize=(l,sel)=>{ const s=fr('Size/'+l); s.resize(30,30); s.cornerRadius=5; if(sel) s.fills=[sol(C.gold)]; else s.fills=[sol(C.cream)]; al(s,{mode:'HORIZONTAL',main:'CENTER',cross:'CENTER'}); s.primaryAxisSizingMode='FIXED'; s.counterAxisSizingMode='FIXED'; s.appendChild(txt(l,13,sel?F.med:F.reg,sel?C.white:C.ink)); return s; };\nsizes.appendChild(mkSize('L',true)); sizes.appendChild(mkSize('XL',false)); sizes.appendChild(mkSize('XS',false));\ninfo.appendChild(sizes);\nconst sp2=fr('sp'); sp2.resize(4,4); info.appendChild(sp2);\ninfo.appendChild(txt('Color',14,F.reg,C.muted,{name:'Color label'}));\nconst colors=fr('Colors'); al(colors,{mode:'HORIZONTAL',gap:16});\nconst mkColor=(hexv,sel)=>{ const w=fr('Color/'+hexv); w.resize(38,38); w.primaryAxisSizingMode='FIXED'; w.counterAxisSizingMode='FIXED'; const ring=figma.createEllipse(); ring.resize(38,38); ring.fills=[]; ring.strokes=sel?[sol(C.gold)]:[]; ring.strokeWeight=2; ring.x=0; ring.y=0; w.appendChild(ring); const dot=figma.createEllipse(); dot.resize(30,30); dot.fills=[sol(hexv)]; dot.x=4; dot.y=4; w.appendChild(dot); return w; };\ncolors.appendChild(mkColor('816DFA',true)); colors.appendChild(mkColor('000000',false)); colors.appendChild(mkColor('B88E2F',false));\ninfo.appendChild(colors);\nconst sp3=fr('sp'); sp3.resize(4,8); info.appendChild(sp3);\nconst buyRow=fr('Buy row'); al(buyRow,{mode:'HORIZONTAL',gap:18,cross:'CENTER'});\nconst qty=fr('Quantity'); qty.resize(123,64); qty.cornerRadius=10; qty.strokes=[sol(C.muted)]; qty.strokeWeight=1; al(qty,{mode:'HORIZONTAL',main:'SPACE_BETWEEN',cross:'CENTER',pad:[0,12,0,12]}); qty.primaryAxisSizingMode='FIXED'; qty.counterAxisSizingMode='FIXED';\nqty.appendChild(txt('-',20,F.reg,C.ink,{name:'Qty minus'})); qty.appendChild(txt('1',16,F.med,C.ink,{name:'Qty value'})); qty.appendChild(txt('+',20,F.reg,C.ink,{name:'Qty plus'}));\nbuyRow.appendChild(qty);\nconst atc=fr('Add To Cart'); atc.cornerRadius=15; atc.strokes=[sol(C.ink)]; atc.strokeWeight=1; al(atc,{mode:'HORIZONTAL',pad:[17,48,17,48]}); atc.appendChild(txt('Add To Cart',20,F.reg,C.ink));\nbuyRow.appendChild(atc);\nconst cmpBtn=fr('CompareBtn'); cmpBtn.cornerRadius=15; cmpBtn.strokes=[sol(C.ink)]; cmpBtn.strokeWeight=1; al(cmpBtn,{mode:'HORIZONTAL',pad:[17,48,17,48]}); cmpBtn.appendChild(txt('+ Compare',20,F.reg,C.ink));\nbuyRow.appendChild(cmpBtn);\ninfo.appendChild(buyRow);\nconst divider=figma.createRectangle(); divider.resize(605,1); divider.fills=[sol('D9D9D9')]; info.appendChild(divider);\nconst meta=fr('Meta'); al(meta,{mode:'VERTICAL',gap:12});\nconst mkMeta=(k,v)=>{ const r=fr('Meta '+k); al(r,{mode:'HORIZONTAL',gap:16}); r.appendChild(txt(k,16,F.reg,C.muted,{w:100})); r.appendChild(txt(':  '+v,16,F.reg,C.muted)); return r; };\nmeta.appendChild(mkMeta('SKU','SS001')); meta.appendChild(mkMeta('Category','Sofas')); meta.appendChild(mkMeta('Tags','Sofa, Chair, Home, Shop'));\nconst shareRow=fr('Meta Share'); al(shareRow,{mode:'HORIZONTAL',gap:16,cross:'CENTER'});\nshareRow.appendChild(txt('Share',16,F.reg,C.muted,{w:100})); shareRow.appendChild(txt(':',16,F.reg,C.muted));\nshareRow.appendChild(await icon('13:44',20,C.ink)); shareRow.appendChild(await icon('13:35',20,C.ink)); shareRow.appendChild(await icon('13:36',20,C.ink));\nmeta.appendChild(shareRow); info.appendChild(meta);\nmain.appendChild(info); stretchFill(prod,main);\n\nWS.appendChild(prod); prod.x=3200; prod.y=0;\nreturn {prod:prod.id, h:prod.height};\n","description":"Build 03_Product part 1: header, breadcrumb bar, gallery with thumbnails, info (title, price, rating, sizes, colors, quantity, buttons, meta)"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"4169e7d1-fa58-4180-9c80-2a57d8444911","uuid":"6c5bda26-4c8b-48bb-ac89-1eea5166c5e3","timestamp":"2026-11-01T19:26:50.500Z","tool_use_meta":[{"id":"mcp__figma__use_figma_21_a701af5c","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
