, color: { r: 0.5, g: 0.5, b: 0.56 } }];\n    frame.appendChild(dateText);\n\n    const forYouTitle = figma.createText();\n    forYouTitle.characters = \"For You Today\";\n    forYouTitle.fontName = { family: \"Nunito\", style: \"ExtraBold\" };\n    forYouTitle.fontSize = 24;\n    forYouTitle.x = 16;\n    forYouTitle.y = 142;\n    forYouTitle.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    frame.appendChild(forYouTitle);\n\n    // For You Cards Horizontal Scroll Container\n    const forYouScroll = figma.createFrame();\n    forYouScroll.name = \"For_You_Scroll\";\n    forYouScroll.x = 0;\n    forYouScroll.y = 182;\n    forYouScroll.resize(375, 150);\n    forYouScroll.fills = [];\n    forYouScroll.clipsContent = false;\n    frame.appendChild(forYouScroll);\n\n    const createForYouCard = (x, title, risk, participants, yearly, riskColor) => {\n      const card = figma.createFrame();\n      card.name = \"For_You_Card\";\n      card.x = x;\n      card.y = 0;\n      card.resize(240, 150);\n      card.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n      card.cornerRadius = 20;\n      card.effects = [{\n        type: 'DROP_SHADOW',\n        color: { r: 0, g: 0, b: 0, a: 0.04 },\n        offset: { x: 0, y: 4 },\n        radius: 12,\n        visible: true,\n        blendMode: 'NORMAL'\n      }];\n\n      const t = figma.createText();\n      t.characters = title;\n      t.fontName = { family: \"Nunito\", style: \"Bold\" };\n      t.fontSize = 16;\n      t.x = 16;\n      t.y = 16;\n      t.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n      card.appendChild(t);\n\n      const r = figma.createText();\n      r.characters = risk;\n      r.fontName = { family: \"Nunito\", style: \"Bold\" };\n      r.fontSize = 11;\n      r.x = 16;\n      r.y = 42;\n      r.fills = [{ type: 'SOLID', color: riskColor }];\n      card.appendChild(r);\n\n      const p = figma.createText();\n      p.characters = participants + \" participants\";\n      p.fontName = { family: \"Nunito\", style: \"Medium\" };\n      p.fontSize = 11;\n      p.x = 16;\n      p.y = 62;\n      p.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.56 } }];\n      card.appendChild(p);\n\n      const y = figma.createText();\n      y.characters = yearly + \" per year\";\n      y.fontName = { family: \"Nunito\", style: \"ExtraBold\" };\n      y.fontSize = 18;\n      y.x = 16;\n      y.y = 88;\n      y.fills = [{ type: 'SOLID', color: { r: 0.18, g: 0.72, b: 0.45 } }];\n      card.appendChild(y);\n\n      // View button (small badge)\n      const viewBadge = figma.createFrame();\n      viewBadge.name = \"View_Badge\";\n      viewBadge.x = 168;\n      viewBadge.y = 108;\n      viewBadge.resize(56, 26);\n      viewBadge.cornerRadius = 13;\n      viewBadge.fills = [{ type: 'SOLID', color: { r: 0.94, g: 0.94, b: 0.96 } }];\n      card.appendChild(viewBadge);\n\n      const viewText = figma.createText();\n      viewText.characters = \"View\";\n      viewText.fontName = { family: \"Nunito\", style: \"Bold\" };\n      viewText.fontSize = 12;\n      viewText.x = 14;\n      viewText.y = 4;\n      viewText.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n      viewBadge.appendChild(viewText);\n\n      return card;\n    };\n\n    const card1 = createForYouCard(16, \"Stable Income\", \"Low risk\", \"10,982\", \"6.24%\", { r: 0.18, g: 0.72, b: 0.45 });\n    forYouScroll.appendChild(card1);\n\n    const card2 = createForYouCard(268, \"Binance Index Strategy\", \"Medium risk\", \"264\", \"12.56%\", { r: 0.95, g: 0.61, b: 0.07 });\n    forYouScroll.appendChild(card2);\n\n    // \"Investing Strategies\" Section\n    const strategiesHeader = figma.createText();\n    strategiesHeader.characters = \"Investing Strategies\";\n    strategiesHeader.fontName = { family: \"Nunito\", style: \"Bold\" };\n    strategiesHeader.fontSize = 18;\n    strategiesHeader.x = 16;\n    strategiesHeader.y = 356;\n    strategiesHeader.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    frame.appendChild(strategiesHeader);\n\n    // List of strategies\n    const strategiesData = [\n      { name: \"The Big Long\", return: \"15.16%\", logos: [\"Coin_BTC\", \"Coin_ETH\", \"Coin_USDT\"], more: \"+3\" },\n      { name: \"Aggressive Growth\", return: \"159.00%\", logos: [\"Coin_MATIC\", \"Coin_MANA\", \"Coin_CAKE\"], more: \"+2\" },\n      { name: \"Best Projects\", return: \"46.22%\", logos: [\"Coin_NEAR\", \"Coin_DASH\", \"Coin_AVAX\"], more: \"+12\" },\n      { name: \"Strategy 2022\", return: \"26.08%\", logos: [\"Coin_ETC\", \"Coin_DAI\", \"Coin_BNB\"], more: \"+2\" }\n    ];\n\n    let stratY = 388;\n    strategiesData.forEach(strat => {\n      const card = figma.createFrame();\n      card.name = \"Strategy_Card_\" + strat.name.replace(/ /g, \"_\");\n      card.x = 16;\n      card.y = stratY;\n      card.resize(343, 80);\n      card.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\n      card.cornerRadius = 16;\n      card.effects = card1.effects;\n      frame.appendChild(card);\n\n      const nameTxt = figma.createText();\n      nameTxt.characters = strat.name;\n      nameTxt.fontName = { family: \"Nunito\", style: \"Bold\" };\n      nameTxt.fontSize = 16;\n      nameTxt.x = 16;\n      nameTxt.y = 16;\n      nameTxt.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n      card.appendChild(nameTxt);\n\n      const retLabel = figma.createText();\n      retLabel.characters = \"Yearly return\";\n      retLabel.fontName = { family: \"Nunito\", style: \"Medium\" };\n      retLabel.fontSize = 12;\n      retLabel.x = 16;\n      retLabel.y = 44;\n      retLabel.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.56 } }];\n      card.appendChild(retLabel);\n\n      const retVal = figma.createText();\n      retVal.characters = strat.return;\n      retVal.fontName = { family: \"Nunito\", style: \"Bold\" };\n      retVal.fontSize = 14;\n      retVal.x = 100;\n      retVal.y = 42;\n      retVal.fills = [{ type: 'SOLID', color: { r: 0.18, g: 0.72, b: 0.45 } }];\n      card.appendChild(retVal);\n\n      // Render 3 asset logos\n      let logoX = 343 - 16 - 24; // starting from right\n      // More badge \"+N more\"\n      const moreTxt = figma.createText();\n      moreTxt.characters = strat.more;\n      moreTxt.fontName = { family: \"Nunito\", style: \"Bold\" };\n      moreTxt.fontSize = 11;\n      moreTxt.x = logoX;\n      moreTxt.y = 44;\n      moreTxt.fills = [{ type: 'SOLID', color: { r: 0.5, g: 0.5, b: 0.56 } }];\n      card.appendChild(moreTxt);\n\n      logoX -= 12; // gap\n      for (let i = strat.logos.length - 1; i >= 0; i--) {\n        const logoName = strat.logos[i];\n        const logoComp = figma.root.findOne(n => n.name === logoName && n.type === 'COMPONENT');\n        if (logoComp) {\n          const logoInst = logoComp.createInstance();\n          logoInst.x = logoX - 24;\n          logoInst.y = 16;\n          logoInst.resize(24, 24);\n          card.appendChild(logoInst);\n          logoX -= 28;\n        }\n      }\n\n      stratY += 92;\n    });\n\n    // \"Coin Lists\" Section with Tabs\n    const coinsHeader = figma.createText();\n    coinsHeader.characters = \"Coin Lists\";\n    coinsHeader.fontName = { family: \"Nunito\", style: \"Bold\" };\n    coinsHeader.fontSize = 18;\n    coinsHeader.x = 16;\n    coinsHeader.y = 772;\n    coinsHeader.fills = [{ type: 'SOLID', color: brandPrimaryColor }];\n    frame.appendChild(coinsHeader);\n\n    // Tabs: Trending (current), Watchlist, Favorites, Stablecoins, BNB Chain Ecosystem\n    // To make it look great, we will show a horizontal tab bar\n    const tabScroll = figma.createFrame();\n    tabScroll.name = \"Coin_Tabs_Scroll\";\n    tabScroll.x = 0;\n    tabScroll.y = 804;\n    tabScroll.resize(375, 40);\n    tabScroll.fills = [];\n    tabScroll.clipsContent = false;\n    frame.appendChild(tabScroll);\n\n    const createTab = (x, text, isActive) => {\n      const tab = figma.createFrame();\n      tab.name = \"Tab_\" + text.replace(/ /g, \"_