 statusBar03.y = 0;\n    frame03.appendChild(statusBar03);\n  }\n\n  // Scroll Container / Content\n  const scrollContent = figma.createFrame();\n  scrollContent.name = \"Content\";\n  scrollContent.resize(358, 755);\n  scrollContent.x = 16;\n  scrollContent.y = 52;\n  scrollContent.fills = [];\n  scrollContent.layoutMode = \"VERTICAL\";\n  scrollContent.itemSpacing = 16;\n\n  // 1. Header (Avatar, Search bar, History icon)\n  const header = figma.createFrame();\n  header.name = \"Header\";\n  header.resize(358, 44);\n  header.fills = [];\n  header.layoutMode = \"HORIZONTAL\";\n  header.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  header.counterAxisAlignItems = \"CENTER\";\n\n  // Avatar Button (Avatar_Hallie_Goebel)\n  const avatarWrapper = figma.createFrame();\n  avatarWrapper.name = \"Btn_Avatar\";\n  avatarWrapper.resize(40, 40);\n  avatarWrapper.cornerRadius = 20;\n  avatarWrapper.clipsContent = true;\n  avatarWrapper.fills = [];\n\n  const avatarImg = getMediaNode(\"Avatar_Hallie_Goebel\");\n  if (avatarImg) {\n    avatarImg.resize(40, 40);\n    avatarImg.x = 0;\n    avatarImg.y = 0;\n    avatarWrapper.appendChild(avatarImg);\n  }\n\n  // Search Bar\n  const searchBar = figma.createFrame();\n  searchBar.name = \"Search_Bar\";\n  searchBar.resize(250, 40);\n  searchBar.cornerRadius = 20;\n  searchBar.fills = [{ type: 'SOLID', color: WHITE }];\n  searchBar.layoutMode = \"HORIZONTAL\";\n  searchBar.counterAxisAlignItems = \"CENTER\";\n  searchBar.paddingLeft = 12;\n  searchBar.paddingRight = 12;\n  searchBar.itemSpacing = 8;\n\n  const iconSearch = getMediaNode(\"Icon_Search\");\n  if (iconSearch) searchBar.appendChild(iconSearch);\n\n  const searchPlaceholder = figma.createText();\n  searchPlaceholder.fontName = { family: \"Inter\", style: \"Regular\" };\n  searchPlaceholder.fontSize = 13;\n  searchPlaceholder.characters = \"Pay by name or phone\";\n  searchPlaceholder.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  searchBar.appendChild(searchPlaceholder);\n\n  // History Icon Button\n  const btnHistory = figma.createFrame();\n  btnHistory.name = \"Btn_History\";\n  btnHistory.resize(40, 40);\n  btnHistory.cornerRadius = 20;\n  btnHistory.fills = [{ type: 'SOLID', color: WHITE }];\n  btnHistory.layoutMode = \"HORIZONTAL\";\n  btnHistory.primaryAxisAlignItems = \"CENTER\";\n  btnHistory.counterAxisAlignItems = \"CENTER\";\n\n  const iconHistory = getMediaNode(\"Icon_History\");\n  if (iconHistory) btnHistory.appendChild(iconHistory);\n\n  header.appendChild(avatarWrapper);\n  header.appendChild(searchBar);\n  header.appendChild(btnHistory);\n  scrollContent.appendChild(header);\n\n  // 2. Primary Balance Card (HSBC)\n  const balanceCard = figma.createFrame();\n  balanceCard.name = \"Balance_Card\";\n  balanceCard.resize(358, 140);\n  balanceCard.cornerRadius = 20;\n  balanceCard.fills = [{ type: 'SOLID', color: BRAND }];\n  balanceCard.paddingTop = 16;\n  balanceCard.paddingBottom = 16;\n  balanceCard.paddingLeft = 20;\n  balanceCard.paddingRight = 20;\n  balanceCard.layoutMode = \"VERTICAL\";\n  balanceCard.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n\n  // Top Row: Bank HSBC Logo & Primary Badge\n  const cardTopRow = figma.createFrame();\n  cardTopRow.name = \"Card_Top_Row\";\n  cardTopRow.resize(318, 28);\n  cardTopRow.fills = [];\n  cardTopRow.layoutMode = \"HORIZONTAL\";\n  cardTopRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  cardTopRow.counterAxisAlignItems = \"CENTER\";\n\n  const hsbcLogo = getMediaNode(\"Bank_HSBC\");\n  if (hsbcLogo) cardTopRow.appendChild(hsbcLogo);\n\n  // Badge Primary\n  const primaryBadge = figma.createFrame();\n  primaryBadge.name = \"Badge_Primary\";\n  primaryBadge.resize(86, 26);\n  primaryBadge.cornerRadius = 13;\n  primaryBadge.fills = [{ type: 'SOLID', color: WHITE, opacity: 0.2 }];\n  primaryBadge.layoutMode = \"HORIZONTAL\";\n  primaryBadge.primaryAxisAlignItems = \"CENTER\";\n  primaryBadge.counterAxisAlignItems = \"CENTER\";\n  primaryBadge.itemSpacing = 4;\n\n  const iconCheck = getMediaNode(\"Icon_Check_Badge\");\n  if (iconCheck) {\n    iconCheck.resize(16, 16);\n    primaryBadge.appendChild(iconCheck);\n  }\n\n  const textPrimary = figma.createText();\n  textPrimary.fontName = { family: \"Inter\", style: \"Medium\" };\n  textPrimary.fontSize = 12;\n  textPrimary.characters = \"Primary\";\n  textPrimary.fills = [{ type: 'SOLID', color: WHITE }];\n  primaryBadge.appendChild(textPrimary);\n\n  cardTopRow.appendChild(primaryBadge);\n\n  // Bottom Row: Balance info & Refresh\n  const cardBottomRow = figma.createFrame();\n  cardBottomRow.name = \"Card_Bottom_Row\";\n  cardBottomRow.resize(318, 64);\n  cardBottomRow.fills = [];\n  cardBottomRow.layoutMode = \"HORIZONTAL\";\n  cardBottomRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  cardBottomRow.counterAxisAlignItems = \"MAX\";\n\n  const balanceTextGroup = figma.createFrame();\n  balanceTextGroup.name = \"Balance_Text_Group\";\n  balanceTextGroup.fills = [];\n  balanceTextGroup.layoutMode = \"VERTICAL\";\n  balanceTextGroup.itemSpacing = 4;\n\n  const labelLastUpdate = figma.createText();\n  labelLastUpdate.fontName = { family: \"Inter\", style: \"Regular\" };\n  labelLastUpdate.fontSize = 12;\n  labelLastUpdate.characters = \"Last Updated Balance\";\n  labelLastUpdate.fills = [{ type: 'SOLID', color: WHITE, opacity: 0.8 }];\n\n  const amountText = figma.createText();\n  amountText.fontName = { family: \"Inter\", style: \"Bold\" };\n  amountText.fontSize = 30;\n  amountText.characters = \"₹85,625\";\n  amountText.fills = [{ type: 'SOLID', color: WHITE }];\n\n  balanceTextGroup.appendChild(labelLastUpdate);\n  balanceTextGroup.appendChild(amountText);\n\n  // Refresh balance button\n  const btnRefresh = figma.createFrame();\n  btnRefresh.name = \"Btn_Refresh\";\n  btnRefresh.resize(36, 36);\n  btnRefresh.cornerRadius = 18;\n  btnRefresh.fills = [{ type: 'SOLID', color: WHITE, opacity: 0.2 }];\n  btnRefresh.layoutMode = \"HORIZONTAL\";\n  btnRefresh.primaryAxisAlignItems = \"CENTER\";\n  btnRefresh.counterAxisAlignItems = \"CENTER\";\n\n  const iconRefresh = getMediaNode(\"Icon_Refresh\");\n  if (iconRefresh) btnRefresh.appendChild(iconRefresh);\n\n  cardBottomRow.appendChild(balanceTextGroup);\n  cardBottomRow.appendChild(btnRefresh);\n\n  balanceCard.appendChild(cardTopRow);\n  balanceCard.appendChild(cardBottomRow);\n  scrollContent.appendChild(balanceCard);\n\n  // 3. Quick Actions: Send, Receive, Scan any QR\n  const actionsRow = figma.createFrame();\n  actionsRow.name = \"Quick_Actions\";\n  actionsRow.resize(358, 64);\n  actionsRow.fills = [];\n  actionsRow.layoutMode = \"HORIZONTAL\";\n  actionsRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n\n  // Helper for quick action button\n  function createActionButton(name, labelText, iconName, bgClr) {\n    const btn = figma.createFrame();\n    btn.name = name;\n    btn.resize(112, 64);\n    btn.cornerRadius = 16;\n    btn.fills = [{ type: 'SOLID', color: bgClr }];\n    btn.layoutMode = \"HORIZONTAL\";\n    btn.primaryAxisAlignItems = \"CENTER\";\n    btn.counterAxisAlignItems = \"CENTER\";\n    btn.itemSpacing = 8;\n\n    const icon = getMediaNode(iconName);\n    if (icon) btn.appendChild(icon);\n\n    const txt = figma.createText();\n    txt.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n    txt.fontSize = 13;\n    txt.characters = labelText;\n    txt.fills = [{ type: 'SOLID', color: TEXT_MAIN }];\n    btn.appendChild(txt);\n\n    return btn;\n  }\n\n  const btnSend = createActionButton(\"Btn_Send\", \"Send\", \"Icon_Send\", WHITE);\n  const btnReceive = createActionButton(\"Btn_Receive\", \"Receive\", \"Icon_Receive\", WHITE);\n  const btnScan = createActionButton(\"Btn_Scan\", \"Scan any QR\", \"Icon_Scan\", WHITE);\n\n  actionsRow.appendChild(btnSend);\n  actionsRow.appendChild(btnReceive);\n  actionsRow.appendChild(btnScan);\n  scrollContent.appendChild(actionsRow);\n\n  // 4. Offer Banner: \"Invite friends and get ₹1,000 reward\"\n  const offerBanner = figma.createFrame();\n  offerBanner.name = \"Offer_Banner\";\n  offerBanner.resize(358, 56);\n  offerBanner.cornerRadius = 16;\n  offerBanner.fills = [{ type: 'SOLID', color: BANNER_BG }];\n  offerBanner.layoutMode = \"HORIZONTAL\";\n  offerBanner.counterAxisAlignItems = \"CENTER\";\n  offerBanner.paddingLeft = 16;\n  offerBanner.paddingRight = 16;\n  offerBanner.itemSpacing = 12;\n\n  const iconOffer = getMediaNode(\"Icon_Offer\");\n  if (iconOffer) offerBanner.appendChild(iconOffer);\n\n  const offerText = figma.createText();\n  offerText.fontName = { family: \"Inter\", style: \"Medium\" };\n  offerText.fontSize = 13;\n  offerText.characters = \"Invite friends and get ₹1,000 reward\";\n  offerText.fills = [{ type: 'SOLID', color: BRAND }];\n  offerBanner.appendChild(offerText);\n\n  scrollContent.appendChild(offerBanner);\n\n  // 5. Other Accounts (Axis Bank, HDFC Bank, Deutsche Bank, Union Bank)\n  const accountsSection = figma.createFrame();\n  accountsSection.name = \"Accounts_Section\";\n  accountsSection.resize(358, 140);\n  accountsSection.fills = [];\n  accountsSection.layoutMode = \"VERTICAL\";\n  accountsSection.itemSpacing = 10;\n\n  const accountsHeader = figma.createText();\n  accountsHeader.fontName = { family: \"Inter\", style: \"Bold\" };\n  accountsHeader.fontSize = 13;\n  accountsHeader.characters = \"OTHER ACCOUNTS\";\n  accountsHeader.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n  accountsSection.appendChild(accountsHeader);\n\n  // Grid / Row for 4 bank cards\n  const accountsGrid = figma.createFrame();\n  accountsGrid.name = \"Accounts_Grid\";\n  accountsGrid.resize(358, 110);\n  accountsGrid.fills = [];\n  accountsGrid.layoutMode = \"HORIZONTAL\";\n  accountsGrid.itemSpacing = 10;\n\n  const otherBanksData = [\n    { name: \"Axis Bank\", balance: \"₹3,500\", mark: \"Bank_Axis\" },\n    { name: \"HDFC Bank\", balance: \"₹63,520\", mark: \"Bank_HDFC\" },\n    { name: \"Deutsche Bank\", balance: \"₹36,258\", mark: \"Bank_Deutsche\" },\n    { name: \"Union Bank\", balance: \"₹67,820\", mark: \"Bank_Union\" }\n  ];\n\n  for (const b of otherBanksData) {\n    const tile = figma.createFrame();\n    tile.name = `Tile_${b.name.replace(/\\s+/g, '_')}`;\n    tile.resize(82, 100);\n    tile.cornerRadius = 14;\n    tile.fills = [{ type: 'SOLID', color: WHITE }];\n    tile.layoutMode = \"VERTICAL\";\n    tile.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    tile.paddingTop = 12;\n    tile.paddingBottom = 12;\n    tile.paddingLeft = 8;\n    tile.paddingRight = 8;\n    tile.counterAxisAlignItems = \"MIN\";\n\n    const bankIcon = getMediaNode(b.mark);\n    if (bankIcon) tile.appendChild(bankIcon);\n\n    const bInfo = figma.createFrame();\n    bInfo.fills = [];\n    bInfo.layoutMode = \"VERTICAL\";\n    bInfo.itemSpacing = 2;\n\n    const bName = figma.createText();\n    bName.fontName = { family: \"Inter\", style: \"Medium\" };\n    bName.fontSize = 11;\n    bName.characters = b.name;\n    bName.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n\n    const bBal = figma.createText();\n    bBal.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n    bBal.fontSize = 12;\n    bBal.characters = b.balance;\n    bBal.fills = [{ type: 'SOLID', color: TEXT_MAIN }];\n\n    bInfo.appendChild(bName);\n    bInfo.appendChild(bBal);\n    tile.appendChild(bInfo);\n\n    accountsGrid.appendChild(tile);\n  }\n  accountsSection.appendChild(accountsGrid);\n  scrollContent.appendChild(accountsSection);\n\n  // 6. Recent Transactions (3 rows)\n  const transactionsSection = figma.createFrame();\n  transactionsSection.name = \"Transactions_Section\";\n  transactionsSection.resize(358, 230);\n  transactionsSection.fills = [];\n  transactionsSection.layoutMode = \"VERTICAL\";\n  transactionsSection.itemSpacing = 10;\n\n  // Header row: \"RECENT TRANSACTIONS\" + \"Transaction History\"\n  const txHeaderRow = figma.createFrame();\n  txHeaderRow.name = \"Tx_Header_Row\";\n  txHeaderRow.resize(358, 20);\n  txHeaderRow.fills = [];\n  txHeaderRow.layoutMode = \"HORIZONTAL\";\n  txHeaderRow.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  txHeaderRow.counterAxisAlignItems = \"CENTER\";\n\n  const txHeader = figma.createText();\n  txHeader.fontName = { family: \"Inter\", style: \"Bold\" };\n  txHeader.fontSize = 13;\n  txHeader.characters = \"RECENT TRANSACTIONS\";\n  txHeader.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n\n  const btnTxHistory = figma.createText();\n  btnTxHistory.name = \"Btn_Transaction_History\";\n  btnTxHistory.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n  btnTxHistory.fontSize = 12;\n  btnTxHistory.characters = \"Transaction History\";\n  btnTxHistory.fills = [{ type: 'SOLID', color: BRAND }];\n\n  txHeaderRow.appendChild(txHeader);\n  txHeaderRow.appendChild(btnTxHistory);\n  transactionsSection.appendChild(txHeaderRow);\n\n  // Transaction Rows Container\n  const txList = figma.createFrame();\n  txList.name = \"Tx_List\";\n  txList.resize(358, 190);\n  txList.cornerRadius = 16;\n  txList.fills = [{ type: 'SOLID', color: WHITE }];\n  txList.layoutMode = \"VERTICAL\";\n  txList.paddingLeft = 14;\n  txList.paddingRight = 14;\n\n  const recentTxData = [\n    { title: \"Paytm Auto Pay\", date: \"22 Jan\", sub: \"Weekly transaction\", amount: \"−₹3,500\", mark: \"Merchant_Paytm\", isPositive: false },\n    { title: \"Risa Midyett\", date: \"05 Jan\", sub: \"Gift for Christmas\", amount: \"+₹6,950\", mark: \"Avatar_Risa_Midyett\", isPositive: true },\n    { title: \"Amazon Pantry\", date: \"01 Jan\", sub: \"Subscription payment\", amount: \"−₹1,200\", mark: \"Merchant_Amazon\", isPositive: false }\n  ];\n\n  for (let i = 0; i < recentTxData.length; i++) {\n    const tx = recentTxData[i];\n    const row = figma.createFrame();\n    row.name = `Tx_Row_${i + 1}`;\n    row.resize(330, 60);\n    row.fills = [];\n    row.layoutMode = \"HORIZONTAL\";\n    row.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    row.counterAxisAlignItems = \"CENTER\";\n\n    // Left: Icon + Info\n    const leftInfo = figma.createFrame();\n    leftInfo.name = \"Left_Info\";\n    leftInfo.fills = [];\n    leftInfo.layoutMode = \"HORIZONTAL\";\n    leftInfo.counterAxisAlignItems = \"CENTER\";\n    leftInfo.itemSpacing = 12;\n\n    const iconWrapper = figma.createFrame();\n    iconWrapper.resize(40, 40);\n    iconWrapper.cornerRadius = 20;\n    iconWrapper.clipsContent = true;\n    iconWrapper.fills = [{ type: 'SOLID', color: BG_LIGHT }];\n\n    const markNode = getMediaNode(tx.mark);\n    if (markNode) {\n      markNode.resize(40, 40);\n      iconWrapper.appendChild(markNode);\n    }\n\n    const textGroup = figma.createFrame();\n    textGroup.fills = [];\n    textGroup.layoutMode = \"VERTICAL\";\n    textGroup.itemSpacing = 2;\n\n    const titleText = figma.createText();\n    titleText.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n    titleText.fontSize = 14;\n    titleText.characters = tx.title;\n    titleText.fills = [{ type: 'SOLID', color: TEXT_MAIN }];\n\n    const subText = figma.createText();\n    subText.fontName = { family: \"Inter\", style: \"Regular\" };\n    subText.fontSize = 12;\n    subText.characters = `${tx.date} · ${tx.sub}`;\n    subText.fills = [{ type: 'SOLID', color: TEXT_MUTED }];\n\n    textGroup.appendChild(titleText);\n    textGroup.appendChild(subText);\n\n    leftInfo.appendChild(iconWrapper);\n    leftInfo.appendChild(textGroup);\n\n    // Right: Amount\n    const amtText = figma.createText();\n    amtText.fontName = { family: \"Inter\", style: \"Bold\" };\n    amtText.fontSize = 14;\n    amtText.characters = tx.amount;\n    amtText.fills = [{ type: 'SOLID', color: tx.isPositive ? GREEN_COLOR : TEXT_MAIN }];\n\n    row.appendChild(leftInfo);\n    row.appendChild(amtText);\n    txList.appendChild(row);\n\n    // Divider line between rows\n    if (i < recentTxData.length - 1) {\n      const sep = figma.createFrame();\n      sep.resize(330, 1);\n      sep.fills = [{ type: 'SOLID', color: BORDER_COLOR }];\n      txList.appendChild(sep);\n    }\n  }\n\n  transactionsSection.appendChild(txList);\n  scrollContent.appendChild(transactionsSection);\n\n  frame03.appendChild(scrollContent);\n\n  // Home Indicator\n  const homeInd03 = getComponentNode(\"Home Indicator\");\n  if (homeInd03) {\n    homeInd03.x = 0;\n    homeInd03.y = 810;\n    frame03.appendChild(homeInd03);\n  }\n\n  workspacePage.appendChild(frame03);\n  return \"Frame 03_Home created successfully\";\n})()\n","description":"Create 03_Home frame in Workspace.","fileKey":"oJ0khyrOsFgMq3cINEL7So"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":27217,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"a48cb58e-c22d-4383-99f1-d8ee15e74b04","uuid":"88b2eaad-de96-4441-ace3-5e3155a9e311","timestamp":"2026-10-31T20:19:04.827Z","tool_use_meta":[{"id":"call_60166b53489a46bc9058df4360a7903a","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
