promo banners) ============\nconst dealsCon = await figma.getNodeByIdAsync('13:23');\nconst deals = [\n  ['Best deals Crispy Sandwiches', 'Enjoy the large size of sandwiches. Complete perfect slice of sandwiches.', '9:44', 'left'],\n  ['Celebrate parties with Fried Chicken', 'Get the best fried chicken smeared with a lip smacking lemon chili flavor. Check out best deals for fried chicken.', '9:42', 'right'],\n  ['Wanna eat hot & spicy Pizza?', 'Pair up with a friend and enjoy the hot and crispy pizza pops. Try it with the best deals.', '9:43', 'left'],\n];\ndeals.forEach(([title, copy, photoId, side], i) => {\n  const y = i * (320 + 20);\n  const banner = figma.createFrame();\n  banner.name = 'Deal · ' + title;\n  banner.resize(1728, 320);\n  banner.x = 0; banner.y = y;\n  banner.fills = [{type:'SOLID', color: WHITE}];\n  banner.cornerRadius = 24;\n  banner.effects=[{type:'DROP_SHADOW',color:{r:0.2,g:0.12,b:0.02,a:0.08},offset:{x:0,y:16},radius:36,spread:0,visible:true,blendMode:'NORMAL'}];\n  dealsCon.appendChild(banner);\n  // photo half\n  const photoX = side === 'left' ? 1728/2 : 0;\n  const photo = instCover(photoId, photoX, 0, 1728/2, 320, banner);\n  // text half\n  const tx = side === 'left' ? 64 : 1728/2 + 64;\n  text(banner, title, 36, 'Bold', INK, tx, 72).resize(1728/2 - 128, 96);\n  const cp = text(banner, copy, 17, 'Regular', GRAY, tx, 150);\n  cp.resize(1728/2 - 160, 66);\n  // Proceed to order link\n  const po = text(banner, 'Proceed to order', 18, 'Bold', ORANGE, tx, 240);\n  const ic = inst('9:4', tx + po.width + 8, 240, banner, 22);\n  for (const v of ic.findAll(n=>n.type==='VECTOR')) v.fills=[{type:'SOLID',color:ORANGE}];\n});\n\n// ============ CTA ============\nconst secCTA = await figma.getNodeByIdAsync('13:12');\nconst ctaCon = await figma.getNodeByIdAsync('13:24');\n// background photo inside the content, full width, rounded\nconst ctaBg = instCover('9:28', 0, 0, 1728, 200, ctaCon);\nctaBg.cornerRadius = 24;\nconst ctaTitle = text(ctaCon, 'Are you ready to order with the best deals?', 36, 'Bold', WHITE, 64, 78);\n// button right\nconst btn = figma.createFrame();\nbtn.name = 'CTA · Proceed to order';\nbtn.resize(260, 60);\nbtn.x = 1728 - 64 - 260; btn.y = 70;\nbtn.fills = [{type:'SOLID', color: WHITE}];\nbtn.cornerRadius = 12;\nctaCon.appendChild(btn);\nconst bt = text(btn, 'Proceed to order', 18, 'Bold', ORANGE, 0, 0);\nconst bic = inst('9:4', 0, 18, btn, 24);\nfor (const v of bic.findAll(n=>n.type==='VECTOR')) v.fills=[{type:'SOLID',color:ORANGE}];\nconst total = bt.width + 8 + 24;\nbt.x = (260 - total)/2; bt.y = (60 - bt.height)/2;\nbic.x = bt.x + bt.width + 8;\nreturn 'deals+cta ok';\n","description":"Build Deals (3 alternating promo banners) and CTA banner with background photo","fileKey":"vxs2YHWWLo4u0YPXrkb2yt"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"2939614a-de6b-46ec-9e1f-7271638640fe","uuid":"fd9202c8-31d3-4ce0-87e1-143ffa249b00","timestamp":"2026-11-02T01:26:27.645Z","tool_use_meta":[{"id":"mcp__figma__use_figma_27_ba3e209e","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
