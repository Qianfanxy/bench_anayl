:'4:17',Settings:'4:22'};\nasync function icon(k,col){const i=(await figma.getNodeByIdAsync(M[k])).createInstance();i.findAll(n=>n.type==='VECTOR').forEach(v=>v.strokes=[solid(col)]);return i;}\nfunction comp(name,dir,o={}){const c=figma.createComponent();c.name=name;c.layoutMode=dir;c.primaryAxisSizingMode='AUTO';c.counterAxisSizingMode='AUTO';c.itemSpacing=o.gap??0;c.paddingLeft=c.paddingRight=o.px??0;c.paddingTop=c.paddingBottom=o.py??0;c.fills=o.fill?[solid(o.fill,o.fo??1)]:[];if(o.r)c.cornerRadius=o.r;c.counterAxisAlignItems=o.align??'CENTER';return c;}\nconst ids={};\nlet sec=section('Menu Item · Type × State (on brand surface)');\nlet cs=[];\nfor(const type of ['Item','Logout'])for(const state of ['Default','Pressed']){const c=comp(`Type=${type}, State=${state}`,'HORIZONTAL',{gap:14,px:14,py:12,r:14});c.primaryAxisSizingMode='FIXED';c.resize(240,48);\n if(state==='Pressed')c.fills=[solid('FFFFFF',0.14)];if(type==='Logout'){c.strokes=[solid('FFFFFF',0.32)];c.strokeAlign='INSIDE';}\n const ic=await icon(type==='Logout'?'Logout':'NewPay','FFFFFF');c.appendChild(ic);\n const l=txt(type==='Logout'?'Logout':'New Payment',16,'Semi Bold','FFFFFF',22);l.name='Label';c.appendChild(l);\n const p1=c.addComponentProperty('Label','TEXT',l.characters);l.componentPropertyReferences={characters:p1};\n const p2=c.addComponentProperty('Icon','INSTANCE_SWAP',ic.mainComponent.id);ic.componentPropertyReferences={mainComponent:p2};\n cs.push(c);}\nconst mset=setify(cs,sec,'Menu Item','HORIZONTAL',T.brand);ids.menuItem=mset.id;\nsec=section('Side Menu');\nconst sm=comp('Side Menu','VERTICAL',{gap:0,px:20,fill:T.brand,align:'MIN'});sm.primaryAxisSizingMode='FIXED';sm.counterAxisSizingMode='FIXED';sm.resize(280,844);sm.paddingTop=88;sm.paddingBottom=56;\nconst prof=af('Account','VERTICAL',{gap:14,px:4});sm.appendChild(prof);\nconst av=(await figma.getNodeByIdAsync('11:46')).createInstance();av.rescale(64/44);av.name='Avatar';\nconst avw=af('Avatar ring','HORIZONTAL',{px:3,py:3,fill:'FFFFFF',fo:0.24,r:40});avw.appendChild(av);prof.appendChild(avw);\nconst nm=af('Name block','VERTICAL',{gap:2});prof.appendChild(nm);nm.appendChild(txt('Hallie Goebel',20,'Bold','FFFFFF',26));const em=txt('hallie.goebel@example.com',14,'Regular','FFFFFF',20);em.opacity=0.76;nm.appendChild(em);\nconst sp1=figma.createFrame();sp1.name='Spacer';sp1.resize(10,32);sp1.fills=[];sm.appendChild(sp1);\nconst dv=figma.createRectangle();dv.name='Divider';dv.resize(240,1);dv.fills=[solid('FFFFFF',0.18)];sm.appendChild(dv);\nconst sp2=sp1.clone();sp2.resize(10,16);sm.appendChild(sp2);\nconst list=af('Menu','VERTICAL',{gap:4});sm.appendChild(list);\nconst itemDef=mset.children.find(c=>c.name==='Type=Item, State=Default');\nfor(const [l,k] of [['New Payment','NewPay'],['Bank Accounts','Bank'],['All Transactions','History'],['Rewards & Offers','Offer'],['Settings','Settings']]){const i=itemDef.createInstance();i.name='Menu Item / '+l;list.appendChild(i);const props=i.componentProperties;const lk=Object.keys(props).find(x=>x.startsWith('Label'));const ik=Object.keys(props).find(x=>x.startsWith('Icon'));i.setProperties({[lk]:l,[ik]:M[k]});i.children[0].findAll(n=>n.type==='VECTOR').forEach(v=>v.strokes=[solid('FFFFFF')]);}\nconst grow=figma.createFrame();grow.name='Spacer (grow)';grow.fills=[];grow.resize(10,10);sm.appendChild(grow);grow.layoutGrow=1;\nconst lo=mset.children.find(c=>c.name==='Type=Logout, State=Default').createInstance();lo.name='Logout';sm.appendChild(lo);\nconst sp3=sp1.clone();sp3.resize(10,16);sm.appendChild(sp3);\nconst ver=txt('Payment Wallet · v1.0',12,'Regular','FFFFFF',16);ver.opacity=0.5;sm.appendChild(ver);\nsec.appendChild(sm);ids.sideMenu=sm.id;\nreturn JSON.stringify(ids);","description":"Create menu item set and side menu component (retry)","fileKey":"MBJGR6pcP8R2URhIN3ARYg"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":26,"cache_creation_input_tokens":58573,"cache_read_input_tokens":0,"cache_cre