nheader.resize(1440, 96);\nheader.layoutMode = 'HORIZONTAL';\nheader.primaryAxisSizingMode = 'FIXED';\nheader.counterAxisSizingMode = 'FIXED';\nheader.paddingLeft = 100; header.paddingRight = 100;\nheader.counterAxisAlignItems = 'CENTER';\nheader.primaryAxisAlignItems = 'CENTER';\nheader.itemSpacing = 40;\nheader.fills = H.solid('#FFFFFF');\nheader.strokes = H.rgba('#000000', 0.1);\nheader.strokeWeight = 1;\nheader.strokeAlign = 'INSIDE';\n\nconst logo = H.text('SHOP.CO', 32, 'Regular', '#000000', 'Archivo Black');\nlogo.name = 'Wordmark';\nheader.appendChild(logo);\n\nconst nav = figma.createFrame();\nnav.name = 'Nav';\nnav.fills = [];\nnav.layoutMode = 'HORIZONTAL';\nnav.itemSpacing = 24;\nnav.counterAxisSizingMode = 'AUTO';\nnav.primaryAxisSizingMode = 'AUTO';\nnav.counterAxisAlignItems = 'CENTER';\n// Shop item with chevron\nconst shopItem = figma.createFrame();\nshopItem.name = 'Nav / Shop';\nshopItem.fills = [];\nshopItem.layoutMode = 'HORIZONTAL';\nshopItem.itemSpacing = 4;\nshopItem.counterAxisSizingMode = 'AUTO';\nshopItem.primaryAxisSizingMode = 'AUTO';\nshopItem.counterAxisAlignItems = 'CENTER';\nconst shopTxt = H.text('Shop', 16, 'Regular', '#000000');\nshopTxt.name = 'Label';\nshopItem.appendChild(shopTxt);\nconst shopChev = chevronDown.createInstance();\nshopChev.resize(16, 16);\nshopItem.appendChild(shopChev);\nnav.appendChild(shopItem);\nnav.appendChild(H.text('On Sale', 16, 'Regular', '#000000'));\nnav.appendChild(H.text('New Arrivals', 16, 'Regular', '#000000'));\nnav.appendChild(H.text('Brands', 16, 'Regular', '#000000'));\nheader.appendChild(nav);\n\n// Search field\nconst search = figma.createFrame();\nsearch.name = 'Search';\nsearch.layoutMode = 'HORIZONTAL';\nsearch.paddingLeft = 16; search.paddingRight = 16;\nsearch.counterAxisAlignItems = 'CENTER';\nsearch.itemSpacing = 12;\nsearch.cornerRadius = 62;\nsearch.fills = H.solid('#F0F0F0');\nsearch.primaryAxisSizingMode = 'FIXED';\nsearch.counterAxisSizingMode = 'FIXED';\nsearch.layoutAlign = 'STRETCH';\nsearch.layoutGrow = 1;\nsearch.resize(400, 48);\nconst sIcon = searchIcon.createInstance();\nsIcon.resize(24, 24);\nsIcon.opacity = 0.4;\nsearch.appendChild(sIcon);\nconst sTxt = H.text('Search for products...', 16, 'Regular', '#000000', 'Plus Jakarta Sans', 0.4);\nsearch.appendChild(sTxt);\nheader.appendChild(search);\n\nconst cartI = cartIcon.createInstance();\ncartI.resize(24, 24);\ncartI.name = 'Cart';\nheader.appendChild(cartI);\nconst accI = accountIcon.createInstance();\naccI.resize(24, 24);\naccI.name = 'Account';\nheader.appendChild(accI);\n\nheader.x = 40; header.y = 180;\nstage.appendChild(header);\n\nreturn { ab: ab.id, header: header.id };\n","description":"Create Announcement Bar and Header components","fileKey":"5S6WFXEo4QEfJTtE7MFltz"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"c5b3498c-81e1-408a-9e23-797293d6b873","uuid":"f644e073-231e-43dd-b897-3c0e84eb3764","timestamp":"2026-11-03T07:14:14.307Z","tool_use_meta":[{"id":"mcp__figma__use_figma_18_d6d477f9","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
