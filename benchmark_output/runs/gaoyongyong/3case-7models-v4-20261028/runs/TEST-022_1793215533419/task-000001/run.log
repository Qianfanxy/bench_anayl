{"type":"assistant","message":{"content":[{"type":"tool_use","id":"call_c8a47f29ced34e85a4224cd6","name":"mcp__figma__use_figma","input":{"code":"const P=figma.root.children.find(p=>p.id===\"2003:2\");\nawait figma.setCurrentPageAsync(P);\nconst nav=(dest)=>[{trigger:{type:\"ON_TAP\"},action:{type:\"NODE\",destinationId:dest,navigation:\"NAVIGATE\",transition:{type:\"DISSOLVE\",duration:0.3}}}];\nconst delay=(dest,ms)=>[{trigger:{type:\"AFTER_DELAY\",timeout:ms},action:{type:\"NODE\",destinationId:dest,navigation:\"NAVIGATE\",transition:{type:\"DISSOLVE\",duration:0.3}}}];\nasync function N(id){return await figma.getNodeByIdAsync(id);}\nconst links=[];\nasync function link(nodeId,dest,label){const n=await N(nodeId);n.reactions=nav(dest);links.push(label);}\nasync function backOf(frameId,dest,label){const f=await N(frameId);const hb=f.findOne(n=>n.type===\"INSTANCE\"&&n.name===\"HeaderBar\");const back=hb?hb.children[0]:null;if(back){back.reactions=nav(dest);links.push(label);}else{links.push(label+\" :: BACK NOT FOUND\");}}\n// splash auto-advance\n(await N(\"2011:147\")).reactions=delay(\"2011:165\",2000);links.push(\"01 auto -> 02\");\n// home cards\nawait link(\"2011:211\",\"2012:313\",\"card03 -> 03\");\nawait link(\"2011:232\",\"2012:379\",\"card04 -> 04\");\nawait link(\"2011:253\",\"2012:445\",\"card05 -> 05\");\nawait link(\"2011:274\",\"2012:511\",\"card06 -> 06\");\n// home nav tabs\n(await N(\"I2011:295;2010:107\")).reactions=nav(\"2014:693\");links.push(\"Profile -> 10\");\n(await N(\"I2011:295;2010:120\")).reactions=nav(\"2015:743\");links.push(\"Support -> 11\");\n// product backs + 03 order now\nawait backOf(\"2012:313\",\"2011:165\",\"03 back -> 02\");\nawait backOf(\"2012:379\",\"2011:165\",\"04 back -> 02\");\nawait backOf(\"2012:445\",\"2011:165\",\"05 back -> 02\");\nawait backOf(\"2012:511\",\"2011:165\",\"06 back -> 02\");\nconst btn03=await N(\"2012:313\");const ob=btn03.findOne(n=>n.name===\"OrderNowBtn\");ob.reactions=nav(\"2013:493\");links