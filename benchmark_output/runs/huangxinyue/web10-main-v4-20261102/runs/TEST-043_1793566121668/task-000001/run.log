';home.x=2400;home.y=0;page.appendChild(home);home.clipsContent=true;\nlet hy=0;const stack=(n,gap)=>{n.y=hy;hy+=n.height+(gap||0);return n};\nconst gap=120;\n// Header\nconst hdr=await figma.getNodeByIdAsync(root.findOne(n=>n.name==='Header/Home').id);const hi=hdr.createInstance();hi.x=0;stack(hi,0);\n// Brands strip\nconst br=Fr(home,1920,96,null);br.x=0;AL(br,'HORIZONTAL',0,240,0,240,0);br.counterAxisAlignItems='CENTER';br.primaryAxisAlignItems='SPACE_BETWEEN';\nfor(const b of ['Minimog','Retrolie','Brook','Learts','Vagabond'])T(br,b,'Volkhov','Regular',30,C.t3);\nstack(br,0);\n// Hero\nconst hero=Fr(home,1920,880,null);hero.x=0;stack(hero,gap);\n// left/right photos\nconst pl=await Inst(hero,'6:72',360,600);pl.x=240;pl.y=140;\nconst prp=await Inst(hero,'6:73',360,600);prp.x=1300;prp.y=140;\nconst pt2=await Inst(hero,'6:74',360,240);pt2.x=760;pt2.y=60;\nconst pb2=await Inst(hero,'6:51',360,240);pb2.x=760;pb2.y=560;\n// center text\nconst ct=Fr(hero,600,400,null);AL(ct,'VERTICAL',10,0,0,0,0);ct.counterAxisAlignItems='CENTER';ct.x=660;ct.y=240;\nconst u=T(ct,'ULTIMATE','Volkhov','Bold',110,C.ink);u.textAlignHorizontal='CENTER';\nconst sale=T(ct,'S A L E','Volkhov','Regular',84,C.red);sale.textAlignHorizontal='CENTER';sale.strokeWeight=0;\nconst nc=T(ct,'NEW COLLECTION','Poppins','SemiBold',20,C.t1);nc.textAlignHorizontal='CENTER';nc.letterSpacing={value:6,unit:'PERCENT'};\nconst shop=Fr(ct,207,56,C.ink);shop.cornerRadius=10;AL(shop,'HORIZONTAL',0,0,0,0,0);shop.primaryAxisAlignItems='CENTER';shop.counterAxisAlignItems='CENTER';T(shop,'SHOP NOW','Poppins','Medium',16,C.white);\nreturn JSON.stringify({ok:true,nextY:hy,frame:home.id});","description":"Create 01_Home frame with header, brand strip, hero collage","fileKey":"dMvhv5xjPfiWiv8wAM1nCY"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"4989fa14-2e7d-4d0d-bbb8-4573dd6d6ae6","uuid":"cf76f556-b86c-4ee5-9a11-a9d0b4803786","timestamp":"2026-11-01T21:15:45.768Z","tool_use_meta":[{"id":"mcp__figma