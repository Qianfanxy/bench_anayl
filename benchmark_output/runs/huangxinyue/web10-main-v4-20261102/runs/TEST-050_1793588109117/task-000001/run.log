l.paddingBottom = 14;\nemailPill.cornerRadius = 100;\nfillVar(emailPill, vars.surface2, '#1C1C24');\nstrokeVar(emailPill, vars.border, '#2A2A33');\nemailPill.strokeWeight = 1;\nconst mailIc = await inst('7:26');\nmailIc.rescale(20/24);\nemailPill.appendChild(mailIc);\nconst emailTxt = figma.createText();\nemailTxt.fontName = P('Medium'); emailTxt.fontSize = 16; emailTxt.characters = 'abm@example.com';\nfillVar(emailTxt, vars.textPrimary, '#F5F5F7');\nemailPill.appendChild(emailTxt);\nfooter.appendChild(emailPill);\n\nconst fSp3 = figma.createRectangle(); fSp3.resize(1,32); fSp3.opacity = 0; footer.appendChild(fSp3);\n\nconst socialRow = figma.createFrame();\nsocialRow.name = 'Social row';\nsocialRow.layoutMode = 'HORIZONTAL';\nsocialRow.itemSpacing = 16;\nsocialRow.fills = [];\nfor (const id of [socialInstagram.id, socialX.id, socialYT.id]) {\n  const si = await inst(id);\n  socialRow.appendChild(si);\n}\nfooter.appendChild(socialRow);\n\nconst fSp4 = figma.createRectangle(); fSp4.resize(1,56); fSp4.opacity = 0; footer.appendChild(fSp4);\n\nconst bottomRow = figma.createFrame();\nbottomRow.name = 'Bottom bar';\nbottomRow.layoutMode = 'HORIZONTAL';\nbottomRow.primaryAxisSizingMode = 'FIXED';\nbottomRow.counterAxisSizingMode = 'AUTO';\nbottomRow.layoutAlign = 'STRETCH';\nbottomRow.primaryAxisAlignItems = 'SPACE_BETWEEN';\nbottomRow.counterAxisAlignItems = 'CENTER';\nbottomRow.fills = [];\nfooter.appendChild(bottomRow);\nconst bLogo = await inst('7:4');\nbLogo.rescale(36/96);\nbottomRow.appendChild(bLogo);\nconst copy = figma.createText();\ncopy.fontName = P('Regular'); copy.fontSize = 13; copy.characters = 'ABM — Full Stack Software Engineer';\nfillVar(copy, vars.textMuted, '#6F6F7B');\nbottomRow.appendChild(copy);\n\npage.appendChild(footer); footer.x = 2400; footer.y = 1750;\n\nreturn {header: header.id, headerH: header.height, socialIds: [socialInstagram.id, socialX.id, socialYT.id], footer: footer.id, footerH: footer.height};\n","description":"Create Header, 3 Soc