TEMS ============\nconst popCon = await figma.getNodeByIdAsync('13:19');\nconst title = text(popCon, 'Popular items', 40, 'Bold', INK, 0, 0);\n// prev/next circles top-right\nfunction navCircle(parent, x, y, iconId, dir) {\n  const c = figma.createFrame();\n  c.name = 'Carousel · ' + dir;\n  c.resize(56, 56); c.x = x; c.y = y;\n  c.fills = [{type:'SOLID', color: WHITE}];\n  c.cornerRadius = 28;\n  c.strokes = [{type:'SOLID', color: {r:0.9,g:0.9,b:0.9}}];\n  c.strokeWeight = 1.5;\n  parent.appendChild(c);\n  const ic = inst(iconId, 16, 16, c, 24);\n  return c;\n}\nnavCircle(popCon, 1728-128, 0, '9:3', 'previous');\nnavCircle(popCon, 1728-60, 0, '9:4', 'next');\n\nconst pData = [\n  ['Cheese Burger', 'Burger Arena', '$3.88', '9:50'],\n  ['Toffee’s Cake', 'Top Sticks', '$4.00', '9:48'],\n  ['Pancake', 'Cake World', '$1.99', '9:41'],\n  ['Crispy Sandwich', 'Fastfood Dine', '$3.00', '9:29'],\n  ['Thai Soup', 'Foody man', '$2.79', '9:47'],\n];\nconst cw = 328, gap = 22;\npData.forEach(([name, rest, price, photoId], i) => {\n  const x = i * (cw + gap);\n  const card = figma.createFrame();\n  card.name = 'Item · ' + name;\n  card.resize(cw, 400);\n  card.x = x; card.y = 80;\n  card.fills = [];\n  popCon.appendChild(card);\n  const photo = instCover(photoId, 0, 0, cw, 220, card);\n  photo.cornerRadius = 16;\n  text(card, name, 20, 'Bold', INK, 0, 240);\n  const ri = inst('9:9', 0, 272, card, 16);\n  for (const v of ri.findAll(n=>n.type==='VECTOR')) v.fills=[{type:'SOLID',color:ORANGE}];\n  text(card, rest, 15, 'Regular', GRAY, 22, 270);\n  text(card, price, 22, 'Bold', INK, 0, 300);\n  // Order Now button\n  const btn = figma.createFrame();\n  btn.name = 'Order Now';\n  btn.resize(cw, 56);\n  btn.x = 0; btn.y = 344;\n  btn.fills = [{type:'SOLID', color: ORANGE}];\n  btn.cornerRadius = 12;\n  btn.effects=[{type:'DROP_SHADOW',color:{r:0.94509804,g:0.44705883,b:0.15686275,a:0.3},offset:{x:0,y:8},radius:16,spread:0,visible:true,blendMode:'NORMAL'}];\n  card.appendChild(btn);\n  const bt = text(btn, 'Order Now', 17, 'Bold', WHITE, 0, 0);\n  bt.x = (cw - bt.width)/2; bt.y = (56 - bt.height)/2;\n});\n\n// ============ FEATURED RESTAURANTS ============\nconst restCon = await figma.getNodeByIdAsync('13:20');\nconst rTitle = text(restCon, 'Featured Restaurants', 40, 'Bold', INK, 0, 0);\nrTitle.x = (1480 - rTitle.width)/2;\nconst rData = [\n  ['Foodworld', 'FW', '20% off', 46, 'Opens tomorrow', '9:54', false],\n  ['Pizzahub', 'PH', '15% off', 40, 'Opens tomorrow', '9:56', false],\n  ['Donuts Hut', 'DH', '10% off', 20, 'Open Now', '9:52', true],\n  ['Cupcake Corner', 'CC', '15% off', 50, 'Open Now', '9:30', true],\n  ['Ruby Grill', 'RG', '10% off', 26, 'Open Now', '9:57', true],\n  ['Kuakata Fried Chicken', 'KFC', '25% off', 53, 'Open Now', '9:40', true],\n  ['Red Square', 'RS', '10% off', 45, 'Open Now', '9:45', true],\n  ['Taco Bay', 'TB', '10% off', 35, 'Open Now', '9:46', true],\n];\nconst rcw = 355, rgap = 20;\nconst ORANGE_TINT={r:0.98823529,g:0.89411765,b:0.83529412}, YELLOW_TINT={r:1,g:0.95686275,b:0.84313725};\nconst GREEN={r:0.04705882,g:0.59215686,b:0.31764706}, GREEN_TINT={r:0.89803922,g:0.97254902,b:0.9372549};\nconst AMBER={r:0.70980392,g:0.44705882,b:0.04705882}, AMBER_TINT={r:1,g:0.95686275,b:0.87058824};\nrData.forEach(([name, initials, disc, rating, status, photoId, open], i) => {\n  const col = i % 4, row = Math.floor(i / 4);\n  const x = col * (rcw + rgap), y = 96 + row * 300;\n  const card = figma.createFrame();\n  card.name = 'Restaurant · ' + name;\n  card.resize(rcw, 280);\n  card.x = x; card.y = y;\n  card.fills = [{type:'SOLID', color: WHITE}];\n  card.cornerRadius = 16;\n  card.effects=[{type:'DROP_SHADOW',color:{r:0.2,g:0.12,b:0.02,a:0.07},offset:{x:0,y:12},radius:28,spread:0,visible:true,blendMode:'NORMAL'}];\n  restCon.appendChild(card);\n  const photo = instCover(photoId, 0, 0, rcw, 160, card);\n  // badges on photo\n  const b1 = rect(card, 16, 16, 0, 0, ORANGE, 8);\n  const t1 = text(card, disc, 14, 'Bold', WHITE, 0, 0);\n  b1.resize(t1.width + 44, 32);\n  const tagIc = inst('9:19', 16+10, 16+8, card, 16);\n  for (const v of tagIc.findAll(n=>n.type==='VECTOR')) v.fills=[{type:'SOLID',color:WHITE}];\n  t1.x = 16+32; t1.y = 16+8;\n  const b2 = rect(card, 16 + b1.width + 8, 16, 0, 0, YELLOW, 8);\n  const t2 = text(card, 'Fast', 14, 'Bold', INK, 0, 0);\n  b2.resize(t2.width + 44, 32);\n  const clkIc = inst('9:5', 16 + b1.width + 8 + 10, 24, card, 16);\n  t2.x = 16 + b1.width + 8 + 32; t2.y = 24;\n  // row: initials logo + name/rating\n  const logo = rect(card, 16, 176, 48, 48, ORANGE_TINT, 12);\n  const lt = text(card, initials, initials.length > 2 ? 13 : 16, 'Bold', ORANGE, 0, 0);\n  lt.x = 16 + (48 - lt.width)/2; lt.y = 176 + (48 - lt.height)/2;\n  text(card, name, 18, 'Bold', INK, 76, 180);\n  const starIc = inst('9:14', 76, 208, card, 16);\n  for (const v of starIc.findAll(n=>n.type==='VECTOR')) v.fills=[{type:'SOLID',color:YELLOW}];\n  text(card, String(rating), 15, 'Bold', GRAY, 98, 208);\n  // status chip\n  const chipFill = open ? GREEN_TINT : AMBER_TINT;\n  const chipText = open ? GREEN : AMBER;\n  const st = text(card, status, 14, 'Bold', chipText, 0, 0);\n  const chip = rect(card, 16, 240, st.width + 28, 28, chipFill, 14);\n  st.x = 16 + 14; st.y = 240 + 6;\n});\n// View All button centered\nconst va = figma.createFrame();\nva.name = 'View All';\nva.resize(220, 60);\nva.x = (1480 - 220)/2; va.y = 96 + 2*300 + 24;\nva.fills = [{type:'SOLID', color: ORANGE}];\nva.cornerRadius = 30;\nva.effects=[{type:'DROP_SHADOW',color:{r:0.94509804,g:0.44705883,b:0.15686275,a:0.3},offset:{x:0,y:10},radius:20,spread:0,visible:true,blendMode:'NORMAL'}];\nrestCon.appendChild(va);\nconst vaT = text(va, 'View All', 18, 'Bold', WHITE, 0, 0);\nconst vaIc = inst('9:4', 0, 18, va, 24);\nfor (const v of vaIc.findAll(n=>n.type==='VECTOR')) v.fills=[{type:'SOLID',color:WHITE}];\nconst total = vaT.width + 8 + 24;\nvaT.x = (220 - total)/2; vaT.y = (60 - vaT.height)/2;\nvaIc.x = vaT.x + vaT.width + 8;