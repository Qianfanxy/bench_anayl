hild(i); return i; }\nfunction whiteSB(parent){ const sb = lib.sb.createInstance(); sb.x = 0; sb.y = 0; sb.findAll(n => (n.type==='TEXT' || n.type==='RECTANGLE' || n.type==='ELLIPSE') && n.name !== 'Notch').forEach(n => { n.fills = S(C.white); }); parent.appendChild(sb); return sb; }\nfunction tile(parent, x, y, bankKey, name, amt){ const f = figma.createFrame(); f.name = 'Account · ' + name; f.resize(164,64); f.cornerRadius = 14; f.fills = S(C.white); f.strokes = S(C.border); f.strokeWeight = 1; f.x = x; f.y = y; parent.appendChild(f); const b = lib[bankKey].createInstance(); b.resize(22,22); b.x = 12; b.y = 12; f.appendChild(b); const n = T(name, 13, 'Semi Bold', C.ink, 'Bank'); n.x = 42; n.y = 12; f.appendChild(n); const a = T(amt, 12, 'Medium', C.gray, 'Balance'); a.x = 42; a.y = 34; f.appendChild(a); return f; }\nfunction txRow(parent, x, y, imgKey, name, meta, amt, color){ const f = figma.createFrame(); f.name = 'TX · ' + name; f.resize(342,56); f.fills = []; f.x = x; f.y = y; parent.appendChild(f); const im = lib[imgKey].createInstance(); im.resize(40,40); im.cornerRadius = 20; im.x = 0; im.y = 8; f.appendChild(im); const n = T(name, 14, 'Semi Bold', C.ink, 'Name'); n.x = 52; n.y = 8; f.appendChild(n); const m = T(meta, 12, 'Regular', C.gray, 'Meta'); m.x = 52; m.y = 30; f.appendChild(m); const a = T(amt, 14, 'Semi Bold', color, 'Amount'); f.appendChild(a); a.x = 342 - a.width; a.y = 8; return f; }\n\nconst f3 = figma.createFrame(); f3.name = '03_Home'; f3.resize(390,1120); f3.fills = S(C.white); f3.x = 920; f3.y = 0; f3.clipsContent = true; P.appendChild(f3);\nconst header = figma.createFrame(); header.name = 'Header · Balance'; header.resize(390,368); header.fills = S(C.brand); header.x = 0; header.y = 0; header.clipsContent = true; f3.appendChild(header);\nwhiteSB(header);\nconst av = lib.avH.createInstance(); av.name = 'Avatar (open menu)'; av.resize(40,40); av.cornerRadius = 20; av.x = 16; av.y = 63; header.appendChild(av);\nconst searchBar = figma.createFrame(); searchBar.name = 'Search · Pay by name or phone'; searchBar.resize(232,40); searchBar.cornerRadius = 20; searchBar.fills = TINT(C.white, 0.16); searchBar.x = 64; searchBar.y = 63; header.appendChild(searchBar);\niconInst('search', 12, 10, searchBar, C.white);\nconst sph = T('Pay by name or phone', 13, 'Regular', C.white, 'Placeholder'); sph.opacity = 0.75; sph.x = 40; searchBar.appendChild(sph); sph.y = (40 - sph.height)/2;\nconst histBtn = figma.createFrame(); histBtn.name = 'History'; histBtn.resize(40,40); histBtn.cornerRadius = 20; histBtn.fills = TINT(C.white, 0.16); histBtn.x = 334; histBtn.y = 63; header.appendChild(histBtn); iconInst('hist', 10, 10, histBtn, C.white);\nconst hsbc = lib.hsbc.createInstance(); hsbc.resize(60,17); hsbc.x = 24; hsbc.y = 131; header.appendChild(hsbc);\nconst lub = T('Last Updated Balance', 12, 'Medium', C.white, 'Last Updated Balance'); lub.opacity = 0.75; lub.x = 24; lub.y = 164; header.appendChild(lub);\nconst bal = T('₹85,625', 40, 'Bold', C.white, 'Balance'); bal.x = 24; bal.y = 184; header.appendChild(bal);\nconst chip = figma.createFrame(); chip.name = 'Primary'; chip.resize(96,26); chip.cornerRadius = 13; chip.fills = TINT(C.white, 0.2); chip.x = 24; chip.y = 240; header.appendChild(chip);\niconInst('chk', 8, 3, chip, C.white);\nconst ct = T('Primary', 12, 'Semi Bold', C.white, 'Label'); chip.appendChild(ct); ct.x = 32; ct.y = (26 - ct.height)/2;\nfunction pill(x, label, iconKey){ const f = figma.createFrame(); f.name = 'Action · ' + label; f.resize(120,40); f.cornerRadius = 20; f.fills = S(C.white); f.x = x; f.y = 298; header.appendChild(f); const t = T(label, 13, 'Semi Bold', C.brandDark, 'Label'); f.appendChild(t); iconInst(iconKey, 14, 10, f, C.brandDark); t.x = 40; t.y = Math.round((40 - t.height)/2); return f; }\npill(16, 'Send', 'send');\npill(146, 'Receive', 'recv');\nconst refrBtn = figma.createFrame(); refrBtn.name = 'Refresh balance'; refrBtn.resize(40,40); refrBtn.cornerRadius = 20; refrBtn.fills = TINT(C.white, 0.16); refrBtn.x = 334; refrBtn.y = 298; header.appendChild(refrBtn); iconInst('refr', 10, 10, refrBtn, C.white);\nconst sub2 = figma.createFrame(); sub2.name = 'My accounts'; sub2.resize(390,220); sub2.fills = S(C.chipBg); sub2.x = 0; sub2.y = 368; f3.appendChild(sub2);\ntile(sub2, 16, 16, 'ax', 'Axis Bank', '₹3,500');\ntile(sub2, 190, 16, 'hdfc', 'HDFC Bank', '₹63,520');\ntile(sub2, 16, 90, 'de', 'Deutsche Bank', '₹36,258');\ntile(sub2, 190, 90, 'un', 'Union Bank', '₹67,820');\nconst banner = figma.createFrame(); banner.name = 'Reward · Invite friends'; banner.resize(358,56); banner.cornerRadius = 16; banner.fills = S(C.ghostBg); banner.x = 16; banner.y = 612; f3.appendChild(banner);\niconInst('offer', 14, 16, banner, C.brand);\nconst bt = T('Invite friends and get ₹1,000 reward', 13, 'Semi Bold', C.ink, 'Copy'); banner.appendChild(bt); bt.x = 44; bt.y = (56 - bt.height)/2;\nconst st = T('RECENT TRANSACTIONS', 12, 'Semi Bold', C.gray, 'RECENT TRANSACTIONS'); st.x = 16; st.y = 700; f3.appendChild(st);\nconst th = T('Transaction History', 13, 'Semi Bold', C.brand, 'Transaction History'); f3.appendChild(th); th.x = 374 - th.width; th.y = 700;\ntxRow(f3, 24, 736, 'paytm', 'Paytm Auto Pay', '22 Jan · Weekly transaction', '−₹3,500', C.neg);\ntxRow(f3, 24, 800, 'avR', 'Risa Midyett', '05 Jan · Gift for Christmas', '+₹6,950', C.pos);\ntxRow(f3, 24, 864, 'amz', 'Amazon Pantry', '01 Jan · Subscription payment', '−₹1,200', C.neg);\nconst scanBtn = figma.createFrame(); scanBtn.name = 'Scan any QR'; scanBtn.resize(358,56); scanBtn.cornerRadius = 28; scanBtn.fills = S(C.ink); scanBtn.x = 16; scanBtn.y = 944; f3.appendChild(scanBtn);\niconInst('scan', 105, 18, scanBtn, C.white);\nconst sct = T('Scan any QR', 15, 'Semi Bold', C.white, 'Label'); scanBtn.appendChild(sct); sct.x = 135; sct.y = (56 - sct.height)/2;\nconst hi3 = lib.hi.createInstance(); hi3.x = 0; hi3.y = 1086; f3.appendChild(hi3);\nreturn JSON.stringify({ f3: f3.id, avatar: av.id, kids: f3.children.length