={}){const t=figma.createText();t.fontName={family:fam,style:st};t.fontSize=size;t.characters=chars;t.fills=[S(hx,o.o||1)];if(o.lh)t.lineHeight={unit:\"PIXELS\",value:o.lh};if(o.ls)t.letterSpacing={unit:\"PERCENT\",value:o.ls};if(o.w!==undefined){t.textAutoResize=\"NONE\";t.resize(o.w,o.h||size*1.4);}if(o.al)t.textAlignHorizontal=o.al;p.appendChild(t);t.x=x;t.y=y;if(o.n)t.name=o.n;return t;}\nfunction setTxt(inst,nm,chars){const n=inst.findOne(x=>x.name===nm);n.characters=chars;return n;}\nfunction swap(inst,nm,target){const n=inst.findOne(x=>x.name===nm);return n.swapComponent(comp(target));}\n\n// ================= 06_XTrade_Welcome =================\nconst f6=FR(\"06_XTrade_Welcome\",0,1000,\"#0A0E17\");\nawait statusBar(f6,true);\nconst c1=await ic(f6,\"Coin_BTC\",258,84,3,S(\"#FFFFFF\"),\"deco1\"); c1.opacity=0.14;\nconst c2=await ic(f6,\"Coin_ETH\",18,470,2.4,S(\"#FFFFFF\"),\"deco2\"); c2.opacity=0.10;\nconst c3=await ic(f6,\"Coin_SOL\",70,170,1.4,S(\"#FFFFFF\"),\"deco3\"); c3.opacity=0.10;\nT(f6,\"FinX\",\"Poppins\",\"Bold\",30,\"#FFFFFF\",0,128,{w:390,h:38,al:\"CENTER\",n:\"brand\"});\nconst un=figma.createRectangle(); un.resize(28,4); un.cornerRadius=2; un.fills=[S(\"#1573FE\")]; f6.appendChild(un); un.x=181; un.y=176; un.name=\"underline\";\nconst chip=figma.createFrame(); chip.resize(88,28); chip.cornerRadius=14; chip.fills=[S(\"#12233F\")]; f6.appendChild(chip); chip.x=151; chip.y=352; chip.name=\"chip\";\nT(chip,\"XTRADE\",\"Poppins\",\"SemiBold\",10,\"#5AA2FF\",0,8,{w:88,h:13,al:\"CENTER\",ls:10});\nT(f6,\"Zero fee payment on XTrade\",\"Poppins\",\"SemiBold\",30,\"#FFFFFF\",30,396,{w:330,h:80,al:\"CENTER\",lh:38,n:\"headline\"});\nT(f6,\"No 1 design for E-bank, e-wallet, personal financial mobile application.\",\"Roboto\",\"Regular\",14,\"#8A94A8\",55,496,{w:280,h:48,al:\"CENTER\",lh:22,n:\"sub\"});\nconst b6=comp(\"Btn/Primary\").createInstance(); f6.appendChild(b6); b6.x=24; b6.y=756; b6.name=\"cta\";\nawait homeInd(f6,true);\n\n// ================= 