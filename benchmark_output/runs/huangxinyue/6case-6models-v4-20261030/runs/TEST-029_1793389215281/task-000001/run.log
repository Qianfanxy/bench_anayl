(44, 44);\nbackBtn.x = 12; backBtn.y = 50;\nbackBtn.fills = [];\n\nconst backIcon = figma.createText();\nbackIcon.fontName = { family: \"Inter\", style: \"Bold\" };\nbackIcon.fontSize = 20;\nbackIcon.characters = \"←\";\nbackIcon.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.12, b: 0.18 } }];\nbackIcon.x = (44 - backIcon.width) / 2; backIcon.y = (44 - backIcon.height) / 2;\nbackBtn.appendChild(backIcon);\nframe.appendChild(backBtn);\n\nconst pageTitle = figma.createText();\npageTitle.fontName = { family: \"Inter\", style: \"Bold\" };\npageTitle.fontSize = 18;\npageTitle.characters = \"Stock Detail\";\npageTitle.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.12, b: 0.18 } }];\npageTitle.x = (375 - pageTitle.width) / 2; pageTitle.y = 62;\nframe.appendChild(pageTitle);\n\n// 3. Stock info row\nconst logo = netflixLogoOrig.createInstance();\nlogo.resize(40, 40);\nlogo.x = 24; logo.y = 110;\nframe.appendChild(logo);\n\nconst tickerText = figma.createText();\ntickerText.fontName = { family: \"Inter\", style: \"Bold\" };\ntickerText.fontSize = 20;\ntickerText.characters = \"NFLX\";\ntickerText.fills = [{ type: 'SOLID', color: { r: 0.051, g: 0.051, b: 0.071 } }];\ntickerText.x = 76; tickerText.y = 110;\nframe.appendChild(tickerText);\n\nconst companyText = figma.createText();\ncompanyText.fontName = { family: \"Inter\", style: \"Regular\" };\ncompanyText.fontSize = 14;\ncompanyText.characters = \"Netflix, Inc\";\ncompanyText.fills = [{ type: 'SOLID', color: { r: 0.506, g: 0.533, b: 0.596 } }];\ncompanyText.x = 76; companyText.y = 132;\nframe.appendChild(companyText);\n\n// 4. Price & Daily Change\nconst priceText = figma.createText();\npriceText.fontName = { family: \"Inter\", style: \"Bold\" };\npriceText.fontSize = 32;\npriceText.characters = \"$88.91\";\npriceText.fills = [{ type: 'SOLID', color: { r: 0.051, g: 0.051, b: 0.071 } }];\npriceText.x = 24; priceText.y = 166;\nframe.appendChild(priceText);\n\nconst changeText = figma.createText();\nchangeText.fontName = { family: \"Inter\", style: \"Semi Bold\" };\nchangeText.fontSize = 14;\nchangeText.characters = \"+$1.13 (+1.29%) today\";\nchangeText.fills = [{ type: 'SOLID', color: { r: 0.18, g: 0.75, b: 0.52 } }];\nchangeText.x = 24; changeText.y = 208;\nframe.appendChild(changeText);\n\n// 5. Chart 1M Range\nconst chartFrame = figma.createFrame();\nchartFrame.name = \"Price Chart\";\nchartFrame.resize(327, 140);\nchartFrame.x = 24; chartFrame.y = 240;\nchartFrame.fills = [{ type: 'SOLID', color: { r: 0.98, g: 0.985, b: 0.99 } }];\nchartFrame.cornerRadius = 16;\n\n// Horizontal grid lines\nfor (let i = 1; i < 3; i++) {\n  const line = figma.createRectangle();\n  line.resize(327, 1);\n  line.fills = [{ type: 'SOLID', color: { r: 0.93, g: 0.94, b: 0.95 } }];\n  line.y = i * 46;\n  chartFrame.appendChild(line);\n}\n\n// Netflix stock 1M ascending trend\nconst nflxTrend = figma.createVector();\nnflxTrend.vectorPaths = [{\n  windingRule: \"EVENODD\",\n  data: \"M 20 110 L 70 85 L 120 95 L 170 55 L 220 70 L 270 35 L 300 25\"\n}];\nnflxTrend.strokes = [{ type: 'SOLID', color: { r: 0.18, g: 0.75, b: 0.52 } }];\nnflxTrend.strokeWeight = 3;\nchartFrame.appendChild(nflxTrend);\n\n// Highlight point Sep 27 · $88.04 (Assume 270, 35 coordinate is Sep 27)\nconst sep27Dot = figma.createEllipse();\nsep27Dot.resize(8, 8);\nsep27Dot.fills = [{ type: 'SOLID', color: { r: 0.18, g: 0.75, b: 0.52 } }];\nsep27Dot.strokes = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\nsep27Dot.strokeWeight = 2;\nsep27Dot.x = 270 - 4; sep27Dot.y = 35 - 4;\nchartFrame.appendChild(sep27Dot);\n\n// Active Sep 27 Tooltip\nconst tooltip = figma.createFrame();\ntooltip.name = \"Sep 27 Tooltip\";\ntooltip.resize(90, 36);\ntooltip.cornerRadius = 6;\ntooltip.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.12, b: 0.18 } }];\ntooltip.x = 210; tooltip.y = 48;\n\nconst tDate = figma.createText();\ntDate.fontName = { family: \"Inter\", style: \"Medium\" };\ntDate.fontSize = 9;\ntDate.characters = \"Sep 27\";\ntDate.fills = [{ type: 'SOLID', color: { r: 0.64, g: 0.67, b: 0.73 } }];\ntDate.x = (90 - tDate.width) / 2; tDate.y = 4;\ntooltip.appendChild(tDate);\n\nconst tPrice = figma.createText();\ntPrice.fontName = { family: \"Inter\", style: \"Bold\" };\ntPrice.fontSize = 11;\ntPrice.characters = \"$88.04\";\ntPrice.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\ntPrice.x = (90 - tPrice.width) / 2; tPrice.y = 18;\ntooltip.appendChild(tPrice);\n\nchartFrame.appendChild(tooltip);\nframe.appendChild(chartFrame);\n\n// 6. Range selector: 1D / 1W / 1M / 1Y / 5Y / ALL · current: 1M\nconst rangeSelector = figma.createFrame();\nrangeSelector.name = \"Range Selector\";\nrangeSelector.resize(327, 36);\nrangeSelector.x = 24; rangeSelector.y = 394;\nrangeSelector.fills = [];\n\nconst ranges = [\"1D\", \"1W\", \"1M\", \"1Y\", \"5Y\", \"ALL\"];\nconst rw = 327 / 6;\nranges.forEach((rng, idx) => {\n  const rFrame = figma.createFrame();\n  rFrame.name = rng;\n  rFrame.resize(rw - 4, 30);\n  rFrame.x = idx * rw + 2; rFrame.y = 3;\n  rFrame.cornerRadius = 6;\n  \n  if (rng === \"1M\") {\n    rFrame.fills = [{ type: 'SOLID', color: { r: 0.243, g: 0.322, b: 0.757 } }]; // active state\n  } else {\n    rFrame.fills = [];\n  }\n  \n  const rText = figma.createText();\n  rText.fontName = { family: \"Inter\", style: \"Semi Bold\" };\n  rText.fontSize = 12;\n  rText.characters = rng;\n  rText.fills = [{ type: 'SOLID', color: rng === \"1M\" ? { r: 1, g: 1, b: 1 } : { r: 0.506, g: 0.533, b: 0.596 } }];\n  rText.x = (rw - 4 - rText.width) / 2; rText.y = (30 - rText.height) / 2;\n  rFrame.appendChild(rText);\n  rangeSelector.appendChild(rFrame);\n});\nframe.appendChild(rangeSelector);\n\n// 7. View Selector: Summary / Details (Current: Details)\nconst viewSelector = figma.createFrame();\nviewSelector.name = \"View Selector\";\nviewSelector.resize(327, 40);\nviewSelector.x = 24; viewSelector.y = 444;\nviewSelector.cornerRadius = 20;\nviewSelector.fills = [{ type: 'SOLID', color: { r: 0.96, g: 0.97, b: 0.98 } }];\n\n// \"Summary\" tab\nconst sumTab = figma.createText();\nsumTab.fontName = { family: \"Inter\", style: \"Semi Bold\" };\nsumTab.fontSize = 13;\nsumTab.characters = \"Summary\";\nsumTab.fills = [{ type: 'SOLID', color: { r: 0.506, g: 0.533, b: 0.596 } }];\nsumTab.x = (327 / 2 - sumTab.width) / 2; sumTab.y = 12;\nviewSelector.appendChild(sumTab);\n\n// \"Details\" tab (Active)\nconst detBg = figma.createFrame();\ndetBg.name = \"Active Background\";\ndetBg.resize(327 / 2 - 4, 32);\ndetBg.cornerRadius = 16;\ndetBg.fills = [{ type: 'SOLID', color: { r: 1, g: 1, b: 1 } }];\ndetBg.x = 327 / 2 + 2; detBg.y = 4;\n\nconst detTab = figma.createText();\ndetTab.fontName = { family: \"Inter\", style: \"Bold\" };\ndetTab.fontSize = 13;\ndetTab.characters = \"Details\";\ndetTab.fills = [{ type: 'SOLID', color: { r: 0.051, g: 0.051, b: 0.071 } }];\ndetTab.x = (327 / 2 - 4 - detTab.width) / 2; detTab.y = (32 - detTab.height) / 2;\ndetBg.appendChild(detTab);\nviewSelector.appendChild(detBg);\n\nframe.appendChild(viewSelector);\n\n// 8. Financials: Revenue / Earnings / Performance · years 2018–2021\nconst finTitle = figma.createText();\nfinTitle.fontName = { family: \"Inter\", style: \"Bold\" };\nfinTitle.fontSize = 16;\nfinTitle.characters = \"Financials\";\nfinTitle.fills = [{ type: 'SOLID', color: { r: 0.051, g: 0.051, b: 0.071 } }];\nfinTitle.x = 24; finTitle.y = 504;\nframe.appendChild(finTitle);\n\n// Add nice Revenue bar chart for 2018-2021\nconst barChart = figma.createFrame();\nbarChart.name = \"Financial Bar Chart\";\nbarChart.resize(327, 90);\nbarChart.x = 24; barChart.y = 532;\nbarChart.fills = [];\n\nconst barData = [\n  { year: \"2018\", value: 40 },\n  { year: \"2019\", value: 55 },\n  { year: \"2020\", value: 70 },\n  { year: \"2021\", value: 85 }\n];\nconst bw = 327 / 4;\nbarData.forEach((item, idx) => {\n  const bar = figma.createRectangle();\n  bar.resize(24, item.value);\n  bar.cornerRadius = 4;\n  bar.fills = [{ type: 'SOLID', color: { r: 0.243, g: 0.322, b: 0.757 } }];\n  bar.x = idx * bw + (bw - 24) / 2; bar.y = 70 - item.value;\n  barChart.appendChild(bar);\n  \n  const lbl = figma.createText();\n  lbl.fontName = { family: \"Inter\", style: \"Medium\" };\n  lbl.fontSize = 11;\n  lbl.characters = item.year;\n  lbl.fills = [{ type: 'SOLID', color: { r: 0.506, g: 0.533, b: 0.596 } }];\n  lbl.x = idx * bw + (bw - lbl.width) / 2; lbl.y = 75;\n  barChart.appendChild(lbl);\n});\nframe.appendChild(barChart);\n\n// 9. Bottom bar with Buy stocks Button\nconst buyBtn = buttonOrig.createInstance();\nbuyBtn.name = \"Buy stocks\";\nbuyBtn.x = 24; buyBtn.y = 660;\nconst btnText = buyBtn.children.find(c => c.type === 'TEXT');\nif (btnText) btnText.characters = \"Buy stocks\";\nframe.appendChild(buyBtn);\n\nreturn \"09_Stock_Detail built successfully\";","description":"Build 09_Stock_Detail with custom line chart (Sep 27 highlighted point & popover tooltip), range selectors, details segment button, financials bars, and bottom buy button","fileKey":"yxXcYheOJMwoQleZezxzb8"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":94835,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"d7838db2-841a-44dc-a76d-94e0a765d60f","uuid":"68bd25c6-a044-4a4d-83b6-3b5f3d614adf","timestamp":"2026-10-30T19:47:53.451Z","tool_use_meta":[{"id":"call_3564794333ef4a8994f4c6c7ba47f214","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
