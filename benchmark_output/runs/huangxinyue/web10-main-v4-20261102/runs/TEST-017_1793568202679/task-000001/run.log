.name='Photo_CTA_Background';cta.appendChild(cbg);cbg.layoutPositioning='ABSOLUTE';cbg.x=0;cbg.y=0;cbg.constraints={horizontal:'STRETCH',vertical:'STRETCH'};\nconst ov=figma.createRectangle();ov.name='Overlay';ov.resize(1920,520);ov.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{r:0.1,g:0.06,b:0.03,a:.72}},{position:1,color:{r:0.1,g:0.06,b:0.03,a:.55}}]}];cta.appendChild(ov);ov.layoutPositioning='ABSOLUTE';ov.x=0;ov.y=0;ov.constraints={horizontal:'STRETCH',vertical:'STRETCH'};\ncta.appendChild(T('Are you ready to order with the best deals?',64,'Bold',C.white,{name:'Title',w:900,align:'CENTER',lh:1.15}));\nconst cb=btnVar('Primary').createInstance();setP(cb,{Label:'Proceed to order','Trailing icon':true});cb.name='Proceed to order';cta.appendChild(cb);\ncta.resize(1920,Math.max(cta.height,520));\nboard.appendChild(cta);ids.cta=cta.id;\n\n// FOOTER LINK\nrow=section('Footer Link · State · Footer');\nconst fls=[];for(const s of ['Default','Hover']){const c=CP('State='+s,'HORIZONTAL',{});const t=T('San Francisco',18,'Regular',s==='Hover'?C.white:C.ftx,{name:'Label'});if(s==='Hover')t.textDecoration='UNDERLINE';c.appendChild(t);fls.push(c);}\nconst flset=figma.combineAsVariants(fls,row);flset.name='Footer Link';AL('Footer Link','HORIZONTAL',{gap:24,pad:[16,16,16,16],fill:C.dark,r:12},flset);\nconst flk=flset.addComponentProperty('Label','TEXT','San Francisco');flset.children.forEach(c=>c.children[0].componentPropertyReferences={characters:flk});\nconst FL=flset.children[0];\nconst link=t=>{const i=FL.createInstance();setP(i,{Label:t});i.name=t;return i;};\n\n// FOOTER\nconst ft=CP('Footer','VERTICAL',{gap:56,pad:[96,240,48,240],fill:C.dark,ca:'MIN'});ft.counterAxisSizingMode='FIXED';ft.resize(1920,ft.height);\nconst cities=['San Francisco','Los Angeles','New York City','Chicago','Columbus','Miami','Washington DC','Orange County','Phoenix','New Mexico','San Diego','Seattle','Atlanta','Las Vegas','Albuquerque','East Ba