TER\").resize(414,22).opacity=0.85;\n\n// ============ 02_Onboarding ============\nf = figma.createFrame(); f.name=\"02_Onboarding\"; f.resize(414,896); f.x=2450; f.y=0;\nf.fills=[{type:\"SOLID\",color:WHITE}]; f.clipsContent=true; ws.appendChild(f);\n// full-bleed photo\nconst photo = await inst(f,\"4:97\",0,0,414,896);\n// dark bottom gradient overlay\nconst grad = rect(f,\"overlay\",0,300,414,596,{r:0,g:0,b:0},0);\ngrad.fills=[{type:\"GRADIENT_LINEAR\", gradientTransform:[[0,0,0],[0,1,0]], gradientStops:[{color:{r:0,g:0,b:0,a:0},position:0},{color:{r:0,g:0,b:0,a:0.72},position:1}]}];\nawait shell(f);\nawait inst(f,\"4:10\",0,520,44,51).then(()=>{}); // carrot — inst returns promise; positioning below\nconst carrot = f.children[f.children.length-1]; carrot.x=Math.round((414-44)/2);\ntxt(f,\"title\",\"Welcome\\nto our store\",0,585,42,\"Semi Bold\",WHITE,\"CENTER\").resize(374,120).x=20;\ntxt(f,\"subtitle\",\"Get your groceries in as fast as one hour\",0,712,16,\"Regular\",{r:1,g:1,b:1},\"CENTER\").resize(374,24).opacity=0.9;\nconst btn = await figma.getNodeByIdAsync(\"6:29\"); const b1 = btn.createInstance(); b1.x=25; b1.y=772; f.appendChild(b1);\n\n// ============ 03_Sign_In ============\nf = figma.createFrame(); f.name=\"03_Sign_In\"; f.resize(414,896); f.x=2900; f.y=0;\nf.fills=[{type:\"SOLID\",color:WHITE}]; f.clipsContent=true; ws.appendChild(f);\nconst p2 = await inst(f,\"4:94\",0,0,414,276);\nawait shell(f);\ntxt(f,\"title\",\"Get your groceries\\nwith nectar\",24,320,26,\"Semi Bold\",INK).resize(366,80);\n// phone field\ntxt(f,\"phone-label\",\"Phone\",24,432,16,\"Semi Bold\",{r:0.486,g:0.51,b:0.541});\nconst flag = await inst(f,\"4:106\",24,478,36,22);\ntxt(f,\"code\",\"+880\",70,472,18,\"Medium\",INK);\ntxt(f,\"placeholder-number\",\"Phone number\",130,472,18,\"Regular\",{r:0.72,g:0.74,b:0.76});\nrect(f,\"underline\",24,516,366,1,{r:0.886,g:0.886,b:0.886});\ntxt(f,\"social-label\",\"Or connect with social media\",0,610,14,\"Semi Bold\",{r:0.486,g:0.51,b:0.541},\"CENTER\").resize(414,20);\nconst gBtn = await inst(f,(ws.findOne(n=>n.type===\"COMPONENT\"&&n.name===\"SocialButton/Google\")).id,25,660);\nconst fBtn = await inst(f,(ws.findOne(n=>n.type===\"COMPONENT\"&&n.name===\"SocialButton/Facebook\")).id,25,742);\n\n// ============ 04_Verification ============\nf = figma.createFrame(); f.name=\"04_Verification\"; f.resize(414,896); f.x=3350; f.y=0;\nf.fills=[{type:\"SOLID\",color:WHITE}]; f.clipsContent=true; ws.appendChild(f);\nawait shell(f);\nawait inst(f,(ws.findOne(n=>n.type===\"COMPONENT\"&&n.name===\"IconButton/Back\")).id,24,68);\ntxt(f,\"title\",\"Enter your 4-digit code\",24,150,26,\"Semi Bold\",INK);\ntxt(f,\"code-label\",\"Code\",24,240,16,\"Semi Bold\",{r:0.486,g:0.51,b:0.541});\ntxt(f,\"code-placeholder\",\"- - - -\",24,272,22,\"Medium\",{r:0.72,g:0.74,b:0.76});\nrect(f,\"underline\",24,316,366,1,{r:0.886,g:0.886,b:0.886});\ntxt(f,\"resend\",\"Resend Code\",24,806,18,\"Semi Bold\",GREEN);\n// next button (circular)\nconst nextBg = figma.createEllipse(); nextBg.name=\"next\"; nextBg.x=330; nextBg.y=786; nextBg.resize(60,60);\nnextBg.fills=[{type:\"SOLID\",color:GREEN}]; f.appendChild(nextBg);\nconst nv = figma.createVector(); nv.name=\"chevron-right\"; nv.resize(10,18); nv.x=355; nv.y=807;\nnv.vectorPaths=[{windingRule:\"NONE\",data:\"M 2 1 L 9 9 L 2 17\"}];\nnv.strokes=[{type:\"SOLID\",color:WHITE}]; nv.strokeWeight=2.4; nv.strokeCap=\"ROUND\"; nv.strokeJoin=\"ROUND\"; nv.fills=[];\nf.appendChild(nv);\n\nreturn \"screens 1-4 ok\";","description":"Build screens 01_Splash, 02_Onboarding, 03_Sign_In, 04_Verification","fileKey":"rOzSn1MkRakcwc5zqsVINX"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"06ae3923-d12a-4248-9468-ebfe96d71820","uuid":"3454776a-1903-47f1-b1a7-3535ec1af7ea","timestamp":"2026-10-31T05:45:01.921Z","tool_use_meta":[{"id":"mcp__figma__use_figma_14_b112d9de","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
