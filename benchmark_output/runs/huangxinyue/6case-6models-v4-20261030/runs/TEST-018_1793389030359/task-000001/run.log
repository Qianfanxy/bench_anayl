ze:13,color:C.gray,w:360,h:96,y:538,lh:22,alignV:'TOP'});\nrect(D,'Divider 2',24,664,366,1,{fill:'#EFEFEF'});\ntxt(D,'Nutritions','Nutritions',{size:18,style:'SemiBold',w:200,h:26,y:680});\ntxt(D,'Per','100gr',{size:14,color:C.gray,w:60,h:20,align:'RIGHT',x:300,y:683});\nawait icon('Icon_Chevron_Right',D,368,682,0.7,C.ink);\nrect(D,'Divider 3',24,722,366,1,{fill:'#EFEFEF'});\ntxt(D,'Review','Review',{size:18,style:'SemiBold',w:200,h:26,y:738});\nfor(let i=0;i<5;i++)star(D,266+i*20,745,16,C.warn);\nrect(D,'Divider 4',24,778,366,1,{fill:'#EFEFEF'});\nconst addBtn=await inst('10:3',D,25,792);addBtn.findOne(n=>n.type==='TEXT').characters='Add To Basket';\nawait inst('6:54',D,0,862);\n\n// ---------- 07 Explore ----------\nconst E=await figma.getNodeByIdAsync('9:8');[...E.children].forEach(c=>c.remove());E.fills=fl(C.white);\nawait inst('6:43',E,0,0);\nawait inst('10:31',E,0,44);\nawait inst('10:19',E,24,110);\nconst cats=[['Fresh Fruits & Vegetable','2e77bb2f5286f2887d48a509caf0aab1031bc357'],['Cooking Oil & Ghee','33cfbe949d893034d1458535ef0c3fabf6219a34'],['Meat & Fish','13fbd8eda1325852fae2eaa22c9a3178415133cb'],['Bakery & Snacks','aed4dcddafb09f71a114f0eca2672c41a60cf74f'],['Dairy & Eggs','ae4d72dea86d981a1dd2b26e26da70d06b8b0a9a'],['Beverages','25122d35077494e794090f67bb0a6f600b81d6c2']];\nfor(let i=0;i<6;i++){\n  const col=i%2,row=Math.floor(i/2);\n  const ci=await inst('10:214',E,24+col*193,178+row*208);\n  const ir=ci.findOne(n=>n.name==='Image');if(ir)ir.fills=[{type:'IMAGE',imageHash:cats[i][1],scaleMode:'FIT'}];\n  ci.findOne(n=>n.name==='Name').characters=cats[i][0];\n}\nawait inst('10:50',E,0,804);\n\n// ---------- 08 Beverages ----------\nconst B=await figma.getNodeByIdAsync('9:9');[...B.children].forEach(c=>c.remove());B.fills=fl(C.white);\nawait inst('6:43',B,0,0);\nawait inst('10:23',B,0,44);\nconst ficon=fr(B,'Filter',356,62,24,24,{});ficon.fills=[];\nrect(ficon,'L1',2,6,20,2,{fill:C.ink,r:1});\nrect(ficon,'L2',2,16,20,2,{fill:C.ink,r:1});\nconst k1=fi