tSize = 12;\n      durationTxt.fills = [{ type: 'SOLID', color: { r: 0.1, g: 0.1, b: 0.15 } }];\n      bubble.appendChild(durationTxt);\n    } else {\n      const msgTxt = figma.createText();\n      msgTxt.characters = m.text;\n      msgTxt.fontName = { family: \"DM Sans\", style: \"Regular\" };\n      msgTxt.fontSize = 12;\n      msgTxt.fills = [{ type: 'SOLID', color: isYou ? { r: 1, g: 1, b: 1 } : { r: 0.1, g: 0.1, b: 0.15 } }];\n      bubble.appendChild(msgTxt);\n    }\n\n    bubbleCol.appendChild(bubble);\n\n    const timeTxt = figma.createText();\n    timeTxt.characters = m.time;\n    timeTxt.fontName = { family: \"DM Sans\", style: \"Regular\" };\n    timeTxt.fontSize = 10;\n    timeTxt.fills = [{ type: 'SOLID', color: { r: 0.6, g: 0.6, b: 0.65 } }];\n    bubbleCol.appendChild(timeTxt);\n\n    bubbleRow.appendChild(bubbleCol);\n\n    if (isYou) {\n      bubbleRow.appendChild(getAsset(m.avatar, 32));\n    }\n\n    msgsArea.appendChild(bubbleRow);\n  }\n  chatCard.appendChild(msgsArea);\n\n  // Chat Input composer: input \"write here...\" (Icon_Mic, Icon_Send)\n  const composer = figma.createFrame();\n  composer.name = \"ChatComposer\";\n  composer.resize(300, 44);\n  composer.cornerRadius = 10;\n  composer.fills = [{ type: 'SOLID', color: { r: 0.96, g: 0.96, b: 0.98 } }];\n  composer.layoutMode = \"HORIZONTAL\";\n  composer.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  composer.counterAxisAlignItems = \"CENTER\";\n  composer.paddingLeft = 14; composer.paddingRight = 14;\n\n  const inputGroup = figma.createFrame();\n  inputGroup.layoutMode = \"HORIZONTAL\";\n  inputGroup.counterAxisAlignItems = \"CENTER\";\n  inputGroup.itemSpacing = 8;\n  inputGroup.fills = [];\n  inputGroup.appendChild(getAsset(\"Icon_Mic\", 18));\n\n  const placeholder = figma.createText();\n  placeholder.characters = \"write here...\";\n  placeholder.fontName = { family: \"DM Sans\", style: \"Regular\" };\n  placeholder.fontSize = 13;\n  placeholder.fills = [{ type: 'SOLID', color: { r: 0.6