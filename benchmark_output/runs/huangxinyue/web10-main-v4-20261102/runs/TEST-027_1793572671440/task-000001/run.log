 · '+title; lib.appendChild(f);\n  f.resize(600,236); f.fills=[]; f.clipsContent=false;\n  const card=frame(f,'Card',0,0,600,236,'#FFFFFF',16,true);\n  card.strokes=[solid('#F3ECE4')]; card.strokeWeight=1; card.strokeAlign='INSIDE';\n  card.effects=[{type:'DROP_SHADOW',color:rgba('#7A5230',0.08),offset:{x:0,y:8},radius:24,spread:0,visible:true,blendMode:'NORMAL'}];\n  const ph=frame(card,'Photo',0,0,252,236,null,0,true);\n  await inst(ph,photoId,0,0,252,236,'Photo');\n  txt(card,'Title',title,284,34,288,{size:21,weight:'Bold',color:C.ink,lh:29});\n  txt(card,'Body',body,284,112,288,{size:13,color:C.ink2,lh:21});\n  const link=frame(card,'Proceed link',284,182,240,30,null,0,false);\n  txt(link,'Proceed label','Proceed to order',0,2,178,{size:14,weight:'Bold',color:C.primary,lh:22});\n  await ic(link,'9:4',148,5,16,C.primary);\n  f.x=x; f.y=1720;\n  return f;\n}\nawait dealCard('Best deals Crispy Sandwiches','Enjoy the large size of sandwiches. Complete perfect slice of sandwiches.','9:44',40);\nawait dealCard('Celebrate parties with Fried Chicken','Get the best fried chicken smeared with a lip smacking lemon chili flavor. Check out best deals for fried chicken.','9:42',680);\nawait dealCard('Wanna eat hot & spicy Pizza?','Pair up with a friend and enjoy the hot and crispy pizza pops. Try it with the best deals.','9:43',1320);\ntxt(lib,'deal cap','Deal Banner · 3 deals',40,1698,900,{size:12,weight:'Bold',color:C.ink2});\n\n// App promo component\nasync function appPromo(){\n  const f=figma.createComponent(); f.name='App Promo'; lib.appendChild(f);\n  f.resize(560,620); f.fills=[]; f.clipsContent=false;\n  txt(f,'Title','Install the app',0,0,500,{size:42,weight:'Bold',color:C.ink,lh:52});\n  txt(f,'Text','It’s never been easier to order food. Look for the finest discounts and you’ll be lost in a world of delectable food.',0,70,470,{size:17,color:C.ink2,lh:28});\n  await inst(f,'9:49',0,190,172,57,'Badge_App_Store');\n  await inst(f,'9:25',196,190,192,57,'Badge_Google_Play');\n  txt(f,'Divider label','Get it on iOS and Android',0,280,400,{size:13,weight:'SemiBold',color:'#A0937F',lh:18,ls:1});\n  f.x=40; f.y=2040;\n  return f;\n}\nawait appPromo();\ntxt(lib,'app cap','App Promo',40,2018,600,{size:12,weight:'Bold',color:C.ink2});\n\n// CTA banner component\nasync function ctaBanner(){\n  const f=figma.createComponent(); f.name='CTA Banner'; lib.appendChild(f);\n  f.resize(1200,320); f.fills=[]; f.clipsContent=false;\n  const card=frame(f,'Card',0,0,1200,320,'#F17228',24,true);\n  card.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[1,0,0],[0,1,0]],gradientStops:[{position:0,color:rgba('#FF8A3D')},{position:0.55,color:rgba('#F17228')},{position:1,color:rgba('#E05A12')}]}];\n  const ph=frame(card,'Photo',700,0,500,320,null,0,true);\n  await inst(ph,'9:28',0,0,500,320,'Photo_CTA_Background');\n  const veil={type:'RECTANGLE',name:'veil'};\n  txt(card,'Title','Are you ready to order with the best deals?',72,82,600,{size:34,weight:'Bold',color:'#FFFFFF',lh:46});\n  const btn=frame(card,'Proceed to order button',72,196,260,64,'#FFFFFF',14,true);\n  txt(btn,'Proceed label','Proceed to order',28,19,180,{size:17,weight:'Bold',color:C.primary,lh:26});\n  await ic(btn,'9:4',206,22,20,C.primary);\n  f.x=40; f.y=2680;\n  return f;\n}\nawait ctaBanner();\ntxt(lib,'cta cap','CTA Banner',40,2658,600,{size:12,weight:'Bold',color:C.ink2});\nreturn 'ok';\n","description":"Build deal banners, app promo and CTA banner components","fileKey":"NE4meAES0ToaWiR2n9eVVf"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":75601,"input_tokens":1,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":75601}},"context_management":null},"parent_tool_use_id":null,"session_id":"c0f7ff31-013f-490f-95a5-726c8f36f404","uuid":"f61c3880-6544-4f11-8e39-76d3471cd9dc","timestamp":"2026-11-01T22:50:40.103