\nconst head=figma.createFrame();head.name='Section header';head.layoutMode='HORIZONTAL';\nhead.primaryAxisSizingMode='FIXED';head.counterAxisSizingMode='AUTO';head.resize(1280,10);\nhead.primaryAxisAlignItems='SPACE_BETWEEN';head.counterAxisAlignItems='MAX';head.itemSpacing=60;head.fills=[];\ncontact.appendChild(head);head.layoutSizingHorizontal='FILL';\nconst l=figma.createFrame();l.name='Heading';l.layoutMode='VERTICAL';l.primaryAxisSizingMode='AUTO';l.counterAxisSizingMode='AUTO';l.itemSpacing=14;l.fills=[];head.appendChild(l);\nl.appendChild(T('GET IN TOUCH',12,'SemiBold',C.orange,{ls:2}));\nl.appendChild(T('Contact',44,'SemiBold',C.text,{name:'Title'}));\n// columns\nconst cGrid=figma.createFrame();cGrid.name='Contact columns';cGrid.layoutMode='HORIZONTAL';cGrid.primaryAxisSizingMode='FIXED';cGrid.counterAxisSizingMode='AUTO';\ncGrid.resize(1280,10);cGrid.itemSpacing=80;cGrid.counterAxisAlignItems='MIN';cGrid.fills=[];\ncontact.appendChild(cGrid);cGrid.layoutSizingHorizontal='FILL';\nconst cLeft=figma.createFrame();cLeft.name='Contact copy';cLeft.layoutMode='VERTICAL';cLeft.primaryAxisSizingMode='AUTO';cLeft.counterAxisSizingMode='FIXED';\ncLeft.resize(660,10);cLeft.itemSpacing=28;cLeft.fills=[];cGrid.appendChild(cLeft);\ncLeft.appendChild(T('Seasoned Full Stack Software Engineer with over 8 years of hands-on experience in designing and implementing robust, scalable, and innovative web solutions. Adept at leveraging a comprehensive skill set encompassing front-end and back-end technologies.',19,'Regular','#C9C9D2',{lh:34,name:'Contact body'}));\nconst emailRow=figma.createFrame();emailRow.name='Email row';emailRow.layoutMode='HORIZONTAL';emailRow.primaryAxisSizingMode='AUTO';emailRow.counterAxisSizingMode='AUTO';\nemailRow.itemSpacing=14;emailRow.counterAxisAlignItems='CENTER';emailRow.paddingTop=16;emailRow.paddingBottom=16;emailRow.paddingLeft=20;emailRow.paddingRight=24;\nemailRow.cornerRadius=100;emailRow.fills=[solid(C.elevated)];emailRow.strokes=[solid(C.border)];emailRow.strokeWeight=1;\ncLeft.appendChild(emailRow);\nconst mail=await clone('3:3');mail.resize(22,22);const mv=mail.findOne(n=>n.type==='VECTOR');if(mv)mv.fills=[solid(C.orange)];emailRow.appendChild(mail);\nemailRow.appendChild(T('abm@example.com',18,'Medium',C.text,{name:'Email address'}));\nconst ctaRow=figma.createFrame();ctaRow.name='Social row';ctaRow.layoutMode='HORIZONTAL';ctaRow.primaryAxisSizingMode='AUTO';ctaRow.counterAxisSizingMode='AUTO';\nctaRow.itemSpacing=12;ctaRow.counterAxisAlignItems='CENTER';ctaRow.fills=[];cLeft.appendChild(ctaRow);\nfor(const id of ['7:60','7:66','7:72']){ctaRow.appendChild(await clone(id));}\nconst cRight=figma.createFrame();cRight.name='Contact card';cRight.layoutMode='VERTICAL';cRight.primaryAxisSizingMode='AUTO';cRight.counterAxisSizingMode='FIXED';\ncRight.resize(520,10);cRight.itemSpacing=24;cRight.paddingTop=36;cRight.paddingRight=36;cRight.paddingBottom=36;cRight.paddingLeft=36;\ncRight.cornerRadius=24;cRight.fills=[{type:'GRADIENT_LINEAR',gradientTransform:[[1,0.4,0],[0,1,0]],gradientStops:[{position:0,color:Object.assign(rgb('#1B1210'),{a:1})},{position:1,color:Object.assign(rgb('#101826'),{a:1})}]}];\ncRight.strokes=[solid('#2E2E3A')];cRight.strokeWeight=1;cGrid.appendChild(cRight);\ncRight.appendChild(T('OPEN TO PROJECTS',11,'SemiBold',C.orange,{ls:2}));\ncRight.appendChild(T('Let’s build something\\nreliable together.',26,'SemiBold',C.text,{lh:34}));\ncRight.appendChild(await clone('7:41'));\ncRight.appendChild(T('Typically replies within a day.',13,'Regular',C.muted,{name:'Reply note'}));\n// footer\nconst footer=figma.createFrame();footer.name='Footer';footer.layoutMode='HORIZONTAL';footer.primaryAxisSizingMode='FIXED';footer.counterAxisSizingMode='FIXED';\nfooter.resize(1280,96);footer.primaryAxisAlignItems='SPACE_BETWEEN';footer.counterAxisAlignItems='CENTER';footer.fills=[];\ncontact.appendChild(footer);footer.layoutSizingHorizontal='FILL';\nconst fLogo=await clone('3:4');footer.appendChild(fLogo