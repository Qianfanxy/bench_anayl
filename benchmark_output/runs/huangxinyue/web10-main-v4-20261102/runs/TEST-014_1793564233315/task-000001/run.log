ddingBottom=paSet.paddingLeft=paSet.paddingRight=24; paSet.primaryAxisSizingMode='AUTO'; paSet.counterAxisSizingMode='AUTO'; paSet.fills=[]; paSet.strokes=S('#9747FF'); paSet.dashPattern=[6,4]; paSet.cornerRadius=13;\n\nconst F=figma.createFrame(); F.name='02_Category'; F.resize(1440,100); F.layoutMode='VERTICAL'; F.primaryAxisSizingMode='AUTO'; F.counterAxisSizingMode='FIXED'; F.fills=S('#FFFFFF'); F.clipsContent=true; P.appendChild(F); F.x=1540; F.y=0;\nF.appendChild((await G('11:80')).createInstance()); F.children[0].name='Announcement Bar';\nconst hdr=(await variant('11:173','Current=Shop')).createInstance(); hdr.name='Header'; F.appendChild(hdr);\n// breadcrumb\nconst bc=AL('Breadcrumb','HORIZONTAL',12,[24,100,24,100]); F.appendChild(bc);\nconst cl=await variant('10:107','Type=Link'), cc=await variant('10:107','Type=Current');\nconst b1=cl.createInstance(); b1.name='Crumb · Home'; setP(b1,{Label:'Home'}); bc.appendChild(b1); const b2=cc.createInstance(); b2.name='Crumb · Casual'; setP(b2,{Label:'Casual'}); bc.appendChild(b2);\n// main\nconst main=AL('Main','HORIZONTAL',20,[0,100,80,100]); main.counterAxisAlignItems='MIN'; F.appendChild(main);\n// filter panel\nconst fp=AL('Filter Panel','VERTICAL',24,[20,24,28,24]); fp.counterAxisSizingMode='FIXED'; fp.resize(295,10); fp.primaryAxisSizingMode='AUTO'; fp.counterAxisAlignItems='MIN'; fp.cornerRadius=20; fp.strokes=S('#E5E5E5'); main.appendChild(fp);\nconst head=async(t,ic)=>{const r=AL(t,'HORIZONTAL',0); r.primaryAxisAlignItems='SPACE_BETWEEN'; fp.appendChild(r); r.layoutSizingHorizontal='FILL'; r.appendChild(await T(t,'Heading/M')); r.appendChild(await icon(ic,'#666666')); return r;};\nawait head('Filters','4:12'); fp.appendChild(divider(247));\nconst foC=await G('10:148');\nconst opts=AL('Category options','VERTICAL',20); opts.counterAxisAlignItems='MIN'; fp.appendChild(opts);\nfor(const o of ['T-shirts','Shorts','Shirts','Hoodie','Jeans']){const i=foC.createInstance(); i.name='Filter · '+o; setP(i,{Label:o}); 