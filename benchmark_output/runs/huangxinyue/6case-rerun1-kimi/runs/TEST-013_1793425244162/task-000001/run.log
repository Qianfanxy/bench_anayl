ER\"); tag.resize(414,22); tag.opacity=0.85;\n\n// ============ 02_Onboarding ============\nf = figma.createFrame(); f.name=\"02_Onboarding\"; f.resize(414,896); f.x=2450; f.y=0;\nf.fills=[{type:\"SOLID\",color:WHITE}]; f.clipsContent=true; ws.appendChild(f);\nawait inst(f,\"4:97\",0,0,414,896);\nconst grad = rect(f,\"overlay\",0,300,414,596,null,0);\ngrad.fills=[{type:\"GRADIENT_LINEAR\", gradientTransform:[[0,0,0],[0,1,0]], gradientStops:[{color:{r:0,g:0,b:0,a:0},position:0},{color:{r:0,g:0,b:0,a:0.72},position:1}]}];\nawait shell(f);\nconst carrot = await inst(f,\"4:10\",0,510,44,51); carrot.x=Math.round((414-44)/2);\nconst title = txt(f,\"title\",\"Welcome\\nto our store\",20,585,42,\"Semi Bold\",WHITE,\"CENTER\"); title.resize(374,120);\nconst sub = txt(f,\"subtitle\",\"Get your groceries in as fast as one hour\",20,720,16,\"Regular\",WHITE,\"CENTER\"); sub.resize(374,24); sub.opacity=0.9;\nconst btnSrc = await figma.getNodeByIdAsync(\"6:29\"); const b1 = btnSrc.createInstance(); b1.x=25; b1.y=772; f.appendChild(b1);\n\n// ============ 03_Sign_In ============\nf = figma.createFrame(); f.name=\"03_Sign_In\"; f.resize(414,896); f.x=2900; f.y=0;\nf.fills=[{type:\"SOLID\",color:WHITE}]; f.clipsContent=true; ws.appendChild(f);\nawait inst(f,\"4:94\",0,0,414,276);\nawait shell(f);\ntxt(f,\"title\",\"Get your groceries\\nwith nectar\",24,320,26,\"Semi Bold\",INK).resize(366,80);\ntxt(f,\"phone-label\",\"Phone\",24,432,16,\"Semi Bold\",GREY);\nawait inst(f,\"4:106\",24,478,36,22);\ntxt(f,\"code\",\"+880\",70,472,18,\"Medium\",INK);\ntxt(f,\"placeholder-number\",\"Phone number\",130,472,18,\"Regular\",{r:0.72,g:0.74,b:0.76});\nrect(f,\"underline\",24,516,366,1,LINE);\ntxt(f,\"social-label\",\"Or connect with social media\",0,610,14,\"Semi Bold\",GREY,\"CENTER\").resize(414,20);\nawait inst(f,\"10:3\",25,660);\nawait inst(f,\"10:12\",25,742);\n\n// ============ 04_Verification ============\nf = figma.createFrame(); f.name=\"04_Verification\"; f.resize(414,896); f.x=3350;