return t;\n}\n\n// Button / Primary\nconst btnPrimary = figma.createComponent();\nbtnPrimary.name = 'Button / Primary';\npill(btnPrimary, 32, 16);\nfillVar(btnPrimary, vars.orange, '#D5491D');\nconst bt1 = label('Get In Touch'); fillVar(bt1, vars.onOrange, '#FFFFFF');\nbtnPrimary.appendChild(bt1);\npage.appendChild(btnPrimary); btnPrimary.x = 2400; btnPrimary.y = 0;\n\n// Button / Primary Hover\nconst btnPrimaryHover = figma.createComponent();\nbtnPrimaryHover.name = 'Button / Primary Hover';\npill(btnPrimaryHover, 32, 16);\nbtnPrimaryHover.fills = [solid('#F05A24')];\nconst bt2 = label('Get In Touch'); fillVar(bt2, vars.onOrange, '#FFFFFF');\nbtnPrimaryHover.appendChild(bt2);\npage.appendChild(btnPrimaryHover); btnPrimaryHover.x = 2400; btnPrimaryHover.y = 90;\n\n// Button / Ghost\nconst btnGhost = figma.createComponent();\nbtnGhost.name = 'Button / Ghost';\npill(btnGhost, 32, 16);\nbtnGhost.fills = [];\nbtnGhost.strokes = [solid('#F5F5F7')]; btnGhost.strokeWeight = 1.5;\nconst bt3 = label('Download CV'); fillVar(bt3, vars.textPrimary, '#F5F5F7');\nbtnGhost.appendChild(bt3);\npage.appendChild(btnGhost); btnGhost.x = 2400; btnGhost.y = 180;\n\n// Button / Ghost Hover\nconst btnGhostHover = figma.createComponent();\nbtnGhostHover.name = 'Button / Ghost Hover';\npill(btnGhostHover, 32, 16);\nfillVar(btnGhostHover, vars.onOrange, '#FFFFFF');\nconst bt4 = label('Download CV'); bt4.fills = [solid('#0C0C10')];\nbtnGhostHover.appendChild(bt4);\npage.appendChild(btnGhostHover); btnGhostHover.x = 2400; btnGhostHover.y = 270;\n\n// Nav Item / Default\nfunction navComp(name, style, colorVar, hex, withDot) {\n  const c = figma.createComponent();\n  c.name = name;\n  c.layoutMode = 'VERTICAL';\n  c.primaryAxisAlignItems = 'CENTER';\n  c.counterAxisAlignItems = 'CENTER';\n  c.paddingLeft = c.paddingRight = 4;\n  c.paddingTop = c.paddingBottom = 8;\n  c.itemSpacing = 6;\n  c.fills = [];\n  const t = figma.createText();\n  t.fontName = P(style); t.fontSize = 15; t.characters = 'Home';\n  if (colorVar) fillVar(t, colorVar, hex); else t.fills = [solid(hex)];\n  c.appendChild(t);\n  if (withDot) {\n    const dot = figma.createEllipse();\n    dot.resize(5,5);\n    fillVar(dot, vars.orange, '#D5491D');\n    c.appendChild(dot);\n  }\n  page.appendChild(c);\n  return c;\n}\nconst navDefault = navComp('Nav Item / Default', 'Regular', vars.textSecondary, '#A9A9B4', false);\nnavDefault.x = 2400; navDefault.y = 360;\nconst navHover = navComp('Nav Item / Hover', 'Medium', vars.textPrimary, '#F5F5F7', false);\nnavHover.x = 2400; navHover.y = 420;\nconst navCurrent = navComp('Nav Item / Current', 'Semi Bold', vars.textPrimary, '#F5F5F7', true);\nnavCurrent.x = 2400; navCurrent.y = 480;\n\nreturn {btnPrimary: btnPrimary.id, btnPrimaryHover: btnPrimaryHover.id, btnGhost: btnGhost.id, btnGhostHover: btnGhostHover.id, navDefault: navDefault.id, navHover: navHover.id, navCurrent: navCurrent.id};\n","description":"Create Button and Nav Item components with variable-bound paints","fileKey":"7Jay53n2t4eIv7n3PmNRTh"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"fcabb8c3-59d8-498d-9399-29c448a10028","uuid":"1aee8b66-b704-4583-8fbe-032d20a37fa1","timestamp":"2026-11-02T03:00:31.064Z","tool_use_meta":[{"id":"mcp__figma__use_figma_17_0a359865","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
