{"type":"assistant","message":{"id":"chatcmpl-20261031200153648582378268d9d6MpwZSbmk","type":"message","role":"assistant","model":"gemini-3.5-flash","content":[{"type":"tool_use","id":"call_55ce90c2d3d041c3a2d611e11bae8503","name":"mcp__figma__use_figma","input":{"code":"(async () => {\n  // 1. Switch to 03 · Workspace page\n  const workspacePage = figma.getNodeById(\"7:2\");\n  await figma.setCurrentPageAsync(workspacePage);\n\n  // Load Inter font variants\n  await figma.loadFontAsync({ family: \"Inter\", style: \"Regular\" });\n  await figma.loadFontAsync({ family: \"Inter\", style: \"Medium\" });\n  await figma.loadFontAsync({ family: \"Inter\", style: \"Semi Bold\" });\n  await figma.loadFontAsync({ family: \"Inter\", style: \"Bold\" });\n\n  // Clear existing children on workspace\n  for (const child of workspacePage.children) {\n    child.remove();\n  }\n\n  // Component & Media map\n  const nodes = {\n    // Shell\n    statusBar: figma.getNodeById(\"1:33\"),\n    homeIndicator: figma.getNodeById(\"1:44\"),\n    // Button\n    button: figma.getNodeById(\"1:28\"),\n    // Logo\n    logo: figma.getNodeById(\"5:4\"),\n    // Portraits\n    portrait_aidan: figma.getNodeById(\"5:112\"),\n    portrait_ben: figma.getNodeById(\"5:139\"),\n    portrait_claire: figma.getNodeById(\"5:113\"),\n    portrait_dan: figma.getNodeById(\"5:114\"),\n    portrait_henry: figma.getNodeById(\"5:144\"),\n    portrait_jo: figma.getNodeById(\"5:141\"),\n    portrait_john: figma.getNodeById(\"5:115\"),\n    portrait_kalvin: figma.getNodeById(\"5:116\"),\n    portrait_keven: figma.getNodeById(\"5:117\"),\n    portrait_lina: figma.getNodeById(\"5:118\"),\n    portrait_lucie: figma.getNodeById(\"5:142\"),\n    portrait_maddison: figma.getNodeById(\"5:119\"),\n    portrait_marry: figma.getNodeById(\"5:120\"),\n    portrait_noemi: figma.getNodeById(\"5:121\"),\n    portrait_pierre: figma.getNodeById(\"5:122\"),\n    portrait_sarah: figma.getNodeById(\"5:123\"),\n    portrait_william: figma.getNodeById(\"5:124\"),\n    portrait_yujian: figma.getNodeById(\"5:125\"),\n    // Posts\n    post_maddison: figma.getNodeById(\"5:126\"),\n    post_noemi: figma.getNodeById(\"5:127\"),\n    post_yujian: figma.getNodeById(\"5:128\"),\n    short_yujian: figma.getNodeById(\"5:137\"),\n    // Claire grid\n    claire_01: figma.getNodeById(\"5:111\"),\n    claire_02: figma.getNodeById(\"5:108\"),\n    claire_03: figma.getNodeById(\"5:110\"),\n    claire_04: figma.getNodeById(\"5:140\"),\n    claire_05: figma.getNodeById(\"5:107\"),\n    claire_06: figma.getNodeById(\"5:106\"),\n    claire_07: figma.getNodeById(\"5:109\"),\n    claire_08: figma.getNodeById(\"5:138\"),\n    claire_09: figma.getNodeById(\"5:143\"),\n    // Sarah grid\n    sarah_01: figma.getNodeById(\"5:129\"),\n    sarah_02: figma.getNodeById(\"5:130\"),\n    sarah_03: figma.getNodeById(\"5:131\"),\n    sarah_04: figma.getNodeById(\"5:132\"),\n    sarah_05: figma.getNodeById(\"5:133\"),\n    sarah_06: figma.getNodeById(\"5:134\"),\n    sarah_07: figma.getNodeById(\"5:135\"),\n    sarah_08: figma.getNodeById(\"5:136\"),\n    sarah_09: figma.getNodeById(\"5:145\"),\n    // Icons\n    icon_activity: figma.getNodeById(\"5:85\"),\n    icon_archive: figma.getNodeById(\"5:88\"),\n    icon_back: figma.getNodeById(\"5:26\"),\n    icon_bell: figma.getNodeById(\"5:33\"),\n    icon_camera: figma.getNodeById(\"5:58\"),\n    icon_chat: figma.getNodeById(\"5:42\"),\n    icon_chevron_right: figma.getNodeById(\"5:29\"),\n    icon_close: figma.getNodeById(\"5:23\"),\n    icon_close_friends: figma.getNodeById(\"5:97\"),\n    icon_discover: figma.getNodeById(\"5:105\"),\n    icon_face_id: figma.getNodeById(\"5:73\"),\n    icon_facebook: figma.getNodeById(\"5:14\"),\n    icon_google: figma.getNodeById(\"5:10\"),\n    icon_group: figma.getNodeById(\"5:101\"),\n    icon_heart: figma.getNodeById(\"5:17\"),\n    icon_home: figma.getNodeById(\"5:36\"),\n    icon_like: figma.getNodeById(\"5:45\"),\n    icon_location: figma.getNodeById(\"5:77\"),\n    icon_menu: figma.getNodeById(\"5:70\"),\n    icon_more: figma.getNodeById(\"5:48\"),\n    icon_music: figma.getNodeById(\"5:63\"),\n    icon_person: figma.getNodeById(\"5:65\"),\n    icon_play: figma.getNodeById(\"5:51\"),\n    icon_plus: figma.getNodeById(\"5:39\"),\n    icon_saved: figma.getNodeById(\"5:91\"),\n    icon_send: figma.getNodeById(\"5:54\"),\n    icon_settings: figma.getNodeById(\"5:81\"),\n    icon_star: figma.getNodeById(\"5:20\"),\n  };\n\n  // Color Definitions\n  const BRAND_PURPLE = { r: 0.294, g: 0.086, b: 0.298 }; // #4B164C\n  const BRAND_PINK = { r: 0.867, g: 0.533, b: 0.812 };   // #DD88CF\n  const WHITE = { r: 1, g: 1, b: 1 };\n  const BLACK = { r: 0, g: 0, b: 0 };\n  const GRAY_100 = { r: 0.96, g: 0.96, b: 0.96 };\n  const GRAY_200 = { r: 0.90, g: 0.90, b: 0.90 };\n  const GRAY_500 = { r: 0.55, g: 0.55, b: 0.55 };\n  const GRAY_900 = { r: 0.12, g: 0.12, b: 0.12 };\n  const GREEN_ACTIVE = { r: 0.22, g: 0.78, b: 0.44 };\n\n  // Helper function to create text node\n  function createText(text, size = 14, weight = \"Regular\", color = GRAY_900) {\n    const t = figma.createText();\n    t.fontName = { family: \"Inter\", style: weight };\n    t.fontSize = size;\n    t.characters = text;\n    t.fills = [{ type: 'SOLID', color }];\n    return t;\n  }\n\n  // Helper to create Instance from Component\n  function inst(compNode, width, height) {\n    if (!compNode) return figma.createFrame();\n    const instance = compNode.createInstance();\n    if (width && height) {\n      instance.resize(width, height);\n    }\n    return instance;\n  }\n\n  // Create Base Frame helper\n  function createScreenFrame(name, x) {\n    const frame = figma.createFrame();\n    frame.name = name;\n    frame.resize(393, 852);\n    frame.x = x;\n    frame.y = 0;\n    frame.fills = [{ type: 'SOLID', color: WHITE }];\n    frame.clipsContent = true;\n    return frame;\n  }\n\n  // Create Tab Bar Component / Frame\n  function createTabBar(currentTab) {\n    const bar = figma.createFrame();\n    bar.name = \"Tab Bar\";\n    bar.resize(393, 83);\n    bar.fills = [{ type: 'SOLID', color: WHITE }];\n    bar.layoutMode = \"HORIZONTAL\";\n    bar.primaryAxisSizingMode = \"FIXED\";\n    bar.counterAxisSizingMode = \"FIXED\";\n    bar.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    bar.counterAxisAlignItems = \"CENTER\";\n    bar.paddingLeft = 24;\n    bar.paddingRight = 24;\n    bar.paddingTop = 10;\n    bar.paddingBottom = 25;\n\n    // Tabs: Home (Icon_Home), Dating (Icon_Heart), Add (Icon_Plus), Chat (Icon_Chat), Profile (Portrait_Sarah_Payne)\n    const tabsData = [\n      { key: \"Home\", icon: nodes.icon_home },\n      { key: \"Dating\", icon: nodes.icon_heart },\n      { key: \"Add\", icon: nodes.icon_plus },\n      { key: \"Chat\", icon: nodes.icon_chat },\n      { key: \"Profile\", portrait: nodes.portrait_sarah }\n    ];\n\n    const tabNodes = {};\n\n    for (const t of tabsData) {\n      const tabItem = figma.createFrame();\n      tabItem.name = `Tab_${t.key}`;\n      tabItem.resize(48, 48);\n      tabItem.layoutMode = \"VERTICAL\";\n      tabItem.primaryAxisAlignItems = \"CENTER\";\n      tabItem.counterAxisAlignItems = \"CENTER\";\n      tabItem.fills = [];\n\n      const isCurrent = t.key === currentTab;\n\n      if (t.portrait) {\n        const pFrame = figma.createFrame();\n        pFrame.resize(28, 28);\n        pFrame.cornerRadius = 14;\n        pFrame.clipsContent = true;\n        if (isCurrent) {\n          pFrame.strokes = [{ type: 'SOLID', color: BRAND_PURPLE }];\n          pFrame.strokeWeight = 2;\n        }\n        const pInst = inst(t.portrait, 28, 28);\n        pFrame.appendChild(pInst);\n        tabItem.appendChild(pFrame);\n      } else {\n        const ic = inst(t.icon, 24, 24);\n        tabItem.appendChild(ic);\n        if (isCurrent) {\n          const dot = figma.createEllipse();\n          dot.resize(4, 4);\n          dot.fills = [{ type: 'SOLID', color: BRAND_PURPLE }];\n          tabItem.appendChild(dot);\n        }\n      }\n\n      bar.appendChild(tabItem);\n      tabNodes[t.key] = tabItem;\n    }\n\n    return { bar, tabNodes };\n  }\n\n  // Dict of screens\n  const screens = {};\n\n  // ==========================================\n  // 1. 01_Welcome Frame\n  // ==========================================\n  const f1 = createScreenFrame(\"01_Welcome\", 0);\n  screens[\"01_Welcome\"] = f1;\n\n  // Status bar\n  const sb1 = inst(nodes.statusBar, 393, 44);\n  sb1.x = 0; sb1.y = 0;\n  f1.appendChild(sb1);\n\n  // Decorative photo collage at top\n  const collage = figma.createFrame();\n  collage.name = \"Collage\";\n  collage.resize(393, 420);\n  collage.x = 0; collage.y = 44;\n  collage.fills = [];\n\n  // Floating portraits: Sarah (center main), Henry, Lucie, Marry, Pierre\n  const pSarahWrap = figma.createFrame();\n  pSarahWrap.resize(140, 140);\n  pSarahWrap.x = 126.5; pSarahWrap.y = 60;\n  pSarahWrap.cornerRadius = 70;\n  pSarahWrap.clipsContent = true;\n  pSarahWrap.appendChild(inst(nodes.portrait_sarah, 140, 140));\n  // Heart badge on Sarah portrait\n  const heartBadge = figma.createFrame();\n  heartBadge.resize(36, 36);\n  heartBadge.x = 226; heartBadge.y = 154;\n  heartBadge.cornerRadius = 18;\n  heartBadge.fills = [{ type: 'SOLID', color: BRAND_PINK }];\n  heartBadge.layoutMode = \"VERTICAL\";\n  heartBadge.primaryAxisAlignItems = \"CENTER\";\n  heartBadge.counterAxisAlignItems = \"CENTER\";\n  heartBadge.appendChild(inst(nodes.icon_heart, 20, 20));\n\n  const pHenry = figma.createFrame();\n  pHenry.resize(70, 70); pHenry.x = 30; pHenry.y = 30; pHenry.cornerRadius = 35; pHenry.clipsContent = true;\n  pHenry.appendChild(inst(nodes.portrait_henry, 70, 70));\n\n  const pLucie = figma.createFrame();\n  pLucie.resize(80, 80); pLucie.x = 280; pLucie.y = 40; pLucie.cornerRadius = 40; pLucie.clipsContent = true;\n  pLucie.appendChild(inst(nodes.portrait_lucie, 80, 80));\n\n  const pMarry = figma.createFrame();\n  pMarry.resize(76, 76); pMarry.x = 40; pMarry.y = 230; pMarry.cornerRadius = 38; pMarry.clipsContent = true;\n  pMarry.appendChild(inst(nodes.portrait_marry, 76, 76));\n\n  const pPierre = figma.createFrame();\n  pPierre.resize(72, 72); pPierre.x = 275; pPierre.y = 220; pPierre.cornerRadius = 36; pPierre.clipsContent = true;\n  pPierre.appendChild(inst(nodes.portrait_pierre, 72, 72));\n\n  collage.appendChild(pHenry);\n  collage.appendChild(pLucie);\n  collage.appendChild(pSarahWrap);\n  collage.appendChild(heartBadge);\n  collage.appendChild(pMarry);\n  collage.appendChild(pPierre);\n  f1.appendChild(collage);\n\n  // Bottom Content container\n  const c1 = figma.createFrame();\n  c1.name = \"Content\";\n  c1.resize(345, 340);\n  c1.x = 24; c1.y = 464;\n  c1.layoutMode = \"VERTICAL\";\n  c1.itemSpacing = 16;\n  c1.counterAxisAlignItems = \"CENTER\";\n  c1.fills = [];\n\n  const headline = createText(\"Let’s meet new people around you\", 24, \"Bold\", BRAND_PURPLE);\n  headline.textAlignHorizontal = \"CENTER\";\n  headline.textAutoResize = \"NONE\";\n  headline.resize(345, 60);\n\n  // Action Buttons\n  function createSocialBtn(text, iconNode, bg, textColor) {\n    const btn = figma.createFrame();\n    btn.resize(345, 52);\n    btn.cornerRadius = 26;\n    btn.fills = [{ type: 'SOLID', color: bg }];\n    btn.layoutMode = \"HORIZONTAL\";\n    btn.primaryAxisAlignItems = \"CENTER\";\n    btn.counterAxisAlignItems = \"CENTER\";\n    btn.itemSpacing = 10;\n    if (iconNode) {\n      btn.appendChild(inst(iconNode, 20, 20));\n    }\n    const txt = createText(text, 15, \"Semi Bold\", textColor);\n    btn.appendChild(txt);\n    return btn;\n  }\n\n  const btnMobile = createSocialBtn(\"Use mobile number\", null, BRAND_PURPLE, WHITE);\n  btnMobile.name = \"Btn_UseMobile\";\n\n  const btnFb = createSocialBtn(\"Continue with Facebook\", nodes.icon_facebook, GRAY_100, BRAND_PURPLE);\n  btnFb.name = \"Btn_Facebook\";\n\n  const btnGg = createSocialBtn(\"Continue with Google\", nodes.icon_google, GRAY_100, BRAND_PURPLE);\n  btnGg.name = \"Btn_Google\";\n\n  // Don't have an account? Sign Up\n  const signupRow = figma.createFrame();\n  signupRow.resize(345, 24);\n  signupRow.layoutMode = \"HORIZONTAL\";\n  signupRow.primaryAxisAlignItems = \"CENTER\";\n  signupRow.counterAxisAlignItems = \"CENTER\";\n  signupRow.itemSpacing = 6;\n  signupRow.fills = [];\n\n  const t1 = createText(\"Don’t have an account?\", 14, \"Regular\", GRAY_500);\n  const tSignUp = createText(\"Sign Up\", 14, \"Bold\", BRAND_PURPLE);\n  tSignUp.name = \"Link_SignUp\";\n\n  signupRow.appendChild(t1);\n  signupRow.appendChild(tSignUp);\n\n  c1.appendChild(headline);\n  c1.appendChild(btnMobile);\n  c1.appendChild(btnFb);\n  c1.appendChild(btnGg);\n  c1.appendChild(signupRow);\n\n  f1.appendChild(c1);\n\n  // Home indicator\n  const hi1 = inst(nodes.homeIndicator, 393, 34);\n  hi1.x = 0; hi1.y = 818;\n  f1.appendChild(hi1);\n\n\n  // ==========================================\n  // 2. 02_Apple_ID_Sheet Frame\n  // ==========================================\n  const f2 = createScreenFrame(\"02_Apple_ID_Sheet\", 450);\n  screens[\"02_Apple_ID_Sheet\"] = f2;\n\n  // Duplicate background of 01_Welcome to show presentation as sheet over 01_Welcome\n  const bgWelcome = f1.clone();\n  bgWelcome.x = 0; bgWelcome.y = 0;\n  f2.appendChild(bgWelcome);\n\n  // Dark overlay\n  const overlay2 = figma.createFrame();\n  overlay2.resize(393, 852);\n  overlay2.x = 0; overlay2.y = 0;\n  overlay2.fills = [{ type: 'SOLID', color: BLACK, opacity: 0.5 }];\n  f2.appendChild(overlay2);\n\n  // Sheet Frame at bottom\n  const sheet = figma.createFrame();\n  sheet.name = \"Apple_ID_Sheet\";\n  sheet.resize(393, 380);\n  sheet.x = 0; sheet.y = 472;\n  sheet.cornerRadius = 24; // Top rounded corners logic handled by frame\n  sheet.fills = [{ type: 'SOLID', color: WHITE }];\n  sheet.layoutMode = \"VERTICAL\";\n  sheet.paddingLeft = 24; sheet.paddingRight = 24; sheet.paddingTop = 20; sheet.paddingBottom = 34;\n  sheet.itemSpacing = 20;\n\n  // Header row of sheet: close icon right aligned\n  const sheetHeader = figma.createFrame();\n  sheetHeader.resize(345, 28);\n  sheetHeader.layoutMode = \"HORIZONTAL\";\n  sheetHeader.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  sheetHeader.counterAxisAlignItems = \"CENTER\";\n  sheetHeader.fills = [];\n\n  const appleIdTitle = createText(\"Apple ID\", 17, \"Bold\", BLACK);\n  const closeBtnSheet = inst(nodes.icon_close, 24, 24);\n  closeBtnSheet.name = \"Btn_Close_Sheet\";\n\n  sheetHeader.appendChild(appleIdTitle);\n  sheetHeader.appendChild(closeBtnSheet);\n\n  // App Logo + Description\n  const sheetContent = figma.createFrame();\n  sheetContent.resize(345, 180);\n  sheetContent.layoutMode = \"VERTICAL\";\n  sheetContent.primaryAxisAlignItems = \"CENTER\";\n  sheetContent.counterAxisAlignItems = \"CENTER\";\n  sheetContent.itemSpacing = 16;\n  sheetContent.fills = [];\n\n  const logoInst = inst(nodes.logo, 60, 60);\n  const copyText = createText(\"Do you want to sign in to Meet Dating App: Meet People with your Apple ID “sarahp@example.com”?\", 15, \"Regular\", GRAY_900);\n  copyText.textAlignHorizontal = \"CENTER\";\n  copyText.textAutoResize = \"NONE\";\n  copyText.resize(345, 60);\n\n  sheetContent.appendChild(logoInst);\n  sheetContent.appendChild(copyText);\n\n  // Face ID Action button\n  const faceIdBtn = figma.createFrame();\n  faceIdBtn.name = \"Btn_Face_ID\";\n  faceIdBtn.resize(345, 52);\n  faceIdBtn.cornerRadius = 26;\n  faceIdBtn.fills = [{ type: 'SOLID', color: BRAND_PURPLE }];\n  faceIdBtn.layoutMode = \"HORIZONTAL\";\n  faceIdBtn.primaryAxisAlignItems = \"CENTER\";\n  faceIdBtn.counterAxisAlignItems = \"CENTER\";\n  faceIdBtn.itemSpacing = 10;\n\n  const faceIdIcon = inst(nodes.icon_face_id, 24, 24);\n  const faceIdLabel = createText(\"Face ID\", 16, \"Semi Bold\", WHITE);\n  faceIdBtn.appendChild(faceIdIcon);\n  faceIdBtn.appendChild(faceIdLabel);\n\n  sheet.appendChild(sheetHeader);\n  sheet.appendChild(sheetContent);\n  sheet.appendChild(faceIdBtn);\n\n  f2.appendChild(sheet);\n\n\n  // ==========================================\n  // 3. 03_Explore Frame\n  // ==========================================\n  const f3 = createScreenFrame(\"03_Explore\", 900);\n  screens[\"03_Explore\"] = f3;\n\n  // Header: \"Explore\", notifications (Icon_Bell)\n  const header3 = figma.createFrame();\n  header3.name = \"Header\";\n  header3.resize(393, 88);\n  header3.x = 0; header3.y = 0;\n  header3.fills = [{ type: 'SOLID', color: WHITE }];\n  header3.layoutMode = \"HORIZONTAL\";\n  header3.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  header3.counterAxisAlignItems = \"CENTER\";\n  header3.paddingLeft = 20; header3.paddingRight = 20; header3.paddingTop = 44;\n\n  const exploreTitle = createText(\"Explore\", 24, \"Bold\", BRAND_PURPLE);\n  const bellIcon = inst(nodes.icon_bell, 24, 24);\n  bellIcon.name = \"Btn_Bell\";\n\n  header3.appendChild(exploreTitle);\n  header3.appendChild(bellIcon);\n  f3.appendChild(header3);\n\n  // Scrollable container / Content area\n  const content3 = figma.createFrame();\n  content3.name = \"Content Scroll\";\n  content3.resize(393, 681);\n  content3.x = 0; content3.y = 88;\n  content3.fills = [];\n  content3.layoutMode = \"VERTICAL\";\n  content3.itemSpacing = 20;\n\n  // 1. Stories list (horizontal)\n  const storiesSection = figma.createFrame();\n  storiesSection.name = \"Stories\";\n  storiesSection.resize(393, 90);\n  storiesSection.layoutMode = \"HORIZONTAL\";\n  storiesSection.itemSpacing = 14;\n  storiesSection.paddingLeft = 20; storiesSection.paddingRight = 20;\n  storiesSection.fills = [];\n\n  // Stories: Your Story (Portrait_Sarah_Payne with Icon_Plus) · Ben · Lucie · Marry · Claire · Lina · Jo · Henry · Pierre\n  const storiesData = [\n    { name: \"Your Story\", portrait: nodes.portrait_sarah, isMine: true },\n    { name: \"Ben\", portrait: nodes.portrait_ben },\n    { name: \"Lucie\", portrait: nodes.portrait_lucie },\n    { name: \"Marry\", portrait: nodes.portrait_marry },\n    { name: \"Claire\", portrait: nodes.portrait_claire, key: \"ClaireStory\" },\n    { name: \"Lina\", portrait: nodes.portrait_lina },\n    { name: \"Jo\", portrait: nodes.portrait_jo },\n    { name: \"Henry\", portrait: nodes.portrait_henry },\n    { name: \"Pierre\", portrait: nodes.portrait_pierre }\n  ];\n\n  const storyNodes = {};\n\n  for (const s of storiesData) {\n    const sItem = figma.createFrame();\n    sItem.name = s.key || `Story_${s.name}`;\n    sItem.resize(60, 85);\n    sItem.layoutMode = \"VERTICAL\";\n    sItem.counterAxisAlignItems = \"CENTER\";\n    sItem.itemSpacing = 4;\n    sItem.fills = [];\n\n    const pRing = figma.createFrame();\n    pRing.resize(58, 58);\n    pRing.cornerRadius = 29;\n    pRing.clipsContent = true;\n    pRing.strokes = [{ type: 'SOLID', color: s.isMine ? GRAY_200 : BRAND_PINK }];\n    pRing.strokeWeight = 2;\n    pRing.paddingLeft = 2; pRing.paddingTop = 2;\n\n    const pInst = inst(s.portrait, 54, 54);\n    pInst.cornerRadius = 27;\n    pRing.appendChild(pInst);\n\n    if (s.isMine) {\n      const addBadge = figma.createFrame();\n      addBadge.resize(18, 18);\n      addBadge.x = 38; addBadge.y = 38;\n      addBadge.cornerRadius = 9;\n      addBadge.fills = [{ type: 'SOLID', color: BRAND_PURPLE }];\n      addBadge.appendChild(inst(nodes.icon_plus, 12, 12));\n      pRing.appendChild(addBadge);\n    }\n\n    const sLabel = createText(s.name, 11, \"Medium\", GRAY_900);\n    sLabel.textAlignHorizontal = \"CENTER\";\n\n    sItem.appendChild(pRing);\n    sItem.appendChild(sLabel);\n    storiesSection.appendChild(sItem);\n\n    if (s.key) {\n      storyNodes[s.key] = sItem;\n    }\n  }\n\n  content3.appendChild(storiesSection);\n\n  // 2. Action buttons: \"Make Friends\", \"Search Partners\"\n  const actionsRow3 = figma.createFrame();\n  actionsRow3.resize(393, 44);\n  actionsRow3.layoutMode = \"HORIZONTAL\";\n  actionsRow3.itemSpacing = 12;\n  actionsRow3.paddingLeft = 20; actionsRow3.paddingRight = 20;\n  actionsRow3.fills = [];\n\n  const btnMakeFriends = figma.createFrame();\n  btnMakeFriends.resize(170, 44);\n  btnMakeFriends.cornerRadius = 22;\n  btnMakeFriends.fills = [{ type: 'SOLID', color: BRAND_PURPLE }];\n  btnMakeFriends.layoutMode = \"HORIZONTAL\";\n  btnMakeFriends.primaryAxisAlignItems = \"CENTER\";\n  btnMakeFriends.counterAxisAlignItems = \"CENTER\";\n  btnMakeFriends.appendChild(createText(\"Make Friends\", 14, \"Semi Bold\", WHITE));\n\n  const btnSearchPartners = figma.createFrame();\n  btnSearchPartners.resize(170, 44);\n  btnSearchPartners.cornerRadius = 22;\n  btnSearchPartners.fills = [{ type: 'SOLID', color: GRAY_100 }];\n  btnSearchPartners.layoutMode = \"HORIZONTAL\";\n  btnSearchPartners.primaryAxisAlignItems = \"CENTER\";\n  btnSearchPartners.counterAxisAlignItems = \"CENTER\";\n  btnSearchPartners.appendChild(createText(\"Search Partners\", 14, \"Semi Bold\", BRAND_PURPLE));\n\n  actionsRow3.appendChild(btnMakeFriends);\n  actionsRow3.appendChild(btnSearchPartners);\n  content3.appendChild(actionsRow3);\n\n  // 3. Feed posts: Noemi Slater, Yu Jian, Maddison Burke\n  const feedPostsData = [\n    { name: \"Noemi Slater\", portrait: nodes.portrait_noemi, post: nodes.post_noemi },\n    { name: \"Yu Jian\", portrait: nodes.portrait_yujian, post: nodes.post_yujian },\n    { name: \"Maddison Burke\", portrait: nodes.portrait_maddison, post: nodes.post_maddison }\n  ];\n\n  for (const post of feedPostsData) {\n    const postCard = figma.createFrame();\n    postCard.name = `Post_${post.name}`;\n    postCard.resize(353, 300);\n    postCard.layoutMode = \"VERTICAL\";\n    postCard.itemSpacing = 10;\n    postCard.fills = [];\n\n    // Header of post\n    const postHeader = figma.createFrame();\n    postHeader.resize(353, 40);\n    postHeader.layoutMode = \"HORIZONTAL\";\n    postHeader.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n    postHeader.counterAxisAlignItems = \"CENTER\";\n    postHeader.fills = [];\n\n    const authorInfo = figma.createFrame();\n    authorInfo.resize(200, 40);\n    authorInfo.layoutMode = \"HORIZONTAL\";\n    authorInfo.counterAxisAlignItems = \"CENTER\";\n    authorInfo.itemSpacing = 10;\n    authorInfo.fills = [];\n\n    const pImg = inst(post.portrait, 40, 40);\n    pImg.cornerRadius = 20;\n    authorInfo.appendChild(pImg);\n    authorInfo.appendChild(createText(post.name, 15, \"Semi Bold\", GRAY_900));\n\n    const moreIcon = inst(nodes.icon_more, 24, 24);\n    postHeader.appendChild(authorInfo);\n    postHeader.appendChild(moreIcon);\n\n    // Media\n    const mediaImg = inst(post.post, 353, 200);\n    mediaImg.cornerRadius = 16;\n    mediaImg.clipsContent = true;\n\n    // Post actions: like (Icon_Like), comment (Icon_Chat)\n    const postActions = figma.createFrame();\n    postActions.resize(353, 30);\n    postActions.layoutMode = \"HORIZONTAL\";\n    postActions.itemSpacing = 16;\n    postActions.counterAxisAlignItems = \"CENTER\";\n    postActions.fills = [];\n\n    postActions.appendChild(inst(nodes.icon_like, 22, 22));\n    postActions.appendChild(inst(nodes.icon_chat, 22, 22));\n\n    postCard.appendChild(postHeader);\n    postCard.appendChild(mediaImg);\n    postCard.appendChild(postActions);\n\n    content3.appendChild(postCard);\n  }\n\n  f3.appendChild(content3);\n\n  // Tab Bar\n  const { bar: tb3, tabNodes: tabNodes3 } = createTabBar(\"Home\");\n  tb3.x = 0; tb3.y = 769;\n  f3.appendChild(tb3);\n\n\n  // ==========================================\n  // 4. 04_Find_Partner Frame\n  // ==========================================\n  const f4 = createScreenFrame(\"04_Find_Partner\", 1350);\n  screens[\"04_Find_Partner\"] = f4;\n\n  // Header: back (Icon_Back), \"Find your partner\"\n  const header4 = figma.createFrame();\n  header4.name = \"Header\";\n  header4.resize(393, 88);\n  header4.x = 0; header4.y = 0;\n  header4.fills = [{ type: 'SOLID', color: WHITE }];\n  header4.layoutMode = \"HORIZONTAL\";\n  header4.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  header4.counterAxisAlignItems = \"CENTER\";\n  header4.paddingLeft = 20; header4.paddingRight = 20; header4.paddingTop = 44;\n\n  const btnBack4 = inst(nodes.icon_back, 24, 24);\n  btnBack4.name = \"Btn_Back_FindPartner\";\n  const partnerTitle = createText(\"Find your partner\", 18, \"Bold\", GRAY_900);\n  const placeholderSpacer = figma.createFrame();\n  placeholderSpacer.resize(24, 24); placeholderSpacer.fills = [];\n\n  header4.appendChild(btnBack4);\n  header4.appendChild(partnerTitle);\n  header4.appendChild(placeholderSpacer);\n  f4.appendChild(header4);\n\n  // Card Stack container\n  const stackContainer = figma.createFrame();\n  stackContainer.name = \"Card Stack\";\n  stackContainer.resize(353, 550);\n  stackContainer.x = 20; stackContainer.y = 100;\n  stackContainer.fills = [];\n\n  // Card stack data: top John 27, then Dan 28, Aidan 25, William 24, Keven 24, Kalvin 23\n  const cardsData = [\n    { name: \"John, 27\", loc: \"San Francisco · 20 km away\", portrait: nodes.portrait_john },\n    { name: \"Dan, 28\", loc: \"Fremont · 12 km away\", portrait: nodes.portrait_dan },\n    { name: \"Aidan, 25\", loc: \"San Ramon · 20 km away\", portrait: nodes.portrait_aidan },\n    { name: \"William, 24\", loc: \"Stockton · 40 km away\", portrait: nodes.portrait_william },\n    { name: \"Keven, 24\", loc: \"Los Angeles · 560 km away\", portrait: nodes.portrait_keven },\n    { name: \"Kalvin, 23\", loc: \"Los Angeles · 560 km away\", portrait: nodes.portrait_kalvin }\n  ];\n\n  // Render back cards first, then top card on top\n  for (let i = cardsData.length - 1; i >= 0; i--) {\n    const cData = cardsData[i];\n    const card = figma.createFrame();\n    card.name = i === 0 ? \"Top Card - John\" : `Card_${cData.name}`;\n    card.resize(353 - i * 8, 520 - i * 10);\n    card.x = i * 4;\n    card.y = i * 6;\n    card.cornerRadius = 24;\n    card.clipsContent = true;\n\n    // Photo background\n    const bgInst = inst(cData.portrait, 353 - i * 8, 520 - i * 10);\n    card.appendChild(bgInst);\n\n    // Gradient overlay at bottom\n    const cardOverlay = figma.createFrame();\n    cardOverlay.resize(353 - i * 8, 200);\n    cardOverlay.x = 0; cardOverlay.y = (520 - i * 10) - 200;\n    cardOverlay.fills = [{\n      type: 'GRADIENT_LINEAR',\n      gradientTransform: [[0, 1, 0], [-1, 0, 1]],\n      gradientStops: [\n        { color: { r: 0, g: 0, b: 0, a: 0 }, position: 0 },\n        { color: { r: 0, g: 0, b: 0, a: 0.8 }, position: 1 }\n      ]\n    }];\n\n    // Info overlay on top card\n    const infoFrame = figma.createFrame();\n    infoFrame.resize(313, 100);\n    infoFrame.x = 20; infoFrame.y = (520 - i * 10) - 110;\n    infoFrame.layoutMode = \"VERTICAL\";\n    infoFrame.itemSpacing = 6;\n    infoFrame.fills = [];\n\n    // Active Now tag\n    const activeTag = figma.createFrame();\n    activeTag.resize(90, 24);\n    activeTag.cornerRadius = 12;\n    activeTag.fills = [{ type: 'SOLID', color: WHITE, opacity: 0.25 }];\n    activeTag.layoutMode = \"HORIZONTAL\";\n    activeTag.primaryAxisAlignItems = \"CENTER\";\n    activeTag.counterAxisAlignItems = \"CENTER\";\n    activeTag.itemSpacing = 6;\n\n    const activeDot = figma.createEllipse();\n    activeDot.resize(8, 8);\n    activeDot.fills = [{ type: 'SOLID', color: GREEN_ACTIVE }];\n    activeTag.appendChild(activeDot);\n    activeTag.appendChild(createText(\"Active Now\", 11, \"Medium\", WHITE));\n\n    const nameText = createText(cData.name, 26, \"Bold\", WHITE);\n\n    const locRow = figma.createFrame();\n    locRow.resize(300, 20);\n    locRow.layoutMode = \"HORIZONTAL\";\n    locRow.counterAxisAlignItems = \"CENTER\";\n    locRow.itemSpacing = 6;\n    locRow.fills = [];\n    locRow.appendChild(inst(nodes.icon_location, 16, 16));\n    locRow.appendChild(createText(cData.loc, 14, \"Medium\", WHITE));\n\n    infoFrame.appendChild(activeTag);\n    infoFrame.appendChild(nameText);\n    infoFrame.appendChild(locRow);\n\n    card.appendChild(cardOverlay);\n    card.appendChild(infoFrame);\n\n    stackContainer.appendChild(card);\n  }\n\n  f4.appendChild(stackContainer);\n\n  // Bottom action buttons: pass (Icon_Close), super like (Icon_Star), like (Icon_Heart)\n  const partnerActions = figma.createFrame();\n  partnerActions.name = \"Actions\";\n  partnerActions.resize(393, 70);\n  partnerActions.x = 0; partnerActions.y = 680;\n  partnerActions.layoutMode = \"HORIZONTAL\";\n  partnerActions.primaryAxisAlignItems = \"CENTER\";\n  partnerActions.counterAxisAlignItems = \"CENTER\";\n  partnerActions.itemSpacing = 24;\n  partnerActions.fills = [];\n\n  function createCircularBtn(iconNode, size, bg) {\n    const btn = figma.createFrame();\n    btn.resize(size, size);\n    btn.cornerRadius = size / 2;\n    btn.fills = [{ type: 'SOLID', color: bg }];\n    btn.layoutMode = \"HORIZONTAL\";\n    btn.primaryAxisAlignItems = \"CENTER\";\n    btn.counterAxisAlignItems = \"CENTER\";\n    btn.appendChild(inst(iconNode, size * 0.45, size * 0.45));\n    return btn;\n  }\n\n  const btnPass = createCircularBtn(nodes.icon_close, 56, GRAY_100);\n  const btnSuperLike = createCircularBtn(nodes.icon_star, 48, BRAND_PINK);\n  const btnLike = createCircularBtn(nodes.icon_heart, 64, BRAND_PURPLE);\n\n  partnerActions.appendChild(btnPass);\n  partnerActions.appendChild(btnSuperLike);\n  partnerActions.appendChild(btnLike);\n  f4.appendChild(partnerActions);\n\n  // Tab Bar\n  const { bar: tb4, tabNodes: tabNodes4 } = createTabBar(\"Dating\");\n  tb4.x = 0; tb4.y = 769;\n  f4.appendChild(tb4);\n\n\n  // ==========================================\n  // 5. 05_Friend_Profile Frame\n  // ==========================================\n  const f5 = createScreenFrame(\"05_Friend_Profile\", 1800);\n  screens[\"05_Friend_Profile\"] = f5;\n\n  // Header: back (Icon_Back), \"Claire Smith\", more (Icon_More)\n  const header5 = figma.createFrame();\n  header5.name = \"Header\";\n  header5.resize(393, 88);\n  header5.x = 0; header5.y = 0;\n  header5.fills = [{ type: 'SOLID', color: WHITE }];\n  header5.layoutMode = \"HORIZONTAL\";\n  header5.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  header5.counterAxisAlignItems = \"CENTER\";\n  header5.paddingLeft = 20; header5.paddingRight = 20; header5.paddingTop = 44;\n\n  const btnBack5 = inst(nodes.icon_back, 24, 24);\n  btnBack5.name = \"Btn_Back_Claire\";\n  const title5 = createText(\"Claire Smith\", 18, \"Bold\", GRAY_900);\n  const more5 = inst(nodes.icon_more, 24, 24);\n\n  header5.appendChild(btnBack5);\n  header5.appendChild(title5);\n  header5.appendChild(more5);\n  f5.appendChild(header5);\n\n  // Profile Header Card: Portrait_Claire_Smith, \"63K Followers\", Actions: \"Follow\", \"Message\"\n  const profileInfo5 = figma.createFrame();\n  profileInfo5.name = \"Profile Info\";\n  profileInfo5.resize(393, 160);\n  profileInfo5.x = 0; profileInfo5.y = 88;\n  profileInfo5.layoutMode = \"VERTICAL\";\n  profileInfo5.primaryAxisAlignItems = \"CENTER\";\n  profileInfo5.counterAxisAlignItems = \"CENTER\";\n  profileInfo5.itemSpacing = 12;\n  profileInfo5.fills = [];\n\n  const pClaireWrap = figma.createFrame();\n  pClaireWrap.resize(72, 72);\n  pClaireWrap.cornerRadius = 36;\n  pClaireWrap.clipsContent = true;\n  pClaireWrap.appendChild(inst(nodes.portrait_claire, 72, 72));\n\n  const followersCount5 = createText(\"63K Followers\", 14, \"Medium\", GRAY_500);\n\n  const actionsRow5 = figma.createFrame();\n  actionsRow5.resize(260, 36);\n  actionsRow5.layoutMode = \"HORIZONTAL\";\n  actionsRow5.itemSpacing = 12;\n  actionsRow5.primaryAxisAlignItems = \"CENTER\";\n  actionsRow5.fills = [];\n\n  const btnFollow = figma.createFrame();\n  btnFollow.resize(120, 36);\n  btnFollow.cornerRadius = 18;\n  btnFollow.fills = [{ type: 'SOLID', color: BRAND_PURPLE }];\n  btnFollow.layoutMode = \"HORIZONTAL\";\n  btnFollow.primaryAxisAlignItems = \"CENTER\";\n  btnFollow.counterAxisAlignItems = \"CENTER\";\n  btnFollow.appendChild(createText(\"Follow\", 14, \"Semi Bold\", WHITE));\n\n  const btnMessage = figma.createFrame();\n  btnMessage.resize(120, 36);\n  btnMessage.cornerRadius = 18;\n  btnMessage.fills = [{ type: 'SOLID', color: GRAY_100 }];\n  btnMessage.layoutMode = \"HORIZONTAL\";\n  btnMessage.primaryAxisAlignItems = \"CENTER\";\n  btnMessage.counterAxisAlignItems = \"CENTER\";\n  btnMessage.appendChild(createText(\"Message\", 14, \"Semi Bold\", GRAY_900));\n\n  actionsRow5.appendChild(btnFollow);\n  actionsRow5.appendChild(btnMessage);\n\n  profileInfo5.appendChild(pClaireWrap);\n  profileInfo5.appendChild(followersCount5);\n  profileInfo5.appendChild(actionsRow5);\n  f5.appendChild(profileInfo5);\n\n  // Tabs: Top, Recent, Short · current: Top\n  const tabs5 = figma.createFrame();\n  tabs5.name = \"Tabs\";\n  tabs5.resize(393, 44);\n  tabs5.x = 0; tabs5.y = 250;\n  tabs5.layoutMode = \"HORIZONTAL\";\n  tabs5.primaryAxisSizingMode = \"FIXED\";\n  tabs5.primaryAxisAlignItems = \"SPACE_AROUND\";\n  tabs5.counterAxisAlignItems = \"CENTER\";\n  tabs5.fills = [{ type: 'SOLID', color: WHITE }];\n\n  const tabTop5 = createText(\"Top\", 15, \"Bold\", BRAND_PURPLE);\n  const tabRecent5 = createText(\"Recent\", 15, \"Medium\", GRAY_500);\n  const tabShort5 = createText(\"Short\", 15, \"Medium\", GRAY_500);\n  tabShort5.name = \"Tab_Short_Claire\";\n\n  tabs5.appendChild(tabTop5);\n  tabs5.appendChild(tabRecent5);\n  tabs5.appendChild(tabShort5);\n  f5.appendChild(tabs5);\n\n  // Media grid: Claire_01 - Claire_09 (01 and 09 are videos, Icon_Play)\n  const grid5 = figma.createFrame();\n  grid5.name = \"Media Grid\";\n  grid5.resize(393, 470);\n  grid5.x = 0; grid5.y = 296;\n  grid5.layoutMode = \"HORIZONTAL\";\n  grid5.layoutWrap = \"WRAP\";\n  grid5.itemSpacing = 2;\n  grid5.counterAxisSpacing = 2;\n  grid5.paddingLeft = 1; grid5.paddingRight = 1;\n  grid5.fills = [];\n\n  const claireMedia = [\n    { node: nodes.claire_01, isVideo: true },\n    { node: nodes.claire_02 },\n    { node: nodes.claire_03 },\n    { node: nodes.claire_04 },\n    { node: nodes.claire_05 },\n    { node: nodes.claire_06 },\n    { node: nodes.claire_07 },\n    { node: nodes.claire_08 },\n    { node: nodes.claire_09, isVideo: true }\n  ];\n\n  for (let i = 0; i < claireMedia.length; i++) {\n    const item = claireMedia[i];\n    const itemFrame = figma.createFrame();\n    itemFrame.name = `Grid_Claire_${i+1}`;\n    itemFrame.resize(129, 129);\n    itemFrame.clipsContent = true;\n\n    const mInst = inst(item.node, 129, 129);\n    itemFrame.appendChild(mInst);\n\n    if (item.isVideo) {\n      const playBadge = figma.createFrame();\n      playBadge.resize(24, 24);\n      playBadge.x = 97; playBadge.y = 8;\n      playBadge.fills = [];\n      playBadge.appendChild(inst(nodes.icon_play, 20, 20));\n      itemFrame.appendChild(playBadge);\n    }\n\n    grid5.appendChild(itemFrame);\n  }\n\n  f5.appendChild(grid5);\n\n  // Tab Bar\n  const { bar: tb5, tabNodes: tabNodes5 } = createTabBar(\"Home\");\n  tb5.x = 0; tb5.y = 769;\n  f5.appendChild(tb5);\n\n\n  // ==========================================\n  // 6. 06_Short_Video Frame\n  // ==========================================\n  const f6 = createScreenFrame(\"06_Short_Video\", 2250);\n  screens[\"06_Short_Video\"] = f6;\n\n  // Media: Short_Yu_Jian_Shore, full-screen video\n  const fullVideo = inst(nodes.short_yujian, 393, 852);\n  fullVideo.x = 0; fullVideo.y = 0;\n  f6.appendChild(fullVideo);\n\n  // Dark Overlay gradient for legibility\n  const videoOverlay = figma.createFrame();\n  videoOverlay.resize(393, 852);\n  videoOverlay.x = 0; videoOverlay.y = 0;\n  videoOverlay.fills = [{\n    type: 'GRADIENT_LINEAR',\n    gradientTransform: [[0, 1, 0], [-1, 0, 1]],\n    gradientStops: [\n      { color: { r: 0, g: 0, b: 0, a: 0.3 }, position: 0 },\n      { color: { r: 0, g: 0, b: 0, a: 0 }, position: 0.4 },\n      { color: { r: 0, g: 0, b: 0, a: 0.7 }, position: 1 }\n    ]\n  }];\n  f6.appendChild(videoOverlay);\n\n  // Header: back (Icon_Back), \"Short\", camera (Icon_Camera)\n  const header6 = figma.createFrame();\n  header6.name = \"Header\";\n  header6.resize(393, 88);\n  header6.x = 0; header6.y = 0;\n  header6.fills = [];\n  header6.layoutMode = \"HORIZONTAL\";\n  header6.primaryAxisAlignItems = \"SPACE_BETWEEN\";\n  header6.counterAxisAlignItems = \"CENTER\";\n  header6.paddingLeft = 20; header6.paddingRight = 20; header6.paddingTop = 44;\n\n  const btnBack6 = inst(nodes.icon_back, 24, 24);\n  btnBack6.name = \"Btn_Back_Short\";\n  const title6 = createText(\"Short\", 18, \"Bold\", WHITE);\n  const cameraIcon = inst(nodes.icon_camera, 24, 24);\n\n  header6.appendChild(btnBack6);\n  header6.appendChild(title6);\n  header6.appendChild(cameraIcon);\n  f6.appendChild(header6);\n\n  // Right vertical action bar: like 123, comment 89, share, more\n  const rightActions = figma.createFrame();\n  rightActions.name = \"Right Actions\";\n  rightActions.resize(60, 240);\n  rightActions.x = 323; rightActions.y = 480;\n  rightActions.layoutMode = \"VERTICAL\";\n  rightActions.counterAxisAlignItems = \"CENTER\";\n  rightActions.itemSpacing = 18;\n  rightActions.fills = [];\n\n  function createActionItem(iconNode, countText) {\n    const item = figma.createFrame();\n    item.resize(50, 44);\n    item.layoutMode = \"VERTICAL\";\n    item.counterAxisAlignItems = \"CENTER\";\n    item.itemSpacing = 2;\n    item.fills = [];\n    item.appendChild(inst(iconNode, 28, 28));\n    if (countText) {\n      item.appendChild(createText(countText, 12, \"Medium\", WHITE));\n    }\n    return item;\n  }\n\n  rightActions.appendChild(createActionItem(nodes.icon_heart, \"123\"));\n  rightActions.appendChild(createActionItem(nodes.icon_chat, \"89\"));\n  rightActions.appendChild(createActionItem(nodes.icon_send, \"\"));\n  rightActions.appendChild(createActionItem(nodes.icon_more, \"\"));\n  f6.appendChild(rightActions);\n\n  // Bottom Author & Caption overlay\n  const captionArea = figma.createFrame();\n  captionArea.name = \"Author & Caption\";\n  captionArea.resize(300, 160);\n  captionArea.x = 20; captionArea.y = 590;\n  captionArea.layoutMode = \"VERTICAL\