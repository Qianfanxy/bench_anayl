omp.findOne(n=>n.name==='Icon').componentPropertyReferences={mainComponent:kI}; place(comp); ids.contact=comp.id; ids.contactK={kT,kV,kI};}\n// Cart drawer\n{const d=AL('VERTICAL',{fill:C.white,gap:0,name:'Cart Drawer'}); d.primaryAxisSizingMode='FIXED'; d.counterAxisSizingMode='FIXED'; d.resize(417,746);\n d.effects=[{type:'DROP_SHADOW',color:{r:0,g:0,b:0,a:0.18},offset:{x:-8,y:0},radius:40,spread:0,visible:true,blendMode:'NORMAL'}];\n const body=AL('VERTICAL',{gap:26,pad:[28,32,28,32],name:'Body'}); d.appendChild(body); body.layoutSizingHorizontal='FILL'; body.layoutGrow=1;\n const top=AL('HORIZONTAL',{justify:'SPACE_BETWEEN',align:'CENTER',name:'Top'}); body.appendChild(top); top.layoutSizingHorizontal='FILL'; top.appendChild(T('Shopping Cart',24,'SemiBold',C.ink,{name:'Title'})); const cl=await icon('13:39',C.muted); cl.name='Close'; top.appendChild(cl);\n const hr=figma.createRectangle(); hr.resize(287,1); hr.fills=solid(C.line); body.appendChild(hr); hr.layoutSizingHorizontal='FILL';\n const item=AL('HORIZONTAL',{gap:24,align:'CENTER',name:'Cart Item'}); body.appendChild(item); item.layoutSizingHorizontal='FILL';\n const ph=await inst('13:4',108,105); ph.cornerRadius=10; item.appendChild(ph); const tx=AL('VERTICAL',{gap:8}); item.appendChild(tx); tx.layoutGrow=1; tx.appendChild(T('Asgaard sofa',16,'Regular',C.ink,{name:'Item name'}));\n const q=AL('HORIZONTAL',{gap:12,align:'CENTER'}); q.appendChild(T('1',16,'Light',C.ink,{name:'Qty'})); q.appendChild(T('×',12,'Light',C.ink)); q.appendChild(T('Rs. 250,000.00',12,'Medium',C.brand,{name:'Item price'})); tx.appendChild(q);\n const rm=await icon('13:43',C.muted); rm.name='Remove'; item.appendChild(rm);\n const sp=figma.createFrame(); sp.fills=[]; sp.name='Spacer'; body.appendChild(sp); sp.layoutSizingHorizontal='FILL'; sp.layoutGrow=1;\n const subt=AL('HORIZONTAL',{gap:0,justify:'SPACE_BETWEEN',align:'CENTER',name:'Subtotal'}); body.appendChild(subt); subt.layoutSizingHorizontal='FILL'; subt.appendChild(T('Subtota