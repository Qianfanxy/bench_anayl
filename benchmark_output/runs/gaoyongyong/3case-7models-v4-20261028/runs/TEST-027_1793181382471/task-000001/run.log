rd.reactions && portCard.reactions.length > 0));\nif (portCard && portCard.reactions) {\n  checks.push(\"  nav type: \" + portCard.reactions[0].actions[0].navigation);\n}\n\n// Check home notif\nconst notifIcon = home.children.find(n => n.type === \"INSTANCE\" && Math.abs(n.x - 360) < 2 && Math.abs(n.y - 60) < 2);\nchecks.push(\"home notif reactions: \" + (notifIcon && notifIcon.reactions && notifIcon.reactions.length > 0));\n\n// Check home account tab\nconst accountTab = home.children.find(n => n.type === \"INSTANCE\" && Math.abs(n.x - (30 + 3 * 103.5)) < 2 && n.y > 800);\nchecks.push(\"home accountTab reactions: \" + (accountTab && accountTab.reactions && accountTab.reactions.length > 0));\n\n// Check overlay close\nconst overlay = await figma.getNodeByIdAsync(\"2015:2\");\nconst closeBtn = overlay.findOne(n => n.name === \"Close\");\nchecks.push(\"overlay close reactions: \" + (closeBtn && closeBtn.reactions && closeBtn.reactions.length > 0));\n\n// Check notification back\nconst notif = await figma.getNodeByIdAsync(\"2016:2\");\nconst nBack = notif.findOne(n => n.name === \"Back\");\nchecks.push(\"notif back reactions: \" + (nBack && nBack.reactions && nBack.reactions.length > 0));\n\n// Check profile home tab\nconst profile = await figma.getNodeByIdAsync(\"2017:2\");\nconst hTab = profile.children.find(n => n.type === \"INSTANCE\" && Math.abs(n.x - 30) < 2 && n.y > 800);\nchecks.push(\"profile homeTab reactions: \" + (hTab && hTab.reactions && hTab.reactions.length > 0));\n\n// Check profile contact row\nconst contactRow = profile.children.find(n => n.type === \"RECTANGLE\" && n.width === 354 && Math.abs(n.y - 290) < 2);\nchecks.push(\"profile contact reactions: \" + (contactRow && contactRow.reactions && contactRow.reactions.length > 0));\n\n// Check profile bank row\nconst bankRow = profile.children.find(n => n.type === \"RECTANGLE\" && n.width === 354 && Math.abs(n.y - 418) < 2);\nchecks.push(\"profile bank reactions: \" + (bankRow && bankRow.reactions && bankRow.reactions.length > 0));\n\n// Check contact back\nconst contact = await figma.getNodeByIdAsync(\"2028:2\");\nconst cBack = contact.findOne(n => n.name === \"Back\");\nchecks.push(\"contact back reactions: \" + (cBack && cBack.reactions && cBack.reactions.length > 0));\n\n// Check bank back\nconst bank = await figma.getNodeByIdAsync(\"2029:2\");\nconst bBack = bank.findOne(n => n.name === \"Back\");\nchecks.push(\"bank back reactions: \" + (bBack && bBack.reactions && bBack.reactions.length > 0));\n\nreturn JSON.stringify(checks, null, 2);\n","description":"Verify all prototype connections","fileKey":"BxIMHhCjiRBVph4Aa3oNRO"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"3394a1fc-48e8-404f-9f28-7846423ba2bb","uuid":"c7ddad72-b0dd-4c9d-be14-2fe1cbae1b45","timestamp":"2026-10-28T10:54:15.748Z","tool_use_meta":[{"id":"mcp__figma__use_figma_84_8e9979aa","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
