t stepper instance y=64, height 36 → 100 < 110. Good. x=252 width 114 → 366. Good.\n\n```js\nconst le=mk(\"List Entry\",366,65);le.fills=[];\nconst li=mediaInst(\"Icon_Orders\",le);li.name=\"EntryIcon\";recolor(li,C.dark);fitIn(li,24,24);li.x=0;li.y=(65-li.height)/2;\nconst ll=txt(\"Label\",17,\"Medium\",C.dark);ll.name=\"Label\";le.appendChild(ll);ll.x=48;ll.y=(65-ll.height)/2;\nconst lv=svgI(\"M9 5l7 7-7 7\",14,C.dark);lv.name=\"Chevron\";le.appendChild(lv);lv.x=352;lv.y=(65-lv.height)/2;\nconst dv=figma.createRectangle();dv.name=\"Divider\";dv.resize(366,1);dv.fills=[F(C.border)];le.appendChild(dv);dv.x=0;dv.y=64;\nconst ci2=mk(\"Code Input\",290,100);ci2.layoutMode=\"VERTICAL\";ci2.primaryAxisSizingMode=\"AUTO\";ci2.counterAxisSizingMode=\"AUTO\";ci2.itemSpacing=16;ci2.fills=[];\nconst cl2=txt(\"Code\",16,\"SemiBold\",C.gray);cl2.name=\"Label\";ci2.appendChild(cl2);\nconst brow=figma.createFrame();brow.name=\"Boxes\";brow.fills=[];brow.layoutMode=\"HORIZONTAL\";brow.primaryAxisSizingMode=\"AUTO\";brow.counterAxisSizingMode=\"AUTO\";brow.itemSpacing=14;ci2.appendChild(brow);\nfor(let i=0;i<4;i++){const b=figma.createFrame();b.name=\"Digit\"+(i+1);b.resize(62,56);b.cornerRadius=10;b.fills=[F(C.white)];b.strokes=[F(C.border)];brow.appendChild(b);}\nconst cb=mk(\"Circle Button\",44,44);cb.cornerRadius=22;cb.fills=[F(C.white)];cb.effects=SH(2,10,0.12);\nconst bs=mk(\"Button Secondary\",364,67);bs.layoutMode=\"HORIZONTAL\";bs.primaryAxisSizingMode=\"FIXED\";bs.counterAxisSizingMode=\"FIXED\";bs.primaryAxisAlignItems=\"CENTER\";bs.counterAxisAlignItems=\"CENTER\";bs.cornerRadius=19;bs.fills=[F(C.white)];bs.strokes=[F(C.border)];bs.resize(364,67);\nconst bl=txt(\"Label\",18,\"SemiBold\",C.dark);bl.name=\"Label\";bs.appendChild(bl);\nconst so=mk(\"Social Button\",364,67);so.cornerRadius=19;so.fills=[F(C.white)];so.strokes=[F(C.border)];\nconst gi=mediaInst(\"Icon_Google_White\",so);gi.name=\"SocialIcon\";recolor(gi,C.dark);fitIn(gi,24,24);gi.x=28;gi.y=(67-gi.height)/2;\nconst gl=txt(\"Continue with Google\",18,\"SemiBold\",C.dark,364);gl.name=\"Label\";gl.textAlignHorizontal=\"CENTER\";gl.x=0;gl.y=(67-gl.height)/2;\nconst crw=mk(\"Checkout Row\",366,88);crw.fills=[];\nconst rl=txt(\"Label\",18,\"SemiBold\",C.dark);rl.name=\"Label\";crw.appendChild(rl);rl.x=0;rl.y=30;\nconst rv=txt(\"Select Method\",16,\"Medium\",C.brand,230);rv.name=\"Value\";rv.textAlignHorizontal=\"RIGHT\";crw.appendChild(rv);rv.x=64;rv.y=32;\nconst ri=mediaInst(\"Icon_Payment\",crw);ri.name=\"ValueIcon\";recolor(ri,C.dark);fitIn(ri,28,20);ri.x=306-ri.width;ri.y=34;ri.visible=false;\nconst chv=svgI(\"M6 9l6 6 6-6\",12,C.dark);chv.name=\"Chevron\";crw.appendChild(chv);chv.x=346;chv.y=38;\nconst dv2=figma.createRectangle();dv2.name=\"Divider\";dv2.resize(366,1);dv2.fills=[F(C.border)];crw.appendChild(dv2);dv2.x=0;dv2.y=87;\nconst TABS=[[\"Shop\",\"Icon_Shop\"],[\"Explore\",\"Icon_Explore\"],[\"Cart\",\"Icon_Cart\"],[\"Favourite\",\"Icon_Favourite\"],[\"Account\",\"Icon_Account\"]];\nconst variants=[];\nfor(const tn of TABS){const v=figma.createComponent();v.resizeWithoutConstraints(414,84);v.name=\"ActiveTab=\"+tn[0];v.fills=[F(C.white)];v.effects=SH(-4,16,0.05);\nconst hl3=figma.createRectangle();hl3.resize(414,1);hl3.fills=[F(C.border)];v.appendChild(hl3);hl3.x=0;hl3.y=0;\nfor(let j=0;j<5;j++){const t=TABS[j];const act=t[0]===tn[0];const ii=mediaInst(t[1],v);recolor(ii,act?C.brand:C.dark);const sc=Math.min(24/ii.width,24/ii.height);ii.resize(ii.width*sc,ii.height*sc);ii.x=j*82.8+(82.8-ii.width)/2;ii.y=18+(24-ii.height)/2;const lt=txt(t[0],11,\"Medium\",act?C.brand:C.dark,82.8);lt.textAlignHorizontal=\"CENTER\";v.appendChild(lt);lt.x=j*82.8;lt.y=50;}\nvariants.push(v);}\nconst tbset=figma.combineAsVariants(variants,WS);tbset.name=\"Tab Bar\";tbset.x=2250;tbset.y=cy+40;\nids[\"Tab Bar\"]=tbset.id;\nreturn JSON.stringify({ids:ids});\n```\n\nWait issue: in mk() for the tab set I don't use mk; cy incremented past. Set y=cy+40 fine.\n\nAlso variant icons: Favourite tab in Shop variant is inactive dark. OK.\n\nHmm, one thing: v.resizeWithoutConstraints(414,84) then fills/effects. Children positioned absolutely — component without auto-layout, fine.\n\nIcon vertical: ii.y=18+(24-ii.height)/2 — for 24-tall icon → 18. Label at y=50, 11px → ~16 tall → ends 66 < 84. Good.\n\nAlso for the tab bar top hairline at y=0 and shadow upward (-4). Good.\n\nChar count ~5.6k. OK.\n\nNow frames. Call 2: Splash, Onboarding, Sign In, Verification.\n\nFrame helper + given components (Button, Text Field, Status Bar, Home Indicator) via MASTER.\n\n```js\nconst BTN=MASTER[\"Button\"],TF=MASTER[\"Text Field\"],SB=MASTER[\"Status Bar\"],HI=MASTER[\"Home Indicator\"];\nfunction btn(parent,label,x,y,name){const b=BTN.createInstance();parent.appendChild(b);b.x=x;b.y=y;if(name)b.name=name;const t=b.findOne(n=>n.type===\"TEXT\");t.characters=label;return b;}\n```\n\nButton text child: from earlier inspection, Button 6:29 has text child \"Get Started\" Poppins SemiBold 18. findOne TEXT. Good.\n\n```js\nfunction statusBar(parent,dark,transparent){const s=SB.createInstance();parent.appendChild(s);s.x=0;s.y=0;if(transparent){s.fills=[];}else if(dark){s.fills=[F(C.dark)];}recolor(s,dark?\"#FFFFFF\":\"#181725\");return s;}\n```\nHmm for splash: dark bg → fills dark, icons white. For normal: white bg, dark icons. For onboarding (over photo): fills=[], white icons.\n\n```js\nfunction homeInd(parent,dark,transparent){const h=HI.createInstance();parent.appendChild(h);h.x=0;h.y=862;if(transparent){h.fills=[];}else if(dark){h.fills=[F(C.dark)];}recolor(h,dark?\"#FFFFFF\":\"#181725\");return h;}\n```\n\nWait HI structure: white bg + black bar. recolor(h,\"#FFFFFF\") makes bar white — good for dark bg. For normal, bar should be black #181725 — recolor dark. But recolor also hits the bg rect? The HI root has fill white (on component root, not child). recolor walks children; the bar is a child rectangle → recolored. If bg is on root fills, unaffected. From summary: \"Home Indicator 6:54: 414×34, white bg, black bar 134×5 radius 3\" — bg on root. Good.\n\nCareful: recolor sets fills on RECTANGLE children that have visible fills — the bar only. Good.\n\n**01_Splash**:\n```js\nconst f1=mkFrame(\"01_Splash\",0,0,414,896,C.dark);\nstatusBar(f1,true,false);\nconst lg=mediaInst(\"Nectar_Logo_White\",f1);const ls=240/lg.width;lg.resize(lg.width*ls,lg.height*ls);lg.x=(414-lg.width)/2;lg.y=426;\nhomeInd(f1,true,false);\n```\nLogo 180×45 → ×1.333 = 240×60. y=426 centers vertically-ish (426+60=486; center 456 vs 448). Fine y=418.\n\n**02_Onboarding** (514,0):\n```js\nconst f2=mkFrame(\"02_Onboarding\",514,0,414,896,C.dark);\nstatusBar(f2,false,true);\nconst hero=figma.createFrame();f2.appendChild(hero);hero.x=0;hero.y=0;hero.resize(414,560);hero.fills=[];hero.clipsContent=true;hero.name=\"Hero\";\nconst pw=mediaInst(\"Photo_Welcome_Delivery\",hero);pw.name=\"Photo\";const cs=Math.max(414/pw.width,560/pw.height);pw.resize(pw.width*cs,pw.height*cs);pw.x=(414-pw.width)/2;pw.y=(560-pw.height)/2;\nconst grad=figma.createRectangle();hero.appendChild(grad);grad.x=0;grad.y=0;grad.resize(414,560);grad.fills=[{type:\"GRADIENT_LINEAR\",gradientTransform:[[0,1,0],[-1,0,1]],gradientStops:[{position:0,color:{r:0,g:0,b:0,a:0}},{position:1,color:{r:0,g:0,b:0,a:0.8}}]}];\n```\ngradientTransform for vertical top→bottom: [[0,1,0],[-1,0,1]] maps... The standard vertical gradient transform: [[0,1,0],[-1,0,1]]. Yes this rotates 90°: gradient goes top to bottom. Good.\n\n```js\nconst w1=txt(\"Welcome to our store\",26,\"SemiBold\",\"#FFFFFF\",340);f2.appendChild(w1);w1.textAlignHorizontal=\"CENTER\";w1.x=37;w1.y=606;\nconst w2=txt(\"Get your groceries in as fast as one hour\",15,\"Medium\",\"#FFFFFF\",320);f2.appendChild(w2);w2.textAlignHorizontal=\"CENTER\";w2.x=47;w2.y=655;\nbtn(f2,\"Get Started\",25,753,\"Btn/Get Started\");\nhomeInd(f2,false,true);\n```\n\n**03_Sign_In** (1028,0):\n```js\nconst f3=mkFrame(\"03_Sign_In\",1028,0,414,896,C.white);\nstatusBar(f3,false,fa