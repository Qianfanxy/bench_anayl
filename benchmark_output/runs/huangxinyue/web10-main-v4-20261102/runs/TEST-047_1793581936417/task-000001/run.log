3529,g:0.89411765,b:0.83529412};\n\n// ============ SEARCH BY FOOD ============\nconst sfCon = await figma.getNodeByIdAsync('13:21');\ntext(sfCon, 'Search by Food', 40, 'Bold', INK, 0, 0);\n// View All top-right\nconst vaT = text(sfCon, 'View All', 17, 'Bold', ORANGE, 0, 12);\nvaT.x = 1728 - vaT.width - 30;\nconst vaIc = inst('9:4', 1728 - 26, 12, sfCon, 20);\nfor (const v of vaIc.findAll(n=>n.type==='VECTOR')) v.fills=[{type:'SOLID',color:ORANGE}];\n// carousel arrows left of view all\nfunction navCircle(parent, x, y, iconId, dir) {\n  const c = figma.createFrame();\n  c.name = 'Carousel · ' + dir;\n  c.resize(44, 44); c.x = x; c.y = y;\n  c.fills = [{type:'SOLID', color: WHITE}];\n  c.cornerRadius = 22;\n  c.strokes = [{type:'SOLID', color: {r:0.9,g:0.9,b:0.9}}];\n  c.strokeWeight = 1.5;\n  parent.appendChild(c);\n  inst(iconId, 10, 10, c, 24);\n  return c;\n}\nnavCircle(sfCon, 1728 - vaT.width - 30 - 120, 0, '9:3', 'previous');\nnavCircle(sfCon, 1728 - vaT.width - 30 - 68, 0, '9:4', 'next');\n\nconst cats = [\n  ['Pizza', '9:37'],\n  ['Burger', '9:34'],\n  ['Noodles', '9:36'],\n  ['Sub-sandwich', '9:53'],\n  ['Chowmein', '9:35'],\n  ['Steak', '9:38'],\n];\nconst tw = 272, tgap = 20;\ncats.forEach(([name, photoId], i) => {\n  const x = i * (tw + tgap);\n  const tile = figma.createFrame();\n  tile.name = 'Category · ' + name;\n  tile.resize(tw, 320);\n  tile.x = x; tile.y = 88;\n  tile.fills = [];\n  sfCon.appendChild(tile);\n  const photo = instCover(photoId, 0, 0, tw, 240, tile);\n  photo.cornerRadius = 16;\n  const t = text(tile, name, 20, 'Bold', INK, 0, 262);\n  t.x = (tw - t.width)/2;\n});\n\n// ============ FEATURES ============\nconst featCon = await figma.getNodeByIdAsync('13:22');\nconst feats = [\n  ['Daily Discounts', 'Icon_Discount', '9:6'],\n  ['Live Tracking', 'Icon_Tracking', '9:20'],\n  ['Quick Delivery', 'Icon_Quick_Delivery', '9:11'],\n];\nconst fw = 460, fgap = 50;\nfeats.forEach(([name, iconName, iconId], i) => {\n  const x = i * (fw + fgap);\n  const card = figma.createFrame();\n  card.name = 'Feature · ' + name;\n  card.resize(fw, 300);\n  card.x = x; card.y = 0;\n  card.fills = [{type:'SOLID', color: WHITE}];\n  card.cornerRadius = 20;\n  card.effects=[{type:'DROP_SHADOW',color:{r:0.2,g:0.12,b:0.02,a:0.07},offset:{x:0,y:14},radius:32,spread:0,visible:true,blendMode:'NORMAL'}];\n  featCon.appendChild(card);\n  const iconWrap = figma.createFrame();\n  iconWrap.name = 'Icon';\n  iconWrap.resize(96, 96);\n  iconWrap.x = (fw-96)/2; iconWrap.y = 40;\n  iconWrap.fills = [{type:'SOLID', color: ORANGE_TINT}];\n  iconWrap.cornerRadius = 48;\n  card.appendChild(iconWrap);\n  const ic = inst(iconId, 26, 26, iconWrap, 44);\n  for (const v of ic.findAll(n=>n.type==='VECTOR')) v.fills=[{type:'SOLID',color:ORANGE}];\n  const t = text(card, name, 24, 'Bold', INK, 0, 160);\n  t.x = (fw - t.width)/2;\n});\nreturn 'searchfood+features ok';\n","description":"Build Search by Food (6 category tiles + View All + carousel) and Features (3 feature cards)","fileKey":"vxs2YHWWLo4u0YPXrkb2yt"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"2939614a-de6b-46ec-9e1f-7271638640fe","uuid":"8ec57f2d-9ad3-466f-9513-582bba982b69","timestamp":"2026-11-02T01:25:54.413Z","tool_use_meta":[{"id":"mcp__figma__use_figma_26_7d17fec7","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
