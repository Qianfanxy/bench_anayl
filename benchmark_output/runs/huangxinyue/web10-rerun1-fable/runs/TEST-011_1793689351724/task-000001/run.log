{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgQMcw668WyAbdd5nVkvg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019pWULS3YRgdw9x9AJxkoaQ","name":"mcp__figma__use_figma","input":{"code":"\nconst PG=await figma.getNodeByIdAsync('9:2');await figma.setCurrentPageAsync(PG);\nfor(const s of ['Regular','Medium','Semi Bold','Bold'])await figma.loadFontAsync({family:'Inter',style:s});\nconst PAL={black:'#000000',ink:'#14141A',body:'#5B5B66',muted:'#8C8C99',line:'#EAEAF0',surface:'#F6F7F8',tint:'#E7F9FD',white:'#FFFFFF',fav:'#E5484D'};\nfunction hx(h){h=h.replace('#','');return{r:parseInt(h.slice(0,2),16)/255,g:parseInt(h.slice(2,4),16)/255,b:parseInt(h.slice(4,6),16)/255};}\nfunction solid(h,o){return{type:'SOLID',color:hx(h),opacity:o===undefined?1:o};}\nconst STY={r:'Regular',m:'Medium',sb:'Semi Bold',b:'Bold'};\nfunction T(p,o,chars){const t=figma.createText();t.name=o.name||'Text';t.fontName={family:'Inter',style:STY[o.st||'r']};t.characters=chars!=null?chars:'Text';t.fontSize=o.sz||16;t.lineHeight={unit:'PERCENT',value:(o.lh||1.45)*100};if(o.ls!==undefined)t.letterSpacing={unit:'PERCENT',value:o.ls};t.fills=[solid(o.c||PAL.ink)];t.textAlignHorizontal=o.al||'LEFT';p.appendChild(t);t.textAutoResize='HEIGHT';t.resize(o.w||300,10);return t;}\nfunction F(p,o){const f=figma.createFrame();f.name=o.name||'Frame';f.resize(o.w||100,o.h||100);f.fills=o.fill?[solid(o.fill)]:[];if(o.r)f.cornerRadius=o.r;if(o.stroke){f.strokes=[solid(o.stroke)];f.strokeWeight=o.sw||1;}if(o.clip)f.clipsContent=true;if(o.ef)f.effects=o.ef;\nif(o.layout){f.layoutMode=o.layout==='V'?'VERTICAL':'HORIZONTAL';f.itemSpacing=o.gap||0;const pd=o.pad||0;f.paddingTop=f.paddingBottom=f.paddingLeft=f.paddingRight=pd;if(o.padL!==undefined)f.paddingLeft=o.padL;if(o.padT!==undefined)f.paddingTop=o.padT;if(o.padR!==undefined)f.paddingRight=o.padR;if(o.padB!==undefined)f.paddingBottom=o.padB;\nf.primaryAxisSizingMode=o.hug?'AUTO':'FIXED';f.counterAxisSizingMode=o.hugW?'AUTO':'FIXED';if(o.align)f.counterAxisAlignItems=o.align;if(o.main)f.primaryAxisAlignItems=o.main;}\np.appendChild(f);return f;}\nconst H={wings:'4a576da13bc911ad9fbca47b72fa857356e78980',chef:'53be7a4eb46d964a5461312afca21e0f577d1bae',fried:'a8a2f85871e0a64ae8021799559e16d6e570fab4'};\nconst IDS={logo:'7:15',fb:'7:48',ig:'7:49',tw:'7:50',timer:'7:47',fork:'7:40',fav:'7:37',play:'7:42',arrow:'7:35',hot:'7:70',tomato:'7:14',onion:'7:12'};\nasync function ICO(p,id,size,color){const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();p.appendChild(i);const k=Math.max(c.width,c.height);i.rescale(size/k);i.findAll(n=>n.type==='VECTOR').forEach(v=>{if(v.fills.length)v.fills=[solid(color)];if(v.strokes.length)v.strokes=[solid(color)];});return i;}\nfunction INST(p,id){const c=figma.currentPage.findOne(()=>false);return null;}\nasync function inst(p,id){const c=await figma.getNodeByIdAsync(id);const i=c.createInstance();p.appendChild(i);return i;}\n\nconst page=figma.currentPage;\n// cleanup old home\nfor(const n of [...page.children]) if(n.name==='01_Home') n.remove();\n\nconst home=figma.createFrame();home.name='01_Home';home.resize(1440,1200);home.x=0;home.y=0;home.fills=[solid(PAL.white)];home.layoutMode='VERTICAL';home.primaryAxisSizingMode='AUTO';home.counterAxisSizingMode='FIXED';home.itemSpacing=0;home.clipsContent=false;page.appendChild(home);\n\n// HEADER\nconst hdrInst=await inst(home,'13:20');hdrInst.name='Header';\n\n// HERO\nconst hero=F(home,{name:'Hero',w:1440,h:560,fill:PAL.white,layout:'H',padL:80,padR:80,padT:56,padB:56,gap:40});\nhero.counterAxisAlignItems='CENTER';\nconst hl=F(hero,{name:'HeroCopy',w:560,h:420,layout:'V',gap:24});\nconst eyebrow=F(hl,{name:'Eyebrow',w:200,h:36,layout:'H',gap:8,fill:PAL.tint,r:18,hugW:true,align:'CENTER'});\neyebrow.paddingLeft=16;eyebrow.paddingRight=18;\nawait ICO(eyebrow,IDS.hot,22,PAL.ink);\nT(eyebrow,{name:'Hot',w:110,sz:14,st:'sb',ls:4,c:'#0B6E7A'},'Hot Recipes');\nT(hl,{name:'H1',w:540,sz:56,st:'b',lh:1.1,ls:-2},'Spicy delicious chicken wings');\nT(hl,{name:'HeroBody',w:480,sz:16,c:PAL.body,lh:1.6},'Crispy outside, juicy inside and coated in a sticky, spicy glaze — these wings are ready in 30 minutes and disappear even faster.');\nconst hmeta=F(hl,{name:'Meta',w:500,h:48,layout:'H',gap:20,align:'CENTER'});\nconst m1=F(hmeta,{name:'Time',w:120,h:32,layout:'H',gap:8,fill:PAL.surface,r:16,align:'CENTER'});m1.paddingLeft=12;m1.paddingRight=14;\nawait ICO(m1,IDS.timer,18,PAL.ink);T(m1,{name:'t',w:80,sz:14,st:'m'},'30 Minutes').textAutoResize='WIDTH_AND_HEIGHT';\nconst m2=F(hmeta,{name:'Cat',w:100,h:32,layout:'H',gap:8,fill:PAL.surface,r:16,align:'CENTER'});m2.paddingLeft=12;m2.paddingRight=14;\nawait ICO(m2,IDS.fork,18,PAL.ink);T(m2,{name:'t',w:80,sz:14,st:'m'},'Chicken').textAutoResize='WIDTH_AND_HEIGHT';\nconst auth=F(hmeta,{name:'Author',w:240,h:44,layout:'H',gap:10,align:'CENTER'});\nconst avInst=await inst(auth,'13:2');avInst.rescale(40/48);\nconst authTxt=F(auth,{name:'Who',w:170,h:38,layout:'V',gap:0});\nT(authTxt,{name:'n',w:160,sz:14,st:'sb'},'John Smith');\nT(authTxt,{name:'d',w:160,sz:12,c:PAL.muted},'15 March 2022');\nconst cta=F(hl,{name:'CTA',w:400,h:60,layout:'H',gap:16,hugW:true,align:'CENTER'});\nconst btn=await inst(cta,'11:5');btn.findOne(n=>n.type==='TEXT').characters='View Recipes';\nconst pl=F(btn,{name:'PlayWrap',w:36,h:36,r:18,fill:PAL.white,layout:'H',main:'CENTER',align:'CENTER'});\nconst picon=await ICO(pl,IDS.play,16,PAL.black);\nbtn.insertChild(0,pl);\n// hero image\nconst heroRight=F(hero,{name:'HeroMedia',w:640,h:450,layout:'V'});\nheroRight.layoutGrow=1;heroRight.counterAxisSizingMode='FIXED';heroRight.primaryAxisSizingMode='FIXED';\nconst blob=figma.createEllipse();blob.name='TintBlob';blob.resize(520,520);blob.fills=[solid(PAL.tint)];blob.x=130;blob.y=-40;heroRight.appendChild(blob);\nconst img=figma.createRectangle();img.name='Photo_Hero_Chicken_Wings';img.resize(600,440);img.cornerRadius=32;img.fills=[{type:'IMAGE',imageHash:H.wings,scaleMode:'FILL'}];img.x=40;img.y=5;heroRight.appendChild(img);\nconst badge=figma.createFrame();badge.name='Badge_Handpicked';badge.resize(132,132);badge.cornerRadius=66;badge.fills=[solid(PAL.black)];badge.x=-10;badge.y=270;badge.layoutMode='VERTICAL';badge.primaryAxisAlignItems='CENTER';badge.counterAxisAlignItems='CENTER';badge.itemSpacing=0;heroRight.appendChild(badge);\nT(badge,{name:'b1',w:100,sz:15,st:'sb',c:PAL.white,al:'CENTER',lh:1.25},'Handpicked');\nT(badge,{name:'b2',w:100,sz:15,st:'sb',c:PAL.white,al:'CENTER',lh:1.25},'Recipes');\nconst dt1=await inst(heroRight,'7:14');dt1.rescale(70/120);dt1.x=560;dt1.y=-20;\nconst do1=await inst(heroRight,'7:12');do1.rescale(80/120);do1.x=-40;do1.y=-30;\nreturn {home:home.id, h:Math.round(home.height)};\n","description":"Start 01_Home with header, hero and mixed content","fileKey":"KBfh4lzngcd72ozCVtDt2c"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":607,"input_tokens":55,"cache_read_input_tokens":114387,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":607}},"context_management":null},"parent_tool_use_id":null,"session_id":"4a1094b8-95cb-47b4-aa0a-0df7e190b320","uuid":"84d496c8-9922-41ea-a043-bceb3d948ab5","timestamp":"2026-11-03T07:16:08.386Z","tool_use_meta":[{"id":"toolu_019pWULS3YRgdw9x9AJxkoaQ","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
