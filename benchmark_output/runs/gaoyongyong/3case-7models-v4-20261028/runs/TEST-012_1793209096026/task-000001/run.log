egular'};t.characters=ch;t.fontSize=size;t.fills=S(color||C.t1);t.lineHeight={value:lh||Math.round(size*1.45),unit:'PIXELS'};return t;}\n   function recolor(n,c){if('strokes' in n&&n.strokes.length)n.strokes=S(c);if('fills' in n&&n.fills!==figma.mixed&&Array.isArray(n.fills)&&n.fills.length)n.fills=S(c);if('children' in n)n.children.forEach(k=>recolor(k,c));}\n   async function icon(name,size,color){const c=await figma.getNodeByIdAsync(name);const i=c.createInstance();recolor(i,color);if(size!==24)i.rescale(size/24);return i;}\n   ```\n   Components being built: `nav(active)` → BottomNav/Home and BottomNav/Account (414×74, 4 tabs, top 1px #E4E9E6 border, active = #31A062 Semi Bold, inactive = #9AA5A0 Regular); `planCard(coinId,name,ret)` (120×140); `articleCard(thumbId,title,summary)` (354×104); `listRow(iconId,label)` (354×64); `historyRow(type,stock,amount,date)` (326×56); `bankCard(logoId,name,number,holder)` (354×88); `notifRow(thumbId,msg,time)` (354×76). Each built as a frame then wrapped: `const c=figma.createComponent(); c.resize(w,h); c.fills=[]; c.appendChild(f); f.x=0;f.y=0; f.remove(); c.name=...`. Planned positions for components: navHome (0,1800), navAccount (460,1800), PlanCard (920,1800), ArticleCard (1080,1800), ListRow (1480,1800), HistoryRow (1900,1800), BankCard (2360,1800), NotificationRow (2780,1800).\n\n4. Errors and fixes:\n   - **get_metadata rejected `description` param** (twice): \"Input validation error: Additional properties are not allowed ('description' was unexpected)\". Fix: omit `description` on get_metadata calls (it IS allowed on use_figma).\n   - **bash tool unavailable**: \"No such tool available: bash\". Fix: no local shell work; everything through Figma MCP tools.\n   - **use_figma script failed**: `TypeError: node.createInstance: no such property 'createInstance' on RECTANGLE node at planCard (PLUGIN_1_SOURCE:41:64)`. Cause: I passed inner `rounded-rectangle` IDs (5:37, 5:55, 5:60, 5:78, 5:83, 5:70) to `getNodeByIdAsync(...).