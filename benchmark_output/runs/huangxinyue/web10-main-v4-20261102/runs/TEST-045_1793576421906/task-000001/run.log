f;\n}\nfunction solid(n, c) { n.fills = [{ type: 'SOLID', color: c }]; }\nfunction gap(n, px) { const s = F('gap'); s.resize(px, px); n.appendChild(s); return s; }\nconst compById = async id => await figma.getNodeByIdAsync(id);\nconst compByName = async name => await figma.getNodeByIdAsync(lib.findOne(n => n.type === 'COMPONENT' && n.name === name).id);\n\nconst prop = await figma.getNodeByIdAsync('20:318');\nif (!prop) return 'prop not found';\n\n// ---------- Content area: 2 columns ----------\nconst content = F('Content'); AL(content, { dir: 'HORIZONTAL', gap: 48, pad: [48, 80, 48, 80], cross: 'MIN' });\nprop.appendChild(content); content.layoutSizingHorizontal = 'FILL';\n\n// LEFT column: description, details, features\nconst left = F('Left'); AL(left, { dir: 'VERTICAL', gap: 40 });\ncontent.appendChild(left); left.layoutSizingHorizontal = 'FILL';\n\n// Description\nconst desc = F('Description'); AL(desc, { dir: 'VERTICAL', gap: 16 });\nleft.appendChild(desc); desc.layoutSizingHorizontal = 'FILL';\ndesc.appendChild(T('Description', { size: 24, style: 'Bold', ls: -1 }));\nconst paras = [\n  'A bright, single-storey family home on a quiet tree-lined street, a short walk from Foster Avenue’s cafés and the subway. The open-plan kitchen with a large island flows into the living and dining area, with floor-to-ceiling windows onto a private garden.',\n  'Four bedrooms include a main suite with its own bathroom.',\n  'Built in 2007 and updated in 2022, the house has a double garage, central air conditioning, new flooring throughout and plenty of built-in storage.',\n];\nfor (const p of paras) {\n  const pt = T(p, { size: 16, color: C.body, lh: 28 });\n  desc.appendChild(pt); pt.layoutSizingHorizontal = 'FILL';\n}\n\n// Details\nconst details = F('Details'); AL(details, { dir: 'VERTICAL', gap: 20 });\nleft.appendChild(details); details.layoutSizingHorizontal = 'FILL';\ndetails.appendChild(T('Details', { size: 24, style: 'Bold', ls: -1 }));\nconst detGrid = F('Grid'); AL(detGrid, { dir: 'HORIZONTAL', gap: 12 });\ndetails.appendChild(detGrid); detGrid.layoutSizingHorizontal = 'FILL';\nconst detailItems = [\n  ['3:6', '4', 'Bedrooms'], ['3:5', '2', 'Bathrooms'], ['3:13', '2', 'Garage'],\n  ['3:12', '1', 'Floor'], ['3:7', '2007', 'Built'],\n];\nconst detailComp = await compByName('Detail / Item');\nfor (const [iconId, val, lab] of detailItems) {\n  const di = detailComp.createInstance();\n  const oldIcon = di.findOne(n => n.type === 'INSTANCE' && n.parent.name === 'icon');\n  oldIcon.swapComponent(await compById(iconId));\n  const texts = di.findAll(n => n.type === 'TEXT');\n  texts.find(t => t.fontSize === 18).characters = val;\n  texts.find(t => t.fontSize === 13).characters = lab;\n  detGrid.appendChild(di); di.layoutSizingHorizontal = 'FILL';\n}\n\n// Features\nconst features = F('Features'); AL(features, { dir: 'VERTICAL', gap: 20 });\nleft.appendChild(features); features.layoutSizingHorizontal = 'FILL';\nfeatures.appendChild(T('Features', { size: 24, style: 'Bold', ls: -1 }));\nconst featList = [\n  'Air conditioning','Central heating','Hardwood floors','Open-plan kitchen','Kitchen island',\n  'Dishwasher','Laundry room','Walk-in closet','En-suite bathroom','Private garden',\n  'Patio','Double garage','Security system','Solar panels','Storage room',\n];\nconst featComp = await compByName('Feature / Item');\nfor (let row = 0; row < 3; row++) {\n  const rowF = F('Row ' + (row + 1)); AL(rowF, { dir: 'HORIZONTAL', gap: 12 });\n  features.appendChild(rowF); rowF.layoutSizingHorizontal = 'FILL';\n  for (let col = 0; col < 5; col++) {\n    const fi = featComp.createInstance();\n    fi.findOne(n => n.type === 'TEXT').characters = featList[row * 5 + col];\n    rowF.appendChild(fi); fi.layoutSizingHorizontal = 'FILL';\n  }\n}\n\n// RIGHT column: agent contact card\nconst right = F('Right'); AL(right, { dir: 'VERTICAL', gap: 0 });\ncontent.appendChild(right); right.layoutSizingHorizontal = 'FIXED'; right.resize(400, 100);\nconst agentCard = F('Agent card'); solid(agentCard, C.white);\nagentCard.cornerRadius = 20;\nagentCard.strokes = [{ type: 'SOLID', color: C.border }]; agentCard.strokeWeight = 1;\nagentCard.effects = [{ type: 'DROP_SHADOW', color: { r: 0.07, g: 0.07, b: 0.09, a: 0.08 }, offset: { x: 0, y: 12 }, radius: 32, spread: 0, visible: true, blendMode: 'NORMAL' }];\nAL(agentCard, { dir: 'VERTICAL', gap: 20, pad: [28, 28, 28, 28] });\nright.appendChild(agentCard); agentCard.layoutSizingHorizontal = 'FILL';\n\n// Agent header\nconst agentHead = F('Agent'); AL(agentHead, { dir: 'HORIZONTAL', gap: 14, cross: 'CENTER' });\nagentCard.appendChild(agentHead); agentHead.layoutSizingHorizontal = 'FILL';\nconst avatar = (await compById('3:19')).createInstance();\navatar.rescale(56 / avatar.width);\nagentHead.appendChild(avatar);\nconst agentInfo = F('info'); AL(agentInfo, { dir: 'VERTICAL', gap: 2 });\nagentHead.appendChild(agentInfo);\nagentInfo.appendChild(T('Kayley Hall', { size: 18, style: 'Bold' }));\nconst vp = T('View profile', { size: 14, style: 'Medium', color: C.amberD });\nagentInfo.appendChild(vp);\n\n// Divider\nconst div = figma.createRectangle(); div.resize(344, 1); solid(div, C.border);\nagentCard.appendChild(div); div.layoutSizingHorizontal = 'FILL';\n\n// Form\nconst fieldComp = await compByName('Field / Input / Focus');\nconst fieldNames = ['Name', 'Phone', 'Email'];\nconst fieldPHs = ['Your full name', '+1 (555) 000-0000', 'you@example.com'];\nfor (let i = 0; i < 3; i++) {\n  const fi = fieldComp.createInstance();\n  const texts = fi.findAll(n => n.type === 'TEXT');\n  texts.find(t => t.fontSize === 14).characters = fieldNames[i];\n  texts.find(t => t.fontSize === 16).characters = fieldPHs[i];\n  agentCard.appendChild(fi); fi.layoutSizingHorizontal = 'FILL';\n  // reset focus state to default (no amber ring, placeholder gray)\n  const input = fi.findOne(n => n.name === 'Input');\n  input.strokes = [{ type: 'SOLID', color: { r: 0.894, g: 0.894, b: 0.894 } }]; input.strokeWeight = 1;\n  texts.find(t => t.fontSize === 16).fills = [{ type: 'SOLID', color: { r: 0.549, g: 0.549, b: 0.549 } }];\n}\nconst taComp = await compByName('Field / Textarea');\nconst ta = taComp.createInstance();\nagentCard.appendChild(ta); ta.layoutSizingHorizontal = 'FILL';\n\n// Contact button\nconst btnIconComp = await compByName('Button / Primary / Icon');\nconst contactBtn = btnIconComp.createInstance();\ncontactBtn.findOne(n => n.type === 'TEXT').characters = 'Contact agent';\nagentCard.appendChild(contactBtn); contactBtn.layoutSizingHorizontal = 'FILL';\n\nreturn JSON.stringify({ propH: Math.round(prop.height) });\n","description":"Build 02_Property step 2: description, details, features, agent contact card"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"8420bd2b-08e1-4650-9759-ee0744cf2f7f","uuid":"6e4ccf4f-edc4-47ea-a5aa-b16431968a91","timestamp":"2026-11-02T00:08:55.165Z","tool_use_meta":[{"id":"mcp__figma__use_figma_57_834e6eb5","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
