antiTxt = figma.createText();\n  gantiTxt.fontName = { family: \"Roboto\", style: \"Bold\" };\n  gantiTxt.characters = \"Ganti\";\n  gantiTxt.fontSize = 13;\n  gantiTxt.fills = [{ type: 'SOLID', color: GREEN_GAIN }];\n  methodCard.appendChild(gantiTxt);\n\n  scroll5.appendChild(methodCard);\n\n  // Amount options section: Amount options: “Pilih Nominal Top Up” · Rp50.000 · Rp100.000 · Rp200.000 · Rp300.000 · Rp500.000 · Rp1.000.000 · selected: Rp500.000\n  const amountSec = figma.createFrame();\n  amountSec.name = \"Amount Options Section\";\n  amountSec.resize(343, 160);\n  amountSec.fills = [];\n  amountSec.layoutMode = \"VERTICAL\";\n  amountSec.itemSpacing = 12;\n\n  const aTitle = figma.createText();\n  aTitle.fontName = { family: \"Roboto\", style: \"Bold\" };\n  aTitle.characters = \"Pilih Nominal Top Up\";\n  aTitle.fontSize = 15;\n  aTitle.fills = [{ type: 'SOLID', color: TEXT_WHITE }];\n  amountSec.appendChild(aTitle);\n\n  // Grid 2 rows of 3 columns\n  const grid = figma.createFrame();\n  grid.name = \"Amounts Grid\";\n  grid.resize(343, 116);\n  grid.fills = [];\n  grid.layoutMode = \"VERTICAL\";\n  grid.itemSpacing = 10;\n\n  const row1Data = [\"Rp50.000\", \"Rp100.000\", \"Rp200.000\"];\n  const row2Data = [\"Rp300.000\", \"Rp500.000\", \"Rp1.000.000\"];\n\n  [row1Data, row2Data].forEach(rowData => {\n    const rFrame = figma.createFrame();\n    rFrame.fills = [];\n    rFrame.layoutMode = \"HORIZONTAL\";\n    rFrame.itemSpacing = 10;\n    rFrame.resize(343, 50);\n\n    rowData.forEach(amt => {\n      const isSelected = amt === \"Rp500.000\";\n      const chip = figma.createFrame();\n      chip.name = `Option_${amt}`;\n      chip.resize(107, 50);\n      chip.fills = isSelected ? [{ type: 'SOLID', color: { r: 0.15, g: 0.59, b: 0.27, a: 0.15 } }] : [{ type: 'SOLID', color: CARD_BG }];\n      chip.strokes = [{ type: 'SOLID', color: isSelected ? GREEN_GAIN : BORDER_COLOR }];\n      chip.strokeWeight = isSelected ? 2 : 1;\n      chip.cornerRadius = 10;\n   