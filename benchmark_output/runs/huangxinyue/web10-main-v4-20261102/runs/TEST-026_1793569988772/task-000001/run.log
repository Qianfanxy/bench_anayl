st k=size/24;if(k!==1)ins.rescale(k);\n  ins.findAll(n=>n.type==='VECTOR').forEach(v=>{v.strokes=fl(color);});\n  ins.x=x;ins.y=y;return ins;\n}\nfunction AV(name,x,y,size=32){const ins=comps[name].createInstance();ins.resize(size,size);ins.cornerRadius=999;ins.x=x;ins.y=y;return ins;}\n\nconst ds=FR(page,'Design System · OCTOM',-1620,0,1500,1200,{fill:'#F7F8FD'});\nds.appendChild(T('Design System · OCTOM',30,'Bold',C.ink));ds.children[0].x=48;ds.children[0].y=40;\nlet n=T('Brand #5051F9 · DM Sans · 8 pt spacing · radii 8 / 10 / 12 / 16 / pill · elevation 0 6 24 rgba(15,16,33,.06)',14,'Regular',C.sub);ds.appendChild(n);n.x=48;n.y=84;\nconst sw=[['#5051F9','Brand 500'],['#3D3EE0','Brand 600'],['#EEEEFE','Brand tint'],['#0F1021','Ink 900'],['#5A5C7A','Ink 600'],['#8A8CA9','Ink 400'],['#ECEFF6','Line'],['#F5F6FA','Canvas'],['#12B886','Mint'],['#F59F00','Amber'],['#F2555A','Danger']];\nsw.forEach((s,i)=>{const x=48+i*132;FR(ds,'Swatch',x,126,112,64,{fill:s[0],r:10});const a=T(s[1],12,'Medium',C.ink);ds.appendChild(a);a.x=x;a.y=200;const b=T(s[0],11,'Regular',C.muted);ds.appendChild(b);b.x=x;b.y=218;});\nconst scale=[['Display 28','Bold'],['Title 22','Bold'],['Section 16','SemiBold'],['Body 14','Regular'],['Meta 12','Regular'],['Micro 11','Medium']];\nscale.forEach((s,i)=>{const t=T(s[0],i===0?28:i===1?22:i===2?16:i===5?11:12===12?12:12,s[1],C.ink);ds.appendChild(t);t.x=48+i*240;t.y=256;});\n\n// Sidebar variants\nconst navDefs=[['Dashboard','Icon_Nav_Dashboard'],['Timeline','Icon_Nav_Timeline'],['Task','Icon_Nav_Task'],['Settings','Icon_Nav_Settings'],['Messages','Icon_Nav_Messages'],['Files','Icon_Nav_Files']];\nconst makeSide=(cur)=>{\n  const c=figma.createComponent();c.name='Current='+cur;c.resize(96,1024);c.fills=fl('#FFFFFF');c.strokes=fl(C.line);c.strokeWeight=1;c.strokeAlign='INSIDE';page.appendChild(c);c.x=-1700;c.y=1400;\n  const lg=comps['Logo_Octom'].createInstance();lg.rescale(0.62);c.appendChild(lg);lg.x=(96-lg.width)/2;lg.y=28;\n  const wm=T('OCTOM',10,'Bold',C.ink,{ls:0.4});c.appendChild(wm);wm.x=30;wm.y=56;const dot=T('.',10,'Bold',P);c.appendChild(dot);dot.x=66;dot.y=56;\n  navDefs.forEach(([label,icon],i)=>{\n    const y=120+i*56, act=label===cur;\n    if(act){const pill=FR(c,'Active pill',24,y,48,48,{fill:P,r:14});pill.effects=[{type:'DROP_SHADOW',color:{r:0.31,g:0.32,b:0.98,a:0.35},offset:{x:0,y:6},radius:14,spread:0,visible:true,blendMode:'NORMAL'}];pill.appendChild(ICO(icon,14,14,20,'#FFFFFF'));}\n    else c.appendChild(ICO(icon,38,y+14,20,C.muted));\n  });\n  c.appendChild(FR(c,'Divider',24,934,48,1,{fill:C.line}));\n  c.appendChild(AV('Avatar_Current_User',32,956,32));\n  return c;\n};\nconst variants=navDefs.map(d=>makeSide(d[0]));\nconst sideSet=figma.combineAsVariants(variants,page);\nsideSet.name='Sidebar';\nsideSet.x=-1700;sideSet.y=1400;\nconst sideBy={};sideSet.children.forEach(c=>{sideBy[c.name.replace('Current=','')]=c;});\n\n// Top bar\nconst tb=figma.createComponent();tb.name='Top Bar';tb.resize(1344,76);tb.fills=fl('#FFFFFF');page.appendChild(tb);tb.x=-1700;tb.y=2520;\nconst search=FR(tb,'Search',32,16,340,44,{fill:'#F5F6FA',r:12});search.appendChild(ICO('Icon_Search',14,12,20,C.muted));\nlet ph=T('Search anything...',14,'Regular',C.muted);search.appendChild(ph);ph.x=44;ph.y=13;\nFR(tb,'Divider',1180,20,1,36,{fill:C.line});\nconst bellWrap=FR(tb,'Notifications',1216,18,40,40,{fill:'#F5F6FA',r:12});bellWrap.appendChild(ICO('Icon_Bell',10,10,20,C.sub));\nconst badge=FR(tb,'Badge',1244,10,18,18,{fill:C.danger,r:999});const bt=T('2',10,'Bold','#FFFFFF');\nbadge.appendChild(bt);bt.x=6;bt.y=2;\ntb.appendChild(AV('Avatar_Current_User',1284,18,40));\ntb.appendChild(ICO('Icon_Chevron_Down',1332,30,16,C.muted));\nreturn JSON.stringify({ok:true,setId:sideSet.id,children:sideSet.children.map(c=>c.name)});","description":"Build design system board, sidebar variants, top bar","fileKey":"abw7NWHcVhT1nBRyk8G1Ya"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{