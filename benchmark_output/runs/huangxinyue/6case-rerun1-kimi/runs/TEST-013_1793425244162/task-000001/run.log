Card(parent, x, y, name, unit, price){\n  const c = await inst(parent,\"10:17\",x,y);\n  setChildrenText(c,{name,unit,price});\n  // replace product image: find instance of product image (first INSTANCE child)\n  const imgInst = c.findOne(n=>n.type===\"INSTANCE\");\n  const newComp = await figma.getNodeByIdAsync(PRODUCTS[name]);\n  imgInst.swapComponent(newComp);\n  return c;\n}\n\n// ============ 05_Home ============\nlet f = figma.createFrame(); f.name=\"05_Home\"; f.resize(414,1310); f.x=2000; f.y=1000;\nf.fills=[{type:\"SOLID\",color:WHITE}]; f.clipsContent=true; ws.appendChild(f);\nawait shell(f);\n// header: carrot + location\nawait inst(f,\"4:10\",193,60,29,34);\ntxt(f,\"location\",\"Dhaka, Banasree\",0,104,16,\"Semi Bold\",GREY,\"CENTER\").resize(414,24);\nawait inst(f,\"9:25\",25,140); // search bar\n// banner\nconst banner = await inst(f,\"4:91\",25,206,364,122);\nbanner.fills=[{type:\"IMAGE\",scaleMode:\"CROP\",imageHash:\"bc77c68d8c1066e0ae39540535c377daacf66b39\",visible:true,opacity:1,blendMode:\"NORMAL\",imageTransform:[[1,0,0],[0,1,0]],scalingFactor:0.5,rotation:0,filters:{exposure:0,contrast:0,saturation:0,temperature:0,tint:0,highlights:0,shadows:0}}];\nbanner.cornerRadius=14;\nconst bnTxt = txt(f,\"banner-title\",\"Fresh Vegetables\",45,232,22,\"Semi Bold\",WHITE); \ntxt(f,\"banner-sub\",\"Get Up To 40% OFF\",45,262,14,\"Medium\",WHITE).opacity=0.95;\n// Exclusive Offer\nconst sh1 = await inst(f,\"10:74\",25,356); setChildrenText(sh1,{title:\"Exclusive Offer\"});\nawait makeCard(f,25,402,\"Organic Bananas\",\"7pcs\",\"$4.99\");\nawait makeCard(f,215,402,\"Red Apple\",\"1kg\",\"$4.99\");\n// Best Selling\nconst sh2 = await inst(f,\"10:74\",25,683); setChildrenText(sh2,{title:\"Best Selling\"});\nawait makeCard(f,25,729,\"Bell Pepper Red\",\"1kg\",\"$4.99\");\nawait makeCard(f,215,729,\"Ginger\",\"250gm\",\"$2.99\");\n// Groceries\nconst sh3 = await inst(f,\"10:74\",25,1010); setChildrenText(sh3,{title:\"Groceries\"});\nconst chip1 = await inst(f,\"10:31\",25,1056); setChildrenText(chip1,{label:\"Pulses\"});\nchip1.findOne(n=>n.type===\"INSTANCE\").swapComponent(await figma.getNodeByIdAsync(\"4:82\"));\nconst chip2 = await inst(f,\"10:31\",215,1056); setChildrenText(chip2,{label:\"Rice\"});\nchip2.findOne(n=>n.type===\"INSTANCE\").swapComponent(await figma.getNodeByIdAsync(\"4:85\"));\nawait makeCard(f,25,1172,\"Beef Bone\",\"1kg\",\"$4.99\");\nawait makeCard(f,215,1172,\"Broiler Chicken\",\"1kg\",\"$4.99\");\n// navbar\nconst navComp = await figma.getNodeByIdAsync(\"10:193\"); // component set\nconst navInst = navComp.children[0].createInstance(); navInst.x=0; navInst.y=1310-84-34; f.appendChild(navInst);\n// move home indicator above nav? it's at bottom; keep.\n\n// ============ 06_Product_Detail ============\nf = figma.createFrame(); f.name=\"06_Product_Detail\"; f.resize(414,896); f.x=2450; f.y=1000;\nf.fills=[{type:\"SOLID\",color:WHITE}]; f.clipsContent=true; ws.appendChild(f);\n// image area\nconst heroBg = rect(f,\"hero-bg\",0,0,414,372,{r:0.949,g:0.949,b:0.949},0);\nheroBg.bottomLeftRadius=25; heroBg.bottomRightRadius=25;\nawait shell(f);\nawait inst(f,\"4:55\",42,110,330,240);\nawait inst(f,\"9:2\",24,60);  // back\nawait inst(f,\"9:5\",346,60); // share\ntxt(f,\"title\",\"Natural Red Apple\",24,404,24,\"Semi Bold\",INK);\ntxt(f,\"unit\",\"1kg, Price\",24,440,16,\"Semi Bold\",GREY);\nawait inst(f,\"9:8\",346,404); // favourite\n// quantity row\nawait inst(f,\"9:14\",24,496); // minus\ntxt(f,\"qty\",\"1\",72,504,18,\"Semi Bold\",INK,\"CENTER\").resize(40,26);\nawait inst(f,\"9:17\",120,496); // plus\ntxt(f,\"price\",\"$4.99\",290,494,24,\"Bold\",INK,\"RIGHT\").resize(100,34);\nrect(f,\"divider1\",24,570,366,1,LINE);\n// Product Detail accordion (open)\ntxt(f,\"pd-label\",\"Product Detail\",24,594,16,\"Semi Bold\",INK);\nconst chevDown = figma.createVector(); chevDown.name=\"chevron-down\"; chevDown.resize(18,10); chevDown.x=372; chevDown.y=600;\nchevDown.vectorPaths=[{windingRule:\"NONE\",data:\"M 1 1 L 9 9 L 17 1\"}];\nchevDown.strokes=[{type:\"SOLID\",color:INK}]; chevDown.strokeWeight=2; chevDown.strokeCap=\"ROUND\"; chevDown.fills=[]; f.appendChild(chevDown);\ntxt(f,\"pd-text\",\"Apples are nutritious. Apples may be good for weight loss. Apples may be good for your heart. As part of a healthful and varied diet.\",24,630,13,\"Regular\",GREY).resize(366,66);\nrect(f,\"divider2\",24,714,366,1,LINE);\n// Nutritions\ntxt(f,\"nut-label\",\"Nutritions\",24,738,16,\"Semi Bold\",INK);\nconst nutChip = rect(f,\"nut-chip\",316,734,44,24,{r:0.93,g:0.93,b:0.93},5);\ntxt(f,\"nut-val\",\"100gr\",316,737,10,\"Semi Bold\",GREY,\"CENTER\").resize(44,18);\nconst ch1 = await inst(f,\"4:124\",374,734,10,16); // chevron right\nrect(f,\"divider3\",24,780,366,1,LINE);\n// Review\ntxt(f,\"rev-label\",\"Review\",24,802,16,\"Semi Bold\",INK);\nfor(let i=0;i<5;i++){ await inst(f,\"9:30\",286+i*18,806,15,15); }\nawait inst(f,\"4:124\",374,800,10,16);\n// Add to basket button\nconst btnSrc = await figma.getNodeByIdAsync(\"6:29\");\nconst addBtn = btnSrc.createInstance(); addBtn.x=25; addBtn.y=896-34-67-8; f.appendChild(addBtn);\naddBtn.findOne(n=>n.type===\"TEXT\").characters=\"Add To Basket\";\n\nreturn \"05, 06 ok\";","description":"Build 05_Home and 06_Product_Detail screens","fileKey":"rOzSn1MkRakcwc5zqsVINX"}}],"context_management":null},"parent_tool_use_id":null,"session_id":"06ae3923-d12a-4248-9468-ebfe96d71820","uuid":"1f7aa3d2-8b51-48f6-8b6e-93ff53383c7a","timestamp":"2026-10-31T05:46:32.634Z","tool_use_meta":[{"id":"mcp__figma__use_figma_18_d7450cc3","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
