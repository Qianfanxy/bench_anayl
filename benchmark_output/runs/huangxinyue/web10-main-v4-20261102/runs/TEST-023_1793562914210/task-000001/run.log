parent,key,x,y,w,h,r){const src=await figma.getNodeByIdAsync(idMap[key]);const inst=src.createInstance();parent.appendChild(inst);inst.name='Photo_'+key;inst.resize(w,h);inst.x=x;inst.y=y;if(r!==undefined)inst.cornerRadius=r;inst.fills=[{type:'IMAGE',scaleMode:'FILL',imageHash:src.fills[0].imageHash}];return inst;}\nasync function icon(parent,id,x,y,size,color){const src=await figma.getNodeByIdAsync(id);const inst=src.createInstance();parent.appendChild(inst);inst.name=src.name;inst.resize(size,size);inst.x=x;inst.y=y;inst.findAll(n=>n.type==='VECTOR').forEach(v=>{v.fills=fill(color||P.ink);v.strokes=[];});return inst;}\nasync function btn(parent,x,y,w,label,kind){const src=await figma.getNodeByIdAsync('1:24');const b=src.createInstance();parent.appendChild(b);b.resize(w,52);b.x=x;b.y=y;if(kind==='outline'){b.fills=fill(P.white);b.strokes=[{type:'SOLID',color:rgb(P.ink),opacity:1}];b.strokeWeight=1;b.strokeAlign='INSIDE';}if(kind==='light'){b.fills=fill(P.white);}const t=b.findOne(n=>n.type==='TEXT');t.characters=label;t.fontSize=14;return b;}\n\n// ---------- Block / Deals ----------\nconst d = comp(lib,'Block / Deals Of The Month',1320,760,40,4850);\ntx(d,'Eyebrow',0,0,{t:'LIMITED TIME',s:11,w:'SemiBold',ls:2.4,c:P.sale});\ntx(d,'Title',0,22,{t:'Deals Of The Month',s:44,f:'Volkhov',w:'Regular',c:P.ink});\ntx(d,'Copy',0,88,{t:'Hand-picked styles at their best prices this month — once the timer runs out, the deals are gone.',s:15,c:P.body,width:600,lh:26});\n// countdown\nconst cd = box(d,'Countdown',0,140,560,86,{fill:P.cream,r:16});\nconst units=[['02','Days'],['06','Hr'],['05','Mins'],['30','Sec']];\nunits.forEach((u,i)=>{const g=box(cd,'Unit '+i,24+i*136,12,120,62,{});tx(g,'Num',0,0,{t:u[0],s:30,f:'Volkhov',w:'Bold',c:P.ink});tx(g,'Label',0,42,{t:u[1],s:11,w:'Medium',ls:1.4,c:P.body});});\ntx(d,'Hurry',0,246,{t:'Hurry, Before It\\'s Too Late!',s:14,w:'Medium',c:P.sale});\n// slider\nconst slides = box(d,'Slides',680,0,640,560,{});\nawait photo(slides,'Deal_1',0,0,640,560,20);\nconst card = box(d,'Current Slide Card',0,280,340,240,{fill:P.white,r:18});\ntx(card,'SlideNo',28,26,{t:'01 — Spring Sale',s:12,w:'Medium',ls:1,c:P.body});\ntx(card,'Off',28,50,{t:'30% OFF',s:44,f:'Volkhov',w:'Bold',c:P.ink});\nawait btn(card,28,150,150,'Buy Now');\n// arrows + indicator\nawait icon(d,'6:20',680,600,44,'#C9C5BD');\nawait icon(d,'6:21',744,600,44,P.ink);\nfor(let i=0;i<4;i++){const dot=box(d,'Dot '+i,828+i*26,618,i===0?22:8,4,{fill:i===0?P.ink:'#D6D2CA',r:2});}\ntx(d,'SlideCount',0,600,{t:'04 slides · 01 current',s:12,c:P.muted});\n// thumbnails column\nawait photo(d,'Deal_2',0,320,120,110,12);\nawait photo(d,'Deal_3',0,445,120,110,12);\n\nreturn {d:d.id};\n","description":"Build deals of the month component","fileKey":"zj84fVMgzEUIcsaY8ScK7u"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"output_tokens":0,"service_tier":"standard","cache_creation_input_tokens":65981,"input_tokens":1,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":65981}},"context_management":null},"parent_tool_use_id":null,"session_id":"45b716de-dcc2-45d2-a4d3-f5e780ce57d2","uuid":"80e4d70d-bc5b-4ad7-bb77-575dd16ee715","timestamp":"2026-11-01T20:05:17.178Z","tool_use_meta":[{"id":"toolu_01JrrmWQbBsoAxVvNpYh7VaP","display_name":"Use Figma","server_display_name":"figma-authenticated-proxy","tool_name":"use_figma"}]}
